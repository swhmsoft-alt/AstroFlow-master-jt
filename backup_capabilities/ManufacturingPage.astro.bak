      <!-- Right Column: Material Traceability -->
      <div>
        <h3 class="text-xl font-bold mb-6" style="color: var(--theme-text);">
          <span style="color: var(--theme-primary);">●</span> Material Traceability & Metrology
        </h3>
        <div class="space-y-4">
          <!-- EN 10204 3.1 MTRs -->
          <div class="rounded-xl p-5 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <h4 class="text-base font-bold mb-1" style="color: var(--theme-text);">EN 10204 Type 3.1 Mill Test Reports</h4>
            <p class="text-xs leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
