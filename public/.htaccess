# ── Content-Security-Policy (Google Ads / Consent Mode) ──
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.googletagservices.com https://tpc.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://stats.g.doubleclick.net;"
</IfModule>

# Raise PHP upload limits for the RFQ drawing attachment (best effort on cPanel/LiteSpeed).
# The server default post_max_size is 8M which would silently drop larger CAD files.
<IfModule mod_php.c>
  php_value post_max_size 32M
  php_value upload_max_filesize 30M
</IfModule>
<IfModule lsapi_module>
  php_value post_max_size 32M
  php_value upload_max_filesize 30M
</IfModule>

# ─────────────────────────────────────────────────────────────
# 301 redirects — old multi-hyphen slugs → clean single-hyphen slugs
# (2026-08-10: normalized industry/system content slugs; see scripts/301-redirects.json)
# ─────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^products/industries/cycling---bicycle/?$ /products/industries/cycling-bicycle/ [R=301,L]
  RewriteRule ^products/systems/brackets--fittings--connectors/?$ /products/systems/brackets-fittings-connectors/ [R=301,L]
  RewriteRule ^products/systems/heat-exchangers--piping-systems/?$ /products/systems/heat-exchangers-piping-systems/ [R=301,L]
  RewriteRule ^products/systems/housings--chambers--enclosures/?$ /products/systems/housings-chambers-enclosures/ [R=301,L]
  RewriteRule ^products/systems/impellers--blades-rotational/?$ /products/systems/impellers-blades-rotational/ [R=301,L]
  RewriteRule ^products/systems/springs--elastic-elements/?$ /products/systems/springs-elastic-elements/ [R=301,L]
  RewriteRule ^products/systems/valves--fluid-control-components/?$ /products/systems/valves-fluid-control-components/ [R=301,L]
  # 2026-08-20: Merged /resources/case-studies/ into the canonical /case-studies/ hub.
  # See scripts/301-redirects.json for the canonical redirect map (single source of truth).
  RewriteRule ^resources/case-studies/?$ /case-studies/ [R=301,L]
  # Multilingual variant: redirect any /[lang]/resources/case-studies/ to /case-studies/ (canonical English hub;
  # localized case-study detail pages render under /[lang]/case-studies/[slug]/ via the dedicated collection route).
  RewriteRule ^[a-z]{2}(-[a-z]{2})?/resources/case-studies/?$ /case-studies/ [R=301,L]
</IfModule>

# BEGIN BotControl
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} (PetalBot|Baiduspider|monitoring360) [NC]
RewriteRule .* - [F,L]
</IfModule>
# END BotControl

# ── Cache-Control: long-lived static assets (PSI 2026-10-15) ──
# _astro/  : Astro content-hashed bundles (filename includes hash) — safe
#            for 1 year, immutable. The 6 _astro/*.js files (~121 KiB)
#            were previously served with no Cache-Control, forcing full
#            re-download on every repeat visit. Expected savings: ~121 KiB
#            on visit 2+, plus ~885 KiB for /uploads/* and /fonts/* that
#            were previously capped at 7 days.
# fonts/   : Inter woff2 (P0-3D self-hosted, version-pinned to v4.5.0).
#            Filenames are stable across version, so 1 year is safe.
# uploads/ : User-uploaded images (also content-hashed by convention).
#            Even if an upload is replaced, the filename changes.
# HTML     : Always revalidate — content changes on every deploy.
# (2026-10-15 LCP/CLS optimization pass)
<IfModule mod_headers.c>
  <FilesMatch "\/_astro\/.*\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\/fonts\/.*\.(woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\/uploads\/.*\.(webp|jpg|jpeg|png|svg|gif|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html

