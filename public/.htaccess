# Raise PHP upload limits for the RFQ drawing attachment (best effort on cPanel/LiteSpeed).
# The server default post_max_size is 8M which would silently drop larger CAD files.
<IfModule mod_php.c>
  php_value post_max_size 32M
  php_value upload_max_filesize 30M
</IfModule>
<IfModule lsapi_module>
  php_value post_max_size 32M
  php_value upload_max_filesize 30M
</IfModule>
