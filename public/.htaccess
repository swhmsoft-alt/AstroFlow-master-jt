# ── Content-Security-Policy (Google Ads / Consent Mode) ──
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.googletagservices.com https://tpc.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://stats.g.doubleclick.net;"
</IfModule>

# Raise PHP upload limits for the RFQ drawing attachment (best effort on cPanel/LiteSpeed).
# The server default post_max_size is 8M which would silently drop larger CAD files.
<IfModule mod_php.c>
  php_value post_max_size 32M
  php_value upload_max_filesize 30M
</IfModule>
<IfModule lsapi_module>
  php_value post_max_size 32M
  php_value upload_max_filesize 30M
</IfModule>

# ─────────────────────────────────────────────────────────────
# 301 redirects — old multi-hyphen slugs → clean single-hyphen slugs
# (2026-08-10: normalized industry/system content slugs; see scripts/301-redirects.json)
# ─────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^products/industries/cycling---bicycle/?$ /products/industries/cycling-bicycle/ [R=301,L]
  RewriteRule ^products/systems/brackets--fittings--connectors/?$ /products/systems/brackets-fittings-connectors/ [R=301,L]
  RewriteRule ^products/systems/heat-exchangers--piping-systems/?$ /products/systems/heat-exchangers-piping-systems/ [R=301,L]
  RewriteRule ^products/systems/housings--chambers--enclosures/?$ /products/systems/housings-chambers-enclosures/ [R=301,L]
  RewriteRule ^products/systems/impellers--blades-rotational/?$ /products/systems/impellers-blades-rotational/ [R=301,L]
  RewriteRule ^products/systems/springs--elastic-elements/?$ /products/systems/springs-elastic-elements/ [R=301,L]
  RewriteRule ^products/systems/valves--fluid-control-components/?$ /products/systems/valves-fluid-control-components/ [R=301,L]
  # 2026-08-20: Merged /resources/case-studies/ into the canonical /case-studies/ hub.
  # See scripts/301-redirects.json for the canonical redirect map (single source of truth).
  RewriteRule ^resources/case-studies/?$ /case-studies/ [R=301,L]
  # Multilingual variant: redirect any /[lang]/resources/case-studies/ to /case-studies/ (canonical English hub;
  # localized case-study detail pages render under /[lang]/case-studies/[slug]/ via the dedicated collection route).
  RewriteRule ^[a-z]{2}(-[a-z]{2})?/resources/case-studies/?$ /case-studies/ [R=301,L]
</IfModule>

# BEGIN BotControl
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} (PetalBot|Baiduspider|monitoring360) [NC]
RewriteRule .* - [F,L]
</IfModule>
# END BotControl

# ── Cache-Control: long-lived static assets (Lighthouse 2026-10-16) ──
# The previous 2026-10-15 attempt used <FilesMatch "\/_astro\/..."> — that
# regex is wrong for Apache <FilesMatch>: FilesMatch only matches the
# filename BASENAME (no path separators allowed), so the leading slash in
# \/_astro\/.+ is non-matching → all /_astro/*.js shipped with no
# Cache-Control.  /uploads/* and /fonts/* showed "7 days" not "1 year"
# because cPanel/LiteSpeed default response cache headers trump nothing.
#
# Strategy (2026-10-16 rewrite): three independent layers, all converge on
# `public, max-age=31536000, immutable` (1 year).  Any one of them is
# sufficient; if all three apply the browser still sees the same header.
#
#   1. mod_expires    : mime-type-driven, independent of path layout.
#                       This is the most portable across Apache + LiteSpeed.
#   2. <LocationMatch>: path-aware fallback (full URL path).  cPanel
#                       LiteSpeed Cache's ESI/CDN layers honor
#                       LocationMatch more reliably than mime-type
#                       Expires headers in some builds.
#   3. <FilesMatch>   : basename-only fallback for .html, which must
#                       always revalidate (otherwise content deploys
#                       would never reach returning visitors).
#
# HTML    : always revalidate — content changes on every deploy.
# _astro/ : Astro content-hashed bundles (hash in filename → immutable).
# fonts/  : Inter woff2 (P0-3D self-hosted, version-pinned v4.5.0;
#          filenames are stable across patch versions).
# uploads/: User-uploaded images, conventionally content-hashed; a
#          replaced upload keeps the old filename until the next build
#          copies a new file with the same name, so 1-year is safe.
# (2026-10-16 LCP/CLS optimization pass — supersedes 2026-10-15 attempt)

# ── Layer 1: mod_expires (MIME-type-driven, deployment-portable) ──
<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed JS/CSS bundles
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"
  # Fonts (some hosts report font/woff2, others application/font-woff2)
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"
  ExpiresByType font/ttf                "access plus 1 year"
  ExpiresByType application/font-woff2  "access plus 1 year"
  ExpiresByType application/font-woff   "access plus 1 year"
  # Images
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  # Sitemaps: 1-day cache (Googlebot re-fetches daily; humans don't hit them)
  ExpiresByType application/xml         "access plus 1 day"
  # Manifests: short
  ExpiresByType application/manifest+json "access plus 1 day"
  # JSON API responses (admin/dev-dashboard): no cache
  ExpiresByType application/json        "access plus 0 seconds"
  # NOTE: no ExpiresDefault.  text/html is intentionally omitted so it
  # inherits the always-revalidate rule from mod_headers below.
</IfModule>

# ── Layers 2 + 3: mod_headers (path-aware LocationMatch + FilesMatch) ──
<IfModule mod_headers.c>
  # HTML always revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Path-aware 1-year immutable for the three known static roots.
  <LocationMatch "^/_astro/.*\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>
  <LocationMatch "^/fonts/.*\.(woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>
  <LocationMatch "^/uploads/.*\.(webp|jpg|jpeg|png|svg|gif|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>
</IfModule>

ErrorDocument 404 /404.html

