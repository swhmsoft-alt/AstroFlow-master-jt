---
interface ComponentCategory {
  title: string;
  subtitle: string;
  description: string;
  capabilities: string[];
  icon: string;
}

const categories: ComponentCategory[] = [
  {
    title: "Complex Structural Assemblies",
    subtitle: "Airframes, Beams & Lightweight Structures",
    description: "Monolithic airframes, drone load-bearing beams, and automotive lightweight structures — achieving strict stress-free welding-machining synergy for mission-critical titanium assemblies.",
    capabilities: [
      "Large monolithic structural nodes for aerospace & UAV",
      "Welded-machined hybrid assemblies — stress-relieved post-weld",
      "Automotive subframe & suspension components in Ti-6Al-4V",
      "Multi-operation integration: machine, weld, heat-treat, inspect"
    ],
    icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
  },
  {
    title: "High-Vacuum & Fluid Manifolds",
    subtitle: "Vacuum Chambers, Valve Blocks & Pump Bodies",
    description: "Deep-cavity semiconductor vacuum chambers, valve blocks, and high-pressure pump bodies — engineered for zero-leakage cross-hole networks in critical fluid and vacuum applications.",
    capabilities: [
      "Semiconductor-grade vacuum chamber machining (UHV compatible)",
      "Multi-port valve blocks with cross-hole intersection accuracy ≤0.01 mm",
      "High-pressure pump bodies rated to 3,000+ PSI operating pressure",
      "Hydrostatic and helium leak testing — in-house certified"
    ],
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
  },
  {
    title: "Precision Micro-Components",
    subtitle: "Medical Devices, Optics & Micro-Fasteners",
    description: "Miniature titanium components for medical devices, optical instrumentation, and micro-fasteners — guaranteeing burr-free microscopic finish with sub-micron feature accuracy.",
    capabilities: [
      "Medical implant modules & surgical instrument components",
      "Optical mount fixtures and instrumentation-grade brackets",
      "Micro-threaded fasteners down to M1.0 with full thread form",
      "Burr-free edge finishing — validated under 20x optical inspection"
    ],
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
  }
];
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Grid pattern -->
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6z" />
        </svg>
        Component Categories
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Custom Industrial <span style="color: var(--theme-primary);">{t('services.customcomponentspectrum.component_spectrum')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        From large monolithic structural assemblies to sub-millimeter micro-components — three specialized workflows covering our full custom industrial component capability.
      </p>
    </div>

    <!-- 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((cat) => (
        <div
          class="group relative rounded-xl p-8 flex flex-col h-full transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);"
          onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 10%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 18%, transparent)'; this.style.boxShadow='none'"
        >
          <!-- Icon -->
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <svg class="w-6 h-6" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={cat.icon} />
            </svg>
          </div>

          <!-- Title & Subtitle -->
          <h3 class="text-lg font-bold mb-1" style="color: var(--theme-text);">{cat.title}</h3>
          <span class="text-sm font-medium mb-4 block" style="color: var(--theme-primary);">{cat.subtitle}</span>

          <!-- Description -->
          <p class="text-sm leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            {cat.description}
          </p>

          <!-- Capabilities -->
          <ul class="space-y-2 mt-auto">
            {cat.capabilities.map((cap) => (
              <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {cap}
              </li>
            ))}
          </ul>

          <!-- Corner hover accent -->
          <div
            class="absolute top-0 right-0 w-0 h-0 transition-all duration-300 rounded-tr-xl"
            style="border-style: solid; border-width: 0 0 0 0; border-color: transparent var(--theme-primary) transparent transparent; opacity: 0;"
            onmouseover="this.style.borderWidth='40px 40px 0 0'; this.style.opacity='1'"
            onmouseout="this.style.borderWidth='0 0 0 0'; this.style.opacity='0'"
          ></div>
        </div>
      ))}
    </div>
  </div>
</section>