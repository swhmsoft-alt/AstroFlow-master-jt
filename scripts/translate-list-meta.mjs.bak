  'it.json': {
    'equipment.list.pageTitle': 'Inventario attrezzature di produzione CNC | Lavorazione di precisione del titanio',
    'equipment.list.metaDescription': 'Schede tecniche complete per il nostro impianto di produzione CNC di titanio — centri di lavoro a 5 assi, torni-fresatori CNC, ispezione CMM, trattamento termico e sistemi automatizzati. Qualità AS9100D.'
  }
};

const langs = Object.keys(translations);
langs.forEach(file => {
  const path = `./src/i18n/translations/${file}`;
  let data = JSON.parse(fs.readFileSync(path, 'utf8'));
  const keys = translations[file];
  Object.keys(keys).forEach(k => {
    data[k] = keys[k];
  });
  fs.writeFileSync(path, JSON.stringify(data, null, 2), 'utf8');
  console.log(`${file}: updated SEO meta translations`);
});
console.log('Done! All 9 language files updated.');