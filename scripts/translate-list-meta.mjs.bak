import fs from 'fs';

const translations = {
  'ja.json': {
    'equipment.list.pageTitle': 'CNC加工設備一覧 | 高精度チタン加工',
    'equipment.list.metaDescription': 'チタンCNC加工施設の全設備仕様書 — 5軸マシニングセンタ、複合旋盤、CMM測定機、熱処理炉、自動化システムまで網羅。AS9100D品質。'
