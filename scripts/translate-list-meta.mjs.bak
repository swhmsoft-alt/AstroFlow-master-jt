  'pl.json': {
    'equipment.list.pageTitle': 'Inwentarz sprzętu produkcyjnego CNC | Precyzyjna obróbka tytanu',
    'equipment.list.metaDescription': 'Kompleksowe arkusze specyfikacji dla naszego zakładu produkcji CNC tytanu — 5-osiowe centra obróbcze, tokarko-frezarki CNC, inspekcja CMM, obróbka cieplna i systemy zautomatyzowane. Jakość AS9100D.'
