  'fr.json': {
    'equipment.list.pageTitle': 'Inventaire des équipements de fabrication CNC | Usinage de précision du titane',
    'equipment.list.metaDescription': 'Fiches techniques complètes de notre installation de fabrication CNC de titane — centres d\'usinage 5 axes, tour-fraisage CNC, inspection CMM, traitement thermique et systèmes automatisés. Qualité AS9100D.'
  },
  'es.json': {
    'equipment.list.pageTitle': 'Inventario de equipos de fabricación CNC | Mecanizado de precisión de titanio',
    'equipment.list.metaDescription': 'Hojas de especificaciones completas de nuestra instalación de fabricación CNC de titanio — centros de mecanizado de 5 ejes, torno-fresa CNC, inspección CMM, tratamiento térmico y sistemas automatizados. Calidad AS9100D.'
