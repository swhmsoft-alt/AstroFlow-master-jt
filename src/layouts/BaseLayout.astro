---
import '../styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE } from '@config/site';
import { SEO_CONFIG } from '@config/seo';
import { getFontConfig, getGoogleFontsUrl, getCssFamily } from '@utils/fonts';
import { getLangFromUrl, getAlternateLinks, removeLangPrefix } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  hideThemeSwitcher?: boolean;
  /** SEO: Canonical URL override — defaults to current URL */
  canonicalURL?: string;
  /** SEO: Open Graph / Twitter share image — defaults to brand OG image */
  ogImage?: string;
  /** Article: publish date ISO string — enables article:published_time meta */
  pubDate?: string | null;
  /** Article: author name — enables article:author meta */
  author?: string;
  /** Article: tags array — enables article:tag meta */
  tags?: string[];
}

const currentPathname = Astro.url.pathname;
const currentLang = getLangFromUrl(Astro.url);
const alternateLinks = getAlternateLinks(currentPathname);

const { 
  title: explicitTitle, 
  description: explicitDesc,
  hideThemeSwitcher = false,
  canonicalURL,
  ogImage,
  pubDate,
  author,
  tags,
} = Astro.props;

// ── SEO Config auto-resolution ──────────────────────────
// Remove language prefix to get canonical path for SEO lookup
// Normalize: strip trailing slash (except for root path '/')
const rawPath = removeLangPrefix(currentPathname);
const canonicalPath = rawPath === '/' ? '/' : rawPath.replace(/\/+$/, '');
const seoEntry = SEO_CONFIG[canonicalPath];

// Language-specific SEO from config
const seoTitleFromConfig = seoEntry?.title?.[currentLang];
const seoDescFromConfig = seoEntry?.description?.[currentLang];

// Priority: explicit prop > SEO_CONFIG > SITE defaults
const title = explicitTitle || seoTitleFromConfig || SITE.title;
const description = explicitDesc || seoDescFromConfig || SITE.description;

// ── Computed SEO values ────────────────────────────────
const siteUrl = SITE.url;
const currentUrl = `${siteUrl}${currentPathname}`;
const canonicalUrl = canonicalURL || currentUrl;
const defaultOgImage = `${siteUrl}/uploads/boze-1-en.png`;
const seoImage = ogImage || defaultOgImage;

// Language → OG locale mapping
const ogLocales: Record<string, string> = {
  en: 'en_US',
  zh: 'zh_CN',
};
const ogLocale = ogLocales[currentLang] || 'en_US';

// Static defaults (previously loaded from CMS collections)
const favicon = '/favicon.svg';
const siteName = SITE.title;
const cmsDefaultTheme = 'aerospace-precision';
const fontStyle = 'inter';
const fallbackFont = 'monospace';
const fontConfig = getFontConfig(fontStyle);
const fontUrl = getGoogleFontsUrl(fontConfig);
const fontFamily = getCssFamily(fontConfig, fallbackFont);
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {favicon.endsWith('.svg') ? (
      <link rel="icon" type="image/svg+xml" href={favicon} />
    ) : favicon.endsWith('.png') ? (
      <link rel="icon" type="image/png" href={favicon} />
    ) : (
      <link rel="icon" href={favicon} />
    )}
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts — statically configured -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontUrl} rel="stylesheet" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- ══ Canonical URL (prevents duplicate content) ════════ -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- ══ Open Graph — URL, Image, Locale ════════════════════ -->
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />

    <!-- ══ Twitter Card — URL & Image ═════════════════════════ -->
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:image" content={seoImage} />

    <!-- ══ Article Meta (blog posts only) ═════════════════════ -->
    {pubDate && <meta property="article:published_time" content={pubDate} />}
    {author && <meta property="article:author" content={author} />}
    {tags && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- ══ JSON-LD — Organization (brand entity for all pages) ══ -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "BOZE CNC Ti",
      "url": siteUrl,
      "logo": `${siteUrl}/uploads/boze-logo-2.png`,
      "description": "Leading provider of optimized Titanium CNC Machining and manufacturing solutions.",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+86-917-1234-5678",
        "contactType": "sales",
        "availableLanguage": ["English", "Chinese"]
      },
      "sameAs": [
        "https://www.linkedin.com/company/bozemetal",
        "https://www.facebook.com/bozemetal"
      ]
    })} />

    <!-- ══ JSON-LD — WebSite (site search & identity) ══════════ -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "BOZE CNC Ti",
      "url": siteUrl,
      "description": SITE.description,
      "inLanguage": currentLang === 'zh' ? 'zh-CN' : 'en-US'
    })} />

    <!-- ══ hreflang Alternate Links (i18n SEO) ═══════════════ -->
    {alternateLinks.map((link) => (
      <link rel="alternate" hrefLang={link.lang} href={`${SITE.url}${link.href}`} />
    ))}
    <link rel="alternate" hrefLang="x-default" href={`${SITE.url}${currentPathname}`} />

    <!-- ═══════════════════════════════════════════════════════
         THEME SYSTEM — FOUC Prevention (static default theme)
         ═══════════════════════════════════════════════════════ -->
    <script is:inline>
      (function(){
        var theme = 'aerospace-precision';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col antialiased bg-theme-bg text-theme-text transition-colors duration-300"
    style={`font-family: ${fontFamily}; --font-primary: ${fontFamily}; --font-body: ${fontFamily}; --font-heading: ${fontFamily};`}
  >
    <Header currentPathname={currentPathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>