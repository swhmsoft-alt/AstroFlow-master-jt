---
import '../styles/global.css';
import '../styles/rtl.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE, NAVIGATION, type NavItem } from '@config/site';
import { SEO_CONFIG } from '@config/seo';
import { getFontConfig, getGoogleFontsUrl, getCssFamily } from '@utils/fonts';
import { getLangFromUrl, useTranslations, getAlternateLinks, removeLangPrefix } from '../i18n/utils';
import { DEFAULT_LANG } from '../i18n/ui';
import { isRouteAvailableInLang } from '@config/route-availability.mjs';
import { buildBlogMap } from '../lib/blog-index';
import { detectPageType, buildBreadcrumbItems, buildPageGraph, type PageType, type BreadcrumbItem, type FaqItem, type HowToItem } from '../lib/schema';
import { pageNeedsMath } from '../lib/page-features';
import { ACTIVE_THEME_ID } from '../config/themes';
import BrandAbout from '@components/home/BrandAbout.astro';
import CookieConsent from '@components/CookieConsent.astro';

// Build path to label map from NAVIGATION for better breadcrumb names
const NAV_LABEL_MAP: Record<string, string> = (() => {
  const m: Record<string, string> = {};
  function walk(items: NavItem[]) {
    for (const item of items) {
      if (item.href) m[item.href.replace(/\/+$/, '')] = item.name;
      if (item.children) {
        for (const g of item.children) {
          for (const c of g.items) {
            if (c.href) m[c.href.replace(/\/+$/, '')] = c.name;
          }
        }
      }
    }
  }
  walk(NAVIGATION);
  return m;
})();

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string | URL;
  ogImage?: string;
  pubDate?: string | null;
  author?: string;
  tags?: string[];
  pageType?: PageType;
  serviceName?: string;
  serviceDescription?: string;
  serviceCategory?: string;
  productName?: string;
  productDescription?: string;
  productImage?: string;
  productCategory?: string;
  productRfqUrl?: string;
  // Phase 3 — Product entity schema field overrides (replaces page-level
  // JSON-LD block on product-entity detail pages).
  productSku?: string;
  productMaterial?: string;
  productHowto?: HowToItem;
  productFaqItems?: FaqItem[];
  /**
   * Phase G-2.2 — Offer.deliveryLeadTime for standard-part-detail Product
   * entity. Example: "5-7 days" or ISO 8601 duration "P5D". When the
   * standard-part-detail case auto-emits a Product entity, this value is
   * forwarded to the Offer.
   */
  productDeliveryLeadTime?: string;
  // Phase 2C — tool detail (WebApplication schema entity)
  toolName?: string;
  toolDescription?: string;
  toolCategory?: string;
  toolSubCategory?: string;
  toolRfqPath?: string;
  /**
   * F4 — Optional Article schema overrides. Defaults to blog-post detection;
   * can be set explicitly on non-blog pages (e.g. services-hub) to attach
   * Article structured data alongside the Service entity.
   */
  articleHeadline?: string;
  articleDescription?: string;
  articleAuthor?: string;
  /**
   * ISO 8601 last-modified date for the Article/BlogPosting entity emitted
   * by buildPageGraph (schema.ts). Mirrors the frontmatter `updatedDate`
   * field on blog/blog-translations collections. When omitted the JSON-LD
   * graph simply drops the `dateModified` key — no fabricated value.
   */
  articleDateModified?: string | null;
  articleImage?: string;
  /**
   * P2-7 — TechArticle.about payload. Forwarded to `SchemaPageData.articleAbout`
   * which is consumed by the 'tech-article' case in buildPageGraph.
   * Omit to use the schema.ts fallback ("Titanium CNC Machining, ...").
   */
  articleAbout?: string | readonly string[];
  collectionName?: string;
  collectionDescription?: string;
  itemCount?: number;
  items?: { name: string; url: string }[];
  /**
   * FAQ items for an in-page accordion. Passed through to buildPageGraph →
   * emits an additional schema.org FAQPage entity in the page @graph.
   */
  faqItems?: FaqItem[];
  /** Optional label for the FAQPage entity (defaults to `${pageName} — Frequently Asked Questions`). */
  faqName?: string;
  /**
   * AIO — HowTo procedure (recipe-style step-by-step). When provided,
   * buildPageGraph emits an additional schema.org HowTo entity in the page
   * @graph. Designed for procedural "how to" content pages (e.g. "How to
   * Choose the Right Titanium Grade") to maximise AI Overview citation rate.
   */
  howtoItem?: HowToItem;
  /**
   * Schema.org Service.serviceType forwarded to buildService(). When set,
   * the emitted Service entity carries a `serviceType` property (e.g.
   * "Precision CNC Machining"). Callers MUST only declare processes the
   * page actually advertises.
   */
  serviceType?: string;
  /**
   * Schema.org Service.areaServed forwarded to buildService(). For the
   * cnc.bozemetal.com export-only B2B funnel, the default is "Worldwide".
   * Pass a country/region list when the page explicitly serves a narrower
   * audience (e.g. a domestic-only landing page).
   */
  serviceAreaServed?: string | string[];
  /**
   * Optional override for the auto-generated JSON-LD BreadcrumbList. When
   * provided, these items replace the auto-derived `breadcrumbRaw` produced
   * from URL segments + SEO_CONFIG. The visible HTML breadcrumb on the page
   * is rendered by the page itself; this prop exists ONLY to keep the
   * JSON-LD BreadcrumbList in lock-step with whatever visible microdata /
   * breadcrumbs the page renders (SOP §四.3 — JSON-LD must match the real
   * navigation). Pass at minimum {position, name, item} tuples; item is
   * the absolute URL (including `https://cnc.bozemetal.com`).
   */
  breadcrumbItems?: BreadcrumbItem[];
  serviceHubKey?: string;
  /** Override the auto-generated hreflang alternate links (e.g. for non-localized campaign pages) */
  alternateLinks?: { lang: string; href: string }[];
  /** Emit <link rel="prev"> for paginated listings */
  prevURL?: string;
  /** Emit <link rel="next"> for paginated listings */
  nextURL?: string;
  /** Emit <meta name="robots" content="noindex, nofollow"> (e.g. thank-you / conversion pages) */
  noindex?: boolean;
  /**
   * F3 — Entity graph @id references. Pass an array of `entity.id` from
   * `data/entities/entity-registry.json`; each is resolved to a schema.org
   * @id + @type reference and emitted under WebPage.mentions in JSON-LD.
   * Recommended for hub pages (industries, capabilities, materials, parts,
   * products) to expose the site's entity vocabulary to LLM crawlers.
   */
  mentions?: string[];
  /**
   * AIO — Speakable CSS selectors. CSS selectors (e.g. `['#aio-thesis-1']`)
   * that target in-page paragraphs AIO is permitted to cite as the
   * authoritative answer for voice / AI-summary features. The selectors
   * MUST match real DOM ids on the rendered page. Recommended: 3-5
   * thesis-first paragraphs at the top of the page.
   */
  speakableSelectors?: string[];
  /**
   * AIO — Comparison-table ItemList. When provided, buildPageGraph emits an
   * additional ItemList entity referencing existing Product @ids with
   * PropertyValue comparison rows. AIO cites such tables for "best X for Y"
   * queries.
   */
  comparisonList?: {
    name: string;
    description?: string;
    items: { '@id': string; name: string; description?: string }[];
    criteria?: { name: string; values: Record<string, string | number> }[];
  };
}

const currentPathname = Astro.url.pathname;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// F6 — Blog translations are independent content (per the user's model):
//   not every `/blog/<slug>/` has a `/<lang>/blog/<slug>/` counterpart. Build
//   a (lang → Set<slug>) map at frontmatter time so hreflang alternates and
//   cross-language links both drop missing mirrors. The same map powers the
//   `rehype-blog-i18n-link.mjs` plugin for markdown anchors.
//
// The 2026-09-17 dead-link audit added EN canonicals under key 'en' —
// without them, LanguageSelector's "English" entry on a DE page emitted
// `/blog/<DE-only-slug>/` hrefs that 404.  The shared `buildBlogMap()`
// helper also reads `src/content/blog/*.md` so callers don't have to.
const blogTranslationMap = await buildBlogMap();

// Drop hreflang alternates pointing at English-only routes — emitting a
// <link rel="alternate" hreflang="de" href="/de/products/"> for a path that
// 404s is a Google violation (alternate must point at a real 200 page).
// Default locale values apply: EN-only paths and EN-only blog slugs (per
// `blogTranslationMap`) keep no alternates at all.  The single unified
// `isRouteAvailableInLang(href, lang, currentLang, blogMap)` handles every
// case: EN-only denylist + cross-language blog availability + self-link
// exemption — so the hreflang output respects the user's "0-link entry"
// rule for ALL paths, including blogs whose translations don't exist.
const defaultAlternateLinks = getAlternateLinks(currentPathname).filter((link) => {
  return isRouteAvailableInLang(link.href, link.lang, currentLang, blogTranslationMap);
});

const {
  title: explicitTitle,
  description: explicitDesc,
  canonicalURL,
  ogImage,
  pubDate,
  author,
  tags,
  pageType: explicitPageType,
  serviceName,
  serviceDescription,
  serviceCategory,
  productName,
  productDescription,
  productImage,
  productCategory,
  productRfqUrl,
  productSku,
  productMaterial,
  productHowto,
  productFaqItems,
  productDeliveryLeadTime,
  toolName,
  toolDescription,
  toolCategory,
  toolSubCategory,
  toolRfqPath,
  articleHeadline,
  articleDescription,
  articleAuthor,
  articleDateModified,
  articleImage,
  articleAbout,
  collectionName,
  collectionDescription,
  itemCount,
  items,
  faqItems,
  faqName,
  howtoItem,
  serviceType,
  serviceAreaServed,
  serviceAdditionalProperty,
  breadcrumbItems: breadcrumbItemsOverride,
  serviceHubKey,
  alternateLinks: explicitAlternateLinks,
  prevURL,
  nextURL,
  noindex = false,
  mentions,
  speakableSelectors,
  comparisonList,
} = Astro.props;

const rawPath = removeLangPrefix(currentPathname);
const canonicalPath = rawPath === '/' ? '/' : rawPath.replace(/\/+$/, '');
const seoEntry = SEO_CONFIG[canonicalPath];
// NOTE: currentLang is typed `Lang` (= string, because LANGUAGES: Record<string, string>),
// while SeoEntry.title/description are fixed-key per-lang objects → cast to their own keys.
const seoTitleFromConfig = seoEntry?.title?.[currentLang as keyof typeof seoEntry.title];
const seoDescFromConfig = seoEntry?.description?.[currentLang as keyof typeof seoEntry.description];
const title = seoTitleFromConfig || explicitTitle || SITE.title;
const description = seoDescFromConfig || explicitDesc || SITE.description;
const siteUrl = SITE.url;
const currentUrl = `${siteUrl}${currentPathname}`;
const canonicalUrl = canonicalURL ? String(canonicalURL) : currentUrl;
const defaultOgImage = `${siteUrl}/uploads/boze-tmc-og-en.png`;
const seoImage = ogImage || defaultOgImage;
const ogLocales: Record<string, string> = { en: 'en_US', de: 'de_DE', zh: 'zh_CN', ja: 'ja_JP', fr: 'fr_FR', es: 'es_ES', pt: 'pt_PT', it: 'it_IT', ko: 'ko_KR', nl: 'nl_NL', pl: 'pl_PL' };
const ogLocale = ogLocales[currentLang] || 'en_US';
const favicon = '/uploads/boze-cnc-ti-ico.png';
const siteName = SITE.title;
const cmsDefaultTheme = 'aerospace-precision';
const fontStyle = 'inter';
const fallbackFont = 'monospace';
const fontConfig = getFontConfig(fontStyle);
const fontUrl = getGoogleFontsUrl(fontConfig);
const fontFamily = getCssFamily(fontConfig, fallbackFont);
const gaId = import.meta.env.PUBLIC_GA_ID || '';
const isProd = import.meta.env.PROD;
const pageType = detectPageType(canonicalPath, explicitPageType);
const homeLabel = t('blog.breadcrumb.home');
const breadcrumbRaw = buildBreadcrumbItems(canonicalPath, SEO_CONFIG, siteUrl, currentLang, homeLabel);
const breadcrumbItems = breadcrumbItemsOverride?.length
  ? breadcrumbItemsOverride
  : breadcrumbRaw.map((item: BreadcrumbItem) => {
      const p = item.item.replace(siteUrl, '').replace(/\/+$/, '');
      const lbl = p ? NAV_LABEL_MAP[p] : undefined;
      return lbl ? { ...item, name: lbl } : item;
    });
const alternateLinks = explicitAlternateLinks || defaultAlternateLinks;

const resolvedServiceName = serviceName ?? ((pageType === 'service-detail' || pageType === 'services-hub') ? title : undefined);
// Phase 2C — case-study pages now use Article (not BlogPosting). Default
// the Article headline to the page title when no explicit headline is passed,
// mirroring the previous blog-post behavior. Both page types derive Article
// from page metadata; the type difference (BlogPosting vs Article) is decided
// in schema.ts switch case.
const resolvedArticleHeadline = articleHeadline ?? ((explicitPageType === 'blog-post' || explicitPageType === 'case-study' || explicitPageType === 'tech-article') ? title : undefined);
const schemaData = {
  pageName: title, pageDescription: description, pageUrl: canonicalUrl, inLanguage: ogLocale.replace('_', '-'),
  breadcrumbItems,
  articleHeadline: resolvedArticleHeadline, articleDescription: articleDescription ?? description, articleAuthor: articleAuthor ?? author,
  articleDatePublished: pubDate ?? undefined, articleDateModified: articleDateModified ?? undefined, articleImage,
  articleAbout,
  serviceName: resolvedServiceName, serviceDescription: serviceDescription ?? (resolvedServiceName ? description : undefined),
  serviceCategory, serviceType, serviceAreaServed, serviceAdditionalProperty, productName, productDescription: productDescription ?? (productName ? description : undefined), productImage, productCategory,
  productRfqUrl, productDatePublished: pubDate ?? null, collectionName: collectionName ?? title, collectionDescription, itemCount, items,
  faqItems, faqName,
  howtoItem,
  mentions,
  speakableSelectors,
  comparisonList,
  // Phase 3 — product-detail entity field overrides (replaces page-level JSON-LD)
  productSku, productMaterial, productHowto, productFaqItems,
  // Phase G-2.2 — Offer.deliveryLeadTime for standard-part-detail Product
  productDeliveryLeadTime,
  // Phase 2C — tool detail (WebApplication)
  toolName, toolDescription, toolCategory, toolSubCategory, toolRfqPath,
};
const pageGraph = buildPageGraph(pageType, schemaData);
const ldJson = JSON.stringify(pageGraph);
---

<!doctype html>
<html lang={currentLang} dir={currentLang === 'ar' ? 'rtl' : 'ltr'}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0" />
{favicon.endsWith('.svg') ? <link rel="icon" type="image/svg+xml" href={favicon} /> : favicon.endsWith('.png') ? <link rel="icon" type="image/png" href={favicon} /> : <link rel="icon" href={favicon} />}
<meta name="generator" content={Astro.generator} />
{/* P0-3D (2026-10-15): Inter font is now self-hosted (4 woff2 files in
    /public/fonts/, ~70 KB total). @font-face declarations live in
    src/styles/global.css (inlined to dist HTML for FCP). Replaces
    the previous async Google Fonts CSS link (P0-3A). Removes the
    200ms Google Fonts CSS round-trip + Google DNS/TCP/TLS handshake
    identified by PSI report k2s2qe9jss. License: SIL OFL 1.1
    (Inter, @fontsource v4.5.0). No more external font dependency
    means no version-pinning risk from Google's CDN.

    P0-3A history (now superseded by P0-3D): the prior
    Google Fonts async preload pattern is no longer needed.
    fontUrl variable is retained for now (used by the
    FontConfig/fallback chain) but the rendered <link> is gone.

    P0-4 (2026-10-16): Preload 600 and 700 weights as well — the home
    hero h1, stats numbers, and CTA buttons all use Tailwind's
    font-bold (700) and font-semibold (600). Without preloading these
    weights, the browser falls back to the synthetic-bold weight
    until the actual woff2 arrives, causing visible font flash on
    the LCP element. Cost: ~37 KB additional preload, no impact on
    layout but eliminates FOUT on the LCP text. */}
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/Inter-400.woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/Inter-600.woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/Inter-700.woff2"
  crossorigin="anonymous"
/>

{/* P0-1 (2026-10-16): LCP image preload for the home page.
    The home page hero image is loaded eagerly by the <picture> element
    inside PremiumHero.astro, but the browser cannot know which image
    a CSS background-image div will fetch. Converting the hero to
    <picture> + <img> (with fetchpriority="high") makes preload possible.
    The webp variant is ~36 KB smaller than the jpg (137 KB vs 173 KB)
    and the small mobile variant (titanium-cnc-machining-manufacturing-facility-750w.webp)
    is generated by postbuild-images.mjs at ~30-40 KB for 750w.
    fetchpriority="high" tells Chromium to deprioritize other same-tab
    resources and start the LCP image fetch as soon as possible. */}
{currentPathname === '/' && (
  <>
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/uploads/titanium-cnc-machining-manufacturing-facility.webp"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/uploads/titanium-cnc-machining-manufacturing-facility-750w.webp"
      fetchpriority="high"
      imagesrcset="/uploads/titanium-cnc-machining-manufacturing-facility-750w.webp 750w, /uploads/titanium-cnc-machining-manufacturing-facility.webp 1920w"
      imagesizes="100vw"
    />
  </>
)}
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteName} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{/* ── Favicon suite (SVG first → PNG ladder → ICO → apple-touch → manifest) ── */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0f172a" />
<meta name="msapplication-TileColor" content="#0f172a" />
<meta name="msapplication-TileImage" content="/android-chrome-192x192.png" />
<link rel="canonical" href={canonicalUrl} />
{prevURL && <link rel="prev" href={`${siteUrl}${prevURL}`} />}
{nextURL && <link rel="next" href={`${siteUrl}${nextURL}`} />}
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={seoImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:image" content={seoImage} />
{pubDate && <meta property="article:published_time" content={pubDate} />}
{author && <meta property="article:author" content={author} />}
{tags && tags.map((tag) => <meta property="article:tag" content={tag} />)}
{/* P0-2 (2026-10-16): KaTeX CSS is now self-hosted at /katex.min.css
    (23.8 KB) and gated by src/lib/page-features.ts. Only pages whose
    source actually contains math syntax ($$ ... $$, \( ... \), \begin{...})
    get the stylesheet. Previously the jsdelivr CDN link was render-
    blocking on every page and added a 3rd-party DNS/TCP/TLS round-trip
    on top of the CSS download. PSI report from 2026-10-16 flagged the
    3rd-party CSS as a render-blocking resource on the home page, which
    has no math content whatsoever. The `media="print" onload=...` async
    pattern is the universally supported standard — Lighthouse honors
    it and the stylesheet still applies after first paint. Math is below
    the fold on every page that uses it, so no FOUC on math rendering. */}
{pageNeedsMath(currentPathname) && (
  <>
    <link
      rel="preload"
      as="style"
      href="/katex.min.css"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="/katex.min.css" /></noscript>
  </>
)}
<script is:inline type="application/ld+json" set:html={ldJson} />
{alternateLinks.map((link) => (<link rel="alternate" hreflang={link.lang} href={`${SITE.url}${link.href}`} />))}
{/* hreflang x-default — always points at the canonical (English) URL so search engines
    have a fallback when no locale-specific alternate matches the user. */}
<link rel="alternate" hreflang="x-default" href={`${SITE.url}${canonicalPath}`} />
<!-- Theme bootstrap: ACTIVE_THEME_ID is injected at build-time from src/config/themes.ts.
     No runtime toggle — change theme by editing themes.ts and rebuilding. -->
<script is:inline define:vars={{ themeId: ACTIVE_THEME_ID }}>document.documentElement.setAttribute('data-theme', themeId);</script>

{/* ══ Google Ads — Consent Mode v2 (GDPR, ePanel-friendly) ══ */}
{isProd && gaId && (
  <>
    <!-- Consent default: always denied until user chooses -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied'
      });
    </script>
    <!-- Google tag (gtag.js) — Google Ads + Google Analytics 4 (shared loader) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', `${gaId}`);
      // Google Analytics 4 (GA4) — traffic analytics, same gtag()/dataLayer as Google Ads
      gtag('config', 'G-HT4X8QR22B');
    </script>
    <!-- Conversion tracking: call gtagReportConversion() on form submit -->
    <script is:inline define:vars={{ gaId }}>
      window.gtagReportConversion = function() {
        if (localStorage.getItem('ad_consent') !== 'granted') return;
        gtag('event', 'conversion', {
          'send_to': `${gaId}/u_IbCPfX6tgcELantrJE`,
          'value': 1.0,
          'currency': 'TWD'
        });
      };
    </script>
  </>
)}
</head>
<body class="flex min-h-screen flex-col antialiased bg-theme-bg text-theme-text transition-colors duration-300" style={`font-family:${fontFamily};--font-primary:${fontFamily};--font-body:${fontFamily};--font-heading:${fontFamily};`}>
<Header currentPathname={currentPathname} />
<main class="flex-1">
<slot />

<BrandAbout />

</main>
<Footer />

<CookieConsent />
</body>
</html>
