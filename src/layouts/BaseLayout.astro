---
import '../styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE } from '@config/site';
import { getFontConfig, getGoogleFontsUrl, getCssFamily } from '@utils/fonts';
import { getLangFromUrl, getAlternateLinks } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  hideThemeSwitcher?: boolean;
}

const currentPathname = Astro.url.pathname;
const currentLang = getLangFromUrl(Astro.url);
const alternateLinks = getAlternateLinks(currentPathname);

const { 
  title = SITE.title, 
  description = SITE.description,
  hideThemeSwitcher = false,
} = Astro.props;

// Static defaults (previously loaded from CMS collections)
const favicon = '/favicon.svg';
const siteName = SITE.title;
const cmsDefaultTheme = 'aerospace-precision';
const fontStyle = 'inter';
const fallbackFont = 'monospace';
const fontConfig = getFontConfig(fontStyle);
const fontUrl = getGoogleFontsUrl(fontConfig);
const fontFamily = getCssFamily(fontConfig, fallbackFont);
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {favicon.endsWith('.svg') ? (
      <link rel="icon" type="image/svg+xml" href={favicon} />
    ) : favicon.endsWith('.png') ? (
      <link rel="icon" type="image/png" href={favicon} />
    ) : (
      <link rel="icon" href={favicon} />
    )}
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts — statically configured -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontUrl} rel="stylesheet" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- ══ hreflang Alternate Links (i18n SEO) ═══════════════ -->
    {alternateLinks.map((link) => (
      <link rel="alternate" hrefLang={link.lang} href={`${SITE.url}${link.href}`} />
    ))}
    <link rel="alternate" hrefLang="x-default" href={`${SITE.url}${currentPathname}`} />

    <!-- ═══════════════════════════════════════════════════════
         THEME SYSTEM — FOUC Prevention (static default theme)
         ═══════════════════════════════════════════════════════ -->
    <script is:inline>
      (function(){
        var theme = 'aerospace-precision';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col antialiased bg-theme-bg text-theme-text transition-colors duration-300"
    style={`font-family: ${fontFamily}; --font-primary: ${fontFamily}; --font-body: ${fontFamily}; --font-heading: ${fontFamily};`}
  >
    <Header currentPathname={currentPathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>