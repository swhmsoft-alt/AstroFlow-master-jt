---
import '../styles/global.css';
import '../styles/rtl.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE, NAVIGATION, type NavItem } from '@config/site';
import { SEO_CONFIG } from '@config/seo';
import { getFontConfig, getGoogleFontsUrl, getCssFamily } from '@utils/fonts';
import { getLangFromUrl, useTranslations, getAlternateLinks, removeLangPrefix } from '../i18n/utils';
import { DEFAULT_LANG } from '../i18n/ui';
import { detectPageType, buildBreadcrumbItems, buildPageGraph, type PageType, type BreadcrumbItem } from '../lib/schema';
import BrandAbout from '@components/home/BrandAbout.astro';
import CookieConsent from '@components/CookieConsent.astro';

// Build path to label map from NAVIGATION for better breadcrumb names
const NAV_LABEL_MAP: Record<string, string> = (() => {
  const m: Record<string, string> = {};
  function walk(items: NavItem[]) {
    for (const item of items) {
      if (item.href) m[item.href.replace(/\/+$/, '')] = item.name;
      if (item.children) {
        for (const g of item.children) {
          for (const c of g.items) {
            if (c.href) m[c.href.replace(/\/+$/, '')] = c.name;
          }
        }
      }
    }
  }
  walk(NAVIGATION);
  return m;
})();

interface Props {
  title?: string;
  description?: string;
  hideThemeSwitcher?: boolean;
  canonicalURL?: string | URL;
  ogImage?: string;
  pubDate?: string | null;
  author?: string;
  tags?: string[];
  pageType?: PageType;
  serviceName?: string;
  serviceCategory?: string;
  productName?: string;
  productImage?: string;
  productCategory?: string;
  collectionName?: string;
  itemCount?: number;
  items?: { name: string; url: string }[];
  serviceHubKey?: string;
  /** Override the auto-generated hreflang alternate links (e.g. for non-localized campaign pages) */
  alternateLinks?: { lang: string; href: string }[];
  /** Emit <link rel="prev"> for paginated listings */
  prevURL?: string;
  /** Emit <link rel="next"> for paginated listings */
  nextURL?: string;
  /** Emit <meta name="robots" content="noindex, nofollow"> (e.g. thank-you / conversion pages) */
  noindex?: boolean;
}

const currentPathname = Astro.url.pathname;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const defaultAlternateLinks = getAlternateLinks(currentPathname);

const {
  title: explicitTitle,
  description: explicitDesc,
  hideThemeSwitcher = false,
  canonicalURL,
  ogImage,
  pubDate,
  author,
  tags,
  pageType: explicitPageType,
  serviceName,
  serviceCategory,
  productName,
  productImage,
  productCategory,
  collectionName,
  itemCount,
  items,
  serviceHubKey,
  alternateLinks: explicitAlternateLinks,
  prevURL,
  nextURL,
  noindex = false,
} = Astro.props;

const rawPath = removeLangPrefix(currentPathname);
const canonicalPath = rawPath === '/' ? '/' : rawPath.replace(/\/+$/, '');
const seoEntry = SEO_CONFIG[canonicalPath];
// NOTE: currentLang is typed `Lang` (= string, because LANGUAGES: Record<string, string>),
// while SeoEntry.title/description are fixed-key per-lang objects → cast to their own keys.
const seoTitleFromConfig = seoEntry?.title?.[currentLang as keyof typeof seoEntry.title];
const seoDescFromConfig = seoEntry?.description?.[currentLang as keyof typeof seoEntry.description];
const title = seoTitleFromConfig || explicitTitle || SITE.title;
const description = seoDescFromConfig || explicitDesc || SITE.description;
const siteUrl = SITE.url;
const currentUrl = `${siteUrl}${currentPathname}`;
const canonicalUrl = canonicalURL ? String(canonicalURL) : currentUrl;
const defaultOgImage = `${siteUrl}/uploads/boze-tmc-og-en.png`;
const seoImage = ogImage || defaultOgImage;
const ogLocales: Record<string, string> = { en: 'en_US', de: 'de_DE', zh: 'zh_CN', ja: 'ja_JP', fr: 'fr_FR', es: 'es_ES', pt: 'pt_PT', it: 'it_IT', ko: 'ko_KR', nl: 'nl_NL', pl: 'pl_PL' };
const ogLocale = ogLocales[currentLang] || 'en_US';
const favicon = '/uploads/boze-cnc-ti-ico.png';
const siteName = SITE.title;
const cmsDefaultTheme = 'aerospace-precision';
const fontStyle = 'inter';
const fallbackFont = 'monospace';
const fontConfig = getFontConfig(fontStyle);
const fontUrl = getGoogleFontsUrl(fontConfig);
const fontFamily = getCssFamily(fontConfig, fallbackFont);
const gaId = import.meta.env.PUBLIC_GA_ID || '';
const isProd = import.meta.env.PROD;
const pageType = detectPageType(canonicalPath, explicitPageType);
const homeLabel = t('blog.breadcrumb.home');
const breadcrumbRaw = buildBreadcrumbItems(canonicalPath, SEO_CONFIG, siteUrl, currentLang, homeLabel);
const breadcrumbItems = breadcrumbRaw.map((item: BreadcrumbItem) => {
  const p = item.item.replace(siteUrl, '').replace(/\/+$/, '');
  const lbl = p ? NAV_LABEL_MAP[p] : undefined;
  return lbl ? { ...item, name: lbl } : item;
});
const alternateLinks = explicitAlternateLinks || defaultAlternateLinks;

const resolvedServiceName = serviceName ?? (pageType === 'service-detail' ? title : undefined);
const schemaData = {
  pageName: title, pageDescription: description, pageUrl: canonicalUrl, inLanguage: ogLocale.replace('_', '-'),
  breadcrumbItems,
  articleHeadline: explicitPageType === 'blog-post' ? title : undefined, articleDescription: description, articleAuthor: author,
  articleDatePublished: pubDate ?? undefined, serviceName: resolvedServiceName, serviceDescription: resolvedServiceName ? description : undefined,
  serviceCategory, productName, productDescription: productName ? description : undefined, productImage, productCategory,
  productDatePublished: pubDate ?? null, collectionName: collectionName ?? title, itemCount, items,
};
const pageGraph = buildPageGraph(pageType, schemaData);
const ldJson = JSON.stringify(pageGraph);
---

<!doctype html>
<html lang={currentLang} dir={currentLang === 'ar' ? 'rtl' : 'ltr'}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0" />
{favicon.endsWith('.svg') ? <link rel="icon" type="image/svg+xml" href={favicon} /> : favicon.endsWith('.png') ? <link rel="icon" type="image/png" href={favicon} /> : <link rel="icon" href={favicon} />}
<meta name="generator" content={Astro.generator} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href={fontUrl} rel="stylesheet" />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteName} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<link rel="icon" type="image/png" href="/uploads/boze-cnc-ti-ico.png" />
<link rel="canonical" href={canonicalUrl} />
{prevURL && <link rel="prev" href={`${siteUrl}${prevURL}`} />}
{nextURL && <link rel="next" href={`${siteUrl}${nextURL}`} />}
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={seoImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:image" content={seoImage} />
{pubDate && <meta property="article:published_time" content={pubDate} />}
{author && <meta property="article:author" content={author} />}
{tags && tags.map((tag) => <meta property="article:tag" content={tag} />)}
<script is:inline type="application/ld+json" set:html={ldJson} />
{alternateLinks.map((link) => (<link rel="alternate" hreflang={link.lang} href={`${SITE.url}${link.href}`} />))}
{/* hreflang alternates — from prop if provided (blog overrides), otherwise auto-generated */}
<link rel="alternate" hreflang="x-default" href={`${SITE.url}${currentPathname}`} />
<script is:inline>(function(){try{var t=localStorage.getItem('titanium-theme');if(t)document.documentElement.setAttribute('data-theme',t);else document.documentElement.setAttribute('data-theme','aerospace-precision')}catch(e){document.documentElement.setAttribute('data-theme','aerospace-precision')}})();</script>

{/* ══ Google Ads — Consent Mode v2 (GDPR, ePanel-friendly) ══ */}
{isProd && gaId && (
  <>
    <!-- Consent default: always denied until user chooses -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied'
      });
    </script>
    <!-- Google tag (gtag.js) — Google Ads + Google Analytics 4 (shared loader) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', `${gaId}`);
      // Google Analytics 4 (GA4) — traffic analytics, same gtag()/dataLayer as Google Ads
      gtag('config', 'G-HT4X8QR22B');
    </script>
    <!-- Conversion tracking: call gtagReportConversion() on form submit -->
    <script is:inline define:vars={{ gaId }}>
      window.gtagReportConversion = function() {
        if (localStorage.getItem('ad_consent') !== 'granted') return;
        gtag('event', 'conversion', {
          'send_to': `${gaId}/u_IbCPfX6tgcELantrJE`,
          'value': 1.0,
          'currency': 'TWD'
        });
      };
    </script>
  </>
)}
</head>
<body class="flex min-h-screen flex-col antialiased bg-theme-bg text-theme-text transition-colors duration-300" style={`font-family:${fontFamily};--font-primary:${fontFamily};--font-body:${fontFamily};--font-heading:${fontFamily};`}>
<Header currentPathname={currentPathname} />
<main class="flex-1">
<slot />

<BrandAbout />

</main>
<Footer />

<CookieConsent />
</body>
</html>
