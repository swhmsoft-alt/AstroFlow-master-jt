  'waterjet-cutting': {
    title: 'Waterjet Cutting',
    badge: 'Fabrication',
    subtitle: 'Cold-cutting process for titanium without heat-affected zones.',
  },
  'raw-material-preparation-sizing': {
    title: 'Raw Material Preparation & Sizing',
    badge: 'Forming & Heavy',
    subtitle: 'Material preparation and precision sizing for downstream processing.',
  },
  'titanium-extrusion': {
    title: 'Titanium Extrusion',
    badge: 'Forming & Heavy',
    subtitle: 'Hot extrusion of titanium profiles and shapes.',
  },
  'titanium-forging': {
    title: 'Titanium Forging',
    badge: 'Forming & Heavy',
    subtitle: 'Hot and cold forging of titanium for high-strength components.',
  },
  'anodizing': {
    title: 'Anodizing',
    badge: 'Surface Treatment',
    subtitle: 'Electrochemical surface treatment for enhanced corrosion resistance.',
  },
  'chemical-passivation': {
    title: 'Chemical Passivation',
    badge: 'Surface Treatment',
    subtitle: 'Chemical treatment to remove surface contaminants and enhance passivity.',
  },
  'polishing-sandblasting': {
    title: 'Polishing & Sandblasting',
    badge: 'Surface Treatment',
    subtitle: 'Mechanical surface finishing for aesthetic and functional requirements.',
  },
};

/* 提取子页面键名 */
function getSubPageKey(slugStr: string): string | null {
  const parts = slugStr.split('/');
  if (parts.length >= 2) {
    return parts[parts.length - 1];
  }
  return null;
}

/* 获取 subpage 元数据 */
let subMeta: { title: string; badge: string; subtitle: string } | null = null;
if (slug) {
  const subKey = getSubPageKey(slug);
  if (subKey && subPageMeta[subKey]) {
    subMeta = subPageMeta[subKey];
  }
}

const meta = slug ? pageMeta[slug] : undefined;
const pageTitle = subMeta?.title || meta?.title || slug || 'Home';
const pageBadge = subMeta?.badge || meta?.badge || '';
const pageSubtitle = subMeta?.subtitle || meta?.subtitle || '';
const pageHighlight = meta?.highlight || '';
---

<!-- ============================================================= -->
<!-- 首页 -->
<!-- ============================================================= -->
{
  isHome && (
    <BaseLayout>
      <PremiumHero hero={heroData} />
      <ServicesOverview />
      <TechnicalCapabilities />
      <MaterialMatrix />
      <IndustryApplications />
      <EngineeringResources />
      <PremiumCTA />
    </BaseLayout>
  )
}

<!-- ============================================================= -->
<!-- Services 页面 -->
<!-- ============================================================= -->
{
  slug === 'services' && (
    <BaseLayout>
      <SubpageHero
        title={pageTitle}
        highlight={pageHighlight}
        badge={pageBadge}
        badgeIcon="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z"
        subtitle={pageSubtitle}
      />
      <ServiceMatrixGrid />
      <ComplianceRibbon />
      <EngineeringWorkflow />
      <QuickIndustrySolutions />
    </BaseLayout>
  )
}

<!-- ============================================================= -->
<!-- 其他已知页面（统一 SubpageHero 布局） -->
<!-- ============================================================= -->
{
  !isHome && slug !== 'services' && !isServiceSubPage && meta && (
    <BaseLayout>
      <SubpageHero
        title={pageTitle}
        highlight={pageHighlight}
        badge={pageBadge}
        subtitle={pageSubtitle}
      />
      <slot />
    </BaseLayout>
  )
}

<!-- ============================================================= -->
<!-- 页面未找到时的优雅降级 -->
<!-- ============================================================= -->
{
  !isHome && !meta && !subMeta && (
    <BaseLayout>
      <SubpageHero
        title={slug || ''}
        highlight=""
        badge=""
        subtitle={t('[lang].Slug].page_is_being_prepared_please')}
      />
      <div class="container mx-auto px-4 py-20 text-center">
        <p class="text-xl text-gray-500">Coming soon: {slug}</p>
      </div>
    </BaseLayout>
  )
}
---
</write_to_file>