    title: 'Custom Industrial Components',
    badge: 'CNC Machining',
    subtitle: 'Bespoke industrial components manufactured to your exact specifications.',
  },
  'wire-edm-machining': {
    title: 'Wire EDM Machining',
    badge: 'CNC Machining',
    subtitle: 'Wire electrical discharge machining for intricate shapes and hard materials.',
  },
  'laser-cutting': {
