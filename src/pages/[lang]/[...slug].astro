import { LANGUAGES, DEFAULT_LANG } from '../../i18n/ui';
import { HERO_CONFIG } from '../../config/hero';

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
  // 排除默认语言(en)，因为根目录已有独立的 .astro 页面处理英语路由
  // 避免英语同时通过 /en/ 前缀生成重复URL
  const supportedLangs = Object.keys(LANGUAGES).filter(l => l !== DEFAULT_LANG);
  const knownSlugs: string[] = [
    'services', 'capabilities', 'materials', 'industries', 'resources',
    'documentation', 'facilities', 'rfq', 'use-cases',
    'branded-custom-packaging-services', 'laser-marking-custom-logo',
    'titanium-additive-manufacturing', 'titanium-cnc-machining-services',
    'titanium-fabrication-services', 'titanium-forming-heavy-manufacturing',
    'titanium-surface-treatment',
  ];
  const deepSlugs: string[] = [
    'titanium-additive-manufacturing/3d-printing-slm',
    'titanium-additive-manufacturing/low-volume-production',
    'titanium-additive-manufacturing/rapid-prototyping',
    'titanium-cnc-machining-services/3-5-axis-cnc-machining',
    'titanium-cnc-machining-services/cnc-milling-turning',
    'titanium-cnc-machining-services/custom-industrial-components',
    'titanium-cnc-machining-services/wire-edm-machining',
    'titanium-fabrication-services/laser-cutting',
    'titanium-fabrication-services/titanium-welding-assembly',
    'titanium-fabrication-services/waterjet-cutting',
    'titanium-forming-heavy-manufacturing/raw-material-preparation-sizing',
    'titanium-forming-heavy-manufacturing/titanium-extrusion',
    'titanium-forming-heavy-manufacturing/titanium-forging',
    'titanium-surface-treatment/anodizing',
    'titanium-surface-treatment/chemical-passivation',
    'titanium-surface-treatment/polishing-sandblasting',
  ];
  const allSlugs = [...knownSlugs, ...deepSlugs];
  const paths: GetStaticPathsResult = [];
  for (const lang of supportedLangs) {
    paths.push({ params: { lang, slug: undefined } });
    for (const slug of allSlugs) {
      paths.push({ params: { lang, slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang?: string; slug?: string };
const currentLang = isSupportedLang(lang) ? lang as string : DEFAULT_LANG;
const t = useTranslations(currentLang);
const pageId = resolveContentId(slug);
const { data: pageData } = await getLocalizedContent(pageId, currentLang);

const isHome = !slug || slug === '';
const isServiceSubPage =
  slug?.includes('titanium-additive-manufacturing/') ||
  slug?.includes('titanium-cnc-machining-services/') ||
  slug?.includes('titanium-fabrication-services/') ||
  slug?.includes('titanium-forming-heavy-manufacturing/') ||
  slug?.includes('titanium-surface-treatment/') ||
  slug === 'branded-custom-packaging-services' ||
  slug === 'laser-marking-custom-logo';

const heroEntry = HERO_CONFIG[`/${slug || ''}` as keyof typeof HERO_CONFIG] || undefined;

// tH1 helper: returns translated value if found, null otherwise (t() returns key as fallback)
const tH1 = (key: string) => {
  const val = t(key);
  return val && val !== key ? val : null;
};

// Translation-aware hero values for home page (isHome)
const homeH1 = currentLang === 'en'
  ? heroEntry?.h1
  : (tH1('hero.home.h1') || heroEntry?.h1);
const homeBadge = currentLang === 'en'
  ? heroEntry?.badge
  : (tH1('hero.home.badge') || heroEntry?.badge);
const homeSubtitle = currentLang === 'en'
  ? heroEntry?.subtitle
  : (tH1('hero.home.subtitle') || heroEntry?.subtitle);

const heroData: Record<string, any> = {
  badge: isHome ? (homeBadge || '') : (pageData.badge || t('home.mainHero.badge')),
  title: pageData.title || t('home.mainHero.title'),
  highlight: pageData.highlight || t('home.mainHero.titleHighlight'),
  h1: isHome ? homeH1 : (heroEntry?.h1 || null),
  description: isHome ? (homeSubtitle || pageData.description || t('home.mainHero.subtitle')) : (pageData.description || t('home.mainHero.subtitle')),
  primaryCta: t('hero.cta'),
  primaryCtaLink: pageData.primaryCtaLink || 'https://www.bozemetal.com/contact',
  secondaryCta: t('hero.cta.secondary'),
  secondaryCtaLink: pageData.secondaryCtaLink || '/services',
  heroMediaType: pageData.heroMediaType || 'image',
  stats: pageData.stats || [
    { value: t('home.mainHero.stat0.value'), label: t('home.mainHero.stat0.label') },
    { value: t('home.mainHero.stat1.value'), label: t('home.mainHero.stat1.label') },
    { value: t('home.mainHero.stat2.value'), label: t('home.mainHero.stat2.label') },
    { value: '15+', label: 'Facilities' },
  ],
};

// Hero translation keys for t() - allows per-language hero text
const pageMetaKeys: Record<string, { title: string; highlight: string; badge: string; subtitle: string }> = {
  services: { title:'services.hero.title', highlight:'services.hero.highlight', badge:'services.hero.badge', subtitle:'services.hero.subtitle' },
  capabilities: { title:'capabilities.hero.title', highlight:'capabilities.hero.highlight', badge:'capabilities.hero.badge', subtitle:'capabilities.hero.subtitle' },
  materials: { title:'materials.title', highlight:'materials.highlight', badge:'materials.badge', subtitle:'materials.subtitle' },
  industries: { title:'industries.hero.title', highlight:'industries.hero.highlight', badge:'industries.hero.badge', subtitle:'industries.hero.subtitle' },
  resources: { title:'resources.hero.title', highlight:'resources.hero.highlight', badge:'resources.hero.badge', subtitle:'resources.hero.subtitle' },
  documentation: { title:'documentation.hero.title', highlight:'documentation.hero.highlight', badge:'documentation.hero.badge', subtitle:'documentation.hero.subtitle' },
  facilities: { title:'facilities.hero.title', highlight:'facilities.hero.highlight', badge:'facilities.hero.badge', subtitle:'facilities.hero.subtitle' },
  rfq: { title:'rfq.hero.title', highlight:'rfq.hero.highlight', badge:'rfq.hero.badge', subtitle:'rfq.hero.subtitle' },
  'use-cases': { title:'use-cases.hero.title', highlight:'use-cases.hero.highlight', badge:'use-cases.hero.badge', subtitle:'use-cases.hero.subtitle' },
  'branded-custom-packaging-services': { title:'branded-custom-packaging-services.hero.title', highlight:'branded-custom-packaging-services.hero.highlight', badge:'branded-custom-packaging-services.hero.badge', subtitle:'branded-custom-packaging-services.hero.subtitle' },
  'laser-marking-custom-logo': { title:'laser-marking-custom-logo.hero.title', highlight:'laser-marking-custom-logo.hero.highlight', badge:'laser-marking-custom-logo.hero.badge', subtitle:'laser-marking-custom-logo.hero.subtitle' },
  'titanium-additive-manufacturing': { title:'titanium-additive-manufacturing.hero.title', highlight:'titanium-additive-manufacturing.hero.highlight', badge:'titanium-additive-manufacturing.hero.badge', subtitle:'titanium-additive-manufacturing.hero.subtitle' },
  'titanium-cnc-machining-services': { title:'titanium-cnc-machining-services.hero.title', highlight:'titanium-cnc-machining-services.hero.highlight', badge:'titanium-cnc-machining-services.hero.badge', subtitle:'titanium-cnc-machining-services.hero.subtitle' },
  'titanium-fabrication-services': { title:'titanium-fabrication-services.hero.title', highlight:'titanium-fabrication-services.hero.highlight', badge:'titanium-fabrication-services.hero.badge', subtitle:'titanium-fabrication-services.hero.subtitle' },
  'titanium-forming-heavy-manufacturing': { title:'titanium-forming-heavy-manufacturing.hero.title', highlight:'titanium-forming-heavy-manufacturing.hero.highlight', badge:'titanium-forming-heavy-manufacturing.hero.badge', subtitle:'titanium-forming-heavy-manufacturing.hero.subtitle' },
  'titanium-surface-treatment': { title:'titanium-surface-treatment.hero.title', highlight:'titanium-surface-treatment.hero.highlight', badge:'titanium-surface-treatment.hero.badge', subtitle:'titanium-surface-treatment.hero.subtitle' },
};

const subPageMeta: Record<string, { title: string; badge: string; subtitle: string }> = {
  '3d-printing-slm': { title:'3D Printing (SLM / DMLS)', badge:'Additive Manufacturing', subtitle:'Selective Laser Melting for complex titanium geometries.' },
  'low-volume-production': { title:'Low-Volume Production', badge:'Additive Manufacturing', subtitle:'Efficient low-volume production using additive.' },
  'rapid-prototyping': { title:'Rapid Prototyping', badge:'Additive Manufacturing', subtitle:'Fast iteration prototyping.' },
  '3-5-axis-cnc-machining': { title:'3/5-Axis CNC Machining', badge:'CNC Machining', subtitle:'Multi-axis CNC machining for complex geometries.' },
  'cnc-milling-turning': { title:'CNC Milling & Turning', badge:'CNC Machining', subtitle:'Precision milling and turning.' },
  'custom-industrial-components': { title:'Custom Industrial Components', badge:'CNC Machining', subtitle:'Bespoke industrial components.' },
  'wire-edm-machining': { title:'Wire EDM Machining', badge:'CNC Machining', subtitle:'Wire EDM for intricate shapes.' },
  'laser-cutting': { title:'Laser Cutting', badge:'Fabrication', subtitle:'High-precision laser cutting for sheet and tube.' },
  'titanium-welding-assembly': { title:'Titanium Welding & Assembly', badge:'Fabrication', subtitle:'Expert TIG/MIG welding.' },
  'waterjet-cutting': { title:'Waterjet Cutting', badge:'Fabrication', subtitle:'Cold-cutting without heat-affected zones.' },
  'raw-material-preparation-sizing': { title:'Raw Material Preparation & Sizing', badge:'Forming & Heavy', subtitle:'Material preparation and sizing.' },
  'titanium-extrusion': { title:'Titanium Extrusion', badge:'Forming & Heavy', subtitle:'Hot extrusion of titanium profiles.' },
  'titanium-forging': { title:'Titanium Forging', badge:'Forming & Heavy', subtitle:'Hot and cold forging.' },
  'anodizing': { title:'Anodizing', badge:'Surface Treatment', subtitle:'Electrochemical surface treatment.' },
  'chemical-passivation': { title:'Chemical Passivation', badge:'Surface Treatment', subtitle:'Chemical treatment for surface contaminants.' },
  'polishing-sandblasting': { title:'Polishing & Sandblasting', badge:'Surface Treatment', subtitle:'Mechanical surface finishing.' },
};

function getSubPageKey(slugStr: string): string | null {
  const parts = slugStr.split('/');
  return parts.length >= 2 ? parts[parts.length - 1] : null;
}

let subMeta: { title: string; badge: string; subtitle: string } | null = null;
if (slug) {
  const subKey = getSubPageKey(slug);
  if (subKey && subPageMeta[subKey]) subMeta = subPageMeta[subKey];
}

// Compute hero values (slug-based pages only) - heroEntry already declared above for home page
// Build i18n translation keys based on HERO_CONFIG path
const heroKey = slug ? `hero.${slug.replace(/\//g, '.')}` : '';

let pageH1: string | undefined;
let pageBadge: string | undefined;
let pageSubtitle: string | undefined;
let pageTitle: string | undefined;
let pageHighlight: string | undefined;

if (heroEntry) {
  // This page is in HERO_CONFIG - hero.ts is the English source of truth
  // For non-English, try translation, fallback to hero.ts English
  if (currentLang === 'en') {
    pageH1 = heroEntry.h1;
    pageBadge = heroEntry.badge;
    pageSubtitle = heroEntry.subtitle;
  } else {
    pageH1 = tH1(`${heroKey}.h1`) || heroEntry.h1;
    pageBadge = tH1(`${heroKey}.badge`) || heroEntry.badge;
    pageSubtitle = tH1(`${heroKey}.subtitle`) || heroEntry.subtitle;
  }
  // title/highlight not needed - h1 replaces them
} else {
  // Fallback: use existing i18n/subMeta logic
  const metaKeys = slug ? pageMetaKeys[slug] : undefined;
  pageTitle = subMeta?.title || (metaKeys ? t(metaKeys.title) : slug || 'Home');
  pageBadge = subMeta?.badge || (metaKeys ? t(metaKeys.badge) : '');
  pageSubtitle = subMeta?.subtitle || (metaKeys ? t(metaKeys.subtitle) : '');
  pageHighlight = metaKeys ? t(metaKeys.highlight) : '';
}
---

