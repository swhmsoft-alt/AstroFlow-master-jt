---
import { LANGUAGES, DEFAULT_LANG } from '../../../i18n/ui';

export async function getStaticPaths() {
  const langCodes = Object.keys(LANGUAGES).filter(l => l !== DEFAULT_LANG);
  return langCodes.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=/${lang}/tools/`} />
    <title>Engineering Tools — Redirect</title>
  </head>
  <body>
    <p>Redirecting to <a href={`/${lang}/tools/`}>Engineering Tools</a>...</p>
  </body>
</html>
