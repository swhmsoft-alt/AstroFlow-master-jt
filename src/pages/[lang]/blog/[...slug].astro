---
/**
 * [lang]/blog/[...slug].astro
 *
 * Per-language blog article page.
 * Routes are generated ONLY from existing blog-translations entries.
 * Each language is fully independent — no English fallback.
 * Hreflang alternates are filtered to only include languages
 * that actually have a translation for this slug.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogAuthorBlock from '../../../components/blog/BlogAuthorBlock.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath } from '../../../i18n/utils';
import { DEFAULT_LANG } from '../../../i18n/ui';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

export async function getStaticPaths() {
  const allTranslations = await getCollection('blog-translations');

  // Group translations by originalSlug to know available languages per article
  const slugMap = new Map<string, { lang: string }[]>();
  for (const t of allTranslations) {
    const slug = t.data.originalSlug;
    if (!slugMap.has(slug)) {
      slugMap.set(slug, []);
    }
    slugMap.get(slug)!.push({ lang: t.data.lang });
  }

  const paths = [];
  for (const [slug, entries] of slugMap) {
    // availableLangs = all languages that have this slug translated
    const availableLangs = entries.map(e => e.lang);
    for (const entry of entries) {
      paths.push({
        params: { lang: entry.lang, slug },
        props: { availableLangs },
      });
    }
  }
  return paths;
}

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { availableLangs = [] } = Astro.props;

// Load the translation entry for this language
const allTranslations = await getCollection('blog-translations');
const translationEntry = allTranslations.find(
  t => t.data.lang === lang && t.data.originalSlug === slug
);

// If no translation exists for this language, 404
if (!translationEntry) {
  return Astro.redirect('/404');
}

const renderEntry = translationEntry;
const data = translationEntry.data;

const { Content, headings } = await renderEntry.render();

// Build filtered alternate links: only include languages that have this article
const filteredAlternateLinks = [
  // English version (handled by src/pages/blog/[...slug].astro)
  { lang: DEFAULT_LANG, href: `/blog/${slug}` },
  // Each non-English language that has a translation for this slug
  ...availableLangs
    .filter((l: string) => l !== DEFAULT_LANG)
    .map((l: string) => ({ lang: l, href: `/${l}/blog/${slug}` })),
];

const tocHeadings = headings.filter((h: any) => h.depth === 2);
const pubDateISO = data.pubDate ? new Date(data.pubDate).toISOString() : null;
const seoTitle = `${data.title} | Boze Titanium Manufacturing Center Blog`;
const tags = data.tags || [];
const blogUrl = `https://cnc.bozemetal.com/${lang === 'en' ? '' : lang + '/'}blog/${slug}`;

// Load internal-link matrix (SoT: data/related-links.json, see scripts/build-related-links.mjs)
// For i18n routes, the file name is "{lang}-{slug}.md" but Astro routes use originalSlug,
// so the related-links.json key for this entry is "{lang}-{originalSlug}".
const __filenameI18n = fileURLToPath(import.meta.url);
const __rootI18n = path.resolve(path.dirname(__filenameI18n), '../../../../');
let relatedEdges: any[] = [];
try {
  const rlPath = path.resolve(__rootI18n, 'data/related-links.json');
  if (fs.existsSync(rlPath)) {
    const all = JSON.parse(fs.readFileSync(rlPath, 'utf-8'));
    const i18nKey = `${lang}-${slug}`;
    relatedEdges = Array.isArray(all?.links?.[i18nKey]) ? all.links[i18nKey] : [];
  }
} catch (e) { /* graceful degradation */ }
const relatedHubs = relatedEdges.filter(e => e.type === 'hub');
const relatedI18n = relatedEdges.filter(e => e.type === 'i18n');
const relatedMore = relatedEdges.filter(e => e.type === 'related');
const hasRelated = relatedEdges.length > 0;
---

<BaseLayout
  title={seoTitle}
  description={data.description}
  pubDate={pubDateISO}
  author={data.author}
  tags={tags.length > 0 ? tags : undefined}
  ogImage={data.coverImage ? `https://cnc.bozemetal.com${data.coverImage}` : undefined}
  alternateLinks={filteredAlternateLinks}
  pageType="blog-post"
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label={t('blog.Slug].breadcrumb')} style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizePath('/', lang)} itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('blog.breadcrumb.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizePath('/blog', lang)} itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('blog.breadcrumb.blog')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{data.title}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Article Header -->
  <section class="py-12 lg:py-16" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {data.coverImage && (
        <div class="relative rounded-2xl overflow-hidden shadow-xl mb-10 aspect-2/1 max-w-5xl mx-auto" style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
          <img src={data.coverImage} alt={data.coverImageAlt || data.title} class="w-full h-full object-cover" width="1200" height="600" />
        </div>
      )}
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          {data.category && (
            <span class="inline-block px-3 py-1 text-sm font-semibold rounded-full" style="background: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">
              {data.category}
            </span>
          )}
          {tags.slice(0, 3).map((tag: string) => (
            <span class="inline-block px-2.5 py-0.5 text-xs rounded-full" style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent); color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
              #{tag}
            </span>
          ))}
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 leading-tight" style="color: var(--theme-text);">
          {data.title}
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-sm pb-8 border-b mb-8" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="flex items-center">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold mr-2" style="background: linear-gradient(to bottom right, var(--theme-primary), var(--theme-accent)); color: var(--theme-text);">
              {data.author.charAt(0)}
            </div>
            <span class="font-medium" style="color: color-mix(in srgb, var(--theme-text) 85%, transparent);">{data.author}</span>
          </div>
          <span style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);">|</span>
          <time datetime={pubDateISO || ''} class="flex items-center">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            {new Date(data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>
    </div>
  </section>

  <!-- Article Content + TOC -->
  <section class="py-8 lg:py-12" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:gap-12">
        <article class="blog-content flex-1 min-w-0 max-w-4xl">
          <Content />

          <!-- Author Block: Full at Article End -->
          <BlogAuthorBlock variant="full" />
        </article>
        {tocHeadings.length > 0 && (
          <aside class="lg:w-72 xl:w-80 flex-shrink-0">
            <div class="lg:sticky lg:top-28">
              <!-- Author Block: Sidebar (top) -->
              <BlogAuthorBlock variant="sidebar" />
              <div class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                <div class="flex items-center mb-4">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--theme-primary);">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                  </svg>
                  <h3 class="text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">{t('blog.toc.title')}</h3>
                </div>
                <nav aria-label={t('blog.Slug].table_of_contents')}>
                  <ul class="space-y-1">
                    {tocHeadings.map((heading: any, index: number) => {
                      const id = heading.text.toLowerCase().replace(/[^\w]+/g, '-').replace(/(^-|-$)/g, '');
                      return (
                        <li>
                          <a href={`#${id}`} class="group flex items-start py-1.5 text-sm transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
                            <span class="toc-number w-5 h-5 flex items-center justify-center rounded-full text-xs font-bold mr-2 flex-shrink-0 transition-colors" style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent); color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
                              {index + 1}
                            </span>
                            <span class="leading-snug">{heading.text}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </nav>
              </div>
              <div class="mt-6 rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                <h3 class="text-sm font-bold uppercase tracking-wider mb-4" style="color: var(--theme-text);">{t('blog.share.title')}</h3>
                <div class="flex space-x-3">
                  <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(data.title)}&url=${encodeURIComponent(blogUrl)}`} target="_blank" rel="noopener noreferrer" class="share-btn w-10 h-10 flex items-center justify-center rounded-lg transition-all" style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent); color: color-mix(in srgb, var(--theme-text) 45%, transparent);" aria-label="Share on Twitter">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
                  </a>
                  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(blogUrl)}`} target="_blank" rel="noopener noreferrer" class="share-btn w-10 h-10 flex items-center justify-center rounded-lg transition-all" style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent); color: color-mix(in srgb, var(--theme-text) 45%, transparent);" aria-label="Share on LinkedIn">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
                  </a>
                  <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(blogUrl)}`} target="_blank" rel="noopener noreferrer" class="share-btn w-10 h-10 flex items-center justify-center rounded-lg transition-all" style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent); color: color-mix(in srgb, var(--theme-text) 45%, transparent);" aria-label="Share on Facebook">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg>
                  </a>
                </div>
              </div>
              <div class="mt-6">
                <a href={localizePath('/blog', lang)} class="back-to-blog flex items-center justify-center w-full px-4 py-3 text-sm font-semibold rounded-xl transition-all shadow-md" style="background: var(--theme-primary); color: var(--theme-text);">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m7 7l-7-7 7-7" /></svg>
                  {t('blog.back')}
                </a>
              </div>

            </div>
          </aside>
        )}
      </div>
    </div>
  </section>

  <!-- Related Articles (internal-link matrix, SoT: data/related-links.json) -->
  {hasRelated && (
    <section class="py-12 lg:py-16" style="background: color-mix(in srgb, var(--theme-surface) 60%, var(--theme-bg) 40%); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-center mb-6">
            <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--theme-primary);">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <h2 class="text-2xl font-bold" style="color: var(--theme-text);">Related Articles</h2>
          </div>

          {relatedHubs.length > 0 && (
            <div class="mb-6">
              <h3 class="text-sm font-bold uppercase tracking-wider mb-3" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                Popular in {data.category}
              </h3>
              <ul class="grid gap-3 md:grid-cols-2">
                {relatedHubs.map((e: any) => (
                  <li>
                    <a href={e.href || '/blog/'} class="related-card group flex items-start p-4 rounded-xl border transition-all hover:shadow-md" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                      <span class="related-badge mr-3 mt-1 px-2 py-0.5 text-xs font-bold rounded-full flex-shrink-0" style="background: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">
                        Hub
                      </span>
                      <span class="flex-1 min-w-0">
                        <span class="block font-semibold leading-snug mb-1 transition-colors group-hover:underline" style="color: var(--theme-text);">
                          {e.label}
                        </span>
                        <span class="block text-xs" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
                          {e.cluster}
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {relatedI18n.length > 0 && (
            <div class="mb-6">
              <h3 class="text-sm font-bold uppercase tracking-wider mb-3" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                Available in other languages
              </h3>
              <ul class="flex flex-wrap gap-2">
                {relatedI18n.map((e: any) => (
                  <li>
                    <a href={e.href || '/blog/'} class="related-i18n inline-flex items-center px-3 py-2 text-sm rounded-lg border transition-colors hover:shadow" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-text);">
                      <span class="font-mono text-xs uppercase mr-2 px-1.5 py-0.5 rounded" style="background: color-mix(in srgb, var(--theme-accent) 18%, transparent); color: var(--theme-text);">
                        {e.lang || 'i18n'}
                      </span>
                      <span class="font-medium">{e.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {relatedMore.length > 0 && (
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider mb-3" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                You may also like
              </h3>
              <ul class="grid gap-3 md:grid-cols-2">
                {relatedMore.map((e: any) => (
                  <li>
                    <a href={e.href || '/blog/'} class="related-card group flex items-start p-4 rounded-xl border transition-all hover:shadow-md" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                      <span class="related-badge mr-3 mt-1 px-2 py-0.5 text-xs font-bold rounded-full flex-shrink-0" style="background: color-mix(in srgb, var(--theme-accent) 18%, transparent); color: var(--theme-text);">
                        Related
                      </span>
                      <span class="flex-1 min-w-0">
                        <span class="block font-semibold leading-snug mb-1 transition-colors group-hover:underline" style="color: var(--theme-text);">
                          {e.label}
                        </span>
                        <span class="block text-xs" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
                          {e.cluster}
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="relative py-24 overflow-hidden" style="background: var(--theme-surface); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background: radial-gradient(circle at 30% 50%, color-mix(in srgb, var(--theme-primary) 30%, transparent) 0%, transparent 50%), radial-gradient(circle at 70% 50%, color-mix(in srgb, var(--theme-accent) 30%, transparent) 0%, transparent 50%);"></div>
    </div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center" style="color: var(--theme-text);">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">{t('blog.cta.title')}</h2>
        <p class="text-xl mb-10" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{t('blog.cta.subtitle')}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/rfq/" target="_blank" rel="noopener noreferrer" class="cta-primary inline-flex items-center px-8 py-4 font-bold rounded-xl shadow-2xl transition-all text-lg" style="background: var(--theme-primary); color: var(--theme-text);">
            {t('blog.cta.quote')}
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
          <a href={localizePath('/blog', lang)} class="cta-secondary inline-flex items-center px-8 py-4 border-2 font-bold rounded-xl transition-all text-lg" style="border-color: color-mix(in srgb, var(--theme-text) 30%, transparent); color: var(--theme-text);">
            {t('blog.cta.moreArticles')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Structured Data: BaseLayout's buildPageGraph already emits Article
       (linked to the Legal Organization by @id). No duplicate BlogPosting. -->
</BaseLayout>

<style is:global>
  html { scroll-behavior: smooth; }
  nav[aria-label="Breadcrumb"] a:hover { color: var(--theme-primary) !important; }
  .toc-number.group-hover\:bg-blue-100, .group:hover .toc-number { background: color-mix(in srgb, var(--theme-primary) 15%, transparent) !important; color: var(--theme-primary) !important; }
  .toc-link:hover, nav[aria-label="Table of contents"] a:hover { color: var(--theme-primary) !important; }
  .share-btn:hover { color: white !important; }
  .share-btn[aria-label="Share on Twitter"]:hover { background: #1DA1F2 !important; }
  .share-btn[aria-label="Share on LinkedIn"]:hover { background: #0A66C2 !important; }
  .share-btn[aria-label="Share on Facebook"]:hover { background: #1877F2 !important; }
  .back-to-blog:hover { background: color-mix(in srgb, var(--theme-primary) 80%, #000) !important; }
  .cta-primary:hover { background: color-mix(in srgb, var(--theme-primary) 80%, #000) !important; }
  .cta-secondary:hover { border-color: color-mix(in srgb, var(--theme-text) 50%, transparent) !important; }
