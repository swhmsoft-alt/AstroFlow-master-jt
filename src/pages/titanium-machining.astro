---
// =============================================================================
// Google Ads Landing Page — "Titanium Machining Services"
// Conversion-focused, keyword-dense B2B landing page.
// English-only campaign page (no localized variants required).
// =============================================================================
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroRfq from '../components/landing/HeroRfq.astro';
import TrustBadges from '../components/landing/TrustBadges.astro';
import Capabilities from '../components/landing/Capabilities.astro';
import QualityControl from '../components/landing/QualityControl.astro';
import Applications from '../components/landing/Applications.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import StickyCta from '../components/landing/StickyCta.astro';

// ── SEO: page title & meta description (Google Ads Quality Score optimized) ──
const pageTitle = 'Precision Titanium CNC Machining Services | AS9100D Certified';
const pageDescription =
  'ISO 9001 & AS9100D certified custom titanium machining. Tight tolerances to ±0.005mm for aerospace & medical parts. Get an instant quote within 24 hours!';
const canonicalUrl = 'https://cnc.bozemetal.com/titanium-machining/';

// ── Supplementary JSON-LD: Service + ManufacturingPlant + OfferCatalog ──
// The Organization / WebSite / WebPage / BreadcrumbList / Service entities are
// auto-generated by BaseLayout via buildPageGraph() (pageType="service-detail").
// This additional graph strengthens "ManufacturingPlant" + 5-Axis CNC relevance
// signals for Google Ads (Quality Score) and organic indexing.
const landingSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: 'Precision Titanium CNC Machining Services',
      serviceType: 'CNC Machining',
      provider: {
        '@type': 'ManufacturingPlant',
        name: 'Boze Titanium Manufacturing Center',
        url: 'https://www.bozemetal.com',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Baoji',
          addressRegion: 'Shaanxi',
          addressCountry: 'CN',
        },
      },
      description:
        'Custom 5-axis titanium machining services for Grade 5, Ti-6Al-4V ELI, and high-precision aerospace and medical components.',
      areaServed: 'Worldwide',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Titanium Machining Capabilities',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: '5-Axis Titanium Milling & Turning',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Medical & Aerospace Titanium Components',
            },
          },
        ],
      },
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalUrl}
  pageType="service-detail"
  serviceName="Precision Titanium CNC Machining Services"
  serviceCategory="CNC Machining"
  alternateLinks={[{ lang: 'en', href: '/titanium-machining/' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(landingSchema)} />

  <!-- ================= Landing page sections ================= -->
  <HeroRfq />
  <TrustBadges />
  <Capabilities />
  <QualityControl />
  <Applications />
  <FinalCta />
  <StickyCta />
</BaseLayout>
