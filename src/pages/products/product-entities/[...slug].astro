---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegacyEntityContent from '../../../components/product/LegacyEntityContent.astro';
import RichEntityContent from '../../../components/product/RichEntityContent.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('product-entities');
  return entries.map((entry) => ({
    params: { slug: entry.slug || entry.id?.replace(/\.(json|md)$/, '') || '' },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;

const seoTitle = data.seoTitle || `${data.title} | ${data.material} | Boze Titanium Manufacturing Center`;
const seoDesc = data.seoDescription || `${data.title} — ${data.function}. Engineering specs, failure analysis, and manufacturing process. AS9100D & ISO 9001.`;

// Load related entities (shared knowledge nodes)
const allSystems = await getCollection('systems');
const systemSlug = data.system?.toLowerCase().replace(/ & /g, '-').replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');
const system = allSystems.find(s => s.data.title === data.system);

// Try to find material page
const allMaterials = await getCollection('materials');
const matSlug = data.material?.toLowerCase().replace(/ /g, '-').replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');
const matClean = data.material?.toLowerCase().replace(/[^a-z0-9]/g, '');
const material = allMaterials.find(m => {
  const mClean = m.data.title?.toLowerCase().replace(/[^a-z0-9]/g, '');
  if (!matClean || !mClean) return false;
  // Direct include check
  if (matClean.includes(mClean) || mClean.includes(matClean)) return true;
  // Token overlap: split into meaningful segments
  const matTokens = matClean.split(/grade|ti|astm/).filter(Boolean);
  const mTokens = mClean.split(/grade|ti|astm/).filter(Boolean);
  return matTokens.some(t => t.length > 3 && mTokens.some(mt => mt.includes(t) || t.includes(mt)));
});

// Better matching: prefer direct title inclusion, avoid false positives
const materialBetter = allMaterials.find(m => {
  const mTitle = m.data.title?.toLowerCase() || '';
  const matLower = data.material?.toLowerCase() || '';
  // Direct title match (preferred)
  if (matLower.includes(mTitle) || mTitle.includes(matLower)) return true;
  // Strong token overlap (ratio >0.4, ignoring very short tokens)
  const mSearch = mTitle.replace(/[^a-z0-9]/g, '');
  const matSearch = matLower.replace(/[^a-z0-9]/g, '');
  const matTokens = matSearch.split(/grade|ti|astm|al/).filter(Boolean).filter(t => t.length > 3);
  const mTokens = mSearch.split(/grade|ti|astm|al/).filter(Boolean).filter(t => t.length > 3);
  return matTokens.some(t => mTokens.some(mt => {
    const longer = t.length >= mt.length ? t : mt;
    const shorter = t.length >= mt.length ? mt : t;
    return longer.includes(shorter) && shorter.length / longer.length > 0.4;
  }));
});


// Use better matched material (prefer direct title match over fuzzy)
const bestMatchedMaterial = materialBetter || material;

// Material slug mapping: content slug → material page slug (direct link, no redirect)
const MATERIAL_SLUG_MAP: Record<string, string> = {
  'grade-5-ti-6al-4v': 'grade-5',
  'grade-23-ti-6al-4v-eli': 'grade-23',
  'grade-1-cp-ti': 'grade-1',
  'grade-2-cp-ti': 'grade-2',
  'grade-3-cp-ti': 'grade-3',
  'grade-4-cp-ti': 'grade-4',
  'beta-c-ti-3al-8v-6cr-4mo-4zr': 'grade-19',
  'grade-9-ti-3al-25v': 'grade-9',
  'ti-1023-ti-10v-2fe-3al': 'ti-5553',
  'ti-15v-3cr-3sn-3al': 'grade-21',
  'ti-5al-25sn-eli': 'grade-6',
  'ti-6242-ti-6al-2sn-4zr-2mo': 'grade-6242',
};
const matContentSlug = bestMatchedMaterial?.slug || bestMatchedMaterial?.id?.replace('.json', '') || '';
const materialPageSlug = MATERIAL_SLUG_MAP[matContentSlug] || matContentSlug;



// Load capabilities (linked, not duplicated)
const allCaps = await getCollection('capabilities');
const relatedCaps = allCaps.filter(c => {
  const cid = c?.slug || c?.id?.replace('.json', '') || '';
  return cid && data.relatedCapabilities?.some((rc: string) => cid.includes(rc.replace(/[^a-z0-9-]/g, '')));
});

// Related products
const allProducts = await getCollection('product-entities');
const relatedProducts = allProducts.filter(p => {
  const pid = p.slug || p.id?.replace('.json', '') || '';
  return data.relatedProducts?.includes(pid);
});

// FAQ
const faqData = data.faq || [];

// Load matching product spec for rich blueprint injection
const allSpecs = await getCollection('product-specs');
const specSlug = entry.slug || entry.id?.replace(/\.(json|md)$/, '').split('/').pop();
const specEntry = allSpecs.find(s => s.slug === specSlug);
let SpecContent;
if (specEntry) {
  const rendered = await specEntry.render();
  SpecContent = rendered.Content;
}

// JSON-LD
const schemaProduct = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": data.title,
      "sku": data.sku || specEntry?.data?.sku || '',
      "description": data.seoDescription || data.function,
      "category": data.category,
      "material": data.material,
      "manufacturer": { "@type": "Organization", "name": "Boze Titanium Manufacturing Center" },
      "brand": { "@type": "Brand", "name": "BOZE" },
      "offers": {
        "@type": "Offer",
        "price": "Inquire",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      },
      ...(system ? { "isRelatedTo": { "@type": "Product", "name": system.data.title }, "isPartOf": { "@type": "Product", "name": data.industry } } : { "isPartOf": { "@type": "Product", "name": data.industry } })
    },
    {
      "@type": "HowTo",
      "name": `Manufacturing ${data.title}`,
      "step": ((specEntry?.data?.manufacturing_process ? specEntry.data.manufacturing_process.split(', ') : (data.process || [])).map((p: string, i: number) => ({
        "@type": "HowToStep", "position": i + 1, "text": p.trim()
      })))
    }
  ]
};
// Use spec FAQ when available, fall back to JSON FAQ
const schemaFaqData = specEntry?.data?.faq || faqData;
if (schemaFaqData.length > 0) {
  (schemaProduct["@graph"] as any[]).push({
    "@type": "FAQPage",
    "mainEntity": schemaFaqData.map((f: any) => ({
      "@type": "Question", "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  });
}

// CTA industry-tailored text
const ctaByIndustry: Record<string, { lead: string; btn: string }> = {
  'Medical Device': {
    lead: `Need a custom ${data.title.toLowerCase()} for your surgical instrument set? Send us your drawings — our ISO 13485-certified team responds within 24 hours.`,
    btn: `Request Medical Manufacturing Quote for ${data.title}`
  },
  'Consumer Electronics': {
    lead: `Ready to prototype ${data.title.toLowerCase()}? Upload your CAD model — our engineering team provides DFM feedback within 24 hours.`,
    btn: `Request DFM Analysis & Quote for ${data.title}`
  },
  'Cycling / Bicycle': {
    lead: `Looking for a lightweight ${data.title.toLowerCase()}? Send us your design specs — our cycling component specialists respond within 24 hours.`,
    btn: `Request Quote for ${data.title}`
  },
  'Semiconductor': {
    lead: `Need ${data.title.toLowerCase()} for your semiconductor process tool? Send your specifications — our cleanroom manufacturing team responds within 24 hours.`,
    btn: `Request UHV Manufacturing Quote for ${data.title}`
  },
  'Aerospace & Defense': {
    lead: `Need an AS9100D-certified ${data.title.toLowerCase()}? Send your print or model — our aerospace engineering team responds within 24 hours.`,
    btn: `Request Aerospace Manufacturing Quote for ${data.title}`
  },
};
const industryKey = Object.keys(ctaByIndustry).find(k => (data.industry || '').startsWith(k));
const industryCta = industryKey ? ctaByIndustry[industryKey] : undefined;
const ctaLead = industryCta?.lead || `Need a custom ${data.title.toLowerCase()}? Send us your drawings — our engineering team responds within 24 hours.`;
const ctaBtn = industryCta?.btn || `Request Quote for ${data.title}`;
---

<BaseLayout title={seoTitle} description={seoDesc}>
  <!-- Breadcrumb -->
  <nav class="border-b" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">Home</span></a>
          <meta itemprop="position" content="1" />
          <span style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"> / </span>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/products" itemprop="item" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">Products</span></a>
          <meta itemprop="position" content="2" />
          <span style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"> / </span>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/products/product-entities/" itemprop="item" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">Component Library</span></a>
          <meta itemprop="position" content="3" />
          <span style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"> / </span>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" style="color: var(--theme-text); font-weight:600;">{data.title}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Scene description: unique product intro paragraph (SEO differentiator) -->
  {data.sceneDescription && (
    <section class="py-6 lg:py-8" style="background: var(--theme-bg);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-sm leading-relaxed max-w-4xl" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          {data.sceneDescription}
        </p>
      </div>
    </section>
  )}

  {specEntry && <RichEntityContent SpecContent={SpecContent} data={data} specEntry={specEntry} materialSlug={materialPageSlug} />}

{!specEntry && <LegacyEntityContent data={data} system={system} material={material} allCaps={allCaps} faqData={faqData} />}

  <!-- ── SECTION 4: Shared Knowledge Links (30% — lean, no duplication) ── -->
  <section class="py-10 border-t" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold mb-6" style="color: var(--theme-text);">Related Knowledge</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {data.material && material && (
          <a href={`/products/materials/${bestMatchedMaterial?.slug || bestMatchedMaterial?.id?.replace(".json","") || ""}/`} class="block p-4 rounded-xl border transition-all" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <p class="text-xs font-semibold" style="color: var(--theme-primary);">Material</p>
            <p class="text-sm font-bold mt-1" style="color: var(--theme-text);">{data.material.replace(/\(.*\)/, '').trim()}</p>
          </a>
        )}
        {relatedCaps.slice(0, 3).map(c => (
          <a href={`/products/capabilities/${c?.slug || c?.id?.replace(".json","") || ""}/`} class="block p-4 rounded-xl border transition-all" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <p class="text-xs font-semibold" style="color: var(--theme-primary);">Capability</p>
            <p class="text-sm font-bold mt-1" style="color: var(--theme-text);">{c.data.title}</p>
            <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{c.data.category}</p>
          </a>
        ))}
        {system && (
          <a href={`/products/systems/${system?.slug || system?.id?.replace('.json','') || ''}/`} class="block p-4 rounded-xl border transition-all" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <p class="text-xs font-semibold" style="color: var(--theme-primary);">System</p>
            <p class="text-sm font-bold mt-1" style="color: var(--theme-text);">{system.data.title}</p>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ── SECTION 5: Related Components (same system) ── -->
  {relatedProducts.length > 0 && (
    <section class="py-10" style="background: var(--theme-surface);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-lg font-bold mb-6" style="color: var(--theme-text);">Related Components</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
          {relatedProducts.slice(0, 10).map(p => (
            <a href={`/products/product-entities/${p?.slug || p?.id?.replace(".json","") || ""}/`} class="block p-3 rounded-xl border text-sm" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
              <p class="font-semibold leading-tight" style="color: var(--theme-text);">{p.data.title}</p>
              <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{p.data.material?.split(' ').slice(0, 2).join(' ')}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── SECTION 6: CTA (industry-tailored) ── -->
  <section class="py-12 text-center" style="background: var(--theme-bg);">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm mb-4" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
        {ctaLead}
      </p>
      <a href="/contact" class="inline-flex items-center px-6 py-3 text-sm font-bold rounded-xl transition-all" style="background: var(--theme-primary); color: var(--theme-text);">
        {ctaBtn}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(schemaProduct)} />
<script is:inline>
(function() {
  var headings = document.querySelectorAll('article.prose h2, article.prose h3');
  var map = {
    'supply': 'supply-chain',
    'application': 'application',
    'manufacturing': 'manufacturing',
    'faq': 'faq-section',
    'graph': 'knowledge-graph',
    'classification': 'knowledge-graph',
    'specifications': 'tech-specs'
  };
  headings.forEach(function(h) {
    var text = h.textContent.toLowerCase().trim();
    for (var key in map) {
      if (text.indexOf(key) === 0) {
        h.id = map[key];
        break;
      }
    }
  });
})();
</script>
</BaseLayout>
