---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('product-entities');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const seoTitle = data.seoTitle || `${data.title} | ${data.material} | Titanium Component | BOZE CNC Ti`;
const seoDesc = data.seoDescription || `${data.title} - ${data.function}. Manufactured from ${data.material} via ${(data.process || []).join(', ')}. AS9100D & ISO 9001 certified.`;

// Load related
const allSystems = await getCollection('systems');
const system = allSystems.find(s => s.slug === data.system?.toLowerCase().replace(/ /g, '-').replace(/[^a-z0-9-]/g, ''));
const allCaps = (await getCollection('capabilities')).filter(c => data.relatedCapabilities?.includes(c.slug));
const allProducts = (await getCollection('product-entities')).filter(p => data.relatedProducts?.includes(p.slug));

const faqData = data.faq || [];
const schemaProduct = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": data.title,
      "description": data.function,
      "category": data.category,
      "material": data.material,
      "manufacturer": { "@type": "Organization", "name": "BOZE CNC Ti" }
    },
    {
      "@type": "HowTo",
      "name": `How to Manufacture ${data.title}`,
      "step": (data.process || []).map((p, i) => ({
        "@type": "HowToStep",
        "position": i + 1,
        "text": p
      }))
    }
  ]
};
if (faqData.length > 0) {
  schemaProduct["@graph"].push({
    "@type": "FAQPage",
    "mainEntity": faqData.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  });
}
---

<BaseLayout title={seoTitle} description={seoDesc}>
  <nav class="border-b" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm">
        <li><a href="/" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Home</a> / </li>
        <li><a href="/products" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Products</a> / </li>
        <li><span class="font-semibold" style="color: var(--theme-text);">{data.title}</span></li>
      </ol>
    </div>
  </nav>

  <section class="py-16 lg:py-20" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h1 class="text-3xl md:text-5xl font-bold mb-4" style="color: var(--theme-text);">{data.title}</h1>
          <p class="text-lg mb-8" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{data.function}</p>
          
          <table class="w-full text-sm">
            <tbody>
              <tr><td class="py-2 font-semibold" style="color: var(--theme-text);">Category</td><td style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{data.category}</td></tr>
              <tr><td class="py-2 font-semibold" style="color: var(--theme-text);">Industry</td><td style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{data.industry}</td></tr>
              <tr><td class="py-2 font-semibold" style="color: var(--theme-text);">Material</td><td style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{data.material}</td></tr>
              <tr><td class="py-2 font-semibold" style="color: var(--theme-text);">Process</td><td style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{(data.process || []).join(', ')}</td></tr>
              {data.surfaceTreatment && data.surfaceTreatment.length > 0 && (
                <tr><td class="py-2 font-semibold" style="color: var(--theme-text);">Surface</td><td style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{data.surfaceTreatment.join(', ')}</td></tr>
              )}
              {data.standards && data.standards.length > 0 && (
                <tr><td class="py-2 font-semibold" style="color: var(--theme-text);">Standards</td><td style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{data.standards.join(', ')}</td></tr>
              )}
            </tbody>
          </table>
        </div>
        <div class="p-8 rounded-2xl border" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
          <h2 class="text-xl font-bold mb-4" style="color: var(--theme-text);">Why Titanium?</h2>
          <p style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{data.alloyReason}</p>
          
          <h3 class="font-bold mt-6 mb-2" style="color: var(--theme-text);">Manufacturing Process</h3>
          <ul class="space-y-1">
            {(data.process || []).map((p: string) => (
              <li class="flex items-start gap-2 text-sm" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                <span style="color: var(--theme-primary);">▸</span> {p}
              </li>
            ))}
          </ul>

          {data.inspection && data.inspection.length > 0 && (
            <>
              <h3 class="font-bold mt-6 mb-2" style="color: var(--theme-text);">Inspection</h3>
              <ul class="space-y-1">
                {data.inspection.map((i: string) => (
                  <li class="flex items-start gap-2 text-sm" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                    <span style="color: var(--theme-primary);">▸</span> {i}
                  </li>
                ))}
              </ul>
            </>
          )}

          {data.commonFailures && data.commonFailures.length > 0 && (
            <>
              <h3 class="font-bold mt-6 mb-2" style="color: var(--theme-text);">Common Failures</h3>
              <ul class="space-y-1">
                {data.commonFailures.map((f: string) => (
                  <li class="flex items-start gap-2 text-sm" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                    <span style="color: var(--theme-primary);">▸</span> {f}
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  {allCaps.length > 0 && (
    <section class="py-12" style="background: var(--theme-bg);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold mb-6" style="color: var(--theme-text);">Related Capabilities</h2>
        <div class="flex flex-wrap gap-3">
          {allCaps.map((c) => (
            <a href={`/products/capabilities/${c.slug}/`} class="px-4 py-2 rounded-full text-sm border" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-text);">{c.data.title}</a>
          ))}
        </div>
      </div>
    </section>
  )}

  {allProducts.length > 0 && (
    <section class="py-12" style="background: var(--theme-surface);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold mb-6" style="color: var(--theme-text);">Related Components</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {allProducts.map((p) => (
            <a href={`/products/product-entities/${p.slug}/`} class="block p-4 rounded-xl border" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
              <h3 class="font-semibold" style="color: var(--theme-text);">{p.data.title}</h3>
              <p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">{p.data.function?.slice(0, 100)}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {faqData.length > 0 && (
    <section class="py-16" style="background: var(--theme-bg);">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold mb-8" style="color: var(--theme-text);">FAQ</h2>
        <div class="space-y-4">
          {faqData.map((item: {q:string, a:string}) => (
            <details class="p-5 rounded-xl border" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
              <summary class="font-semibold cursor-pointer" style="color: var(--theme-text);">{item.q}</summary>
              <p class="mt-3 text-sm" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-16 text-center" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/contact" class="inline-flex items-center px-8 py-4 font-bold rounded-xl transition-all" style="background: var(--theme-primary); color: var(--theme-text);">Request Quote for {data.title}</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(schemaProduct)} />
</BaseLayout>
