---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { GRADE_DATA } from '../../../data/titanium-grades';

export const prerender = true;

interface EntityRef {
  title: string;
  system: string;
  material: string;
}

// Load all product-entities at build time
const entityGlob = import.meta.glob('/src/content/product-entities/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const allEntities: EntityRef[] = Object.values(entityGlob).map((e: any) => ({
  title: e.title || '',
  system: e.system || '',
  material: e.material || '',
}));

// Build cross-reference: material title -> { systemNames, componentTitles }
function buildMaterialRef(materials: any[]): Map<string, { systems: Set<string>; components: string[] }> {
  const refMap = new Map<string, { systems: Set<string>; components: string[] }>();

  for (const mat of materials) {
    const title = mat.data.title;
    const lowerTitle = title.toLowerCase().trim();
    const ref = { systems: new Set<string>(), components: [] as string[] };

    for (const ent of allEntities) {
      const entMat = (ent.material || '').toLowerCase().trim();

      let matched = entMat.includes(lowerTitle);

      // Special cases — handle format mismatches
      if (!matched) {
        if (lowerTitle.includes('grade 23') && (entMat.includes('6al-4v eli') || entMat.includes('astm f136'))) {
          if (!entMat.includes('grade 5')) matched = true;
        }
        if (lowerTitle.includes('nitinol') && entMat.includes('nitinol')) matched = true;
        if (lowerTitle.includes('ti-65') && entMat.includes('ti-65')) matched = true;
        if (lowerTitle.includes('6al-7nb') && entMat.includes('6al-7nb')) matched = true;
        if (lowerTitle.includes('5al-2.5sn') && entMat.includes('5al-2.5sn')) matched = true;
        if (lowerTitle.includes('grade 4') && entMat.includes('grade 4')) matched = true;
      }

      if (matched && ent.system) {
        ref.systems.add(ent.system);
        ref.components.push(ent.title);
      }
    }

    refMap.set(title, ref);
  }
  return refMap;
}

// Map content entry ID -> GRADE_DATA key via file-slug prefix matching
function findGradeKeyById(entryId: string): string | null {
  for (const key of Object.keys(GRADE_DATA)) {
    if (entryId === key || entryId.startsWith(key + '-')) {
      return key;
    }
  }
  return null;
}

// Extract "Tensile Strength" and "Yield Strength" properties specifically
function findKeyProps(properties: any[] | undefined): { tensile?: string; yield?: string; other: any[] } {
  const result: { tensile?: string; yield?: string; other: any[] } = { other: [] };
  if (!properties) return result;

  for (const p of properties) {
    const label = (p.label || '').toLowerCase();
    if (label.includes('tensile')) {
      if (!result.tensile || label.includes('min')) result.tensile = p.value;
    } else if (label.includes('yield')) {
      if (!result.yield || label.includes('min')) result.yield = p.value;
    } else {
      result.other.push(p);
    }
  }
  return result;
}

// Simplify long system names for display
const SYS_SHORT: Record<string, string> = {
  "Aerospace Structural Components & Airframe Hardware": "Aerospace Structures",
  "Medical Implants & Surgical Instruments": "Medical Implants",
  "Consumer & Lifestyle Products": "Consumer & Lifestyle",
  "Premium Consumer Electronics & Wearables": "Consumer Electronics",
  "Automotive Performance & Racing Components": "Automotive & Racing",
  "Marine & Subsea Engineering Components": "Marine & Subsea",
  "Oil & Gas Downhole & Production Hardware": "Oil & Gas",
  "Chemical Processing & Industrial Equipment": "Chemical Processing",
  "Semiconductor & Vacuum Processing Hardware": "Semiconductor",
  "Defense & Ordnance Components": "Defense & Ordnance",
  "Nuclear & Advanced Energy Systems": "Nuclear & Energy",
  "Sports & Recreation Equipment": "Sports & Recreation",
  "Optical & Precision Instrumentation": "Optical Instruments",
  "Additive Manufacturing & 3D Printing": "Additive Mfg",
};

const materials = await getCollection('materials');
const refMap = buildMaterialRef(materials);

// Augment each material with GRADE_DATA and entity counts
const allEnriched = materials.map(m => {
  const gradeKey = findGradeKeyById(m.id);
  const grade = gradeKey ? GRADE_DATA[gradeKey] : null;
  const ref = refMap.get(m.data.title) || { systems: new Set<string>(), components: [] };
  const props = grade?.hasProperty?.properties ? findKeyProps(grade.hasProperty.properties) : { other: [] };
  return { ...m, grade, gradeKey, ref, props };
});

// Filter: only show materials that have matched systems or components
const enriched = allEnriched.filter((m: any) => m.ref.systems.size > 0 || m.ref.components.length > 0);

// Categorize
const categories = ['Commercially Pure', 'Alpha-Beta Alloy', 'Near-Alpha Alloy', 'Beta Alloy', 'Intermetallic', 'Shape Memory Alloy'];
const grouped: Record<string, typeof enriched> = {};
for (const cat of categories) {
  const items = enriched.filter((m: any) => m.data.category === cat);
  if (items.length > 0) grouped[cat] = items;
}

// Category styling
const catColor: Record<string, string> = {
  'Commercially Pure': '#10b981',
  'Alpha-Beta Alloy': '#3b82f6',
  'Near-Alpha Alloy': '#f59e0b',
  'Beta Alloy': '#8b5cf6',
  'Intermetallic': '#ef4444',
  'Shape Memory Alloy': '#ec4899',
};
const catShort: Record<string, string> = {
  'Commercially Pure':'CP','Alpha-Beta Alloy':'Alpha-Beta','Near-Alpha Alloy':'Near-Alpha',
  'Beta Alloy':'Beta','Intermetallic':'Intermetallic','Shape Memory Alloy':'Shape Memory',
};
const catDesc: Record<string, string> = {
  'Commercially Pure': 'Unalloyed titanium, excellent corrosion resistance and formability.',
  'Alpha-Beta Alloy': 'Workhorse alloys balancing strength, toughness, and weldability.',
  'Near-Alpha Alloy': 'High-temperature creep resistance for aerospace engines.',
  'Beta Alloy': 'Ultra-high strength, excellent spring-back for fasteners.',
  'Intermetallic': 'Lightweight, high-temperature capability for turbine applications.',
  'Shape Memory Alloy': 'Superelasticity and shape memory effect for medical devices.',
};
---

<style>
  .mat-card {
    background-color: var(--theme-bg);
    border: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);
    transition: border-color 300ms, box-shadow 300ms;
  }
  .mat-card:hover {
    box-shadow: 0 0 30px color-mix(in srgb, var(--theme-primary) 12%, transparent);
  }
  .mat-card:hover .mat-card-title {
    color: var(--theme-primary);
  }
  .mat-card-title {
    color: var(--theme-text);
    transition: color 300ms;
  }
  .mat-list-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .cat-tab {
    background: color-mix(in srgb, var(--theme-bg) 100%, transparent);
    border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);
    color: var(--theme-text);
    transition: border-color 300ms, color 300ms;
  }
  .cat-tab:hover {
    border-color: var(--theme-primary);
    color: var(--theme-primary);
  }
</style>

<BaseLayout
  title="Titanium Materials Library - {enriched.length} Alloys | BOZE CNC Ti"
  description="Browse {enriched.length} titanium alloys with matched systems and components. Complete mechanical property data."
>
  <nav class="border-b" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">Home</span></a>
          <meta itemprop="position" content="1" />
          <span style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"> / </span>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/products" itemprop="item" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">Products</span></a>
          <meta itemprop="position" content="2" />
          <span style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"> / </span>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" style="font-weight:600;color:var(--theme-text);">Materials</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>

  <section class="py-12 lg:py-16" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-3" style="color: var(--theme-text);">Titanium Materials Library</h1>
      <p class="text-lg mb-10 max-w-3xl" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
        {enriched.length} titanium alloys — from commercially pure grades for chemical processing to advanced beta alloys for aerospace and medical-grade ELI for implants.
      </p>

      <!-- Category Tabs -->
      <div class="flex flex-wrap gap-2 mb-8">
        {Object.keys(grouped).map(cat => {
          const count = grouped[cat].length;
          return (
            <a href={`#${cat.toLowerCase().replace(/\s+/g, '-')}`} class="cat-tab px-4 py-2 text-sm font-medium rounded-full border">
              {catShort[cat]} ({count})
            </a>
          );
        })}
      </div>

      <!-- Material Groups -->
      {Object.entries(grouped).map(([cat, items]) => (
        <div id={cat.toLowerCase().replace(/\s+/g, '-')} class="mb-16 last:mb-0">
          <!-- Category Header -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-1.5 h-8 rounded-full" style="background: {catColor[cat]};"></div>
            <div>
              <h2 class="text-2xl font-bold" style="color: var(--theme-text);">{cat}</h2>
              <p class="text-sm mt-0.5" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{catDesc[cat]}</p>
            </div>
            <span class="ml-auto text-xs font-semibold px-3 py-1.5 rounded-full" style="background: color-mix(in srgb, {catColor[cat]} 12%, transparent); color: {catColor[cat]};">{items.length} {items.length === 1 ? 'alloy' : 'alloys'}</span>
          </div>

          <!-- Card Grid -->
          <div class="grid sm:grid-cols-2 gap-5">
            {(items as any[]).map((entry: any) => {
              const d = entry.data;
              const grade = entry.grade;
              const gradeKey = entry.gradeKey;
              const ref = entry.ref;
              const props = entry.props;

              const href = gradeKey ? `/materials/${gradeKey}/` : `/products/materials/${entry.id}/`;

              const keyChar = grade?.entityDefinition?.keyCharacteristics?.[0] || null;
              const sysCount = ref.systems.size;
              const compCount = ref.components.length;
              const accentColor = catColor[cat] || 'var(--theme-primary)';

              // Build system & component lists (max 4 shown)
              const sysList = [...ref.systems].slice(0, 4);
              const sysMore = sysCount - 4;
              const compList = ref.components.slice(0, 4);
              const compMore = compCount - 4;

              return (
                <a href={href} class="mat-card group relative rounded-xl p-6">
                  <!-- Top row: badge + title -->
                  <div class="flex items-start justify-between gap-3 mb-3">
                    <div>
                      <span class="inline-block text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md mb-2"
                        style="background: color-mix(in srgb, {accentColor} 12%, transparent); color: {accentColor};"
                      >{catShort[cat]}</span>
                      <h3 class="mat-card-title text-base font-bold leading-snug">{d.title}</h3>
                    </div>
                    <svg class="w-5 h-5 mt-1 shrink-0 transition-all group-hover:translate-x-0.5" style="color: color-mix(in srgb, var(--theme-text) 30%, transparent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </div>

                  <!-- Key characteristic -->
                  {keyChar && (
                    <div class="relative pl-4 mb-4 border-l-2" style="border-color: color-mix(in srgb, {accentColor} 30%, transparent);">
                      <p class="text-xs leading-relaxed italic" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
                        "{keyChar}"
                      </p>
                    </div>
                  )}

                  <!-- Systems list -->
                  {sysList.length > 0 && (
                    <div class="mb-3">
                      <div class="text-xs font-bold uppercase tracking-wider mb-1.5" style="color: {accentColor};">Systems ({sysCount})</div>
                      <ul class="space-y-1">
                        {sysList.map((s: string) => (
                          <li class="flex items-center gap-1.5 text-xs leading-tight" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
                            <span class="mat-list-dot" style="background: {accentColor};"></span>
                            {SYS_SHORT[s] || s.replace(/&/g, 'and')}
                          </li>
                        ))}
                        {sysMore > 0 && (
                          <li class="text-xs font-medium" style="color: color-mix(in srgb, var(--theme-primary) 50%, transparent);">+{sysMore} more</li>
                        )}
                      </ul>
                    </div>
                  )}

                  <!-- Components list -->
                  {compList.length > 0 && (
                    <div class="mb-4">
                      <div class="text-xs font-bold uppercase tracking-wider mb-1.5" style="color: {accentColor};">Components ({compCount})</div>
                      <ul class="space-y-1">
                        {compList.map((c: string) => {
                          const display = c.replace(/^titanium\s*/i, '').replace(/\b(titanium)\b/gi, '').replace(/^\s*-\s*/, '').trim() || c;
                          return (
                            <li class="flex items-center gap-1.5 text-xs leading-tight" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
                              <span class="mat-list-dot" style="background: color-mix(in srgb, {accentColor} 60%, transparent);"></span>
                              {display}
                            </li>
                          );
                        })}
                        {compMore > 0 && (
                          <li class="text-xs font-medium" style="color: color-mix(in srgb, var(--theme-primary) 50%, transparent);">+{compMore} more</li>
                        )}
                      </ul>
                    </div>
                  )}

                  <!-- Key property specs -->
                  <div class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
                    {props.tensile && (
                      <span><span class="font-medium" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">Tensile:</span> {props.tensile}</span>
                    )}
                    {props.yield && (
                      <span><span class="font-medium" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">Yield:</span> {props.yield}</span>
                    )}
                    {props.other.slice(0, 2).map((p: any) => (
                      <span><span class="font-medium" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{p.label.split('(')[0].trim().replace(/\s\(min\).*$/, '')}:</span> {p.value}</span>
                    ))}
                    {/* Fallback for materials without GRADE_DATA */}
                    {!grade && d.tensileStrength && <span><span class="font-medium">Tensile:</span> {d.tensileStrength}</span>}
                    {!grade && d.yieldStrength && <span><span class="font-medium">Yield:</span> {d.yieldStrength}</span>}
                    {!grade && !props.tensile && !d.tensileStrength && (
                      <>
                        <span><span class="font-medium">Density:</span> {d.density || '—'}</span>
                        <span><span class="font-medium">Elong:</span> {d.elongation || '—'}</span>
                      </>
                    )}
                  </div>

                  <!-- Bottom CTA -->
                  <div class="mt-4 pt-3 border-t flex items-center text-xs font-semibold transition-all"
                    style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent); color: {accentColor};"
                  >
                    <span>View Details</span>
                    <svg class="w-3.5 h-3.5 ml-1.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "CollectionPage",
    "name": "Titanium Materials Library",
    "description": `${enriched.length} titanium alloys with matched systems and components`
  })} />
</BaseLayout>