---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { GRADE_DATA } from '../../../data/titanium-grades';
import { SITE } from '../../../config/site';
import { hubMentionsForCategory } from '../../../lib/hub-mentions';

export const prerender = true;

interface EntityRef {
  title: string;
  system: string;
  material: string;
}

// Load all product-entities at build time
const entityGlob = import.meta.glob('/src/content/product-entities/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const allEntities: EntityRef[] = Object.values(entityGlob).map((e: any) => ({
  title: e.title || '',
  system: e.system || '',
  material: e.material || '',
}));

// Build cross-reference: material title -> { systemNames, componentTitles }
function buildMaterialRef(materials: any[]): Map<string, { systems: Set<string>; components: string[] }> {
  const refMap = new Map<string, { systems: Set<string>; components: string[] }>();

  for (const mat of materials) {
    const title = mat.data.title;
    const lowerTitle = title.toLowerCase().trim();
    const ref = { systems: new Set<string>(), components: [] as string[] };

    for (const ent of allEntities) {
      const entMat = (ent.material || '').toLowerCase().trim();

      let matched = entMat.includes(lowerTitle);

      // Special cases — handle format mismatches
      if (!matched) {
        if (lowerTitle.includes('grade 23') && (entMat.includes('6al-4v eli') || entMat.includes('astm f136'))) {
          if (!entMat.includes('grade 5')) matched = true;
        }
        if (lowerTitle.includes('nitinol') && entMat.includes('nitinol')) matched = true;
        if (lowerTitle.includes('ti-65') && entMat.includes('ti-65')) matched = true;
        if (lowerTitle.includes('6al-7nb') && entMat.includes('6al-7nb')) matched = true;
        if (lowerTitle.includes('5al-2.5sn') && entMat.includes('5al-2.5sn')) matched = true;
        if (lowerTitle.includes('grade 4') && entMat.includes('grade 4')) matched = true;
      }

      if (matched && ent.system) {
        ref.systems.add(ent.system);
        ref.components.push(ent.title);
      }
    }

    refMap.set(title, ref);
  }
  return refMap;
}

// Map content entry ID -> GRADE_DATA key via file-slug prefix matching
function findGradeKeyById(entryId: string): string | null {
  for (const key of Object.keys(GRADE_DATA)) {
    if (entryId === key || entryId.startsWith(key + '-')) {
      return key;
    }
  }
  return null;
}

// Extract "Tensile Strength" and "Yield Strength" properties specifically
function findKeyProps(properties: any[] | undefined): { tensile?: string; yield?: string; other: any[] } {
  const result: { tensile?: string; yield?: string; other: any[] } = { other: [] };
  if (!properties) return result;

  for (const p of properties) {
    const label = (p.label || '').toLowerCase();
    if (label.includes('tensile')) {
      if (!result.tensile || label.includes('min')) result.tensile = p.value;
    } else if (label.includes('yield')) {
      if (!result.yield || label.includes('min')) result.yield = p.value;
    } else {
      result.other.push(p);
    }
  }
  return result;
}

const materials = await getCollection('materials');

// FAQ items — also rendered as visible accordion on the page
const faqItems = [
  { question: 'How many titanium alloys are in this materials library?', answer: 'The library catalogs 30+ titanium alloys organized by metallurgical class — Commercially Pure (Grade 1, 2, 3, 4), Alpha-Beta (Grade 5 Ti-6Al-4V, Grade 5 ELI, Grade 9, Grade 23), Near-Alpha (Grade 6, Ti-6242), Beta (Ti-10V-2Fe-3Al, Beta-C), Intermetallic (TiAl, Gamma-MET), and Shape Memory (Nitinol Ni-Ti).' },
  { question: 'What certifications are available for these titanium alloys?', answer: 'Every alloy in the library is available with EN 10204 Type 3.1 mill certification, AS9102 first-article inspection, and full batch traceability per ASTM E415 spectrometric analysis. Aerospace grades are AS9100D and NADCAP-compliant. Medical grades meet ASTM F136 (Ti-6Al-4V ELI) and ISO 5832-3 biocompatibility per ISO 10993.' },
  { question: 'How are alloys classified in this library?', answer: 'Alloys are organized by microstructural class — Commercially Pure (CP-Ti grades 1-4 with varying oxygen and iron content), Alpha-Beta (the workhorse family including Ti-6Al-4V), Near-Alpha (high-temperature alloys for jet engines), Beta (high-strength alloys for fasteners and springs), Intermetallic (gamma TiAl for turbine blades), and Shape Memory (Nitinol for medical stents and actuators).' },
];
const refMap = buildMaterialRef(materials);

// Augment each material with GRADE_DATA and entity counts
const allEnriched = materials.map(m => {
  const gradeKey = findGradeKeyById(m.id);
  const grade = gradeKey ? GRADE_DATA[gradeKey] : null;
  const ref = refMap.get(m.data.title) || { systems: new Set<string>(), components: [] };
  const props = grade?.hasProperty?.properties ? findKeyProps(grade.hasProperty.properties) : { other: [] };
  return { ...m, grade, gradeKey, ref, props };
});

// Filter: only show materials that have matched systems or components
const enriched = allEnriched.filter((m: any) => m.ref.systems.size > 0 || m.ref.components.length > 0);

// Categorize
const categories = ['Commercially Pure', 'Alpha-Beta Alloy', 'Near-Alpha Alloy', 'Beta Alloy', 'Intermetallic', 'Shape Memory Alloy'];
const grouped: Record<string, typeof enriched> = {};
for (const cat of categories) {
  const items = enriched.filter((m: any) => m.data.category === cat);
  if (items.length > 0) grouped[cat] = items;
}

// Category styling
const catColor: Record<string, string> = {
  'Commercially Pure': '#10b981',
  'Alpha-Beta Alloy': '#3b82f6',
  'Near-Alpha Alloy': '#f59e0b',
  'Beta Alloy': '#8b5cf6',
  'Intermetallic': '#ef4444',
  'Shape Memory Alloy': '#ec4899',
};
const catShort: Record<string, string> = {
  'Commercially Pure':'CP','Alpha-Beta Alloy':'Alpha-Beta','Near-Alpha Alloy':'Near-Alpha',
  'Beta Alloy':'Beta','Intermetallic':'Intermetallic','Shape Memory Alloy':'Shape Memory',
};
const catDesc: Record<string, string> = {
  'Commercially Pure': 'Unalloyed titanium, excellent corrosion resistance and formability.',
  'Alpha-Beta Alloy': 'Workhorse alloys balancing strength, toughness, and weldability.',
  'Near-Alpha Alloy': 'High-temperature creep resistance for aerospace engines.',
  'Beta Alloy': 'Ultra-high strength, excellent spring-back for fasteners.',
  'Intermetallic': 'Lightweight, high-temperature capability for turbine applications.',
  'Shape Memory Alloy': 'Superelasticity and shape memory effect for medical devices.',
};
---

<BaseLayout
  title="Titanium Materials Library - {enriched.length} Alloys | Boze Titanium Manufacturing Center"
  description="Browse {enriched.length} titanium alloys with matched systems and components. Complete mechanical property data."
  pageType="products-hub"
  collectionName="Titanium Materials Library"
  collectionDescription={`${enriched.length} titanium alloys with matched systems and components. Complete mechanical property data.`}
  itemCount={enriched.length}
  items={enriched.map((m: any) => ({ name: m.data.title, url: `${SITE.url}${m.gradeKey ? '/materials/' + m.gradeKey + '/' : '/materials/'}` }))}
  mentions={hubMentionsForCategory('material')}
  faqItems={faqItems}
  faqName="Titanium Materials Library — Frequently Asked Questions"
>
  <nav class="border-b" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">Home</span></a>
          <meta itemprop="position" content="1" />
          <span style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"> / </span>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/products" itemprop="item" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">Products</span></a>
          <meta itemprop="position" content="2" />
          <span style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"> / </span>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" style="font-weight:600;color:var(--theme-text);">Materials</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>

  <section class="py-12 lg:py-16" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-3" style="color: var(--theme-text);">Titanium Materials Library</h1>
      <p class="text-lg mb-10 max-w-3xl" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
        {enriched.length} titanium alloys — from commercially pure grades for chemical processing to advanced beta alloys for aerospace and medical-grade ELI for implants.
      </p>

      <!-- Category Tabs -->
      <div class="flex flex-wrap gap-2 mb-8">
        {Object.keys(grouped).map(cat => {
          const count = grouped[cat].length;
          const color = catColor[cat] || 'var(--theme-primary)';
          return (
            <a href={`#${cat.toLowerCase().replace(/\s+/g, '-')}`}
              class="px-4 py-2 text-sm font-medium rounded-full border transition-all"
              style="background: color-mix(in srgb, var(--theme-bg) 100%, transparent); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-text);"
              onmouseover="this.style.borderColor='{color}'; this.style.color='{color}'"
              onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.color='var(--theme-text)'"
            >{catShort[cat]} ({count})</a>
          );
        })}
      </div>

      <!-- Material Groups -->
      {Object.entries(grouped).map(([cat, items]) => (
        <div id={cat.toLowerCase().replace(/\s+/g, '-')} class="mb-12">
          <h2 class="text-xl font-bold mb-1" style="color: var(--theme-text);">{cat}</h2>
          <p class="text-sm mb-4" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{catDesc[cat]}</p>

          <!-- Card Grid — aligned with capabilities page -->
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {(items as any[]).map((entry: any) => {
              const d = entry.data;
              const grade = entry.grade;
              const gradeKey = entry.gradeKey;
              const ref = entry.ref;
              const props = entry.props;
              const href = gradeKey ? `/materials/${gradeKey}/` : `/materials/`;
              const keyChar = grade?.entityDefinition?.keyCharacteristics?.[0] || null;
              const sysCount = ref.systems.size;
              const compCount = ref.components.length;
              const accentColor = catColor[cat] || 'var(--theme-primary)';

              return (
                <a href={href} class="block p-5 rounded-xl border transition-all"
                  style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);"
                >
                  <!-- Category Badge -->
                  <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded mb-2"
                    style="background: color-mix(in srgb, {accentColor} 12%, transparent); color: {accentColor};"
                  >{catShort[cat]}</span>

                  <!-- Title — text-sm bold per capabilities standard -->
                  <h3 class="font-bold text-sm leading-snug" style="color: var(--theme-text);">{d.title}</h3>

                  <!-- Key characteristic — compact single line -->
                  {keyChar && (
                    <p class="text-xs mt-1 leading-relaxed italic" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
                      "{keyChar.slice(0, 90)}{keyChar.length > 90 ? '...' : ''}"
                    </p>
                  )}

                  <!-- Stats badges — text-[10px] per capabilities standard -->
                  <div class="mt-2 flex flex-wrap gap-x-2 gap-y-0.5 text-[10px]" style="color: color-mix(in srgb, var(--theme-primary) 60%, transparent);">
                    {sysCount > 0 && <span>{sysCount} system{sysCount !== 1 ? 's' : ''}</span>}
                    {compCount > 0 && <span>{compCount} component{compCount !== 1 ? 's' : ''}</span>}
                  </div>

                  <!-- Key property specs — compact -->
                  <div class="mt-1 text-[10px] leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);">
                    {props.tensile && <span><span style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">Tensile:</span> {props.tensile}</span>}
                    {props.tensile && props.yield && <span class="mx-1" style="color: color-mix(in srgb, var(--theme-text) 20%, transparent);">|</span>}
                    {props.yield && <span><span style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">Yield:</span> {props.yield}</span>}
                    {!props.tensile && !props.yield && grade?.hasProperty?.properties?.slice(0, 2).map((p: any) => (
                      <span><span style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">{p.label.split('(')[0].trim()}:</span> {p.value}</span>
                    ))}
                    {/* Fallback for materials without GRADE_DATA */}
                    {!grade && d.tensileStrength && <span>Tensile: {d.tensileStrength}</span>}
                    {!grade && d.yieldStrength && <span>Yield: {d.yieldStrength}</span>}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Quick-Reference Table — alloy class vs typical use case -->
  <section class="py-16" style="background: var(--theme-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">Titanium Alloy Class Quick-Reference</h2>
        <p class="text-lg max-w-3xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">Compare the six metallurgical classes by tensile strength, density, weldability, and typical applications.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left" style="border-collapse: collapse; background-color: var(--theme-surface);">
          <thead>
            <tr style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-bottom: 2px solid var(--theme-primary);">
              <th class="px-4 py-3 text-sm font-bold" style="color: var(--theme-text);">Alloy Class</th>
              <th class="px-4 py-3 text-sm font-bold" style="color: var(--theme-text);">Example Grades</th>
              <th class="px-4 py-3 text-sm font-bold" style="color: var(--theme-text);">Tensile Strength</th>
              <th class="px-4 py-3 text-sm font-bold" style="color: var(--theme-text);">Density</th>
              <th class="px-4 py-3 text-sm font-bold" style="color: var(--theme-text);">Weldability</th>
              <th class="px-4 py-3 text-sm font-bold" style="color: var(--theme-text);">Best for</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);"><td class="px-4 py-3 text-sm">Commercially Pure</td><td class="px-4 py-3 text-sm">Grade 1, 2, 3, 4</td><td class="px-4 py-3 text-sm">240-550 MPa</td><td class="px-4 py-3 text-sm">4.51 g/cm3</td><td class="px-4 py-3 text-sm">Excellent</td><td class="px-4 py-3 text-sm">Best for chemical processing, marine hardware</td></tr>
            <tr style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);"><td class="px-4 py-3 text-sm">Alpha-Beta</td><td class="px-4 py-3 text-sm">Grade 5, 5 ELI, 9, 23</td><td class="px-4 py-3 text-sm">895-1100 MPa</td><td class="px-4 py-3 text-sm">4.43 g/cm3</td><td class="px-4 py-3 text-sm">Good (Grade 9)</td><td class="px-4 py-3 text-sm">Best for aerospace structural, medical implants</td></tr>
            <tr style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);"><td class="px-4 py-3 text-sm">Near-Alpha</td><td class="px-4 py-3 text-sm">Grade 6, Ti-6242</td><td class="px-4 py-3 text-sm">895-1100 MPa</td><td class="px-4 py-3 text-sm">4.55 g/cm3</td><td class="px-4 py-3 text-sm">Limited</td><td class="px-4 py-3 text-sm">Best for high-temperature jet engine components</td></tr>
            <tr style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);"><td class="px-4 py-3 text-sm">Beta</td><td class="px-4 py-3 text-sm">Ti-10V-2Fe-3Al, Beta-C</td><td class="px-4 py-3 text-sm">1100-1400 MPa</td><td class="px-4 py-3 text-sm">4.65 g/cm3</td><td class="px-4 py-3 text-sm">Good</td><td class="px-4 py-3 text-sm">Best for high-strength fasteners and springs</td></tr>
            <tr style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);"><td class="px-4 py-3 text-sm">Intermetallic</td><td class="px-4 py-3 text-sm">Gamma TiAl</td><td class="px-4 py-3 text-sm">500-800 MPa</td><td class="px-4 py-3 text-sm">3.9-4.0 g/cm3</td><td class="px-4 py-3 text-sm">Poor</td><td class="px-4 py-3 text-sm">Best for turbine blades</td></tr>
            <tr><td class="px-4 py-3 text-sm">Shape Memory</td><td class="px-4 py-3 text-sm">Nitinol Ni-Ti</td><td class="px-4 py-3 text-sm">800-1500 MPa</td><td class="px-4 py-3 text-sm">6.45 g/cm3</td><td class="px-4 py-3 text-sm">Limited</td><td class="px-4 py-3 text-sm">Best for medical stents and actuators</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Selection Guide — 3-step decision path -->
  <section class="py-16" style="background: color-mix(in srgb, var(--theme-surface) 50%, transparent);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">How to Select the Right Titanium Alloy</h2>
      </div>
      <ol class="space-y-6">
        <li class="rounded-xl p-6" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <h3 class="text-xl font-bold mb-3" style="color: var(--theme-primary);">Step 1: Identify Operating Environment</h3>
          <p class="text-sm leading-relaxed">Match your service conditions to the alloy class. Seawater, chlorides, and oxidizing acids favor Commercially Pure Grade 2 or Pd-stabilized Grade 7. High-temperature jet engine service above 315 degrees Celsius needs Near-Alpha Grade 6 or Ti-6242. Body-temperature medical implants call for Grade 23 ELI per ASTM F136.</p>
        </li>
        <li class="rounded-xl p-6" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <h3 class="text-xl font-bold mb-3" style="color: var(--theme-primary);">Step 2: Define Strength and Density Targets</h3>
          <p class="text-sm leading-relaxed">For aerospace structural parts requiring the best strength-to-weight ratio, Grade 5 Ti-6Al-4V at 895 MPa minimum tensile and 4.43 g/cm3 density remains the industry default. Beta alloys such as Ti-10V-2Fe-3Al reach 1400 MPa for landing gear and fastener applications where maximum strength outweighs density concerns.</p>
        </li>
        <li class="rounded-xl p-6" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <h3 class="text-xl font-bold mb-3" style="color: var(--theme-primary);">Step 3: Specify Certification Requirements</h3>
          <p class="text-sm leading-relaxed">Aerospace programs require EN 10204 Type 3.1 mill certification, AS9102 first-article inspection, and full heat-number traceability per ASTM E415. Medical implants add ASTM F136 or ISO 5832-3 compliance, ISO 10993 biocompatibility, and DFARS-compliant Country of Origin. Oil and gas sour service specifies NACE MR0175.</p>
        </li>
      </ol>
    </div>
  </section>

<!-- FAQ — accordion UI paired with FAQPage JSON-LD via BaseLayout faqItems prop -->
  <section class="py-16" style="background: color-mix(in srgb, var(--theme-surface) 50%, transparent);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">Frequently Asked Questions</h2>
        <p class="text-lg max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">Common questions from procurement and design engineers selecting titanium alloys from the Boze materials library.</p>
      </div>
      <div class="space-y-3">
        {faqItems.map((item) => (
          <details class="group rounded-xl p-5" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <summary class="flex items-center justify-between cursor-pointer font-semibold" style="color: var(--theme-text);">
              <span>{item.question}</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>