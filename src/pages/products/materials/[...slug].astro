---
// Redirect /products/materials/{slug}/ → /materials/{slug}/
import { getCollection } from 'astro:content';
export const prerender = true;

// Map new KG slugs to old material page slugs
const SLUG_MAP: Record<string, string> = {
  'grade-5-ti-6al-4v': 'grade-5',
  'grade-23-ti-6al-4v-eli': 'grade-23',
  'grade-1-cp-ti': 'grade-1',
  'grade-2-cp-ti': 'grade-2',
  'grade-3-cp-ti': 'grade-3',
  'grade-4-cp-ti': 'grade-4',
  'beta-c-ti-3al-8v-6cr-4mo-4zr': 'grade-19',
  'gamma-tial-ti-48al-2cr-2nb': '',
  'nitinol-ni-ti-shape-memory-alloy': '',
  'grade-12-ti-03mo-08ni': '',
  'grade-9-ti-3al-25v': 'grade-9',
  'grade-7-ti-015pd': '',
  'ti-1023-ti-10v-2fe-3al': 'ti-5553',
  'ti-1100': '',
  'ti-15v-3cr-3sn-3al': 'grade-21',
  'ti-5al-25sn-eli': 'grade-6',
  'ti-6242-ti-6al-2sn-4zr-2mo': 'grade-6242',
  'ti-6246-ti-6al-2sn-4zr-6mo': '',
  'ti-65-ti-6al-4sn-9zr-1mo-1w-03si': '',
  'ti-6al-7nb-astm-f1295': '',
};

export async function getStaticPaths() {
  const entries = await getCollection('materials');
  return entries.map((entry) => ({
    params: { slug: entry.slug || entry.id?.replace('.json','') || '' },
    props: {},
  }));
}

const { slug } = Astro.params;
const oldSlug = slug ? SLUG_MAP[slug] : '';
const target = oldSlug ? `/materials/${oldSlug}/` : '/materials/';
---
<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Redirecting...</title>
<meta http-equiv="refresh" content="0; url={target}" />
<link rel="canonical" href={target} /></head>
<body>
<script>window.location.href = '{target}';</script>
<p>Redirecting to <a href={target}>{target}</a></p>
</body>
</html>
