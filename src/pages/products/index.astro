---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../../config/hero';
import { getCollection } from 'astro:content';

export const prerender = true;

const systems = await getCollection('systems');
const industries = await getCollection('industries');
const entities = await getCollection('product-entities');

// Group systems by industry
const byIndustry: Record<string, { industry: any; systems: any[]; total: number }> = {};
for (const sys of systems) {
  const indName = sys.data.industry || 'Other';
  if (!byIndustry[indName]) byIndustry[indName] = { industry: null, systems: [], total: 0 };
  byIndustry[indName].systems.push(sys);
  byIndustry[indName].total += sys.data.productEntities?.length || 0;
}
// Sort industries by system count (most first)
const sortedIndustries = Object.entries(byIndustry).sort((a, b) => b[1].systems.length - a[1].systems.length);

// Find industry metadata
for (const ind of industries) {
  if (byIndustry[ind.data.title]) byIndustry[ind.data.title].industry = ind;
}

const totalSystems = systems.length;
const totalEntities = entities.length;
const systemSlug = (title: string) => title.toLowerCase().replace(/ & /g, '-').replace(/[/,()]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
---

<BaseLayout
  title="Precision CNC Titanium Components — 260+ Parts Across 12 Industries | BOZE CNC Ti"
  description="Browse 260+ precision CNC machined titanium components organized across 60 engineering systems and 12 industries. Aerospace, Medical, Cycling, Semiconductor, Chemical, Marine. AS9100D & ISO 9001."
>
  <!-- Breadcrumb -->
  <nav class="border-b" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">Home</span></a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">Products & Components</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <SubpageHero
    h1={HERO_CONFIG['/products'].h1}
    badge="260+ Components · 60 Systems · 12 Industries · 20 Materials"
    subtitle={HERO_CONFIG['/products'].subtitle}
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
  />

  <!-- Stats Bar -->
  <section class="py-8" style="background: var(--theme-bg); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <a href="/products/product-entities/" class="block p-4 rounded-xl border text-center transition-all" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
          <p class="text-2xl font-bold" style="color: var(--theme-primary);">{totalEntities}</p>
          <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">Components</p>
        </a>
        <a href="#systems" class="block p-4 rounded-xl border text-center transition-all" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
          <p class="text-2xl font-bold" style="color: var(--theme-primary);">{totalSystems}</p>
          <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">Systems</p>
        </a>
        <a href="/products/industries/" class="block p-4 rounded-xl border text-center transition-all" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
          <p class="text-2xl font-bold" style="color: var(--theme-primary);">{Object.keys(byIndustry).length}</p>
          <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">Industries</p>
        </a>
        <a href="/products/materials/" class="block p-4 rounded-xl border text-center transition-all" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
          <p class="text-2xl font-bold" style="color: var(--theme-primary);">20</p>
          <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">Materials</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Systems by Industry -->
  <section id="systems" class="py-16 lg:py-20" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h2 class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--theme-text);">Engineering Systems by Industry</h2>
        <p style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          Each system contains a complete set of titanium components with material specifications, manufacturing processes, inspection criteria, and engineering failure analysis.
        </p>
      </div>

      <div class="space-y-16">
        {sortedIndustries.map(([indName, indData]) => {
          const indSlug = indName.toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
          return (
            <div>
              <div class="flex items-center justify-between mb-6">
                <div>
                  <h3 class="text-xl font-bold" style="color: var(--theme-text);">{indName}</h3>
                  <p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
                    {indData.systems.length} systems · {indData.total} components
                  </p>
                </div>
                <a href={`/products/industries/${indSlug}/`} class="text-sm font-medium flex items-center gap-1" style="color: var(--theme-primary);">
                  View all →
                </a>
              </div>
              
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                {indData.systems.map((sys: any) => {
                  const slug = sys.slug || sys.id?.replace('.json','') || systemSlug(sys.data.title);
                  const prodCount = sys.data.productEntities?.length || 0;
                  return (
                    <a href={`/products/systems/${slug}/`} class="group block p-5 rounded-xl border transition-all" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
                      <div class="flex items-start justify-between">
                        <div class="text-2xl mb-2">{sys.data.emoji || '🔧'}</div>
                        {prodCount > 0 && (
                          <span class="text-xs px-2 py-0.5 rounded-full" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">{prodCount} parts</span>
                        )}
                      </div>
                      <h4 class="font-semibold text-sm leading-tight group-hover" style="color: var(--theme-text);">{sys.data.title}</h4>
                      <p class="text-xs mt-2 line-clamp-2" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
                        {sys.data.description?.slice(0, 100) || 'Precision titanium components'}
                      </p>
                    </a>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Quick Links: Knowledge Graph -->
  <section class="py-12" style="background: var(--theme-bg); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-lg font-bold mb-6 text-center" style="color: var(--theme-text);">Knowledge Graph</h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-2xl mx-auto">
        <a href="/products/product-entities/" class="block p-4 rounded-xl border text-center" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
          <p class="text-sm font-semibold" style="color: var(--theme-text);">🔩 Component Library</p>
          <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">All {totalEntities} parts</p>
        </a>
        <a href="/products/materials/" class="block p-4 rounded-xl border text-center" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
          <p class="text-sm font-semibold" style="color: var(--theme-text);">🧪 Materials</p>
          <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">20 alloys</p>
        </a>
        <a href="/products/capabilities/" class="block p-4 rounded-xl border text-center" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
          <p class="text-sm font-semibold" style="color: var(--theme-text);">⚙️ Capabilities</p>
          <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">446 processes</p>
        </a>
        <a href="/products/industries/" class="block p-4 rounded-xl border text-center" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
          <p class="text-sm font-semibold" style="color: var(--theme-text);">🏭 Industries</p>
          <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">12 sectors</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 text-center" style="background: var(--theme-surface); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">Need a Custom Component?</h3>
      <p class="text-sm mb-6" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
        Don't see your part listed? Send us your drawings — our engineering team responds within 24 hours.
      </p>
      <a href="/contact" class="inline-flex items-center px-6 py-3 text-sm font-bold rounded-xl transition-all" style="background: var(--theme-primary); color: var(--theme-text);">
        Submit RFQ
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    </div>
  </section>

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Precision CNC Titanium Components",
    "description": `${totalEntities} titanium components across ${totalSystems} engineering systems and 12 industries.`,
    "numberOfItems": totalEntities,
    "about": { "@type": "Thing", "name": "Titanium Precision Components" }
  })} />
</BaseLayout>
