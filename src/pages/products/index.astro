---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

type Product = CollectionEntry<'products'>;
type SpecItem = { param: string; value: string };

const allProducts: Product[] = await getCollection('products');
const sorted = allProducts
  .sort((a: Product, b: Product) => (a.data.order || 0) - (b.data.order || 0));

const categories: string[] = [...new Set(sorted.map((p: Product) => p.data.category))];
---

<BaseLayout
  description="Browse our catalog of precision CNC machined titanium components. Custom manufacturing available for aerospace, medical, and industrial applications."
>
  <!-- Hero -->
  <SubpageHero
    title="Our"
    highlight="Products"
    badge="Precision Manufacturing"
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    subtitle="High-precision CNC machined components for aerospace, medical, automotive, and industrial applications. Certified quality, global delivery."
  />

  <!-- Category Filter -->
  {categories.length > 1 && (
    <Section background="dark">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-wrap gap-3 justify-center mb-12">
          <a href="#products" class="filter-btn-primary px-6 py-3 rounded-full text-sm font-semibold transition-all shadow-md" style="background: var(--theme-primary); color: var(--theme-text);">
            All Products
          </a>
          {categories.map((cat: string) => (
            <a href={`/products?category=${encodeURIComponent(cat)}`} class="filter-btn-secondary px-6 py-3 rounded-full text-sm font-semibold transition-all" style="background: var(--theme-surface); color: color-mix(in srgb, var(--theme-text) 85%, transparent);">
              {cat}
            </a>
          ))}
        </div>
      </div>
    </Section>
  )}

  <!-- Products Grid -->
  <section class="py-20" id="products" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sorted.map((product: Product) => {
          const { data, slug } = product;
          const img: string = data.gallery?.[0]?.image || '/uploads/hero-bg.jpg';
          const imgAlt: string = data.gallery?.[0]?.alt || data.title;
          const leadTimeSpec: SpecItem | undefined = data.specs?.find((s: SpecItem) => s.param === 'Lead Time');
          return (
            <a href={`/products/${slug}`} class="group block">
              <div class="product-card rounded-2xl overflow-hidden shadow-md transition-all duration-300 border" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                <div class="relative h-64 overflow-hidden" style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
                  <img
                    src={img}
                    alt={imgAlt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute inset-0" style="background: linear-gradient(to top, color-mix(in srgb, var(--theme-bg) 60%, transparent) 0%, transparent 60%);"></div>
                  <div class="absolute top-4 left-4">
                    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full" style="background: color-mix(in srgb, var(--theme-primary) 90%, transparent); backdrop-filter: blur(4px); color: var(--theme-text);">
                      {data.category}
                    </span>
                  </div>
                  {data.featured && (
                    <div class="absolute top-4 right-4">
                      <span class="featured-badge inline-flex items-center px-3 py-1 text-xs font-bold rounded-full" style="background: color-mix(in srgb, var(--theme-accent) 90%, transparent); backdrop-filter: blur(4px); color: var(--theme-accent);">
                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                        Featured
                      </span>
                    </div>
                  )}
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold mb-2 transition-colors" style="color: var(--theme-text);">
                    {data.title}
                  </h3>
                  <p class="text-sm line-clamp-3 mb-4 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                    {data.description}
                  </p>
                  <div class="border-t pt-4 mb-4" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                    <div class="grid grid-cols-2 gap-2 text-xs">
                      {data.specs?.slice(0, 4).map((spec: SpecItem) => (
                        <div class="flex flex-col">
                          <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{spec.param}</span>
                          <span class="font-semibold truncate" style="color: var(--theme-text);">{spec.value}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="view-details-link inline-flex items-center font-semibold text-sm transition-all" style="color: var(--theme-primary);">
                      View Details
                      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </span>
                    {leadTimeSpec && (
                      <span class="lead-time-badge text-xs px-2 py-1 rounded-full" style="background: color-mix(in srgb, var(--theme-accent) 15%, transparent); color: var(--theme-accent);">
                        {leadTimeSpec.value.split(';')[0] || 'Fast delivery'}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      {sorted.length === 0 && (
        <div class="text-center py-20">
          <svg class="w-20 h-20 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
          </svg>
          <h3 class="text-2xl font-bold mb-2" style="color: var(--theme-text);">{t('products.index.no_products_yet')}</h3>
          <p style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('products.index.products_will_appear_here_once')}</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 overflow-hidden" style="background: linear-gradient(to right, color-mix(in srgb, var(--theme-primary) 50%, var(--theme-bg)), color-mix(in srgb, var(--theme-accent) 50%, var(--theme-bg)));">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background: radial-gradient(circle at 30% 50%, color-mix(in srgb, var(--theme-primary) 30%, transparent) 0%, transparent 50%), radial-gradient(circle at 70% 50%, color-mix(in srgb, var(--theme-accent) 30%, transparent) 0%, transparent 50%);"></div>
    </div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center" style="color: var(--theme-text);">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          Need Custom CNC <span class="text-transparent bg-clip-text" style="background: linear-gradient(to right, color-mix(in srgb, var(--theme-primary) 70%, white), color-mix(in srgb, var(--theme-accent) 70%, white)); -webkit-background-clip: text;">{t('products.index.components')}</span>?
        </h2>
        <p class="text-xl mb-10 max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
          Send us your drawings and specifications. Our engineering team will respond within 24 hours with a competitive quote.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://www.bozemetal.com/contact" target="_blank" rel="noopener noreferrer" class="cta-primary-btn inline-flex items-center px-8 py-4 font-bold rounded-xl shadow-2xl transition-all text-lg" style="background: var(--theme-primary); color: var(--theme-text);">
            Submit RFQ
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
          <a href="/services" class="cta-secondary-btn inline-flex items-center px-8 py-4 border-2 font-bold rounded-xl transition-all text-lg" style="border-color: color-mix(in srgb, var(--theme-text) 30%, transparent); color: var(--theme-text);">
            View Capabilities
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .product-card:hover {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25) !important;
    transform: translateY(-4px) !important;
  }
  .group:hover .product-card {
    border-color: color-mix(in srgb, var(--theme-primary) 30%, transparent) !important;
  }
  .filter-btn-secondary:hover {
    background: color-mix(in srgb, var(--theme-primary) 8%, transparent) !important;
    color: var(--theme-primary) !important;
  }
  .filter-btn-primary:hover {
    background: color-mix(in srgb, var(--theme-primary) 80%, #000) !important;
  }
  .group:hover .view-details-link {
    gap: 0.5rem !important;
  }
  .group:hover h3 {
    color: var(--theme-primary) !important;
  }
  .cta-primary-btn:hover {
    background: color-mix(in srgb, var(--theme-primary) 80%, #000) !important;
  }
  .cta-secondary-btn:hover {
    border-color: color-mix(in srgb, var(--theme-text) 50%, transparent) !important;
  }
</style>
