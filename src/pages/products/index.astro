  <span id="total-systems-data" style="display:none;" data-total={totalSystems}></span>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- Client-side Search & Filter Script (pure JS, no framework)    -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <script is:inline>
    (function() {
      'use strict';
      const searchInput = document.getElementById('system-search');
      const industryFilter = document.getElementById('industry-filter');
      const statusEl = document.getElementById('search-status');
      const noResultsEl = document.getElementById('no-results');

      if (!searchInput || !industryFilter) return;

      function filterSystems() {
        const query = (searchInput.value || '').toLowerCase().trim();
        const industry = industryFilter.value;
        const groups = document.querySelectorAll('.industry-group');
        let visibleCardsCount = 0;
        let totalCardsCount = 0;

        groups.forEach(function(group) {
          const groupIndustry = group.getAttribute('data-industry');
          const cards = group.querySelectorAll('.systems-grid > a');
          const industryMatch = !industry || groupIndustry === industry;
          let groupHasVisible = false;

          cards.forEach(function(card) {
            totalCardsCount++;
            const title = (card.getAttribute('data-search-title') || '').toLowerCase();
            const desc = (card.getAttribute('data-search-desc') || '').toLowerCase();
            const queryMatch = !query || title.indexOf(query) !== -1 || desc.indexOf(query) !== -1;
            const show = industryMatch && queryMatch;
            card.style.display = show ? '' : 'none';
            if (show) { groupHasVisible = true; visibleCardsCount++; }
          });

          if (!industryMatch) {
            group.style.display = 'none';
          } else if (query && !groupHasVisible) {
            group.style.display = 'none';
          } else {
            group.style.display = '';
          }
        });

        // Update status text
        if (statusEl) {
          if (query || industry) {
            statusEl.textContent = 'Showing ' + visibleCardsCount + ' of ' + totalCardsCount + ' systems';
          } else {
            statusEl.textContent = 'Showing all ' + totalCardsCount + ' systems';
          }
        }

        // Toggle no-results message
        if (noResultsEl) {
          noResultsEl.classList.toggle('hidden', visibleCardsCount > 0);
        }
      }

      searchInput.addEventListener('input', filterSystems);
      industryFilter.addEventListener('change', filterSystems);
    })();
  </script>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- Structured Data (JSON-LD)                                      -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Precision CNC Titanium Components & Systems Library",
    "description": `${totalEntities} titanium components across ${totalSystems} engineering systems, ${totalIndustries} industries, 445 capabilities, and 20 titanium alloys.`,
    "numberOfItems": totalEntities,
    "about": [
      { "@type": "Thing", "name": "Titanium Precision Components" },
      { "@type": "Thing", "name": "CNC Machining Capabilities" },
      { "@type": "Thing", "name": "Titanium Manufacturing Systems" }
    ],
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": sortedIndustries.map(([indName, { systems: indSystems }], idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "item": {
          "@type": "DefinedTermSet",
          "name": indName,
          "hasDefinedTerm": indSystems.map(sys => ({
            "@type": "DefinedTerm",
            "name": sys.data.title
          }))
        }
      }))
    }
  })} />
</BaseLayout>

