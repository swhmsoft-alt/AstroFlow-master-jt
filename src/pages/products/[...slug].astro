---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { data } = product;
const firstImage = data.gallery?.[0]?.image || '/uploads/hero-bg.jpg';
const seoTitle = data.seoTitle || `${data.title} | Boze Titanium Manufacturing Center`;
const seoDesc = data.seoDescription || `${data.description} Precision CNC machined ${data.category.toLowerCase()} components. AS9100D & ISO 9001 certified. Request a quote.`;
const pubDateISO = data.pubDate ? new Date(data.pubDate).toISOString() : null;
const updatedISO = data.updatedDate ? new Date(data.updatedDate).toISOString() : null;
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  pageType="product-detail"
  productName={data.title}
  productImage={firstImage ? `https://cnc.bozemetal.com${firstImage}` : undefined}
  productCategory={data.category}
  productDatePublished={pubDateISO}
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="breadcrumb-link transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/products" itemprop="item" class="breadcrumb-link transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.products')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{data.title}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Product Detail Section -->
  <section class="py-12 lg:py-16" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Left: Gallery -->
        <div>
          <div class="relative rounded-2xl overflow-hidden shadow-xl mb-4 aspect-4/3" style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <img
              src={firstImage}
              alt={data.gallery?.[0]?.alt || data.title}
              class="w-full h-full object-cover"
              width="800"
              height="600"
            />
          </div>
          {data.gallery && data.gallery.length > 1 && (
            <div class="grid grid-cols-4 gap-3">
              {data.gallery.slice(0, 4).map((img, i) => (
                <div
                  class="aspect-square shadow-sm"
                  style={`background: color-mix(in srgb, var(--theme-primary) 8%, transparent); border-radius: 0.75rem; overflow: hidden;${i === 0 ? ' outline: 2px solid var(--theme-primary); outline-offset: -2px;' : ''}`}
                >
                  <img
                    src={img.image}
                    alt={img.alt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Right: Product Info -->
        <div class="flex flex-col">
          <!-- Category badge -->
          <div class="mb-4">
            <span
              class="inline-block px-4 py-1.5 text-sm font-semibold rounded-full"
              style="background: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);"
            >
              {data.category}
            </span>
          </div>

          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4 leading-tight" style="color: var(--theme-text);">
            {data.title}
          </h1>

          <p class="text-lg mb-8 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            {data.description}
          </p>

          <!-- Inquiry Button -->
          <div class="mb-10">
            <a
              href={data.btnLink}
              class="product-cta-btn inline-flex items-center px-8 py-4 font-bold text-lg rounded-xl shadow-lg transition-all"
              style="background: linear-gradient(to right, var(--theme-primary), color-mix(in srgb, var(--theme-primary) 80%, #000)); color: var(--theme-text);"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {data.btnText}
            </a>
          </div>

          <!-- Quick Highlights -->
          <div class="grid grid-cols-2 gap-4 mb-8">
            {data.specs?.filter(s => ['Certification', 'Lead Time', 'MOQ'].includes(s.param)).map(spec => (
              <div class="rounded-xl p-4 border" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                <div class="text-xs uppercase tracking-wider mb-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{spec.param}</div>
                <div class="text-sm font-bold" style="color: var(--theme-text);">{spec.value.split(';')[0]}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specifications Table -->
  <section class="py-16" style="background: var(--theme-surface);">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-3" style="color: var(--theme-text);">
          Technical <span class="text-transparent bg-clip-text" style="background: linear-gradient(to right, var(--theme-primary), var(--theme-accent)); -webkit-background-clip: text;">{t('products.detail.specifications')}</span>
        </h2>
        <p style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Detailed parameters and tolerances for {data.title}</p>
      </div>

      <div class="rounded-2xl shadow-lg overflow-hidden border" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <table class="w-full text-sm">
          <thead>
            <tr style="background: linear-gradient(to right, var(--theme-primary), var(--theme-accent));">
              <th class="px-6 py-4 text-left font-bold uppercase tracking-wider w-2/5" style="color: var(--theme-text);">Parameter</th>
              <th class="px-6 py-4 text-left font-bold uppercase tracking-wider" style="color: var(--theme-text);">Value</th>
            </tr>
          </thead>
          <tbody>
            {data.specs?.map((spec, i) => (
              <tr class="border-b" style={`border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); background: ${i % 2 === 0 ? 'var(--theme-surface)' : 'color-mix(in srgb, var(--theme-primary) 5%, var(--theme-surface))'};`}>
                <td class="px-6 py-4 font-semibold" style="color: color-mix(in srgb, var(--theme-text) 85%, transparent);">{spec.param}</td>
                <td class="px-6 py-4" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{spec.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Applications Section -->
  <section class="py-16" style="background: var(--theme-surface);">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-3" style="color: var(--theme-text);">
          Industry <span class="text-transparent bg-clip-text" style="background: linear-gradient(to right, var(--theme-primary), var(--theme-accent)); -webkit-background-clip: text;">{t('products.detail.applications')}</span>
        </h2>
        <p class="max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
          Our precision components are trusted across multiple industries worldwide
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { name: 'Aerospace', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />' },
          { name: 'Medical', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />' },
          { name: 'Automotive', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 1M20 16V6a1 1 0 00-1-1h-5" />' },
          { name: 'Industrial', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />' },
        ].map(app => (
          <div class="rounded-2xl p-6 text-center border transition-shadow" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <div class="w-12 h-12 mx-auto mb-3 rounded-xl flex items-center justify-center" style="background: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--theme-primary);" set:html={app.icon} />
            </div>
            <h3 class="font-bold" style="color: var(--theme-text);">{app.name}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 overflow-hidden" style="background: linear-gradient(to right, color-mix(in srgb, var(--theme-primary) 40%, var(--theme-bg)), color-mix(in srgb, var(--theme-primary) 60%, var(--theme-bg)), color-mix(in srgb, var(--theme-accent) 60%, var(--theme-bg)));">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background: radial-gradient(circle at 30% 50%, color-mix(in srgb, var(--theme-primary) 30%, transparent) 0%, transparent 50%), radial-gradient(circle at 70% 50%, color-mix(in srgb, var(--theme-accent) 30%, transparent) 0%, transparent 50%);"></div>
    </div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center" style="color: var(--theme-text);">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
          Get a Quote for <span class="text-transparent bg-clip-text" style="background: linear-gradient(to right, color-mix(in srgb, var(--theme-primary) 70%, white), color-mix(in srgb, var(--theme-accent) 70%, white)); -webkit-background-clip: text;">{data.title}</span>
        </h2>
        <p class="text-xl mb-10" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
          Upload your CAD drawing or provide specifications. We'll respond within 24 hours.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={data.btnLink} class="cta-primary-btn inline-flex items-center px-8 py-4 font-bold rounded-xl shadow-2xl transition-all text-lg" style="background: var(--theme-primary); color: var(--theme-text);">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            {data.btnText}
          </a>
          <a href="/products" class="cta-secondary-btn inline-flex items-center px-8 py-4 border-2 font-bold rounded-xl transition-all text-lg" style="border-color: color-mix(in srgb, var(--theme-text) 30%, transparent); color: var(--theme-text);">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
            All Products
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .breadcrumb-link:hover {
    color: var(--theme-primary) !important;
  }
  .product-cta-btn:hover {
    background: linear-gradient(to right, color-mix(in srgb, var(--theme-primary) 80%, #000), color-mix(in srgb, var(--theme-primary) 65%, #000)) !important;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
  }
  .cta-primary-btn:hover {
    background: color-mix(in srgb, var(--theme-primary) 80%, #000) !important;
  }
  .cta-secondary-btn:hover {
    border-color: color-mix(in srgb, var(--theme-text) 50%, transparent) !important;
  }
</style>
