---
/**
 * src/pages/products/capabilities/[...slug].astro
 *
 * 产品生态中的微能力详情页（英文）。
 * 复用 MicroCapabilityPage 7 模块模板，同时保留产品生态特有的
 * 交叉引用：相关产品实体、系统、同类别能力。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/seo/BreadcrumbNav.astro';
import MicroCapabilityPage from '../../../components/capabilities/MicroCapabilityPage.astro';
import { getCollection } from 'astro:content';
import { DEFAULT_LANG } from '../../../i18n/ui';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('capabilities');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.[^/.]+$/, '').replace(/^.*[\\/\\\\]/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const slug = entry.id.replace(/\.json$/i, '').replace(/^.*[\\/\\\\]/, '');

const seoTitle = data.seoTitle || `${data.title} | Titanium Manufacturing Capability | BOZE CNC Ti`;
const seoDesc = data.seoDescription || `${data.description}. ${data.category} capability for precision CNC machined titanium components. AS9100D & ISO 9001 certified.`;

// ── Resolve related product-entities & systems ──
const currentSlugNorm = slug.toLowerCase().replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');

const allEntities = await getCollection('product-entities');
const allSystems = await getCollection('systems');
const allCapabilities = await getCollection('capabilities');

const matchFn = (rc: string) => {
  const n = rc.toLowerCase().replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');
  return n.includes(currentSlugNorm) || currentSlugNorm.includes(n);
};

const relatedProducts = allEntities.filter((e) =>
  (e.data.relatedCapabilities || []).some(matchFn)
).slice(0, 30);

const relatedSystems = allSystems.filter((s) =>
  (s.data.relatedCapabilities || []).some(matchFn)
).slice(0, 12);

const sameCategoryCaps = allCapabilities.filter(
  (c) => c.data.category === data.category &&
    c.id.replace(/\.json$/i, '').replace(/^.*[\\/\\\\]/, '') !== slug
).slice(0, 12);

const entitySlug = (title: string) =>
  title.toLowerCase().replace(/ /g, '-').replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');
const sysSlug = (title: string) =>
  title.toLowerCase().replace(/ & /g, '-').replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');

// ── Build relatedEntities for MicroCapabilityPage ──
// 优先用 product-entities 反向引用；不足时用 enriched JSON 的 relatedEntities 补充
const enrichedRelatedSlugs: string[] = (data as any).relatedEntities || [];
let relatedEntities: { title: string; slug: string; material?: string; industry?: string }[];

if (relatedProducts.length >= 3) {
  // 反向引用足够 → 用它
  relatedEntities = relatedProducts.map((p) => ({
    title: p.data.title,
    slug: p.slug || p.id?.replace('.json','') || '',
    material: (p.data as any).material,
    industry: (p.data as any).industry,
  }));
} else if (enrichedRelatedSlugs.length > 0) {
  // 反向引用不足 → 用 enriched 数据的 relatedEntities 字段
  relatedEntities = enrichedRelatedSlugs
    .map((s: string) => {
      const found = allEntities.find((e) => {
        const eSlug = e.id.replace(/\.json$/i, '').replace(/^.*[\\/]/, '');
        return eSlug === s || e.data.title.toLowerCase().replace(/[^a-z0-9-]/g, '').includes(s.replace(/[^a-z0-9-]/g, ''));
      });
      if (!found) return null;
      return {
        title: found.data.title,
        slug: found.slug || found.id?.replace('.json','') || '',
        material: (found.data as any).material,
        industry: (found.data as any).industry,
      };
    })
    .filter(Boolean) as { title: string; slug: string; material?: string; industry?: string }[];
} else {
  relatedEntities = [];
}
---

<BaseLayout title={seoTitle} description={seoDesc}>
  <!-- Products-specific breadcrumb -->
  <BreadcrumbNav
    lang="en"
    items={[
      { label: 'Home', slug: '' },
      { label: 'Products', slug: 'products' },
      { label: 'Capabilities', slug: 'products/capabilities' },
      { label: data.title, slug: '', isCurrent: true },
    ]}
    siteUrl="https://cnc.bozemetal.com"
  />

  <!-- ═══ Module 1–7: MicroCapabilityPage Template ═══ -->
  <MicroCapabilityPage
    capability={entry}
    relatedEntities={relatedEntities}
    lang={DEFAULT_LANG}
    hideBreadcrumb={true}
    hideCta={true}
    theme="products"
    t={(key: string) => {
      const map: Record<string, string> = {
        'capabilities.breadcrumb.home': 'Home',
        'capabilities.breadcrumb.capabilities': 'Capabilities',
        'capabilities.specs.grades': 'Common Grades',
        'capabilities.specs.thickness': 'Thickness Range',
        'capabilities.specs.minHoleRatio': 'Min Hole/Thickness Ratio',
        'capabilities.specs.cuttingTolerance': 'Cutting Tolerance',
        'capabilities.specs.tolerance': 'Tolerance',
        'capabilities.specs.maxSize': 'Max Part Size',
        'capabilities.specs.surfaceFinish': 'Surface Finish',
        'capabilities.processComparison.title': 'Process Comparison: Laser vs. Waterjet',
        'capabilities.processComparison.dimension': 'Evaluation Dimension',
        'capabilities.processComparison.laser': 'Laser Cutting',
        'capabilities.processComparison.waterjet': 'Waterjet Cutting',
        'capabilities.processComparison.empty': 'Process comparison data is being compiled for this capability.',
        'capabilities.engineering.title': 'Engineering Capabilities & Limits',
        'capabilities.engineering.holeTypes': 'Hole Types Supported',
        'capabilities.engineering.heatControl': 'Heat Control Measures',
        'capabilities.engineering.flatnessControl': 'Flatness & Stress Relief',
        'capabilities.engineering.materials': 'Materials Supported',
        'capabilities.applications.title': 'Typical Applications & Components',
        'capabilities.applications.description': 'This process is used to manufacture the following titanium components.',
        'capabilities.downstream.title': 'Secondary Operations & Downstream Processing',
        'capabilities.downstream.description': 'Enhance your component with our integrated downstream services:',
        'capabilities.quality.title': 'Quality Assurance & Inspection',
        'capabilities.quality.inspectionItems': 'Inspection Items',
        'capabilities.quality.standards': 'Quality Standards & Certifications',
        'capabilities.cta.buttonText': 'Request a Quote',
        'capabilities.comparison.singleTitle': 'Technical Specifications & Capabilities',
        'capabilities.comparison.specLabel': 'Specification / Value',
      };
      return map[key] || key;
    }}
    siteUrl="https://cnc.bozemetal.com"
  />

  <!-- ═══ 产品生态专属区块：Systems + Same-Category Capabilities ═══ -->

  {relatedSystems.length > 0 && (
    <section class="py-16" style="background: var(--theme-bg);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold mb-2" style="color: var(--theme-text);">Systems Requiring This Capability</h2>
        <p class="text-sm mb-8" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
          {relatedSystems.length} product systems that depend on {data.title}.
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedSystems.map((s) => {
            const sd = s.data;
            const slug_s = sysSlug(sd.title);
            const count = (sd as any).productEntities?.length || 0;
            return (
              <a href={`/products/systems/${slug_s}/`} class="block p-5 rounded-xl border transition-all" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
                <p class="text-xl mb-1">{(sd as any).emoji || '🔧'}</p>
                <h3 class="font-bold text-sm" style="color: var(--theme-text);">{sd.title}</h3>
                <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{sd.description?.slice(0, 100)}</p>
                {count > 0 && <p class="text-[10px] mt-2" style="color: color-mix(in srgb, var(--theme-primary) 50%, transparent);">{count} components</p>}
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {sameCategoryCaps.length > 0 && (
    <section class="py-16" style="background: var(--theme-surface);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold mb-2" style="color: var(--theme-text);">Related {data.category} Capabilities</h2>
        <p class="text-sm mb-8" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
          Other capabilities in the same category.
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {sameCategoryCaps.map((c) => {
            const cd = c.data;
            const cSlug = c.id.replace(/\.json$/i, '').replace(/^.*[\\/\\\\]/, '');
            return (
              <a href={`/products/capabilities/${cSlug}/`} class="block p-5 rounded-xl border transition-all" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
                <h3 class="font-bold text-sm" style="color: var(--theme-text);">{cd.title}</h3>
                <p class="text-xs mt-1 line-clamp-2" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{cd.description?.slice(0, 120)}</p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
