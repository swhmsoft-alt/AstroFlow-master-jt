---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../config/hero';
import MaterialGradeMatrix from '../components/materials/MaterialGradeMatrix.astro';
import TitaniumStandardsSection from '../components/materials/TitaniumStandardsSection.astro';
import AlloyComparisonTable from '../components/materials/AlloyComparisonTable.astro';
import MachiningKnowHow from '../components/materials/MachiningKnowHow.astro';
import MaterialTraceability from '../components/materials/MaterialTraceability.astro';
import TitaniumGradeFinder from '../components/react/TitaniumGradeFinder';
import WeightCalculator from '../components/react/WeightCalculator';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<BaseLayout>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.materials')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <SubpageHero
    h1={HERO_CONFIG['/materials'].h1}
    badge={HERO_CONFIG['/materials'].badge}
    subtitle={HERO_CONFIG['/materials'].subtitle}
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    keyMetrics={HERO_CONFIG['/materials'].keyMetrics}
    entityChips={HERO_CONFIG['/materials'].entityChips}
    compact={HERO_CONFIG['/materials'].compact}
  />

  <!-- Titanium Grade Finder Tool -->
  <section class="py-16" style="background: var(--theme-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
          Find the Right Titanium Grade
        </h2>
        <p class="text-lg max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          Filter by strength, corrosion resistance, weldability, and more — instantly narrow down the best titanium alloy for your application.
        </p>
      </div>
      <TitaniumGradeFinder client:load />
    </div>
  </section>

  <!-- Titanium Weight Calculator Tool -->
  <section class="py-16" style="background: color-mix(in srgb, var(--theme-surface) 50%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
          Titanium Weight & Cost Estimator
        </h2>
        <p class="text-lg max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          Estimate part weight and raw material cost for common shapes — round bar, plate, tube, and rectangular bar across all titanium grades.
        </p>
      </div>
      <WeightCalculator client:load />
    </div>
  </section>

  <!-- Material Grade Matrix -->
  <MaterialGradeMatrix />

  <!-- Titanium Standards -->
  <TitaniumStandardsSection />

  <!-- Alloy Comparison Table -->
  <AlloyComparisonTable />

  <!-- Machining Know-How -->
  <MachiningKnowHow />

  <!-- Material Traceability -->
  <MaterialTraceability />
</BaseLayout>
