---
import BaseLayout from '@layouts/BaseLayout.astro';
import ThemeSwitcher from '@components/ThemeSwitcher.astro';
---

<BaseLayout>
  <!-- ==========================================================
       THEME DEMO PAGE
       Showcases all 5 themes using semantic utility classes
       ========================================================== -->
  <section class="relative overflow-hidden py-20">
    <!-- Decorative background pattern -->
    <div class="absolute inset-0 -z-10 opacity-[0.03]">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, var(--theme-text) 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">

      <!-- ── Page Header ── -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--theme-text);">
          🎨 主题演示
          <span class="block mt-1" style="color: var(--theme-primary);">{t('theme-demo.astro.themeDemo.theme_demonstration')}</span>
        </h1>
        <p class="text-lg max-w-2xl mx-auto" style="color: var(--theme-text); opacity: 0.7;">
          使用 <code class="rounded px-2 py-0.5 text-sm font-mono" style="background-color: var(--theme-surface); color: var(--theme-primary);">bg-theme-bg</code>、<code class="rounded px-2 py-0.5 text-sm font-mono" style="background-color: var(--theme-surface); color: var(--theme-primary);">text-theme-text</code>、<code class="rounded px-2 py-0.5 text-sm font-mono" style="background-color: var(--theme-surface); color: var(--theme-primary);">bg-theme-primary</code>、<code class="rounded px-2 py-0.5 text-sm font-mono" style="background-color: var(--theme-surface); color: var(--theme-primary);">bg-theme-accent</code> 等语义类名驱动。
        </p>

        <!-- Theme Switcher -->
        <div class="mt-8 inline-flex items-center gap-3">
          <span class="text-sm font-medium" style="color: var(--theme-text); opacity: 0.6;">切换主题：</span>
          <ThemeSwitcher />
        </div>
      </div>

      <!-- ── Cards Grid (bg-theme-surface demo) ── -->
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2" style="color: var(--theme-primary);">
        <span>📦</span> Surface Cards
        <span class="text-sm font-normal opacity-60" style="color: var(--theme-text);">{t('theme-demo.astro.themeDemo.bgthemesurface')}</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        {['钛合金精密加工', '航空航天认证', '全流程可追溯'].map((title, i) => (
          <div class="rounded-2xl p-6 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 20%, transparent);">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center text-xl mb-4" style="background-color: var(--theme-primary); color: var(--theme-bg);">
              {['🔧', '✈️', '📋'][i]}
            </div>
            <h3 class="text-lg font-bold mb-2" style="color: var(--theme-text);">{title}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--theme-text); opacity: 0.7;">
              Our state-of-the-art facilities ensure consistent quality across every batch of production.
            </p>
          </div>
        ))}
      </div>

      <!-- ── Primary-colored Titles (text-theme-primary demo) ── -->
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2" style="color: var(--theme-primary);">
        <span>🎯</span> Primary Highlighted Titles
        <span class="text-sm font-normal opacity-60" style="color: var(--theme-text);">{t('theme-demo.astro.themeDemo.textthemeprimary')}</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        <div class="rounded-xl p-8" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
          <h3 class="text-3xl font-bold mb-3" style="color: var(--theme-primary);">{t('theme-demo.astro.themeDemo.titanium_excellence')}</h3>
          <p class="text-sm leading-relaxed" style="color: var(--theme-text); opacity: 0.7;">
            From raw billet to finished component — every step is precision engineered for the most demanding applications.
          </p>
          <div class="mt-4 flex gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-semibold" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">{t('theme-demo.astro.themeDemo.as9100d_2')}</span>
            <span class="px-3 py-1 rounded-full text-xs font-semibold" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">{t('theme-demo.astro.themeDemo.iso_9001_3')}</span>
            <span class="px-3 py-1 rounded-full text-xs font-semibold" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">{t('theme-demo.astro.themeDemo.nadcap')}</span>
          </div>
        </div>
        <div class="rounded-xl p-8" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
          <h3 class="text-3xl font-bold mb-3" style="color: var(--theme-primary);">{t('theme-demo.astro.themeDemo.aerospace_grade')}</h3>
          <p class="text-sm leading-relaxed" style="color: var(--theme-text); opacity: 0.7;">
            Trusted by leading aerospace manufacturers for critical structural components and engine parts.
          </p>
          <div class="mt-4 flex gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-semibold" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">{t('theme-demo.astro.themeDemo.traceable')}</span>
            <span class="px-3 py-1 rounded-full text-xs font-semibold" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">{t('theme-demo.astro.themeDemo.certified')}</span>
          </div>
        </div>
      </div>

      <!-- ── Accent CTA Buttons (bg-theme-accent demo) ── -->
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2" style="color: var(--theme-primary);">
        <span>🚀</span> Accent Call-to-Action Buttons
        <span class="text-sm font-normal opacity-60" style="color: var(--theme-text);">{t('theme-demo.astro.themeDemo.bgthemeaccent')}</span>
      </h2>
      <div class="flex flex-wrap gap-4 mb-16">
        <a
          href="https://www.bozemetal.com/contact" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5"
          style="background-color: var(--theme-accent); color: var(--theme-bg);"
        >
          Request a Quote →
        </a>
        <a
          href="/services"
          class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-xl border-2 transition-all duration-300 hover:-translate-y-0.5"
          style="border-color: var(--theme-primary); color: var(--theme-primary); background-color: transparent;"
        >
          Explore Services →
        </a>
      </div>

      <!-- ── Description Text Example ── -->
      <h2 class="text-2xl font-bold mb-6" style="color: var(--theme-primary);">
        📝 Body Text Example <span class="text-sm font-normal opacity-60" style="color: var(--theme-text);">{t('theme-demo.astro.themeDemo.textthemetext_via_body_class')}</span>
      </h2>
      <div class="rounded-2xl p-8 mb-12" style="background-color: var(--theme-surface);">
        <p class="mb-4 leading-relaxed">
          This entire page automatically inherits <strong>--theme-text</strong> for its body copy color
          thanks to the <code class="rounded px-2 py-0.5 text-sm font-mono" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">text-theme-text</code> class on the <code class="rounded px-2 py-0.5 text-sm font-mono" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);"><body></code> element.
        </p>
        <p class="mb-4 leading-relaxed">
          The background uses <code class="rounded px-2 py-0.5 text-sm font-mono" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">bg-theme-bg</code> and this card
          uses <code class="rounded px-2 py-0.5 text-sm font-mono" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">bg-theme-surface</code> — they all update seamlessly when
          selecting a different theme from the dropdown above.
        </p>
        <p class="leading-relaxed" style="color: var(--theme-primary);">
          <strong>All 5 themes &mdash; driven by a single data file at <code class="rounded px-2 py-0.5 text-sm font-mono" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">{t('theme-demo.astro.themeDemo.srclibcmsthemests')}</code> &mdash; no hardcoded colors needed!</strong>
        </p>
      </div>

      <!-- ── Theme Quick Reference Table ── -->
      <h2 class="text-2xl font-bold mb-6" style="color: var(--theme-primary);">
        📋 Theme Color Reference
      </h2>
      <div class="overflow-hidden rounded-2xl border shadow-lg" style="background-color: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 20%, transparent);">
        <table class="w-full text-sm">
          <thead>
            <tr style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
              <th class="px-6 py-4 text-left font-semibold" style="color: var(--theme-text);">{t('theme-demo.astro.themeDemo.theme')}</th>
              <th class="px-6 py-4 text-left font-semibold" style="color: var(--theme-text);">--theme-bg</th>
              <th class="px-6 py-4 text-left font-semibold" style="color: var(--theme-text);">--theme-surface</th>
              <th class="px-6 py-4 text-left font-semibold" style="color: var(--theme-text);">--theme-text</th>
              <th class="px-6 py-4 text-left font-semibold" style="color: var(--theme-text);">--theme-primary</th>
              <th class="px-6 py-4 text-left font-semibold" style="color: var(--theme-text);">--theme-accent</th>
            </tr>
          </thead>
          <tbody>
            {[
              { id: 'legacy-original', name: 'BOZE Original', bg: '#0d0e10', surface: '#1a1c1e', text: '#e4e4e7', primary: '#ff5a00', accent: '#ff5a00' },
              { id: 'classic-titanium', name: '经典钛金工业', bg: '#F4F5F7', surface: '#FFFFFF', text: '#1E293B', primary: '#64748B', accent: '#0EA5E9' },
              { id: 'aerospace-precision', name: '航空航天精密', bg: '#0F172A', surface: '#1E293B', text: '#F8FAFC', primary: '#38BDF8', accent: '#34D399' },
              { id: 'anodized-colorway', name: '阳极氧化艺术', bg: '#0B0F19', surface: '#161F30', text: '#E2E8F0', primary: '#8B5CF6', accent: '#EC4899' },
              { id: 'sustainable-metallics', name: '绿色低碳未来', bg: '#F8FAFC', surface: '#F1F5F9', text: '#0F172A', primary: '#059669', accent: '#475569' },
            ].map((t) => (
              <tr class="border-t transition-colors" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                <td class="px-6 py-4 font-medium whitespace-nowrap" style="color: var(--theme-primary);">{t.name}</td>
                <td class="px-6 py-4"><code class="rounded px-2 py-0.5 text-xs font-mono" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">{t.bg}</code></td>
                <td class="px-6 py-4"><code class="rounded px-2 py-0.5 text-xs font-mono" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">{t.surface}</code></td>
                <td class="px-6 py-4"><code class="rounded px-2 py-0.5 text-xs font-mono" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">{t.text}</code></td>
                <td class="px-6 py-4"><code class="rounded px-2 py-0.5 text-xs font-mono" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">{t.primary}</code></td>
                <td class="px-6 py-4"><code class="rounded px-2 py-0.5 text-xs font-mono" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">{t.accent}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
