---
/**
 * Grade 5 Titanium CNC Machining Services — Ti-6Al-4V
 *
 * D1 (Process) + D1 (Material) hub-mapping decision per Buyer Search
 * Intelligence SOP §1. Sub-page under the /titanium-cnc-machining-services/
 * Process hub. The four existing siblings (3-5-axis, cnc-milling-turning,
 * custom-industrial-components, wire-edm) cover generic multi-axis/process
 * scope; this page is the **material-specific** Grade 5 Ti-6Al-4V
 * machining deep-dive.
 *
 * Schema: Service entity emitted via BaseLayout pageType="service-detail".
 * FAQPage schema injected as a small inline JSON-LD (matches existing
 * FaqSection.astro convention — TODO: fold into BaseLayout in a future
 * refactor so SOP F4 is fully satisfied at the framework level).
 *
 * 5 inbound entries (SOP §1 Step 4):
 *   1. NAVIGATION in src/config/site.ts (added under "CNC Machining" column)
 *   2. Footer.astro (inherits from NAVIGATION)
 *   3. Sibling cross-link in 3-5-axis-cnc-machining.astro
 *   4. data/keywords/main-db.json (5 mapped entries)
 *   5. astro.config.mjs keywordMap (5 entries)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import TrustBadges from '../../components/landing/TrustBadges.astro';
import Applications from '../../components/landing/Applications.astro';
import { HERO_CONFIG } from '../../config/hero';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pageTitle = 'Grade 5 Titanium CNC Machining Services | Ti-6Al-4V (UNS R56400)';
const pageDescription =
  'Precision Grade 5 Titanium (Ti-6Al-4V, UNS R56400) CNC machining services for aerospace, medical, and advanced industrial components. AS9100D  controlled process, ±0.005 mm tolerance target, MTR-supported.';
const canonicalUrl = 'https://cnc.bozemetal.com/titanium-cnc-machining-services/grade-5-titanium-cnc-machining/';

const heroKey = '/titanium-cnc-machining-services/grade-5-titanium-cnc-machining';

// FAQ items (5 buyer-decision-support Q&A). Keys must be {question, answer}
// per Schema.org / SOP F3 — never {q, a}.
const faqItems = [
  {
    question: 'What is Grade 5 titanium and how is it designated in standards?',
    answer:
      'Grade 5 titanium is the common designation for the wrought alpha-beta alloy Ti-6Al-4V (UNS R56400). It is referenced in ASTM B348 (bars and billets), AMS 4928 (aerospace), and ISO 5832-3 (surgical implants). For medical-implant applications the ELI variant is Grade 23 (Ti-6Al-4V ELI) per ASTM F136.',
  },
  {
    question: 'What tolerance can be achieved on Grade 5 Ti-6Al-4V machined components?',
    answer:
      'For validated, supported geometries the machining process can target linear dimensional tolerances up to ±0.005 mm and GD&T positional tolerances up to 0.01 mm. Final tolerance commitment is confirmed after CAD, drawing, material condition, feature geometry, and inspection method review — not all features can be held at the tightest band simultaneously.',
  },
  {
    question: 'What quality documentation is supplied with each order?',
    answer:
      'Material Test Reports (MTR) per EN 10204 3.1 (or per the agreed specification), heat / lot identification, dimensional inspection records, and the agreed certificates of conformance are reviewed against the order documentation. Customer-supplied material is accepted by prior agreement and routed through incoming inspection.',
  },
  {
    question: 'What is the minimum order quantity for a Grade 5 titanium prototype?',
    answer:
      'A 1-piece minimum order quantity is supported to allow engineering teams to evaluate fit, critical dimensions, GD&T, thin-wall behavior, and surface finish before committing to a production run. Indicative prototype lead time is 5–7 working days, subject to drawing completeness, material availability, and inspection scope.',
  },
  {
    question: 'Can customer-supplied titanium stock be used?',
    answer:
      'Yes — by prior agreement, customer-supplied material is accepted subject to specification review, incoming inspection, material identification, and traceability requirements. This arrangement can help customers retain purchasing control over approved aerospace- or medical-grade stock and reduce working-capital exposure on raw material.',
  },
];

// FAQPage JSON-LD payload (matches visible content; matches existing
// FaqSection.astro convention). TODO: refactor into BaseLayout so SOP F4
// is satisfied at the framework level instead of per-page.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((it) => ({
    '@type': 'Question',
    name: it.question,
    acceptedAnswer: { '@type': 'Answer', text: it.answer },
  })),
};

// Material / quality standards (Section 2 of the buyer brief)
const standards = [
  { code: 'ASTM B348', scope: 'Titanium and titanium alloy bars and billets', application: 'Verify grade, condition, dimensions, and material certification against the purchase order.' },
  { code: 'ASTM F136', scope: 'Wrought Ti-6Al-4V ELI alloy for surgical implant applications', application: 'Confirm ELI material designation and applicable requirements for implant-related components.' },
  { code: 'ISO 5832-3', scope: 'Wrought Ti-6Al-4V alloy for surgical implants', application: 'Verify the specified material grade and applicable product requirements.' },
  { code: 'AMS 4928', scope: 'Aerospace titanium alloy material specification', application: 'Confirm specification applicability to the ordered product form, condition, and procurement requirements.' },
  { code: 'AS9100D', scope: 'Aerospace quality management system', application: 'Applicable when the manufacturing facility holds the relevant certification.' },
  { code: 'ISO 9001', scope: 'Quality management system', application: 'Applicable when the manufacturing facility holds the relevant certification.' },
];

// Three Critical Controls (Section 3 of the buyer brief)
const criticalControls = [
  {
    title: 'Thermal Management and Cutting-Edge Stability',
    challenge: 'Grade 5 titanium has low thermal conductivity. Heat concentrates near the tool–workpiece interface rather than dissipating rapidly through the workpiece and chips. Combined with titanium\'s chemical reactivity at elevated temperatures, this can accelerate tool wear, promote adhesion, and increase the risk of edge chipping or unstable surface conditions.',
    approach: 'We select cutting parameters, tool geometry, carbide grades, and coatings according to the component geometry, engagement conditions, and material condition. Where compatible with the machine setup and tool design, high-pressure coolant (HPC) and through-spindle coolant delivery help control the cutting zone and evacuate chips. Toolpath strategies, engagement control, and cutting-edge condition monitoring are used to manage heat generation and reduce avoidable tool failure.',
    outcome: 'More controlled cutting conditions for Ti-6Al-4V; reduced risk of tool-related dimensional drift and surface damage; improved process repeatability through controlled tool life and machining parameters. Final achievable tolerances depend on part geometry, setup rigidity, material condition, feature accessibility, and the inspection method.',
  },
  {
    title: 'Thin-Wall Stability, Springback, and GD&T Control',
    challenge: 'Grade 5 titanium has an elastic modulus of approximately 110 GPa. Thin walls and slender features can deflect under cutting forces and recover elastically after the tool passes. Residual stress, fixture pressure, tool engagement, and datum changes can further affect the final geometry. A nominally accurate toolpath is not enough: the finished part must satisfy the specified geometric relationships and inspection datums.',
    approach: 'We develop machining sequences around the component\'s structural stiffness and critical features. Depending on the drawing and setup, the process may incorporate 3-axis / 4-axis / 5-axis CNC machining selected for feature access and datum control, dedicated or custom workholding to minimize distortion without excessive clamping pressure, balanced roughing and finishing sequences, optimized tool engagement and cutting direction for thin-wall features, in-process measurement and tool / coordinate compensation where supported by the process, and final dimensional inspection against the drawing\'s GD&T requirements.',
    outcome: 'For suitable, validated geometries, the machining process can target linear dimensional tolerance up to ±0.005 mm and GD&T positional tolerance up to 0.01 mm. These are project-specific precision targets, not universal guarantees. The final tolerance commitment is confirmed after reviewing the CAD model, drawing, material condition, feature geometry, production volume, and measurement requirements.',
  },
  {
    title: 'Stress Relief, Surface Integrity, and Finishing',
    challenge: 'Material removal can redistribute residual stresses, particularly in thin-wall structures and components machined from stress-bearing stock. Tool condition, cutting parameters, burr formation, and post-machining treatment can also affect surface integrity and dimensional stability. Surface roughness alone does not establish fatigue performance, corrosion resistance, or suitability for a safety-critical application.',
    approach: 'We define the finishing sequence around the component\'s material specification and functional requirements. Depending on the agreed process, this may include rough machining followed by a controlled finishing pass, vacuum stress-relief heat treatment (where specified and metallurgically appropriate), deburring and edge conditioning per drawing requirements, surface-finish inspection at designated locations, Type II anodizing (where compatible with the specified titanium alloy and approved finishing process), and final dimensional inspection after applicable secondary operations.',
    outcome: 'Default surface-finish target Ra 0.8 μm, subject to drawing and feature accessibility; dimensional verification after specified finishing operations; documented material identity and agreed inspection records; defined acceptance criteria for critical surfaces, edges, and geometric features. Additional finishing processes, coatings, or treatments are confirmed against the component\'s functional requirements before quotation.',
  },
];

// Commercial terms (Section 4 of the buyer brief)
const leadTimeRows = [
  { phase: 'Prototype / Engineering Validation', moq: '1 piece', leadTime: '5–7 working days', objective: 'Validate fit, interfaces, critical dimensions, and manufacturability', notes: 'Heat treatment included in the stated prototype target when specified and feasible within the agreed process' },
  { phase: 'Production', moq: 'Based on the production order', leadTime: '3–4 weeks', objective: 'Establish repeatable output against the approved drawing and inspection plan', notes: 'Scheduled according to the approved process route' },
];

// Tier 1 outbound anchors (Answer Module ⑥ Related)
const relatedLinks = [
  { name: '3/4/5-Axis Titanium Machining', desc: 'Axis configuration selection for Ti-6Al-4V', href: '/titanium-cnc-machining-services/3-5-axis-cnc-machining/' },
  { name: 'Titanium CNC Milling & Turning', desc: 'Milling, turning, and mill-turn for Grade 5', href: '/titanium-cnc-machining-services/cnc-milling-turning/' },
  { name: 'Grade 5 Ti-6Al-4V Material Data', desc: 'Composition, mechanical properties, and forms', href: '/materials/grade-5/' },
  { name: 'AS9100D Compliance Hub', desc: 'Aerospace / medical / defense compliance scope', href: '/capabilities/compliance/' },
  { name: 'Submit Grade 5 RFQ', desc: 'Upload drawing for DFM engineering review', href: '/rfq/' },
];
---

<BaseLayout
  pageType="service-detail"
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalUrl}
  serviceName="Grade 5 Titanium (Ti-6Al-4V) CNC Machining Services"
  serviceDescription="Precision CNC machining of Grade 5 titanium (Ti-6Al-4V, UNS R56400) for aerospace structural components, medical device parts, and advanced industrial assemblies. AS9100D  / ISO 9001 controlled process with MTR-supported material traceability."
  serviceCategory="CNC Machining — Titanium"
  faqItems={faqItems}
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: var(--text-muted);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--text-muted);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-cnc-machining-services/" itemprop="item" class="transition-colors" style="color: var(--text-muted);">
            <span itemprop="name">Titanium CNC Machining Services</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--text-muted);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">Grade 5 Ti-6Al-4V</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <SubpageHero
    h1={HERO_CONFIG[heroKey].h1}
    subtitle={HERO_CONFIG[heroKey].subtitle}
    badge={HERO_CONFIG[heroKey].badge}
    badgeIcon="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 001.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
    keyMetrics={HERO_CONFIG[heroKey].keyMetrics}
    entityChips={HERO_CONFIG[heroKey].entityChips}
  />

  <!-- ① Direct Answer (Engineering Trust Bar) -->
  <TrustBadges />

  <!-- ================= ② HONEST POSITIONING (Scope & Limits) ================= -->
  <section class="relative py-16" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Scope &amp; Limits</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
          What This Page Covers — and What It Does Not
        </h2>
        <p class="mt-4 text-base leading-relaxed" style="color: var(--text-muted);">
          We machine Ti-6Al-4V Grade 5 to customer-defined drawings and purchase specifications, with material standards, condition, inspection requirements, and acceptance criteria confirmed during RFQ review. The limits below are not caveats — they are the procurement boundaries you should validate before releasing a drawing.
        </p>
      </header>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">In Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Subtractive CNC Machining</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">3-axis, 4-axis, 5-axis milling, turning, mill-turn, and wire EDM of wrought Ti-6Al-4V bar, billet, plate, and near-net forging stock.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">In Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Compliant Traceability</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">MTR per EN 10204 3.1, lot / heat identification, dimensional inspection records, and agreed certificates of conformance reviewed against the order documentation.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">In Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Engineered Finishing</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Vacuum stress-relief (where specified), deburring, edge conditioning, surface-finish inspection, and Type II anodizing on compatible alloys.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: var(--text-muted);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">Out of Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Finished-Device Compliance</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">For implant-related applications, material conformity alone does not establish finished-device compliance. Final validation, regulatory responsibilities, and acceptance testing remain with the customer.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: var(--text-muted);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">Out of Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Universal Tolerance Guarantees</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">±0.005 mm and Ra 0.8 μm are project-specific precision targets. Final tolerance is confirmed after CAD, drawing, material condition, feature geometry, volume, and inspection-method review.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: var(--text-muted);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-muted);">Out of Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">NDA-as-ITAR-Proof</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">We do not represent NDA coverage alone as proof of ITAR compliance. Any ITAR-controlled technical data requires a separate compliance and authorization review before transfer or processing.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ================= ③ STRUCTURED BODY · SECTION 2: Material & Quality Standards ================= -->
  <section class="relative py-20" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Engineering Compliance</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
          Material Compliance Starts with the Correct Specification
        </h2>
        <p class="mt-4 text-base leading-relaxed" style="color: var(--text-muted);">
          For aerospace structural components, medical device components, and precision industrial assemblies, material selection is only the first control point. The manufacturing process must also preserve drawing requirements, material identity, dimensional conformity, and lot-level documentation.
        </p>
      </header>

      <div class="overflow-x-auto rounded-2xl border" style="border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
        <table class="w-full text-left">
          <thead>
            <tr style="background: linear-gradient(135deg, var(--theme-primary) 12%, var(--theme-surface));">
              <th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Standard / Specification</th>
              <th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Material or Quality Scope</th>
              <th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Application in Procurement</th>
            </tr>
          </thead>
          <tbody>
            {
              standards.map((s, i) => (
                <tr style={`background: var(--theme-surface); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);`}>
                  <td class="px-5 py-4 align-top"><span class="font-bold text-sm" style="color: var(--theme-primary);">{s.code}</span></td>
                  <td class="px-5 py-4 align-top"><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);">{s.scope}</p></td>
                  <td class="px-5 py-4 align-top"><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{s.application}</p></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <!-- MTR callout -->
      <div
        class="mt-8 rounded-xl p-6 md:p-7 flex flex-col md:flex-row md:items-center gap-4"
        style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 6%, var(--theme-surface))); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);"
      >
        <svg class="w-7 h-7 md:mr-1 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        <div class="flex-1">
          <p class="text-base font-bold mb-1" style="color: var(--theme-text);">Material Documentation: MTR supplied with each shipment covered by the agreed traceability requirements.</p>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">Material certificates, heat or lot identification, and purchase specification requirements are reviewed against the order documentation. Customer-supplied material can be processed subject to incoming inspection, material identification, and agreed acceptance criteria.</p>
        </div>
        <a href="/rfq/" class="inline-flex items-center justify-center whitespace-nowrap px-6 py-3 rounded-lg font-bold text-sm transition-all duration-200 hover:-translate-y-0.5 shrink-0" style="background: linear-gradient(135deg, #ff8a3d 0%, #ff5a00 100%); color: #ffffff;">
          Submit Drawing &amp; Material Specification
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= ③ STRUCTURED BODY · SECTION 3: Three Critical Controls ================= -->
  <section class="relative py-20" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Technical Capabilities</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
          Three Critical Controls for Precision Ti-6Al-4V Machining
        </h2>
      </header>
      <div class="space-y-6">
        {
          criticalControls.map((c, i) => (
            <article class="rounded-2xl border p-6 md:p-8" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
              <div class="flex items-start gap-4 mb-5">
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl text-sm font-black shrink-0" style="background: linear-gradient(135deg, var(--theme-primary), color-mix(in srgb, var(--theme-primary) 70%, #000)); color: #0F172A;">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="text-xl md:text-2xl font-bold leading-snug" style="color: var(--theme-text);">{c.title}</h3>
              </div>
              <div class="grid gap-5 md:grid-cols-3">
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">Engineering Challenge</p>
                  <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{c.challenge}</p>
                </div>
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">Our Machining Approach</p>
                  <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{c.approach}</p>
                </div>
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">Engineering Outcome</p>
                  <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{c.outcome}</p>
