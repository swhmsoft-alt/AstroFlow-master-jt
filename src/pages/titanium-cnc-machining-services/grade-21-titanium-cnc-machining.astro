---
/**
 * Grade 21 Titanium CNC Machining Services — Ti-15Mo-3Nb-3Al-0.2Si (UNS R58210)
 *
 * BSI Phase P — metastable beta alloy for high-strength aerospace and
 * structural applications. Solution-treated in the beta field for
 * cold-formability; aged to develop high strength.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import TrustBadges from '../../components/landing/TrustBadges.astro';
import Applications from '../../components/landing/Applications.astro';
import { HERO_CONFIG } from '../../config/hero';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pageTitle = 'Grade 21 Titanium CNC Machining Services | Ti-15Mo-3Nb-3Al-0.2Si (UNS R58210)';
const pageDescription = 'Precision Grade 21 metastable beta titanium (Ti-15Mo-3Nb-3Al-0.2Si, UNS R58210) CNC machining services for high-strength aerospace structural and fastener applications. AMS 4915 / 4917 / 4928 controlled process, MTR-supported traceability.';
const canonicalUrl = 'https://cnc.bozemetal.com/titanium-cnc-machining-services/grade-21-titanium-cnc-machining/';

const heroKey = '/titanium-cnc-machining-services/grade-21-titanium-cnc-machining';

const faqItems = [
  { question: 'What is Grade 21 titanium and what makes it different?', answer: 'Grade 21 is a metastable beta titanium alloy (UNS R58210) with nominal 15% Mo, 3% Nb, 3% Al, 0.2% Si. In the solution-treated condition the beta-phase matrix is ductile and cold-formable; subsequent aging precipitates fine alpha phase and raises tensile strength to 1100+ MPa UTS. The trade-off vs Grade 5 is higher strength and better formability before aging, at the cost of higher density and more complex heat treatment.' },
  { question: 'What is the typical heat treatment for Grade 21?', answer: 'Solution treatment in the beta field (typically 800–850 °C, water quench) to retain the metastable beta phase, followed by aging (typically 480–595 °C, 4–24 h) to precipitate fine alpha. The exact parameters depend on the customer specification and the strength / ductility target. Machining in the solution-treated condition is easier; aging is done after final machining.' },
  { question: 'Is Grade 21 weldable?', answer: 'Yes, but the welds are typically left in the solution-treated condition and the assembly is age-hardened afterward. Beta-stabilizing elements (Mo, Nb) reduce weld-pool fluidity; the WPS / WPQ should be qualified against the actual customer specification, and post-weld stress relief is usually required.' },
  { question: 'What surface finish does Grade 21 require?', answer: 'The same contamination-controlled workflow used for alloyed titanium grades: no iron embedment, no free-cutting-fluid residue, ASTM B600 alkaline cleaning + acid pickling for parts that go into fatigue-loaded service.' },
  { question: 'What is the minimum order quantity for a Grade 21 prototype?', answer: 'A 1-piece minimum order quantity is supported. Indicative prototype lead time is 5–7 working days for the machined component, plus any subsequent solution / aging cycle.' },
];

const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((it) => ({ '@type': 'Question', name: it.question, acceptedAnswer: { '@type': 'Answer', text: it.answer } })) };

const standards = [
  { code: 'AMS 4915', scope: 'Titanium alloy sheet, strip, and plate (Ti-15Mo-3Nb-3Al-0.2Si)', application: 'Verify specification applicability for plate and sheet stock.' },
  { code: 'AMS 4917', scope: 'Titanium alloy plate (Ti-15Mo-3Nb-3Al-0.2Si)', application: 'Confirm specification applicability for plate applications.' },
  { code: 'AMS 4928', scope: 'Titanium alloy bars and billets (Ti-15Mo-3Nb-3Al-0.2Si)', application: 'Verify specification for bar / billet stock.' },
  { code: 'ASTM B348', scope: 'Titanium and titanium alloy bars and billets (general, applicable to beta alloys)', application: 'General bar / billet reference where AMS not specified.' },
  { code: 'ASTM B600', scope: 'Surface preparation of titanium and titanium alloy surfaces', application: 'Pickling / passivation reference for fatigue-loaded components.' },
];

const criticalControls = [
  { title: 'Beta-Phase Stability and Over-Aging Avoidance', challenge: 'Grade 21 strength is developed by aging the metastable beta matrix. Excessive heat input during machining — high cutting temperatures, slow traverse, or interrupted cuts that re-heat the same zone — can locally over-age the surface and produce inconsistent hardness, dimensional drift, and reduced fatigue life.', approach: 'We select cutting parameters and tool geometries to keep the cutting-zone temperature well below the aging range. Sharp tools, high-pressure coolant, and conservative engagement keep the bulk material cool. Material is supplied in the solution-treated condition for machining; aging is performed as a separate post-machining step per the customer specification.', outcome: 'Mechanical properties consistent with the agreed specification at the machined surface and in the bulk. Final tolerance and property targets are confirmed after CAD, drawing, material condition, and inspection method review.' },
  { title: 'Cold-Form + Age-Hardening Sequence Coordination', challenge: 'The advantage of Grade 21 is its cold-formability in the solution-treated condition followed by age-hardening to 1100+ MPa UTS. Machining a part that has already been age-hardened is significantly harder and risks tool breakage; machining a part that has been cold-formed but not aged can produce springback and shape drift.', approach: 'We confirm the sequence with the customer at the RFQ stage: machine in the solution-treated condition, then age. We use a stress-relief step between heavy roughing and finishing to minimize distortion during aging. Inspection intervals are scheduled to catch any movement between machining and aging.', outcome: 'Final geometry held within drawing tolerance after aging, with documented cutting parameters and the agreed heat-treatment sequence.' },
  { title: 'Heat-Treatment Parameter Control and Documentation', challenge: 'Grade 21 mechanical properties are highly sensitive to solution-treatment temperature, quench rate, and aging parameters. A 10 °C shift in aging temperature or a missed quench step can move the yield strength by 100 MPa or more, and the result is not visible at the machined surface — only in subsequent mechanical testing.', approach: 'We do not perform the solution / aging treatment in-house unless explicitly contracted; we typically ship the machined part to the customer or to a qualified heat-treater with documented material condition and recommended parameters. When we do coordinate heat treatment, we use qualified vendors with calibrated furnaces and full cycle traceability.', outcome: 'Heat-treatment cycle is traceable to the specific part, the agreed parameters are within the specification window, and the customer receives documented evidence of the cycle applied.' },
];

const relatedLinks = [
  { name: '3/4/5-Axis Titanium Machining', desc: 'Axis configuration selection for Grade 21 components', href: '/titanium-cnc-machining-services/3-5-axis-cnc-machining/' },
  { name: 'Grade 5 Ti-6Al-4V Machining', desc: 'Higher-volume alpha+beta alloy counterpart', href: '/titanium-cnc-machining-services/grade-5-titanium-cnc-machining/' },
  { name: 'Grade 9 Ti-3Al-2.5V Machining', desc: 'Near-alpha alloy for hydraulic tubing', href: '/titanium-cnc-machining-services/grade-9-titanium-cnc-machining/' },
  { name: 'Grade 21 Ti-15Mo-3Nb-3Al Material Data', desc: 'Composition, mechanical properties, and forms', href: '/materials/grade-21/' },
  { name: 'Submit Grade 21 RFQ', desc: 'Upload drawing for DFM engineering review', href: '/rfq/' },
];
---

<BaseLayout pageType="service-detail" title={pageTitle} description={pageDescription} canonicalURL={canonicalUrl} serviceName="Grade 21 Metastable Beta Titanium (Ti-15Mo-3Nb-3Al) CNC Machining Services" serviceDescription="Precision CNC machining of Grade 21 metastable beta titanium (Ti-15Mo-3Nb-3Al-0.2Si, UNS R58210) for high-strength aerospace structural and fastener applications. AMS 4915 / 4917 / 4928 controlled process with MTR-supported traceability and coordinated solution-treat + age sequence." serviceCategory="CNC Machining — Beta Titanium" faqItems={faqItems}>
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList"><li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">{t('nav.home')}</span></a><meta itemprop="position" content="1" /><svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li><li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a href="/titanium-cnc-machining-services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">Titanium CNC Machining Services</span></a><meta itemprop="position" content="2" /><svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li><li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><span itemprop="name" class="font-semibold" style="color: var(--theme-text);">Grade 21 Ti-15Mo-3Nb-3Al</span><meta itemprop="position" content="3" /></li></ol></div></nav>

  <SubpageHero h1={HERO_CONFIG[heroKey].h1} subtitle={HERO_CONFIG[heroKey].subtitle} badge={HERO_CONFIG[heroKey].badge} badgeIcon="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 001.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" keyMetrics={HERO_CONFIG[heroKey].keyMetrics} entityChips={HERO_CONFIG[heroKey].entityChips} />

  <TrustBadges />

  <section class="relative py-20" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Engineering Compliance</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">High-Strength Beta-Alloy Material Compliance Starts with the Correct Specification</h2>
        <p class="mt-4 text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">For aerospace structural components, fasteners, and high-strength assemblies where Grade 5 strength (~895 MPa UTS) is insufficient but cold-formability and weldability are still required, Grade 21 (Ti-15Mo-3Nb-3Al) is the specified alloy. The manufacturing process must preserve the agreed heat-treatment sequence and the material identity, and document the solution-treat / age parameters applied.</p>
      </header>
      <div class="overflow-x-auto rounded-2xl border" style="border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
        <table class="w-full text-left">
          <thead><tr style="background: linear-gradient(135deg, var(--theme-primary) 12%, var(--theme-surface));"><th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Standard / Specification</th><th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Material or Quality Scope</th><th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Application in Procurement</th></tr></thead>
          <tbody>
            {standards.map((s) => (<tr style="background: var(--theme-surface); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"><td class="px-5 py-4 align-top"><span class="font-bold text-sm" style="color: var(--theme-primary);">{s.code}</span></td><td class="px-5 py-4 align-top"><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);">{s.scope}</p></td><td class="px-5 py-4 align-top"><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{s.application}</p></td></tr>))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="relative py-20" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Technical Capabilities</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Three Critical Controls for Grade 21 Beta-Alloy Machining</h2>
      </header>
      <div class="space-y-6">
        {criticalControls.map((c, i) => (
          <article class="rounded-2xl border p-6 md:p-8" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
            <div class="flex items-start gap-4 mb-5">
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl text-sm font-black shrink-0" style="background: linear-gradient(135deg, var(--theme-primary), color-mix(in srgb, var(--theme-primary) 70%, #000)); color: #0F172A;">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="text-xl md:text-2xl font-bold leading-snug" style="color: var(--theme-text);">{c.title}</h3>
            </div>
            <div class="grid gap-5 md:grid-cols-3">
              <div><p class="text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">Engineering Challenge</p><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{c.challenge}</p></div>
              <div><p class="text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">Our Machining Approach</p><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{c.approach}</p></div>
              <div><p class="text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">Engineering Outcome</p><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{c.outcome}</p></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Applications />

  <section class="relative" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="max-w-4xl mx-auto rounded-3xl border p-8 md:p-10 text-center" style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 4%, var(--theme-surface))); border-color: color-mix(in srgb, var(--theme-primary) 22%, transparent);">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Submit Your Engineering Package</p>
        <h2 class="text-2xl md:text-3xl font-bold leading-tight mb-3" style="color: var(--theme-text);">Have a Grade 21 Ti-15Mo-3Nb-3Al Component Ready for Manufacturing?</h2>
        <p class="text-base leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">Send your drawing to initiate a technical review. Accepted file formats: STEP, STP, DXF. <strong>Target response: initial RFQ acknowledgment within 24 hours on working days.</strong> Mutual NDA available before technical file exchange.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/rfq/" class="inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 text-sm font-bold text-white shadow-lg" style="background: linear-gradient(135deg, #ff8a3d 0%, #ff5a00 100%);">Upload CAD/STEP for DFM Review<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg></a>
          <a href="/rfq/" class="inline-flex items-center justify-center gap-2 rounded-xl border px-6 py-3 text-sm font-bold" style="border-color: var(--theme-primary); color: var(--theme-primary);">Request a Grade 21 Quote</a>
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <header class="max-w-3xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Related Capabilities</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Continue the Engineering Review</h2>
      </header>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {relatedLinks.map((r) => (
          <a href={r.href} class="rounded-2xl border p-6 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
            <h3 class="text-lg font-bold" style="color: var(--theme-primary);">{r.name}</h3>
            <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{r.desc}</p>
            <p class="mt-4 text-xs font-semibold" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{r.href} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="text-center mb-12 max-w-3xl mx-auto">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Frequently Asked Questions</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Grade 21 Ti-15Mo-3Nb-3Al CNC Machining — Engineering FAQ</h2>
      </header>
      <div class="max-w-4xl mx-auto space-y-4">
        {faqItems.map((it, idx) => (
          <details class="group rounded-xl overflow-hidden border" style="background-color: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 22%, transparent);" open={idx === 0}>
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-bold text-base md:text-lg list-none" style="color: var(--theme-text);">
              <span class="flex items-start">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg mr-4 shrink-0 text-xs font-bold" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">Q{idx + 1}</span>
                <span class="leading-snug">{it.question}</span>
              </span>
              <svg class="w-5 h-5 shrink-0 transition-transform group-open:rotate-180" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-6 pt-2 text-sm md:text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{it.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>