---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import WireEdmAdvantages from '../../components/services/WireEdmAdvantages.astro';
import WireEdmSpecsDashboard from '../../components/services/WireEdmSpecsDashboard.astro';
import WireEdmKnowHow from '../../components/services/WireEdmKnowHow.astro';
import WireEdmDedicatedCta from '../../components/services/WireEdmDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-cnc-machining-services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services.titaniumCncMachiningServices')}</span>
          </a>
          <meta itemprop="position" content="3" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.wireEdmMachining')}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title={t('titanium-cnc-machining-services.wireEdmMachining.wire_edm_machining')}
    highlight="Services"
    badge="Precision EDM Machining"
    badgeIcon="M13 10V3L4 14h7v7l9-11h-7z"
    subtitle="Electric discharge cutting for micro-slots, hardened titanium alloys, thin-wall parts, and complex tapered profiles — achieving ±0.002 mm accuracy and Ra 0.25 µm micro-finish."
  
    keyMetrics={HERO_CONFIG['/titanium-cnc-machining-services/wire-edm-machining']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-cnc-machining-services/wire-edm-machining']?.entityChips}
  />

  <!-- Wire EDM Process Advantages — 3-column grid -->
  <WireEdmAdvantages />

  <!-- Wire EDM Technical Specs Dashboard — 4-column -->
  <WireEdmSpecsDashboard />

  <!-- Wire EDM Engineering Know-How — 2-column challenge/solution -->
  <WireEdmKnowHow />

  <!-- Dedicated CTA for Wire EDM DFM Analysis -->
  <WireEdmDedicatedCta />
</BaseLayout>