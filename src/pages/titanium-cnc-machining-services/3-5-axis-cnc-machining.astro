---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudienceHub from '../../components/audience/AudienceHub.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import MultiAxisComparison from '../../components/services/MultiAxisComparison.astro';
import MultiAxisCta from '../../components/services/MultiAxisCta.astro';
import TitaniumPainPoints from '../../components/services/TitaniumPainPoints.astro';
import AxisComparisonMatrix from '../../components/services/AxisComparisonMatrix.astro';
import QualityControl from '../../components/services/QualityControl.astro';
import FaqSection from '../../components/services/FaqSection.astro';
import CaseStudies from '../../components/services/CaseStudies.astro';
import LeadTimePricing from '../../components/services/LeadTimePricing.astro';
import ProcessCapability from '../../components/services/ProcessCapability.astro';
import TeamCredentials from '../../components/services/TeamCredentials.astro';
import QuickStatsBanner from '../../components/services/QuickStatsBanner.astro';
import WhyBozeVsOthers from '../../components/services/WhyBozeVsOthers.astro';
import FileProcessAndCapacity from '../../components/services/FileProcessAndCapacity.astro';
import HowToChooseAxis from '../../components/services/HowToChooseAxis.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Service JSON-LD schema for AI citation (ProductSchema)
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'CNC Machining',
  name: 'Titanium CNC Machining Services — 3-Axis / 4-Axis / 5-Axis',
  provider: {
    '@type': 'Organization',
    name: 'BOZE CNC',
    foundingDate: '2011',
  },
  areaServed: ['United States', 'European Union', 'United Kingdom'],
  description: 'High-precision 3-axis, 4-axis, and 5-axis CNC machining of titanium alloys for aerospace, medical, motorsport, and chemical-processing industries. AS9100D / ISO 13485 / ISO 9001 certified.',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'USD',
    priceRange: '$$',
  },
};
---

<BaseLayout>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-cnc-machining-services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services.titaniumCncMachiningServices')}</span>
          </a>
          <meta itemprop="position" content="3" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.3_5AxisCncMachining')}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero awareness lead-in (Buyer Decision Chain stage 1) -->
  <section style="background-color: var(--theme-bg); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);" class="py-6">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm md:text-base" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
        Need to machine titanium parts? Aerospace brackets, medical implants, blisks, or custom prototypes? You are in the right place.
      </p>
    </div>
  </section>

  <!-- Hero -->
  <SubpageHero
    title="High-Precision Titanium CNC Machining"
    highlight="3-Axis · 4-Axis · 5-Axis"
    badge="Titanium CNC | AS9100D"
    badgeIcon="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
    subtitle="High-precision CNC machining for difficult-to-cut titanium (Ti-6Al-4V Grade 5, CP-Ti Grade 2, Ti-6Al-4V ELI Grade 23) — overcoming poor heat dissipation and severe work-hardening. From standard aerospace brackets to blisks and orthopedic implants, with full DFM assessment and custom production."

    keyMetrics={HERO_CONFIG['/titanium-cnc-machining-services/3-5-axis-cnc-machining']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-cnc-machining-services/3-5-axis-cnc-machining']?.entityChips}
  />

  <!-- 1. Quick Stats Banner (EEAT: years, scale, certs) -->
  <QuickStatsBanner />

  <!-- 2. How to Choose Your Axis (AI: HowTo schema) -->
  <HowToChooseAxis />

  <!-- 3. Pain points -->
  <TitaniumPainPoints />

  <!-- 4. Engineering comparison matrix -->
  <AxisComparisonMatrix />

  <!-- 5. Per-axis capability cards (now with Best for / Not for) -->
  <MultiAxisComparison />

  <!-- 6. Process capability / Cpk data -->
  <ProcessCapability />

  <!-- 7. Quality Control & Certifications -->
  <QualityControl />

  <!-- 8. Engineering team credentials -->
  <TeamCredentials />

  <!-- 9. Customer case studies -->
  <CaseStudies />

  <!-- 10. Lead time & pricing transparency -->
  <LeadTimePricing />

  <!-- 11. File Process & Capacity (Buyer: fileProcess + capacityLock) -->
  <FileProcessAndCapacity />

  <!-- 12. BOZE vs Others (Buyer: comparison) -->
  <WhyBozeVsOthers />

  <!-- 13. FAQ (AI: FAQPage schema) -->
  <FaqSection />

  <!-- 14. Conversion CTA -->
  <MultiAxisCta />
  <AudienceHub industry="cnc-machining" />

  <!-- Service JSON-LD schema (AI citation) -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
</BaseLayout>