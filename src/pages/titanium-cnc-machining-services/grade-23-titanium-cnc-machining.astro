---
/**
 * Grade 23 Titanium CNC Machining Services — Ti-6Al-4V ELI (UNS R56407)
 *
 * BSI Phase J — parallel to Phase I (Grade 5 Ti-6Al-4V) sub-page.
 * D1 (Process) + D1 (Material) hybrid sub-page under the
 * /titanium-cnc-machining-services/ Process hub. Medical/implant-focused
 * counterpart of the Grade 5 page.
 *
 * Key differences vs Grade 5:
 *  - Standard:  ASTM F136 (primary, surgical implants) / ISO 5832-3
 *  - UNS:       R56407 (ELI variant of R56400)
 *  - Property:  Lower O/N/C/Fe limits → better ductility, fracture toughness,
 *               fatigue life, and biocompatibility
 *  - Surface:   ASTM F86 passivation, electropolishing, anodizing for
 *               color-coded surgical identification
 *  - Sterilization compatibility: autoclave, gamma, EtO
 *
 * Schema: Service entity emitted via BaseLayout pageType="service-detail".
 * FAQPage JSON-LD inline at end (matches existing FaqSection.astro
 * convention; TODO refactor into BaseLayout to fully satisfy SOP F4).
 *
 * 5 inbound entries (SOP §1 Step 4):
 *   1. NAVIGATION in src/config/site.ts (under "CNC Machining" column)
 *   2. Footer.astro (inherits from NAVIGATION)
 *   3. Sibling cross-links: 3-5-axis-cnc-machining.astro + grade-5-titanium-cnc-machining.astro
 *   4. data/keywords/main-db.json (5 mapped entries)
 *   5. astro.config.mjs keywordMap (5 entries)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import TrustBadges from '../../components/landing/TrustBadges.astro';
import Applications from '../../components/landing/Applications.astro';
import { HERO_CONFIG } from '../../config/hero';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pageTitle = 'Grade 23 Titanium CNC Machining Services | Ti-6Al-4V ELI (UNS R56407)';
const pageDescription =
  'Precision Grade 23 Titanium (Ti-6Al-4V ELI, UNS R56407) CNC machining services for medical implants, surgical instruments, and dental applications. ASTM F136 / ISO 5832-3 controlled process, ±0.005 mm tolerance target, MTR-supported.';
const canonicalUrl = 'https://cnc.bozemetal.com/titanium-cnc-machining-services/grade-23-titanium-cnc-machining/';

const heroKey = '/titanium-cnc-machining-services/grade-23-titanium-cnc-machining';

// FAQ items (5 buyer-decision-support Q&A). Keys must be {question, answer}
// per Schema.org / SOP F3 — never {q, a}.
const faqItems = [
  {
    question: 'What is Grade 23 titanium and how does it differ from Grade 5?',
    answer:
      'Grade 23 titanium is the ELI (Extra Low Interstitials) variant of Ti-6Al-4V, designated UNS R56407. Compared to Grade 5 (UNS R56400), it has tighter upper limits on oxygen, nitrogen, carbon, and iron. The lower interstitial content improves ductility, fracture toughness, fatigue life, and biocompatibility — making it the specified alloy for surgical implants per ASTM F136 and ISO 5832-3.',
  },
  {
    question: 'Is Grade 23 ELI required for medical implants?',
    answer:
      'For finished implants placed in contact with bone, soft tissue, or body fluids, ASTM F136 (Grade 23 ELI) and ISO 5832-3 are the most commonly cited material specifications. The ELI chemistry reduces the risk of adverse biological response and improves fatigue performance under cyclic load. Material conformity is reviewed against the customer specification; finished-device compliance remains the customer regulatory responsibility.',
  },
  {
    question: 'What surface finish and post-processing is required for medical-grade parts?',
    answer:
      'Surface-finish targets depend on the implant function. Load-bearing articulating surfaces typically require very low Ra (achievable via electropolishing), while bone-contact surfaces may need controlled micro-roughness for osseointegration. Passivation per ASTM F86, electropolishing, and Type II / Type III anodizing for color coding are common secondary operations. Final finish requirements are confirmed against the customer drawing and the agreed inspection plan.',
  },
  {
    question: 'What sterilization methods are compatible with Grade 23 Ti-6Al-4V ELI?',
    answer:
      'Ti-6Al-4V ELI is compatible with the three primary sterilization methods used in medical device manufacturing: steam autoclave (typically 134 °C / 18 min), gamma irradiation, and ethylene oxide (EtO). The alloy does not degrade under standard validated sterilization cycles, and finished surface treatments (passivation, electropolish, anodize) are selected to remain stable through the agreed sterilization route.',
  },
  {
    question: 'What is the minimum order quantity for a Grade 23 prototype?',
    answer:
      'A 1-piece minimum order quantity is supported to allow engineering teams to evaluate fit, critical dimensions, GD&T, and surface finish before committing to a production run. Indicative prototype lead time is 5–7 working days, subject to drawing completeness, material availability, inspection scope, and any agreed secondary operations such as passivation or anodizing.',
  },
];

// FAQPage JSON-LD payload. TODO: refactor into BaseLayout so SOP F4 is
// fully satisfied at the framework level instead of per-page.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((it) => ({
    '@type': 'Question',
    name: it.question,
    acceptedAnswer: { '@type': 'Answer', text: it.answer },
  })),
};

// Material / quality standards (Section 2 — medical/implant-focused)
const standards = [
  { code: 'ASTM F136', scope: 'Wrought Ti-6Al-4V ELI alloy for surgical implant applications', application: 'Confirm ELI material designation, interstitial limits, and applicable requirements for implant components.' },
  { code: 'ISO 5832-3', scope: 'Wrought Ti-6Al-4V alloy for surgical implants', application: 'Verify the specified material grade and applicable product requirements for implant-related components.' },
  { code: 'ASTM B348', scope: 'Titanium and titanium alloy bars and billets (general)', application: 'Verify grade, condition, dimensions, and material certification for non-implant Ti-6Al-4V ELI bar / billet stock.' },
  { code: 'AMS 4930', scope: 'Aerospace Ti-6Al-4V ELI bar, wire, and forging stock', application: 'Confirm specification applicability when aerospace-grade ELI stock is required for medical or hybrid programs.' },
  { code: 'ASTM F86', scope: 'Standard practice for surface preparation and marking of metallic surgical implants', application: 'Reference for the agreed passivation and surface preparation step on finished implant components.' },
  { code: 'AS9100D', scope: 'Aerospace quality management system', application: 'Applicable when the manufacturing facility holds the relevant certification and the program has aerospace overlap.' },
  { code: 'ISO 13485', scope: 'Medical device quality management system', application: 'Applicable when the manufacturing facility holds the relevant certification and the component supports a medical device.' },
  { code: 'ISO 9001', scope: 'Quality management system', application: 'Applicable when the manufacturing facility holds the relevant certification.' },
];

// Three Critical Controls (Section 3 — medical/implant-focused)
const criticalControls = [
  {
    title: 'Biocompatibility and Surface Integrity',
    challenge: 'Implant components must not introduce contaminants, foreign material, or surface conditions that compromise biological safety. Cross-contamination from non-medical work, residual machining fluid, embedded abrasive, or uncontrolled surface chemistry can affect osseointegration, fatigue performance, and regulatory acceptance. ELI chemistry alone does not establish finished-implant biocompatibility.',
    approach: 'We segregate medical-grade work where the order scope requires it, use cutting fluids and cleaning agents compatible with the agreed surface-preparation route, and verify that no cross-contamination from prior work is introduced. Material identity is preserved through incoming inspection, in-process marking, and segregated tool / workholding. Surface preparation per ASTM F86 (pickling / passivation) and, where specified, electropolishing are scheduled as part of the agreed process route.',
    outcome: 'Implant-grade surface integrity suitable for downstream passivation and sterilization; preserved ELI material chemistry at the machined surface; documented material identity and lot traceability through to the shipping record. Finished-device biocompatibility remains subject to the customer regulatory validation and sterilization qualification.',
  },
  {
    title: 'Thin-Wall, Micro-Feature, and Thread Precision',
    challenge: 'Implant geometries often combine thin walls (spinal cage struts, acetabular shell features), micro-features (bone-screw thread forms, micro-pores for bone apposition), and small lot sizes. Springback, tool deflection, and chip evacuation are amplified at these scales. Standard machining approaches optimised for thicker aerospace sections do not transfer directly to thin-wall / micro-feature medical work.',
    approach: 'We select cutting parameters, micro-tool geometry, and tool coatings around the thinnest wall and the smallest feature on the drawing. Where the geometry requires it, 3-axis / 4-axis / 5-axis CNC machining is used to maintain access and datum control, with dedicated workholding sized to the implant envelope. In-process measurement, tool-compensation, and conservative finishing passes are used to manage micro-feature fidelity. Final dimensional inspection is conducted against the drawing GD&T and the agreed inspection plan.',
    outcome: 'For suitable, validated geometries the machining process can target linear dimensional tolerance up to ±0.005 mm and GD&T positional tolerance up to 0.01 mm, with thread forms and micro-features held to the drawing-specified limits. These are project-specific precision targets, not universal guarantees — final tolerance commitment is confirmed after CAD, drawing, material condition, feature geometry, and inspection method review.',
  },
  {
    title: 'Sterilization Compatibility and Finishing',
    challenge: 'Finished implants must withstand the customer validated sterilization cycle — typically steam autoclave, gamma irradiation, or ethylene oxide (EtO) — without surface degradation, dimensional change, or coating failure. Surface roughness alone does not establish fatigue performance, corrosion resistance, or compatibility with the sterilization route. Anodized color coding (commonly used for surgical size identification) must remain stable through the agreed cycle.',
    approach: 'We define the finishing sequence around the customer downstream sterilization and the implant functional requirements. Depending on the agreed process, this may include surface preparation per ASTM F86, electropolishing for low surface roughness on articulating surfaces, Type II or Type III anodizing for color coding, controlled cleaning, and packaging in the agreed clean-room class. Process parameters and acceptance criteria are documented in the agreed inspection plan.',
    outcome: 'Surface compatible with the agreed sterilization route, documented surface-finish values at designated inspection locations, defined acceptance criteria for critical surfaces and edges, and packaging suitable for clean-handling at the customer incoming inspection. Heat treatment, anodizing, and sterilization parameters remain subject to the customer regulatory qualification of the finished device.',
  },
];

// Tier 1 outbound anchors (Answer Module ⑥ Related)
const relatedLinks = [
  { name: '3/4/5-Axis Titanium Machining', desc: 'Axis configuration selection for medical implants', href: '/titanium-cnc-machining-services/3-5-axis-cnc-machining/' },
  { name: 'Grade 5 Ti-6Al-4V Machining', desc: 'Aerospace / industrial counterpart of Grade 23', href: '/titanium-cnc-machining-services/grade-5-titanium-cnc-machining/' },
  { name: 'Grade 23 ELI Material Data', desc: 'Composition, mechanical properties, and forms', href: '/materials/grade-23/' },
  { name: 'ISO 13485 Compliance Hub', desc: 'Medical device quality management scope', href: '/capabilities/compliance/' },
  { name: 'Submit Grade 23 RFQ', desc: 'Upload drawing for DFM engineering review', href: '/rfq/' },
];
---

<BaseLayout
  pageType="service-detail"
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalUrl}
  serviceName="Grade 23 Titanium (Ti-6Al-4V ELI) CNC Machining Services"
  serviceDescription="Precision CNC machining of Grade 23 titanium (Ti-6Al-4V ELI, UNS R56407) for orthopedic, spinal, dental, and surgical instrument components. ASTM F136 / ISO 5832-3 controlled process with ASTM F86 surface preparation, MTR-supported material traceability, and sterilization-compatible finishing."
  serviceCategory="CNC Machining — Medical Titanium"
  faqItems={faqItems}
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-cnc-machining-services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">Titanium CNC Machining Services</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">Grade 23 Ti-6Al-4V ELI</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <SubpageHero
    h1={HERO_CONFIG[heroKey].h1}
    subtitle={HERO_CONFIG[heroKey].subtitle}
    badge={HERO_CONFIG[heroKey].badge}
    badgeIcon="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 001.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
    keyMetrics={HERO_CONFIG[heroKey].keyMetrics}
    entityChips={HERO_CONFIG[heroKey].entityChips}
  />

  <!-- ① Direct Answer (Engineering Trust Bar) -->
  <TrustBadges />

  <!-- ================= ② HONEST POSITIONING (Scope & Limits) ================= -->
  <section class="relative py-16" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Scope &amp; Limits</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
          What This Page Covers — and What It Does Not
        </h2>
        <p class="mt-4 text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          We machine Ti-6Al-4V ELI (Grade 23) to customer-defined drawings and purchase specifications, with material standards, condition, inspection requirements, and acceptance criteria confirmed during RFQ review. The limits below are not caveats — they are the regulatory and process boundaries you should validate before releasing a drawing.
        </p>
      </header>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">In Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Implant-Grade Subtractive Machining</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">3-axis, 4-axis, 5-axis milling, turning, mill-turn, and micro-machining of wrought Ti-6Al-4V ELI bar, billet, and forging stock for orthopedic, spinal, dental, trauma, and surgical-instrument components.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">In Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">ASTM F136 / ISO 5832-3 Traceability</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">ELI interstitial limits, lot / heat identification, MTR per EN 10204 3.1, dimensional inspection records, and the agreed certificates of conformance reviewed against the order documentation.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">In Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Sterilization-Compatible Finishing</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">ASTM F86 surface preparation, electropolishing, Type II / Type III anodizing for color coding, controlled cleaning, and packaging per the agreed clean-room class.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-text) 15%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">Out of Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Finished-Device Regulatory Clearance</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Material conformity per ASTM F136 / ISO 5832-3 does not establish finished-device compliance. FDA / CE / NMPA clearance, sterilization validation, and finished-device biocompatibility testing remain the customer regulatory responsibility.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-text) 15%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">Out of Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Universal Tolerance Guarantees</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">±0.005 mm and micro-feature fidelity are project-specific precision targets. Final tolerance is confirmed after CAD, drawing, material condition, feature geometry, volume, and inspection-method review.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-text) 15%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">Out of Scope</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Sterilization Validation</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">We supply components suitable for the agreed sterilization route, but we do not perform or validate finished-device sterilization cycles. Sterilization qualification remains the customer regulatory responsibility.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ================= ③ STRUCTURED BODY · SECTION 2: Material & Quality Standards ================= -->
  <section class="relative py-20" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Engineering Compliance</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
          Medical-Grade Material Compliance Starts with the Correct Specification
        </h2>
        <p class="mt-4 text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          For orthopedic, spinal, dental, and surgical-instrument components, the material specification is the first control point and the foundation for finished-device compliance. The manufacturing process must preserve drawing requirements, ELI material identity, dimensional conformity, and lot-level documentation.
        </p>
      </header>

      <div class="overflow-x-auto rounded-2xl border" style="border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
        <table class="w-full text-left">
          <thead>
            <tr style="background: linear-gradient(135deg, var(--theme-primary) 12%, var(--theme-surface));">
              <th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Standard / Specification</th>
              <th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Material or Quality Scope</th>
              <th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Application in Procurement</th>
            </tr>
          </thead>
          <tbody>
            {
              standards.map((s) => (
                <tr style="background: var(--theme-surface); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                  <td class="px-5 py-4 align-top"><span class="font-bold text-sm" style="color: var(--theme-primary);">{s.code}</span></td>
                  <td class="px-5 py-4 align-top"><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);">{s.scope}</p></td>
                  <td class="px-5 py-4 align-top"><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{s.application}</p></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="mt-8 rounded-xl p-6 md:p-7 flex flex-col md:flex-row md:items-center gap-4" style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 6%, var(--theme-surface))); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);">
        <svg class="w-7 h-7 md:mr-1 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        <div class="flex-1">
          <p class="text-base font-bold mb-1" style="color: var(--theme-text);">Material Documentation: MTR supplied with each shipment covered by the agreed traceability requirements.</p>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">Material certificates, ELI interstitial verification, heat / lot identification, and purchase specification requirements are reviewed against the order documentation. Customer-supplied medical-grade material is accepted by prior agreement subject to incoming inspection and identification.</p>
        </div>
        <a href="/rfq/" class="inline-flex items-center justify-center whitespace-nowrap px-6 py-3 rounded-lg font-bold text-sm transition-all duration-200 hover:-translate-y-0.5 shrink-0" style="background: linear-gradient(135deg, #ff8a3d 0%, #ff5a00 100%); color: #ffffff;">
          Submit Drawing &amp; Material Specification
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= ③ STRUCTURED BODY · SECTION 3: Three Critical Controls ================= -->
  <section class="relative py-20" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Technical Capabilities</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
          Three Critical Controls for Medical-Grade Ti-6Al-4V ELI Machining
        </h2>
      </header>
      <div class="space-y-6">
        {
          criticalControls.map((c, i) => (
