---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudienceHub from '../../components/audience/AudienceHub.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import CustomComponentSpectrum from '../../components/services/CustomComponentSpectrum.astro';
import SystemSpecsDashboard from '../../components/services/SystemSpecsDashboard.astro';
import CustomComponentsKnowHow from '../../components/services/CustomComponentsKnowHow.astro';
import ComponentDedicatedCta from '../../components/services/ComponentDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-cnc-machining-services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services.titaniumCncMachiningServices')}</span>
          </a>
          <meta itemprop="position" content="3" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.customIndustrialComponents')}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title={t('titanium-cnc-machining-services.customIndustrialComponents.custom_industrial_components')}
    highlight="Services"
    badge="Industrial Component Manufacturing"
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    subtitle="Vacuum chambers, high-pressure pump valves, structural assemblies, and precision micro-components — from prototype to batch production with full NIST traceability."
  
    keyMetrics={HERO_CONFIG['/titanium-cnc-machining-services/custom-industrial-components']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-cnc-machining-services/custom-industrial-components']?.entityChips}
  />

  <!-- Custom Component Spectrum — 3-column grid -->
  <CustomComponentSpectrum />

  <!-- System Throughput Dashboard — 4-column specs -->
  <SystemSpecsDashboard />

  <!-- Custom Components Engineering Know-How — 2-column -->
  <CustomComponentsKnowHow />

  <!-- Dedicated CTA — BOM Program Evaluation -->
  <ComponentDedicatedCta />
<AudienceHub industry="cnc-machining" />
</BaseLayout>