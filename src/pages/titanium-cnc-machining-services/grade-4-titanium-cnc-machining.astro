---
/**
 * Grade 4 Titanium CNC Machining Services — CP-Ti (UNS R50700)
 *
 * BSI Phase M — fifth material-specific sub-page; strongest of the
 * unalloyed (CP-Ti) grades. Complements Phase K (Grade 2) with higher
 * oxygen-controlled strength while keeping CP-Ti corrosion behavior.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import TrustBadges from '../../components/landing/TrustBadges.astro';
import Applications from '../../components/landing/Applications.astro';
import { HERO_CONFIG } from '../../config/hero';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pageTitle = 'Grade 4 Titanium CNC Machining Services | CP-Ti (UNS R50700)';
const pageDescription =
  'Precision Grade 4 Commercially Pure Titanium (CP-Ti, UNS R50700) CNC machining services for chemical processing, marine, medical, and aerospace structural components. ASTM B348 / B265 / B338 controlled process, MTR-supported traceability.';
const canonicalUrl = 'https://cnc.bozemetal.com/titanium-cnc-machining-services/grade-4-titanium-cnc-machining/';

const heroKey = '/titanium-cnc-machining-services/grade-4-titanium-cnc-machining';

const faqItems = [
  {
    question: 'What is Grade 4 titanium and how does it differ from Grade 2?',
    answer:
      'Grade 4 is the strongest of the four unalloyed CP-Ti grades (UNS R50700). It carries a higher allowable oxygen content (≤0.40 wt%) than Grade 2 (≤0.25 wt%), which raises tensile strength to roughly 550 MPa UTS versus 345 MPa for Grade 2. Ductility and formability are correspondingly lower, and weldability is more sensitive to joint design. Corrosion resistance in chloride-bearing media is essentially identical to Grade 2.',
  },
  {
    question: 'Where is Grade 4 used instead of Grade 2?',
    answer:
      'Grade 4 is the preferred CP-Ti grade where higher strength is needed without moving to a Ti-6Al-4V-class alloy: aircraft structural panels, chemical-reactor internals, high-pressure heat-exchanger components, marine hardware subject to mechanical loading, and cryogenic-vessel parts. The trade-off vs Grade 2 is reduced formability and reduced weld ductility; the trade-off vs Grade 5 is lower strength but better weldability, lower cost, and superior corrosion in reducing-acid environments.',
  },
  {
    question: 'Is Grade 4 weldable?',
    answer:
      'Yes, but with more care than Grade 2. The higher oxygen content reduces weld-ductility; welded joints in Grade 4 are more sensitive to impurity pickup, joint fit-up, and shielding-gas coverage. We confirm the WPS / WPQ against ASME IX or AWS D1.6 as applicable, and use controlled-purity shielding gas and backing to preserve weld-metal ductility.',
  },
  {
    question: 'What surface finish preserves Grade 4 corrosion resistance?',
    answer:
      'A clean, oxide-intact, contamination-free surface is the basis for Grade 4 corrosion resistance, identical to Grade 2. Iron, carbon-steel, or abrasive embedment from prior work can seed pitting. We use dedicated CP-Ti tooling where the order requires it, and surface preparation (degrease, pickle, or passivation) is scheduled per ASTM B600.',
  },
  {
    question: 'What is the minimum order quantity for a Grade 4 prototype?',
    answer:
      'A 1-piece minimum order quantity is supported. Indicative prototype lead time is 5–7 working days, subject to drawing completeness, material availability, and inspection scope.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((it) => ({
    '@type': 'Question',
    name: it.question,
    acceptedAnswer: { '@type': 'Answer', text: it.answer },
  })),
};

const standards = [
  { code: 'ASTM B348', scope: 'Titanium and titanium alloy bars and billets (Grade 4 form)', application: 'Verify grade, condition, dimensions, and material certification for bar / billet stock.' },
  { code: 'ASTM B265', scope: 'Titanium and titanium alloy strip, sheet, and plate (Grade 4 form)', application: 'Verify grade, condition, dimensions, and material certification for plate / sheet stock.' },
  { code: 'ASTM B338', scope: 'Seamless and welded titanium and titanium alloy tubes (Grade 4 form)', application: 'Confirm specification applicability for tube applications.' },
  { code: 'ASTM F67', scope: 'Unalloyed titanium for surgical implant applications (Grade 4 form)', application: 'Reference for higher-strength CP-Ti medical components.' },
  { code: 'ASME SB-348', scope: 'Titanium and titanium alloy bars and billets (pressure-vessel code)', application: 'Confirm specification applicability when the program requires ASME BPVC Section II material.' },
  { code: 'ASTM B600', scope: 'Surface preparation of titanium and titanium alloy surfaces', application: 'Reference for the agreed pickling / passivation step.' },
];

const criticalControls = [
  {
    title: 'Strength-vs-Formability Trade-Off in Section Design',
    challenge: 'Grade 4 carries roughly 60% more tensile strength than Grade 2 but lower ductility (typically 15% elongation vs 25%). Machined sections optimized for GR2 — sharp internal corners, deep draws, aggressive flanges — can crack or chip during machining or service. Cold-forming operations that work for GR2 (bending, flaring, stamping) need larger bend radii and intermediate anneals for GR4.',
    approach: 'We confirm bend radii, draw depths, and minimum corner radii against the agreed specification and the material condition (annealed vs as-rolled) at the RFQ stage. Cutting parameters are tuned to keep the cutting-zone temperature below the alloy over-aging range. In-process inspection verifies that as-machined geometry is within drawing tolerance before the next operation, so geometry drift is caught early.',
    outcome: 'Components that meet drawing tolerance without edge chipping, cracking, or excessive springback at the agreed strength level. Final tolerance and property targets are confirmed after CAD, drawing, material condition, and inspection method review.',
  },
  {
    title: 'Weld-Prep Geometry and Joint-Preparation Sensitivity',
    challenge: 'Grade 4 weldments are more sensitive to contamination, joint fit-up, and shielding-gas coverage than Grade 2. The higher oxygen content reduces weld-metal ductility, and embrittlement from atmospheric pickup (oxygen, nitrogen, hydrogen) is a real risk. Machined weld preps that look acceptable to the eye can introduce fit-up gaps that the welder cannot compensate for.',
    approach: 'We machine weld preps to tighter geometric tolerance than for Grade 2 (root-face flatness, groove angle, land thickness) and verify dimensions at the agreed inspection locations. The surface-preparation step (degrease, pickling) is scheduled before welding to remove the oxygen-rich alpha-case layer from the heat-affected zone. The WPS / WPQ reference is reviewed at the RFQ stage.',
    outcome: 'Weld prep geometry that meets the agreed WPS tolerance band, with a contaminant-free joint surface ready for welding. Welding and WPS / WPQ qualification remain the customer or designated fabricator responsibility.',
  },
  {
    title: 'Gummy-Chip Control and Corrosion-Service Surface Prep',
    challenge: 'Like Grade 2, Grade 4 chips are long and stringy when cut with the wrong tool geometry, leading to wrap-around, re-cut, and surface scratching. Corrosion performance in chloride service depends on an intact passive film; iron, carbon-steel, or abrasive embedment from prior work can seed pitting.',
    approach: 'We use sharp, positive-rake carbide tooling with chip-breaker geometry suited to CP-Ti, lower cutting speeds than for Ti-6Al-4V, and high-pressure coolant directed at the cutting edge. Where the order scope requires it, we segregate CP-Ti work from carbon-steel / 316L / aluminum work, use dedicated tooling, workholding, and consumables. Surface preparation per ASTM B600 (alkaline cleaning + acid pickling) is scheduled per the agreed inspection plan.',
    outcome: 'Predictable chip evacuation, surface free of iron and abrasive embedment, with the passive oxide film intact at the point of shipment. Corrosion performance remains subject to the customer qualification of the finished component in its service environment.',
  },
];

const relatedLinks = [
  { name: '3/4/5-Axis Titanium Machining', desc: 'Axis configuration selection for Grade 4 components', href: '/titanium-cnc-machining-services/3-5-axis-cnc-machining/' },
  { name: 'Grade 2 CP-Ti Machining', desc: 'Lower-strength CP-Ti counterpart (better formability / weldability)', href: '/titanium-cnc-machining-services/grade-2-titanium-cnc-machining/' },
  { name: 'Grade 5 Ti-6Al-4V Machining', desc: 'Higher-strength alloyed counterpart', href: '/titanium-cnc-machining-services/grade-5-titanium-cnc-machining/' },
  { name: 'Grade 4 CP-Ti Material Data', desc: 'Composition, mechanical properties, and forms', href: '/materials/grade-4/' },
  { name: 'Submit Grade 4 RFQ', desc: 'Upload drawing for DFM engineering review', href: '/rfq/' },
];
---

<BaseLayout pageType="service-detail" title={pageTitle} description={pageDescription} canonicalURL={canonicalUrl} serviceName="Grade 4 Commercially Pure Titanium (CP-Ti) CNC Machining Services" serviceDescription="Precision CNC machining of Grade 4 commercially pure titanium (CP-Ti, UNS R50700) for chemical processing, marine, medical, and aerospace structural components. ASTM B348 / B265 / B338 controlled process with MTR-supported material traceability and ASTM B600 surface preparation." serviceCategory="CNC Machining — Commercially Pure Titanium" faqItems={faqItems}>
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList"><li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">{t('nav.home')}</span></a><meta itemprop="position" content="1" /><svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li><li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a href="/titanium-cnc-machining-services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"><span itemprop="name">Titanium CNC Machining Services</span></a><meta itemprop="position" content="2" /><svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></li><li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><span itemprop="name" class="font-semibold" style="color: var(--theme-text);">Grade 4 CP-Ti</span><meta itemprop="position" content="3" /></li></ol></div></nav>

  <SubpageHero h1={HERO_CONFIG[heroKey].h1} subtitle={HERO_CONFIG[heroKey].subtitle} badge={HERO_CONFIG[heroKey].badge} badgeIcon="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 001.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" keyMetrics={HERO_CONFIG[heroKey].keyMetrics} entityChips={HERO_CONFIG[heroKey].entityChips} />

  <TrustBadges />

  <section class="relative py-16" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Scope &amp; Limits</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">What This Page Covers — and What It Does Not</h2>
        <p class="mt-4 text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">We machine Grade 4 CP-Ti to customer-defined drawings, with material standards, condition, and acceptance criteria confirmed during RFQ review.</p>
      </header>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);"><p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">In Scope</p><h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Higher-Strength CP-Ti Machining</h3><p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">3-axis, 4-axis, 5-axis milling, turning, mill-turn of wrought Grade 4 bar, billet, plate, sheet, and tube for structural and pressure-containing components.</p></article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);"><p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">In Scope</p><h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Weld Prep + Joint Prep</h3><p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Tighter-tolerance weld preps per ASME IX / AWS D1.6 (root-face flatness, groove angle, land thickness) for welded assemblies.</p></article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);"><p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">In Scope</p><h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Corrosion-Critical Surface Prep</h3><p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">ASTM B600 cleaning / pickling, dedicated CP-Ti tooling, contamination-controlled workflow.</p></article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-text) 15%, transparent);"><p class="text-xs font-bold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">Out of Scope</p><h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">In-House Corrosion Testing</h3><p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">We do not perform ASTM G48 / B117 corrosion testing. Finished-component qualification remains the customer responsibility.</p></article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-text) 15%, transparent);"><p class="text-xs font-bold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">Out of Scope</p><h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Welding &amp; WPS Qualification</h3><p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">We machine weld preps. Welding and WPS / WPQ qualification remain the customer or designated fabricator responsibility.</p></article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-text) 15%, transparent);"><p class="text-xs font-bold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">Out of Scope</p><h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Universal Tolerance</h3><p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">±0.025 mm is a project-specific target. Final commitment confirmed after CAD, drawing, material condition, and inspection method review.</p></article>
      </div>
    </div>
  </section>

  <section class="relative py-20" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Engineering Compliance</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Material Compliance Starts with the Correct Specification</h2>
      </header>
      <div class="overflow-x-auto rounded-2xl border" style="border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
        <table class="w-full text-left">
          <thead><tr style="background: linear-gradient(135deg, var(--theme-primary) 12%, var(--theme-surface));"><th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Standard / Specification</th><th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Material or Quality Scope</th><th class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="color: var(--theme-text);">Application in Procurement</th></tr></thead>
          <tbody>
            {standards.map((s) => (<tr style="background: var(--theme-surface); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"><td class="px-5 py-4 align-top"><span class="font-bold text-sm" style="color: var(--theme-primary);">{s.code}</span></td><td class="px-5 py-4 align-top"><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);">{s.scope}</p></td><td class="px-5 py-4 align-top"><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{s.application}</p></td></tr>))}
          </tbody>
        </table>
      </div>
      <div class="mt-8 rounded-xl p-6 md:p-7 flex flex-col md:flex-row md:items-center gap-4" style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 6%, var(--theme-surface))); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);">
        <svg class="w-7 h-7 md:mr-1 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
        <div class="flex-1"><p class="text-base font-bold mb-1" style="color: var(--theme-text);">Material Documentation: MTR supplied with each shipment covered by the agreed traceability requirements.</p><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">Material certificates, oxygen limits verification, heat / lot identification, and purchase specification requirements are reviewed against the order documentation.</p></div>
        <a href="/rfq/" class="inline-flex items-center justify-center whitespace-nowrap px-6 py-3 rounded-lg font-bold text-sm transition-all duration-200 hover:-translate-y-0.5 shrink-0" style="background: linear-gradient(135deg, #ff8a3d 0%, #ff5a00 100%); color: #ffffff;">Submit Drawing &amp; Material Specification<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg></a>
      </div>
    </div>
  </section>

  <section class="relative py-20" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Technical Capabilities</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Three Critical Controls for Grade 4 CP-Ti Machining</h2>
      </header>
      <div class="space-y-6">
        {criticalControls.map((c, i) => (
          <article class="rounded-2xl border p-6 md:p-8" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
            <div class="flex items-start gap-4 mb-5">
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl text-sm font-black shrink-0" style="background: linear-gradient(135deg, var(--theme-primary), color-mix(in srgb, var(--theme-primary) 70%, #000)); color: #0F172A;">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="text-xl md:text-2xl font-bold leading-snug" style="color: var(--theme-text);">{c.title}</h3>
            </div>
            <div class="grid gap-5 md:grid-cols-3">
              <div><p class="text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">Engineering Challenge</p><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{c.challenge}</p></div>
              <div><p class="text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">Our Machining Approach</p><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{c.approach}</p></div>
              <div><p class="text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">Engineering Outcome</p><p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{c.outcome}</p></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Applications />

  <section class="relative" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="max-w-4xl mx-auto rounded-3xl border p-8 md:p-10 text-center" style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 4%, var(--theme-surface))); border-color: color-mix(in srgb, var(--theme-primary) 22%, transparent);">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Submit Your Engineering Package</p>
        <h2 class="text-2xl md:text-3xl font-bold leading-tight mb-3" style="color: var(--theme-text);">Have a Grade 4 CP-Ti Component Ready for Manufacturing?</h2>
        <p class="text-base leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">Send your drawing to initiate a technical review. Accepted file formats: STEP, STP, DXF. <strong>Target response: initial RFQ acknowledgment within 24 hours on working days.</strong> Mutual NDA available before technical file exchange.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/rfq/" class="inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 text-sm font-bold text-white shadow-lg" style="background: linear-gradient(135deg, #ff8a3d 0%, #ff5a00 100%);">Upload CAD/STEP for DFM Review<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg></a>
          <a href="/rfq/" class="inline-flex items-center justify-center gap-2 rounded-xl border px-6 py-3 text-sm font-bold" style="border-color: var(--theme-primary); color: var(--theme-primary);">Request a Grade 4 Quote</a>
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <header class="max-w-3xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Related Capabilities</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Continue the Engineering Review</h2>
      </header>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {relatedLinks.map((r) => (
          <a href={r.href} class="rounded-2xl border p-6 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
            <h3 class="text-lg font-bold" style="color: var(--theme-primary);">{r.name}</h3>
            <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{r.desc}</p>
            <p class="mt-4 text-xs font-semibold" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{r.href} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="text-center mb-12 max-w-3xl mx-auto">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Frequently Asked Questions</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Grade 4 CP-Ti CNC Machining — Engineering FAQ</h2>
      </header>
      <div class="max-w-4xl mx-auto space-y-4">
        {faqItems.map((it, idx) => (
          <details class="group rounded-xl overflow-hidden border" style="background-color: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 22%, transparent);" open={idx === 0}>
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-bold text-base md:text-lg list-none" style="color: var(--theme-text);">
              <span class="flex items-start">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg mr-4 shrink-0 text-xs font-bold" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">Q{idx + 1}</span>
                <span class="leading-snug">{it.question}</span>
              </span>
              <svg class="w-5 h-5 shrink-0 transition-transform group-open:rotate-180" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-6 pt-2 text-sm md:text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{it.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>