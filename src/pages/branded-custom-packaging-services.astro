---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import PackagingProcessSpectrum from '../components/services/PackagingProcessSpectrum.astro';
import PackagingSpecsDashboard from '../components/services/PackagingSpecsDashboard.astro';
import SmearingWarehouseInterlockKnowHow from '../components/services/SmearingWarehouseInterlockKnowHow.astro';
import PackagingDedicatedCta from '../components/services/PackagingDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { HERO_CONFIG } from '../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.brandedCustomPackaging')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title={t('branded-custom-packaging-services.astro.brandedCustomPackagingServices.branded_custom_packaging')}
    highlight="Services"
    badge={t('branded-custom-packaging-services.hero.badge')}
    badgeIcon="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
    subtitle={t('branded-custom-packaging-services.hero.subtitle')}
  
    keyMetrics={HERO_CONFIG['/branded-custom-packaging-services'].keyMetrics}
    entityChips={HERO_CONFIG['/branded-custom-packaging-services'].entityChips}
  />

  <!-- Packaging Process Spectrum — 3-card grid -->
  <PackagingProcessSpectrum />

  <!-- Technical Specifications Dashboard — 4-column metrics -->
  <PackagingSpecsDashboard />

  <!-- Smearing & Warehouse Interlock Know-How — 2-column challenge/solution -->
  <SmearingWarehouseInterlockKnowHow />

  <!-- Dedicated CTA — 24-Hour Packaging Quote -->
  <PackagingDedicatedCta />
</BaseLayout>