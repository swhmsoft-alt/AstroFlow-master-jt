---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import PassivationSpectrum from '../../components/services/PassivationSpectrum.astro';
import PassivationSpecsDashboard from '../../components/services/PassivationSpecsDashboard.astro';
import HydrogenEmbrittlementAcidControlKnowHow from '../../components/services/HydrogenEmbrittlementAcidControlKnowHow.astro';
import PassivationDedicatedCta from '../../components/services/PassivationDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout title={t('titanium-surface-treatment.chemicalPassivation.titanium_chemical_passivation_boze_cnc')} description="Precision titanium chemical passivation services: nitric acid passivation, citric acid biocompatible lines, HF-HNO3 acid pickling. ASTM F86, ASTM A967, AMS 2700 certified.">
  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title={t('titanium-surface-treatment.chemicalPassivation.chemical_passivation')}
    highlight="Services"
    badge="Surface De-Contamination"
    badgeIcon="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
    subtitle="Certified titanium chemical de-contamination and passivation workflows — nitric acid passivation for iron removal, biocompatible citric acid lines per ASTM F86, and deep HF-HNO3 acid pickling for heavy oxide stripping."
  
    keyMetrics={HERO_CONFIG['/titanium-surface-treatment/chemical-passivation']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-surface-treatment/chemical-passivation']?.entityChips}
  />

  <!-- Passivation Spectrum — 3-card grid -->
  <PassivationSpectrum />

  <!-- Technical Specifications Dashboard — 4-column metrics -->
  <PassivationSpecsDashboard />

  <!-- Hydrogen Embrittlement & Acid Control Know-How — 2-column challenge/solution -->
  <HydrogenEmbrittlementAcidControlKnowHow />

  <!-- Dedicated CTA — 24-Hour Commercial Quote -->
  <PassivationDedicatedCta />
</BaseLayout>