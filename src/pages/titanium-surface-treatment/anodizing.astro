---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import AnodizingClassifications from '../../components/services/AnodizingClassifications.astro';
import AnodizingSpecsDashboard from '../../components/services/AnodizingSpecsDashboard.astro';
import GallingColorVariationKnowHow from '../../components/services/GallingColorVariationKnowHow.astro';
import AnodizingDedicatedCta from '../../components/services/AnodizingDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout title={t('titanium-surface-treatment.anodizing.titanium_anodizing_boze_cnc_ti')} description="Precision titanium anodizing services: AMS 2488 Type II anti-galling anodizing, Type III pigment-free color coding, and high-purity acid pre-treatment. ISO 13485, AMS 2488D certified.">
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-surface-treatment/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services.surfaceTreatment')}</span>
          </a>
          <meta itemprop="position" content="3" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.anodizing')}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title={t('titanium-surface-treatment.anodizing.titanium_anodizing')}
    highlight="Services"
    badge="Electrochemical Processing"
    badgeIcon="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
    subtitle="Certified titanium electrochemical anodizing workflows — AMS 2488 Type II anti-galling conversions, Type III pigment-free color-coding for medical traceability, and high-purity acid pre-treatment for composite co-bonding."
  
    keyMetrics={HERO_CONFIG['/titanium-surface-treatment/anodizing']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-surface-treatment/anodizing']?.entityChips}
  />

  <!-- Anodizing Classifications — 3-card grid -->
  <AnodizingClassifications />

  <!-- Technical Specifications Dashboard — 4-column metrics -->
  <AnodizingSpecsDashboard />

  <!-- Galling & Color Variation Know-How — 2-column challenge/solution -->
  <GallingColorVariationKnowHow />

  <!-- Dedicated CTA — 24-Hour Commercial Quote -->
  <AnodizingDedicatedCta />
</BaseLayout>