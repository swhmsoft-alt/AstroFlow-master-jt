---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudienceHub from '../../components/audience/AudienceHub.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import ExtrusionProcessSpectrum from '../../components/services/ExtrusionProcessSpectrum.astro';
import ExtrusionSpecsDashboard from '../../components/services/ExtrusionSpecsDashboard.astro';
import DieGallingLubricationKnowHow from '../../components/services/DieGallingLubricationKnowHow.astro';
import ExtrusionDedicatedCta from '../../components/services/ExtrusionDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout title={t('titanium-forming-heavy-manufacturing.titaniumExtrusion.titanium_extrusion_boze_cnc_ti')} description="Precision titanium extrusion: complex structural profiles, seamless heavy-wall tubes, multi-channel hollow shapes. 6,000 ton press, 12 m length, ø 350 mm envelope, AS9100D.">
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-forming-heavy-manufacturing/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services.formingHeavy')}</span>
          </a>
          <meta itemprop="position" content="3" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.titaniumExtrusion')}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>
  <SubpageHero
    title={t('titanium-forming-heavy-manufacturing.titaniumExtrusion.titanium_extrusion')}
    highlight="Services"
    badge="Precision Metal Extrusion"
    badgeIcon="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6z"
    subtitle="Hot extrusion of complex titanium profiles, seamless heavy-wall tubes, and precision multi-channel hollow shapes — using glass-lubricated dies, isothermal tooling, and stretch straightening for aerospace-grade straightness."
  
    keyMetrics={HERO_CONFIG['/titanium-forming-heavy-manufacturing/titanium-extrusion']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-forming-heavy-manufacturing/titanium-extrusion']?.entityChips}
  />

  <!-- Extrusion Process Spectrum — 3-column grid -->
  <ExtrusionProcessSpectrum />

  <!-- Extrusion Capacity Dashboard — 4-column specs -->
  <ExtrusionSpecsDashboard />

  <!-- Die Lubrication & Thermal Control Know-How — 2-column -->
  <DieGallingLubricationKnowHow />

  <!-- Dedicated CTA — Extrusion Feasibility Review -->
  <ExtrusionDedicatedCta />
<AudienceHub industry="forming" />
</BaseLayout>