---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudienceHub from '../../components/audience/AudienceHub.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import PrepProcessSpectrum from '../../components/services/PrepProcessSpectrum.astro';
import PrepSpecsDashboard from '../../components/services/PrepSpecsDashboard.astro';
import SizingHardeningTraceabilityKnowHow from '../../components/services/SizingHardeningTraceabilityKnowHow.astro';
import PrepDedicatedCta from '../../components/services/PrepDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout title={t('titanium-forming-heavy-manufacturing.rawMaterialPreparationSizing.raw_material_preparation_sizing_boze')} description="Titanium raw material preparation: heavy-duty CNC band sawing up to ø 800 mm, mechanical surface peeling, chemical decontamination. PMI validated, AS9100D.">
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-forming-heavy-manufacturing/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services.formingHeavy')}</span>
          </a>
          <meta itemprop="position" content="3" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.rawMaterialPreparation')}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>
  <SubpageHero
    title={t('titanium-forming-heavy-manufacturing.rawMaterialPreparationSizing.raw_material_preparation_sizing')}
    highlight="Services"
    badge="Material Preparation"
    badgeIcon="M13 10V3L4 14h7v7l9-11h-7z"
    subtitle="Heavy-duty CNC band sawing, mechanical surface peeling, and deep chemical decontamination for titanium ingots, billets, and blocks — preparing raw stock for downstream forging, extrusion, and forming operations."
  
    keyMetrics={HERO_CONFIG['/titanium-forming-heavy-manufacturing/raw-material-preparation-sizing']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-forming-heavy-manufacturing/raw-material-preparation-sizing']?.entityChips}
  />

  <!-- Material Preparation Process Spectrum — 3-column grid -->
  <PrepProcessSpectrum />

  <!-- Material Prep Capacity Dashboard — 4-column specs -->
  <PrepSpecsDashboard />

  <!-- Hardening Suppression & Traceability Control — 2-column -->
  <SizingHardeningTraceabilityKnowHow />

  <!-- Dedicated CTA — Processing & Compliance Assessment -->
  <PrepDedicatedCta />
<AudienceHub industry="forming" />
</BaseLayout>