---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import ForgingProcessSpectrum from '../../components/services/ForgingProcessSpectrum.astro';
import ForgingSpecsDashboard from '../../components/services/ForgingSpecsDashboard.astro';
import MetallurgyGrainFlowKnowHow from '../../components/services/MetallurgyGrainFlowKnowHow.astro';
import ForgingDedicatedCta from '../../components/services/ForgingDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout title={t('titanium-forming-heavy-manufacturing.titaniumForging.titanium_forging_boze_cnc_ti')} description="Precision titanium forging: closed-die, open-die, and seamless rolled ring forging. 8,000 metric ton press, ø 2,500 mm rings, AMS 2631 Class AA, ≥95% equiaxed α+β.">
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-forming-heavy-manufacturing/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services.formingHeavy')}</span>
          </a>
          <meta itemprop="position" content="3" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.titaniumForging')}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>
  <SubpageHero
    title={t('titanium-forming-heavy-manufacturing.titaniumForging.titanium_forging')}
    highlight="Services"
    badge="Precision Metal Forging"
    badgeIcon="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0z"
    subtitle="Closed-die precision forging, open-die ingot breakdown, and seamless rolled ring forging — delivering aerospace-grade grain flow, AMS 2631 Class AA ultrasonic quality, and ≥95% equiaxed alpha+beta microstructure."
  
    keyMetrics={HERO_CONFIG['/titanium-forming-heavy-manufacturing/titanium-forging']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-forming-heavy-manufacturing/titanium-forging']?.entityChips}
  />

  <!-- Forging Process Spectrum — 3-column grid -->
  <ForgingProcessSpectrum />

  <!-- Forging Capacity Dashboard — 4-column specs -->
  <ForgingSpecsDashboard />

  <!-- Grain Flow & Metallurgy Control — 2-column -->
  <MetallurgyGrainFlowKnowHow />

  <!-- Dedicated CTA — Forging Assessment -->
  <ForgingDedicatedCta />
</BaseLayout>