---
/** /parts/titanium-cnc-parts/ — Titanium CNC Parts (B2B procurement page). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PartsDetail from '../../components/parts/PartsDetail.astro';
import { PART_PAGES } from '../../data/parts';

const data = PART_PAGES.find((p) => p.slug === 'titanium-cnc-parts')!;
const SITE = 'https://cnc.bozemetal.com';
const canonicalUrl = `${SITE}/parts/${data.slug}/`;

// ── Identity @id references (defined in src/lib/schema.ts) ──
// Re-used here so the supplementary JSON-LD never redeclares Organization fields.
// BaseLayout already emits the canonical Organization / Brand / ManufacturingCenter.
import { MANUFACTURING_CENTER_ID } from '../../lib/schema';

// Reference the canonical Manufacturing Center for the Service provider (no inline
// Organization redeclaration). The Service's provider entity must carry an @id only.
const supplementarySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: data.heroH1,
      serviceType: 'Custom Titanium CNC Machining',
      description: data.metaDescription,
      provider: { '@id': MANUFACTURING_CENTER_ID },
      areaServed: 'Global',
      url: canonicalUrl,
    },
    {
      '@type': 'TechArticle',
      '@id': `${canonicalUrl}#article`,
      headline: data.pageTitle,
      description: data.metaDescription,
      about: { '@type': 'Service', name: 'Custom Titanium CNC Machining' },
      proficiencyLevel: 'Expert',
      inLanguage: 'en',
      author: { '@id': MANUFACTURING_CENTER_ID },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: data.faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---
<BaseLayout
  title={data.pageTitle}
  description={data.metaDescription}
  pageType="part-detail"
  serviceName={data.heroH1}
  productName={data.heroH1}
  productCategory={data.navName}
  serviceCategory={data.navName}
  canonicalURL={canonicalUrl}
  alternateLinks={[{ lang: 'en', href: `/parts/${data.slug}/` }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(supplementarySchema)} />
  <PartsDetail data={data} />
</BaseLayout>
