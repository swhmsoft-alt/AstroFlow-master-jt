  canonicalURL="/standard-parts/"
>
  <section class="container mx-auto px-4 py-16 md:py-24">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">{pageTitle}</h1>
    <p class="text-lg text-theme-text/80 mb-6">{pageDescription}</p>
    <p class="text-sm text-theme-text/60 italic">
      Page content is under development. The Solutions dropdown is wired and the
      canonical URL <code>/standard-parts/</code> is reserved for this hub.
    </p>
  </section>
</BaseLayout>