---
/**
 * /standard-parts/ - Titanium Standard Parts & Components Procurement Hub
 * Buyer Search Intelligence Phase H-A (2026-10-07)
 * 100 percent ASCII content. Use ${L} / ${G} via PS interpolation to write tags.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import SubpageHero from "@components/ui/SubpageHero.astro";
import { HERO_CONFIG } from "@config/hero";

const SITE = "https://cnc.bozemetal.com";
const pageTitle = "Titanium Standard Parts & Components | ASTM, ASME, DIN | BOZE";
const pageDescription = "Standard-compliant titanium fasteners, flanges, pipe fittings and machined components supplied to ASTM, ASME, DIN and other applicable specifications -- with certified materials, dimensional control and full heat-to-part material traceability. Sourced from Baoji, China titanium manufacturing hub with AS9100D and ISO 13485 quality systems.";
const canonicalUrl = `${SITE}/standard-parts/`;
const hero = HERO_CONFIG["/standard-parts"];

const faqItems = [
  { question: "What titanium standard parts does BOZE supply?", answer: "BOZE supplies catalog-spec titanium fasteners, flanges, pipe fittings and CNC-machined standard components. Typical families include slip-on / weld-neck / blind flanges per ASME B16.5, butt-weld and forged fittings per ASME B16.9 / B16.11, bolts / nuts / washers per ASTM F467 / DIN / ISO, and standard machined components such as spacers, sleeves, rings, bushings, pins and collars." },
  { question: "Which titanium grades are available for standard parts?", answer: "Commercially pure Grades 1 and 2, Grade 5 (Ti-6Al-4V), Grade 7 (Ti-0.15Pd), Grade 9 (Ti-3Al-2.5V), Grade 12 (Ti-0.3Mo-0.8Ni) and Grade 23 (Ti-6Al-4V ELI) are commonly specified for standard parts. Specific grade availability depends on product form and applicable standard -- see the Grade x Standard matrix on this page and confirm with our team at RFQ stage." },
  { question: "Which ASTM and ASME standards do your titanium parts follow?", answer: "Commonly supplied to ASTM B348 (bars / billets), B381 (forgings -- flanges), B363 (wrought fittings), B338 (tubes), B265 (plate / sheet), B861 (seamless pipe), B862 (welded pipe), F467 (fasteners), F67 (medical CP-Ti), F136 (medical Ti-6Al-4V ELI) and to ASME B16.5 / B16.9 / B16.11 / B16.28 dimensional specifications. Project-specific or proprietary standards can be reviewed at RFQ." },
  { question: "Can you provide MTR or MTC documentation?", answer: "Yes. EN 10204 Type 3.1 mill test certificates are available as standard documentation. 3.2 certificates (independent third-party validation) are accommodated on request. CoC, dimensional inspection report, FAIR and hydrostatic test report are available on a project-dependent basis (see the Documentation Package section on this page)." },
  { question: "Can titanium standard parts be CNC machined to modified dimensions?", answer: "Yes. BOZE is not limited to catalog supply -- when a standard component requires modified dimensions, special tolerances, non-standard threads, additional machining features or drawing-specific geometry, our CNC manufacturing capability provides a direct path from standard specification to engineered component. Submit your modification request alongside the standard reference and our engineering team can review dimensional changes and inspection requirements before quotation." },
  { question: "Can you supply titanium pipe fittings and flanges to ASME requirements?", answer: "Yes. Butt-weld fittings per ASME B16.9 (and B16.28 for short-radius returns), forged fittings per ASME B16.11, and flanges per ASME B16.5 / B16.47 dimensional requirements. Material backing is typically ASTM B363 (wrought) or ASTM B381 (forged) per project specification. Standard catalog fittings per ASME B16.9 / B16.11 are detailed in our Standard Pipe Fittings sub-hub." },
  { question: "Can BOZE provide material and heat-number traceability?", answer: "Yes. Heat-to-part material traceability is available as a standard documentation output: the mill heat number is recorded at incoming inspection and persists through processing, dimensional inspection and shipment. A heat / lot traceability statement is provided with the shipment. Project-specific documentation packages including weld traceability for fabricated assemblies are accommodated on request." },
  { question: "Can you manufacture a standard part from our drawing?", answer: "Yes. When your requirement deviates from a catalog specification -- different dimensions, tighter tolerances, special threads, additional features or project-specific geometry -- submit your drawing with the applicable standard reference. Our engineering team reviews dimensional changes, material requirements and inspection requirements, then returns a quotation aligned to your drawing. Standard-supply RFQs and modified-standard RFQs follow the same intake path." }
];

const mentionEntityIds = [
  "standard:astm-b348", "standard:astm-b381", "standard:astm-b363", "standard:astm-b338", "standard:astm-b265",
  "standard:astm-b861", "standard:astm-b862", "standard:astm-f467", "standard:astm-f67", "standard:astm-f136", "standard:iso-5832-3",
  "material:grade-2", "material:grade-5", "material:grade-7", "material:grade-9", "material:grade-12", "material:grade-23"
];
---

<BaseLayout  title={pageTitle}
  description={pageDescription}
  pageType="standard-parts-hub"
  canonicalURL={canonicalUrl}
  collectionName="Titanium Standard Parts and Components"
  collectionDescription={pageDescription}
  serviceName="Titanium Standard Parts Procurement"
  serviceDescription={pageDescription}
  serviceCategory="Titanium Standard Parts"
  itemCount={4}
  items={[{name:"Titanium Flanges",url:"/standard-parts/flanges/"},{name:"Titanium Pipe Fittings",url:"/standard-parts/pipe-fittings/"},{name:"Titanium Fasteners",url:"/standard-parts/fasteners/"},{name:"CNC Machined Standard Components",url:"/standard-parts/machined-components/"}]}
  faqItems={faqItems}
  mentions={mentionEntityIds}
  alternateLinks={[{ lang: "en", href: "/standard-parts/" }]}
>

  <SubpageHero
    h1={hero.h1}
    badge={hero.badge}
    subtitle={hero.subtitle}
    keyMetrics={hero.keyMetrics}
    entityChips={hero.entityChips}>
  </SubpageHero>

  <!-- AIO Thesis 1: What are titanium standard parts? -->
  <section id="aio-thesis-1" class="py-10 lg:py-12 border-t" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Direct Answer</p>
      <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--theme-text);">What are titanium standard parts?</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
        Titanium standard parts are catalog-specification components -- fasteners, flanges, pipe fittings and standard machined geometries -- supplied to a recognized product or material standard (ASTM B348 / B381 / B363 / F467, ASME B16.5 / B16.9 / B16.11, DIN 912 / 933 / 934, ISO 4017 / 4032, AMS 4928 / 4965, or project-specific specifications) rather than to a customer drawing. They are intended for procurement by buyers who already know the catalog reference, material grade and dimensional class they need, and want a qualified supplier that can deliver against that reference with documented material traceability.
      </p>
    </div>
  </section>

  <!-- AIO Thesis 2: Which standards? -->
  <section id="aio-thesis-2" class="py-10 lg:py-12" style="background: var(--theme-surface); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Direct Answer</p>
      <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--theme-text);">Which standards does BOZE supply titanium standard parts to?</h2>
      <p class="text-base sm:text-lg leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
        BOZE supplies titanium standard parts to the following standards families, subject to the product family and grade you specify:
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-5 rounded-xl border" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
          <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">ASTM / ASME</p>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">B348 (bars), B381 (forgings -- flanges), B363 (wrought fittings), B338 (tubes), B265 (plate / sheet), B861 (seamless pipe), B862 (welded pipe), F467 (fasteners), F67 / F136 (medical CP / Ti-6Al-4V ELI), ASME B16.5 / B16.9 / B16.11 / B16.28 (dimensional).</p>
        </div>
        <div class="p-5 rounded-xl border" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
          <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">DIN / ISO</p>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Fasteners: DIN 912 / 933 / 931 / 934, ISO 4017 / 4032 / 4762. Project-specific DIN / ISO / GB/T references can be reviewed at RFQ.</p>
        </div>
        <div class="p-5 rounded-xl border" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
          <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">AMS / Project</p>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">AMS-controlled aerospace material specifications (where applicable to the product family). Project-specific or proprietary specifications are reviewed at RFQ.</p>
        </div>
        <div class="p-5 rounded-xl border" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
          <p class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">Quality Systems</p>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">AS9100D (aerospace), ISO 13485:2016 (medical), ISO 9001:2015 (general). Material certification to EN 10204 Type 3.1 standard; 3.2 on request.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Product Categories grid -->
  <section id="product-categories" class="py-16 lg:py-20" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-10 lg:mb-14">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Browse by Product Family</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Titanium Standard Parts by Product Family</h2>
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          Four product families cover the majority of catalog-spec titanium procurement. Each family has its own sub-hub with detailed specifications, common grades, applicable standards and documentation scope.
        </p>
      </header>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/standard-parts/flanges/" class="group flex flex-col rounded-2xl border p-6 transition-all hover:-translate-y-0.5 hover:shadow-lg" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
          <article id="flanges" class="flex flex-col h-full">
            <div class="flex items-start gap-3 mb-4">
              <span class="text-3xl" aria-hidden="true">⊕</span>
              <h3 class="text-lg font-bold leading-snug" style="color: var(--theme-text);">Titanium Flanges</h3>
            </div>
            <p class="text-sm leading-relaxed mb-5" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">Slip-on, weld-neck, blind, threaded, lap-joint and custom flanges per ASTM B381, ASME B16.5 / B16.47.</p>
            <div class="space-y-3">
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Forms</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Slip-on · Weld-neck · Blind · Threaded · Lap-joint</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Common Grades</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Grade 1 · Grade 2 · Grade 5 · Grade 7 · Grade 12</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Typical Standards</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">ASTM B381 · ASME B16.5 · ASME B16.47</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Typical Applications</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Chemical · Marine · Oil and Gas piping</p></div>
            </div>
          </article>
        </a>
        <a href="/standard-parts/pipe-fittings/" class="group flex flex-col rounded-2xl border p-6 transition-all hover:-translate-y-0.5 hover:shadow-lg" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
          <article id="pipe-fittings" class="flex flex-col h-full">
            <div class="flex items-start gap-3 mb-4">
              <span class="text-3xl" aria-hidden="true">⊝</span>
              <h3 class="text-lg font-bold leading-snug" style="color: var(--theme-text);">Titanium Pipe Fittings</h3>
            </div>
            <p class="text-sm leading-relaxed mb-5" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">Butt-weld and forged fittings -- elbows, tees, reducers, caps per ASTM B363, B381 and ASME B16.9, B16.11, B16.28.</p>
            <div class="space-y-3">
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Forms</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Butt-weld Elbows · Tees · Reducers · Caps · Forged Couplings</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Common Grades</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Grade 1 · Grade 2 · Grade 5 · Grade 7 · Grade 9 · Grade 12</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Typical Standards</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">ASTM B363 · B381 · ASME B16.9 · B16.11 · B16.28</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Typical Applications</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Chemical · Marine · Oil and Gas · Heat Exchangers</p></div>
            </div>
          </article>
        </a>
        <a href="/standard-parts/fasteners/" class="group flex flex-col rounded-2xl border p-6 transition-all hover:-translate-y-0.5 hover:shadow-lg" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
          <article id="fasteners" class="flex flex-col h-full">
            <div class="flex items-start gap-3 mb-4">
              <span class="text-3xl" aria-hidden="true">⬢</span>
              <h3 class="text-lg font-bold leading-snug" style="color: var(--theme-text);">Titanium Fasteners</h3>
            </div>
            <p class="text-sm leading-relaxed mb-5" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">Bolts, screws, nuts, washers, studs and threaded rods to ASTM F467, ASME B18.2.1 / B18.2.2 and DIN / ISO equivalents.</p>
            <div class="space-y-3">
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Forms</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Hex Bolts · Socket-head Screws · Nuts · Washers · Studs · Threaded Rods</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Common Grades</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Grade 2 · Grade 5 · Grade 7 · Grade 23 (medical)</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Typical Standards</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">ASTM F467 · ASME B18.2.1 · DIN 912 / 933 / 934 · ISO 4017 / 4032</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Typical Applications</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Aerospace · Marine · Chemical assemblies · Industrial mechanical assemblies</p></div>
            </div>
          </article>
        </a>
        <a href="/standard-parts/machined-components/" class="group flex flex-col rounded-2xl border p-6 transition-all hover:-translate-y-0.5 hover:shadow-lg" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
          <article id="machined-components" class="flex flex-col h-full">
            <div class="flex items-start gap-3 mb-4">
              <span class="text-3xl" aria-hidden="true">◉</span>
              <h3 class="text-lg font-bold leading-snug" style="color: var(--theme-text);">CNC Machined Standard Components</h3>
            </div>
            <p class="text-sm leading-relaxed mb-5" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">Standard geometry but precision-machined to drawing dimensions and tolerances from stock bar / billet.</p>
            <div class="space-y-3">
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Forms</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Spacers · Sleeves · Rings · Bushings · Pins · Collars</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Common Grades</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Grade 2 · Grade 5 · Grade 9 · Grade 23</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Typical Standards</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Drawing-defined under AS9100D QMS</p></div>
              <div><p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary); letter-spacing: 0.12em;">Typical Applications</p><p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Industrial mechanical assemblies · Equipment components</p></div>
            </div>
          </article>
        </a>
      </div>
      <p class="mt-8 text-xs leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
        For drawing-based custom fabrication and full spools, see <a href="/parts/titanium-pipe-components/" style="color: var(--theme-primary);">custom pipe components</a> and <a href="/parts/" style="color: var(--theme-primary);">custom titanium parts</a>. For raw material, see <a href="/mill-products/" style="color: var(--theme-primary);">Mill Products</a>.
      </p>
    </div>
  </section>

  <!-- 05 Grade Matrix -->
  <section id="grade-matrix" class="py-16 lg:py-20" style="background: var(--theme-surface); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Material x Standard</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Titanium Grades and Applicable Standards</h2>
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          The matrix below maps common titanium grades to typical UNS designations, product forms and applicable ASTM / ASME material standards. Specific availability is confirmed at RFQ stage.
        </p>
      </header>
      <div class="overflow-x-auto rounded-2xl border" style="border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent); background: var(--theme-bg);">
        <table class="min-w-full text-sm" style="color: var(--theme-text);">
          <thead>
            <tr style="background: color-mix(in srgb, var(--theme-primary) 8%, var(--theme-bg)); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);">
              <th class="text-left px-4 py-3 font-bold uppercase tracking-wider text-xs" style="color: var(--theme-primary);">Titanium Grade</th>
              <th class="text-left px-4 py-3 font-bold uppercase tracking-wider text-xs" style="color: var(--theme-primary);">UNS</th>
              <th class="text-left px-4 py-3 font-bold uppercase tracking-wider text-xs" style="color: var(--theme-primary);">Product Forms</th>
              <th class="text-left px-4 py-3 font-bold uppercase tracking-wider text-xs" style="color: var(--theme-primary);">Common Standards</th>
              <th class="text-left px-4 py-3 font-bold uppercase tracking-wider text-xs" style="color: var(--theme-primary);">Typical Applications</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t">
              <td class="px-4 py-3 font-semibold align-top">Grade 1 (CP-Ti)</td>
              <td class="px-4 py-3 align-top font-mono text-xs">R50250</td>
              <td class="px-4 py-3 align-top">Plate, Sheet, Tube</td>
              <td class="px-4 py-3 align-top">ASTM B265, B338, B348</td>
              <td class="px-4 py-3 align-top">Chemical, marine, general industrial</td>
            </tr>
            <tr class="border-t">
              <td class="px-4 py-3 font-semibold align-top">Grade 2 (CP-Ti)</td>
              <td class="px-4 py-3 align-top font-mono text-xs">R50400</td>
              <td class="px-4 py-3 align-top">Plate, Sheet, Tube, Bar, Pipe</td>
              <td class="px-4 py-3 align-top">ASTM B265, B338, B348, B861, B862</td>
              <td class="px-4 py-3 align-top">Seawater, chemical, marine piping</td>
            </tr>
            <tr class="border-t">
              <td class="px-4 py-3 font-semibold align-top">Grade 5 (Ti-6Al-4V)</td>
              <td class="px-4 py-3 align-top font-mono text-xs">R56400</td>
              <td class="px-4 py-3 align-top">Bar, Forging, Machined Parts</td>
              <td class="px-4 py-3 align-top">ASTM B348, B381, AMS 4928, AMS 4965</td>
              <td class="px-4 py-3 align-top">Aerospace, industrial, structural fasteners</td>
            </tr>
            <tr class="border-t">
              <td class="px-4 py-3 font-semibold align-top">Grade 7 (Ti-0.15Pd)</td>
              <td class="px-4 py-3 align-top font-mono text-xs">R52400</td>
              <td class="px-4 py-3 align-top">Plate, Tube, Fittings</td>
              <td class="px-4 py-3 align-top">ASTM B265, B338, B363, B381</td>
              <td class="px-4 py-3 align-top">Chemical processing, reducing-acid service</td>
            </tr>
            <tr class="border-t">
              <td class="px-4 py-3 font-semibold align-top">Grade 9 (Ti-3Al-2.5V)</td>
              <td class="px-4 py-3 align-top font-mono text-xs">R56320</td>
