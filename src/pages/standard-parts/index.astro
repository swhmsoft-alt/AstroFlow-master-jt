---
/**
 * /standard-parts/ — Titanium Standard Parts (placeholder)
 *
 * 2026-10-06 — Empty page shell created during Solutions dropdown rollout.
 * Content (Answer Module 6 elements: Direct Answer, Honest Positioning,
 * Structured Body, Claim↔Evidence, Entities, Related anchors) will be built
 * in a follow-up round once the user provides the research brief.
 *
 * Trailing-slash URL: `/standard-parts/` (Astro `trailingSlash: 'always'`).
 */
import BaseLayout from '@layouts/BaseLayout.astro';

const pageTitle = 'Titanium Standard Parts';
const pageDescription =
  'Boze Titanium standard parts catalog — flanges, pipe fittings, fasteners and pipe components manufactured to ASTM, ASME and DIN standards. Page content under development.';
---

<BaseLayout
  title={pageTitle}
