  <section id="faq" class="py-16 lg:py-20" style="background: var(--theme-surface); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);">
