---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import ImageTextSplit from '../../components/ui/ImageTextSplit.astro';
import TrustBadges from '../../components/landing/TrustBadges.astro';
import QualityControl from '../../components/landing/QualityControl.astro';
import Applications from '../../components/landing/Applications.astro';
import { HERO_CONFIG } from '../../config/hero';

const hero = HERO_CONFIG['/standard-parts/fasteners'];
const pageTitle = 'Titanium Fasteners | DIN 912 / ISO 4014 / NAS | BOZE Metal';
const pageDescription = 'High-precision titanium fasteners in CP Gr.2 and Gr.5 (Ti-6Al-4V). Socket head cap screws, hex bolts, hex nuts, flange nuts, washers, threaded rod. To DIN 912 / DIN 933 / DIN 934 / DIN 6923 / ISO 4014 / ISO 4017 / ISO 4032 and aerospace NAS / AN / MS. AS9100D QMS. Standard stock 24-48 hours, custom machined 7-10 days, batch heading 3-4 weeks.';
const canonicalUrl = 'https://cnc.bozemetal.com/standard-parts/fasteners/';

const gradeMatrix = [
  { family: 'CP Titanium', grade: 'Grade 2', uns: 'R50400', composition: 'Unalloyed Ti, balanced strength', form: 'SHCS, hex bolts, hex nuts, washers, threaded rod, custom', use: 'Semiconductor wet bench, marine, chemical processing, biomedical forming, general corrosion-resistant hardware' },
  { family: 'Aerospace a-b', grade: 'Grade 5 (Ti-6Al-4V)', uns: 'R56400', composition: '6% Al, 4% V, a-b alloy', form: 'SHCS, hex bolts, hex nuts, flange nuts, washers, custom', use: 'Motorsport suspension and brake calipers, premium bicycle, aerospace structural, high-strength fatigue-critical service' },
];

const specAttributes = [
  { attr: 'Industrial standard compliance', value: 'DIN 912, DIN 933, DIN 934, DIN 6923, DIN 125, DIN 9021, ISO 4014, ISO 4017, ISO 4032, ISO 7093, ASME B18.2.1, ASME B18.2.2', std: 'DIN / ISO / ASME' },
  { attr: 'Aerospace standard compliance', value: 'NAS 1351, NAS 1352, NAS 620, NAS 630, AN 3 / AN 4 / AN 5 / AN 6, MS 27039, MS 21250', std: 'NAS / AN / MS' },
  { attr: 'Quality management system', value: 'AS9100D (aerospace), ISO 9001 (industrial), IATF 16949 (automotive on request)', std: 'AS9100D, ISO 9001' },
  { attr: 'Thread tolerance class', value: '6g / 6H (industrial standard) or 3A / 3B (aerospace high precision)', std: 'ISO 965-1, ASME B1.1' },
  { attr: 'Item matrix', value: 'Socket head cap screws, hex head bolts, hex nuts, flange nuts, washers, threaded rod, custom per drawing', std: 'Customer specification' },
  { attr: 'Size range (metric)', value: 'M2 to M36 (standard); M42 to M64 on request', std: 'DIN 912, ISO 4014' },
  { attr: 'Tensile strength (Gr.5)', value: 'Ultimate >= 895 MPa, 0.2 percent YS >= 828 MPa (per ASTM F468)', std: 'ASTM F468, ASTM E8' },
  { attr: 'Head-forming process', value: 'Cold heading (M2 to M16) and warm heading (M16 to M36) with grain-flow preservation', std: 'Internal process standard' },
  { attr: 'Thread-forming process', value: 'Thread rolling (no cutting) for continuous grain flow and >= 30 percent fatigue gain', std: 'Internal process standard' },
  { attr: 'Surface finish', value: 'As-machined, anti-seize coated, PVD-coated, or multi-color anodized (purple / blue / gold / green / rainbow)', std: 'MIL-DTL-16232, AMS 2471' },
  { attr: 'MOQ', value: 'Standard stocked items: 100 pieces; custom machined: 50 pieces; large-batch heading: scheduled mill campaign', std: 'Customer specification' },
  { attr: 'Mill certification', value: 'EN 10204 3.1 standard; AS9100D batch record with PMI, hardness, and tensile test report', std: 'EN 10204, AS9100D' },
];

const fastenerTypes = [
  {
    id: 'bolts',
    title: 'Titanium Bolts and Hex Bolts',
    image: '/images/products/titanium-hex-bolt-iso-4014.svg',
    imageAlt: 'Grade 5 titanium hex bolt ISO 4014',
    specify: ['Head and dimension standard', 'Diameter and pitch', 'Grip and length', 'Thread class'],
    body: 'Specify finished-product standard, head geometry, under-head length, shank, thread extent and marking.',
    href: '/products/product-entities/titanium-hex-bolt-iso-4014/',
  },
  {
    id: 'screws',
    title: 'Titanium Screws and Socket Heads',
    image: '/images/products/titanium-socket-head-cap-screw-iso-4762.svg',
    imageAlt: 'Grade 5 titanium socket head cap screw ISO 4762',
    specify: ['Head and drive', 'Thread and length', 'Recess inspection'],
    body: 'Define socket, button, countersunk or drawing-based geometry plus recess, head transition and thread requirements.',
    href: '/products/product-entities/titanium-socket-head-cap-screw-iso-4762/',
  },
  {
    id: 'nuts',
    title: 'Titanium Nuts',
    image: '/images/products/titanium-hex-nut-iso-4032.svg',
    imageAlt: 'Grade 5 titanium hex nut ISO 4032',
    specify: ['Style and internal thread class', 'Proof requirement', 'Mating bolt'],
    body: 'Treat the nut as a matched joint component; state style, material, thread, proof requirement and anti-galling basis.',
    href: '/products/product-entities/titanium-hex-nut-iso-4032/',
  },
  {
    id: 'washers',
    title: 'Titanium Washers',
    image: '/images/products/titanium-flat-washer-iso-7089.svg',
    imageAlt: 'Grade 5 titanium flat washer ISO 7089',
    specify: ['OD, ID and thickness', 'Hardness and condition', 'Flatness', 'Surface'],
    body: 'Define geometry, bearing role, material condition, surface and compatibility with the bolt, nut and joint face.',
    href: '/products/product-entities/titanium-flat-washer-iso-7089/',
  },
  {
    id: 'studs',
    title: 'Stud Bolts and Threaded Rods',
    image: '/images/products/titanium-threaded-rod-1m.svg',
    imageAlt: 'Grade 5 titanium threaded rod 1 m length',
    specify: ['Diameter and pitch', 'Overall and threaded length', 'End style', 'Marking'],
    body: 'Specify full or partial thread, end condition, tolerance length and marking. Stud bolts per ASTM A193 and threaded rod in 1 m stock lengths.',
    href: '/products/product-entities/titanium-threaded-rod-1m/',
  },
  {
    id: 'u-bolts',
    title: 'U-Bolts and Bent Fasteners',
    image: '/images/products/titanium-u-bolt.svg',
    imageAlt: 'Grade 5 titanium U-bolt',
    specify: ['Rod diameter', 'Bend radius', 'Leg spacing', 'Thread length'],
    body: 'Drawing control is essential for bent geometry: state rod diameter, bend radius, leg spacing and thread length so the formed part matches the mating flange or pipe.',
    href: '/products/product-entities/titanium-u-bolt/',
  },
  {
    id: 'machined',
    title: 'CNC Machined Fasteners',
    image: '/images/products/titanium-cryogenic-h2-flange-bolt.svg',
    imageAlt: 'Grade 2 titanium cryogenic H2 flange bolt',
    specify: ['Drawing and datums', 'Tolerances', 'Thread route', 'Surface'],
    body: 'For shoulders, special heads, reduced shank, non-standard lengths and drawing-only geometry, machining from bar under a drawing datum scheme is the normal route.',
    href: '/products/product-entities/titanium-cryogenic-h2-flange-bolt/',
  },
  {
    id: 'assemblies',
    title: 'Custom Fastener Assemblies',
    image: '/images/products/titanium-water-bottle-cage-bolt.svg',
    imageAlt: 'Grade 5 titanium water bottle cage bolt',
    specify: ['Bolt, nut and washer set', 'Interfaces', 'Lot control', 'Packing'],
    body: 'Freeze each component, mating thread, finish and marking into one lot-controlled kit. Interface geometry, torque values and packing are confirmed at the RFQ stage.',
    href: '/products/product-entities/titanium-water-bottle-cage-bolt/',
  },
];

const pipeline = [
  { n: '01', title: 'Raw material PMI and traceability', body: 'Every heat-lot of Grade 2 (CP) or Grade 5 (Ti-6Al-4V) wire rod / bar is received with the upstream-mill 3.1 MTR and verified by XRF positive-material-identification (PMI) before release to the heading line. Heat number is logged for full downstream traceability.' },
  { n: '02', title: 'Cold and warm heading of the head', body: 'Bolts and screws are headed on multi-station cold headers (M2 to M16) or warm headers (M16 to M36). Heading energy, lubrication, and die geometry are tuned per grade to preserve the radial grain-flow from the wire surface through the head. Mismatch causes head-base cracking, which is caught by 100 percent eddy-current test on the first-off sample.' },
  { n: '03', title: 'Thread rolling (no cutting)', body: 'Threads are produced by cold thread-rolling between hardened flat or cylindrical dies. Rolling displaces the metal rather than cutting it, so the grain flow follows the thread profile and is unbroken at the root radius. The result is a 30-50 percent fatigue-strength gain over a cut thread of the same nominal size.' },
  { n: '04', title: 'Heat treatment and surface finishing', body: 'Gr.5 parts are vacuum solution-treated and aged to the required temper. Surface finish is then applied: as-machined for industrial service, anti-seize coated (PTFE, nickel, or Cu-free formulation) for galling-prone service, or multi-color anodized for motorsport / bicycle / consumer color coding.' },
  { n: '05', title: '100 percent thread and dimensional inspection', body: 'Every part is thread-checked with calibrated Go / No-Go ring or plug gauges. Critical dimensions (head height, across-flats, across-corners) are checked on an optical comparator. Surface-defect screening is done on a vision system for A-class orders.' },
  { n: '06', title: 'AS9100D release, packaging, and shipping', body: 'EN 10204 3.1 mill test report (chemistry, mechanical, dimensional) is issued per batch under AS9100D. Aerospace lots are individually bagged and trace-labeled with heat number, batch, and inspection record. Standard lots are bulk-packed in foam-padded cartons. Standard stock ships in 24-48 hours; custom machined 7-10 days; batch heading 3-4 weeks.' },
];

const boundaries = [
  { icon: '🌡️', title: 'High-temperature service ceiling', body: 'Grade 5 (Ti-6Al-4V) fasteners lose strength progressively above about 315 C. Above about 350 C, sustained tensile load will accelerate creep and reduce preload retention. For sustained high-temperature service, specify nickel-based or other alloy fasteners; for short excursions up to about 400 C, confirm preload at the RFQ stage.' },
  { icon: '⚡', title: 'Torque-control warning', body: 'Titanium has a lower elastic modulus than steel. The same tightening torque that preloads a steel bolt to its proof load will over-stretch a titanium bolt, causing yield and loss of preload. Use the manufacturer-published torque table for the specific grade, finish, and thread size; do not use a generic steel torque value.' },
  { icon: '🔧', title: 'Anti-seize required for titanium-on-titanium', body: 'Titanium fasteners in titanium nuts (or titanium-on-titanium clamped joints) will gall and seize on the first installation cycle if run dry. Apply a qualified anti-seize compound (PTFE-based, nickel-based, or Cu-free per spec) on the thread and under-head bearing surface for every assembly and disassembly.' },
];

const supplyChain = [
  { icon: '🏭', title: 'Capacity and MOQ', body: 'Cold-heading capacity from M2 to M16; warm-heading capacity from M16 to M36. Engineering sample supported down to 50 pieces for custom machined; production runs of several hundred thousand pieces per month are standard for high-volume orders. Special alloy pulls and exotic dimensions are scheduled against the upstream-mill wire campaign.' },
  { icon: '📦', title: 'Stock and lead time', value: '', std: '' },
  { icon: '🗓️', title: 'Documentation and third-party witness', body: 'EN 10204 3.1 mill test report (chemistry, mechanical, dimensional) is standard under AS9100D. 3.2 with independent witness from Lloyds, Bureau Veritas, DNV, or customer-appointed agencies is supported and arranged at the RFQ stage. PMI verification, hardness, and tensile test report are attached to each batch.' },
];

const comparisonRows = [
  { dim: 'Density and specific strength', ours: 'Lightest: about 4.51 g/cm3, ratio of strength to density is highest', alt1: 'Heavy: about 7.85 g/cm3, very high absolute strength', alt2: 'Heavy: about 7.98 g/cm3, moderate strength' },
  { dim: 'Ultimate tensile strength', ours: 'Gr.5 >= 895 MPa; high strength with 40-50 percent weight saving versus steel', alt1: '>= 1220 MPa (12.9 grade); highest absolute strength but heavy', alt2: '>= 620 MPa (316L); moderate strength, heavy' },
  { dim: 'Chemical and corrosion resistance', ours: 'Excellent: immune to seawater, chloride, and most chemical attack; no protective coating required', alt1: 'Poor: no corrosion resistance without plating or coating', alt2: 'Good: pitting risk in chloride media, especially under deposits' },
  { dim: 'Fatigue and damping behaviour', ours: 'Low modulus gives high elastic compliance and excellent vibration damping; ideal for motorsport and dynamic aerospace', alt1: 'High modulus gives high stiffness but more brittle impact behaviour', alt2: 'Moderate modulus and fatigue performance; general purpose' },
];

const faqItems = [
  { question: 'Why do aerospace and motorsport titanium bolts require thread rolling rather than thread cutting?', answer: 'Cutting a thread interrupts the metal grain flow at the thread root and creates a sharp stress-concentration feature. Rolling a thread by plastic deformation preserves continuous grain flow along the thread profile, smooths the root radius, and typically improves fatigue strength by 30-50 percent versus a cut thread of the same nominal size.' },
  { question: 'Why is Grade 2 (CP) the default for semiconductor wet-bench fasteners rather than Grade 5?', answer: 'Wet-bench equipment is exposed to strong acids and alkalis (HCl, H2O2, SC1, SC2) at elevated temperature. Grade 5 contains 6 percent aluminum and 4 percent vanadium; the aluminum in particular can interfere with the passive-film stability in reducing-acid chemistries. Grade 2 (CP) has a cleaner, more stable TiO2 passive film and is the workhorse specification for wet-bench fasteners, tanks, and piping.' },
  { question: 'How is color consistency guaranteed across multi-color anodized batches?', answer: 'Color consistency depends on the thickness of the TiO2 layer, which is controlled by electrolyte temperature, chemical concentration, voltage, and dwell time. We use a temperature-controlled electrolytic bath with closed-loop voltage regulation and a membrane-thickness gauge for in-process verification. This holds the oxide thickness to plus or minus 0.1 micrometer and produces consistent purple / blue / gold / green / rainbow colors across batches.' },
  { question: 'Is anti-seize compound required for every titanium fastener installation?', answer: 'Anti-seize is required for any titanium-on-titanium threaded joint (titanium bolt in titanium nut) and for any disassembly-and-reassembly service. For single-use aerospace installations (e.g. NAS bolt in a steel nut) anti-seize is generally not required. The fastener manufacturer should be consulted for the specific application and qualified anti-seize (PTFE-, nickel-, or Cu-free formulation) selected per spec.' },
  { question: 'What is the lead time for custom titanium fasteners?', answer: 'Standard stocked items (common DIN / ISO sizes in Gr.2 and Gr.5) ship in 24-48 hours. Custom machined parts (non-standard dimensions, custom head, special thread, or non-standard alloy) take 7-10 days. Large-batch heading (cold or warm) for a new part number takes 3-4 weeks. Final lead time is confirmed at the RFQ stage.' },
  { question: 'How do I select between DIN, ISO, and NAS / AN / MS standards for the same application?', answer: 'DIN (DIN 912, 933, 934) and ISO (ISO 4014, 4017, 4032) are interchangeable for most global industrial and automotive applications; ISO is the preferred global standard. NAS, AN, and MS are U.S. aerospace / defense specifications and are mandatory for many legacy and current aerospace platforms. The choice is driven by the engineering drawing and the end-customer spec, not by the material. BOZE supplies all three families from one production line.' },
];

const relatedLinks = [
  { title: 'All Titanium Standard Parts', desc: 'Flanges, pipe fittings, fasteners, and CNC-machined standard components from one supplier.', href: '/standard-parts/' },
  { title: 'Titanium Flanges', desc: 'Weld-neck, slip-on, blind, threaded, and lap-joint flanges to ASME B16.5 / ASTM B381.', href: '/standard-parts/flanges/' },
  { title: 'Titanium Pipe Fittings', desc: 'Butt-weld elbows, tees, reducers, caps, and stub ends to ASME B16.9 / ASTM B363.', href: '/standard-parts/pipe-fittings/' },
  { title: 'CNC Machined Standard Components', desc: 'Custom machined titanium parts to print, including brackets, manifolds, and specialty assemblies.', href: '/standard-parts/machined-components/' },
  { title: 'Compliance and Certifications', desc: 'AS9100D, EN 10204 3.1 evidence chain.', href: '/capabilities/compliance/' },
];

// ItemList mirrors the eight product-type cards rendered in the
// "Titanium Fastener Types" section below, so every ListItem URL resolves
// to a real anchor id on this page (no dangling #shcs / #nut / #washer).
const itemListItems = [
  { name: 'Titanium Bolts and Hex Bolts (DIN 933 / ISO 4014)', url: 'https://cnc.bozemetal.com/standard-parts/fasteners/#bolts' },
  { name: 'Titanium Screws and Socket Head Cap Screws (DIN 912 / ISO 4762)', url: 'https://cnc.bozemetal.com/standard-parts/fasteners/#screws' },
  { name: 'Titanium Nuts (DIN 934 / ISO 4032, DIN 6923)', url: 'https://cnc.bozemetal.com/standard-parts/fasteners/#nuts' },
  { name: 'Titanium Washers (DIN 125 / ISO 7089, DIN 127)', url: 'https://cnc.bozemetal.com/standard-parts/fasteners/#washers' },
  { name: 'Titanium Stud Bolts and Threaded Rods (ASTM A193)', url: 'https://cnc.bozemetal.com/standard-parts/fasteners/#studs' },
  { name: 'Titanium U-Bolts and Bent Fasteners', url: 'https://cnc.bozemetal.com/standard-parts/fasteners/#u-bolts' },
  { name: 'CNC Machined Titanium Fasteners (per drawing)', url: 'https://cnc.bozemetal.com/standard-parts/fasteners/#machined' },
  { name: 'Custom Titanium Fastener Assemblies', url: 'https://cnc.bozemetal.com/standard-parts/fasteners/#assemblies' },
];
---


<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalUrl}
  pageType="standard-part-detail"
  serviceName="Titanium Fasteners Mill-Standard Parts"
  serviceDescription="Industrial titanium fasteners (socket head cap screws DIN 912, hex head bolts DIN 933, hex nuts DIN 934, flange nuts DIN 6923, washers DIN 125/DIN 9021, threaded rod, custom per drawing) in CP Gr.2 / Gr.5 (Ti-6Al-4V). Industrial standards DIN 912 / DIN 933 / DIN 934 / DIN 6923 / DIN 125 / ISO 4014 / ISO 4017 / ISO 4032 / ASME B18.2.1 / ASME B18.2.2 plus aerospace NAS / AN / MS. AS9100D QMS. Manufactured by thread-rolled (no cutting) cold heading and warm heading with full heat-to-fastener material traceability."
  serviceCategory="Raw Materials, Non-Ferrous Metals, Titanium"
  collectionName="Industrial Titanium Fasteners"
  collectionDescription="Titanium fasteners (bolts, screws, nuts, washers, stud bolts, threaded rod, U-bolts, CNC-machined parts and custom assemblies) for motorsport, premium bicycle, aerospace structural, semiconductor wet-bench, marine, and chemical-processing applications."
  itemCount={itemListItems.length}
  items={itemListItems}
  faqItems={faqItems}
  faqName="Engineering and Procurement FAQ, Titanium Fasteners"
  productDeliveryLeadTime="24-48 hours (stock) / 7-10 days (custom machined) / 3-4 weeks (batch heading)"
>
  <SubpageHero h1={hero.h1} subtitle={hero.subtitle} badge={hero.badge} keyMetrics={hero.keyMetrics} entityChips={hero.entityChips} />


  <section class="py-16 lg:py-20" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Honest Positioning</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Where We Do Not Compete</h2>
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">BOZE Metal is a sourcing and processing partner for titanium fasteners, not a primary melter. The following scope clarifications are necessary for accurate technical and commercial alignment on fastener orders for motorsport, aerospace, and semiconductor service.</p>
      </header>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-2xl" aria-hidden="true">🛑</span>
          <h3 class="mt-3 text-lg font-bold" style="color: var(--theme-text);">No primary melting</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">Sponge, VAR, and EBM melting and bar production is not in our vertically integrated scope. We source wire rod and bar from upstream mills; our scope is cold and warm heading, thread rolling, heat treatment, surface coating, and quality verification.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-2xl" aria-hidden="true">⚠️</span>
          <h3 class="mt-3 text-lg font-bold" style="color: var(--theme-text);">No blanket aerospace-grade</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">Material specifications are applied "where applicable" per order. AS9100D governs our QMS, not every shipment classification. Confirm criticality class, specification (DIN / ISO / ASME B18 / NAS / AN / MS), and required documentation per RFQ.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-2xl" aria-hidden="true">🏥</span>
          <h3 class="mt-3 text-lg font-bold" style="color: var(--theme-text);">No blanket medical claim</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">We supply fasteners to medical material specifications (ASTM F67, F136) where applicable. We are a material supplier and processor, not a finished medical device manufacturer; downstream device-level certification remains the device maker responsibility.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-2xl" aria-hidden="true">⏱️</span>
          <h3 class="mt-3 text-lg font-bold" style="color: var(--theme-text);">No 24-hour quote promise</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">Engineering review and quotation timelines are confirmed at the RFQ stage based on the order complexity, alloy, size, finish, and downstream processing required. Standard stocked items typically receive a same-day or next-day response.</p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-2xl" aria-hidden="true">🔍</span>
          <h3 class="mt-3 text-lg font-bold" style="color: var(--theme-text);">Anodizing color scope</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">Standard anodizing palette is purple, blue, gold, green, and rainbow. Custom Pantone-matching is order-specified and subject to a per-batch setup fee; color reference is held in the AS9100D batch record. Confirm the color and tolerance at the RFQ stage.</p>
        </article>
      </div>
    </div>
  </section>


  <section id="fastener-types" class="py-16 lg:py-20" style="background: var(--theme-surface);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Product Types</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Titanium Fastener Types</h2>
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">Bolts, screws, nuts, washers, studs and drawing-based parts. For buyers comparing titanium fastener manufacturers and suppliers, each type must be tied to a material, thread, dimensional, process and inspection basis - not only a product name.</p>
      </header>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {fastenerTypes.map((t) => (
          <a href={t.href} class="group flex flex-col h-full rounded-2xl border overflow-hidden transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
            <article id={t.id} class="flex flex-col h-full">
              <div class="relative aspect-[4/3] overflow-hidden" style="background: var(--theme-surface);">
                <img src={t.image} alt={t.imageAlt} width="1024" height="1024" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.onerror=function(){var s=this.src;if(s.lastIndexOf('.svg')!==s.length-4){this.src=s.replace(/\.\w+$/,'.svg')}else{this.style.display='none'}}" />
              </div>
              <div class="flex flex-col flex-1 p-5">
                <h3 class="text-base font-bold leading-snug mb-3" style="color: var(--theme-text);">{t.title}</h3>
                <p class="text-sm font-semibold leading-relaxed mb-3" style="color: var(--theme-primary);">
                  <span class="font-bold">Specify:</span> {t.specify.join(' · ')}
                </p>
                <p class="text-sm leading-relaxed mb-5" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{t.body}</p>
                <span class="mt-auto inline-flex items-center gap-1 text-sm font-bold" style="color: var(--theme-primary);">View specification <span aria-hidden="true">&rarr;</span></span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>


  <section id="grade-form-matrix" class="py-16 lg:py-20" style="background: var(--theme-surface);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl">
