--- 
import BaseLayout from '../../layouts/BaseLayout.astro'; 
import EquipmentPageLayout from '../../components/equipment/EquipmentPageLayout.astro'; 
import { getLangFromUrl, useTranslations } from '../../i18n/utils'; 
import { EQUIPMENT_DATA } from '../../data/equipment'; 
 
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang); 
const equipment = EQUIPMENT_DATA['anodizing-surface-treatment']; 
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://cnc.bozemetal.com'); 
--- 
 
<BaseLayout title={t('equipment.anodizing-surface-treatment.pageTitle')} description={t('equipment.anodizing-surface-treatment.metaDescription')} canonicalURL={canonicalURL}> 
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/equipment/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.equipment')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('equipment.anodizing-surface-treatment.name')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <EquipmentPageLayout equipment={equipment} lang={lang} equipmentKey={equipment.key} /> 
</BaseLayout>
