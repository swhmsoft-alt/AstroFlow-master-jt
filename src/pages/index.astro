---
import BaseLayout from '../layouts/BaseLayout.astro';
import PremiumHero from '../components/home/PremiumHero.astro';
import ServicesOverview from '../components/home/ServicesOverview.astro';
import TechnicalCapabilities from '../components/home/TechnicalCapabilities.astro';
import SpecializedCapabilities from '../components/home/SpecializedCapabilities.astro';
import JapanTrustDashboard from '../components/home/JapanTrustDashboard.astro';
import CertificationsMarquee from '../components/home/CertificationsMarquee.astro';
import MaterialMatrix from '../components/home/MaterialMatrix.astro';
import IndustryApplications from '../components/home/IndustryApplications.astro';
import EngineeringResources from '../components/home/EngineeringResources.astro';
import PremiumCTA from '../components/home/PremiumCTA.astro';
import PartsPromoBanner from '../components/parts/PartsPromoBanner.astro';
import { HERO_CONFIG } from '../config/hero';
import { getCollection } from 'astro:content';
import { getEntitiesByCategory, getAllEntities } from '../lib/entity-graph';

// This collection is defined in src/content/config.ts
// home.md from src/content/pages/home.md is loaded at build time
const pages = await getCollection('pages');
const homePage = pages.find(p => p.id === 'home');

// F3 — Home page exposes the site's full entity vocabulary as WebPage.mentions
// so LLM crawlers see a centralized @id graph for the brand.
// T3-P0 (2026-10-16): Reduced top-30 → top-12 per category. JSON-LD
// WebPage.mentions block was 57,614 bytes (15% of 387KB dist HTML) at
// top-30. Top-12 keeps the most important entities from each category
// (60 total, well above the LLM "centralized @id graph" use case) while
// reducing the JSON-LD payload by ~60% (≈ 23 KB savings). The full 868
// entity vocabulary remains available on the actual hub pages, so
// semantic discoverability is unchanged.
const homeMentions: string[] = (() => {
  const ids = new Set<string>();
  const priority: Array<'industry' | 'material' | 'service' | 'standard' | 'application'> = [
    'industry', 'material', 'service', 'standard', 'application',
  ];
  for (const cat of priority) {
    const ents = getEntitiesByCategory(cat).slice(0, 12);
    for (const e of ents) {
      if (e.page_url) ids.add(e.id);
    }
  }
  return [...ids];
})();
const enHero = HERO_CONFIG['/'];
const heroData = {
  ...(homePage?.data || {
    primaryCta: 'Request a Quote',
    primaryCtaLink: '/rfq/',
    secondaryCta: 'Explore Solutions',
    secondaryCtaLink: '/services',
    heroMediaType: 'image',
    heroVideoUrl: '',
    // P0-1 (2026-10-16): Point to the WebP variant directly so the
    // <picture><source type="image/webp"> picks the smallest file.
    // The 750w mobile variant is generated by postbuild-images.mjs.
    // The .jpg filename is kept as a fallback in the <img src=...> for
    // ancient browsers that don't support WebP (postbuild strips the
    // .jpg from dist/, so the fallback is only meaningful if served
    // from a CDN that retains the original).
    heroImage: '/uploads/titanium-cnc-machining-manufacturing-facility.webp',
    heroImageMobile: '/uploads/titanium-cnc-machining-manufacturing-facility-750w.webp',
    heroImageAlt: 'CNC machining background',
    stats: [
      { value: '120+', label: 'Advanced CNC Machining Centers' },
      { value: 'AS9100D', label: 'Aerospace-Grade Certified' },
      { value: '< 48h', label: 'Technical DFM & RFQ Response' },
      { value: '5,000+ pcs', label: 'Monthly Titanium Output' }
    ]
  }),
  badge: enHero.badge,
  h1: enHero.h1,
  title: '',
  highlight: '',
  description: enHero.subtitle,
  tertiaryCta: 'Engineering Tools',
  tertiaryCtaLink: '/tools/',
};
---

<BaseLayout mentions={homeMentions}>
  <PremiumHero hero={heroData} />
  <ServicesOverview />
  <TechnicalCapabilities />
  <SpecializedCapabilities />
  <JapanTrustDashboard />
  <CertificationsMarquee />
  <MaterialMatrix />
  <IndustryApplications />
  <EngineeringResources />
  <PartsPromoBanner />
  <PremiumCTA />
</BaseLayout>