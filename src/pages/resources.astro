---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import ResourceHubMatrix from '../components/resources/ResourceHubMatrix.astro';
import FeaturedInsights from '../components/resources/FeaturedInsights.astro';
import EngineeringDownloads from '../components/resources/EngineeringDownloads.astro';
import TechnicalFaqAccordion from '../components/resources/TechnicalFaqAccordion.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<BaseLayout>
  <!-- Hero -->
  <SubpageHero
    title={t('resources.astro.resources.technical_2')}
    highlight="Resources Library"
    badge="Engineering Knowledge Base"
    badgeIcon="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
    subtitle="Comprehensive technical documentation, engineering guides, whitepapers, and downloadable CAD resources — an open library for titanium manufacturing professionals."
  />

  <!-- Resource Hub Matrix -->
  <ResourceHubMatrix />

  <!-- Featured Insights -->
  <FeaturedInsights />

  <!-- Engineering Downloads -->
  <EngineeringDownloads />

  <!-- Technical FAQ Accordion -->
  <TechnicalFaqAccordion />
</BaseLayout>
