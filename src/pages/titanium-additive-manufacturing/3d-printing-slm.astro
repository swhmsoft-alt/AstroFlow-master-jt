---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudienceHub from '../../components/audience/AudienceHub.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import SlmProcessBreakdown from '../../components/services/SlmProcessBreakdown.astro';
import SlmMechanicalDashboard from '../../components/services/SlmMechanicalDashboard.astro';
import MetallurgyDefectControl from '../../components/services/MetallurgyDefectControl.astro';
import SlmDedicatedCta from '../../components/services/SlmDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-additive-manufacturing/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services.additiveManufacturing')}</span>
          </a>
          <meta itemprop="position" content="3" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.3dPrintingSlm')}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title={t('titanium-additive-manufacturing.dPrintingSlm.3d_printing_slm_dmls')}
    highlight="Services"
    badge="Additive Manufacturing"
    badgeIcon="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
    subtitle="Selective Laser Melting and Direct Metal Laser Sintering of titanium powders — achieving full-density components with mechanical properties surpassing wrought material, internal channels, and complex lattice geometries."
  
    keyMetrics={HERO_CONFIG['/titanium-additive-manufacturing/3d-printing-slm']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-additive-manufacturing/3d-printing-slm']?.entityChips}
  />

  <!-- SLM Process Mechanics — 3-column breakdown -->
  <SlmProcessBreakdown />

  <!-- SLM Mechanical Performance Dashboard — 5-column -->
  <SlmMechanicalDashboard />

  <!-- Micro-Void & Layer Purity Control — 2-column -->
  <MetallurgyDefectControl />

  <!-- Dedicated CTA — SLM Feasibility Review -->
  <SlmDedicatedCta />
<AudienceHub industry="additive" />
</BaseLayout>