---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import AdditiveEconomicsPillars from '../../components/services/AdditiveEconomicsPillars.astro';
import ProductionVolumeDashboard from '../../components/services/ProductionVolumeDashboard.astro';
import InterBatchRepeatability from '../../components/services/InterBatchRepeatability.astro';
import AdditiveBatchCta from '../../components/services/AdditiveBatchCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout title={t('titanium-additive-manufacturing.lowVolumeProduction.lowvolume_production_boze_cnc_ti')} description="Low-volume titanium production via SLM: 10-1,000+ unit batches, zero tooling costs, ≥95% material utilization, multi-laser sync, SPC witness bar validation. AS9100D.">
  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title={t('titanium-additive-manufacturing.lowVolumeProduction.lowvolume_production')}
    highlight="Services"
    badge="Additive Manufacturing"
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    subtitle="Cost-effective batch runs from 10 to 1,000+ units utilizing optimized nesting arrays across quad-laser SLM platforms — skipping high tooling amortization while maintaining production-grade mechanical properties."
  
    keyMetrics={HERO_CONFIG['/titanium-additive-manufacturing/low-volume-production']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-additive-manufacturing/low-volume-production']?.entityChips}
  />

  <!-- Additive Economics Pillars — 3-column grid -->
  <AdditiveEconomicsPillars />

  <!-- Production Volume Throughput Dashboard — 4-column -->
  <ProductionVolumeDashboard />

  <!-- Inter-Batch Repeatability Control — 2-column -->
  <InterBatchRepeatability />

  <!-- Dedicated CTA — Batch Pricing Assessment -->
  <AdditiveBatchCta />
</BaseLayout>