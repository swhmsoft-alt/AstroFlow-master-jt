  }
];
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<BaseLayout>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">Facilities</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <SubpageHero
    title="Our"
    highlight="Facilities"
    badge="Our Infrastructure"
    badgeIcon="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
    subtitle="Strategically located facilities across North America equipped with state-of-the-art technology and industry certifications."
  />

  <!-- Quick Stats -->
  <Section background="white">
    <FacilityStats client:load />
  </Section>

  <!-- Facilities Grid -->
  <Section background="gray">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4" style="background: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); font-size: 0.875rem; font-weight: 600; border-radius: 9999px;">
        Our Locations
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--theme-text);">
        Strategic <span class="gradient-text">{t('facilities.astro.facilities.facilities')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Each facility is designed to meet specific industry needs with cutting-edge infrastructure and capabilities.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {facilities.map((facility, index) => (
        <ImageReveal client:load delay={index * 0.1}>
          <Card hover class="overflow-hidden animate-fadeInUp group" style={`animation-delay: ${index * 0.1}s`}>
            <!-- Facility Image -->
            <div class="relative h-64 overflow-hidden">
              <Img 
                src={facility.image}
                alt={facility.name}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                widths={[480,768,1024,1600,2070]}
                sizes="100vw"
              />
              <div class="absolute inset-0" style="background: linear-gradient(to top, color-mix(in srgb, var(--theme-bg) 80%, transparent) 0%, color-mix(in srgb, var(--theme-bg) 40%, transparent) 60%, transparent 100%);"></div>
              <div class="absolute top-4 right-4">
                <div class="w-12 h-12 rounded-full backdrop-blur-sm flex items-center justify-center" style="background: color-mix(in srgb, var(--theme-text) 20%, transparent); border: 1px solid color-mix(in srgb, var(--theme-text) 30%, transparent);" set:html={facility.icon}></div>
              </div>
              <div class="absolute bottom-0 left-0 right-0 p-6" style="color: var(--theme-text);">
                <h3 class="text-2xl font-bold mb-1">{facility.name}</h3>
                <p class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{facility.type}</p>
              </div>
            </div>

            <div class="p-6 space-y-5" style="background: var(--theme-surface);">
              <!-- Location & Size -->
              <div class="flex flex-wrap items-center gap-3 text-sm" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {facility.location}
                </span>
                <span style="color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">•</span>
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1v-3z" />
                  </svg>
                  {facility.size}
                </span>
              </div>

              <!-- Features -->
              <div>
                <h4 class="text-sm font-semibold uppercase mb-3 tracking-wide flex items-center gap-2" style="color: color-mix(in srgb, var(--theme-text) 85%, transparent);">
                  <svg class="w-4 h-4" style="color: var(--theme-accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  Key Features
                </h4>
                <ul class="grid grid-cols-1 gap-2.5">
                  {facility.features.map((feature) => (
                    <li class="flex items-start space-x-2.5 text-sm">
                      <svg class="w-4 h-4 shrink-0 mt-0.5" style="color: var(--theme-accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Certifications -->
              <div class="border-t pt-4" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                <h4 class="text-sm font-semibold uppercase mb-3 tracking-wide flex items-center gap-2" style="color: color-mix(in srgb, var(--theme-text) 85%, transparent);">
                  <svg class="w-4 h-4" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                  </svg>
                  Certifications
                </h4>
                <div class="flex flex-wrap gap-2">
                  {facility.certifications.map((cert) => (
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium" style="background: linear-gradient(to right, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-accent) 15%, transparent)); color: var(--theme-primary); border: 1px solid color-mix(in srgb, var(--theme-primary) 30%, transparent);">
                      {cert}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </Card>
        </ImageReveal>
      ))}
    </div>
  </Section>

  <!-- Map Section -->
  <Section background="white">
    <Card class="overflow-hidden">
      <div class="text-center mb-8">
        <div class="inline-block px-4 py-2 mb-4" style="background: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); font-size: 0.875rem; font-weight: 600; border-radius: 9999px;">
          Network Coverage
        </div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
          Strategic <span class="gradient-text">{t('facilities.astro.facilities.coverage')}</span>
        </h2>
        <p class="max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          Our facilities are strategically positioned to provide optimal coverage across North America
        </p>
      </div>
      
      <!-- Map Placeholder -->
      <div class="relative aspect-video rounded-xl overflow-hidden" style="background: linear-gradient(to bottom right, color-mix(in srgb, var(--theme-primary) 8%, var(--theme-surface)), var(--theme-surface), color-mix(in srgb, var(--theme-accent) 8%, var(--theme-surface))); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="absolute inset-0 flex items-center justify-center z-10">
          <div class="text-center">
            <svg class="w-24 h-24 mx-auto mb-4 animate-pulse" style="color: color-mix(in srgb, var(--theme-primary) 40%, transparent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="font-semibold text-lg mb-2" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{t('facilities.astro.facilities.interactive_map')}</p>
            <p class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('facilities.astro.facilities.contact_us_detailed_facility_information')}</p>
          </div>
        </div>
        
        <!-- Decorative location markers -->
        <div class="absolute inset-0 opacity-40">
          <div class="absolute top-1/4 left-1/4 w-4 h-4" style="background: var(--theme-primary); border-radius: 9999px; animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; box-shadow: 0 10px 15px -3px color-mix(in srgb, var(--theme-primary) 30%, transparent);"></div>
          <div class="absolute top-1/3 left-1/2 w-4 h-4" style="background: var(--theme-primary); border-radius: 9999px; animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; box-shadow: 0 10px 15px -3px color-mix(in srgb, var(--theme-primary) 30%, transparent); animation-delay: 0.2s"></div>
          <div class="absolute top-1/2 right-1/3 w-4 h-4" style="background: var(--theme-primary); border-radius: 9999px; animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; box-shadow: 0 10px 15px -3px color-mix(in srgb, var(--theme-primary) 30%, transparent); animation-delay: 0.4s"></div>
          <div class="absolute bottom-1/3 left-1/3 w-4 h-4" style="background: var(--theme-primary); border-radius: 9999px; animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; box-shadow: 0 10px 15px -3px color-mix(in srgb, var(--theme-primary) 30%, transparent); animation-delay: 0.6s"></div>
          <div class="absolute bottom-1/4 right-1/4 w-4 h-4" style="background: var(--theme-primary); border-radius: 9999px; animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; box-shadow: 0 10px 15px -3px color-mix(in srgb, var(--theme-primary) 30%, transparent); animation-delay: 0.8s"></div>
          <div class="absolute top-2/3 right-1/4 w-4 h-4" style="background: var(--theme-primary); border-radius: 9999px; animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; box-shadow: 0 10px 15px -3px color-mix(in srgb, var(--theme-primary) 30%, transparent); animation-delay: 1s"></div>
        </div>
      </div>
    </Card>
  </Section>

  <!-- Facility Standards -->
  <Section background="gradient">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4" style="background: color-mix(in srgb, var(--theme-text) 15%, var(--theme-surface)); backdrop-filter: blur(8px); color: var(--theme-primary); font-size: 0.875rem; font-weight: 600; border-radius: 9999px; border: 1px solid color-mix(in srgb, var(--theme-primary) 30%, transparent);">
        Our Standards
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--theme-text);">
        Facility <span class="gradient-text">{t('facilities.astro.facilities.standards')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Every facility meets our rigorous standards for safety, security, and operational excellence.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {facilityStandards.map((feature, index) => (
        <Card hover class="text-center animate-fadeInUp group" style={`animation-delay: ${index * 0.1}s`}>
          <div class="w-16 h-16 mx-auto mb-4 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-lg" style={`background: ${feature.color};`} set:html={feature.icon}></div>
          <h3 class="text-lg font-bold mb-2" style="color: var(--theme-text);">{feature.title}</h3>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{feature.description}</p>
        </Card>
      ))}
    </div>
  </Section>

  <!-- CTA Section -->
  <section class="relative py-32 overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0">
      <Img 
        src={undefined}
        alt={t('facilities.astro.facilities.modern_facilities_infrastructure')}
        class="w-full h-full object-cover"
        widths={[480,768,1024,1600,2070]}
        sizes="100vw"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to right, color-mix(in srgb, var(--theme-primary) 95%, var(--theme-bg)), color-mix(in srgb, var(--theme-accent) 95%, var(--theme-bg)));"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center" style="color: var(--theme-text);">
        <div class="inline-block px-4 py-2 mb-6" style="background: color-mix(in srgb, var(--theme-text) 15%, transparent); backdrop-filter: blur(8px); color: var(--theme-text); font-size: 0.875rem; font-weight: 600; border-radius: 9999px;">
          Get Started Today
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          Ready to Visit Our <span class="text-transparent bg-clip-text" style="background: linear-gradient(to right, var(--theme-primary), var(--theme-accent)); -webkit-background-clip: text;">{t('facilities.astro.facilities.facilities_2')}</span>?
        </h2>
        <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
          Schedule a tour to see our operations firsthand and discuss how we can meet your needs.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
          <Button href="/rfq/" target="_blank" rel="noopener noreferrer" size="lg">
            Request a Quote
          </Button>
          <Button href="/services" size="lg" variant="outline">
            View Capabilities
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
