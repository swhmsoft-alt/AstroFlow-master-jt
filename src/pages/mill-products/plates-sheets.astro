---
/**
 * /mill-products/plates-sheets/ — Titanium Plate, Sheet, Coil & Foil Sub-Page
 * Buyer Search Intelligence Phase G-2 · Mill Products Plate & Sheet
 * Schema: pageType="standard-part-detail" → CollectionPage + ItemList + Service
 * (auto-emitted via src/lib/schema.ts; F4 compliant, no inline JSON-LD)
 * F2: No new component for a single page. F3: { question, answer } keys. F9: trailing slash.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import ImageTextSplit from '../../components/ui/ImageTextSplit.astro';
import TrustBadges from '../../components/landing/TrustBadges.astro';
import QualityControl from '../../components/landing/QualityControl.astro';
import Applications from '../../components/landing/Applications.astro';
import { HERO_CONFIG } from '../../config/hero';

const hero = HERO_CONFIG['/mill-products/plates-sheets'];

const pageTitle = 'Titanium Plate & Sheet Stock | ASME SB265 & AMS 4911 | BOZE Metal';
const pageDescription = 'Precision-rolled titanium plates & sheets (0.0197" to 6"). Gr1-Gr23, Ti-6-2-4-2 & Gr7 in stock. EN 10204 3.1 MTR, AS9100D certified. Standard stock ships in 3-5 days.';
const canonicalUrl = 'https://cnc.bozemetal.com/mill-products/plates-sheets/';

// ── S02 Grade × Form Matrix ────────────────────────────────────────────────
const gradeMatrix = [
  { family: 'CP Titanium', grade: 'Grade 1', uns: 'R50250', composition: 'Unalloyed Ti, lowest interstitial', form: 'Sheet, Plate', use: 'Chemical processing, formable structures' },
  { family: 'CP Titanium', grade: 'Grade 2', uns: 'R50400', composition: 'Unalloyed Ti, balanced strength', form: 'Plate, Sheet, Tube, Bar', use: 'Most widely specified CP — pressure vessels, marine' },
  { family: 'CP Titanium', grade: 'Grade 3', uns: 'R50550', composition: 'Unalloyed Ti, higher strength', form: 'Plate, Sheet', use: 'Higher-stress chemical service' },
  { family: 'CP Titanium', grade: 'Grade 4', uns: 'R50700', composition: 'Unalloyed Ti, highest CP strength', form: 'Plate, Sheet', use: 'Aerospace structures, fasteners, surgical hardware' },
  { family: 'Aerospace α-β', grade: 'Grade 5 (Ti-6Al-4V)', uns: 'R56400', composition: '6% Al, 4% V — α-β alloy', form: 'Plate, Sheet, Bar', use: 'Aerospace workhorse — airframe, engine brackets' },
  { family: 'Aerospace α-β ELI', grade: 'Grade 23 (Ti-6Al-4V ELI)', uns: 'R56401', composition: '6% Al, 4% V, low interstitials', form: 'Plate, Sheet, Bar, Wire', use: 'Fracture-critical, medical device' },
  { family: 'Near-α', grade: 'Grade 9 (Ti-3Al-2.5V)', uns: 'R56320', composition: '3% Al, 2.5% V', form: 'Sheet, Tube, Bar', use: 'High-pressure hydraulic tubing, moderate strength' },
  { family: 'Corrosion-resistant', grade: 'Grade 7 (Ti-Pd)', uns: 'R52400', composition: 'CP + 0.12–0.25% Pd', form: 'Plate, Sheet, Bar', use: 'Reducing acids, HCl service, chemical industry' },
  { family: 'Corrosion-resistant', grade: 'Grade 12 (Ti-0.3Mo-0.8Ni)', uns: 'R53400', composition: 'CP + 0.3% Mo, 0.8% Ni', form: 'Plate, Sheet, Bar, Tube', use: 'High-temperature salt water, hot brine' },
  { family: 'High-temperature', grade: 'Ti-6Al-2Sn-4Zr-2Mo (Ti-6-2-4-2)', uns: 'R54620', composition: '6Al-2Sn-4Zr-2Mo', form: 'Plate, Sheet, Bar, Forging', use: 'Aero engine components, high-temp sections' },
];

// ── S03 Specification EAV ──────────────────────────────────────────────────
const specAttributes = [
  { attr: 'Thickness range (sheet–plate)', value: '0.5 mm (sheet) → 6.0″ (plate)', std: 'ASTM B265 §3 · ASME SB265' },
  { attr: 'Max sheet dimensions', value: 'Width 12 ft × length 50 ft', std: 'AMS 4911 · AMS 4919' },
  { attr: 'Thickness tolerance (thin sheet ≤ 0.040″)', value: '±0.0005″ typical', std: 'AMS 4911 §3.3.2' },
  { attr: 'Thickness tolerance (plate ≥ 0.1875″)', value: '±0.005″ or ±5% of nominal', std: 'ASTM B265 §9' },
  { attr: 'Surface finish (mill)', value: 'Hot-rolled, pickled, cold-rolled, polished', std: 'ASTM B265 §10 · AMS 4911 §3.4' },
  { attr: 'Flatness (plate)', value: '≤ 0.040″ / ft of length', std: 'AMS 4911 §3.3.4' },
  { attr: 'NDT (UT)', value: 'Class A1 / A2 / A3 per order', std: 'ASTM E213 · AMS-STD-2154' },
  { attr: 'NDT (RT)', value: 'Available on request for critical sections', std: 'ASTM E1417 · E1742' },
  { attr: 'Material certificate', value: 'EN 10204 3.1 (default) / 3.2 (on request)', std: 'EN 10204 §4' },
  { attr: 'First-article inspection', value: 'AS9102 FAIR (on request)', std: 'AS9102' },
];

// ── S05 Production Pipeline ────────────────────────────────────────────────
const pipeline = [
  { n: '01', title: 'Incoming Material Verification', body: 'VAR-refined titanium ingot sourced to ASTM B348 / AMS 4928 chemistry; incoming spectrometer verification before stock release.' },
  { n: '02', title: 'Hot Rolling Breakdown', body: 'Controlled heating window per grade; breakdown pass optimizes grain structure and minimizes internal soundness defects.' },
  { n: '03', title: 'Cold Rolling & Gauge Control', body: 'Multi-stand reversible mill with closed-loop laser gauge and tension control. Tolerance held per ASTM B265 §9 / AMS 4911 §3.3.' },
  { n: '04', title: 'Vacuum Annealing & Pickling', body: 'Stress relief or solution anneal per grade; acid pickling removes oxide scale and exposes base metal surface finish.' },
  { n: '05', title: 'NDT, MTR & Shipment', body: 'UT/RT executed per order spec; EN 10204 3.1 MTR issued; laser-marked lot identity preserved to piece for downstream traceability.' },
];

// ── S06 Boundary Conditions ────────────────────────────────────────────────
const boundaries = [
  { icon: '🌡️', title: 'Temperature Ceiling', body: 'Standard CP titanium and common α-β alloys are intended for service below 300–500 °C. Sustained operation above this range requires elevated-temperature grades such as Ti-6Al-2Sn-4Zr-2Mo (Ti-6-2-4-2) — confirm alloy selection before high-temperature specification.' },
  { icon: '🧪', title: 'Reducing-Acid Embrittlement', body: 'Strong reducing inorganic acids (HCl, H₂SO₄ at high concentration) and anhydrous fluoride media attack unalloyed CP titanium. Specify Grade 7 (Pd-bearing, 0.12–0.25% Pd) or Grade 12 (0.3% Mo, 0.8% Ni) for these environments to suppress hydrogen uptake.' },
  { icon: '✂️', title: 'High-Strength Alloy Springback', body: 'High-strength alloys (Ti-6Al-2Sn-4Zr-2Mo, Gr5 in cold-worked tempers) exhibit significant springback at room temperature. Warm working or heated shear / waterjet cutting recommended for tight-tolerance cut-to-shape fabrication.' },
];

// ── S09 Supply Chain & Lead Time ───────────────────────────────────────────
const supplyChain = [
  { icon: '🏭', title: 'Monthly Capacity', body: 'Baoji-sourced plate and sheet rolled in commercial-scale lots; standard inventory supports both single-piece engineering prototypes and ton-scale industrial production. Final capacity is confirmed at RFQ stage against current upstream mill schedule.' },
  { icon: '📦', title: 'MOQ Flexibility', body: 'Standard stock dimensions carry no minimum order quantity. Non-standard alloy × dimension combinations are scheduled against minimum mill batch sizes per upstream supplier. Single-piece sample pieces are available for grade-level evaluation on request.' },
  { icon: '⏱️', title: 'Lead Time Windows', body: 'Standard stock & coil slitting: 3–5 business days. Non-standard alloy × dimension combinations: 4–6 weeks. Custom rolling (gauge, width, or length not in upstream mill catalog): 6–8 weeks. Expedited engineering review is available for prototype programs.' },
];

// ── S10 Capability Comparison Matrix ───────────────────────────────────────
const comparisonRows = [
  { dim: 'Thickness / gauge control', traditional: 'Standard mill tolerance; ultra-thin coil prone to break and edge crack', ours: 'High-rigidity cluster mill with closed-loop laser gauge; foil ±0.0005″ / sheet ±0.005″' },
  { dim: 'Alloy coverage', traditional: 'Common CP Gr1/Gr2 + Gr5; limited or no Pd / ELI / Ti-6-2-4-2', ours: 'CP Gr1/2/3/4 + Gr5/Gr23/Gr7/Gr9/Gr12/Ti-6-2-4-2 + refractory-metal cross-supply' },
  { dim: 'MOQ & lead-time flexibility', traditional: 'Fixed large-lot schedule; high per-item minimum quantity', ours: 'Standard stock 3–5 days; prototype single-piece → ton-scale industrial production' },
  { dim: 'Multi-metal supply coordination', traditional: 'Single titanium supply, no cross-metal coordination', ours: 'Tantalum, niobium, zirconium, hafnium and other refractory metals coordinated alongside titanium' },
];

// ── S12 FAQ (F3: must use { question, answer } keys) ───────────────────────
// Phase G-2.1 added Q7-Q9 long-tail items: high-temperature Ti-6-2-4-2 selection,
// Gr7 vs Gr12 reducing-acid selection, AMS 4911 vs AMS 4919 plate differentiation.
const faqItems = [
  { question: 'How is surface scratch prevented on cold-rolled titanium sheet for 3C electronics stamping?', answer: 'Cold-rolled bright sheet is supplied with a dual-side protective PE/PVC lamination. Intermediate annealing reduces hardness for low-springback stamping. After blanking and stamping, the film is removed at the assembler, exposing the mirror-finish 2B / BA surface beneath.' },
  { question: 'How does Grade 7 titanium resist hydrogen embrittlement in chemical processing service?', answer: 'Grade 7 contains 0.12–0.25% palladium as an alloying addition. Under cathodic polarization, the Pd lowers the hydrogen overpotential, suppressing hydrogen-atom ingress into the titanium matrix and reducing the risk of hydrogen-induced cracking in reducing-acid service.' },
  { question: 'How is batch traceability maintained for aerospace plate conforming to AMS 4911?', answer: 'Each shipped plate is laser-marked with the upstream heat number and mill batch identity. An EN 10204 3.1 mill test certificate is issued with the shipment and includes chemical composition, tensile / yield / elongation, and UT results per ASTM E213. Independent 3.2 witnessing is available on request.' },
  { question: 'How is gauge tolerance controlled on ultra-thin titanium foil (≤ 0.0197″)?', answer: 'Multi-stand reversible cluster mill with in-line X-ray / laser gauge, closed-loop tension control, and roll-crown adjustment. Foil gauge typically held to ±0.0005″ (≈ ±0.013 mm) with slit edges deburred and the coil interleaved with neutral-pH paper for storage stability.' },
  { question: 'What is the lead-time difference between standard stock and custom-rolled plate or sheet?', answer: 'Standard plate and sheet stock in common dimensions ships in 3–5 business days. Non-standard alloy × dimension combinations require 4–6 weeks. Fully custom rolling (gauge, width, or length not in upstream mill catalog) requires 6–8 weeks. Expedited engineering review is available for prototype programs.' },
  { question: 'How should Grade 12 (Ti-0.3Mo-0.8Ni) be selected versus Grade 2 CP for chemical vessels?', answer: 'Grade 12 contains 0.2–0.4% molybdenum and 0.6–0.9% nickel, which improves resistance to crevice corrosion in hot brine, hot chloride solutions and moderate-concentration reducing media. Grade 2 remains the default for oxidizing media (nitric acid, moist chlorine) and general atmospheric exposure. Confirm service environment before final grade selection.' },
  // ──────── Phase G-2.1 · Long-tail FAQ additions ────────
  { question: 'When should Ti-6Al-2Sn-4Zr-2Mo (Ti-6-2-4-2) be selected over Ti-6Al-4V (Grade 5) for sustained high-temperature plate service above 400 °C?', answer: 'Ti-6-2-4-2 is a near-α alloy stabilized with tin (Sn) and zirconium (Zr) additions for creep resistance up to approximately 540 °C sustained service. Ti-6Al-4V (Grade 5) is conventionally specified below ~315 °C; above that range, creep deformation accelerates and a high-temperature alloy should be specified. Ti-6-2-4-2 is typically supplied in the duplex-annealed condition; specification should reference AMS 4975 (Ti-6Al-2Sn-4Zr-2Mo plate) and confirm anneal condition with the mill at RFQ.' },
  { question: 'How should Grade 7 (Ti-Pd) be selected versus Grade 12 for reducing-acid service and what MTR documentation is required?', answer: 'Grade 7 (Ti-0.12–0.25% Pd) is the primary choice for reducing inorganic acids (HCl, dilute H₂SO₄, H₃PO₄) where cathodic hydrogen evolution is the corrosion mechanism — the Pd lowers the hydrogen overpotential and suppresses hydrogen ingress / embrittlement. Grade 12 (Ti-0.3Mo-0.8Ni) is preferred for hot chloride brines, moderate reducing media, and where Pd cost is prohibitive. Both grades require MTR to confirm Pd or Mo-Ni content; EN 10204 3.2 independent witnessing is recommended for critical acid service.' },
  { question: 'What is the difference between AMS 4911 and AMS 4919 for titanium plate procurement and when is each specified?', answer: 'AMS 4911 covers Grade 5 (Ti-6Al-4V) plate, sheet and strip in the annealed condition up to 6″ thickness (UTS ≥ 895 MPa / 130 ksi). AMS 4919 covers the same alloy in the solution-treated and aged (STA) condition (UTS ≥ 1103 MPa / 160 ksi), providing higher specific strength at the cost of reduced fracture toughness and formability. Specify AMS 4911 for formed and welded aerospace structures; specify AMS 4919 only when maximum strength is required in the as-shipped condition with minimal subsequent forming or welding.' },
];

// ── S13 Related Outbound ───────────────────────────────────────────────────
const relatedLinks = [
  { title: 'All Titanium Mill Products', desc: 'Bars, tubes, wire, foil and mesh stock from one supplier.', href: '/mill-products/' },
  { title: 'Grade Library', desc: 'Grade 1 / Grade 2 / Grade 5 / Grade 23 / Ti-6-2-4-2 chemistry and datasheets.', href: '/materials/' },
  { title: 'CNC Machining Services', desc: 'Downstream 3 / 5-axis machining of plate and sheet blanks.', href: '/titanium-cnc-machining-services/' },
  { title: 'Compliance & Certifications', desc: 'AS9100D / ISO 13485 / EN 10204 3.1 evidence chain.', href: '/capabilities/compliance/' },
  { title: 'Engineering Tools', desc: 'Plate and sheet weight, tolerance, and grade-selection utilities.', href: '/tools/' },
];

// ── CollectionPage / ItemList data (auto-emitted via schema.ts) ────────────
// Phase G-2.1: removed 2 dead cross-ref entries pointing to /mill-products/foil-coils/
// (page not yet built; per F9 no fabricated URLs). Coil/foil coverage inquiries
// route through /rfq/ as the canonical intake.
const itemListItems = [
  { name: 'Titanium Plate', url: 'https://cnc.bozemetal.com/mill-products/plates-sheets/#plate' },
  { name: 'Titanium Sheet', url: 'https://cnc.bozemetal.com/mill-products/plates-sheets/#sheet' },
  { name: 'Titanium Hot-Rolled Plate', url: 'https://cnc.bozemetal.com/mill-products/plates-sheets/#hot-rolled' },
  { name: 'Titanium Cold-Rolled Sheet', url: 'https://cnc.bozemetal.com/mill-products/plates-sheets/#cold-rolled' },
];
---

<BaseLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  canonicalURL={canonicalUrl}
  pageType="standard-part-detail"
  serviceName="Titanium Plate & Sheet Mill Stock"
  serviceDescription="Industrial titanium plate and sheet stock in CP Gr1/2/3/4, aerospace Gr5 / Ti-6Al-2Sn-4Zr-2Mo, and corrosion-resistant Gr7 / Gr12. Supplied to ASTM B265 / ASME SB265 / AMS 4911 / AMS 4919 with EN 10204 3.1 / 3.2 mill certification. Standard stock 3–5 days; custom rolling 6–8 weeks."
  serviceCategory="Raw Materials > Non-Ferrous Metals > Titanium"
  collectionName="Industrial Titanium Plate & Sheet"
  collectionDescription="Precision-rolled titanium plate and sheet stock for aerospace, chemical processing, marine, heavy industrial, and pressure-vessel applications."
  itemCount={itemListItems.length}
  items={itemListItems}
  faqItems={faqItems}
  faqName="Engineering & Procurement FAQ — Titanium Plate & Sheet"
>

  <!-- ═══ S00 SubpageHero — Direct Answer ① ═══ -->
  <SubpageHero
    h1={hero.h1}
    subtitle={hero.subtitle}
    badge={hero.badge}
    keyMetrics={hero.keyMetrics}
    entityChips={hero.entityChips}
  />

  <!-- ═══ S01 What We Don't Cover — Honest Positioning ② ═══ -->
  <section class="py-16 lg:py-20" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Honest Positioning</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Where We Don't Compete</h2>
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          BOZE Metal is a sourcing and processing partner for titanium mill products, not a primary melter. The following scope clarifications are necessary for accurate technical and commercial alignment.
        </p>
      </header>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-2xl" aria-hidden="true">🛑</span>
          <h3 class="mt-3 text-lg font-bold" style="color: var(--theme-text);">No primary melting</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            Ingot / VAR / EBM melting is not in our vertically integrated scope. We source plate and sheet from upstream mills that hold the metallurgical chain-of-custody; our scope is sourcing, processing, and quality verification.
          </p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-2xl" aria-hidden="true">⚠️</span>
          <h3 class="mt-3 text-lg font-bold" style="color: var(--theme-text);">No blanket "aerospace-grade"</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            Material specifications are applied "where applicable" per order. AS9100D governs our QMS, not every shipment's classification. Confirm criticality class, specification (AMS 4911, AMS 4919, ASTM B265), and required documentation per RFQ.
          </p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-2xl" aria-hidden="true">⏱️</span>
          <h3 class="mt-3 text-lg font-bold" style="color: var(--theme-text);">No 24-hour quote promise</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            Standard quotes are returned within 1–3 business days. Non-standard alloy × dimension combinations or first-time engineering review may require additional coordination before quotation. Sample-evaluation requests follow a similar review path.
          </p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-2xl" aria-hidden="true">🔍</span>
          <h3 class="mt-3 text-lg font-bold" style="color: var(--theme-text);">No 100% traceability blanket claim</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            Material traceability is documented per order specification. EN 10204 3.1 mill test certificates are standard; 3.2 independent-witness certification is available on request. Documentation depth varies by spec and by application criticality.
          </p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-2xl" aria-hidden="true">📦</span>
          <h3 class="mt-3 text-lg font-bold" style="color: var(--theme-text);">No universal stock guarantee</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            Not every grade × thickness × width × length combination is held as standing inventory. Stock availability is confirmed at RFQ stage. Custom rolling is scheduled against upstream-mill minimum batch quantities when required.
          </p>
        </article>
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-2xl" aria-hidden="true">🚫</span>
          <h3 class="mt-3 text-lg font-bold" style="color: var(--theme-text);">No coil / foil in this sub-page</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            This sub-page covers plate and sheet forms (cold-rolled and hot-rolled). Dedicated coil, foil, strip and ultra-thin gauge (≤ 0.040″) coverage is not detailed here — submit coil / foil / strip inquiry via <a href="/rfq/" class="font-semibold underline" style="color: var(--theme-primary);">the RFQ form</a> and our team will route the requirement to the foil &amp; coil supply chain.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══ S02 Grade × Form Matrix — Structured Body ③#1 ═══ -->
  <section id="grade-matrix" class="py-16 lg:py-20" style="background: var(--theme-surface);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Grade Library</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Titanium Grade × Plate / Sheet Form Matrix</h2>
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          Plate and sheet form availability per titanium family, with UNS designation, nominal composition, and typical use. Refer to ASTM B265 for dimensional envelopes, and ASTM F67 / F136 for medical-grade specifications.
        </p>
      </header>

      <div class="mt-10 overflow-x-auto">
        <table class="w-full text-sm" style="border-collapse: collapse;">
          <thead>
            <tr style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
              <th class="text-left p-3 font-bold" style="color: var(--theme-text); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 30%, transparent);">Family</th>
              <th class="text-left p-3 font-bold" style="color: var(--theme-text); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 30%, transparent);">Grade / UNS</th>
              <th class="text-left p-3 font-bold" style="color: var(--theme-text); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 30%, transparent);">Nominal Composition</th>
              <th class="text-left p-3 font-bold" style="color: var(--theme-text); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 30%, transparent);">Plate / Sheet Form</th>
              <th class="text-left p-3 font-bold" style="color: var(--theme-text); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 30%, transparent);">Typical Use</th>
            </tr>
          </thead>
          <tbody>
            {gradeMatrix.map((g, i) => (
              <tr style={i % 2 === 0 ? 'background: color-mix(in srgb, var(--theme-primary) 3%, transparent);' : ''}>
                <td class="p-3 font-semibold" style="color: var(--theme-text); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">{g.family}</td>
                <td class="p-3" style="color: color-mix(in srgb, var(--theme-text) 80%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                  <span class="font-mono font-semibold" style="color: var(--theme-primary);">{g.grade}</span>
                  <span class="block text-xs" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">UNS {g.uns}</span>
                </td>
                <td class="p-3" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">{g.composition}</td>
                <td class="p-3" style="color: color-mix(in srgb, var(--theme-text) 80%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">{g.form}</td>
                <td class="p-3" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">{g.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">Reference: ASTM B265 §4 (plate/sheet/strip composition), ASTM F67 (unalloyed surgical implant), ASTM F136 (Ti-6Al-4V ELI surgical implant), AMS 4911 / AMS 4919 / AMS 4928 / AMS 4965 / AMS 4943 / AMS 4944.</p>
    </div>
  </section>

  <!-- ═══ S03 Specification EAV — Structured Body ③#2 ═══ -->
  <section id="specifications" class="py-16 lg:py-20" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Specifications</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">Specification Envelope</h2>
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
