            <article class="rounded-2xl border p-6 lg:p-8" style="background: var(--theme-surface); border-color: color-mix(in srgb, #dc2626 18%, transparent);">
              <div class="flex items-start gap-3 mb-3">
                <svg class="h-5 w-5 shrink-0 mt-0.5" style="color: #dc2626;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M4.93 4.93l14.14 14.14M12 2a10 10 0 100 20 10 10 0 000-20z" />
                </svg>
                <h3 class="text-base font-bold" style="color: var(--theme-text);">{w.topic}</h3>
              </div>
              <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{w.reason}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 14 FAQ (§25 — 8 questions, faqItems auto-emits FAQPage JSON-LD) -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <section class="py-16 lg:py-24" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Frequently Asked Questions</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
          Titanium Mill Products FAQ
        </h2>
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          Common questions from procurement engineers, sourcing managers and QA teams specifying titanium mill stock for aerospace, medical, chemical and industrial programs.
        </p>
      </header>

      <div class="mt-12 max-w-4xl space-y-4">
        {
          faqItems.map((f, i) => (
            <details class="group rounded-2xl border" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
              <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5">
                <span class="flex items-start gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">{i + 1}</span>
                  <span class="text-base font-bold leading-snug" style="color: var(--theme-text);">{f.question}</span>
                </span>
              </summary>
              <div class="px-6 pb-6 pl-[4.5rem]">
                <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{f.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 15 RFQ CTA (§26)                                                -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 opacity-25" aria-hidden="true">
      <div class="absolute inset-0" style="background: radial-gradient(circle at 50% 100%, color-mix(in srgb, var(--theme-primary) 30%, transparent) 0%, transparent 55%);"></div>
    </div>
    <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="mx-auto max-w-4xl rounded-3xl border p-8 text-center lg:p-12" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 22%, transparent);">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Request a Quote</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
          Request a Titanium Mill Products Quote
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          Tell us what titanium material you need. Our team can review your product form, grade, dimensions, specification, quantity and documentation requirements before preparing a quotation.
        </p>

        <div class="mt-8 grid gap-4 md:grid-cols-2 text-left max-w-2xl mx-auto">
          <div class="rounded-xl border p-4" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <p class="text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--theme-primary);">Contact</p>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Name · Company · Business Email · Country / Region</p>
          </div>
          <div class="rounded-xl border p-4" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <p class="text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--theme-primary);">Requirement</p>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Product Form · Titanium Grade · Standard · Dimensions · Quantity · Delivery Date</p>
          </div>
          <div class="rounded-xl border p-4" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <p class="text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--theme-primary);">Certification</p>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Material Certificate Required · Inspection Requirements · Special Documentation</p>
          </div>
          <div class="rounded-xl border p-4" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <p class="text-xs font-semibold uppercase tracking-wider mb-1" style="color: var(--theme-primary);">Drawing Upload</p>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">PDF / DWG / STEP / STP / XLSX / DOCX (per site capability)</p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/rfq/" class="inline-flex items-center gap-2 rounded-xl px-8 py-4 text-base font-bold text-white shadow-lg" style="background: linear-gradient(135deg, #ff8a3d 0%, #ff5a00 100%);">
            Request a Technical Quote
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
          <a href="/rfq/" class="inline-flex items-center gap-2 rounded-xl border px-8 py-4 text-base font-bold" style="border-color: var(--theme-primary); color: var(--theme-primary);">
            Send Material Specification
          </a>
        </div>

        <p class="mt-6 text-xs leading-relaxed max-w-xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          We will review your requirement and respond with the appropriate material and quotation information.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>