const itemListEntries = productForms.map((p) => ({ name: p.name, url: `${canonicalUrl}#${p.slug}` }));
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalUrl}
  pageType="products-hub"
  collectionName="Titanium Mill Products Collection"
  collectionDescription={pageDescription}
  itemCount={productForms.length}
  items={itemListEntries}
  serviceName="Titanium Mill Products Procurement Service"
  serviceDescription="Procurement, sourcing, traceability and value-added processing for titanium bar, plate, sheet, tube, pipe, wire, foil, coil and mesh stock."
  serviceCategory="Titanium Mill Products Procurement"
  faqItems={faqItems}
  faqName="Titanium Mill Products — Frequently Asked Questions"
  articleHeadline="Titanium Mill Products Hub — Procurement Reference for B2B Buyers"
  articleDatePublished="2026-10-06"
  articleAuthor="BOZE CNC Ti Engineering Team"
>
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 01 Hero (SubpageHero · HERO_CONFIG-driven)                      -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <SubpageHero
    h1={hero.h1}
    subtitle={hero.subtitle}
    badge={hero.badge}
    keyMetrics={hero.keyMetrics}
    entityChips={hero.entityChips}
  />

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 02 Product Forms (6 forms · Product Entity Gateway cards)       -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <section class="py-16 lg:py-24" style="background: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Product Forms</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
          Six Titanium Mill Product Forms
        </h2>
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          BOZE Metal supplies titanium mill products in multiple forms, grades and specifications for manufacturing and further fabrication. Each form below is a gateway to the applicable materials, standards, typical dimensions and downstream processing options — review the form most relevant to your application, or submit your specification directly for a tailored quote.
        </p>
      </header>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          productForms.map((p) => (
            <article id={p.slug} class="rounded-2xl border p-6 lg:p-8" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
              <div class="flex items-start gap-3 mb-4">
                <span class="text-3xl" aria-hidden="true">{p.icon}</span>
                <h3 class="text-xl font-bold" style="color: var(--theme-text);">{p.name}</h3>
              </div>
              <p class="text-sm leading-relaxed mb-4" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{p.summary}</p>

              <div class="space-y-3">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary);">Forms</p>
                  <p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{p.forms.join(' · ')}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary);">Common Grades</p>
                  <p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{p.commonGrades.join(' · ')}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary);">Typical Standards</p>
                  <p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{p.commonStandards.join(' · ')}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary);">Typical Applications</p>
                  <p class="text-sm mt-1" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{p.typicalApplications.join(' · ')}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-primary);">Available Material Reference</p>
                  <p class="text-sm mt-1">
                    <a href={p.href} class="underline underline-offset-4 font-semibold" style="color: var(--theme-primary);">View {p.name.replace('Titanium ', '')} grades →</a>
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- "Need a specific form?" connector to RFQ -->
      <div class="mt-12 rounded-2xl border p-6 lg:p-8 text-center" style="background: color-mix(in srgb, var(--theme-primary) 4%, var(--theme-surface)); border-color: color-mix(in srgb, var(--theme-primary) 22%, transparent);">
        <h3 class="text-xl font-bold mb-2" style="color: var(--theme-text);">Need a Specific Titanium Form or Size?</h3>
        <p class="text-sm leading-relaxed mb-5 max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
          If you do not see the required titanium form, grade or dimension above, send us your material specification, drawing or purchasing requirement. BOZE Metal can review non-standard requirements and identify the appropriate material and processing route.
        </p>
        <a href="/rfq/" class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-bold text-white shadow-lg" style="background: linear-gradient(135deg, #ff8a3d 0%, #ff5a00 100%);">
          Send Your Specification
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 03 Titanium Grades (5-grade table, §13 honest wording)           -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <section class="py-16 lg:py-24" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <header class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Titanium Grades</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
