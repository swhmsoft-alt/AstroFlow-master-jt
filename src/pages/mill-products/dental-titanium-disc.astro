const relatedLinks = [
  { title: 'All Titanium Mill Products', desc: 'Ingots, bars, plates, tubes, wire, foil, mesh and dental discs from one sourcing partner.', href: '/mill-products/' },
  { title: 'Titanium Bar & Rod Stock', desc: 'The upstream stock for laboratories that cut their own blanks in-house.', href: '/mill-products/bars-rods/' },
