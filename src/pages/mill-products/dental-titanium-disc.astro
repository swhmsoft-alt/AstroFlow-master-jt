const itemListItems = [
  { name: 'Dental Titanium Disc 98 mm CAD-CAM — Product Specification', url: 'https://cnc.bozemetal.com/mill-products/dental-titanium-disc/#product' },
  { name: 'Open System Titanium Disc Blank 98 mm', url: 'https://cnc.bozemetal.com/mill-products/dental-titanium-disc/#interface-matrix' },
