---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalUrl}
  pageType="standard-part-detail"
  serviceName="Dental Titanium CAD/CAM Disc Blanks"
  serviceDescription="Dental titanium disc blanks for CAD/CAM milling centres, in commercially pure Grade 1 / 2 / 3 / 4 to ASTM F67 and ISO 5832-2 and Grade 23 Ti-6Al-4V ELI to ASTM F136 and ISO 5832-3. Open-system 98 mm with central register step, Zirkonzahn 95 mm and Amann Girrbach 89 mm with side notch. Vacuum annealed for residual stress relief, EN 10204 3.1 certification with heat-level batch traceability, manufactured under an ISO 13485:2016-certified authorised contract manufacturing partner."
  serviceCategory="Raw Materials, Non-Ferrous Metals, Titanium"
  collectionName="Dental Titanium CAD/CAM Disc Blanks"
  collectionDescription="Titanium disc blanks machined to dental CAD/CAM chuck interfaces, in CP Grade 1-4 and Grade 23 Ti-6Al-4V ELI, supplied with chemistry control, vacuum annealing, dimensional inspection and heat-level material traceability."
  itemCount={itemListItems.length}
  items={itemListItems}
  faqItems={faqItems}
  faqName="Engineering and Procurement FAQ, Dental Titanium Disc Blanks"
  productDeliveryLeadTime="Quotation-specific"
>

  <SubpageHero h1={hero.h1} subtitle={hero.subtitle} badge={hero.badge} keyMetrics={hero.keyMetrics} entityChips={hero.entityChips} />

  <section id="product" class="py-16 lg:py-20" style="background: var(--theme-surface);">
