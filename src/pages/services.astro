---
/**
 * src/pages/services.astro — Services Hub
 *
 * Trinity Audit (P0 fixes 2026-09-10):
 *   Buyer: awareness / pain / cost / time / file / risk / rfq / comparison / capacity / faq
 *   EEAT:  experience / years / standards / cert / external / team / source / freshness / unique / proprietary
 *   AI:    schemaOrg / product / article / faqHtml / realTable / bestFor / headingNumbered
 *
 * Architectural notes:
 *   - pageType="services-hub" + serviceName → schema.ts injects Service + Product + Article
 *     entities via the F4 case added in buildPageGraph (services-hub branch).
 *   - faqItems / howtoItem → FAQPage + HowTo JSON-LD via BaseLayout.
 *   - mentions → entity-graph @id refs (Service / Material / Standard / Industry / Product).
 *   - All <a href> use literal project-relative paths (no undefined interpolation).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../config/hero';
import ServiceMatrixGrid from '../components/services/ServiceMatrixGrid.astro';
import ComplianceRibbon from '../components/services/ComplianceRibbon.astro';
import EngineeringWorkflow from '../components/services/EngineeringWorkflow.astro';
import QuickIndustrySolutions from '../components/services/QuickIndustrySolutions.astro';
import ServicesPainAndValue from '../components/services/ServicesPainAndValue.astro';
import LeadTimeAndCapacity from '../components/services/LeadTimeAndCapacity.astro';
import CostAndRisk from '../components/services/CostAndRisk.astro';
import ServicesFaq from '../components/services/ServicesFaq.astro';
import PartsPromoBanner from '../components/parts/PartsPromoBanner.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { FaqItem, HowToItem } from '../lib/schema';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// F4 — Service schema (services-hub → buildService)
const serviceName = 'Titanium CNC Manufacturing Services';
const serviceDescription = 'End-to-end titanium CNC machining, fabrication, additive manufacturing, and surface treatment for aerospace, medical, marine, and energy — AS9100D-certified, 12+ years in titanium.';
const serviceCategory = 'Precision Manufacturing';

// NOTE (Phase 2B, 2026-09-12): Product entity removed from services hub.
// Per the Page Type → Entity Type governance matrix, /services/ is a Service hub
// (CollectionPage + ItemList of Services). Emitting a Product on a hub page
// triggered GSC's retail-Product enhancement check and created a competing
// primary entity (Service "Titanium CNC Manufacturing Services" vs Product
// "Custom Titanium CNC Parts") — see docs/schema-audit/schema-issues.md P0-1.
// The Custom Titanium CNC Parts concept is correctly modeled on the per-part
// detail pages (/products/titanium-cnc-parts/, /products/product-entities/.../).

// F4 — Article schema (EEAT.proprietaryFrame hook → drives JSON-LD Article)
const articleHeadline = 'BOZE 5-Pillar DFM Framework™ for Titanium Manufacturing';
const articleAuthor = 'BOZE CNC Ti Engineering Team';
const articleDatePublished = '2026-09-10';

// F4 — FAQPage JSON-LD (8 entries → FAQ schema + real HTML <details>)
const faqItems: FaqItem[] = [0,1,2,3,4,5,6,7].map((i) => ({
  question: t(`services.faq.q${i}.q`),
  answer: t(`services.faq.q${i}.a`),
}));

// F4 — HowTo schema (mirrors existing EngineeringWorkflow 4 steps)
const howtoItem: HowToItem = {
  name: 'How to Order Custom Titanium CNC Parts from BOZE',
  description: 'Four-step B2B workflow from RFQ submission to on-time delivery — covering DFM, engineering, production, and final QA.',
  totalTime: 'P14D',
  steps: [
    { name: t('services.workflow.step0.title'), text: t('services.workflow.step0.desc'), position: 1 },
    { name: t('services.workflow.step1.title'), text: t('services.workflow.step1.desc'), position: 2 },
    { name: t('services.workflow.step2.title'), text: t('services.workflow.step2.desc'), position: 3 },
    { name: t('services.workflow.step3.title'), text: t('services.workflow.step3.desc'), position: 4 },
  ],
};
---

<BaseLayout
  pageType="services-hub"
  serviceName={serviceName}
  serviceDescription={serviceDescription}
  serviceCategory={serviceCategory}
  articleHeadline={articleHeadline}
  articleDescription={serviceDescription}
  articleAuthor={articleAuthor}
  articleDatePublished={articleDatePublished}
  faqItems={faqItems}
  faqName="Titanium CNC Manufacturing Services — Frequently Asked Questions"
  howtoItem={howtoItem}
  serviceHubKey="master-service"
  mentions={[
    'service:master-services',
    'service:titanium-cnc-machining-services',
    'service:titanium-additive-manufacturing',
    'service:titanium-fabrication-services',
    'service:titanium-forming-heavy-manufacturing',
    'service:titanium-surface-treatment',
    'material:astm-b348-titanium-grade-5',
    'material:astm-b348-titanium-grade-2',
    'standard:as9100d',
    'standard:iso-9001-2015',
    'standard:iso-13485-2016',
    'standard:astm-b348',
    'standard:ams-4928',
    'industry:aerospace',
    'industry:medical',
    'industry:marine',
    'industry:semiconductor',
    'industry:energy',
  ]}
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <SubpageHero
    h1={HERO_CONFIG['/services'].h1}
    badge={HERO_CONFIG['/services'].badge}
    subtitle={HERO_CONFIG['/services'].subtitle}
    badgeIcon="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z"
    keyMetrics={HERO_CONFIG['/services'].keyMetrics}
    entityChips={HERO_CONFIG['/services'].entityChips}
    compact={HERO_CONFIG['/services'].compact}
  />

  <!-- F4 — Section 01–02: Buyer awareness + pain identification + EEAT signal strip -->
  <ServicesPainAndValue />

  <!-- Service Matrix Grid (existing — 7 service pillars) -->
  <ServiceMatrixGrid />

  <!-- F4 — Compliance Ribbon extended with real cert list, standards, external links, freshness, source -->
  <ComplianceRibbon />

  <!-- F4 — Section 03–04: Lead-time table + capacity lock (Buyer timeDecision + capacityLock) -->
  <LeadTimeAndCapacity />

  <!-- F4 — Section 05–10: Cost drivers + Risk + DFM file checklist + 5-Pillar framework + Comparison + RFQ decision -->
  <CostAndRisk />

  <!-- Engineering Workflow (existing — HowTo schema source) -->
  <EngineeringWorkflow />

  <!-- Quick Industry Solutions (existing — 8 industry cards) -->
  <QuickIndustrySolutions />

  <!-- F4 — Section 11: FAQ HTML pattern (real <details>, FAQPage schema via BaseLayout faqItems) -->
  <ServicesFaq />

  <PartsPromoBanner />
</BaseLayout>