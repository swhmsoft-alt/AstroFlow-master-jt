---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudienceHub from '../../components/audience/AudienceHub.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import WaterjetAdvantages from '../../components/services/WaterjetAdvantages.astro';
import WaterjetSpecsDashboard from '../../components/services/WaterjetSpecsDashboard.astro';
import TaperStriationKnowHow from '../../components/services/TaperStriationKnowHow.astro';
import WaterjetDedicatedCta from '../../components/services/WaterjetDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout title={t('titanium-fabrication-services.waterjetCutting.waterjet_cutting_boze_cnc_ti')} description="Precision abrasive waterjet cutting for titanium: 60,000 PSI, 120 mm thickness capacity, 3,000 x 2,000 mm bed, ±0.05 mm angular repeatability, zero HAZ.">
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-fabrication-services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services.titaniumFabricationServices')}</span>
          </a>
          <meta itemprop="position" content="3" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.waterjetCutting')}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>
  <SubpageHero
    title={t('titanium-fabrication-services.waterjetCutting.waterjet_cutting')}
    highlight="Services"
    badge="Precision Waterjet Cutting"
    badgeIcon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
    subtitle="Cold abrasive waterjet cutting for titanium — from thin sheets to 120 mm thick forgings — with zero HAZ, no thermal distortion, and near-perpendicular edge profiles."
  
    keyMetrics={HERO_CONFIG['/titanium-fabrication-services/waterjet-cutting']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-fabrication-services/waterjet-cutting']?.entityChips}
  />

  <!-- Waterjet Cutting Process Advantages — 3-column grid -->
  <WaterjetAdvantages />

  <!-- Waterjet Performance Dashboard — 4-column specs -->
  <WaterjetSpecsDashboard />

  <!-- Taper & Striation Elimination Know-How — 2-column -->
  <TaperStriationKnowHow />

  <!-- Dedicated CTA — Waterjet Assessment -->
  <WaterjetDedicatedCta />
<AudienceHub industry="fabrication" />
</BaseLayout>