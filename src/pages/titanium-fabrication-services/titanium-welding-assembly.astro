---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudienceHub from '../../components/audience/AudienceHub.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import WeldingAssemblySpectrum from '../../components/services/WeldingAssemblySpectrum.astro';
import AssemblySpecsDashboard from '../../components/services/AssemblySpecsDashboard.astro';
import BrittleGallingControlKnowHow from '../../components/services/BrittleGallingControlKnowHow.astro';
import AssemblyDedicatedCta from '../../components/services/AssemblyDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout title={t('titanium-fabrication-services.titaniumWeldingAssembly.titanium_welding_assembly_boze_cnc')} description="Precision titanium welding and assembly: ultra-pure TIG, laser welding, multi-component system assembly with anti-galling and CMM verification. AWS D1.6, AS9100D.">
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-fabrication-services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services.titaniumFabricationServices')}</span>
          </a>
          <meta itemprop="position" content="3" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.titaniumWeldingAssembly')}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>
  <SubpageHero
    title={t('titanium-fabrication-services.titaniumWeldingAssembly.titanium_welding_assembly')}
    highlight="Services"
    badge="Precision Welding & Assembly"
    badgeIcon="M13 10V3L4 14h7v7l9-11h-7z"
    subtitle="From ultra-pure TIG welding with triple-argon shielding to high-penetration laser welding and full multi-component system assembly — delivering mission-critical titanium structures meeting AWS D1.6 and AS9100D standards."
  
    keyMetrics={HERO_CONFIG['/titanium-fabrication-services/titanium-welding-assembly']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-fabrication-services/titanium-welding-assembly']?.entityChips}
  />

  <!-- Welding & Assembly Process Spectrum — 3-column grid -->
  <WeldingAssemblySpectrum />

  <!-- Welding & Assembly Specifications Dashboard — 4-column -->
  <AssemblySpecsDashboard />

  <!-- Brittle Layer & Galling Control Engineering — 2-column -->
  <BrittleGallingControlKnowHow />

  <!-- Dedicated CTA — PQR & Commercial Assessment -->
  <AssemblyDedicatedCta />
<AudienceHub industry="fabrication" />
</BaseLayout>