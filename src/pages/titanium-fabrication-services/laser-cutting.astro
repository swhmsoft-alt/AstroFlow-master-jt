---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import LaserProcessSpectrum from '../../components/services/LaserProcessSpectrum.astro';
import LaserSpecsDashboard from '../../components/services/LaserSpecsDashboard.astro';
import OxideSlagMitigation from '../../components/services/OxideSlagMitigation.astro';
import LaserDedicatedCta from '../../components/services/LaserDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { HERO_CONFIG } from '../../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout title={t('titanium-fabrication-services.laserCutting.laser_cutting_sheet_tube_boze')} description="Precision fiber laser cutting for titanium sheets and tubes: 3,000 x 1,500 mm sheet capacity, ø 20-220 mm tube, ±0.03 mm accuracy, 0.1 mm kerf, weld-ready edges.">
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/titanium-fabrication-services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services.titaniumFabricationServices')}</span>
          </a>
          <meta itemprop="position" content="3" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.laserCutting')}</span>
          <meta itemprop="position" content="4" />
        </li>
      </ol>
    </div>
  </nav>
  <SubpageHero
    title={t('titanium-fabrication-services.laserCutting.laser_cutting_sheet_tube')}
    highlight="Services"
    badge="Precision Laser Cutting"
    badgeIcon="M13 10V3L4 14h7v7l9-11h-7z"
    subtitle="High-kilowatt fiber laser cutting for titanium sheets and tubes — from 2D flat plate profiling to complex 3D rotary tube machining with oxide-free, weld-ready edges."
  
    keyMetrics={HERO_CONFIG['/titanium-fabrication-services/laser-cutting']?.keyMetrics}
    entityChips={HERO_CONFIG['/titanium-fabrication-services/laser-cutting']?.entityChips}
  />

  <!-- Sheet & Tube Laser Process Spectrum — 2-column -->
  <LaserProcessSpectrum />

  <!-- Laser Cutting Specifications Dashboard — 4-column -->
  <LaserSpecsDashboard />

  <!-- Oxide & Slag Mitigation Protocols — 2-column -->
  <OxideSlagMitigation />

  <!-- Dedicated CTA — Laser Nesting & Quote -->
  <LaserDedicatedCta />
</BaseLayout>