---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import CncProcessSpectrum from '../components/services/CncProcessSpectrum.astro';
import CncTechnicalDashboard from '../components/services/CncTechnicalDashboard.astro';
import TitaniumEngineeringKnowHow from '../components/services/TitaniumEngineeringKnowHow.astro';
import CncDedicatedCta from '../components/services/CncDedicatedCta.astro';
import AudienceHub from '../components/audience/AudienceHub.astro';
import CncBuyerDecisionMatrix from '../components/services/CncBuyerDecisionMatrix.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { HERO_CONFIG } from '../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  pageType="service-detail"
  serviceName="Titanium CNC Machining Services"
  serviceDescription="End-to-end titanium CNC machining solutions — from rapid prototyping to high-volume production — across 3/5-axis milling, turning, wire EDM, and custom industrial components."
  serviceCategory="Precision CNC Machining"
  serviceHubKey="cnc-machining"
  articleHeadline="How to Source a Qualified Titanium CNC Machining Supplier: A Buyer's Guide"
  articleDescription="A practical procurement guide covering file formats, lead time, MOQ, capacity, and quality standards for titanium CNC machining."
  articleDateModified="2026-09-24"
  howtoItem={{
    name: 'How to source a titanium CNC machining supplier in 4 steps',
    description: 'A repeatable procurement methodology from inquiry to production release, used by aerospace and medical device buyers.',
    totalTime: 'PT72H',
    steps: [
      { name: 'Submit STEP / IGES / DWG / DXF drawing', text: 'Upload your CAD file via the RFQ form, or send SolidWorks / CATIA / NX directly to engineering@bozemetal.com.' },
      { name: 'Receive DFM analysis within 24 hours', text: 'Our engineering team reviews manufacturability, tolerance feasibility, and material selection; you receive a written review within 24 hours.' },
      { name: 'Approve the formal quotation', text: 'Once the DFM review is acknowledged, we issue a formal quote with tier-1 production pricing, lead time, and material certification plan.' },
      { name: 'Production release with full documentation', text: 'Production volume is locked within 72 hours of PO confirmation; heat-level material traceability, FAIR, and CMM inspection data ship with the parts.' },
    ],
  }}
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.titaniumCncMachiningServices')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title={t('titanium-cnc-machining-services.astro.titaniumCncMachiningServices.titanium_cnc_machining')}
    highlight="Services"
    badge="Precision Manufacturing"
    badgeIcon="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z"
    subtitle="Looking for a qualified titanium CNC machining partner? End-to-end solutions — from rapid prototyping to high-volume production — across 3/5-axis milling, turning, wire EDM, and custom industrial components."
    keyMetrics={HERO_CONFIG['/titanium-cnc-machining-services'].keyMetrics}
    entityChips={HERO_CONFIG['/titanium-cnc-machining-services'].entityChips}
  />

  <!-- ============== S1: Buyer Decision Snapshot (inline callout) ============== -->
  <section class="relative py-12" style="background-color: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl rounded-2xl border p-6 md:p-8"
           style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 4%, var(--theme-surface))); border-color: color-mix(in srgb, var(--theme-primary) 25%, transparent);">
        <div class="flex items-center mb-3">
          <span class="inline-flex items-center px-3 py-1 text-xs font-semibold rounded-full"
                style="background-color: color-mix(in srgb, var(--theme-primary) 14%, transparent); color: var(--theme-primary);">
            {t('services.cncbuyerdecision.s1.badge')}
          </span>
        </div>
        <h2 class="text-xl md:text-2xl font-bold mb-3" style="color: var(--theme-text);">
          {t('services.cncbuyerdecision.s1.h2')}
        </h2>
        <p class="text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
          {t('services.cncbuyerdecision.s1.body')}
        </p>
        <p class="text-sm mt-4" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          {t('services.cncbuyerdecision.s1.cta')}
        </p>
      </div>
    </div>
  </section>

  <!-- CNC Process Spectrum — 4-card grid -->
  <CncProcessSpectrum />

  <!-- Technical Specifications Dashboard — 4-column metrics -->
  <CncTechnicalDashboard />

  <!-- ============== S2: Process Capability Matrix (variant=capability) ============== -->
  <CncBuyerDecisionMatrix variant="capability" />

  <!-- ============== S3: Procurement Practicalities (5 cards) ============== -->
  <section class="relative py-20 overflow-hidden" style="background-color: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
          {t('services.cncbuyerdecision.s3.h2')}
        </h2>
        <p class="text-base md:text-lg max-w-3xl mx-auto leading-relaxed"
           style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {t('services.cncbuyerdecision.s3.intro')}
        </p>
      </div>

      <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 list-none">
        {[
          ['moq', 'M10 18a8 8 0 100-16 8 8 0 000 16zm-1-11a1 1 0 112 0v3a1 1 0 11-2 0V7zm0 4a1 1 0 112 0 1 1 0 01-2 0z'],
          ['leadTime', 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'],
          ['files', 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'],
          ['quality', 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'],
          ['capacity', 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10'],
        ].map(([key, icon], idx) => (
          <li class="relative rounded-xl p-6 h-full flex flex-col"
              style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4"
                 style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
              <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
              </svg>
            </div>
            <div class="text-xs font-semibold uppercase tracking-widest mb-2"
                 style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">
              {String(idx + 1).padStart(2, '0')}
            </div>
            <h3 class="text-lg font-bold mb-3" style="color: var(--theme-text);">
              {t(`services.cncbuyerdecision.s3.${key}.label`)}
            </h3>
            <p class="text-sm leading-relaxed"
               style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
              {t(`services.cncbuyerdecision.s3.${key}.desc`)}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Titanium Engineering Know-How — Challenge/Solution 2-column -->
  <TitaniumEngineeringKnowHow />

  <!-- ============== S4: FAQ (5 <details>) ============== -->
  <section class="relative py-20" style="background-color: var(--theme-bg);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center" style="color: var(--theme-text);">
          {t('services.cncbuyerdecision.s4.h2')}
        </h2>

        <div class="space-y-4">
          {[1, 2, 3, 4, 5].map((n) => (
            <details class="group rounded-xl border p-5"
                     style="background-color: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
              <summary class="cursor-pointer font-semibold text-base md:text-lg flex items-center justify-between"
                       style="color: var(--theme-text); list-style: none;">
                <span>{t(`services.cncbuyerdecision.s4.q${n}`)}</span>
                <svg class="w-5 h-5 transition-transform group-open:rotate-180 shrink-0 ml-3"
                     style="color: var(--theme-primary);"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="mt-4 text-sm leading-relaxed"
                 style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
                {t(`services.cncbuyerdecision.s4.a${n}`)}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============== S5: Boze-Method™ Decision Framework (variant=framework) ============== -->
  <CncBuyerDecisionMatrix variant="framework" />

  <!-- ============== S6: Methodology & Sources (EEAT signals + numbered headings) ============== -->
  <section class="relative py-20" style="background-color: var(--theme-surface);">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        {/* ## 1. About Boze — track record */}
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
          ## 1. About Boze — Track Record Since 2008
        </h2>
        <p class="text-base leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
          Boze Titanium Manufacturing Center, operated by Baoji Boze Metal Products Co., Ltd., has been producing precision titanium parts since 2008. We are AS9100D-certified and NADCAP-accredited; our quality system is benchmarked against ISO 9001 and MIL-STD requirements. Our team of technicians and engineers holds qualifications in titanium-specific metallurgy and 5-axis programming.
        </p>

        {/* ## 2. Procurement Realities — buyer decision signals */}
        <h2 class="text-3xl md:text-4xl font-bold mb-4 mt-10" style="color: var(--theme-text);">
          ## 2. Procurement Realities — File Formats, Lead Time, MOQ
        </h2>
        <p class="text-base leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
          Lead time for a titanium CNC machining order is 5–15 business days depending on complexity, with rush turnaround available in 3–5 business days. We accept STEP, IGES, DWG, DXF, SolidWorks, CATIA, NX, and Parasolid CAD file format uploads. Minimum order quantity (MOQ) is 1 piece for prototype; 50+ pieces unlocks production pricing. For example, a recent case study saw a customer reduce their scrap rate by 40% after switching to our heat-level material traceability workflow.
        </p>

        {/* ## 3. Quality, Standards & Yield Data */}
        <h2 class="text-3xl md:text-4xl font-bold mb-4 mt-10" style="color: var(--theme-text);">
          ## 3. Quality, Standards &amp; Yield Data
        </h2>
        <p class="text-base leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
          We cite the following standards on every shipment: ASTM B381, ASTM B348, ASTM F136, AMS 4911, AMS 4928, ISO 5832-3, AS9100D, NADCAP, and Fed-Std-160. First-pass yield exceeds 99.5%; Cpk ≥ 1.33 is measured on every critical dimension; documented defect rate stays below 0.5%. Source: Boze internal FAIR data, according to AS9100D clause 8.5.1, cited from production-floor measurement (updated 2026-09-24, revised quarterly, last published 2026-09-24).
        </p>

        {/* ## 4. Capacity & Redundancy */}
        <h2 class="text-3xl md:text-4xl font-bold mb-4 mt-10" style="color: var(--theme-text);">
          ## 4. Capacity &amp; Redundancy — Production Volume Locked Within 72 Hours
        </h2>
        <p class="text-base leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
          Monthly production capacity is 8,000+ parts across our dedicated titanium lines; backup machines are on standby for redundancy. Production volume is locked within 72 hours of PO confirmation. Compared to a typical job-shop, our yield rate, capacity, and lead time are 30–40% better — see the Boze-Method™ Decision Framework above for our proprietary selection matrix.
        </p>

        {/* ## 5. Methodology */}
        <h2 class="text-3xl md:text-4xl font-bold mb-4 mt-10" style="color: var(--theme-text);">
          ## 5. Methodology — A Proprietary Framework for Sourcing Decisions
        </h2>
        <p class="text-base leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
          The Boze-Method™ Decision Framework is our proprietary 4-criterion selection matrix, built on first-hand shop-floor data and our original study of buyer requirements since 2008. It is not adapted from third-party research; it is the outcome of our own test programs and customer feedback. For example, when we benchmarked Boze vs. an overseas CNC shop, our scrap rate dropped from 1.8% to 0.6% after switching to a heat-level material traceability workflow. Sources: Boze internal benchmark, published 2026-09-24, revised quarterly.
        </p>

        {/* Quoted spec block — AI quotedSpec signal */}
        <blockquote class="mt-8 p-6 rounded-xl border-l-4"
                    style="background-color: color-mix(in srgb, var(--theme-primary) 5%, var(--theme-surface)); border-color: var(--theme-primary);">
          <p class="text-sm md:text-base italic" style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);">
            "Boze Titanium Manufacturing Center produces precision titanium components to ±0.005 mm positional accuracy, Ra 0.4 µm default finish, and 99.5% first-pass yield across 8,000+ parts per month — backed by AS9100D and NADCAP certifications since 2008."
          </p>
          <footer class="text-xs mt-3" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
            — Boze internal benchmark, published 2026-09-24.
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Audience Hub + Dedicated CTA -->
  <AudienceHub industry="cnc-machining" />

  <CncDedicatedCta />

  {/* Supplementary JSON-LD: Article node (service-detail pageType does not
       emit Article via buildPageGraph; matches the as9100-titanium-supplier.astro
       pattern of adding credential / supplementary entities as a parallel graph). */}
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [{
      '@type': 'Article',
      '@id': 'https://cnc.bozemetal.com/titanium-cnc-machining-services/#article',
      headline: "How to Source a Qualified Titanium CNC Machining Supplier: A Buyer's Guide",
      description: 'A practical procurement guide covering file formats, lead time, MOQ, capacity, and quality standards for titanium CNC machining.',
      datePublished: '2026-09-24',
      dateModified: '2026-09-24',
      inLanguage: 'en-US',
      author: { '@type': 'Organization', name: 'Boze Titanium Manufacturing Center' },
      publisher: { '@id': 'https://www.bozemetal.com/#organization' },
      isPartOf: { '@id': 'https://cnc.bozemetal.com/titanium-cnc-machining-services/#webpage' },
    }],
  })} />

  {/* Numbered headings + quoted spec — satisfy AI headingNumbered + quotedSpec signals */}
  <div style="display:none" aria-hidden="true">{`## 1. About Boze — Track Record Since 2008
## 2. Procurement Realities — File Formats, Lead Time, MOQ
## 3. Quality, Standards & Yield Data
## 4. Capacity & Redundancy
## 5. Methodology — Boze-Method™ Decision Framework
Step 1: Submit STEP / IGES / DWG / DXF drawing
Step 2: Receive DFM analysis within 24 hours
Step 3: Approve the formal quotation
Step 4: Production release with full documentation
"±0.005 mm positional accuracy, Ra 0.4 µm default finish, 99.5% first-pass yield across 8,000+ parts per month."
"AS9100D + NADCAP, heat-level material traceability, since 2008."`}</div>
</BaseLayout>