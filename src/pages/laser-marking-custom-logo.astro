---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import MarkingProcessSpectrum from '../components/services/MarkingProcessSpectrum.astro';
import MarkingSpecsDashboard from '../components/services/MarkingSpecsDashboard.astro';
import ThermalStressContrastKnowHow from '../components/services/ThermalStressContrastKnowHow.astro';
import MarkingDedicatedCta from '../components/services/MarkingDedicatedCta.astro';
---
<BaseLayout>
  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title="Laser Marking & Custom Logo"
    highlight="Services"
    badge="Laser Personalization & Traceability"
    badgeIcon="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
    subtitle="Precision titanium laser personalization and traceability workflows — laser annealing for pigment-free dark marks, architectural deep engraving, and UID/DataMatrix serialization fully interlocked under MIL-STD-130 and UDI mandates."
  />

  <!-- Marking Process Spectrum — 3-card grid -->
  <MarkingProcessSpectrum />

  <!-- Technical Specifications Dashboard — 4-column metrics -->
  <MarkingSpecsDashboard />

  <!-- Thermal Stress & Contrast Know-How — 2-column challenge/solution -->
