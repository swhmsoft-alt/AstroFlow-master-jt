---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import HeavyProcessSpectrum from '../components/services/HeavyProcessSpectrum.astro';
import HeavySpecsDashboard from '../components/services/HeavySpecsDashboard.astro';
import HotFormingStressKnowHow from '../components/services/HotFormingStressKnowHow.astro';
import HeavyDedicatedCta from '../components/services/HeavyDedicatedCta.astro';
import AudienceHub from '../components/audience/AudienceHub.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { HERO_CONFIG } from '../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout serviceHubKey="forming">
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.formingHeavy')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <SubpageHero
    title={t('titanium-forming-heavy-manufacturing.astro.titaniumFormingHeavyManufacturing.titanium_forming_heavy_manufacturing')}
    highlight="Services"
    badge="Heavy Manufacturing"
    badgeIcon="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z"
    subtitle="Hot forming, open/closed-die forging, and large-scale multi-component integration for multi-ton titanium infrastructure — from heavy plate rolling to vacuum stress-relieved structural assemblies."
  
    keyMetrics={HERO_CONFIG['/titanium-forming-heavy-manufacturing'].keyMetrics}
    entityChips={HERO_CONFIG['/titanium-forming-heavy-manufacturing'].entityChips}
  />

  <!-- Heavy Manufacturing Process Spectrum — 3-column grid -->
  <HeavyProcessSpectrum />

  <!-- Heavy Manufacturing Capacity Dashboard — 4-column specs -->
  <HeavySpecsDashboard />

  <!-- Hot Forming & Stress Relief Engineering Know-How — 2-column -->
  <HotFormingStressKnowHow />

  <!-- Dedicated CTA — Heavy Compliance Assessment -->
  <AudienceHub industry="forming" />

  <HeavyDedicatedCta />
</BaseLayout>