---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import AdditiveProcessSpectrum from '../components/services/AdditiveProcessSpectrum.astro';
import AdditiveSpecsDashboard from '../components/services/AdditiveSpecsDashboard.astro';
import AdditiveQualityKnowHow from '../components/services/AdditiveQualityKnowHow.astro';
import AdditiveDedicatedCta from '../components/services/AdditiveDedicatedCta.astro';
---
<BaseLayout title="Titanium Additive Manufacturing — BOZE CNC Ti" description="Industrial titanium additive manufacturing: SLM/DMLS 3D printing, rapid prototyping in 3-5 days, low-volume production. Full-density Ti-6Al-4V, ASTM F2924, AS9100D.">
  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title="Titanium Additive Manufacturing"
    highlight="Services"
    badge="Advanced Additive Manufacturing"
    badgeIcon="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
    subtitle="Industrial-grade titanium 3D printing via SLM/DMLS — from rapid functional prototypes in 3-5 days to full-scale low-volume production runs with mechanical properties matching wrought material."
  />

  <!-- Additive Process Spectrum — 3-column grid -->
  <AdditiveProcessSpectrum />

  <!-- 3D Printing Machine Specs Dashboard — 4-column -->
  <AdditiveSpecsDashboard />

  <!-- Additive Quality & Process Control — 2-column -->
  <AdditiveQualityKnowHow />

  <!-- Dedicated CTA — AM Design Review -->
  <AdditiveDedicatedCta />
</BaseLayout>