---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../../config/hero';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import { getBlogPosts, categoryToSlug, BLOG_PAGE_SIZE } from '../../lib/blog-i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type BlogPost = CollectionEntry<'blog'>;

// English blog: only load top-level posts (no lang/ prefix)
const sorted: BlogPost[] = await getBlogPosts('en');

const featured = sorted.find(p => p.data.featured);
const nonFeatured = featured ? sorted.filter(p => p.slug !== featured.slug) : sorted;

// Group by category — ordered by B2B buyer's journey
const CATEGORY_ORDER = [
  'Titanium CNC Machining Services',
  'Design Engineering',
  'Materials Engineering',
  'Manufacturing Problems',
  'Quality and Standards',
  'Applications and Processes',
  'Case Studies',
  'Procurement Guides',
];

const CATEGORY_ICONS: Record<string, string> = {
  'Titanium CNC Machining Services': 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  'Design Engineering': 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  'Materials Engineering': 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  'Manufacturing Problems': 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z',
  'Quality and Standards': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'Applications and Processes': 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  'Case Studies': 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
  'Procurement Guides': 'M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z M20.488 9H12V.512A9.025 9.025 0 0120.488 9z',
};

// Build grouped map
const grouped = new Map<string, BlogPost[]>();
for (const post of nonFeatured) {
  const cat = post.data.category || 'Uncategorized';
  if (!grouped.has(cat)) grouped.set(cat, []);
  grouped.get(cat)!.push(post);
}

const MAX_VISIBLE = 4;
const sectionIds: Record<string, string> = {};
// Merge curated CATEGORY_ORDER with any remaining categories (e.g. "Industry Insights")
// so newly added categories are never hidden from the index page.
const orderedCategories = [
  ...CATEGORY_ORDER.filter(cat => grouped.has(cat)),
  ...[...grouped.keys()].filter(cat => !CATEGORY_ORDER.includes(cat)),
];
for (const cat of orderedCategories) {
  sectionIds[cat] = categoryToSlug(cat);
}

// Blog stats for hero keyMetrics
const totalArticles = sorted.length;
const totalCategories = grouped.size;
const topCats = CATEGORY_ORDER.filter(c => grouped.has(c)).slice(0, 5);
const totalCaseStudies = (grouped.get('Case Studies') || []).length;
const totalProcurement = (grouped.get('Procurement Guides') || []).length;

// Pagination — full chronological listing lives under /blog/page/{n}/.
// Page 1 = /blog/ (this index); /blog/page/1/ 301-redirects here.
const totalPages = Math.max(1, Math.ceil(sorted.length / BLOG_PAGE_SIZE));
const blogPageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<BaseLayout
  description="Expert insights on CNC machining, titanium manufacturing, material science, and industry best practices. Stay informed with the latest from Boze Titanium Manufacturing Center."
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizePath('/', lang)} itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.blog')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <SubpageHero
    h1={HERO_CONFIG['/blog'].h1}
    badge={HERO_CONFIG['/blog'].badge}
    subtitle={HERO_CONFIG['/blog'].subtitle}
    badgeIcon="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
    keyMetrics={[
      { value: `${totalArticles}`, label: 'Articles' },
      { value: `${totalCategories}`, label: 'Categories' },
      { value: `${totalCaseStudies > 0 ? totalCaseStudies : ''}`, label: totalCaseStudies > 0 ? 'Case Studies' : '' },
    ].filter(m => m.label)}
    entityChips={topCats.map(c => c.replace('Titanium ', 'Ti ').replace(' and ', ' & ').replace(' Applications', ''))}
  />

  <!-- Featured Post -->
  {featured && (
    <section class="py-16" style="background: var(--theme-surface);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <span class="inline-flex items-center px-4 py-1.5 text-sm font-bold rounded-full mb-4" style="background: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">
            <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            {t('blog.featured')}
          </span>
        </div>
        <a href={localizePath(`/blog/${featured.slug}`, lang)} class="group block max-w-4xl mx-auto">
          <div class="rounded-2xl overflow-hidden transition-all duration-300 group-hover:shadow-2xl" style="background: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
            {featured.data.coverImage && (
              <div class="relative overflow-hidden aspect-[21/9]">
                <img src={featured.data.coverImage} alt={featured.data.coverImageAlt || featured.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" width="1200" height="514" />
              </div>
            )}
            <div class="p-8 md:p-10">
              <div class="flex items-center gap-3 mb-4">
                {featured.data.category && (
                  <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full" style="background: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">{featured.data.category}</span>
                )}
                <span class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
                  {new Date(featured.data.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </span>
              </div>
              <h2 class="text-2xl md:text-3xl font-bold mb-3 group-hover:text-[var(--theme-primary)] transition-colors" style="color: var(--theme-text);">
                {featured.data.title}
              </h2>
              <p class="text-base leading-relaxed mb-6 line-clamp-2" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                {featured.data.description}
              </p>
              <span class="inline-flex items-center font-semibold text-sm group-hover:gap-2 transition-all" style="color: var(--theme-primary);">
                {t('blog.readMore')}
                <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </span>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Category Navigation Bar -->
  <nav class="sticky top-20 z-40 py-3 overflow-x-auto border-y" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);" aria-label="Article categories">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 min-w-max">
      {orderedCategories.map(cat => (
        <a
          href={`#${sectionIds[cat]}`}
          class="whitespace-nowrap px-3 py-1.5 text-xs font-semibold rounded-full transition-all border"
          style="color: color-mix(in srgb, var(--theme-text) 65%, transparent); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);"
          onmouseover="this.style.color='var(--theme-primary)'; this.style.borderColor='var(--theme-primary)'; this.style.background='color-mix(in srgb, var(--theme-primary) 8%, transparent)'"
          onmouseout="this.style.color='color-mix(in srgb, var(--theme-text) 65%, transparent)'; this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.background='transparent'"
        >
          {cat}
          <span class="ml-1.5 opacity-60">({grouped.get(cat)!.length})</span>
        </a>
      ))}
      {totalPages > 1 && (
        <a
          href={localizePath('/blog/page/2/', lang)}
          class="whitespace-nowrap px-3 py-1.5 text-xs font-bold rounded-full transition-all border ml-2"
          style="color: var(--theme-primary); border-color: color-mix(in srgb, var(--theme-primary) 30%, transparent); background: color-mix(in srgb, var(--theme-primary) 8%, transparent);"
          onmouseover="this.style.background='color-mix(in srgb, var(--theme-primary) 14%, transparent)'"
          onmouseout="this.style.background='color-mix(in srgb, var(--theme-primary) 8%, transparent)'"
        >
          All Articles
          <svg class="w-3 h-3 inline ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      )}
    </div>
  </nav>

  <!-- Category Sections -->
  <div class="py-16 lg:py-20" style="background: var(--theme-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">

      {orderedCategories.map(cat => {
        const posts = grouped.get(cat)!;
        const hasMore = posts.length > MAX_VISIBLE;
        const icon = CATEGORY_ICONS[cat];
        return (
          <section id={sectionIds[cat]} class="scroll-mt-32">
            <!-- Section Header -->
            <div class="flex items-center justify-between mb-8">
              <div class="flex items-center gap-3">
                {icon && (
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                    <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icon} />
                    </svg>
                  </div>
                )}
                <div>
                  <h2 class="text-xl md:text-2xl font-bold" style="color: var(--theme-text);">{cat}</h2>
                  <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{posts.length} article{posts.length > 1 ? 's' : ''}</p>
                </div>
              </div>
            </div>

            <!-- Article Grid -->
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
              {posts.slice(0, MAX_VISIBLE).map(post => (
                <a
                  href={localizePath(`/blog/${post.slug}`, lang)}
                  class="group rounded-xl overflow-hidden transition-all duration-300 hover:shadow-xl flex flex-col"
                  style="background: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);"
                >
                  {post.data.coverImage && (
                    <div class="relative overflow-hidden aspect-[16/10]">
                      <img
                        src={post.data.coverImage}
                        alt={post.data.coverImageAlt || post.data.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        width="400" height="250" loading="lazy"
                      />
                    </div>
                  )}
                  <div class="p-4 flex flex-col flex-1">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-[10px]" style="color: color-mix(in srgb, var(--theme-text) 40%, transparent);">
                        {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </span>
                    </div>
                    <h3 class="text-sm font-bold mb-1.5 transition-colors group-hover:text-[var(--theme-primary)] line-clamp-2" style="color: var(--theme-text);">
                      {post.data.title}
                    </h3>
                    <p class="text-xs leading-relaxed line-clamp-2 flex-1" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
                      {post.data.description}
                    </p>
                    <div class="mt-3 flex items-center gap-1 text-xs font-medium transition-all group-hover:gap-2" style="color: var(--theme-primary);">
                      {t('blog.readMore')}
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </div>
                  </div>
                </a>
              ))}
            </div>

            {hasMore && (
              <div class="mt-6 text-center">
                <a
                  href={`/blog/category/${categoryToSlug(cat)}/`}
                  class="inline-flex items-center gap-1.5 px-5 py-2 text-sm font-semibold rounded-xl transition-all border"
                  style="color: var(--theme-primary); border-color: color-mix(in srgb, var(--theme-primary) 20%, transparent); background: color-mix(in srgb, var(--theme-primary) 6%, transparent);"
                  onmouseover="this.style.background='color-mix(in srgb, var(--theme-primary) 12%, transparent)'"
                  onmouseout="this.style.background='color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
                >
                  View all {posts.length} articles
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </a>
              </div>
            )}
          </section>
        );
      })}

      {sorted.length === 0 && (
        <div class="text-center py-20">
          <svg class="w-20 h-20 mx-auto mb-6" style="color: color-mix(in srgb, var(--theme-text) 30%, transparent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <h3 class="text-2xl font-bold mb-2" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{t('blog.empty.title')}</h3>
          <p class="text-base" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('blog.empty.desc')}</p>
        </div>
      )}
    </div>
  </div>

  <!-- Pagination (page 1 = this index) -->
  {totalPages > 1 && (
    <section class="py-12" style="background: var(--theme-bg); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-center gap-2" role="navigation" aria-label="Blog pagination">
          <a
            href={localizePath('/blog/page/2/', lang)}
            class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-xl transition-all border"
            style="color: var(--theme-primary); border-color: color-mix(in srgb, var(--theme-primary) 20%, transparent); background: color-mix(in srgb, var(--theme-primary) 6%, transparent);"
            rel="next"
          >
            Next Page
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
          <span class="text-xs font-medium px-3" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            {totalPages} pages · {totalArticles} articles
          </span>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="relative py-24 overflow-hidden" style="background: var(--theme-surface); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background: radial-gradient(circle at 30% 50%, var(--theme-primary) 0%, transparent 50%), radial-gradient(circle at 70% 50%, var(--theme-accent) 0%, transparent 50%);"></div>
    </div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center" style="color: var(--theme-text);">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          {t('blog.cta2.title')}
        </h2>
        <p class="text-xl mb-10 max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
          {t('blog.cta2.subtitle')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://www.bozemetal.com/contact" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-8 py-4 font-bold rounded-xl shadow-2xl hover:shadow-3xl transition-all text-lg" style="background: var(--theme-primary); color: var(--theme-text);" onmouseover="this.style.background='color-mix(in srgb, var(--theme-primary) 80%, black)'" onmouseout="this.style.background='var(--theme-primary)'">
            {t('blog.cta2.quote')}
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
          <a href={localizePath('/products', lang)} class="inline-flex items-center px-8 py-4 font-bold rounded-xl transition-all text-lg" style="border: 2px solid color-mix(in srgb, var(--theme-text) 30%, transparent); color: var(--theme-text);" onmouseover="this.style.borderColor='color-mix(in srgb, var(--theme-text) 50%, transparent)'" onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-text) 30%, transparent)'">
            {t('blog.cta2.products')}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>