---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

type BlogPost = CollectionEntry<'blog'>;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allPosts: BlogPost[] = await getCollection('blog');
const sorted = allPosts.sort((a: BlogPost, b: BlogPost) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

const featured = sorted.find(p => p.data.featured);
const recent = featured ? sorted.filter(p => p.slug !== featured.slug) : sorted;
---

<BaseLayout
  description="Expert insights on CNC machining, titanium manufacturing, material science, and industry best practices. Stay informed with the latest from BOZE CNC Ti."
>
  <!-- Hero -->
  <SubpageHero
    title="Our"
    highlight="Blog"
    badge="Insights & Updates"
    badgeIcon="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
    subtitle="Technical guides, industry trends, and company news from the forefront of precision CNC titanium manufacturing."
  />

  <!-- Featured Post -->
  {featured && (
    <section class="py-16" style="background: var(--theme-surface);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <span class="inline-flex items-center px-4 py-1.5 text-sm font-bold rounded-full mb-4" style="background: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">
            <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            {t('blog.featured')}
          </span>
        </div>
        <a href={localizePath(`/blog/${featured.slug}`, lang)} class="group block max-w-4xl mx-auto">
          <div class="rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 grid grid-cols-1 md:grid-cols-2" style="background: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <div class="relative h-64 md:h-full min-h-[280px] overflow-hidden" style="background: color-mix(in srgb, var(--theme-text) 10%, var(--theme-surface));">

              {featured.data.coverImage ? (
                <img
                  src={featured.data.coverImage}
                  alt={featured.data.coverImageAlt || featured.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center" style="background: linear-gradient(to bottom right, var(--theme-primary), color-mix(in srgb, var(--theme-primary) 70%, white));">
                  <svg class="w-20 h-20" style="color: color-mix(in srgb, var(--theme-text) 40%, transparent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
              )}
              <div class="absolute inset-0 md:hidden" style="background: linear-gradient(to top, color-mix(in srgb, var(--theme-bg) 40%, transparent), transparent);"></div>
            </div>
            <div class="p-8 lg:p-10 flex flex-col justify-center">
              {featured.data.category && (
                <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full mb-3 w-fit" style="background: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">
                  {featured.data.category}
                </span>
              )}
              <h2 class="text-2xl lg:text-3xl font-bold mb-3 transition-colors" style="color: var(--theme-text);" onmouseover="this.style.color='var(--theme-primary)'" onmouseout="this.style.color='var(--theme-text)'">
                {featured.data.title}
              </h2>
              <p class="mb-4 leading-relaxed line-clamp-3" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                {featured.data.description}
              </p>
              <div class="flex items-center justify-between mt-auto">
                <div class="flex items-center space-x-3 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
                  <span>{featured.data.author}</span>
                  <span style="color: color-mix(in srgb, var(--theme-text) 30%, transparent);">|</span>
                  <time datetime={featured.data.pubDate.toISOString()}>
                    {new Date(featured.data.pubDate).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </div>
                <span class="inline-flex items-center font-semibold text-sm group-hover:gap-2 transition-all" style="color: var(--theme-primary);">
                  {t('blog.readMore')}
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Recent Posts Grid -->
  <section class="py-16" style="background: color-mix(in srgb, var(--theme-text) 3%, var(--theme-surface));">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-3" style="color: var(--theme-text);">
          {t('blog.latest.title')}
        </h2>
        <p class="max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('blog.latest.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recent.map((post: BlogPost) => {
          const { data, slug } = post;
          const tags = data.tags || [];
          return (
            <a href={localizePath(`/blog/${slug}`, lang)} class="group block">
              <div class="rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 h-full flex flex-col" style="background: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                <div class="relative h-48 overflow-hidden" style="background: color-mix(in srgb, var(--theme-text) 10%, var(--theme-surface));">
                  {data.coverImage ? (
                    <img
                      src={data.coverImage}
                      alt={data.coverImageAlt || data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center" style="background: linear-gradient(to bottom right, color-mix(in srgb, var(--theme-primary) 20%, transparent), color-mix(in srgb, var(--theme-primary) 10%, transparent));">
                      <svg class="w-12 h-12" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                      </svg>
                    </div>
                  )}
                  {data.featured && (
                    <div class="absolute top-3 right-3">
                      <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-full" style="background: color-mix(in srgb, var(--theme-primary) 80%, transparent); backdrop-filter: blur(4px); color: var(--theme-text);">
                        {t('blog.featuredBadge')}
                      </span>
                    </div>
                  )}
                </div>
                <div class="p-6 flex flex-col flex-1" style="background: var(--theme-surface);">
                  {data.category && (
                    <span class="inline-block px-2.5 py-1 text-xs font-semibold rounded-full mb-3 w-fit" style="background: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">
                      {data.category}
                    </span>
                  )}
                  <h3 class="text-lg font-bold mb-2 transition-colors" style="color: var(--theme-text);" onmouseover="this.style.color='var(--theme-primary)'" onmouseout="this.style.color='var(--theme-text)'">
                    {data.title}
                  </h3>
                  <p class="text-sm line-clamp-3 mb-4 leading-relaxed flex-1" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                    {data.description}
                  </p>
                  <div class="flex items-center justify-between pt-4" style="border-top: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                    <div class="flex items-center space-x-2 text-xs" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
                      <time datetime={data.pubDate.toISOString()}>
                        {new Date(data.pubDate).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </time>
                    </div>
                    <span class="inline-flex items-center font-semibold text-xs group-hover:gap-2 transition-all" style="color: var(--theme-primary);">
                      {t('blog.readMore')}
                      <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      {sorted.length === 0 && (
        <div class="text-center py-20">
          <svg class="w-20 h-20 mx-auto mb-6" style="color: color-mix(in srgb, var(--theme-text) 30%, transparent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <h3 class="text-2xl font-bold mb-2" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{t('blog.empty.title')}</h3>
          <p class="text-base" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('blog.empty.desc')}</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 overflow-hidden" style="background: linear-gradient(to right, color-mix(in srgb, var(--theme-primary) 90%, var(--theme-bg)), color-mix(in srgb, var(--theme-accent) 90%, var(--theme-bg)));">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background: radial-gradient(circle at 30% 50%, var(--theme-primary) 0%, transparent 50%), radial-gradient(circle at 70% 50%, var(--theme-accent) 0%, transparent 50%);"></div>
    </div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center" style="color: var(--theme-text);">
        <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          {t('blog.cta2.title')}
        </h2>
        <p class="text-xl mb-10 max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
          {t('blog.cta2.subtitle')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://www.bozemetal.com/contact" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-8 py-4 font-bold rounded-xl shadow-2xl hover:shadow-3xl transition-all text-lg" style="background: var(--theme-primary); color: var(--theme-text);" onmouseover="this.style.background='color-mix(in srgb, var(--theme-primary) 80%, black)'" onmouseout="this.style.background='var(--theme-primary)'">
            {t('blog.cta2.quote')}
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
          <a href={localizePath('/products', lang)} class="inline-flex items-center px-8 py-4 font-bold rounded-xl transition-all text-lg" style="border: 2px solid color-mix(in srgb, var(--theme-text) 30%, transparent); color: var(--theme-text);" onmouseover="this.style.borderColor='color-mix(in srgb, var(--theme-text) 50%, transparent)'" onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-text) 30%, transparent)'">
            {t('blog.cta2.products')}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
