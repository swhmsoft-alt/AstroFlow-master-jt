---
/**
 * src/pages/blog/category/[slug].astro
 *
 * Blog category archive (English).
 * Lists ALL articles of a single category — the real target of the
 * "View all N articles" buttons on /blog/ (which previously were dead
 * anchor links that never expanded the list).
 *
 * JSON-LD: BaseLayout emits CollectionPage + ItemList + BreadcrumbList
 * via pageType="blog-index" and the items prop.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, localizePath } from '../../../i18n/utils';
import { categoryToSlug } from '../../../lib/blog-i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const englishPosts = posts.filter(p => !p.slug.includes('/'));

  // Every distinct category becomes an archive page (incl. "Industry Insights").
  const categories = Array.from(
    new Set(englishPosts.map(p => p.data.category || 'Uncategorized'))
  );

  return categories.map(cat => ({
    params: { slug: categoryToSlug(cat) },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => !p.slug.includes('/'))
  .filter(p => (p.data.category || 'Uncategorized') === category)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const categorySlug = categoryToSlug(category);
const pageTitle = `${category} Articles | Boze Titanium Manufacturing Center Blog`;
const pageDescription = `Browse all ${category} articles from the Boze Titanium Manufacturing Center blog — engineering guides, case studies, procurement guidance, and manufacturing insights on titanium CNC machining.`;
const items = posts.map(p => ({
  name: p.data.title,
  url: `https://cnc.bozemetal.com/blog/${p.slug}`,
}));

const featured = posts.find(p => p.data.featured);
const recent = featured ? posts.filter(p => p.slug !== featured.slug) : posts;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pageType="blog-index"
  collectionName={`${category} Articles`}
  itemCount={posts.length}
  items={items}
  alternateLinks={[{ lang: 'en', href: `/blog/category/${categorySlug}` }]}
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizePath('/', lang)} itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('blog.breadcrumb.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={localizePath('/blog', lang)} itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('blog.breadcrumb.blog')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{category}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Category Header -->
  <section class="py-14 lg:py-16" style="background: var(--theme-surface); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full mb-4" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">
          {posts.length} article{posts.length > 1 ? 's' : ''}
        </span>
        <h1 class="text-3xl md:text-4xl font-bold mb-4 leading-tight" style="color: var(--theme-text);">
          {category}
        </h1>
        <p class="text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          All {category.toLowerCase()} articles from the Boze Titanium Manufacturing Center — engineering guides, case studies, and manufacturing insights for buyers and engineers.
        </p>
      </div>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="py-14 lg:py-16" style="background: var(--theme-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {featured && (
        <div class="rounded-2xl overflow-hidden mb-10" style="background: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <a href={localizePath(`/blog/${featured.slug}`, lang)} class="group block md:grid md:grid-cols-2 gap-0">
            {featured.data.coverImage && (
              <div class="relative overflow-hidden aspect-[16/10]">
                <img
                  src={featured.data.coverImage}
                  alt={featured.data.coverImageAlt || featured.data.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  width="800"
                  height="500"
                />
              </div>
            )}
            <div class="p-8 flex flex-col justify-center">
              <div class="flex items-center gap-2 mb-3">
                <span class="px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">
                  {t('blog.featured')}
                </span>
                <span class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 40%, transparent);">
                  {new Date(featured.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
              </div>
              <h2 class="text-xl md:text-2xl font-bold mb-3 transition-colors group-hover:text-[var(--theme-primary)]" style="color: var(--theme-text);">
                {featured.data.title}
              </h2>
              <p class="text-sm line-clamp-3 mb-5" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
                {featured.data.description}
              </p>
              <span class="inline-flex items-center gap-2 text-sm font-medium transition-all group-hover:gap-3" style="color: var(--theme-primary);">
                {t('blog.readMore')}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </span>
            </div>
          </a>
        </div>
      )}

      {recent.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {recent.map((post) => (
            <a
              href={localizePath(`/blog/${post.slug}`, lang)}
              class="group rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-xl"
              style="background: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);"
            >
              {post.data.coverImage && (
                <div class="relative overflow-hidden aspect-[16/10]">
                  <img
                    src={post.data.coverImage}
                    alt={post.data.coverImageAlt || post.data.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    width="600"
                    height="375"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 40%, transparent);">
                    {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                </div>
                <h3 class="text-lg font-bold mb-2 transition-colors group-hover:text-[var(--theme-primary)]" style="color: var(--theme-text);">
                  {post.data.title}
                </h3>
                <p class="text-sm line-clamp-2" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                  {post.data.description}
                </p>
                <div class="mt-4 flex items-center gap-2 text-xs font-medium" style="color: var(--theme-primary);">
                  {t('blog.readMore')}
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-center py-16" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          No articles published in this category yet.
        </p>
      )}

      <!-- Back to all articles -->
      <div class="mt-12 text-center">
        <a
          href={localizePath('/blog', lang)}
          class="inline-flex items-center gap-1.5 px-6 py-3 text-sm font-semibold rounded-xl transition-all border"
          style="color: var(--theme-primary); border-color: color-mix(in srgb, var(--theme-primary) 20%, transparent); background: color-mix(in srgb, var(--theme-primary) 6%, transparent);"
        >
          <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          {t('blog.back')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
