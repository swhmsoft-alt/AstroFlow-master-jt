---
// =============================================================================
// Engineering RFQ Page — "Request a Quote | Titanium CNC Machining"
// Conversion-focused B2B inquiry page.
// Inquiry module: HeroRfq form (tested & live) — native POST to /submit-rfq.php
// (cPanel PHP handler → email + server-side file archive → redirect /thank-you/).
// Localized /[lang]/rfq/ mirrors this English landing structure (English-only).
// =============================================================================
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroRfq from '../components/landing/HeroRfq.astro';
import TrustBadges from '../components/landing/TrustBadges.astro';
import Capabilities from '../components/landing/Capabilities.astro';
import QualityControl from '../components/landing/QualityControl.astro';
import Applications from '../components/landing/Applications.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import StickyCta from '../components/landing/StickyCta.astro';

// ── SEO: page title & meta description (RFQ / quotation intent) ──
// Note: for English the title/description are sourced from src/config/seo.ts
// ('/rfq' entry); these explicit values act as a fallback.
const pageTitle = 'Request a Quote | Titanium CNC Machining RFQ | Boze Titanium Manufacturing Center';
const pageDescription =
  'Submit your titanium CNC machining RFQ with CAD files. AS9100D certified manufacturing with tolerances to ±0.005mm for aerospace and medical parts. Formal quotation within 24–48 hours.';
const canonicalUrl = 'https://cnc.bozemetal.com/rfq/';

// ── Supplementary JSON-LD: Service + ManufacturingPlant + OfferCatalog ──
// BaseLayout auto-generates Organization / WebSite / WebPage / BreadcrumbList
// (pageType="rfq"). This additional graph strengthens the Service / provider
// signals for GEO / AI search and indexing of the quotation service.
const landingSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: 'Precision Titanium CNC Machining RFQ & Quotation',
      serviceType: 'CNC Machining RFQ',
      provider: {
        '@type': 'ManufacturingPlant',
        name: 'Boze Titanium Manufacturing Center',
        url: 'https://www.bozemetal.com',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Baoji',
          addressRegion: 'Shaanxi',
          addressCountry: 'CN',
        },
      },
      description:
        'Request a quotation for custom 5-axis titanium CNC machining of Grade 5, Ti-6Al-4V ELI, aerospace and medical components. Formal quote within 24-48 hours with full material traceability and inspection reports.',
      areaServed: 'Worldwide',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Titanium Machining RFQ Services',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: '5-Axis Titanium Milling & Turning Quotation',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Aerospace & Medical Titanium Component RFQ',
            },
          },
        ],
      },
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalUrl}
  pageType="rfq"
>
  <script type="application/ld+json" set:html={JSON.stringify(landingSchema)} />

  <!-- ================= RFQ landing sections ================= -->
  <HeroRfq />
  <TrustBadges />
  <Capabilities />
  <QualityControl />
  <Applications />
  <FinalCta />
  <StickyCta />
</BaseLayout>
