---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import EngineeringRfqForm from '../components/rfq/EngineeringRfqForm.astro';
import SecurityNdaBanner from '../components/rfq/SecurityNdaBanner.astro';
import ResponsePipelineTimeline from '../components/rfq/ResponsePipelineTimeline.astro';

const pageTitle = 'Engineering RFQ | Titanium CNC Machining';
const pageSubtitle = 'Submit your technical requirements and CAD files. Our processing engineers will respond with a formal quotation within 24–48 hours.';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<BaseLayout title={pageTitle} description={pageSubtitle}>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">RFQ</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero -->
  <SubpageHero
    title={t('rfq.astro.rfq.request')}
    highlight="Engineering Quote"
    badge="RFQ Portal"
    badgeIcon="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
    subtitle={pageSubtitle}
  />

  <!-- Engineering RFQ Form -->
  <EngineeringRfqForm />

  <!-- Security & NDA Banner -->
  <SecurityNdaBanner />

  <!-- Response Pipeline Timeline -->
  <ResponsePipelineTimeline />
</BaseLayout>
