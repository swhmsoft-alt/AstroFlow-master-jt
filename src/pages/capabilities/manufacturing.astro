---
/**
 * capabilities/manufacturing.astro
 *
 * Advanced Titanium Manufacturing Capabilities & Infrastructure
 * Google AIO-optimized page — semantic HTML5, structured JSON-LD,
 * high-density entity injection for procurement engineering audiences.
 *
 * Route: /capabilities/manufacturing/ (English, default)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import ManufacturingPage from '../../components/capabilities/ManufacturingPage.astro';

// ── Canonical URL ──
const canonicalURL = new URL('/capabilities/manufacturing/', Astro.site || 'https://cnc.bozemetal.com');
---

<BaseLayout
  title="Advanced Titanium Manufacturing Capabilities & Infrastructure | BOZE CNC Ti"
  description="Certified titanium precision manufacturing infrastructure. Specializing in micron-level CNC tolerances, 5-axis milling, Swiss turning, and full material traceability (MTR) for aerospace, medical, and defense applications."
  canonicalURL={canonicalURL}
>
  <!-- Hero Section -->
  <SubpageHero
    h1="Advanced Titanium Manufacturing Capabilities & Infrastructure"
    badge="Precision Manufacturing Infrastructure"
    subtitle="Scalable, certified precision manufacturing delivering micron-level tolerances, multi-axis geometry, and 100% material traceability for aerospace, medical, and defense applications."
  />

  <!-- Main Content -->
  <ManufacturingPage />

  <!-- ════════════════════════════════════════════════════════════════
       Custom JSON-LD — Google AIO Entity Mapping
       Injected in addition to BaseLayout's auto-generated schema.
       Schema.org @graph merges cleanly with the existing block.
       ════════════════════════════════════════════════════════════════ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://cnc.bozemetal.com/capabilities/manufacturing/#webpage",
        "url": "https://cnc.bozemetal.com/capabilities/manufacturing/",
        "name": "Advanced Titanium CNC Machining & Manufacturing Capabilities",
        "description": "Certified titanium precision manufacturing infrastructure. Specializing in micron-level CNC tolerances, 5-axis milling, Swiss turning, and full material traceability (MTR).",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://cnc.bozemetal.com/#website",
          "url": "https://cnc.bozemetal.com/",
          "name": "BOZE CNC Titanium Machining"
        },
        "breadcrumb": {
          "@id": "https://cnc.bozemetal.com/capabilities/manufacturing/#breadcrumb"
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://cnc.bozemetal.com/capabilities/manufacturing/#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://cnc.bozemetal.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Capabilities",
            "item": "https://cnc.bozemetal.com/capabilities/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Manufacturing Capabilities",
            "item": "https://cnc.bozemetal.com/capabilities/manufacturing/"
          }
        ]
      },
      {
        "@type": "ManufacturingBusiness",
        "@id": "https://cnc.bozemetal.com/#organization",
        "name": "BOZE CNC Metal",
        "url": "https://cnc.bozemetal.com/",
        "knowsAbout": [
          "Titanium CNC Machining",
          "5-Axis CNC Milling",
          "Swiss Precision Turning",
          "Aerospace Component Manufacturing",
          "Medical Device Components",
          "Grade 5 Titanium Properties",
          "Material Traceability"
        ]
      }
    ]
  })} />
</BaseLayout>
