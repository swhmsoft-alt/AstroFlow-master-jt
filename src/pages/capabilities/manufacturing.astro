---
/**
 * capabilities/manufacturing.astro
 *
 * Advanced Titanium Manufacturing Capabilities & Infrastructure
 * Google AIO-optimized page — semantic HTML5, structured JSON-LD,
 * high-density entity injection for procurement engineering audiences.
 *
 * Route: /capabilities/manufacturing/ (English, default)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import ManufacturingPage from '../../components/capabilities/ManufacturingPage.astro';
import { HERO_CONFIG } from '../../config/hero';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// ── Canonical URL ──
const canonicalURL = new URL('/capabilities/manufacturing/', Astro.site || 'https://cnc.bozemetal.com');
const hero = HERO_CONFIG['/capabilities/manufacturing'];
---

<BaseLayout
  title="Advanced Titanium Manufacturing Capabilities & Infrastructure | BOZE CNC Ti"
  description="Certified titanium precision manufacturing infrastructure. Specializing in micron-level CNC tolerances, 5-axis milling, Swiss turning, and full material traceability (MTR) for aerospace, medical, and defense applications."
  canonicalURL={canonicalURL}
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/capabilities/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.capabilities')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.capabilities.manufacturing')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero Section -->
  <SubpageHero
    h1={hero.h1}
    badge={hero.badge}
    subtitle={hero.subtitle}
    keyMetrics={hero.keyMetrics}
    entityChips={hero.entityChips}
    compact={hero.compact}
  />

  <!-- Main Content -->
  <ManufacturingPage />

  <!-- ════════════════════════════════════════════════════════════════
       Custom JSON-LD — Google AIO Entity Mapping
       Injected in addition to BaseLayout's auto-generated schema.
       Schema.org @graph merges cleanly with the existing block.
       ════════════════════════════════════════════════════════════════ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://cnc.bozemetal.com/capabilities/manufacturing/#webpage",
        "url": "https://cnc.bozemetal.com/capabilities/manufacturing/",
        "name": "Advanced Titanium CNC Machining & Manufacturing Capabilities",
        "description": "Certified titanium precision manufacturing infrastructure. Specializing in micron-level CNC tolerances, 5-axis milling, Swiss turning, and full material traceability (MTR).",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://cnc.bozemetal.com/#website",
          "url": "https://cnc.bozemetal.com/",
          "name": "BOZE CNC Titanium Machining"
        },
        "breadcrumb": {
          "@id": "https://cnc.bozemetal.com/capabilities/manufacturing/#breadcrumb"
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://cnc.bozemetal.com/capabilities/manufacturing/#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://cnc.bozemetal.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Capabilities",
            "item": "https://cnc.bozemetal.com/capabilities/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Manufacturing Capabilities",
            "item": "https://cnc.bozemetal.com/capabilities/manufacturing/"
          }
        ]
      },
      {
        "@type": "ManufacturingBusiness",
        "@id": "https://cnc.bozemetal.com/#organization",
        "name": "BOZE CNC Metal",
        "url": "https://cnc.bozemetal.com/",
        "knowsAbout": [
          "Titanium CNC Machining",
          "5-Axis CNC Milling",
          "Swiss Precision Turning",
          "Aerospace Component Manufacturing",
          "Medical Device Components",
          "Grade 5 Titanium Properties",
          "Material Traceability"
        ]
      }
    ]
  })} />
</BaseLayout>
