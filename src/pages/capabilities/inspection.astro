---
/**
 * capabilities/inspection.astro
 *
 * Titanium Metrology, Inspection & Testing Infrastructure.
 * Google AIO-optimized page for procurement engineers evaluating
 * quality verification capabilities and NDT services.
 *
 * Route: /capabilities/inspection/ (English, default)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import InspectionPage from '../../components/capabilities/InspectionPage.astro';
import { HERO_CONFIG } from '../../config/hero';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const hero = HERO_CONFIG['/capabilities/inspection'];

const canonicalURL = new URL('/capabilities/inspection/', Astro.site || 'https://cnc.bozemetal.com');
---

<BaseLayout
  title="Titanium CNC Metrology, Inspection & Testing Services | Boze Titanium Manufacturing Center"
  description="In-house inspection laboratory for titanium components — CMM metrology, OES material verification, FPI/UT non-destructive testing, surface profilometry, and GD&T dimensional analysis. ISO 17025 calibrated."
  canonicalURL={canonicalURL}
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/capabilities/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.capabilities')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.capabilities.inspection')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <SubpageHero
    h1={hero.h1}
    badge={hero.badge}
    subtitle={hero.subtitle}
    keyMetrics={hero.keyMetrics}
    entityChips={hero.entityChips}
    compact={hero.compact}
  />

  <InspectionPage />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://cnc.bozemetal.com/capabilities/inspection/#webpage",
        "url": "https://cnc.bozemetal.com/capabilities/inspection/",
        "name": "Titanium CNC Metrology, Inspection & Testing Services",
        "description": "In-house inspection laboratory for titanium components — CMM metrology, OES material verification, FPI/UT non-destructive testing, surface profilometry, and GD&T dimensional analysis.",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://cnc.bozemetal.com/#website",
          "url": "https://cnc.bozemetal.com/",
          "name": "Boze Titanium Manufacturing Center"
        },
        "breadcrumb": {
          "@id": "https://cnc.bozemetal.com/capabilities/inspection/#breadcrumb"
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://cnc.bozemetal.com/capabilities/inspection/#breadcrumb",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cnc.bozemetal.com/" },
          { "@type": "ListItem", "position": 2, "name": "Capabilities", "item": "https://cnc.bozemetal.com/capabilities/" },
          { "@type": "ListItem", "position": 3, "name": "Inspection & Testing", "item": "https://cnc.bozemetal.com/capabilities/inspection/" }
        ]
      },
      {
        "@type": "ManufacturingBusiness",
        "@id": "https://cnc.bozemetal.com/#organization",
        "name": "Boze Titanium Manufacturing Center",
        "url": "https://cnc.bozemetal.com/",
        "knowsAbout": [
          "Coordinate Measuring Machine",
          "Optical Emission Spectrometry",
          "Non-Destructive Testing",
          "Fluorescent Penetrant Inspection",
          "Ultrasonic Testing",
          "Surface Roughness Measurement",
          "GD and T Dimensional Analysis",
          "ISO 17025 Calibration"
        ]
      }
    ]
  })} />
</BaseLayout>
