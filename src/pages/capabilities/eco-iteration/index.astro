              <svg class="h-3.5 w-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              100% confidential · Your designs are safe — NDA available on request
            </p>
          </form>
        </div>
      </div>
    </div>
  </Section>

  <script>
    // ============================================================
    // RFQ form client-side enhancement (vanilla JS, no React island).
    // Mirrors HeroRfq.astro pattern:
    //   1. "Submitting…" state to prevent double submission
    //   2. Error banner when PHP redirects back with ?rfq=error
    // ============================================================
    (() => {
      const form = document.getElementById('rfq-form');
      const errBox = document.getElementById('tm-form-error');
      const submitBtn = form ? form.querySelector<HTMLButtonElement>('button[type="submit"]') : null;
      let toastTimer = 0;

      // PHP handler failed → redirected back with ?rfq=error
      if (new URLSearchParams(window.location.search).get('rfq') === 'error') {
        showToast('Sorry, your RFQ could not be sent. Please try again or email us directly at info@bozemetal.com.');
      }

      function showToast(msg: string) {
        if (!errBox) return;
        errBox.textContent = msg;
        errBox.classList.remove('hidden');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => errBox.classList.add('hidden'), 8000);
      }

      if (form && submitBtn) {
        form.addEventListener('submit', () => {
          // Prevent double-submission while the PHP handler processes the request.
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting…';
        });
      }
    })();
  </script>

