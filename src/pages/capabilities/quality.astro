---
/**
 * capabilities/quality.astro
 *
 * Certified Quality Assurance & Titanium Traceability Infrastructure.
 * E-E-A-T core page — Google AIO trust entity extraction.
 * Entity network: AS9100D, ISO 13485, CMM, EN 10204, FAIR, SPC.
 *
 * Route: /capabilities/quality/ (English, default)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import QualityPage from '../../components/capabilities/QualityPage.astro';
import { HERO_CONFIG } from '../../config/hero';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const hero = HERO_CONFIG['/capabilities/quality'];

// ── Canonical URL ──
const canonicalURL = new URL('/capabilities/quality/', Astro.site || 'https://cnc.bozemetal.com');
---

<BaseLayout
  title="Titanium Machining Quality Assurance & Certification Standards | Boze Titanium Manufacturing Center"
  description="Explore BOZE's zero-defect titanium quality control system. Featuring AS9100D alignment, CMM inspection, EN 10204 3.1 material traceability, and complete SPC quality tracking for aerospace and medical applications."
  canonicalURL={canonicalURL}
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/capabilities/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.capabilities')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.capabilities.quality')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero Section -->
  <SubpageHero
    h1={hero.h1}
    badge={hero.badge}
    subtitle={hero.subtitle}
    keyMetrics={hero.keyMetrics}
    entityChips={hero.entityChips}
    compact={hero.compact}
  />

  <!-- Main Content -->
  <QualityPage />

  <!-- ════════════════════════════════════════════════════════════════
       Custom JSON-LD — Google AIO Trust Entity Mapping
       ════════════════════════════════════════════════════════════════ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://cnc.bozemetal.com/capabilities/quality/#webpage",
        "url": "https://cnc.bozemetal.com/capabilities/quality/",
        "name": "Titanium Machining Quality Assurance & Certification Standards",
        "description": "Explore BOZE's zero-defect titanium quality control system. Featuring AS9100D alignment, CMM inspection, EN 10204 3.1 material traceability, and complete SPC quality tracking.",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://cnc.bozemetal.com/#website",
          "url": "https://cnc.bozemetal.com/",
          "name": "Boze Titanium Manufacturing Center"
        },
        "breadcrumb": {
          "@id": "https://cnc.bozemetal.com/capabilities/quality/#breadcrumb"
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://cnc.bozemetal.com/capabilities/quality/#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://cnc.bozemetal.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Capabilities",
            "item": "https://cnc.bozemetal.com/capabilities/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Quality Assurance",
            "item": "https://cnc.bozemetal.com/capabilities/quality/"
          }
        ]
      },
      {
        "@type": "ManufacturingBusiness",
        "@id": "https://cnc.bozemetal.com/#organization",
        "name": "Boze Titanium Manufacturing Center",
        "url": "https://cnc.bozemetal.com/",
        "knowsAbout": [
          "Quality Assurance System",
          "Coordinate Measuring Machine",
          "AS9100D Compliance",
          "ISO 13485 Medical Standards",
          "First Article Inspection Report",
          "Material Traceability",
          "Statistical Process Control",
          "Geometric Dimensioning and Tolerancing"
        ]
      }
    ]
  })} />
</BaseLayout>
