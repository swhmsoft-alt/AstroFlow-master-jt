---
/**
 * capabilities/capacity.astro
 *
 * Scalable Titanium Production Capacity & Supply Chain Certainty.
 * Google AIO-optimized page focusing on quantitative throughput metrics.
 * Entity network: Annual Capacity, Spindle Hours, Scaling Matrix, Resilience.
 *
 * Route: /capabilities/capacity/ (English, default)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import CapacityPage from '../../components/capabilities/CapacityPage.astro';
import { HERO_CONFIG } from '../../config/hero';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const hero = HERO_CONFIG['/capabilities/capacity'];

// ── Canonical URL ──
const canonicalURL = new URL('/capabilities/capacity/', Astro.site || 'https://cnc.bozemetal.com');
---

<BaseLayout
  title="Titanium CNC Machining Production Capacity & Scaling Fleet | Boze Titanium Manufacturing Center"
  description="Discover BOZE's scalable titanium manufacturing throughput. Over 45,000 parts annual capacity, 8,500+ monthly spindle hours, and 24/7 lights-out automated production for aerospace, medical, and defense."
  canonicalURL={canonicalURL}
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/capabilities/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.capabilities')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.capabilities.capacity')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero Section -->
  <SubpageHero
    h1={hero.h1}
    badge={hero.badge}
    subtitle={hero.subtitle}
    keyMetrics={hero.keyMetrics}
    entityChips={hero.entityChips}
    compact={hero.compact}
  />

  <!-- Main Content -->
  <CapacityPage />
</BaseLayout>
