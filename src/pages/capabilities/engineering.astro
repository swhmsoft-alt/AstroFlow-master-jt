---
/**
 * capabilities/engineering.astro
 *
 * Front-End Engineering Support & DFM Optimization for Titanium.
 * Google AIO-optimized page for procurement engineer search intent.
 * Entity network: DFM, CAD/CAM, Value Engineering, Metallurgy Consulting.
 *
 * Route: /capabilities/engineering/ (English, default)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import EngineeringPage from '../../components/capabilities/EngineeringPage.astro';
import { HERO_CONFIG } from '../../config/hero';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// ── Canonical URL ──
const canonicalURL = new URL('/capabilities/engineering/', Astro.site || 'https://cnc.bozemetal.com');
const hero = HERO_CONFIG['/capabilities/engineering'];
---

<BaseLayout
  title="Titanium Engineering Support & DFM Optimization Services | BOZE CNC Ti"
  description="Expert engineering consultation for titanium CNC machining. Specializing in Design for Manufacturing (DFM) review, 5-axis CAM simulation, and cost-out value engineering for aerospace and medical applications."
  canonicalURL={canonicalURL}
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/capabilities/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.capabilities')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.capabilities.engineering')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero Section -->
  <SubpageHero
    h1={hero.h1}
    badge={hero.badge}
    subtitle={hero.subtitle}
    keyMetrics={hero.keyMetrics}
    entityChips={hero.entityChips}
    compact={hero.compact}
  />

  <!-- Main Content -->
  <EngineeringPage />

  <!-- ════════════════════════════════════════════════════════════════
       Custom JSON-LD — Google AIO Entity Mapping
       Injected in addition to BaseLayout's auto-generated schema.
       ════════════════════════════════════════════════════════════════ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://cnc.bozemetal.com/capabilities/engineering/#webpage",
        "url": "https://cnc.bozemetal.com/capabilities/engineering/",
        "name": "Titanium Engineering Support & DFM Optimization Services",
        "description": "Expert engineering consultation for titanium CNC machining. Specializing in Design for Manufacturing (DFM) review, 5-axis CAM simulation, and cost-out value engineering.",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://cnc.bozemetal.com/#website",
          "url": "https://cnc.bozemetal.com/",
          "name": "BOZE CNC Titanium Machining"
        },
        "breadcrumb": {
          "@id": "https://cnc.bozemetal.com/capabilities/engineering/#breadcrumb"
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://cnc.bozemetal.com/capabilities/engineering/#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://cnc.bozemetal.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Capabilities",
            "item": "https://cnc.bozemetal.com/capabilities/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Engineering Support",
            "item": "https://cnc.bozemetal.com/capabilities/engineering/"
          }
        ]
      },
      {
        "@type": "ManufacturingBusiness",
        "@id": "https://cnc.bozemetal.com/#organization",
        "name": "BOZE CNC Metal",
        "url": "https://cnc.bozemetal.com/",
        "knowsAbout": [
          "Design for Manufacturing",
          "DFM Optimization",
          "CAD/CAM Programming",
          "Mastercam Simulation",
          "Titanium Metallurgy",
          "Value Engineering",
          "GD and T Blueprint Review"
        ]
      }
    ]
  })} />
</BaseLayout>
