---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import AboutPage from '../components/about/AboutPage.astro';
import { HERO_CONFIG } from '../config/hero';
---

<BaseLayout>
  <SubpageHero
    h1={HERO_CONFIG['/about'].h1}
    badge={HERO_CONFIG['/about'].badge}
    subtitle={HERO_CONFIG['/about'].subtitle}
  />

  <AboutPage />
</BaseLayout>
