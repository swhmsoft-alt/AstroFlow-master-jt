---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import CapacityDashboard from '../components/capabilities/CapacityDashboard.astro';
import EngineeringSupport from '../components/capabilities/EngineeringSupport.astro';
import QualityAndCertifications from '../components/capabilities/QualityAndCertifications.astro';
import InspectionLabGrid from '../components/capabilities/InspectionLabGrid.astro';
import TraceabilityFoundation from '../components/capabilities/TraceabilityFoundation.astro';
---

<BaseLayout title="Capabilities - BOZE CNC Ti">
  <!-- Hero -->
  <SubpageHero
    title="Technical"
    highlight="Capabilities"
    badge="Manufacturing Engineering Data Sheet"
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    subtitle="Certified precision manufacturing infrastructure — from micron-level CNC tolerancing to full material traceability. A detailed technical reference for procurement and engineering teams."
  />

  <!-- 1. Capacity Dashboard -->
  <CapacityDashboard />

  <!-- 2. Engineering Support -->
  <EngineeringSupport />

  <!-- 3. Quality & Certifications -->
  <QualityAndCertifications />

  <!-- 4. Inspection Lab Grid -->
  <InspectionLabGrid />

  <!-- 5. Traceability Foundation -->
  <TraceabilityFoundation />
</BaseLayout>
