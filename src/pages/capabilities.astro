---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../config/hero';
import CapacityDashboard from '../components/capabilities/CapacityDashboard.astro';
import EngineeringSupport from '../components/capabilities/EngineeringSupport.astro';
import QualityAndCertifications from '../components/capabilities/QualityAndCertifications.astro';
import InspectionLabGrid from '../components/capabilities/InspectionLabGrid.astro';
import TraceabilityFoundation from '../components/capabilities/TraceabilityFoundation.astro';
import AudienceHub from '../components/audience/AudienceHub.astro';
import ToleranceChecker from '../components/react/ToleranceChecker';
import SurfaceRoughnessComparator from '../components/react/SurfaceRoughnessComparator';
import GDTSymbolReference from '../components/react/GDTSymbolReference';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<BaseLayout>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.capabilities')}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <SubpageHero
    h1={HERO_CONFIG['/capabilities'].h1}
    badge={HERO_CONFIG['/capabilities'].badge}
    subtitle={HERO_CONFIG['/capabilities'].subtitle}
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    keyMetrics={HERO_CONFIG['/capabilities'].keyMetrics}
    entityChips={HERO_CONFIG['/capabilities'].entityChips}
    compact={HERO_CONFIG['/capabilities'].compact}
  />

  <!-- Tolerance Feasibility Checker Tool -->
  <section class="py-16" style="background: var(--theme-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
          CNC Tolerance Feasibility Checker
        </h2>
        <p class="text-lg max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          Select a feature type and enter your tolerance requirement — instantly see if it falls within our standard, precision, or ultra-precision capability bands.
        </p>
      </div>
      <ToleranceChecker client:load />
    </div>
  </section>

  <!-- Surface Roughness Comparator Tool -->
  <section class="py-16" style="background: color-mix(in srgb, var(--theme-surface) 50%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
          Surface Roughness Comparator
        </h2>
        <p class="text-lg max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          Compare surface finishes from mirror polish to as-rough — with Ra/Rz values, everyday object comparisons, and achievable processes.
        </p>
      </div>
      <SurfaceRoughnessComparator client:load />
    </div>
  </section>

  <!-- GD&T Symbol Reference Tool -->
  <section class="py-16" style="background: var(--theme-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
          GD&T Symbol Reference
        </h2>
        <p class="text-lg max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          Interactive reference for ASME Y14.5 GD&T symbols — form, orientation, location, profile, and runout controls with tolerance zone explanations and application guidance.
        </p>
      </div>
      <GDTSymbolReference client:load />
    </div>
  </section>

  <!-- 1. Capacity Dashboard -->
  <CapacityDashboard />

  <!-- 2. Engineering Support -->
  <EngineeringSupport />

  <!-- 3. Quality & Certifications -->
  <QualityAndCertifications />

  <!-- 4. Inspection Lab Grid -->
  <InspectionLabGrid />

  <!-- 5. Traceability Foundation -->
  <TraceabilityFoundation />

  <!-- Audience guidance -->
  <AudienceHub industry="capabilities" />

  <!-- ================= BSI 6-Dimension Capability Matrix =================
       Buyer Search Intelligence · 12-class canonical mapping per
       Hub-Mapping-First SOP. Inline cards give top-nav, footer, and
       parent-hub entry to all 4 new sub-pages. -->
  <section class="relative overflow-hidden" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <header class="max-w-3xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Capability Dimensions</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
          Six Dimensions of Our Titanium Machining Capability
        </h2>
        <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          Procurement teams evaluate suppliers across six decision dimensions. The four sub-pages below are deep-dives into the most-asked dimensions; the two existing components above cover capacity and quality on this page.
        </p>
      </header>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">Compliance</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Compliance & Certifications</h3>
          <p class="mt-2 text-sm" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">AS9100D / ISO 13485 / ASTM / EN 10204 3.1 / DFARS scope, 8 active compliance areas, document deliverables.</p>
          <a href="/capabilities/compliance/" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold" style="color: var(--theme-primary);">Explore Compliance Hub →</a>
        </article>

        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">Supplier Evaluation</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Supplier Evaluation</h3>
          <p class="mt-2 text-sm" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">7-dimension framework + 25-point scorecard + 9 Red/Yellow/Green triage signals + 8 self-disclosure Q&A.</p>
          <a href="/capabilities/supplier-evaluation/" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold" style="color: var(--theme-primary);">Apply the 7-Dim Framework →</a>
        </article>

        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">Lead Time</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Lead Time Guide</h3>
          <p class="mt-2 text-sm" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Sample (3-5 BD) / prototype (10-15 BD) / small-batch (15-25 BD) / production (25-45 BD) tier breakdown + 6 influence factors.</p>
          <a href="/capabilities/lead-time/" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold" style="color: var(--theme-primary);">View Lead Time Tiers →</a>
        </article>

        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: var(--theme-primary);">Logistics</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Logistics & Shipping</h3>
          <p class="mt-2 text-sm" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">Incoterms 2020 (EXW / FCA / FOB / CIF / DAP / DDP) + 5 packaging methods + freight + DFARS / REACH docs.</p>
          <a href="/capabilities/logistics/" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold" style="color: var(--theme-primary);">View Logistics Options →</a>
        </article>

        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">Capacity</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Capacity Dashboard</h3>
          <p class="mt-2 text-sm" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">120+ CNC machining centers, 5,000+ pcs/month titanium output, 16+ years experience — see Capacity Dashboard section above.</p>
        </article>

        <article class="rounded-2xl border p-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <p class="text-xs font-bold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">Quality</p>
          <h3 class="mt-2 text-lg font-bold" style="color: var(--theme-text);">Quality & Certifications</h3>
          <p class="mt-2 text-sm" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">CMM inspection, FAIR per AS9102, ISO 10360 metrology — see Quality & Certifications section above.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
