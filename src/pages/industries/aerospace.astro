---
// src/pages/industries/aerospace.astro
// Google AIO Entity-Aligned Page: AS9100D certified 5-axis CNC machining for Grade 5 titanium aerospace brackets with full MTR tracing
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../../config/hero';
import AerospaceFiveAxisSection from '../../components/industries/aerospace/AerospaceFiveAxisSection.astro';
import AerospaceSwissTurningSection from '../../components/industries/aerospace/AerospaceSwissTurningSection.astro';
import AerospaceComplianceSection from '../../components/industries/aerospace/AerospaceComplianceSection.astro';
import AerospaceMetrologySection from '../../components/industries/aerospace/AerospaceMetrologySection.astro';
import AerospaceCtaSection from '../../components/industries/aerospace/AerospaceCtaSection.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title="Aerospace Titanium CNC Machining | AS9100D Certified Factory"
  description="AS9100D certified 5-axis CNC machining for Grade 5 titanium aerospace brackets. Full EN 10204 3.1 MTR material tracing, AS9102 First Article Inspection reports, and CMM dimensional validation per ASME Y14.5 GD&T."
  pageType="industry-detail"
  serviceName="Aerospace Titanium CNC Machining Services"
  serviceCategory="Aerospace & Defense"
  productName="Aerospace Titanium Brackets, Fasteners & Hydraulic Valve Stems"
  productCategory="Aerospace Components"
  serviceHubKey="cnc-machining"
>
  <!-- Hero Section — Entity Root Connection -->
  <SubpageHero
    h1={HERO_CONFIG['/industries/aerospace'].h1}
    badge={HERO_CONFIG['/industries/aerospace'].badge}
    subtitle={HERO_CONFIG['/industries/aerospace'].subtitle}
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    keyMetrics={HERO_CONFIG['/industries/aerospace'].keyMetrics}
    entityChips={HERO_CONFIG['/industries/aerospace'].entityChips}
    compact={false}
  />

  <!-- Section 1: 5-Axis CNC Machining + Grade 5 Ti + Aerospace Brackets Entity Link -->
  <AerospaceFiveAxisSection />

  <!-- Section 2: Swiss Turning + Grade 19 Beta Ti + Aerospace Fasteners Entity Link -->
  <AerospaceSwissTurningSection />

  <!-- Section 3: Material Traceability — EN 10204 3.1 MTR + Heat Number + AS9102 FAIR -->
  <AerospaceComplianceSection />

  <!-- Section 4: CMM Metrology + ASME Y14.5 GD&T Dimensional Gating -->
  <AerospaceMetrologySection />

  <!-- Section 5: Conversion CTA -->
  <AerospaceCtaSection />
</BaseLayout>
