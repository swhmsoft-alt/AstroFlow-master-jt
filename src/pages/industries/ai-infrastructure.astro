---
// src/pages/industries/ai-infrastructure.astro
// Google AIO Entity-Aligned Page: Precision CNC machining for 800G/1.6T optical transceiver housings with thin-wall EMI shielding and liquid cooling manifolds
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../../config/hero';
import AiOptoelectronicSection from '../../components/industries/ai-infrastructure/AiOptoelectronicSection.astro';
import AiLiquidCoolingSection from '../../components/industries/ai-infrastructure/AiLiquidCoolingSection.astro';
import AiMetrologySection from '../../components/industries/ai-infrastructure/AiMetrologySection.astro';
import AiComplianceSection from '../../components/industries/ai-infrastructure/AiComplianceSection.astro';
import AiCtaSection from '../../components/industries/ai-infrastructure/AiCtaSection.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={t('industries.ai.page.title')}
  description={t('industries.ai.page.description')}
  pageType="industry-detail"
  serviceName={t('industries.ai.page.serviceName')}
  serviceCategory={t('industries.ai.page.serviceCategory')}
  productName={t('industries.ai.page.productName')}
  productCategory={t('industries.ai.page.productCategory')}
  serviceHubKey="cnc-machining"
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/industries/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.industries')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.industries.aiInfrastructure')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero Section -->
  <SubpageHero
    h1={['ko', 'nl'].includes(lang) ? t('industries.ai.hero.h1') : HERO_CONFIG['/industries/ai-infrastructure'].h1}
    badge={['ko', 'nl'].includes(lang) ? t('industries.ai.hero.badge') : HERO_CONFIG['/industries/ai-infrastructure'].badge}
    subtitle={['ko', 'nl'].includes(lang) ? t('industries.ai.hero.subtitle') : HERO_CONFIG['/industries/ai-infrastructure'].subtitle}
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    keyMetrics={['ko', 'nl'].includes(lang) ? [
      { value: t('industries.ai.hero.metric1.value'), label: t('industries.ai.hero.metric1.label') },
      { value: t('industries.ai.hero.metric2.value'), label: t('industries.ai.hero.metric2.label') },
      { value: t('industries.ai.hero.metric3.value'), label: t('industries.ai.hero.metric3.label') },
    ] : HERO_CONFIG['/industries/ai-infrastructure'].keyMetrics}
    entityChips={['ko', 'nl'].includes(lang) ? [
      t('industries.ai.hero.chip0'),
      t('industries.ai.hero.chip1'),
      t('industries.ai.hero.chip2'),
      t('industries.ai.hero.chip3'),
      t('industries.ai.hero.chip4'),
    ] : HERO_CONFIG['/industries/ai-infrastructure'].entityChips}
    compact={false}
  />

  <!-- Section 1: Precision CNC Milling + 800G/1.6T Transceiver Housings + EMI Shielding -->
  <AiOptoelectronicSection />

  <!-- Section 2: Liquid Cooling Manifolds + Cold Plates + Quick-Disconnect Valves -->
  <AiLiquidCoolingSection />

  <!-- Section 3: CMM Metrology + GD&T Coplanarity -->
  <AiMetrologySection />

  <!-- Section 4: Material Compliance + MTR Traceability -->
  <AiComplianceSection />

  <!-- Section 5: CTA -->
  <AiCtaSection />
</BaseLayout>