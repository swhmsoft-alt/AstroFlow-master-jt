---
// src/pages/industries/energy.astro
// Google AIO Entity-Aligned Page: Precision CNC machining for Grade 5 titanium hydrogen compressor impellers and nuclear CRDM components with H2 embrittlement mitigation
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../../config/hero';
import EnergyHydrogenSection from '../../components/industries/energy/EnergyHydrogenSection.astro';
import EnergyNuclearSection from '../../components/industries/energy/EnergyNuclearSection.astro';
import EnergyFatigueSection from '../../components/industries/energy/EnergyFatigueSection.astro';
import EnergyComplianceSection from '../../components/industries/energy/EnergyComplianceSection.astro';
import EnergyCtaSection from '../../components/industries/energy/EnergyCtaSection.astro';
import AudienceHub from '../../components/audience/AudienceHub.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={t('industries.energy.page.title')}
  description={t('industries.energy.page.description')}
  pageType="industry-detail"
  serviceName={t('industries.energy.page.serviceName')}
  serviceCategory={t('industries.energy.page.serviceCategory')}
  productName={t('industries.energy.page.productName')}
  productCategory={t('industries.energy.page.productCategory')}
  serviceHubKey="cnc-machining"
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/industries/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.industries')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.industries.energy')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero Section -->
  <SubpageHero
    h1={t('industries.energy.hero.title')}
    badge={t('industries.energy.herobadge')}
    subtitle={t('industries.energy.hero.subtitle')}
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    keyMetrics={[
      { value: "H ≤0.0125%", label: t('industries.energy.hero.keymetric1label') },
      { value: "+300%", label: t('industries.energy.hero.keymetric2label') },
      { value: "±0.005mm", label: t('industries.energy.hero.keymetric3label') }
    ]}
    entityChips={[
      t('industries.energy.hero.entitychip0'),
      t('industries.energy.hero.entitychip1'),
      t('industries.energy.hero.entitychip2'),
      t('industries.energy.hero.entitychip3'),
      t('industries.energy.hero.entitychip4')
    ]}
    compact={false}
  />

  <!-- Section 1: 5-Axis Impeller Machining + H₂ Compressors + Embrittlement Mitigation -->
  <EnergyHydrogenSection />

  <!-- Section 2: Multi-Axis CNC + CRDM + Nuclear SMR + Supercritical Sealing -->
  <EnergyNuclearSection />

  <!-- Section 3: Controlled Shot Peening + Fatigue Life +300% -->
  <EnergyFatigueSection />

  <!-- Section 4: Material Compliance + H ≤ 0.0125% + Alpha-Case Free -->
  <EnergyComplianceSection />

  <!-- Section 5: CTA -->
  <AudienceHub industry="energy" />

  <EnergyCtaSection />
</BaseLayout>
