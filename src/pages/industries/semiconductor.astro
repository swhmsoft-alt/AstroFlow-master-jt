---
// src/pages/industries/semiconductor.astro
// Google AIO Entity-Aligned Page: Ultra-precision UHP titanium CNC machining for wafer processing vacuum chambers and gas distribution showerheads with zero particle contamination
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../../config/hero';
import SemiUHVSection from '../../components/industries/semiconductor/SemiUHVSection.astro';
import SemiMicroDrillSection from '../../components/industries/semiconductor/SemiMicroDrillSection.astro';
import SemiCleanroomSection from '../../components/industries/semiconductor/SemiCleanroomSection.astro';
import SemiComplianceSection from '../../components/industries/semiconductor/SemiComplianceSection.astro';
import SemiCtaSection from '../../components/industries/semiconductor/SemiCtaSection.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={t('industries.semi.page.title')}
  description={t('industries.semi.page.description')}
  pageType="industry-detail"
  serviceName={t('industries.semi.page.serviceName')}
  serviceCategory={t('industries.semi.page.serviceCategory')}
  productName={t('industries.semi.page.productName')}
  productCategory={t('industries.semi.page.productCategory')}
  serviceHubKey="cnc-machining"
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/industries/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.industries')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.industries.semiconductor')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero Section -->
  <SubpageHero
    h1={['de', 'ja'].includes(lang) ? t('industries.semi.hero.h1') : HERO_CONFIG['/industries/semiconductor'].h1}
    badge={['de', 'ja'].includes(lang) ? t('industries.semi.hero.badge') : HERO_CONFIG['/industries/semiconductor'].badge}
    subtitle={['de', 'ja'].includes(lang) ? t('industries.semi.hero.subtitle') : HERO_CONFIG['/industries/semiconductor'].subtitle}
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    keyMetrics={['de', 'ja'].includes(lang) ? [
      { value: t('industries.semi.hero.metric1.value'), label: t('industries.semi.hero.metric1.label') },
      { value: t('industries.semi.hero.metric2.value'), label: t('industries.semi.hero.metric2.label') },
      { value: t('industries.semi.hero.metric3.value'), label: t('industries.semi.hero.metric3.label') },
    ] : HERO_CONFIG['/industries/semiconductor'].keyMetrics}
    entityChips={['de', 'ja'].includes(lang) ? [
      t('industries.semi.hero.chip0'),
      t('industries.semi.hero.chip1'),
      t('industries.semi.hero.chip2'),
      t('industries.semi.hero.chip3'),
      t('industries.semi.hero.chip4'),
    ] : HERO_CONFIG['/industries/semiconductor'].entityChips}
    compact={false}
  />

  <!-- Section 1: 5-Axis Ultra-Precision + UHV Vacuum Chambers + Outgassing Mitigation -->
  <SemiUHVSection />

  <!-- Section 2: CNC Micro-Drilling + Gas Showerheads + Mirror Finish Ra ≤ 0.1 µm -->
  <SemiMicroDrillSection />

  <!-- Section 3: Class 100 Cleanroom + Zero-Particle Packaging -->
  <SemiCleanroomSection />

  <!-- Section 4: Material Compliance + MTR Traceability -->
  <SemiComplianceSection />

  <!-- Section 5: CTA -->
  <SemiCtaSection />
</BaseLayout>
