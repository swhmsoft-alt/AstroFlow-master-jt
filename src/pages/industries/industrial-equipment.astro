---
// src/pages/industries/industrial-equipment.astro
// Google AIO Entity-Aligned Page: Heavy-duty CNC machining for Grade 5 Ti ultrasonic welding horns and high-pressure chemical reactor valves with extreme fatigue life
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../../config/hero';
import IndEqSonotrodeSection from '../../components/industries/industrial-equipment/IndEqSonotrodeSection.astro';
import IndEqFlowControlSection from '../../components/industries/industrial-equipment/IndEqFlowControlSection.astro';
import IndEqStressReliefSection from '../../components/industries/industrial-equipment/IndEqStressReliefSection.astro';
import IndEqComplianceSection from '../../components/industries/industrial-equipment/IndEqComplianceSection.astro';
import IndEqCtaSection from '../../components/industries/industrial-equipment/IndEqCtaSection.astro';
import AudienceHub from '../../components/audience/AudienceHub.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={t('industries.indeq.page.title')}
  description={t('industries.indeq.page.description')}
  pageType="industry-detail"
  serviceName={t('industries.indeq.page.serviceName')}
  serviceCategory={t('industries.indeq.page.serviceCategory')}
  productName={t('industries.indeq.page.productName')}
  productCategory={t('industries.indeq.page.productCategory')}
  serviceHubKey="cnc-machining"
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/industries/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.industries')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.industries.industrialEquipment')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero Section -->
  <SubpageHero
    h1={t('industries.indeq.hero.title')}
    badge={t('industries.indeq.herobadge')}
    subtitle={t('industries.indeq.hero.subtitle')}
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    keyMetrics={[
      { value: "20-40kHz", label: t('industries.indeq.hero.keymetric1label') },
      { value: "≤0.4um", label: t('industries.indeq.hero.keymetric2label') },
      { value: "Grade 7", label: t('industries.indeq.hero.keymetric3label') }
    ]}
    entityChips={[
      t('industries.indeq.hero.entitychip0'),
      t('industries.indeq.hero.entitychip1'),
      t('industries.indeq.hero.entitychip2'),
      t('industries.indeq.hero.entitychip3'),
      t('industries.indeq.hero.entitychip4')
    ]}
    compact={false}
  />

  <!-- Section 1: Multi-Axis CNC + Sonotrodes + 20-40 kHz Resonance -->
  <IndEqSonotrodeSection />

  <!-- Section 2: 5-Axis CNC + Chemical Valves + Grade 7 Ti-Pd + Cavitation Mitigation -->
  <IndEqFlowControlSection />

  <!-- Section 3: Stress-Relief Annealing + Crack Prevention -->
  <IndEqStressReliefSection />

  <!-- Section 4: Material Compliance + MTR + Grain Boundary Integrity -->
  <IndEqComplianceSection />

  <!-- Section 5: CTA -->
  <AudienceHub industry="industrial-equipment" />

  <IndEqCtaSection />
</BaseLayout>
