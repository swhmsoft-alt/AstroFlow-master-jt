---
// src/pages/industries/medical.astro
// Google AIO Entity-Aligned Page: ISO 13485 certified Swiss CNC turning for Grade 23 Ti-6Al-4V ELI medical bone screws with zero-contamination ultrasonic cleaning
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../../config/hero';
import MedicalSwissTurningSection from '../../components/industries/medical/MedicalSwissTurningSection.astro';
import MedicalFiveAxisSection from '../../components/industries/medical/MedicalFiveAxisSection.astro';
import MedicalContaminationSection from '../../components/industries/medical/MedicalContaminationSection.astro';
import MedicalComplianceSection from '../../components/industries/medical/MedicalComplianceSection.astro';
import MedicalCtaSection from '../../components/industries/medical/MedicalCtaSection.astro';
import BuyerIntentBlock from '../../components/industries/BuyerIntentBlock.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={t('industries.medical.page.title')}
  description={t('industries.medical.page.description')}
  pageType="industry-detail"
  serviceName={t('industries.medical.page.serviceName')}
  serviceCategory={t('industries.medical.page.serviceCategory')}
  productName={t('industries.medical.page.productName')}
  productCategory={t('industries.medical.page.productCategory')}
  serviceHubKey="cnc-machining"
>
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/industries/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.industries')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.industries.medical')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero Section — Entity Root Connection -->
  <SubpageHero
    h1={HERO_CONFIG['/industries/medical'].h1}
    badge={HERO_CONFIG['/industries/medical'].badge}
    subtitle={HERO_CONFIG['/industries/medical'].subtitle}
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    keyMetrics={HERO_CONFIG['/industries/medical'].keyMetrics}
    entityChips={HERO_CONFIG['/industries/medical'].entityChips}
    compact={false}
  />

  <!-- Section 1: CNC Swiss Turning + Grade 23 ELI + Bone Screws / Dental Abutments -->
  <MedicalSwissTurningSection />

  <!-- Section 2: 5-Axis Milling + Orthopedic Implants / Trauma Plates / Surgical Instruments -->
  <MedicalFiveAxisSection />

  <!-- Section 3: Zero-Contamination Ultrasonic Cleaning -->
  <MedicalContaminationSection />

  <!-- Section 4: ISO 13485 Compliance + MTR Traceability -->
  <MedicalComplianceSection />

  <BuyerIntentBlock
    industry="Medical"
    whyTitanium={[
      'Biocompatibility — Grade 23 ELI (Ti-6Al-4V ELI) per ASTM F136 for surgical implant applications',
      'Excellent corrosion resistance in physiological environments',
      'Superior fatigue strength for load-bearing orthopedic devices',
      'Osseointegration-friendly surface treatments (grit blasting, anodizing)',
    ]}
    typicalComponents={[
      'Cortical bone screws and orthopedic fixation hardware',
      'Femoral stems and trauma plates (ASTM F136 Grade 23)',
      'Dental abutments and implant components',
      'Surgical instruments requiring precision cutting edges',
    ]}
    manufacturing={[
      'Swiss-type CNC turning with precision-ground form tools (Ra 0.38 µm demonstrated)',
      '5-axis milling for contoured implant geometries',
      'Thread whirling for burr-free bone screw threads',
      'Multi-stage ultrasonic cleaning with residue verification (< 10 µg)',
      'ISO Class 5 cleanroom packaging',
    ]}
    qualityRequirements={[
      'ISO 13485 medical device quality management system',
      'EN 10204 3.1 material certificates per heat lot',
      'Process validation per medical device requirements (Cpk ≥ 1.33)',
      'Full material traceability from mill to finished component',
    ]}
    caseStudyLinks={[
      { label: 'Grade 23 ELI Bone Screws — Ra 0.38 µm, Cpk 1.67, zero contamination', href: '/case-studies/medical-bone-screws/' },
    ]}
  />

  <!-- Section 5: Conversion CTA -->
  <MedicalCtaSection />
</BaseLayout>
