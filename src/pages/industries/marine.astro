---
// src/pages/industries/marine.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../../components/ui/SubpageHero.astro';
import { HERO_CONFIG } from '../../config/hero';
import MarineSubseaSection from '../../components/industries/marine/MarineSubseaSection.astro';
import MarineCorrosionSection from '../../components/industries/marine/MarineCorrosionSection.astro';
import MarineValidationSection from '../../components/industries/marine/MarineValidationSection.astro';
import MarineComplianceSection from '../../components/industries/marine/MarineComplianceSection.astro';
import MarineCtaSection from '../../components/industries/marine/MarineCtaSection.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={t('industries.marine.page.title')}
  description={t('industries.marine.page.description')}
  pageType="industry-detail"
  serviceName={t('industries.marine.page.serviceName')}
  serviceCategory={t('industries.marine.page.serviceCategory')}
  productName={t('industries.marine.page.productName')}
  productCategory={t('industries.marine.page.productCategory')}
  serviceHubKey="cnc-machining"
>
  <!-- Hero Section -->
  <SubpageHero
    h1={['ar', 'de', 'es', 'fr', 'it', 'ko', 'nl', 'ja', 'pl', 'pt', 'ru'].includes(lang) ? t('industries.marine.hero.h1') : HERO_CONFIG['/industries/marine'].h1}
    badge={['ar', 'de', 'es', 'fr', 'it', 'ko', 'nl', 'ja', 'pl', 'pt', 'ru'].includes(lang) ? t('industries.marine.hero.badge') : HERO_CONFIG['/industries/marine'].badge}
    subtitle={['ar', 'de', 'es', 'fr', 'it', 'ko', 'nl', 'ja', 'pl', 'pt', 'ru'].includes(lang) ? t('industries.marine.hero.subtitle') : HERO_CONFIG['/industries/marine'].subtitle}
    badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
    keyMetrics={['ar', 'de', 'es', 'fr', 'it', 'ko', 'nl', 'ja', 'pl', 'pt', 'ru'].includes(lang) ? [
      { value: t('industries.marine.hero.metric1.value'), label: t('industries.marine.hero.metric1.label') },
      { value: t('industries.marine.hero.metric2.value'), label: t('industries.marine.hero.metric2.label') },
      { value: t('industries.marine.hero.metric3.value'), label: t('industries.marine.hero.metric3.label') },
    ] : HERO_CONFIG['/industries/marine'].keyMetrics}
    entityChips={['ar', 'de', 'es', 'fr', 'it', 'ko', 'nl', 'ja', 'pl', 'pt', 'ru'].includes(lang) ? [
      t('industries.marine.hero.chip0'),
      t('industries.marine.hero.chip1'),
      t('industries.marine.hero.chip2'),
      t('industries.marine.hero.chip3'),
      t('industries.marine.hero.chip4'),
    ] : HERO_CONFIG['/industries/marine'].entityChips}
    compact={false}
  />

  <MarineSubseaSection />
  <MarineCorrosionSection />
  <MarineValidationSection />
  <MarineComplianceSection />
  <MarineCtaSection />
</BaseLayout>