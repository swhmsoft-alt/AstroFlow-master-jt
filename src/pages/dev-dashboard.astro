---
/**
 * src/pages/dev-dashboard.astro
 * ─────────────────────────────────────────────────────────────────────
 *  Local Dev Dashboard — SEO/GEO tool launcher.
 *  PROD-safe: redirects to /404 at build time.  Dev-only execution.
 *
 *  Architecture:
 *    • Server side: render static card skeleton from tools-manifest.
 *    • Client side: fetch /api/list-tools for live stats + attach
 *      click handlers that POST /api/run-tool and stream NDJSON
 *      output into the global log panel.
 * ─────────────────────────────────────────────────────────────────────
 */
import { TOOLS, GROUP_LABELS, type ToolGroup } from '../lib/dashboard/tools-manifest';

// Block this page entirely in production builds.
if (import.meta.env.PROD) {
  return Astro.redirect('/404');
}

const groups: ToolGroup[] = ['keywords', 'internal-links', 'quality', 'assets'];
const toolCount = TOOLS.length;
---

<html lang="zh-CN" data-theme="legacy-original">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>🛠️ Dev Dashboard · SEO & GEO 工具箱</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased font-sans">
    <!-- ─────────── HEADER ─────────── -->
    <header class="border-b border-amber-500/30 bg-gradient-to-b from-amber-950/30 to-zinc-950">
      <div class="mx-auto max-w-7xl px-6 py-8">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div>
            <h1 class="text-3xl font-bold tracking-tight">
              🛠️ SEO &amp; GEO 开发者工具箱
            </h1>
            <p class="mt-2 text-zinc-400 text-sm">
              本地仪表盘 · <span data-bind="tool-count">{toolCount}</span> 个工具 · 仅在
              <code class="px-1.5 py-0.5 rounded bg-zinc-800 text-amber-300 text-xs">astro dev</code>
              下可用，PROD 自动重定向 404
            </p>
          </div>
          <div
            id="env-badge"
            class="px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/40 text-amber-300 text-xs font-mono"
          >
            <span class="inline-block w-2 h-2 rounded-full bg-amber-400 mr-2 animate-pulse"></span>
            DEV MODE
          </div>
        </div>
      </div>
    </header>

    <!-- ─────────── TOOL SECTIONS ─────────── -->
    <main class="mx-auto max-w-7xl px-6 py-8 space-y-10">
      {
        groups.map((group) => {
          const groupTools = TOOLS.filter((t) => t.group === group);
          if (groupTools.length === 0) return null;
          const meta = GROUP_LABELS[group];
          return (
            <section>
              <div class="mb-4 flex items-baseline gap-3">
                <h2 class="text-xl font-semibold text-zinc-100">
                  <span class="mr-2">{meta.icon}</span>{meta.label}
                </h2>
                <span class="text-xs text-zinc-500">{meta.subtitle}</span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                {groupTools.map((tool) => {
                  const dangerStyles = {
                    safe:   'border-zinc-700 hover:border-emerald-500/60',
                    caution:'border-amber-700/60 hover:border-amber-400',
                    danger: 'border-rose-800/80 hover:border-rose-500',
                  }[tool.dangerLevel];
                  const badgeStyles = {
                    safe:   'bg-emerald-500/10 text-emerald-300 border-emerald-500/30',
                    caution:'bg-amber-500/10 text-amber-300 border-amber-500/30',
                    danger: 'bg-rose-500/10 text-rose-300 border-rose-500/30',
                  }[tool.dangerLevel];
                  const badgeLabel = {
                    safe: '✓ 安全',
                    caution: '⚠ 谨慎',
                    danger: '☠ 危险',
                  }[tool.dangerLevel];
                  const btnStyles = {
                    safe:   'bg-emerald-600 hover:bg-emerald-500',
                    caution:'bg-amber-600 hover:bg-amber-500',
                    danger: 'bg-rose-600 hover:bg-rose-500',
                  }[tool.dangerLevel];
                  return (
                    <article
                      class={`tool-card rounded-xl border bg-zinc-900/70 backdrop-blur p-5 transition-all hover:shadow-lg ${dangerStyles}`}
                      data-tool-id={tool.id}
                      data-danger={tool.dangerLevel}
                      data-command={tool.command}
                    >
                      <header class="flex items-start justify-between gap-2 mb-2">
                        <h3 class="text-base font-semibold text-zinc-100 leading-snug">
                          <span class="mr-1.5">{tool.icon}</span>{tool.title}
                        </h3>
                        <span class={`shrink-0 text-[10px] px-1.5 py-0.5 rounded border font-mono ${badgeStyles}`}>
                          {badgeLabel}
                        </span>
                      </header>

                      <p class="text-sm text-zinc-400 mb-3 min-h-[2.5rem]">{tool.description}</p>

                      {tool.args && tool.args.length > 0 && (
                        <div class="space-y-2 mb-3">
                          {tool.args.map((arg) => (
                            <label class="block text-xs">
                              <span class="text-zinc-500 font-medium">{arg.label}</span>
                              {arg.type === 'select' ? (
                                <select
                                  data-arg={arg.flag}
                                  class="mt-1 w-full bg-zinc-950 border border-zinc-700 rounded px-2 py-1.5 text-zinc-100 text-xs focus:border-amber-500 focus:outline-none"
                                >
                                  {arg.options?.map((opt) => (
                                    <option value={opt} selected={opt === arg.default}>
                                      {opt}
                                    </option>
                                  ))}
                                </select>
                              ) : arg.type === 'boolean' ? (
                                <label class="mt-1 flex items-center gap-2 text-zinc-300 cursor-pointer">
                                  <input
                                    type="checkbox"
                                    data-arg={arg.flag}
                                    class="rounded border-zinc-700 bg-zinc-950 text-amber-500 focus:ring-amber-500"
                                  />
                                  <span class="text-[11px] text-zinc-500">{arg.hint || ''}</span>
                                </label>
                              ) : (
                                <input
                                  type="text"
                                  data-arg={arg.flag}
                                  value={arg.default ?? ''}
                                  placeholder={arg.placeholder ?? ''}
                                  class="mt-1 w-full bg-zinc-950 border border-zinc-700 rounded px-2 py-1.5 text-zinc-100 text-xs focus:border-amber-500 focus:outline-none"
                                />
                              )}
                              {arg.hint && arg.type !== 'boolean' && (
                                <span class="block mt-0.5 text-[10px] text-zinc-600">{arg.hint}</span>
                              )}
                            </label>
                          ))}
                        </div>
                      )}

                      <div class="flex items-center gap-2 mt-3">
                        <button
                          class={`run-btn flex-1 px-3 py-2 rounded-md text-sm font-medium text-white transition-colors disabled:opacity-40 disabled:cursor-not-allowed ${btnStyles}`}
                          data-action="run"
                        >
                          <span data-bind="btn-label">▶ 运行</span>
                        </button>
                        <span
                          data-bind="status-pill"
                          class="shrink-0 text-[10px] px-2 py-1 rounded bg-zinc-800 text-zinc-500 font-mono"
                        >
                          空闲
                        </span>
                      </div>

                      <footer class="mt-3 pt-3 border-t border-zinc-800/60 flex items-center justify-between text-[10px] text-zinc-600">
                        <span data-bind="last-run" class="font-mono">从未运行</span>
                        <span data-bind="duration" class="font-mono"></span>
                      </footer>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })
      }
    </main>

    <!-- ─────────── GLOBAL LOG CONSOLE ─────────── -->
    <section class="fixed bottom-0 left-0 right-0 z-40 bg-zinc-950/95 backdrop-blur border-t border-zinc-800 shadow-2xl">
      <div class="mx-auto max-w-7xl px-6 py-3">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-3">
            <h3 class="text-sm font-semibold text-zinc-300">📟 运行日志</h3>
            <span data-bind="active-tool" class="text-xs text-zinc-500 font-mono">空闲</span>
          </div>
          <div class="flex items-center gap-2">
            <button
              id="copy-log"
              class="text-xs px-2 py-1 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition-colors"
            >
              📋 复制
            </button>
            <button
              id="clear-log"
              class="text-xs px-2 py-1 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition-colors"
            >
              🗑 清空
            </button>
            <button
              id="toggle-log"
              class="text-xs px-2 py-1 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition-colors"
            >
              收起 ▼
            </button>
          </div>
        </div>
        <pre
          id="log"
          class="bg-black rounded-md p-3 text-xs font-mono h-48 overflow-auto text-emerald-400 border border-zinc-800 leading-relaxed whitespace-pre-wrap break-all"
        ><span class="text-zinc-600">等待指令… 点击任意卡片上的「▶ 运行」按钮启动工具。</span></pre>
      </div>
    </section>

    <!-- Bottom padding so footer doesn't cover content -->
    <div class="h-64"></div>

    <!-- ─────────── CONFIRMATION MODAL ─────────── -->
    <div
      id="confirm-modal"
      class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4"
    >
      <div class="bg-zinc-900 border border-rose-500/50 rounded-xl max-w-md w-full p-6 shadow-2xl">
        <h3 class="text-lg font-bold text-rose-300 mb-2">⚠ 危险操作确认</h3>
        <p id="confirm-title" class="text-sm text-zinc-300 mb-3"></p>
        <p id="confirm-warning" class="text-xs text-zinc-400 mb-4 p-3 bg-zinc-950 rounded border border-zinc-800"></p>
        <p class="text-xs text-zinc-500 mb-4 font-mono break-all">
          <span class="text-zinc-600">即将执行：</span>
          <code id="confirm-cmd" class="text-amber-300"></code>
        </p>
        <div class="flex justify-end gap-2">
          <button
            id="confirm-cancel"
            class="px-4 py-2 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-sm"
          >
            取消
          </button>
          <button
            id="confirm-ok"
            class="px-4 py-2 rounded bg-rose-600 hover:bg-rose-500 text-white text-sm font-medium"
          >
            我已了解，继续执行
          </button>
        </div>
      </div>
    </div>

    <!-- ─────────── CLIENT LOGIC ─────────── -->
    <script>
      import { TOOLS, GROUP_LABELS } from '../lib/dashboard/tools-manifest';

      type DangerLevel = 'safe' | 'caution' | 'danger';

      interface FileStat {
        path: string;
        exists: boolean;
        sizeBytes: number | null;
        mtimeMs: number | null;
        ageLabel: string | null;
      }

      interface ToolFromApi {
        id: string;
        group: keyof typeof GROUP_LABELS;
        title: string;
        description: string;
        icon: string;
        dangerLevel: DangerLevel;
        estimatedDurationMs: number;
        args: any[];
        warning: string | null;
        outputIndicatorStats: FileStat[];
      }

      // ── localStorage helpers ────────────────────────────────────────
      const LS_KEY = 'dev-dashboard:state:v1';

      interface PersistedState {
        lastRuns: Record<string, { ts: number; status: 'success' | 'error'; durationMs: number }>;
      }

      function loadState(): PersistedState {
        try {
          return JSON.parse(localStorage.getItem(LS_KEY) || '{"lastRuns":{}}');
        } catch {
          return { lastRuns: {} };
        }
      }

      function saveState(s: PersistedState) {
        try { localStorage.setItem(LS_KEY, JSON.stringify(s)); } catch { /* quota */ }
      }

      // ── DOM helpers ─────────────────────────────────────────────────
      const $ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) =>
        root.querySelector(sel) as T | null;
      const $$ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) =>
        Array.from(root.querySelectorAll(sel)) as T[];

      const log = $('#log')!;
      const activeToolLabel = $('[data-bind="active-tool"]')!;
      const confirmModal = $('#confirm-modal')!;

      function appendLog(text: string, cls = 'text-emerald-400') {
        // Replace the placeholder text if this is the first write.
        if (log.textContent?.startsWith('等待指令')) log.textContent = '';
        const span = document.createElement('span');
        span.className = cls;
        span.textContent = text;
        log.appendChild(span);
        log.scrollTop = log.scrollHeight;
      }

      function setCardStatus(card: HTMLElement, status: 'idle' | 'running' | 'success' | 'error', durationMs = 0) {
        const pill = $('[data-bind="status-pill"]', card)!;
        const label = $('[data-bind="btn-label"]', card)!;
        const dur = $('[data-bind="duration"]', card)!;
        pill.className = 'shrink-0 text-[10px] px-2 py-1 rounded font-mono ';
        if (status === 'running') {
          pill.className += 'bg-amber-500/20 text-amber-300 border border-amber-500/40';
          pill.textContent = '运行中…';
          label.textContent = '⏳ 运行中';
          dur.textContent = '';
        } else if (status === 'success') {
          pill.className += 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
          pill.textContent = '✓ 成功';
          label.textContent = '▶ 再次运行';
          dur.textContent = `${(durationMs / 1000).toFixed(1)}s`;
        } else if (status === 'error') {
          pill.className += 'bg-rose-500/20 text-rose-300 border border-rose-500/40';
          pill.textContent = '✗ 失败';
          label.textContent = '▶ 重试';
          dur.textContent = `${(durationMs / 1000).toFixed(1)}s`;
        } else {
          pill.className += 'bg-zinc-800 text-zinc-500';
          pill.textContent = '空闲';
          label.textContent = '▶ 运行';
          dur.textContent = '';
        }
      }

      // ── Confirmation modal ──────────────────────────────────────────
      let pendingConfirm: (() => void) | null = null;

      function showConfirm(opts: {
        title: string;
        warning: string;
        command: string;
      }): Promise<boolean> {
        return new Promise((resolve) => {
          $('#confirm-title')!.textContent = opts.title;
          $('#confirm-warning')!.textContent = opts.warning;
          $('#confirm-cmd')!.textContent = opts.command;
          confirmModal.classList.remove('hidden');
          pendingConfirm = () => resolve(true);
          const ok = $('#confirm-ok')!;
          const cancel = $('#confirm-cancel')!;
          const handler = (e: Event) => {
            const accepted = e.target === ok;
            ok.removeEventListener('click', handler);
            cancel.removeEventListener('click', handler);
            confirmModal.classList.add('hidden');
            pendingConfirm = null;
            resolve(accepted);
          };
          ok.addEventListener('click', handler);
          cancel.addEventListener('click', handler);
        });
      }

      // ── Fetch with NDJSON streaming ─────────────────────────────────
      async function runTool(card: HTMLElement) {
        const toolId = card.dataset.toolId!;
        const danger = card.dataset.danger as DangerLevel;
        const commandTpl = card.dataset.command!;
        const args: Record<string, string> = {};
        $$('[data-arg]', card).forEach((el) => {
          const flag = (el as HTMLElement).dataset.arg!;
          if (el instanceof HTMLInputElement && el.type === 'checkbox') {
            args[flag] = el.checked ? 'true' : 'false';
          } else if (el instanceof HTMLSelectElement || el instanceof HTMLInputElement) {
            args[flag] = el.value;
          }
        });

        const def = TOOLS.find((t) => t.id === toolId)!;
        const titleText = `${def.icon} ${def.title}`;
        activeToolLabel.textContent = `执行中：${def.title}`;

        // For caution/danger tools, show confirmation modal first.
        if (danger !== 'safe') {
          const ok = await showConfirm({
            title: `即将执行：${titleText}`,
            warning: def.warning || '此操作可能修改项目文件或调用外部 API。',
            command: commandTpl,
          });
          if (!ok) {
            activeToolLabel.textContent = '已取消';
            return;
          }
        }

        // Disable all buttons to prevent concurrent runs.
        $$('.run-btn').forEach((b) => ((b as HTMLButtonElement).disabled = true));
        setCardStatus(card, 'running');
        appendLog(`\n━━━ ${titleText} ━━━\n`, 'text-amber-300 font-bold');

        const startedAt = Date.now();
        try {
          const res = await fetch('/api/run-tool', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tool: toolId, args }),
          });

          if (!res.ok || !res.body) {
            const text = await res.text();
            appendLog(`✗ HTTP ${res.status}: ${text}\n`, 'text-rose-400');
            setCardStatus(card, 'error', Date.now() - startedAt);
            return;
          }

          // Read NDJSON stream.
          const reader = res.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';
          let exitInfo: { code: number | null; signal: string | null; durationMs: number } | null = null;

          while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split('\n');
            buffer = lines.pop() || '';

            for (const line of lines) {
              if (!line.trim()) continue;
              try {
                const ev = JSON.parse(line);
                if (ev.type === 'meta') {
                  appendLog(`$ ${ev.command}\n`, 'text-zinc-500');
                } else if (ev.type === 'stdout') {
                  appendLog(ev.data, 'text-emerald-300');
                } else if (ev.type === 'stderr') {
                  appendLog(ev.data, 'text-rose-300');
                } else if (ev.type === 'error') {
                  appendLog(`✗ ${ev.data}\n`, 'text-rose-400');
                } else if (ev.type === 'exit') {
                  exitInfo = { code: ev.code, signal: ev.signal, durationMs: ev.durationMs };
                }
              } catch { /* ignore malformed line */ }
            }
          }

          const success = exitInfo?.code === 0;
          setCardStatus(card, success ? 'success' : 'error', exitInfo?.durationMs ?? 0);
          appendLog(
            success
              ? `\n✓ 完成 (${(exitInfo!.durationMs / 1000).toFixed(1)}s)\n`
              : `\n✗ 退出码 ${exitInfo?.code} 信号 ${exitInfo?.signal} (${((exitInfo?.durationMs ?? 0) / 1000).toFixed(1)}s)\n`,
            success ? 'text-emerald-400 font-bold' : 'text-rose-400 font-bold',
          );
          activeToolLabel.textContent = success ? '✓ 完成' : '✗ 失败';

          // Persist last-run state.
          const state = loadState();
          state.lastRuns[toolId] = {
            ts: Date.now(),
            status: success ? 'success' : 'error',
            durationMs: exitInfo?.durationMs ?? 0,
          };
          saveState(state);
          renderLastRunTimes();
        } catch (err: any) {
          appendLog(`\n✗ 网络错误：${err.message}\n`, 'text-rose-400');
          setCardStatus(card, 'error', Date.now() - startedAt);
        } finally {
          $$('.run-btn').forEach((b) => ((b as HTMLButtonElement).disabled = false));
        }
      }

      // ── Initial load ────────────────────────────────────────────────
      async function refreshStats() {
        try {
          const res = await fetch('/api/list-tools');
          const data = await res.json();
          // For each tool, update the "last touched" footer from server stats.
          for (const t of data.tools as ToolFromApi[]) {
            const card = $(`[data-tool-id="${t.id}"]`);
            if (!card) continue;
            const footer = $('[data-bind="last-run"]', card);
            if (!footer) continue;
            const newest = t.outputIndicatorStats
              .filter((s) => s.exists && s.mtimeMs)
              .sort((a, b) => (b.mtimeMs ?? 0) - (a.mtimeMs ?? 0))[0];
            if (newest) {
              footer.textContent = `${newest.path.split('/').pop()} · ${newest.ageLabel}`;
              footer.setAttribute('title', `${newest.path}\n${newest.sizeBytes ? (newest.sizeBytes / 1024).toFixed(1) + ' KB' : '目录'}`);
            } else {
              footer.textContent = '尚未生成';
              footer.removeAttribute('title');
            }
          }
        } catch (e) {
          console.warn('Failed to refresh stats:', e);
        }
      }

      function renderLastRunTimes() {
        const state = loadState();
        $$('.tool-card').forEach((card) => {
          const toolId = card.dataset.toolId!;
          const rec = state.lastRuns[toolId];
          const el = $('[data-bind="last-run"]', card);
          if (!el) return;
          if (rec) {
            const ago = Math.floor((Date.now() - rec.ts) / 1000);
            const age = ago < 60 ? `${ago}秒前` : ago < 3600 ? `${Math.floor(ago / 60)}分钟前` : `${Math.floor(ago / 3600)}小时前`;
            el.textContent = `${rec.status === 'success' ? '✓' : '✗'} ${age}`;
            el.setAttribute('title', `${new Date(rec.ts).toLocaleString()} · ${(rec.durationMs / 1000).toFixed(1)}s`);
          }
        });
      }

      // ── Wire up ─────────────────────────────────────────────────────
      $$('.run-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const card = (e.currentTarget as HTMLElement).closest('.tool-card') as HTMLElement;
          if (card) runTool(card);
        });
      });

      $('#copy-log')!.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(log.textContent || '');
          appendLog('\n[已复制到剪贴板]\n', 'text-zinc-500');
        } catch { /* clipboard blocked */ }
      });

      $('#clear-log')!.addEventListener('click', () => {
        log.textContent = '';
        appendLog('日志已清空\n', 'text-zinc-600');
      });

      const toggleBtn = $('#toggle-log')!;
      toggleBtn.addEventListener('click', () => {
        const isHidden = log.classList.contains('h-48');
        if (isHidden) {
          log.classList.remove('h-48');
          log.classList.add('h-96');
          toggleBtn.textContent = '收起 ▼';
        } else {
          log.classList.add('h-48');
          log.classList.remove('h-96');
          toggleBtn.textContent = '展开 ▲';
        }
      });

      // Initial render
      refreshStats();
      renderLastRunTimes();
      // Auto-refresh stats every 30s.
      setInterval(refreshStats, 30_000);
    </script>
  </body>
</html>
