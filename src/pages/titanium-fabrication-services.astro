---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import FabProcessSpectrum from '../components/services/FabProcessSpectrum.astro';
import FabSpecsDashboard from '../components/services/FabSpecsDashboard.astro';
import ReactiveWeldingKnowHow from '../components/services/ReactiveWeldingKnowHow.astro';
import FabDedicatedCta from '../components/services/FabDedicatedCta.astro';
import AudienceHub from '../components/audience/AudienceHub.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { HERO_CONFIG } from '../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout serviceHubKey="fabrication">
  <!-- Breadcrumb -->
  <nav class="border-b" aria-label="Breadcrumb" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.home')}</span>
          </a>
          <meta itemprop="position" content="1" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/services/" itemprop="item" class="transition-colors" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span itemprop="name">{t('nav.services')}</span>
          </a>
          <meta itemprop="position" content="2" />
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="font-semibold" style="color: var(--theme-text);">{t('nav.services.titaniumFabricationServices')}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </div>
  </nav>
  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title={t('titanium-fabrication-services.astro.titaniumFabricationServices.titanium_fabrication')}
    highlight="Services"
    badge="Precision Fabrication"
    badgeIcon="M13 10V3L4 14h7v7l9-11h-7z"
    subtitle="End-to-end titanium fabrication solutions — from precision TIG/laser welding with full argon shielding to custom sheet metal fabrication and large-scale industrial vessel and piping assembly."
  
    keyMetrics={HERO_CONFIG['/titanium-fabrication-services'].keyMetrics}
    entityChips={HERO_CONFIG['/titanium-fabrication-services'].entityChips}
  />

  <!-- Fabrication Process Spectrum — 3-column grid -->
  <FabProcessSpectrum />

  <!-- Fabrication Capacity Dashboard — 4-column specs -->
  <FabSpecsDashboard />

  <!-- Reactive Welding Engineering Know-How — 2-column -->
  <ReactiveWeldingKnowHow />

  <!-- Dedicated CTA — WPS & RFQ Assessment -->
  <AudienceHub industry="fabrication" />

  <FabDedicatedCta />
</BaseLayout>