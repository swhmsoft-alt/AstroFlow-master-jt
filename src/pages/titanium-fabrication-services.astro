---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubpageHero from '../components/ui/SubpageHero.astro';
import FabProcessSpectrum from '../components/services/FabProcessSpectrum.astro';
import FabSpecsDashboard from '../components/services/FabSpecsDashboard.astro';
import ReactiveWeldingKnowHow from '../components/services/ReactiveWeldingKnowHow.astro';
import FabDedicatedCta from '../components/services/FabDedicatedCta.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { HERO_CONFIG } from '../config/hero';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<BaseLayout serviceHubKey="fabrication">
  <!-- Hero — DO NOT MODIFY -->
  <SubpageHero
    title={t('titanium-fabrication-services.astro.titaniumFabricationServices.titanium_fabrication')}
    highlight="Services"
    badge="Precision Fabrication"
    badgeIcon="M13 10V3L4 14h7v7l9-11h-7z"
    subtitle="End-to-end titanium fabrication solutions — from precision TIG/laser welding with full argon shielding to custom sheet metal fabrication and large-scale industrial vessel and piping assembly."
  
    keyMetrics={HERO_CONFIG['/titanium-fabrication-services'].keyMetrics}
    entityChips={HERO_CONFIG['/titanium-fabrication-services'].entityChips}
  />

  <!-- Fabrication Process Spectrum — 3-column grid -->
  <FabProcessSpectrum />

  <!-- Fabrication Capacity Dashboard — 4-column specs -->
  <FabSpecsDashboard />

  <!-- Reactive Welding Engineering Know-How — 2-column -->
  <ReactiveWeldingKnowHow />

  <!-- Dedicated CTA — WPS & RFQ Assessment -->
  <FabDedicatedCta />
</BaseLayout>