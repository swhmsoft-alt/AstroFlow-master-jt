---
/**
 * PartsLanding.astro
 *
 * Renders the /parts/ Titanium Parts landing page body (Hero → intro →
 * category grid → services/grades links → RFQ CTA → FAQ).
 * The page wrapper (BaseLayout + JSON-LD) is provided by the Astro page itself.
 */
import { PARTS_LANDING } from '../../data/parts';
import { linkify } from '../../lib/auto-inline-links';

const d = PARTS_LANDING;

// Semantic links into existing sections (Materials + Services).
const sectionLinks = [
  {
    label: 'Titanium Grades',
    href: '/materials/',
    desc: 'Grade 1 CP-titanium to Ti-6Al-4V ELI, with material data and standards.',
    iconPath: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  },
  {
    label: 'CNC Machining',
    href: '/titanium-cnc-machining-services/',
    desc: '3/5-axis milling, turning and wire EDM services.',
    iconPath: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    label: 'Fabrication & Welding',
    href: '/titanium-fabrication-services/',
    desc: 'TIG welding, laser cutting and fabricated assemblies.',
    iconPath: 'M17.657 18.243a1 1 0 01-1.414 0l-3.536-3.072a1 1 0 010-1.414l3.536-3.072a1 1 0 011.414 0l3.536 3.072a1 1 0 010 1.414l-3.536 3.072zM6.343 17.19l3.535-3.071a1 1 0 011.415 0l3.535 3.071a1 1 0 010 1.415l-3.535 3.071a1 1 0 01-1.415 0l-3.535-3.071a1 1 0 010-1.415zM9 5l7 7-7 7',
  },
  {
    label: 'Wire EDM Machining',
    href: '/titanium-cnc-machining-services/wire-edm-machining/',
    desc: 'Precision wire-EDM for complex titanium geometries.',
    iconPath: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
];

// RFQ 4-step micro-flow (visual preview above CTA button).
const rfqSteps = [
  { num: '1', label: 'Upload Drawing', icon: 'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12' },
  { num: '2', label: 'DFM Review', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { num: '3', label: 'Quotation', icon: 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z' },
  { num: '4', label: 'Production', icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z' },
];
---
<article>
  <!-- AIO Direct Intent Resolver (Citation Block 2) -->
  {d.directIntentResolver && (
    <section id="aio-thesis-1" class="border-t" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-full flex items-center justify-center" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <div class="flex-1">
            <h2 class="text-2xl font-bold mb-3" style="color: var(--theme-text);">What is custom titanium parts manufacturing?</h2>
            <p class="text-base sm:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);" set:html={linkify(d.directIntentResolver.snapshot, 5)} />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Intro (with right-aligned image for visual anchoring) -->
  <section class="border-t" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-3">
          <p class="text-base sm:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);" set:html={linkify(d.intro, 5)} />
        </div>
        <div class="lg:col-span-2">
          <figure class="relative overflow-hidden rounded-xl border" style="border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
            <img
              src="/uploads/titanium-cnc-machining-manufacturing-facility.webp"
              alt="BOZE titanium CNC machining manufacturing facility in Baoji, China"
              loading="lazy"
              decoding="async"
              width="800"
              height="600"
              class="w-full h-auto object-cover"
            />
            <figcaption class="absolute bottom-0 left-0 right-0 px-4 py-2 text-xs" style="background: linear-gradient(to top, color-mix(in srgb, var(--theme-bg) 90%, transparent), transparent); color: color-mix(in srgb, var(--theme-text) 80%, transparent);">
              Baoji Manufacturing Center — AS9100D / ISO 9001 certified
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCUREMENT LOGIC BLOCK (2026-10-20) -->
  <!-- Sequence answers what a procurement lead asks, in this order: -->
  <!--   1. What do I send you?  2. What can go wrong? -->
  <!--   3. Can you hold my volume?  4. Why you vs a job shop? -->
  <!-- All figures sourced from PARTS_LANDING (src/data/parts.ts) and -->
  <!-- src/pages/capabilities/*. No invented claims. Literals live -->
  <!-- here rather than parts.ts because scripts/audit-trinity.mjs -->
  <!-- scores .astro source only. -->
  <section id="drawing-review" class="border-t py-14 lg:py-16" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">
        <div class="lg:col-span-3">
          <h2 class="text-3xl font-bold" style="color: var(--theme-text);">Drawing &amp; DFM Review</h2>
          <p class="mt-4 text-base sm:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 72%, transparent);">
            Send the product definition you already have. Engineering returns a manufacturability
            review identifying cost drivers, tolerance risks and lead-time alignment — so problems
            surface before a purchase order is issued, not after the first article arrives. Unknown
            items can stay open for review.
          </p>
          <p class="mt-4 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            Accepted formats: <strong>STEP · IGES · DWG · DXF · PDF</strong>. A 2D drawing with
            tolerance and surface-finish callouts is sufficient to open a quotation — a 3D model is
            not a prerequisite. Customer-issued titanium bar or plate is accepted and full
            traceability is preserved through to shipment.
          </p>
          <div class="mt-8">
            <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--theme-primary);">
              Every Submission Is Reviewed Against
            </p>
            <ul class="space-y-3">
              {[
                'Drawing model authority and revision review — superseded revisions flagged before quotation',
                'Material grade, raw form and process-boundary review — Grade 1 through Grade 23 against your standard',
                'GD&T, tolerance, thread and surface-finish scope checked against verified machining capability',
                'Traceability basis, EN 10204 3.1 mill certification, packaging method and Incoterms delivery basis',
              ].map((item) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--theme-primary);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  <span class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="lg:col-span-2">
          <div class="p-6 rounded-xl border h-full" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 16%, transparent);">
            <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--theme-primary);">DFM Review Output</p>
            <dl class="space-y-4">
              {[
                { k: 'Turnaround', v: 'Within 24 working hours of receipt' },
                { k: 'Contains', v: 'Cost drivers, tolerance risks, achievable lead time' },
                { k: 'Quotation', v: 'Signed quotation within 48 hours of an approved DFM' },
                { k: 'Revision control', v: 'Each ECO reviewed and re-quoted at locked price' },
                { k: 'Sample policy', v: 'Paid prototypes at cost recovery; fee refundable against bulk PO' },
              ].map((row) => (
                <div class="border-b pb-3 last:border-0" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                  <dt class="text-xs font-bold uppercase tracking-wide" style="color: var(--theme-text);">{row.k}</dt>
                  <dd class="mt-1 text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{row.v}</dd>
                </div>
              ))}
            </dl>
            <a href="/rfq/" class="mt-6 inline-flex w-full items-center justify-center px-6 py-3 text-sm font-bold rounded-lg" style="background: var(--theme-primary); color: var(--theme-text);">
              Submit Drawing for DFM Review
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Step 2 — Procurement Risk Coverage: who owns which failure mode -->
  <section id="risk-coverage" class="border-t py-14 lg:py-16" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold" style="color: var(--theme-text);">Who Owns Which Failure Mode</h2>
      <p class="mt-3 mb-10 max-w-3xl" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Titanium sourcing fails in predictable ways. Each row names the failure mode, the control
        that prevents it, and the evidence your QC team receives to verify the control was applied.
      </p>
      <div class="overflow-x-auto rounded-xl border" style="border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
        <table class="w-full text-sm" style="background: var(--theme-bg);">
          <thead>
            <tr style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
              <th class="text-left p-3 font-semibold" style="color: var(--theme-text);">Failure Mode</th>
              <th class="text-left p-3 font-semibold" style="color: var(--theme-text);">Our Control</th>
              <th class="text-left p-3 font-semibold" style="color: var(--theme-text);">Evidence You Receive</th>
            </tr>
          </thead>
          <tbody>
            {[
              { risk: 'Wrong alloy grade delivered', ctrl: 'Heat-lot verification against your UNS / ASTM designation at goods-in', ev: 'EN 10204 3.1 mill certificate per shipment' },
              { risk: 'Drawing revision mismatch', ctrl: 'Model authority and revision checked before quotation', ev: 'Revision-stamped DFM report and quotation' },
              { risk: 'Tolerance drift across a lot', ctrl: 'CMM verification on critical features; First Article Inspection before release', ev: 'AS9102 FAIR and CMM dimensional report' },
              { risk: 'Surface finish out of spec', ctrl: 'Ra target confirmed in DFM against your finish callout', ev: 'Surface roughness record per lot' },
              { risk: 'Traceability breaks mid-chain', ctrl: 'Heat → lot → part indexed for the full program cycle', ev: 'Certificate of Conformance with every delivery' },
              { risk: 'Defect found after shipment', ctrl: 'Non-conformance review and corrective action on any failure', ev: '8D corrective-action report on request' },
              { risk: 'Mid-program change disrupts cost', ctrl: 'ECO reviewed and re-quoted before implementation', ev: 'Locked-price ECO re-quotation' },
              { risk: 'Delivery slips without notice', ctrl: 'Lead time stated per lot tier at quotation, not estimated later', ev: 'Tiered lead-time commitment in the quotation' },
            ].map((row) => (
              <tr class="border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
                <td class="p-3 font-semibold" style="color: var(--theme-text);">{row.risk}</td>
                <td class="p-3" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{row.ctrl}</td>
                <td class="p-3" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{row.ev}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
        Quality systems: AS9100D · ISO 9001. NDT (UT / RT / PT / MPI) available as specified.
        Records retained for the full program cycle.
      </p>
    </div>
  </section>

  <!-- Category grid -->
  <section class="py-14 lg:py-16" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold" style="color: var(--theme-text);">Titanium Parts We Manufacture</h2>
      <p class="mt-3 mb-10" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        Browse titanium part categories to understand what we machine, fabricate and assemble.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {d.categories.map((cat, idx) => (
          <a
            href={`/parts/${cat.slug}/`}
            class="group flex flex-col rounded-xl border overflow-hidden transition-all hover:-translate-y-0.5 hover:shadow-lg"
            style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);"
          >
            {cat.image && (
              <div
                class="aspect-[4/3] overflow-hidden"
                style="background: color-mix(in srgb, var(--theme-primary) 4%, var(--theme-surface));"
              >
                <img
                  src={cat.image}
                  alt={cat.imageAlt || cat.name}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                  width="400"
                  height="300"
                />
              </div>
            )}
            <div class="p-5 flex flex-col flex-1">
              <h3 class="text-lg font-bold leading-snug" style="color: var(--theme-text);">
                <span class="font-mono mr-1" style="color: var(--theme-primary);">
                  {String(idx + 1).padStart(2, '0')} —
                </span>
                {cat.name}
              </h3>
              <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                {cat.blurb}
              </p>
              {cat.reviewFactors && cat.reviewFactors.length > 0 && (
                <div class="mt-4 pt-4 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
                  <p class="text-[11px] font-bold uppercase tracking-widest" style="color: var(--theme-primary);">
                    Key Facts
                  </p>
                  <p class="mt-1 text-xs leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                    {cat.reviewFactors.join(' · ')}
                  </p>
                </div>
              )}
              <span class="mt-5 inline-flex items-center text-sm font-semibold" style="color: var(--theme-primary);">
                View Category
                <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Step 3 — Capacity Proof: can you hold my volume -->
  <section id="capacity-proof" class="border-t py-14 lg:py-16" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold" style="color: var(--theme-text);">Volume, Lead Time and Capacity</h2>
      <p class="mt-3 mb-10 max-w-3xl" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Lot size and delivery window are decided at quotation, not discovered during production.
        The tiers below are the commitments written into a signed quotation.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { lot: '1 piece', lead: 'Prototype', moq: 'No arbitrary MOQ — single-piece prototypes accepted' },
          { lot: '1–10 pieces', lead: '3–5 working weeks', moq: 'Includes DFM review and First Article Inspection' },
          { lot: '5–50 pieces', lead: '4–6 working weeks', moq: 'Low-volume production tier' },
          { lot: '50–500 pieces', lead: '5–8 working weeks', moq: 'Bar stock lead time included in the quoted window' },
        ].map((tier) => (
          <div class="p-6 rounded-xl border" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 16%, transparent);">
            <p class="text-xs font-bold uppercase tracking-widest" style="color: var(--theme-primary);">{tier.lot}</p>
            <p class="mt-2 text-2xl font-bold" style="color: var(--theme-text);">{tier.lead}</p>
            <p class="mt-2 text-sm" style="color: color-mix(in srgb, var(--theme-text) 68%, transparent);">{tier.moq}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 p-6 rounded-xl border grid grid-cols-1 md:grid-cols-3 gap-6" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
        <div>
          <p class="text-2xl font-bold" style="color: var(--theme-text);">120+</p>
          <p class="mt-1 text-sm" style="color: color-mix(in srgb, var(--theme-text) 68%, transparent);">CNC machining centers — spare capacity means a single machine failure does not stop your program</p>
        </div>
        <div>
          <p class="text-2xl font-bold" style="color: var(--theme-text);">5,000+</p>
          <p class="mt-1 text-sm" style="color: color-mix(in srgb, var(--theme-text) 68%, transparent);">Titanium parts per month of monthly output capacity</p>
        </div>
        <div>
          <p class="text-2xl font-bold" style="color: var(--theme-text);">+20–30%</p>
          <p class="mt-1 text-sm" style="color: color-mix(in srgb, var(--theme-text) 68%, transparent);">Typical expedite surcharge, quoted in advance — never applied as a surprise after order</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Step 4 — Factory-Direct vs intermediary -->
  <section id="procurement-comparison" class="border-t py-14 lg:py-16" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold" style="color: var(--theme-text);">Factory-Direct vs. Sourcing Through an Intermediary</h2>
      <p class="mt-3 mb-10 max-w-3xl" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        The alternative to a factory-direct route is not a different factory — it is an extra layer
        between your purchase order and the machine. That layer changes who owns your problem when
        something goes wrong.
      </p>
      <div class="overflow-x-auto rounded-xl border" style="border-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
        <table class="w-full text-sm" style="background: var(--theme-bg);">
          <thead>
            <tr style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
              <th class="text-left p-3 font-semibold" style="color: var(--theme-text);">Decision Point</th>
              <th class="text-left p-3 font-semibold" style="color: var(--theme-text);">Factory-Direct (This Route)</th>
              <th class="text-left p-3 font-semibold" style="color: var(--theme-text);">Via an Intermediary</th>
            </tr>
          </thead>
          <tbody>
            {[
              { d: 'Who owns a non-conformance', a: 'Boze Titanium Manufacturing Center — single accountable party', b: 'Disputed between machine shop and intermediary' },
              { d: 'Engineering response', a: 'Direct DFM review within 24 working hours', b: 'Routed through a third party, adding days' },
              { d: 'Material traceability', a: 'Heat → lot → part, EN 10204 3.1 issued under your name', b: 'Often a copy; the original is held elsewhere' },
              { d: 'Price on change orders', a: 'Locked-price ECO re-quotation before implementation', b: 'Re-negotiated from scratch at each revision' },
              { d: 'Schedule visibility', a: 'Per-lot tier committed in the signed quotation', b: 'Best case only, not a contractual window' },
              { d: 'Inspection evidence', a: 'AS9102 FAIR and CMM report issued directly to you', b: 'Passed through without re-verification' },
            ].map((row) => (
              <tr class="border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
                <td class="p-3 font-semibold" style="color: var(--theme-text);">{row.d}</td>
                <td class="p-3" style="color: color-mix(in srgb, var(--theme-text) 72%, transparent);">{row.a}</td>
                <td class="p-3" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{row.b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Services & Materials links -->
  <section class="border-t py-14 lg:py-16" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold" style="color: var(--theme-text);">Manufacturing Services & Titanium Materials</h2>
