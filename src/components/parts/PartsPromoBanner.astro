---
/**
 * PartsPromoBanner.astro
 *
 * Reusable internal-link banner pointing into the /parts/ Titanium Parts
 * procurement gateway. Placed on the homepage, Services, Materials, Industries
 * and RFQ pages to build semantic internal links toward the new top-level entry.
 * English-only content (parts section is English-only).
 */
const ctaLabel = 'Explore Titanium Parts';
const heading = 'Custom Titanium Parts Manufacturing';
const body =
  'CNC machining, welding, EDM and fabrication of titanium components — from prototype to production, with direct access to the Baoji titanium supply chain.';
---
<section
  class="border-t"
  aria-label="Titanium Parts manufacturing"
  style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-12">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold leading-tight" style="color: var(--theme-text);">{heading}</h2>
        <p class="mt-2 text-sm sm:text-base" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {body}
        </p>
      </div>
      <div class="shrink-0">
        <a
          href="/parts/"
          class="inline-flex items-center px-6 py-3 text-sm font-semibold rounded-lg transition-all"
          style="background: var(--theme-primary); color: var(--theme-text);"
        >
          {ctaLabel}
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>
