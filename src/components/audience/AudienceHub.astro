---
// AudienceHub.astro
// Audience-First SEO 外显模块：按「行业 × 人群」在当前页面渲染可见的受众导向内容。
// - FAQ（含 FAQPage JSON-LD，提升 AI Overview 引用概率）
// - 相关资源（人群导向 blog / 服务页 / 询盘）
// - CTA → /rfq/
// 0-JS：FAQ 用原生 <details>，无客户端水合。
// 通用文案走 t()（en.json 缺省回退）；FAQ/相关链接内容为内联 EN 配置（首个外显版本）。
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  /** 行业 id：semiconductor / medical / aerospace / marine / chemical / energy / industrial-equipment / ai-infrastructure / uav-drones */
  industry: string;
}
const { industry } = Astro.props;

const PERSONA_LABEL: Record<string, string> = {
  procurement: t('audience.persona.procurement'),
  design: t('audience.persona.design'),
  manufacturing: t('audience.persona.manufacturing'),
  quality: t('audience.persona.quality'),
  owner: t('audience.persona.owner'),
};

interface IndustryConfig {
  personas: string[];
  faqs: { q: string; a: string }[];
  related: { label: string; href: string; localized?: boolean }[];
}

const CONFIG: Record<string, IndustryConfig> = {
  semiconductor: {
    personas: ['quality', 'manufacturing', 'design'],
    faqs: [
      { q: 'What cleanliness and particle requirements apply to semiconductor titanium components?', a: 'Semiconductor titanium parts are manufactured to strict UHP cleanliness—degreased, cleaned and passivated—then packed in cleanroom conditions to prevent particle contamination of vacuum and gas-delivery hardware.' },
      { q: 'Which titanium grade suits vacuum chamber and showerhead components?', a: 'Grades 2, 5 (Ti-6Al-4V) and 23 (Ti-6Al-4V ELI) are commonly specified for vacuum and gas-delivery hardware depending on strength, corrosion and outgassing requirements.' },
      { q: 'Can you hold tight tolerances on thin-walled vacuum hardware?', a: 'Yes—we use 5-axis ultra-precision CNC and controlled machining to hold tolerances down to ±0.005 mm on complex geometries.' },
    ],
    related: [
      { label: 'Semiconductor titanium components: precision requirements', href: '/blog/semiconductor-titanium-components-precision-requirements/' },
      { label: 'Custom industrial components', href: '/titanium-cnc-machining-services/custom-industrial-components/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  medical: {
    personas: ['quality', 'design', 'procurement'],
    faqs: [
      { q: 'What quality system applies to titanium medical device components?', a: 'We operate under ISO 13485 and ISO 9001; implantable-grade parts are made from Ti-6Al-4V ELI (Grade 23) with full material certification and traceability.' },
      { q: 'Which titanium grade is used for medical implants?', a: 'Ti-6Al-4V ELI (Grade 23) is the most common implantable grade, offering high strength, biocompatibility and a lower interstitial content for improved toughness.' },
      { q: 'Can you achieve the surface finish required for surgical instruments and implants?', a: 'Yes—precision grinding and controlled finishing achieve Ra down to 0.4 µm and mirror finishes where specifications require.' },
    ],
    related: [
      { label: 'Medical titanium implants: manufacturing standards', href: '/blog/medical-titanium-implants-manufacturing-standards/' },
      { label: 'Titanium medical components', href: '/parts/titanium-medical-components/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  aerospace: {
    personas: ['quality', 'design', 'procurement'],
    faqs: [
      { q: 'Are you AS9100D certified for aerospace titanium parts?', a: 'Yes—we are AS9100D and ISO 9001 certified, with full material certification, traceability and controlled documentation for aerospace programs.' },
      { q: 'What material certifications and traceability do you provide?', a: 'Each heat is supplied with mill test certificates (AMS 4928, ASTM B348/B265) and full lot traceability through machining, inspection and delivery.' },
      { q: 'Can you machine thin-wall airframe and engine components to tight tolerances?', a: 'Yes—5-axis machining with controlled fixturing holds tight tolerances while managing distortion in thin-wall aerospace geometries.' },
    ],
    related: [
      { label: 'Aerospace titanium component manufacturing challenges', href: '/blog/aerospace-titanium-components-manufacturing-challenges/' },
      { label: 'AS9100D titanium CNC manufacturing', href: '/blog/as9100d-titanium-cnc-manufacturing-aerospace-quality/' },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  marine: {
    personas: ['procurement', 'quality', 'manufacturing'],
    faqs: [
      { q: 'Which titanium grade resists seawater corrosion for marine components?', a: 'Commercially pure grades (2) and Ti-6Al-4V are widely used offshore for their outstanding resistance to seawater and chloride-induced corrosion.' },
      { q: 'Can you manufacture propellers, shafting and seawater hardware?', a: 'Yes—we machine, fabricate and weld titanium for marine propellers, shafting, fasteners and structural hardware.' },
      { q: 'Do you provide marine-grade material certification?', a: 'Yes—full material certification and traceability are provided for every marine titanium component.' },
    ],
    related: [
      { label: 'Titanium marine parts', href: '/parts/titanium-marine-parts/', localized: true },
      { label: 'Titanium welding & assembly', href: '/titanium-fabrication-services/titanium-welding-assembly/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  chemical: {
    personas: ['procurement', 'quality', 'design'],
    faqs: [
      { q: 'How does titanium resist corrosion in chemical processing equipment?', a: 'Titanium forms a stable passive oxide film that resists chlorides, acids and process fluids, making it ideal for heat exchangers, valves and reactor internals.' },
      { q: 'Which grade is best for chemical processing hardware?', a: 'Grades 2 and 12 (with molybdenum) are common; for higher strength and creep resistance, Ti-6Al-4V may be specified.' },
      { q: 'Can you fabricate heat exchangers, tube sheets and valve bodies?', a: 'Yes—we machine and fabricate heat exchanger components, tube sheets, flanges, valves and reactor internals.' },
    ],
    related: [
      { label: 'Titanium pipe components', href: '/parts/titanium-pipe-components/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  energy: {
    personas: ['procurement', 'quality', 'design'],
    faqs: [
      { q: 'Why is titanium used in energy and offshore applications?', a: 'Titanium offers high strength-to-weight, corrosion resistance and long service life in demanding energy and subsea environments.' },
      { q: 'Which titanium grades are specified for energy components?', a: 'Grades 2, 5 and 23 are common depending on pressure, temperature and corrosion requirements.' },
      { q: 'Do you provide certified titanium for critical energy hardware?', a: 'Yes—full material certification, NDT and traceability are available for critical energy applications.' },
    ],
    related: [
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  'industrial-equipment': {
    personas: ['procurement', 'design', 'manufacturing'],
    faqs: [
      { q: 'Can you produce custom titanium industrial components?', a: 'Yes—we machine custom industrial components from drawings or CAD, with DFM feedback and rapid prototyping.' },
      { q: 'What tolerances can you hold?', a: 'We hold tolerances down to ±0.005 mm on precision-machined titanium components.' },
      { q: 'Do you support low-volume and production runs?', a: 'Yes—from rapid prototyping to low-volume and production quantities with consistent quality control.' },
    ],
    related: [
      { label: 'Custom industrial components', href: '/titanium-cnc-machining-services/custom-industrial-components/', localized: true },
      { label: 'DFM guide for titanium parts', href: '/blog/dfm-guide-titanium-parts-design-for-manufacturability/' },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  'ai-infrastructure': {
    personas: ['design', 'manufacturing', 'procurement'],
    faqs: [
      { q: 'Can you machine precision titanium components for AI / data-center infrastructure?', a: 'Yes—we produce precision-machined titanium structural and thermal hardware for high-performance computing and data-center infrastructure.' },
      { q: 'Which grade suits structural AI-infrastructure components?', a: 'Grades 5 and 23 offer high strength and stiffness-to-weight for precision structural hardware.' },
      { q: 'Can you hold tight tolerances on complex geometries?', a: 'Yes—5-axis machining and controlled processes hold tight tolerances on complex geometries.' },
    ],
    related: [
      { label: 'Custom industrial components', href: '/titanium-cnc-machining-services/custom-industrial-components/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  'uav-drones': {
    personas: ['design', 'manufacturing', 'owner'],
    faqs: [
      { q: 'Why use titanium in UAV and drone components?', a: 'Titanium delivers a high strength-to-weight ratio and stiffness, ideal for lightweight airframes, motor housings and fasteners.' },
      { q: 'Which grade suits UAV hardware?', a: 'Ti-6Al-4V (Grade 5) is the standard for lightweight, high-strength UAV and drone components.' },
      { q: 'Can you produce small, high-precision UAV parts?', a: 'Yes—we machine small, complex, high-precision titanium components with tight tolerances and low-volume runs.' },
    ],
    related: [
      { label: 'Titanium UAV components', href: '/parts/titanium-uav-components/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  // ── 服务/工艺页配置（persona 导向）──
  'cnc-machining': {
    personas: ['procurement', 'design', 'manufacturing'],
    faqs: [
      { q: 'What titanium CNC machining services do you offer?', a: '3/5-axis milling, CNC turning and mill-turn, wire EDM, and custom industrial components — from rapid prototyping to high-volume production.' },
      { q: 'What tolerances can you hold on machined titanium?', a: 'We hold tolerances down to ±0.005 mm with 3/5-axis machining and in-house CMM inspection.' },
      { q: 'Do you provide DFM feedback before quoting?', a: 'Yes—our engineers review your drawings or CAD and provide DFM feedback with a quote, typically within 24-48 hours.' },
    ],
    related: [
      { label: '3/5-axis CNC machining', href: '/titanium-cnc-machining-services/3-5-axis-cnc-machining/', localized: true },
      { label: 'CNC milling & turning', href: '/titanium-cnc-machining-services/cnc-milling-turning/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  'surface': {
    personas: ['manufacturing', 'design', 'quality'],
    faqs: [
      { q: 'What titanium surface treatments do you offer?', a: 'Anodizing (AMS 2488), micro-arc plasma ceramic deposition, chemical passivation, and polishing / sandblasting.' },
      { q: 'Which surface finish improves corrosion resistance?', a: 'Anodizing and passivation build a protective oxide layer that enhances corrosion resistance and wear performance.' },
      { q: 'Can you achieve Ra 0.4 or mirror finishes?', a: 'Yes—precision polishing achieves Ra down to 0.4 µm and mirror finishes where specified.' },
    ],
    related: [
      { label: 'Anodizing', href: '/titanium-surface-treatment/anodizing/', localized: true },
      { label: 'Polishing & sandblasting', href: '/titanium-surface-treatment/polishing-sandblasting/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  'fabrication': {
    personas: ['manufacturing', 'procurement', 'quality'],
    faqs: [
      { q: 'What titanium fabrication services do you provide?', a: 'Laser cutting, waterjet cutting, TIG / laser welding with full argon shielding, and sheet-metal assembly.' },
      { q: 'How do you prevent weld contamination?', a: 'We use full argon shielding and controlled purge during TIG welding to prevent oxygen and nitrogen contamination of the weld.' },
      { q: 'Can you handle large vessels and piping assemblies?', a: 'Yes—large-scale industrial vessel and piping assembly with qualified welding procedures (WPS).' },
    ],
    related: [
      { label: 'Laser cutting', href: '/titanium-fabrication-services/laser-cutting/', localized: true },
      { label: 'Titanium welding & assembly', href: '/titanium-fabrication-services/titanium-welding-assembly/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  'forming': {
    personas: ['manufacturing', 'procurement', 'design'],
    faqs: [
      { q: 'What titanium forming and heavy manufacturing do you offer?', a: 'Hot forming, open / closed-die forging, extrusion, and large-scale structural assembly for multi-ton infrastructure.' },
      { q: 'How do you control stress and distortion in formed parts?', a: 'Vacuum heat treatment for stress relief and controlled hot-forming processes reduce distortion.' },
      { q: 'Can you handle large, heavy titanium components?', a: 'Yes—multi-ton titanium structural components with heavy plate rolling and integration.' },
    ],
    related: [
      { label: 'Titanium forging', href: '/titanium-forming-heavy-manufacturing/titanium-forging/', localized: true },
      { label: 'Titanium extrusion', href: '/titanium-forming-heavy-manufacturing/titanium-extrusion/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  'additive': {
    personas: ['design', 'procurement', 'manufacturing'],
    faqs: [
      { q: 'What titanium additive manufacturing do you offer?', a: 'SLM / DMLS 3D printing from rapid prototypes in 3-5 days to low-volume production with mechanical properties matching wrought material.' },
