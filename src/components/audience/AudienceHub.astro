      { q: 'Do you combine AM with CNC finishing?', a: 'Yes—we finish printed parts with CNC machining to achieve tight tolerances and required surface finishes.' },
    ],
    related: [
      { label: '3D printing (SLM/DMLS)', href: '/titanium-additive-manufacturing/3d-printing-slm/', localized: true },
      { label: 'Rapid prototyping', href: '/titanium-additive-manufacturing/rapid-prototyping/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  'capabilities': {
    personas: ['quality', 'procurement', 'design'],
    faqs: [
      { q: 'What quality systems and certifications do you hold?', a: 'AS9100D, ISO 9001, ISO 13485, NADCAP and ITAR-compliant — with full material traceability and in-house CMM inspection.' },
      { q: 'How do you verify dimensional quality?', a: 'In-house CMM metrology and GD&T validation per ASME Y14.5, with first article inspection reports.' },
      { q: 'Do you provide engineering support and DFM?', a: 'Yes—engineering support for DFM, material selection, and tolerance feasibility.' },
    ],
    related: [
      { label: 'Certifications', href: '/capabilities/certifications/', localized: true },
      { label: 'Engineering support', href: '/capabilities/engineering/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  // ── 材料页配置（设计/质量导向）──
  'materials': {
    personas: ['design', 'quality', 'procurement'],
    faqs: [
      { q: 'How do I choose the right titanium grade?', a: 'Selection depends on strength, corrosion resistance, formability and application — CP grades for corrosion, alpha-beta alloys like Ti-6Al-4V for strength, and ELI grades for medical.' },
      { q: 'Which titanium grade is best for medical implants?', a: 'Ti-6Al-4V ELI (Grade 23) per ASTM F136 is the most common implantable grade for its strength and biocompatibility.' },
      { q: 'What certifications accompany titanium material?', a: 'Mill test certificates (ASTM, AMS), EN 10204 3.1 reports and full lot traceability are provided with every shipment.' },
    ],
    related: [
      { label: 'Titanium alloy selection guide', href: '/blog/titanium-alloy-selection-guide-how-to-choose-grade/' },
      { label: 'Ti-6Al-4V (Grade 5) guide', href: '/materials/grade-5/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  // ── 部件页配置（采购导向）──
  'parts': {
    personas: ['procurement', 'design', 'manufacturing'],
    faqs: [
      { q: 'Can you machine custom titanium parts?', a: 'Yes—CNC machined, fabricated, forged and pipe titanium parts from drawings or CAD, with DFM feedback and quoting.' },
      { q: 'What titanium parts do you manufacture?', a: 'CNC parts, fabricated parts, pipe components, and marine, UAV, medical and motorsport parts.' },
      { q: 'How do I get a quote for titanium parts?', a: 'Submit your drawing via the request-a-quote page and our engineers respond with DFM feedback and a quote in 24-48 hours.' },
    ],
    related: [
      { label: 'Titanium CNC parts', href: '/parts/titanium-cnc-parts/', localized: true },
      { label: 'Titanium fabricated parts', href: '/parts/titanium-fabricated-parts/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  // ── blog 文章页配置（采购导向）──
  'blog': {
    personas: ['procurement', 'design', 'quality'],
    faqs: [
      { q: 'Need a quote for a custom titanium component?', a: 'Submit your drawing via our request-a-quote page and our engineers provide DFM feedback with a quote in 24-48 hours.' },
      { q: 'Which titanium grade should I choose?', a: 'Selection depends on strength, corrosion resistance and application — see our titanium alloy selection guide.' },
      { q: 'How do you ensure quality and traceability?', a: 'We are AS9100D / ISO 9001 certified and provide material certification with full lot traceability.' },
    ],
    related: [
      { label: 'Titanium alloy selection guide', href: '/blog/titanium-alloy-selection-guide-how-to-choose-grade/' },
      { label: 'How to choose a titanium CNC machining supplier', href: '/blog/how-to-choose-titanium-cnc-machining-supplier/' },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
  // ── 设备页配置（工艺/质量导向）──
  'equipment': {
    personas: ['manufacturing', 'quality', 'design'],
    faqs: [
      { q: 'What equipment do you use for titanium machining?', a: '5-axis machining centers, turn-mill CNC, wire EDM, CMM, laser trackers, robotic pallet systems and vacuum heat-treat furnaces.' },
      { q: 'How do you ensure precision and repeatability?', a: 'In-house CMM metrology and laser-tracker 3D scanning verify dimensions; controlled machining holds tolerances down to ±0.005 mm.' },
      { q: 'How is inspection and quality verified?', a: 'CMM, laser tracker and 3D scanner inspection per ASME Y14.5 with first article reports.' },
    ],
    related: [
      { label: '3D CMM inspection', href: '/products/capabilities/3d-cmm-inspection/', localized: true },
      { label: 'Capabilities & certifications', href: '/capabilities/', localized: true },
      { label: 'Request a quote', href: '/rfq/', localized: true },
    ],
  },
};

const cfg = CONFIG[industry] ?? CONFIG['industrial-equipment'];

const faqLdJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: cfg.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

function linkFor(href: string, localized?: boolean): string {
  return localized ? localizePath(href, lang) : href;
}
---
<section class="relative py-16" style="background-color: var(--theme-surface); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);" aria-label="Audience guidance">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
    <div class="rounded-2xl p-6 sm:p-10" style="border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent); background: color-mix(in srgb, var(--theme-bg) 60%, transparent);">
      <div class="inline-flex items-center px-3 py-1 text-xs font-semibold rounded-full border mb-4" style="border-color: var(--theme-primary); color: var(--theme-primary);">
        {t('audience.hub.badge')}
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold mb-2" style="color: var(--theme-text);">
        {t('audience.hub.title')}
      </h2>
      <p class="mb-6" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t('audience.hub.subtitle')}
      </p>

      <!-- Persona chips -->
      <div class="flex flex-wrap gap-2 mb-8" role="list" aria-label="Audience personas">
        {cfg.personas.map((p) => (
          <span role="listitem" class="inline-flex items-center px-3 py-1 text-sm font-medium rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); color: var(--theme-primary);">
            {PERSONA_LABEL[p] ?? p}
          </span>
        ))}
      </div>

      <!-- FAQ -->
      <h3 class="text-lg font-bold mb-4" style="color: var(--theme-text);">
        {t('audience.hub.faqTitle')}
      </h3>
      <div class="space-y-3 mb-8">
        {cfg.faqs.map((f) => (
          <details class="group rounded-xl border px-4 py-3" style="border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
            <summary class="cursor-pointer font-medium" style="color: var(--theme-text);">
              {f.q}
            </summary>
            <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
              {f.a}
            </p>
          </details>
        ))}
      </div>

      <!-- Related resources -->
      <h3 class="text-lg font-bold mb-4" style="color: var(--theme-text);">
        {t('audience.hub.relatedTitle')}
      </h3>
      <ul class="space-y-2 mb-8">
        {cfg.related.map((r) => (
          <li>
            <a href={linkFor(r.href, r.localized)} class="inline-flex items-center gap-2 font-medium transition-colors" style="color: var(--theme-primary);">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              {r.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA -->
      <a href={localizePath('/rfq/', lang)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 font-semibold rounded-xl transition-all duration-300 hover:scale-105" style="background-color: var(--theme-primary); color: #ffffff;">
        {t('audience.hub.cta')}
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={faqLdJson} />
