---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { EquipmentData } from '../../data/equipment';

export interface Props {
  equipment: EquipmentData;
  equipmentKey: string;
}

const { equipment, equipmentKey } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pfx = `equipment.${equipmentKey}.hasProperty`;
const _t = (key: string, fallback: string) => { const v = t(key); return v !== key ? v : fallback; };
const secTitle = _t(`${pfx}.title`, equipment.hasProperty.title);
const secDesc = _t(`${pfx}.description`, equipment.hasProperty.description);
---

<section class="relative py-20 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-6xl mx-auto">
    <div class="mb-12">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        Technical Specifications
      </div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
        {secTitle}
      </h2>
      <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {secDesc}
      </p>
    </div>

    <div class="overflow-hidden rounded-xl" style="border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
      <table class="w-full">
        <thead>
          <tr style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <th class="px-6 py-4 text-left text-sm font-semibold uppercase tracking-wider" style="color: var(--theme-text);">Parameter</th>
            <th class="px-6 py-4 text-left text-sm font-semibold uppercase tracking-wider" style="color: var(--theme-text);">Specification</th>
          </tr>
        </thead>
        <tbody>
          {equipment.hasProperty.properties.map((prop, i) => (
            <tr class="border-t odd:bg-transparent even:bg-[color-mix(in_srgb,var(--theme-surface)_30%,transparent)]" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
              <td class="px-6 py-4 text-sm font-medium" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{_t(`${pfx}.props.${i}.label`, prop.label)}</td>
              <td class="px-6 py-4 text-sm font-semibold font-mono" style="color: var(--theme-text);">{_t(`${pfx}.props.${i}.value`, prop.value)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>