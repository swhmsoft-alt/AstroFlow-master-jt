---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { EQUIPMENT_DATA } from '../../data/equipment';
import type { EquipmentData } from '../../data/equipment';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const equipmentList: EquipmentData[] = Object.values(EQUIPMENT_DATA);

const categories = [...new Set(equipmentList.map(e => e.category))];
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-7xl mx-auto">

    <!-- Category Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-16">
      {categories.map(cat => {
        const count = equipmentList.filter(e => e.category === cat).length;
        return (
          <div class="p-5 rounded-xl text-center" style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
            <div class="text-3xl font-bold mb-1" style="color: var(--theme-primary);">{count}</div>
            <div class="text-sm font-medium" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{cat}</div>
          </div>
        );
      })}
    </div>

    <!-- Equipment Table -->
    <div class="overflow-hidden rounded-xl" style="border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
      <table class="w-full">
        <thead>
          <tr style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <th class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-text);">{t('equipment.list.column.equipment')}</th>
            <th class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider hidden md:table-cell" style="color: var(--theme-text);">{t('equipment.list.column.category')}</th>
            <th class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider hidden lg:table-cell" style="color: var(--theme-text);">{t('equipment.list.column.specification')}</th>
            <th class="px-5 py-4 text-center text-xs font-semibold uppercase tracking-wider" style="color: var(--theme-text);">{t('equipment.list.column.details')}</th>
          </tr>
        </thead>
        <tbody>
          {equipmentList.map((eq, i) => (
            <tr class="border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent); background-color: i % 2 === 0 ? 'transparent' : 'color-mix(in srgb, var(--theme-surface) 20%, transparent)';">
              <td class="px-5 py-4">
                <div class="font-semibold text-sm" style="color: var(--theme-text);">{t(`equipment.${eq.key}.name`)}</div>
                <div class="text-xs mt-0.5" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t(`equipment.${eq.key}.badge`)}</div>
              </td>
              <td class="px-5 py-4 text-sm hidden md:table-cell" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
                {eq.category}
              </td>
              <td class="px-5 py-4 text-sm hidden lg:table-cell font-mono" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
                {t(`equipment.${eq.key}.hasProperty.properties.0.value`)}
              </td>
              <td class="px-5 py-4 text-center">
                <a
                  href={`/${lang !== 'en' ? lang + '/' : ''}equipment/${eq.key}`}
                  class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg transition-all duration-200 hover:opacity-80"
                  style="background-color: var(--theme-primary); color: white;"
                >
                  {t('equipment.list.viewSpecs')}
                  <svg class="w-3 h-3 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Note -->
    <p class="text-xs mt-6 text-center" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
      {t('equipment.list.note')}
    </p>
  </div>
</section>