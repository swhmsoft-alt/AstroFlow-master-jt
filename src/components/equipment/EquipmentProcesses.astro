---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { EquipmentData } from '../../data/equipment';

export interface Props {
  equipment: EquipmentData;
  equipmentKey: string;
}

const { equipment, equipmentKey } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pfx = `equipment.${equipmentKey}.processedBy`;
const _t = (key: string, fallback: string) => { const v = t(key); return v !== key ? v : fallback; };
const secTitle = _t(`${pfx}.title`, equipment.processedBy.title);
const secDesc = _t(`${pfx}.description`, equipment.processedBy.description);
---

<section class="relative py-20 overflow-hidden" style="background-color: color-mix(in srgb, var(--theme-surface) 50%, transparent);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-6xl mx-auto">
    <div class="mb-12">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Operations & Capabilities
      </div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
        {secTitle}
      </h2>
      <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {secDesc}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {equipment.processedBy.items.map((item, i) => (
        <div class="flex items-start p-4 rounded-lg" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);">
          <svg class="w-5 h-5 mt-0.5 mr-3 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
          <span class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
            {_t(`${pfx}.items.${i}`, item)}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>