---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { EquipmentData } from '../../data/equipment';

export interface Props {
  equipment: EquipmentData;
  equipmentKey: string;
}

const { equipment, equipmentKey } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pfx = `equipment.${equipmentKey}.alternativeTo`;
const _t = (key: string, fallback: string) => { const v = t(key); return v !== key ? v : fallback; };
const secTitle = _t(`${pfx}.title`, equipment.alternativeTo.title);
const secDesc = _t(`${pfx}.description`, equipment.alternativeTo.description);
---

<section class="relative py-20 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-6xl mx-auto">
    <div class="mb-12">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
        Alternative & Complementary Options
      </div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
        {secTitle}
      </h2>
      <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {secDesc}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {equipment.alternativeTo.items.map((item, i) => (
        <div class="flex items-start p-4 rounded-lg" style="background-color: color-mix(in srgb, var(--theme-surface) 30%, transparent); border: 1px solid color-mix(in srgb, var(--theme-warning) 15%, transparent);">
          <svg class="w-5 h-5 mt-0.5 mr-3 shrink-0" style="color: var(--theme-warning);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
          <span class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
            {_t(`${pfx}.items.${i}`, item)}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>