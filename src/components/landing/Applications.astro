---
// Applications.astro — Industrial gallery: real titanium parts, placeholder visuals.
const parts = [
  {
    badge: 'Aerospace Structural Element',
    title: 'Aerospace Structural Elements',
    desc: 'Brackets, fittings & frames machined from Grade 5 Ti-6Al-4V under AS9100D-controlled processes.',
    monogram: 'AERO',
    icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    badge: 'Orthopedic Bone Screw',
    title: 'Orthopedic Bone Screws',
    desc: 'Implant-grade Grade 23 ELI (Ti-6Al-4V ELI) parts machined in cleanroom-controlled environments.',
    monogram: 'MED',
    icon: 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    badge: 'Marine Valve Components',
    title: 'Marine Valve Components',
    desc: 'Corrosion-resistant titanium valves, shafts & housings engineered for extreme offshore service.',
    monogram: 'MAR',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    badge: 'Motorsport Fasteners',
    title: 'Motorsport Fasteners',
    desc: 'High-strength titanium bolts, studs & hardware for racing and high-performance vehicles.',
    monogram: 'MTR',
    icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
  },
];
---

<section id="applications" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <header class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary); letter-spacing: 0.12em;">Applications</p>
      <h2 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">
        Titanium Parts That Perform Where It Matters
      </h2>
      <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        From aircraft structures to surgical implants, precision titanium machining delivers the strength, bio-compatibility,
        and corrosion resistance that demanding industries rely on.
      </p>
    </header>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        parts.map((p) => (
          <article class="group overflow-hidden rounded-2xl border transition-transform duration-200 hover:-translate-y-1" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
            <!-- Visual placeholder block -->
            <div
              class="relative flex h-40 items-center justify-center overflow-hidden"
              style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 20%, var(--theme-bg)) 0%, color-mix(in srgb, var(--theme-accent) 10%, var(--theme-surface)) 100%);"
            >
              <svg class="h-14 w-14 opacity-80 transition-transform duration-300 group-hover:scale-110" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={p.icon} />
              </svg>
              <span
                class="absolute left-3 top-3 rounded-md px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider"
                style="background: rgba(15,23,42,0.75); color: var(--theme-primary); letter-spacing: 0.08em; border: 1px solid color-mix(in srgb, var(--theme-primary) 35%, transparent);"
              >[{p.badge}]</span>
              <span class="absolute bottom-2 right-3 text-2xl font-black opacity-20" style="color: var(--theme-text); letter-spacing: 0.15em;">{p.monogram}</span>
            </div>

            <div class="p-5">
              <h3 class="text-base font-bold leading-snug" style="color: var(--theme-text);">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{p.desc}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
