---
/**
 * src/components/seo/BreadcrumbNav.astro
 *
 * 自动面包屑导航组件 + JSON-LD BreadcrumbList Schema。
 *
 * 内链蜘蛛网规则 1（纵向单向收拢 Specs → Hub）的实现核心：
 *   在 Specs 页头部自动渲染面包屑：
 *     Home > [对应 Hub 页面名称] > 当前 Specs
 *   将 Specs 的 PageRank 无损地向 Hub 汇聚。
 *
 * 使用方式：
 *   <BreadcrumbNav
 *     lang={currentLang}
 *     items={[
 *       { label: "Home", slug: "" },
 *       { label: hubTitle, slug: hubSlug, collection: "applications" },
 *       { label: specTitle, slug: "", isCurrent: true },
 *     ]}
 *     siteUrl="https://cnc.bozemetal.com"
 *   />
 *
 * 多语言安全：所有链接通过 localizePath 自动适配当前语种。
 */

import {
  buildBreadcrumbItems,
  buildBreadcrumbLdJson,
  type BreadcrumbItem,
} from '../../utils/seo-linking';

interface Props {
  /** 当前页面语言代码 */
  lang: string;
  /** 面包屑层级列表（从首页到当前页） */
  items: BreadcrumbItem[];
  /** 站点根 URL */
  siteUrl?: string;
  /** 是否自动隐藏当前页链接（仅展示文本） */
  hideCurrentLink?: boolean;
}

const {
  lang,
  items,
  siteUrl = 'https://cnc.bozemetal.com',
  hideCurrentLink = true,
} = Astro.props;

const enrichedItems = buildBreadcrumbItems(lang, items);
const ldJson = buildBreadcrumbLdJson(enrichedItems, siteUrl);
---

<!-- JSON-LD Breadcrumb Schema -->
<script type="application/ld+json" set:html={ldJson} />

<!-- 视觉面包屑导航 — 与 listing 页面统一的全宽 border-b 容器 -->
<nav class="border-b" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);" aria-label="Breadcrumb">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <ol class="flex items-center space-x-2 py-4 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
      {
        enrichedItems.map((item, index) => {
          const isLast = index === enrichedItems.length - 1;
          return (
            <li
              itemprop="itemListElement"
              itemscope
              itemtype="https://schema.org/ListItem"
              class="flex items-center"
            >
              {/* 分隔符（非首项） */}
              {index > 0 && (
                <span style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);" class="mx-2">/</span>
              )}

              {/* 链接或纯文本 */}
              {isLast ? (
                <span
                  itemprop="name"
                  style="font-weight:600;color:var(--theme-text);"
                  aria-current="page"
                >
                  {item.label}
                </span>
              ) : item.href && item.href !== '#' ? (
                <a
                  href={item.href}
                  itemprop="item"
                  style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);"
                  onmouseover="this.style.color='var(--theme-primary)'"
                  onmouseout="this.style.color='color-mix(in srgb, var(--theme-text) 45%, transparent)'"
                >
                  <span itemprop="name">{item.label}</span>
                </a>
              ) : (
                <span itemprop="name" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
                  {item.label}
                </span>
              )}

              {/* Schema position */}
              <meta itemprop="position" content={String(index + 1)} />
            </li>
          );
        })
      }
    </ol>
  </div>
</nav>
