---
// src/components/product/RichEntityContent.astro
// Orchestration layer — Composes all B2B components in procurement decision order

import ProductHero from '../products/ProductHero.astro';
import SpecificationTable from '../products/SpecificationTable.astro';
import ProcurementMatrix from '../products/ProcurementMatrix.astro';
import QualityComplianceWall from '../products/QualityComplianceWall.astro';
import SemanticClosedLoop from '../products/SemanticClosedLoop.astro';
import SpecBlock from '../products/SpecBlock.astro';
import EngineeringReport from '../products/EngineeringReport.astro';
import InquiryForm from '../react/InquiryForm.tsx';

export interface Props {
  SpecContent: any;
  data: any;
  specEntry?: any;
  materialSlug?: string;
  pageSlug?: string;
}

const { SpecContent, data, specEntry, materialSlug, pageSlug } = Astro.props;
const fm = specEntry?.data || {};

const moq = typeof fm.moq === 'number' ? fm.moq : (typeof fm.moq === 'string' ? parseInt(fm.moq) || 1 : 1);
const compliance: string[] = fm.compliance || [];
const standards: string[] = fm.standards || [];
const upstream: string[] = fm.upstream || [];
const downstream: string[] = fm.downstream || [];
// FAQ: prefer specEntry data, fall back to product-entities JSON data
const faqs = (fm.faqs && fm.faqs.length > 0) ? fm.faqs : (data.faq || []);
---

<!-- 1. Product Hero — Visual + SKU + MOQ + RFQ -->
<ProductHero
  title={data.title}
  sku={fm.sku || ''}
  moq={moq}
  material={fm.titanium_grade || data.material || ''}
  func={data.function}
  category={data.category}
  industry={data.industry}
  compliance={compliance}
  density={fm.density}
  tensile_strength={fm.tensile_strength}
  yield_strength={fm.yield_strength}
  materialSlug={materialSlug}
/>

<!-- 2. TOC Navigation -->
<div class="py-4" style="background: var(--theme-surface); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap gap-2 text-xs" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
      <span class="font-semibold" style="color: var(--theme-text);">Jump to:</span>
      <a href="#tech-specs" class="px-2.5 py-1 rounded-full border transition-colors" style="border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">Specifications</a>
      <a href="#procurement-matrix" class="px-2.5 py-1 rounded-full border transition-colors" style="border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">Procurement</a>
      <a href="#compliance-wall" class="px-2.5 py-1 rounded-full border transition-colors" style="border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">Compliance</a>
      <a href="#knowledge-graph" class="px-2.5 py-1 rounded-full border transition-colors" style="border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">Topology</a>
      <a href="#inquiry-section" class="px-2.5 py-1 rounded-full border transition-colors" style="border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">Custom Titanium Part</a>
    </div>
    {data.aliases && data.aliases.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2 text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
        <span class="font-semibold" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">Also known as:</span>
        {data.aliases.map((a: string) => (
          <span class="px-2 py-0.5 rounded" style="background: color-mix(in srgb, var(--theme-primary) 6%, transparent);">{a}</span>
        ))}
      </div>
    )}
  </div>
</div>

<!-- 3. Specification Table — Mechanical/Dimensional parameters -->
<SpecificationTable
  sku={fm.sku || ''}
  unsNumber={fm.uns_number}
  werkstoffNumber={fm.werkstoff_number}
  standards={standards}
  tensileStrength={fm.tensile_strength}
  yieldStrength={fm.yield_strength}
  elongation={fm.elongation}
  hardness={fm.hardness}
  density={fm.density}
  modulus={fm.modulus}
  thermalConductivity={fm.thermal_conductivity}
  maxServiceTemp={fm.max_service_temp}
  surfaceFinish={fm.surface_finish}
  tolerances={fm.tolerances}
  ndtMethods={fm.ndt_methods}
  materialSlug={materialSlug}
/>

<!-- 4. Spec Block — Dark technical quick-scan card -->
<SpecBlock
  title={data.title}
  sku={fm.sku || ''}
  category={data.category}
  industry={data.industry}
  system={data.system}
  titanium_grade={fm.titanium_grade || ''}
  uns_number={fm.uns_number}
  werkstoff_number={fm.werkstoff_number}
  supply_availability={fm.supply_availability}
  compliance={compliance}
  standards={standards}
  function={data.function}
  density={fm.density}
  tensile_strength={fm.tensile_strength}
  yield_strength={fm.yield_strength}
  elongation={fm.elongation}
  hardness={fm.hardness}
  modulus={fm.modulus}
  thermal_conductivity={fm.thermal_conductivity}
  max_service_temp={fm.max_service_temp}
  surface_finish={fm.surface_finish}
  tolerances={fm.tolerances}
  ndt_methods={fm.ndt_methods}
  manufacturing_process={fm.manufacturing_process}
  weight_reduction={fm.weight_reduction}
  upstream={upstream}
  downstream={downstream}
  faqs={faqs}
  materialSlug={materialSlug}
/>

<!-- 5. Deep Engineering Report — Structured Supply Chain / Application / Manufacturing -->
<EngineeringReport
  title={data.title}
  sku={fm.sku || ''}
  category={data.category}
  industry={data.industry}
  titanium_grade={fm.titanium_grade || data.material || ''}
  uns_number={fm.uns_number}
  werkstoff_number={fm.werkstoff_number}
  compliance={compliance}
  standards={standards}
  density={fm.density}
  tensile_strength={fm.tensile_strength}
  yield_strength={fm.yield_strength}
  thermal_conductivity={fm.thermal_conductivity}
  modulus={fm.modulus}
  manufacturing_process={fm.manufacturing_process}
  weight_reduction={fm.weight_reduction}
  materialSlug={materialSlug}
  sectionTitles={{
    application: data.sectionTitles?.whyTitanium || data.title,
    quality: data.sectionTitles?.inspection,
    manufacturing: data.sectionTitles?.manufacturing,
  }}
/>

<!-- 6. Procurement Matrix — MOQ / Lead Times / Incoterms -->
<ProcurementMatrix
  moq={moq}
  sampleLeadTime={fm.sampleLeadTime || '3-5 Business Days'}
  bulkLeadTime={fm.bulkLeadTime || '15-25 Business Days (Batch Dependent)'}
  incoterms={fm.incoterms || 'EXW / FOB Shenzhen'}
  title={data.title}
/>

<!-- 7. Quality Compliance Wall — Certifications Ledger -->
<QualityComplianceWall
  title={data.title}
  compliance={compliance}
  standards={standards}
  materialSlug={materialSlug}

/>

<!-- 8. Semantic Closed Loop — Topology + JSON-LD -->
<SemanticClosedLoop
  productName={data.title}
  sku={fm.sku || ''}
  material={fm.titanium_grade || data.material || ''}
  unsNumber={fm.uns_number || ''}
  upstream={upstream}
  downstream={downstream}
  industry={data.industry || ''}
  system={data.system || ''}
  materialSlug={materialSlug}
  pageSlug={pageSlug}

/>

<!-- 9. Inquiry Form — B2B Conversion (client:load) -->
<InquiryForm
  productTitle={data.title}
  productSku={fm.sku || ''}
  client:load
/>
