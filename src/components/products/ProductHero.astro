---
// src/components/products/ProductHero.astro
// B2B Product Visual + Essential Specs + RFQ Entry Point

interface Props {
  title: string;
  sku: string;
  moq: number;
  material: string;
  function: string;
  category: string;
  industry: string;
  compliance: string[];
  density?: string;
  tensile_strength?: string;
  yield_strength?: string;
  materialSlug?: string;
}

const { title, sku, moq, material, function: fn, category, industry, compliance, density, tensile_strength, yield_strength, materialSlug } = Astro.props;
const matShort = material.replace(/\(.*\)/, '').trim();
---

<div class="py-10 lg:py-14" style="background: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg)); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-8 items-start">

      <!-- Left: Title + Specs + CTA -->
      <div class="space-y-5">
        <!-- Breadcrumb-style badges -->
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="px-2.5 py-1 rounded font-semibold" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">{industry}</span>
          <span style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);">/</span>
          <span class="px-2.5 py-1 rounded" style="background: color-mix(in srgb, var(--theme-text) 6%, transparent); color: color-mix(in srgb, var(--theme-text) 50%, transparent);">{category}</span>
          <span style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);">/</span>
          <span class="font-mono text-[10px]" style="color: color-mix(in srgb, var(--theme-text) 40%, transparent);">SKU: {sku}</span>
        </div>

        <h1 class="text-3xl md:text-4xl font-bold leading-tight" style="color: var(--theme-text);">{title}</h1>
        <p class="text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{fn}</p>

        <!-- Material + MOQ inline -->
        <div class="flex flex-wrap gap-3">
          <div class="card-titanium px-4 py-2">
            <span class="text-[10px] font-semibold uppercase block" style="color: color-mix(in srgb, var(--theme-primary) 50%, transparent);">Material</span>
            {materialSlug ? (
              <a href={`/materials/${materialSlug}/`} class="text-sm font-bold" style="color: var(--theme-primary); text-decoration: underline; text-underline-offset: 2px;">{matShort} &rarr;</a>
            ) : (
              <strong class="text-sm" style="color: var(--theme-text);">{matShort}</strong>
            )}
          </div>
          <div class="card-titanium px-4 py-2">
            <span class="text-[10px] font-semibold uppercase block" style="color: color-mix(in srgb, var(--theme-primary) 50%, transparent);">MOQ</span>
            <strong class="text-sm" style="color: var(--theme-text);">{moq} Unit{moq !== 1 ? 's' : ''}</strong>
          </div>
          {density && (
            <div class="card-titanium px-4 py-2">
              <span class="text-[10px] font-semibold uppercase block" style="color: color-mix(in srgb, var(--theme-primary) 50%, transparent);">Density</span>
              <strong class="text-sm" style="color: var(--theme-text);">{density}</strong>
            </div>
          )}
        </div>

        <!-- CTA -->
        <a href="#inquiry-section" class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-3.5 text-sm font-bold rounded-xl transition-all" style="background: var(--theme-primary); color: var(--theme-text);">
          Request Enterprise Pricing
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>

      <!-- Right: Image / Visual Placeholder -->
      <div class="card-titanium border-2 border-dashed flex items-center justify-center min-h-[260px] lg:min-h-[320px]" style="background: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
        <div class="text-center px-6">
          <svg class="w-12 h-12 mx-auto mb-3" style="color: color-mix(in srgb, var(--theme-primary) 25%, transparent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-xs font-medium" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);">{matShort} Product Rendering</p>
          <p class="text-[10px] mt-1" style="color: color-mix(in srgb, var(--theme-text) 25%, transparent);">Upload CAD / 3D scan to replace</p>
        </div>
      </div>
    </div>
  </div>
</div>
