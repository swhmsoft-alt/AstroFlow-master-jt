---
// src/components/products/SpecificationTable.astro
// B2B Technical Specifications Matrix — only product-specific fields

interface Props {
  sku: string;
  standards: string[];
  surfaceFinish?: string;
  tolerances?: string;
  ndtMethods?: string;
  materialSlug?: string;
}

const { sku, standards, surfaceFinish, tolerances, ndtMethods, materialSlug } = Astro.props;

const STANDARD_SLUGS: Record<string, string> = {
  'ASTM B348': 'astm-b348',
  'ASTM B265': 'astm-b265',
  'ASTM B381': 'astm-b381',
  'ASTM B338': 'astm-b338',
  'ASTM B861': 'astm-b861',
  'ASTM F67': 'astm-f67',
  'ASTM F136': 'astm-f136',
  'ASTM F86': 'astm-f86',
  'ISO 5832-3': 'iso-5832-3',
  'ISO 5832-11': 'iso-5832-11',
  'ISO 2768-m': 'iso-2768',
  'ISO 9001:2015': 'iso-9001',
  'ISO 9001': 'iso-9001',
  'AS9100D': 'as9100d',
  'ASME': 'asme-bpvc',
  'MIL-STD-810H': 'mil-std-810h',
  'ASTM B117': 'astm-b117',
  'NACE MR0175': 'nace-mr0175',
  'NORSOK M-001': 'norsok-m-001',
  'API 6A': 'api-6a',
  'DIN 13-1': 'din-13-1',
  'ISO 965-2': 'iso-965-2',
  'EN 10204 3.1': 'en-10204-3-1',
  'REACH': 'reach',
  'RoHS 3': 'rohs-3',
  'IATF 16949': 'iatf-16949',
};

function resolveLink(slug: string): string {
  const key = Object.keys(STANDARD_SLUGS).find(k => slug.includes(k));
  return key ? `/standards/${STANDARD_SLUGS[key]}/` : '#';
}
---

<section class="py-10 lg:py-12" style="background: var(--theme-bg);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="border-b" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
          <th class="py-3 px-4 text-left font-semibold" style="color: var(--theme-text);">Technical Parameter</th>
          <th class="py-3 px-4 text-left font-semibold" style="color: var(--theme-text);">Specification</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
          <td class="py-3 px-4" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Component SKU</td>
          <td class="py-3 px-4 font-mono text-xs" style="color: var(--theme-text);">{sku}</td>
        </tr>
        <tr class="border-b" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
          <td class="py-3 px-4" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Standards &amp; Specifications</td>
          <td class="py-3 px-4" style="color: var(--theme-text);">
            {standards.length > 0 ? standards.map((s: string) => (
              <a href={resolveLink(s)} class="inline-block mr-2 mb-1 px-2 py-0.5 text-xs rounded" style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent); color: var(--theme-primary);">{s}</a>
            )) : <span class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">—</span>}
          </td>
        </tr>
        {surfaceFinish && (
        <tr class="border-b" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
          <td class="py-3 px-4" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Surface Finish</td>
          <td class="py-3 px-4" style="color: var(--theme-text);">{surfaceFinish}</td>
        </tr>
        )}
        {tolerances && (
        <tr class="border-b" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
          <td class="py-3 px-4" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Tolerances</td>
          <td class="py-3 px-4" style="color: var(--theme-text);">{tolerances}</td>
        </tr>
        )}
      </tbody>
    </table>
  </div>
</section>
