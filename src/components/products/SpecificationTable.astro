---
// src/components/products/SpecificationTable.astro
// B2B Technical Specifications Matrix from spec frontmatter data

interface Props {
  sku: string;
  unsNumber?: string;
  werkstoffNumber?: string;
  standards: string[];
  tensileStrength?: string;
  yieldStrength?: string;
  elongation?: string;
  hardness?: string;
  density?: string;
  modulus?: string;
  thermalConductivity?: string;
  maxServiceTemp?: string;
  surfaceFinish?: string;
  tolerances?: string;
  ndtMethods?: string;
  materialSlug?: string;
}

const { sku, unsNumber, werkstoffNumber, standards, tensileStrength, yieldStrength, elongation, hardness, density, modulus, thermalConductivity, maxServiceTemp, surfaceFinish, tolerances, ndtMethods, materialSlug } = Astro.props;

// Known material standard slugs for linking
const STANDARD_SLUGS: Record<string, string> = {
  'ASTM B348': 'astm-b348',
  'ASTM B265': 'astm-b265',
  'ASTM B381': 'astm-b381',
  'ASTM B338': 'astm-b338',
  'ASTM B861': 'astm-b861',
  'ASTM F136': 'astm-f136',
  'ASTM F67': 'astm-f67',
  'ASTM F86': 'astm-f86',
  'ASTM F2924': 'astm-f2924',
  'ASTM F3001': 'astm-f3001',
  'ISO 5832-3': 'iso-5832-3',
  'ISO 5832-11': 'iso-5832-11',
  'AMS 4911': 'ams-4911',
  'AMS 4928': 'ams-4928',
  'AMS 4943': 'ams-4943',
  'AMS 4944': 'ams-4944',
  'AMS 2488': 'ams-2488',
  'MIL-T-9047': 'mil-t-9047',
};

interface Row { param: string; value: string; standard: string; style: string; }
const r: Row[] = [];
const altStyle = 'color-mix(in srgb, var(--theme-bg) 50%, var(--theme-surface))';
function add(p: string, v: string, s: string) {
  r.push({ param: p, value: v, standard: s, style: r.length % 2 === 1 ? altStyle : 'transparent' });
}
function renderStandard(name: string): string {
  const slug = STANDARD_SLUGS[name];
  if (slug) {
    return `<a href="/materials/${slug}/" class="underline underline-offset-2" style="color: var(--theme-primary);">${name}</a>`;
  }
  return name;
}

function renderStandardsList(list: string[]): string {
  return list.map(s => renderStandard(s.trim())).join(', ');
}

add('Component SKU', sku, 'Manufacturing identifier');
if (unsNumber) add('UNS Number', unsNumber, 'Unified Numbering System');
if (werkstoffNumber) add('Werkstoff Number', werkstoffNumber, 'DIN EN Material Number');
if (standards.length > 0) add('International Standards', standards.join(', '), 'Manufacturing & material testing compliance');
if (tensileStrength) add('Tensile Strength ($R_m$)', tensileStrength, 'Mechanical minimum per ASTM');
if (yieldStrength) add('Yield Strength ($R_{p0.2}$)', yieldStrength, 'Structural load boundary');
if (elongation) add('Elongation ($A_5$)', elongation, 'Ductility for forming/assembly');
if (hardness) add('Hardness', hardness, 'Machinability & wear resistance');
if (density) add('Density & Weight Profile', density, 'Design engineering benchmark');
if (modulus) add('Modulus of Elasticity', modulus, 'Stiffness & deflection');
if (thermalConductivity) add('Thermal Conductivity', thermalConductivity, 'Thermal management');
if (maxServiceTemp) add('Max Continuous Service Temp', maxServiceTemp, 'Safe operating envelope');
if (surfaceFinish) add('Surface Finish', surfaceFinish, 'Corrosion / leakage protection');
if (tolerances) add('Dimensional Tolerances', tolerances, 'Assembly interchangeability');
if (ndtMethods) add('NDT & Inspection', ndtMethods, 'Verification per ISO/IEC');
---

<div class="py-10 lg:py-12" style="background: var(--theme-bg);" id="tech-specs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h3 class="text-lg font-bold mb-1" style="color: var(--theme-text);">Technical Specifications Matrix</h3>
    <p class="text-sm mb-6" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Mechanical, dimensional, and material properties for procurement engineering review.</p>
    <div class="card-titanium overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-primary) 50%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">Technical Parameter</th>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-primary) 50%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">Specification Value</th>
            <th class="text-left px-4 py-3 font-semibold text-xs uppercase tracking-wider hidden md:table-cell" style="color: color-mix(in srgb, var(--theme-primary) 50%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">Associated Standard</th>
          </tr>
        </thead>
        <tbody>
          {r.map((row) => (
            <tr style={`background: ${row.style}`}>
              <td class="px-4 py-2.5 font-medium" style="color: var(--theme-text); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 5%, transparent);">{row.param}</td>
              {row.param === 'International Standards' ? (
                <td class="px-4 py-2.5" style="color: var(--theme-text); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 5%, transparent);" set:html={renderStandardsList(standards)}></td>
              ) : (
                <td class="px-4 py-2.5" style="color: var(--theme-text); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 5%, transparent);">{row.value}</td>
              )}
              <td class="px-4 py-2.5 text-xs hidden md:table-cell" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 5%, transparent);">{row.standard}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>
