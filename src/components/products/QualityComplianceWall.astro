---
// src/components/products/QualityComplianceWall.astro
// Targets: QA Engineer / Regulatory Compliance
// Data source: specEntry.data.compliance[], data.title

interface Props {
  title: string;
  compliance: string[];
  standards: string[];
  materialSlug?: string;
}

const { title, compliance, standards, materialSlug } = Astro.props;

// Known material standard slugs for linking
const STANDARD_SLUGS: Record<string, string> = {
  'ASTM B348': 'astm-b348',
  'ASTM B265': 'astm-b265',
  'ASTM B381': 'astm-b381',
  'ASTM B338': 'astm-b338',
  'ASTM B861': 'astm-b861',
  'ASTM F136': 'astm-f136',
  'ASTM F67': 'astm-f67',
  'ASTM F86': 'astm-f86',
  'ASTM F2924': 'astm-f2924',
  'ASTM F3001': 'astm-f3001',
  'ISO 5832-3': 'iso-5832-3',
  'ISO 5832-11': 'iso-5832-11',
  'AMS 4911': 'ams-4911',
  'AMS 4928': 'ams-4928',
  'AMS 4943': 'ams-4943',
  'AMS 4944': 'ams-4944',
  'AMS 2488': 'ams-2488',
  'MIL-T-9047': 'mil-t-9047',
};

// Helper: render standard name as link if known slug exists
function renderStandard(name: string): string {
  const slug = STANDARD_SLUGS[name];
  if (slug) {
    return `<a href="/materials/${slug}/" class="underline underline-offset-2" style="color: var(--theme-primary);">${name}</a>`;
  }
  return name;
}

// Build certification entries from data
const allCerts: { name: string; standard: string; status: string }[] = [];

if (compliance.includes('EN 10204 3.1') || standards.some(s => s.includes('10204'))) {
  allCerts.push({ name: 'Material Test Certificate (MTC)', standard: 'EN 10204 3.1', status: 'Verified' });
}
if (compliance.some(c => c.toUpperCase().includes('REACH'))) {
  allCerts.push({ name: 'Environmental Compliance', standard: 'REACH (EC No 1907/2006)', status: 'Verified' });
}
if (compliance.some(c => c.toUpperCase().includes('ROHS'))) {
  allCerts.push({ name: 'Restricted Substances', standard: 'RoHS 3 Directive (2015/863/EU)', status: 'Verified' });
}
if (compliance.some(c => c.toUpperCase().includes('ISO 9001') || c.toUpperCase().includes('AS9100'))) {
  allCerts.push({ name: 'Quality Management System', standard: compliance.find(c => c.includes('ISO 9001') || c.includes('AS9100')) || 'ISO 9001:2015', status: 'Verified' });
}
if (compliance.some(c => c.toUpperCase().includes('ISO 2768'))) {
  allCerts.push({ name: 'Dimensional Tolerances', standard: compliance.find(c => c.includes('ISO 2768')) || 'ISO 2768-m', status: 'Verified' });
}
if (standards && standards.length > 0) {
  standards.forEach(s => {
    if (!allCerts.find(c => c.standard.includes(s))) {
      allCerts.push({ name: `Standard: ${s}`, standard: s, status: 'Available upon Request' });
    }
  });
}

if (allCerts.length === 0) {
  allCerts.push({ name: 'Material Test Certificate (MTC)', standard: 'EN 10204 3.1', status: 'Verified' });
  allCerts.push({ name: 'Environmental Compliance', standard: 'REACH / RoHS 3', status: 'Verified' });
}
---

<div class="py-10 lg:py-12" style="background: var(--theme-surface);" id="compliance-wall">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h3 class="text-lg font-bold mb-1" style="color: var(--theme-text);">Regulatory &amp; Quality Assurance Ledger</h3>
    <p class="text-sm mb-6" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Verifiable certifications for <strong style="color: var(--theme-text);">{title}</strong></p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {allCerts.map((cert) => (
        <div class="card-titanium p-3 flex items-center justify-between">
          <div>
            <h4 class="font-medium text-sm" style="color: var(--theme-text);">{cert.name}</h4>
            <p class="text-xs mt-0.5" style="color: color-mix(in srgb, var(--theme-text) 40%, transparent);" set:html={renderStandard(cert.standard)}></p>
          </div>
          <span class="text-[10px] font-semibold px-2 py-1 rounded-full" style="background: color-mix(in srgb, #10b981 12%, transparent); color: color-mix(in srgb, #10b981 90%, transparent);">{cert.status}</span>
        </div>
      ))}
    </div>
  </div>
</div>
