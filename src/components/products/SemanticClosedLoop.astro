---
// src/components/products/SemanticClosedLoop.astro
// Targets: LLM/SEO Crawlers + System Engineers
// Human-visible topology + Machine-readable JSON-LD injection

interface Props {
  productName: string;
  sku: string;
  material: string;
  unsNumber: string;
  upstream: string[];
  downstream: string[];
  industry: string;
  system: string;
}

const { productName, sku, material, unsNumber, upstream, downstream, industry, system } = Astro.props;

// Escape string for JSON
const esc = (s: string) => s.replace(/"/g, '\\"');
const skuLower = sku.toLowerCase();
const upStr = upstream.join('; ');
const downStr = downstream.join('; ');

// Build JSON-LD payload in frontmatter (avoids template literal issues in is:inline)
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": `https://bozemetal.com/products/product-entities/${skuLower}/#product`,
      "name": productName,
      "sku": sku,
      "material": material,
      "category": industry,
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "USD",
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "DefinedTermSet",
      "@id": `https://bozemetal.com/products/product-entities/${skuLower}/#topology`,
      "name": "Industrial Component Topology",
      "hasDefinedTerm": [
        {
          "@type": "DefinedTerm",
          "name": "Upstream Integration",
          "description": upStr
        },
        {
          "@type": "DefinedTerm",
          "name": "Downstream Interconnectivity",
          "description": downStr
        }
      ]
    },
    {
      "@type": "DefinedTermSet",
      "@id": `https://bozemetal.com/products/product-entities/${skuLower}/#classification`,
      "name": "Component Classification",
      "hasDefinedTerm": [
        { "@type": "DefinedTerm", "name": "Industry", "description": industry },
        { "@type": "DefinedTerm", "name": "System", "description": system }
      ]
    }
  ]
}, null, 2);
---

<!-- Human-Visible Topology Mapping for System Engineers -->
<section class="py-10 lg:py-12" style="background: var(--theme-bg); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);" id="knowledge-graph">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h3 class="text-lg font-bold mb-1" style="color: var(--theme-text);">Systems Interconnectivity &amp; Topology</h3>
    <p class="text-sm mb-6" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Cross-functional integration matrix for Tier-1 supply chains and assembly orchestration.</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Upstream -->
      <div class="p-5 rounded-xl border" style="background: color-mix(in srgb, var(--theme-primary) 5%, var(--theme-surface)); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <span class="text-[10px] font-bold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-primary) 60%, transparent);">Upstream System Integration</span>
        {upstream.length > 0 ? (
          <ul class="mt-3 space-y-1 text-sm" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            {upstream.map((item: string) => <li class="flex items-start gap-2"><span style="color: var(--theme-primary);">&#9656;</span> {item}</li>)}
          </ul>
        ) : (
          <p class="mt-3 text-sm" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);">Not specified</p>
        )}
      </div>

      <!-- Primary Component -->
      <div class="p-5 rounded-xl border-2" style="background: color-mix(in srgb, var(--theme-primary) 8%, var(--theme-surface)); border-color: color-mix(in srgb, var(--theme-primary) 25%, transparent);">
        <span class="text-[10px] font-bold uppercase tracking-wider" style="color: color-mix(in srgb, #10b981 80%, transparent);">Primary Inspected Component</span>
        <h4 class="mt-2 text-base font-bold" style="color: var(--theme-text);">{productName}</h4>
        <p class="text-xs mt-1 font-mono" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Material: {material} {unsNumber ? `(${unsNumber})` : ''}</p>
        <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);">SKU: {sku}</p>
        <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);">Industry: {industry} / System: {system}</p>
      </div>

      <!-- Downstream -->
      <div class="p-5 rounded-xl border" style="background: color-mix(in srgb, var(--theme-primary) 5%, var(--theme-surface)); border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <span class="text-[10px] font-bold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-primary) 60%, transparent);">Downstream Consumables</span>
        {downstream.length > 0 ? (
          <ul class="mt-3 space-y-1 text-sm" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            {downstream.map((item: string) => <li class="flex items-start gap-2"><span style="color: var(--theme-primary);">&#9656;</span> {item}</li>)}
          </ul>
        ) : (
          <p class="mt-3 text-sm" style="color: color-mix(in srgb, var(--theme-text) 35%, transparent);">Not specified</p>
        )}
      </div>
    </div>
  </div>
</section>

<!-- Machine-Readable Structured Graph Loop (built in frontmatter, injected as raw HTML) -->
<script type="application/ld+json" set:html={jsonLd} />
