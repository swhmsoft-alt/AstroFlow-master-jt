---
// src/components/products/EngineeringReport.astro
// Deep Engineering Report — replaces raw prose for Supply Chain / Application / Manufacturing sections

interface Props {
  title: string;
  sku: string;
  category: string;
  industry: string;
  titanium_grade: string;
  uns_number?: string;
  werkstoff_number?: string;
  compliance?: string[];
  standards?: string[];
  density?: string;
  tensile_strength?: string;
  yield_strength?: string;
  thermal_conductivity?: string;
  modulus?: string;
  manufacturing_process?: string;
  weight_reduction?: string;
}

const { title, sku, category, industry, titanium_grade, uns_number, werkstoff_number, compliance, standards, density, tensile_strength, yield_strength, thermal_conductivity, modulus, manufacturing_process, weight_reduction } = Astro.props;
---

<div class="py-10 lg:py-12" style="background: var(--theme-surface);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="mb-8 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
      <span class="h-2 w-2 rounded-full" style="background: var(--theme-primary);"></span>
      <span>Comprehensive Engineering Report &amp; Compliance Documentation</span>
    </div>

    <!-- ===== §1: Supply Chain & Quality Compliance ===== -->
    <section class="mb-10 border-b pb-8" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2" style="color: var(--theme-text);">
        <span style="color: var(--theme-primary);">§</span> Supply Chain, Traceability &amp; Quality Compliance
      </h2>

      <div class="grid md:grid-cols-2 gap-4">
        <!-- Traceability -->
        <div class="card-titanium p-4">
          <h3 class="text-sm font-semibold mb-2 flex items-center gap-1.5" style="color: var(--theme-text);">
            <span style="color: var(--theme-primary);">📄</span> Material Traceability
          </h3>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            Every production batch is 100% traceable from raw ingot to finished <strong style="color: var(--theme-text);">{title}</strong>. Shipments include a complete <strong>EN 10204 3.1</strong> Mill Test Certificate (MTC) detailing heat analysis chemical composition and destructive mechanical testing results per <strong>ASTM B348</strong> specification.
          </p>
        </div>

        <!-- NDT -->
        <div class="card-titanium p-4">
          <h3 class="text-sm font-semibold mb-2 flex items-center gap-1.5" style="color: var(--theme-text);">
            <span style="color: var(--theme-primary);">🔍</span> Non-Destructive Testing
          </h3>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            Components undergo <strong>Dimensional CMM</strong> per ISO 10360, <strong>Surface profilometry</strong> per ISO 4287, <strong>PMI</strong> per ASTM E1476 to guarantee zero sub-surface voids, micro-cracks, or structural anomalies. Threaded features verified with <strong>Go/No-Go ring gauges</strong> (Class 6g) per DIN 13-1 / ISO 965-2.
          </p>
        </div>

        <!-- Compliance -->
        <div class="card-titanium p-4">
          <h3 class="text-sm font-semibold mb-2 flex items-center gap-1.5" style="color: var(--theme-text);">
            <span style="color: var(--theme-primary);">🌱</span> Environmental Compliance
          </h3>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            100% compliant with <strong>REACH Regulation</strong> (EC No 1907/2006) and <strong>RoHS 3 Directive</strong> (2015/863/EU). Certificate of Conformity (CoC) issued with every shipment.
          </p>
        </div>

        <!-- Quality Management -->
        <div class="card-titanium p-4">
          <h3 class="text-sm font-semibold mb-2 flex items-center gap-1.5" style="color: var(--theme-text);">
            <span style="color: var(--theme-primary);">🏭</span> Quality Management
          </h3>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            Manufactured in <strong>ISO 9001:2015</strong> and <strong>AS9100D</strong>-certified facilities. <strong>First Article Inspection (FAI)</strong> reports available upon request per AS9102.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== §2: Application Dynamics ===== -->
    <section class="mb-10 border-b pb-8" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2" style="color: var(--theme-text);">
        <span style="color: var(--theme-primary);">§</span> Application Dynamics &amp; Alternative Displacement
      </h2>

      <!-- Corrosion -->
      <div class="card-titanium p-4 mb-4">
        <h3 class="text-sm font-semibold mb-2 flex items-center gap-1.5" style="color: var(--theme-text);">
          <span style="color: var(--theme-primary);">🛡️</span> Corrosion Kinetics &amp; Operating Boundaries
        </h3>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          In consumer electronics applications, <strong>{title}</strong> Titanium's native <strong>TiO₂ passive layer</strong> provides complete immunity to galvanic corrosion when mated with aluminum or stainless steel chassis components in sweat, humidity, and salt-fog environments (<strong>MIL-STD-810H</strong> certified). The material's low thermal conductivity (<strong>{thermal_conductivity || '6.7 W/m·K'}</strong>) provides critical thermal isolation and dimensional stability.
        </p>
      </div>

      <!-- Galvanic -->
      <div class="card-titanium p-4 mb-4">
        <h3 class="text-sm font-semibold mb-2 flex items-center gap-1.5" style="color: var(--theme-text);">
          <span style="color: var(--theme-primary);">⚡</span> Galvanic Isolation &amp; Material Compatibility
        </h3>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          Titanium's modulus (<strong>{modulus || '105-114 GPa'}</strong>) reduces stress shielding. The <strong>TiO₂ passive layer</strong> (maintained via <strong>ASTM F86 passivation</strong> — 20-30% HNO₃ bath, 30 min at 50°C) removes iron contamination and restores the full oxide barrier, providing electrical isolation for antenna window compatibility.
        </p>
      </div>

      <!-- TCO -->
      <div class="card-titanium p-4" style="border-left: 3px solid color-mix(in srgb, var(--theme-primary) 30%, transparent);">
        <h3 class="text-sm font-semibold mb-2 flex items-center gap-1.5" style="color: var(--theme-text);">
          <span style="color: var(--theme-primary);">💰</span> Lifecycle Cost Benefit
        </h3>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          While the initial acquisition cost is 2-4x that of 316L or aluminum equivalents, the lifecycle TCO favors titanium:
        </p>
        <ul class="mt-2 space-y-1 text-sm" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          <li class="flex items-start gap-2"><span style="color: var(--theme-primary); font-weight:bold;">(1)</span> Zero corrosion in sweat/salt environments</li>
          <li class="flex items-start gap-2"><span style="color: var(--theme-primary); font-weight:bold;">(2)</span> {weight_reduction || '45% weight reduction vs steel (7.85 g/cm³)'} reducing device mass</li>
          <li class="flex items-start gap-2"><span style="color: var(--theme-primary); font-weight:bold;">(3)</span> Fatigue endurance &gt;500 MPa for 200,000+ fold cycles</li>
          <li class="flex items-start gap-2"><span style="color: var(--theme-primary); font-weight:bold;">(4)</span> Scratch resistance 3x greater than anodized aluminum</li>
        </ul>
      </div>
    </section>

    <!-- ===== §3: Advanced Manufacturing ===== -->
    <section class="mb-6">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2" style="color: var(--theme-text);">
        <span style="color: var(--theme-primary);">§</span> Advanced Manufacturing &amp; Mechanical Stress Control
      </h2>

      <div class="grid md:grid-cols-2 gap-4">
        <!-- CNC Strategy -->
        <div class="card-titanium p-4">
          <h3 class="text-sm font-semibold mb-2 flex items-center gap-1.5" style="color: var(--theme-text);">
            <span style="color: var(--theme-primary);">🔧</span> CNC Tooling &amp; Execution Strategy
          </h3>
          <p class="text-sm leading-relaxed mb-3" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
            Titanium's low thermal conductivity (~10% of aluminum) requires strict parameter controls:
          </p>
          <ul class="space-y-1.5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            <li class="flex items-start gap-2"><span style="color: var(--theme-primary); font-weight:bold;">(a)</span> Cutting speed <em>$V_c$</em> = 40-60 m/min roughing, 60-80 m/min finishing — K313 carbide + TiAlN coating</li>
            <li class="flex items-start gap-2"><span style="color: var(--theme-primary); font-weight:bold;">(b)</span> Feed rate <em>$f$</em> = 0.08-0.15 mm/rev — constant chip load prevents work-hardening</li>
            <li class="flex items-start gap-2"><span style="color: var(--theme-primary); font-weight:bold;">(c)</span> High-pressure flood coolant (&gt;70 bar / 1000 psi) suppresses adiabatic shear bands</li>
            <li class="flex items-start gap-2"><span style="color: var(--theme-primary); font-weight:bold;">(d)</span> Rigid setups — tool overhang &lt;3:1 ratio eliminates deflection-induced chatter</li>
          </ul>
        </div>

        <!-- Stress Relief -->
        <div class="card-titanium p-4">
          <h3 class="text-sm font-semibold mb-2 flex items-center gap-1.5" style="color: var(--theme-text);">
            <span style="color: var(--theme-primary);">🔥</span> Residual Stress Mitigation
          </h3>
          <p class="text-sm leading-relaxed mb-3" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
            Post-machining stress management eliminates micro-structural tension:
          </p>
          <ul class="space-y-1.5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            <li class="flex items-start gap-2"><span style="color: var(--theme-primary); font-weight:bold;">•</span> <strong>Vacuum annealing</strong> at 540-675°C for 1-2 h under Argon (O₂ &lt;50 ppm) — reduces distortion risk &gt;70%</li>
            <li class="flex items-start gap-2"><span style="color: var(--theme-primary); font-weight:bold;">•</span> <strong>Thread rolling</strong> (not cutting) induces compressive residual stresses — increases fatigue strength by 30-50%</li>
            <li class="flex items-start gap-2"><span style="color: var(--theme-primary); font-weight:bold;">•</span> <strong>ISO 965-2 Class 6g</strong> verified with calibrated Go/No-Go ring gauges on 100% of production</li>
          </ul>
        </div>
      </div>
    </section>

  </div>
</div>
