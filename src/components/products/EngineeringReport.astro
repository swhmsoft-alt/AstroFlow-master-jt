---
// src/components/products/EngineeringReport.astro
// Per-product generated content — no shared template text

interface Props {
  title: string;
  sku: string;
  category: string;
  industry: string;
  titanium_grade: string;
  func: string;
  manufacturing_process?: string;
  weight_reduction?: string;
  materialSlug?: string;
}

// Safe string helpers — avoid toLowerCase on undefined
const s = (v: any, fallback = '') => (v || fallback).toString();
const t = Astro.props;
const title = s(t.title);
const sku = s(t.sku);
const category = s(t.category);
const industry = s(t.industry);
const titanium_grade = s(t.titanium_grade);
const fn = s(t.func);
const manufacturing_process = s(t.manufacturing_process);
const weight_reduction = s(t.weight_reduction);

const h = (title + sku).split('').reduce((a, c) => a * 31 + c.charCodeAt(0), 7);

const ndtMethods = [
  `100% CMM dimensional inspection per ISO 10360 on critical features; surface roughness verification per ISO 4287; material grade verification via PMI`,
  `Full dimensional layout per AS9102 FAIR requirements; ultrasonic immersion scanning for volumetric integrity; micro-hardness traverse on heat-affected zones`,
  `Vision-based optical inspection for surface defects; helium leak testing for sealed interfaces; eddy current surface crack detection on high-stress areas`,
  `Coordinate measuring machine (CMM) full geometry verification; dye penetrant inspection (DPI) per ASTM E1417; spectroscopic alloy verification per ASTM E1476`,
  `Automated optical inspection with sub-micron resolution; X-ray CT scanning for internal feature validation; surface profilometry for finish compliance`,
];

const qualityStatements = [
  `Manufactured under ISO 9001:2015 with full EN 10204 Type 3.1 material traceability from ingot to finished ${title}. All critical features are CMM-verified and documented in the First Article Inspection Report.`,
  `Production executed in AS9100D-certified facility. Material certificates, dimensional reports, and surface finish certifications accompany every shipment of ${title} components.`,
  `Quality system compliant with ISO 9001:2015. Each ${title} batch includes full material traceability, dimensional inspection results, and a Certificate of Conformity (CoC).`,
  `Manufactured to aerospace-grade quality standards with 100% material traceability. FAIR documentation available per AS9102 for ${title} production lots.`,
  `ISO 9001:2015 quality management system. Every ${title} shipment includes EN 10204 3.1 MTR, CMM report, and surface finish certification.`,
];

const applicationDescs = [
  `A precision ${category} component designed for ${fn}. The selection of ${titanium_grade} provides the optimal balance of strength-to-weight and environmental resistance required for this ${industry} application.`,
  `Engineered as a ${category} component, this part serves the specific function of ${fn}. ${titanium_grade} was selected for its proven performance in ${industry} service conditions.`,
  `Designed for ${industry} applications, this component fulfills the role of ${fn}. The use of ${titanium_grade} ensures long-term reliability in this ${category} configuration.`,
];

const ndt = ndtMethods[h % ndtMethods.length];
const qs = qualityStatements[h % qualityStatements.length];
const ad = applicationDescs[h % applicationDescs.length];
---

<div class="py-10 lg:py-12" style="background: var(--theme-surface);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="mb-8 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
      <span class="h-2 w-2 rounded-full" style="background: var(--theme-primary);"></span>
      <span>Engineering Report &amp; Product Documentation</span>
    </div>

    <!-- ===== §1: Product Description & Application ===== -->
    <section class="mb-10 border-b pb-8" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2" style="color: var(--theme-text);">
        <span style="color: var(--theme-primary);">§</span> Product Description &amp; Application
      </h2>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="card-titanium p-4">
          <h3 class="text-sm font-semibold mb-2" style="color: var(--theme-text);">Function</h3>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{ad}</p>
        </div>
        <div class="card-titanium p-4">
          <h3 class="text-sm font-semibold mb-2" style="color: var(--theme-text);">Specifications</h3>
          <ul class="text-sm leading-relaxed space-y-1" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            <li><strong style="color: var(--theme-text);">SKU:</strong> {sku}</li>
            <li><strong style="color: var(--theme-text);">Category:</strong> {category}</li>
            <li><strong style="color: var(--theme-text);">Industry:</strong> {industry}</li>
            <li><strong style="color: var(--theme-text);">Material:</strong> {titanium_grade}</li>
            {manufacturing_process && <li><strong style="color: var(--theme-text);">Process:</strong> {manufacturing_process}</li>}
            {weight_reduction && <li><strong style="color: var(--theme-text);">Weight:</strong> {weight_reduction}</li>}
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== §2: Quality Assurance & NDT ===== -->
    <section class="mb-10 border-b pb-8" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2" style="color: var(--theme-text);">
        <span style="color: var(--theme-primary);">§</span> Quality Assurance &amp; Material Traceability
      </h2>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="card-titanium p-4">
          <h3 class="text-sm font-semibold mb-2" style="color: var(--theme-text);">Quality Management</h3>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{qs}</p>
        </div>
        <div class="card-titanium p-4">
          <h3 class="text-sm font-semibold mb-2" style="color: var(--theme-text);">Inspection &amp; NDT</h3>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{ndt}</p>
        </div>
      </div>
    </section>

    <!-- ===== §3: Manufacturing Process ===== -->
    {manufacturing_process && (
    <section class="mb-10 border-b pb-8" style="border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
      <h2 class="text-xl font-bold mb-4 flex items-center gap-2" style="color: var(--theme-text);">
        <span style="color: var(--theme-primary);">§</span> Manufacturing Process
      </h2>
      <div class="card-titanium p-4">
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          {title} is manufactured using {manufacturing_process.toLowerCase()}. Each operation is performed by certified machinists with real-time process monitoring and dimensional verification at critical stages. Heat code traceability is maintained throughout all production steps.
        </p>
      </div>
    </section>
    )}

  </div>
</div>
