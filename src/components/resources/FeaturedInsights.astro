---
interface Whitepaper {
  title: string;
  abstract: string;
  pages: string;
  date: string;
  href: string;
  icon: string;
}

const whitepapers: Whitepaper[] = [
  {
    title: "Cost-Saving DFM Rules: Reducing Titanium Waste by 23%",
    abstract: "A data-driven analysis of design-for-manufacturability parameters that directly reduce buy-to-fly ratios. Covers near-net shape nesting, toolpath optimization, and strategic stock allowance reduction across 5-axis and mill-turn platforms.",
    pages: "18 pp.",
    date: "2026-02",
    href: "/resources/whitepapers/dfm-cost-saving",
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
  },
  {
    title: "Grade 5 vs Grade 23 ELI: Medical-Grade Comparative Analysis",
    abstract: "Side-by-side metallurgical evaluation of Ti-6Al-4V (Grade 5) versus Ti-6Al-4V ELI (Grade 23) for implantable and surgical instrument applications. Fatigue life, notch sensitivity, and biocompatibility data from certified test batches.",
    pages: "24 pp.",
    date: "2026-01",
    href: "/resources/whitepapers/grade5-vs-grade23",
    icon: "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4",
  },
  {
    title: "5-Axis Thermal Mitigation: Real-Time Heat Control Logs",
    abstract: "Instrumented spindle load and coolant temperature logs from production-grade 5-axis machining of Grade 5 titanium blocks. Presents validated parameters for thermal distortion prevention, chatter suppression, and surface integrity retention.",
    pages: "32 pp.",
    date: "2026-03",
    href: "/resources/whitepapers/thermal-mitigation",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
  },
];
---

<section class="relative py-24 overflow-hidden" style="background-color: color-mix(in srgb, var(--theme-surface) 20%, var(--theme-bg));">
  <!-- Subtle dot matrix -->
  <div class="absolute inset-0 opacity-[0.02]">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, var(--theme-primary) 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        Featured Insights
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Engineering <span style="background: linear-gradient(135deg, var(--theme-primary) 0%, color-mix(in srgb, var(--theme-primary) 70%, white) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Whitepapers</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Flagship technical reports authored by our engineering team — each paper validated against production-floor data and third-party metallurgical analysis.
      </p>
    </div>

    <!-- 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {whitepapers.map((wp) => (
        <div
          class="group relative rounded-xl overflow-hidden transition-all duration-300 flex flex-col"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-text) 42%, transparent);"
          onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 8%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-text) 42%, transparent)'; this.style.boxShadow='none'"
        >
          {/* Top accent bar */}
          <div class="h-1 w-full" style="background: linear-gradient(90deg, var(--theme-primary), color-mix(in srgb, var(--theme-primary) 70%, white));"></div>

          <div class="p-7 flex flex-col flex-1">
            {/* Icon + Meta row */}
            <div class="flex items-start justify-between mb-4">
              <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 20%, transparent);">
                <svg class="w-5 h-5" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={wp.icon} />
                </svg>
              </div>
              <div class="text-right">
                <span class="text-xs font-medium" style="color: color-mix(in srgb, var(--theme-text) 42%, transparent);">{wp.date}</span>
                <span class="text-xs font-medium ml-2" style="color: color-mix(in srgb, var(--theme-text) 42%, transparent);">{wp.pages}</span>
              </div>
            </div>

            {/* Title */}
            <h3 class="text-lg font-bold mb-3 leading-snug transition-colors" style="color: var(--theme-text);" onmouseover="this.style.color='var(--theme-primary)'" onmouseout="this.style.color='var(--theme-text)'">
              {wp.title}
            </h3>

            {/* Abstract */}
            <p class="text-sm leading-relaxed mb-6 flex-1" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
              {wp.abstract}
            </p>

            {/* CTA */}
            <a
              href={wp.href}
              class="inline-flex items-center text-sm font-semibold transition-all group/link"
              style="color: var(--theme-primary);"
              onmouseover="this.style.color='color-mix(in srgb, var(--theme-primary) 70%, white)'"
              onmouseout="this.style.color='var(--theme-primary)'"
            >
              <span>Download Whitepaper</span>
              <svg class="w-4 h-4 ml-2 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
