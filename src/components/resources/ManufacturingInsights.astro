---
/**
 * ManufacturingInsights.astro
 *
 * Astro shell for the Titanium Manufacturing Insights Hub
 * (`/resources/manufacturing-insights/`).
 *
 * Architecture (post-restructure 2026-10-09):
 *   - Static `<SubpageHero />` for the canonical title/lead/badge.
 *   - Interactive React 19 client island `<ManufacturingInsightsHub />` (all
 *     filtering, dashboard, cards, CMM/MTR modal, factory-audit drawer).
 *   - Schema authority: pageType="tech-article" + articleAbout + items feeds
 *     the BaseLayout `buildPageGraph()` machinery. No inline JSON-LD except
 *     for the page-specific supplementary `knowsAbout` extension, which is
 *     explicitly allowed for credentials/standards pages per
 *     `.clinerules/工作区 Rules.txt` §3.
 *   - 12 language routing handled by the parent `pages/resources/[lang]/...
 *     aria.astr` mount pages. This component renders identically for every
 *     locale (Hub strings are English-only initially).
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../ui/SubpageHero.astro';
import {
  ManufacturingInsightsHub,
} from './ManufacturingInsightsHub.tsx';
import { MANUFACTURING_INSIGHTS } from '../../data/manufacturing-insights-data';
import {
  toSchemaItemList,
  buildSupplementaryKnowsAbout,
  buildSupplementaryGraphObject,
} from './ManufacturingInsightsJsonLd.tsx';

// Canonical page URL (used for ItemList hrefs and TechArticle mainEntityOfPage).
const pageUrl = 'https://cnc.bozemetal.com/resources/manufacturing-insights/';

// Build the ItemList payload that BaseLayout will emit via its `items` prop.
// One ListItem per insight, all anchored to the canonical page URL.
const itemList = toSchemaItemList(MANUFACTURING_INSIGHTS, pageUrl, '/resources/manufacturing-insights/');

// Aggregate a non-redundant list of certifications / standards from the
// 6 insights — used for the TechArticle.about @id and the supplementary
// knowsAbout graph. All values are real (no fabrication).
const allAbout = new Set<string>();
for (const i of MANUFACTURING_INSIGHTS) {
  for (const c of i.certifications) allAbout.add(c);
  // Include top-3 threshold `standard` references per insight.
  for (const t of i.thresholds.slice(0, 3)) {
    if (t.standard !== undefined) allAbout.add(t.standard);
  }
}
const articleAbout = Array.from(allAbout).slice(0, 16);

// Supplementary knowsAbout graph (allowed per `.clinerules/工作区 Rules.txt` §3
// because this page surfaces credentials not in the global entity-registry).
const supplementary = buildSupplementaryKnowsAbout(MANUFACTURING_INSIGHTS);
const supplementaryGraphJson = JSON.stringify(
  buildSupplementaryGraphObject(supplementary),
);

// Distinct quality-metric tags used as speakable answer anchors in the AIO
// "first-paragraph" thesis below.
const speakableSelectors = ['#mih-heading', '#mih-dash-title'];
---

<BaseLayout
  title="Titanium Manufacturing Insights | 5-Axis CNC, CMM, EN 10204 3.1"
  description="Shop-floor-proven titanium manufacturing capabilities \u2014 5-axis CNC ±0.005 mm, Zeiss CMM (1.8+L/300) µm, EN 10204 3.1 traceability, EU PED pressure-component welding, AMS 2488/2489 anodizing. CMM and MTR sample reports openable in-page."
  pageType="tech-article"
  pageName="Titanium Manufacturing Insights"
  pageUrl={pageUrl}
  inLanguage="en-US"
  articleHeadline="Titanium Manufacturing Insights Hub: 5-Axis CNC, CMM, EN 10204 3.1"
  articleDescription="Six shop-floor-proven manufacturing insights on titanium 5-axis CNC milling, trochoidal thin-wall milling, CMM geometric verification (Zeiss PRISMO), EN 10204 3.1 material traceability, EU PED 2014/68/EU welding, and Type II/III anodizing fatigue behavior \u2014 each anchored to real workshop data and cited standards."
  articleAuthor="Boze Titanium Engineering Center"
  articleDatePublished="2026-10-09"
  articleDateModified={new Date().toISOString().slice(0, 10)}
  articleAbout={articleAbout}
  collectionName="Titanium Manufacturing Insights"
  collectionDescription="Workshop-proven titanium CNC, CMM, EN 10204 3.1, EU PED and anodizing capabilities."
  itemCount={MANUFACTURING_INSIGHTS.length}
  items={itemList.map((i) => ({ name: i.name, url: i.url }))}
  speakableSelectors={speakableSelectors}
>
  <SubpageHero
    title="Shop-Floor-Proven"
    highlight="Titanium Manufacturing Insights"
    subtitle="Six manufacturing capabilities verified by workshop data, CMM inspection reports, and EN 10204 3.1 material traceability. Every claim is anchored to a real measurement, a real standard, and a real machine."
    badge="Titanium Smart Manufacturing & Quality Assurance Hub"
    keyMetrics={[
      { value: '\u00b10.005 mm', label: '5-axis tolerance' },
      { value: '(1.8+L/300) \u00b5m', label: 'Zeiss CMM accuracy' },
      { value: '\u2265 70 bar', label: 'HPC coolant' },
      { value: '100%', label: 'MTR EN 10204 3.1' },
    ]}
    entityChips={[
      '5-Axis CNC',
      'Trochoidal Milling',
      'Zeiss PRISMO CMM',
      'EN 10204 3.1',
      'EU PED 2014/68/EU',
      'AMS 2488 / 2489',
      'AS9100D',
      'ISO 10360-2:2009',
    ]}
  />

  {/* AIO Speakable thesis paragraphs \u2014 first 2 sentences establish the
      page's expert answer to GE-model queries about titanium manufacturing. */}
  <div class="mx-auto mt-8 max-w-4xl px-4 sm:px-6 lg:px-8">
    <p
      id="mih-heading"
      class="mb-3 text-base leading-relaxed"
      style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);"
    >
      The Boze Titanium Manufacturing Insights Hub curates six shop-floor-proven capabilities \u2014 5-axis thermal-stress control (70+ bar through-tool coolant), trochoidal thin-wall milling (AlTiN/AlCrN PVD carbide), Zeiss PRISMO CMM geometric verification (ISO 10360-2 calibrated), EN 10204 3.1 material traceability with heat-number persistence, EU PED 2014/68/EU pressure-component welding, and Type II/III anodizing fatigue behavior. Every claim is anchored to a real workshop parameter, a real cited standard, and a real machine spec.
    </p>
    <p
      class="text-base leading-relaxed"
      style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);"
    >
      Procurement engineers and QA Managers in aerospace, medical, hydrofoil, racing, chemical, marine, and subsea sectors can open CMM and MTR sample evidence directly from the page and forward those samples to their qualification teams. The Hub's floating factory-audit drawer carries the selected capability context into /rfq/?part=audit|cmm-sample|mtr-sample so applications engineers respond with the right request from the first email.
    </p>
  </div>

  <ManufacturingInsightsHub client:visible />

  {/* Page-level supplementary JSON-LD \u2014 extends Organization.knowsAbout
      via a DefinedTermSet per .clinerules/工作区 Rules.txt §3 (allowed for
      credentials / knowsAbout extensions). Rendered exactly once. */}
  <script
    is:inline
    type="application/ld+json"
    set:html={supplementaryGraphJson}
  />
</BaseLayout>
