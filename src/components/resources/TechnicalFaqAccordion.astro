---
interface FaqItem {
  q: string;
  a: string;
}

const faqs: FaqItem[] = [
  {
    q: "What are your typical lead times for rapid prototyping in titanium?",
    a: "Our standard rapid prototyping lead time is <strong>3–7 business days</strong> from CAD approval. For SLM/DMLS additive prototypes, we can achieve as fast as 48-hour turnaround on select geometries using our pre-qualified parameter sets. CNC machined prototypes typically ship within 5–7 days. All rapid prototype orders include a preliminary dimensional inspection report.",
  },
  {
    q: "Do you provide EN 10204 3.1 Material Test Reports (MTR) with every shipment?",
    a: "Yes — EN 10204 3.1 MTRs are included as standard for all production orders. Our material traceability pipeline links each batch from mill certificate to finished component via a unique heat/lot number. 3.2 inspection certificates (third-party verified) are available upon request with a 48-hour processing window. We also provide ASTM E8/E8M tensile verification and chemical analysis upon request.",
  },
  {
    q: "What dimensional tolerances can you guarantee on 5-axis titanium parts?",
    a: "Our standard machining tolerance is <strong>±0.05 mm</strong> (ISO 2768-m). For precision-class work, we routinely hold <strong>±0.005 mm</strong> on critical features using thermal-compensated 5-axis machining centers. Surface finish capabilities range from Ra 3.2 µm (standard) down to Ra 0.4 µm (precision burnish). All tolerances are certified via our CMM inspection lab (Zeiss CONTURA, calibrated to ISO 10360).",
  },
  {
    q: "Can you manufacture components under AS9100D or ISO 13485 compliance?",
    a: "Absolutely. Our facility operates under <strong>AS9100D</strong> (aerospace) and <strong>ISO 13485:2016</strong> (medical devices) quality management systems. We maintain NADCAP accreditation for NDT, heat treatment, and chemical processing. Documentation packages include first article inspection reports (FAIR) per AS9102, process control plans, and full material traceability chains.",
  },
  {
    q: "What file formats do you accept for engineering review and quoting?",
    a: "We accept STEP (AP203/AP242), IGES, STL, Parasolid (X_T/X_B), SolidWorks (SLDPRT), AutoCAD (DWG/DXF), and native CATIA or NX files. For DFM analysis we prefer STEP or native CAD. For additive quoting, STL with a minimum 0.1 mm chord tolerance is recommended. All files can be uploaded via our secure RFQ portal with IP protection (NDA-backed).",
  },
  {
    q: "Do you offer NDA-protected design review before production?",
    a: "Yes — all design reviews are conducted under executed <strong>mutual NDA</strong> as a standard procedure. Our engineering team provides a confidential DFM analysis report within 1–2 business days of file receipt, identifying potential manufacturing risks, cost-saving geometry adjustments, and lead time estimates — at no charge for qualified production inquiries.",
  },
];
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="relative py-24 overflow-hidden" style="background-color: color-mix(in srgb, var(--theme-surface) 20%, var(--theme-bg));">
  <!-- Subtle dot matrix -->
  <div class="absolute inset-0 opacity-[0.02]">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, var(--theme-primary) 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-4xl">
    <!-- Section Header -->
    <div class="text-center mb-14">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
        {t('resources.technicalfaqaccordion.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        <span style="color: var(--theme-text);">{t('resources.technicalfaqaccordion.titlePrefix')}</span> <span style="background: linear-gradient(135deg, var(--theme-primary) 0%, color-mix(in srgb, var(--theme-primary) 70%, white) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">{t('resources.technicalfaqaccordion.titleHighlight')}</span>
      </h2>
      <p class="text-lg max-w-2xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t('resources.technicalfaqaccordion.description')}
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details
          class="group rounded-xl overflow-hidden transition-all duration-300"
          style="border: 1px solid color-mix(in srgb, var(--theme-text) 42%, transparent); background-color: var(--theme-surface);"
        >
          <summary
            class="flex items-center justify-between px-6 py-5 cursor-pointer list-none transition-colors select-none"
            style="color: var(--theme-text);"
          >
            <span class="text-base font-semibold leading-snug pr-4">
              {t(`resources.technicalfaqaccordion.faq${index}.question`)}
            </span>
            <div
              class="shrink-0 w-6 h-6 flex items-center justify-center rounded-full transition-transform duration-300 group-open:rotate-180"
              style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-5 pt-0 border-t" style="border-color: color-mix(in srgb, var(--theme-text) 20%, transparent);">
            <p class="text-sm leading-relaxed mt-4" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
              {t(`resources.technicalfaqaccordion.faq${index}.answer`)}
            </p>
          </div>
        </details>
      ))}
    </div>

    <!-- Bottom CTA hint -->
    <div class="text-center mt-10">
      <p class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 42%, transparent);">
        {t('resources.technicalfaqaccordion.ctaHint')} <a href="/rfq/" target="_blank" rel="noopener noreferrer" class="font-semibold underline-offset-2 hover:underline" style="color: var(--theme-primary);">{t('resources.technicalfaqaccordion.contact_engineering_team')}</a>
      </p>
    </div>
  </div>
</section>
