---
// DownloadsPage.astro
// Conversion hub: BOZE Titanium Machining DFM Manual, Material Grade Comparison Chart,
// Surface Finish Conversion Guide, ASME Y14.5 GD&T Reference — technical PDF assets
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Titanium CNC Machining Technical Downloads | DFM Manuals & Reference Charts"
  description="Download technical engineering resources: BOZE Titanium Machining DFM Manual (48 pages), Material Grade Comparison Chart (Grade 1-23 ELI), Surface Finish Conversion Guide (Ra, Rz, RMS), ASME Y14.5 GD&T Reference Sheet."
>
  <div class="container mx-auto px-4 py-24 max-w-5xl">
    <nav class="text-sm mb-8 text-zinc-400"><a href="/" class="hover:text-white">Home</a> / <a href="/resources" class="hover:text-white">Resources</a> / <span class="text-white">Downloads</span></nav>
    <h1 class="text-4xl md:text-5xl font-bold mb-8" style="color: var(--theme-text);">Engineering Downloads — Technical References for Titanium CNC Machining</h1>
    <p class="text-xl mb-12 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">Download technical reference materials for precision titanium component design. These engineering assets are essential for design engineers, procurement specialists, and quality managers. Registration is required for full access to the complete technical library.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

      <!-- Card 1: DFM Manual -->
      <div class="p-8 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
        <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <svg class="w-7 h-7" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
        </div>
        <h3 class="text-lg font-bold mb-2" style="color: var(--theme-text);">BOZE Titanium Machining DFM Manual</h3>
        <p class="text-sm mb-5 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">Comprehensive guide to designing titanium CNC machined components. Covers material selection across Grade 1-23 ELI, tolerance allocation for thin-wall structures down to 0.5 mm, surface finish specification (Ra 0.1-1.6 µm), thread design per ASME B1.1, deep-hole drilling L/D ratio limits, and GD&T best practices per ASME Y14.5-2018 with profile tolerances to 0.02 mm.</p>
        <span class="inline-flex items-center text-xs px-3 py-1 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); color: var(--theme-primary);">BOZE_Ti_DFM_Manual.pdf · 48 Pages · 12 MB</span>
      </div>

      <!-- Card 2: Grade Comparison Chart -->
      <div class="p-8 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
        <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <svg class="w-7 h-7" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
        </div>
        <h3 class="text-lg font-bold mb-2" style="color: var(--theme-text);">Material Grade Comparison Chart</h3>
        <p class="text-sm mb-5 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">Side-by-side comparison of all commercially significant titanium grades: CP Grades 1-4 (99.2-99.5% Ti), Grade 5 Ti-6Al-4V (tensile ≥ 895 MPa), Grade 7 Ti-0.12Pd (palladium-stabilized corrosion resistance), Grade 12 Ti-0.3Mo-0.8Ni (hot chloride crevice defense), and Grade 23 Ti-6Al-4V ELI (O ≤ 0.13% for medical biocompatibility). Includes chemical composition limits, mechanical property minima, and application guidance.</p>
        <span class="inline-flex items-center text-xs px-3 py-1 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); color: var(--theme-primary);">BOZE_Ti_Grade_Chart.pdf · 16 Pages · 4 MB</span>
      </div>

      <!-- Card 3: Surface Finish Guide -->
      <div class="p-8 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
        <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <svg class="w-7 h-7" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
        </div>
        <h3 class="text-lg font-bold mb-2" style="color: var(--theme-text);">Surface Finish &amp; Roughness Conversion Guide</h3>
        <p class="text-sm mb-5 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">Quick-reference guide linking surface finish specifications (Ra, Rz, RMS) to achievable tolerances and process capabilities across titanium turning, milling, Swiss turning, EDM, grinding, and electropolishing. Includes conversion tables between ISO 1302 and ASME B46.1 standards, with practical Ra limits for sealing surfaces (≤ 0.4 µm), medical implants (≤ 0.2 µm), and semiconductor components (≤ 0.1 µm).</p>
        <span class="inline-flex items-center text-xs px-3 py-1 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); color: var(--theme-primary);">BOZE_Ti_Surface_Guide.pdf · 8 Pages · 2 MB</span>
      </div>

      <!-- Card 4: GD&T Reference -->
      <div class="p-8 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
        <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <svg class="w-7 h-7" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
        </div>
        <h3 class="text-lg font-bold mb-2" style="color: var(--theme-text);">ASME Y14.5 GD&amp;T Quick Reference Standards Sheet</h3>
        <p class="text-sm mb-5 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">Engineering reference for geometric dimensioning and tolerancing as applied to titanium machined components. Covers datum reference frame establishment, tolerance zone calculations for true position (∅0.015 mm), profile of a surface (0.02 mm), perpendicularity, and parallelism (0.01 mm). Includes CMM verification guidelines with ZEISS ±1.9 µm accuracy protocols.</p>
        <span class="inline-flex items-center text-xs px-3 py-1 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); color: var(--theme-primary);">BOZE_Ti_GD&T_Reference.pdf · 24 Pages · 6 MB</span>
      </div>

    </div>

    <div class="p-8 rounded-xl text-center" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
      <p class="text-lg mb-4" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">Contact our engineering team to request access to the complete technical library — including process capability reports, material-specific machining guides, and application-specific case studies.</p>
      <a href="/rfq" class="inline-flex items-center px-6 py-3 text-base font-semibold rounded-xl" style="background-color: var(--theme-primary); color: #ffffff;">Request Download Access →</a>
    </div>
  </div>
</BaseLayout>
