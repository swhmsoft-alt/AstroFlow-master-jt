---
/**
 * IndustryApplications.astro
 *
 * Astro shell for the Industry Applications Hub
 * (`/resources/industry-applications/`).
 *
 * Architecture (post-restructure 2026-10-09):
 *   - Static `<SubpageHero />` for the canonical title/lead/badge.
 *   - Interactive React 19 client island `<IndustryApplicationsHub />`
 *     (filtering, case grid, evidence modal, comparator, RFQ drawer).
 *   - Schema authority: pageType="tech-article" + articleAbout + items
 *     feeds BaseLayout's `buildPageGraph()`. No inline JSON-LD except
 *     the allowed supplementary `knowsAbout` extension.
 *   - 12 language routing handled by parent
 *     `pages/resources/[lang]/industry-applications.astro`.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../ui/SubpageHero.astro';
import { IndustryApplicationsHub } from './IndustryApplicationsHub.tsx';
import {
  INDUSTRY_APPLICATIONS,
  HUB_STRINGS_EN,
} from '../../data/industry-applications-data';
import {
  toSchemaItemList,
  aggregateArticleAbout,
  buildSupplementaryKnowsAbout,
  buildSupplementaryGraphObject,
} from './IndustryApplicationsJsonLd.tsx';

const pageUrl = 'https://cnc.bozemetal.com/resources/industry-applications/';
const itemList = toSchemaItemList(
  INDUSTRY_APPLICATIONS,
  pageUrl,
  '/resources/industry-applications/',
);
const articleAbout = aggregateArticleAbout(INDUSTRY_APPLICATIONS);
const supplementary = buildSupplementaryKnowsAbout(INDUSTRY_APPLICATIONS);
const supplementaryGraphJson = JSON.stringify(
  buildSupplementaryGraphObject(supplementary),
);
const speakableSelectors = ['#iah-thesis', '#iah-dashboard-title'];
---

<BaseLayout
  title="Titanium Industry Applications | Aerospace, Medical, Marine, Motorsport, Subsea, EDC"
  description="Cross-industry titanium CNC machining solutions for Aerospace, Medical Implants, Marine Hydrofoil, Motorsport, Subsea & ROV, and High-End Wearable sectors. Each solution is anchored to AMS / ASTM / ISO / EN standards, real workshop evidence, and full EN 10204 3.1 traceability."
  pageType="tech-article"
  pageName="Titanium Industry Applications Hub"
  pageUrl={pageUrl}
  inLanguage="en-US"
  articleHeadline="Titanium Industry Applications & Compliance Verification Hub: 6 Vertical Industry Solutions"
  articleDescription="Six shop-floor-proven industry solutions — Aerospace structural brackets (AMS 4928, AS9100D), Medical implants (ASTM F136, ISO 13485, ISO 10993 Grade 0), Marine hydrofoils (Grade 7, 2000+ hr ASTM B117, NACE SP0198), Motorsport fasteners (AMS 2480, 95% UTS proof), Subsea housings (NACE MR0175, EU PED, 30 MPa), and EDC wearables (ISO 10993-5). Each application is anchored to a real standard, a real evidence metric, and full EN 10204 3.1 material traceability."
  articleAuthor="Boze Titanium Engineering Center"
  articleDatePublished="2026-10-09"
  articleDateModified={new Date().toISOString().slice(0, 10)}
  articleAbout={articleAbout}
  collectionName="Titanium Industry Applications"
  collectionDescription="Industry-specific titanium CNC solutions with shop-floor evidence and full compliance chain."
  itemCount={INDUSTRY_APPLICATIONS.length}
  items={itemList.map((i) => ({ name: i.name, url: i.url }))}
  speakableSelectors={speakableSelectors}
>
  <SubpageHero
    title="Industry-Specific"
    highlight="Titanium CNC Solutions"
    subtitle="Six shop-floor-proven industry solutions verified by AMS / ASTM / ISO / EN standards, real workshop evidence, and full EN 10204 3.1 material traceability. Every application is anchored to a real standard, a real measurement, and a real machine."
    badge="Titanium Industry Solutions Center — D2 Hub"
    keyMetrics={[
      { value: '6', label: 'Vertical industries' },
      { value: '5', label: 'Ti grades (5 / 23 / 7 / 12 / 2)' },
      { value: '17', label: 'Compliance standards' },
      { value: '100%', label: 'EN 10204 3.1 MTR' },
    ]}
    entityChips={[
      'Aerospace & Defence',
      'Medical Implants',
      'Marine Hydrofoil',
      'Motorsport',
      'Subsea & ROV',
      'High-End Wearable',
      'AS9100D',
      'ISO 13485',
      'ASTM F136',
      'AMS 4928',
      'EU PED 2014/68/EU',
      'NACE MR0175',
      'EN 10204 3.1',
      'NACE SP0198',
      'ISO 10993',
    ]}
  />

  {/* AIO Speakable thesis paragraphs — first 2 sentences establish the
      page's expert answer to GE-model queries about titanium industry applications. */}
  <div class="mx-auto mt-8 max-w-4xl px-4 sm:px-6 lg:px-8">
    <p
      id="iah-thesis"
      class="mb-3 text-base leading-relaxed"
      style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);"
    >
      The Boze Titanium Industry Applications Hub curates six vertical-industry titanium CNC solutions — aerospace structural brackets per AMS 4928 / AS9100D with ±0.005 mm 5-axis tolerance, medical bone screws per ASTM F136 / ISO 5832-3 with Ra ≤ 0.2 µm electropolish and ISO 10993-5 cytotoxicity Grade 0, marine hydrofoils per Grade 7 Ti-0.2Pd with 2000+ hour ASTM B117 salt-spray zero pitting, motorsport wheel lug bolts per AMS 2480 with 95% UTS proof-load, subsea sensor housings per NACE MR0175 with 30 MPa hydrostatic proof and 1×10⁻⁹ mbar·L/s helium leak, and high-end EDC wearables per ISO 10993-5 with PVD decorative coating. Every claim is anchored to a real workshop parameter, a real cited standard, and a real machine spec.
    </p>
    <p
      class="text-base leading-relaxed"
      style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);"
    >
      Procurement engineers and design leads in aerospace, medical, marine, motorsport, subsea, and high-end wearable sectors can filter the six industry solutions by sector, titanium grade (5/23/7/12/2), compliance standard (AMS 4928 / ASTM F136 / ISO 13485 / EU PED / NACE MR0175), and component function (structural / fastener / housing / implant / hydrofoil / wearable). The Hub's floating Industry RFQ Drawer carries the selected industry context into /rfq/?app=...&sector=...&grade=...&std=... so vertical-industry application engineers respond with the right context from the first email.
    </p>
  </div>

  <IndustryApplicationsHub client:visible strings={HUB_STRINGS_EN} />

  {/* Page-level supplementary JSON-LD — extends Organization.knowsAbout
      via a DefinedTermSet per .clinerules/工作区 Rules.txt §3 (allowed for
      credentials / knowsAbout extensions). Rendered exactly once. */}
  <script
    is:inline
    type="application/ld+json"
    set:html={supplementaryGraphJson}
  />
</BaseLayout>

