---
// DesignEngineeringGuide.astro
// Astro shell for the Titanium Design Engineering Hub
// (`/resources/design-engineering-guide/`). Renders the SubpageHero + the
// interactive React 19 client island `DesignEngineeringHub`.
//
// Schema authority: BaseLayout props → buildPageGraph() (no inline JSON-LD).
// The 6 FAQ items + 6 ItemList entries are fed by the mount page
// (`src/pages/resources/design-engineering-guide.astro`).
import SubpageHero from '../ui/SubpageHero.astro';
import DesignEngineeringHub from './DesignEngineeringHub';
---
<SubpageHero
  badge="Titanium DFM Engineering Hub · ASTM B348 / AMS 4928 / ASME Y14.5"
  title="The Engineer's Guide to"
  highlight="Titanium DFM & CNC Machinability"
  subtitle="Authoritative Design-for-Manufacturability rules for titanium 5-axis CNC machining — minimum wall thickness, internal corner radius, deep-hole L/D ratio, thread depth limits, 5-axis toolpath engagement, and AMS 2801 stress relief — each backed by physics, real standards, and BOZE production data."
  entityChips={[
    'ASME Y14.5-2018',
    'ISO 2768-f',
    'ASTM B348 / AMS 4928',
    '5-Axis CNC',
    'CMM ±1.9 µm',
    'EN 10204 3.1',
  ]}
  keyMetrics={[
    { value: '±0.005 mm', label: 'Tight tolerance' },
    { value: '12 : 1', label: 'Deep hole L/D max' },
    { value: '650 °C', label: 'Vacuum stress relief' },
    { value: '6', label: 'DFM rules' },
  ]}
/>
<DesignEngineeringHub client:visible />
