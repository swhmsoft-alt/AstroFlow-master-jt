---
interface CategoryItem {
  title: string;
  description: string;
  href: string;
  icon: string;
}

const categories: CategoryItem[] = [
  {
    title: "Titanium Knowledge Base",
    description: "Material physics & chemistry logs — crystallographic structures, thermal conductivity curves, corrosion resistance profiles across all commercially pure and alloyed grades.",
    href: "/resources/titanium-knowledge-base",
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
  },
  {
    title: "Titanium Grades Guide",
    description: "Comparative property selection matrix — yield strength, elongation, hardenability, and biocompatibility benchmarks for Grades 1–23 with application-specific recommendations.",
    href: "/resources/titanium-grades-guide",
    icon: "M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
  {
    title: "Design & Engineering Guides",
    description: "DFM parameters, minimum wall limits, anti-galling design rules, and GD&T callout standards specific to titanium CNC machining and additive manufacturing.",
    href: "/resources/design-engineering-guides",
    icon: "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01",
  },
  {
    title: "Manufacturing Insights",
    description: "5-axis CNC advances, SLM 3D printing process parameters, toolpath optimization logs, and surface integrity studies for high-performance titanium components.",
    href: "/resources/manufacturing-insights",
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z",
  },
  {
    title: "Industry Applications",
    description: "Aerospace compliance (AS9100D, NADCAP), medical biological limits (ISO 10993, ASTM F136/F67), and AI infrastructure thermal management engineering data.",
    href: "/resources/industry-applications",
    icon: "M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Case Studies",
    description: "Real-world cost reduction & precision project reviews — documented ROI analyses, cycle-time benchmarks, and metallurgical outcomes from Tier 1 aerospace and medical engagements.",
    href: "/resources/case-studies",
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
];
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Engineering grid pattern -->
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
        </svg>
        {t('resources.resourcehubmatrix.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        <span style="color: var(--theme-text);">{t('resources.resourcehubmatrix.titlePrefix')}</span> <span style="background: linear-gradient(135deg, var(--theme-primary) 0%, color-mix(in srgb, var(--theme-primary) 70%, white) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">{t('resources.resourcehubmatrix.titleHighlight')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t('resources.resourcehubmatrix.description')}
      </p>
    </div>

    <!-- 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {categories.map((cat, index) => (
        <a
          href={cat.href}
          class="group relative rounded-xl p-6 transition-all duration-300 flex flex-col"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-text) 42%, transparent);"
          onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 24px color-mix(in srgb, var(--theme-primary) 8%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-text) 42%, transparent)'; this.style.boxShadow='none'"
        >
          <!-- Icon -->
          <div class="mb-4 flex items-center justify-center w-10 h-10 rounded-lg" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 20%, transparent);">
            <svg class="w-5 h-5" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={cat.icon} />
            </svg>
          </div>

          <!-- Title -->
          <h3 class="text-lg font-bold mb-2 transition-colors" style="color: var(--theme-text);" onmouseover="this.style.color='var(--theme-primary)'" onmouseout="this.style.color='var(--theme-text)'">
          {t(`resources.resourcehubmatrix.card${index}.title`)}
          </h3>

          <!-- Description -->
          <p class="text-sm leading-relaxed mb-5 flex-1" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {t(`resources.resourcehubmatrix.card${index}.description`)}
          </p>

          <!-- Link Tag -->
          <div class="inline-flex items-center text-sm font-semibold transition-all" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
            <span style="color: var(--theme-primary);">{t('resources.resourcehubmatrix.explorePrefix')} →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
