---
/**
 * FaqPage.astro
 *
 * Resources-Hub FAQ pillar page — `/resources/faq/`. Composes the existing
 * `SubpageHero` with the new `FAQHub` React island. Owns the i18n bridge
 * between `useTranslations()` (Astro frontmatter) and the React island's
 * string props.
 *
 * Schema.org FAQPage JSON-LD:
 *   The `faqItems` prop on `BaseLayout` triggers `buildFaqPage()` in
 *   `src/lib/schema.ts`, which emits the full `@graph` payload. We use
 *   `toSchemaFaqItems()` (from `./FAQJsonLd.tsx`) to convert the rich
 *   `FaqEntry` model to the schema-friendly `{question, answer}` pair —
 *   this is the data-pipeline split, NOT a parallel JSON-LD block.
 *   (SOP §F4: schema authority lives in src/lib/schema.ts.)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageHero from '../ui/SubpageHero.astro';
import { FAQHub } from './FAQHub.tsx';
import {
  FAQ_ENTRIES,
  CATEGORY_META_DEFAULT,
} from './faq-data';
import { toSchemaFaqItems } from './FAQJsonLd.tsx';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

/**
 * String bridge — Astro frontmatter resolves every label, then we pass them
 * to the React island as plain props. The island does NOT call `t()` itself
 * (it is hydrated on the client; pulling the 12×12-key dictionaries into
 * the client bundle would balloon JS).
 */
const heroPlaceholder = t('resources.faqhub.heroPlaceholder');
const heroShortcutHint = t('resources.faqhub.heroShortcutHint');
const categoryAllLabel = t('resources.faqhub.categoryAllLabel');
const expandAllLabel = t('resources.faqhub.expandAllLabel');
const collapseAllLabel = t('resources.faqhub.collapseAllLabel');
const helpfulQuestion = t('resources.faqhub.helpfulQuestion');
const helpfulYes = t('resources.faqhub.helpfulYes');
const helpfulNo = t('resources.faqhub.helpfulNo');
const helpfulThanks = t('resources.faqhub.helpfulThanks');
const helpfulThanksNegative = t('resources.faqhub.helpfulThanksNegative');
const emptyTitle = t('resources.faqhub.emptyTitle');
const emptyDescription = t('resources.faqhub.emptyDescription');
const emptyResetLabel = t('resources.faqhub.emptyResetLabel');
const emptyCtaLabel = t('resources.faqhub.emptyCtaLabel');
const ctaTitle = t('resources.faqhub.ctaTitle');
const ctaSubtitle = t('resources.faqhub.ctaSubtitle');
const ctaPrimaryLabel = t('resources.faqhub.ctaPrimaryLabel');
const ctaSecondaryLabel = t('resources.faqhub.ctaSecondaryLabel');

const heroMatchedLabelTemplate = t('resources.faqhub.heroMatchedLabel');
const heroTotalLabelTemplate = t('resources.faqhub.heroTotalLabel');

const hubStrings = {
  heroPlaceholder,
  heroShortcutHint,
  // Template strings only — {matched} / {total} interpolated inside FAQHub.
  // (Avoids passing functions through Astro's `devalue` island serializer.)
  heroMatchedLabel: heroMatchedLabelTemplate,
  heroTotalLabel: heroTotalLabelTemplate,
  categoryAllLabel,
  expandAllLabel,
  collapseAllLabel,
  helpfulQuestion,
  helpfulYes,
  helpfulNo,
  helpfulThanks,
  helpfulThanksNegative,
  emptyTitle,
  emptyDescription,
  emptyResetLabel,
  emptyCtaLabel,
  ctaTitle,
  ctaSubtitle,
  ctaPrimaryLabel,
  ctaSecondaryLabel,
};

/** Title for the FAQPage schema entity — drives the rich-result label. */
const faqSchemaName = t('resources.faqhub.faqSchemaName');

/**
 * Stripped plain-text payload for schema.org Answer.text (Google spec).
 * Build once at SSG time — never reaches the client.
 */
const faqSchemaItems = toSchemaFaqItems(FAQ_ENTRIES);

/** AIO Speakable anchors — 2 thesis-first paragraphs at the top of the body. */
const speakableSelectors = ['#faq-aio-thesis-1', '#faq-aio-thesis-2'];

/** Canonical page URL (Astro `site` is `https://cnc.bozemetal.com`). */
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://cnc.bozemetal.com').toString();
---

<BaseLayout
  title={t('resources.faqhub.pageTitle')}
  description={t('resources.faqhub.pageDescription')}
  pageType="service-detail"
  pageName={t('resources.faqhub.pageTitle')}
  pageUrl={pageUrl}
  inLanguage="en-US"
  serviceName={t('resources.faqhub.serviceName')}
  serviceDescription={t('resources.faqhub.serviceDescription')}
  serviceCategory={t('resources.faqhub.serviceCategory')}
  faqItems={[...faqSchemaItems]}
  faqName={faqSchemaName}
  speakableSelectors={speakableSelectors}
>
  <SubpageHero
    title={t('resources.faqhub.heroTitle')}
    highlight={t('resources.faqhub.heroTitleHighlight')}
    subtitle={t('resources.faqhub.heroSubtitle')}
    badge={t('resources.faqhub.heroBadge')}
    keyMetrics={[
      { value: '24', label: t('resources.faqhub.metricQuestions') },
      { value: '6', label: t('resources.faqhub.metricCategories') },
      { value: 'AS9100D', label: t('resources.faqhub.metricCert') },
    ]}
    entityChips={[
      'DFARS 252.225-7014',
      'EN 10204 3.1',
      'AS9100D',
      'ISO 13485',
      'AMS 2801',
      'AMS-STD-2154',
    ]}
  />

  {/* AIO Speakable thesis paragraphs — schema references #faq-aio-thesis-1/2 */}
  <div class="mx-auto mt-8 max-w-4xl px-4 sm:px-6 lg:px-8">
    <p
      id="faq-aio-thesis-1"
      class="mb-3 text-base leading-relaxed"
      style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);"
    >
      {t('resources.faqhub.aioThesis1')}
    </p>
    <p
      id="faq-aio-thesis-2"
      class="text-base leading-relaxed"
      style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);"
    >
      {t('resources.faqhub.aioThesis2')}
    </p>
  </div>

  <FAQHub
    client:visible
    categories={CATEGORY_META_DEFAULT}
    entries={FAQ_ENTRIES}
    strings={hubStrings}
    ctaHref="/rfq/"
  />
</BaseLayout>