---
/**
 * AboutPage.astro
 * The "About Boze Titanium Manufacturing Center" page content component.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const siteUrl = Astro.site || new URL('https://cnc.bozemetal.com');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!-- About Hero Section -->
<section class="relative py-20 lg:py-28" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl font-bold mb-6 lg:text-5xl" style="color: var(--theme-text);">
        {t('about.hero.title')}
      </h1>
      <div class="w-24 h-1 mx-auto mb-8" style="background-color: var(--theme-primary);"></div>
      <p class="text-xl font-semibold mb-6 leading-relaxed" style="color: var(--theme-text);">
        {t('about.hero.headline')}
      </p>
      <p class="text-base leading-relaxed max-w-3xl mx-auto" style="color: var(--text-muted);">
        {t('about.hero.description')}
      </p>
      <div class="mt-8 p-6 rounded-lg" style="background-color: var(--theme-surface); border-left: 4px solid var(--theme-primary);">
        <p class="text-lg italic font-medium" style="color: var(--theme-text);">
          {t('about.hero.promise')}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Story Section -->
<section class="relative py-16 lg:py-20" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-8" style="color: var(--theme-text);">
        {t('about.story.title')}
      </h2>
      <p class="text-base leading-relaxed mb-6" style="color: var(--text-muted);">
        {t('about.story.paragraph1')}
      </p>
      <p class="text-base leading-relaxed mb-6" style="color: var(--text-muted);">
        {t('about.story.paragraph2')}
      </p>
      <h3 class="text-2xl font-bold mb-4 mt-10" style="color: var(--theme-text);">
        {t('about.story.subtitle')}
      </h3>
      <p class="text-base leading-relaxed" style="color: var(--text-muted);">
        {t('about.story.description')}
      </p>
    </div>
  </div>
</section>

<!-- Editorial & AI Use Policy (Audit A2) — 2026-10-15 -->
<section class="relative py-12 lg:py-16" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-6" style="color: var(--theme-text);">
        Editorial &amp; AI Use Policy
      </h2>
      <div class="rounded-2xl p-6 lg:p-8" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <p class="text-base leading-relaxed mb-4" style="color: var(--text-muted);">
          All blog content on this site is authored by the Boze Titanium Manufacturing Center
          engineering team, with named technical review by
          <a href="/author/garrett-liu/" rel="author" style="color: var(--theme-primary); text-decoration: underline;">Garrett Liu, Lead Production Engineer</a>.
          Final published copy is human-reviewed and fact-checked against ASTM / AMS / ISO standards,
          manufacturer datasheets, and our internal shop-floor process data.
        </p>
        <p class="text-base leading-relaxed" style="color: var(--text-muted);">
          We use large language models (Gemini, Claude) for research assistance and editorial polish only.
          No LLM-authored content is published without human authorship, technical review by a named
          engineer, and final approval. The full policy is published on the
          <a href="/author/garrett-liu/#editorial-policy" style="color: var(--theme-primary); text-decoration: underline;">author profile page</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Video Tour Section -->
<section class="relative py-16 lg:py-20" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold mb-4" style="color: var(--theme-text);">
          {t('about.video.tour')}
        </h2>
        <p class="text-base" style="color: var(--text-muted);">
          {t('about.video.subtitle')}
        </p>
      </div>
      <div class="relative rounded-xl overflow-hidden shadow-2xl" style="background-color: #000;">
        <video
          controls
          autoplay
          muted
          loop
          preload="auto"
          playsinline
          poster="/uploads/boze-cnc-ti-about.mp4"
          class="w-full h-auto max-h-[80vh]"
          style="display: block;"
        >
          <source src="/uploads/boze-cnc-ti-about.mp4" type="video/mp4" />
          <p style="color: #fff; padding: 2rem; text-align: center;">
            {t('about.video.fallback')}
          </p>
        </video>
      </div>
    </div>
  </div>
</section>

<!-- Why Partner Section -->
<section class="relative py-16 lg:py-20" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-8" style="color: var(--theme-text);">
        {t('about.whyPartner.title')}
      </h2>
      <p class="text-base leading-relaxed mb-8" style="color: var(--text-muted);">
        {t('about.whyPartner.intro')}
      </p>
      <ul class="space-y-6">
        <li class="flex items-start">
          <span class="shrink-0 w-6 h-6 mt-0.5 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: var(--theme-primary); color: var(--theme-text);">1</span>
          <div class="ml-4">
            <strong class="block text-base font-semibold mb-1" style="color: var(--theme-text);">{t('about.whyPartner.item1Title')}</strong>
            <span class="text-sm leading-relaxed" style="color: var(--text-muted);">{t('about.whyPartner.item1Desc')}</span>
          </div>
        </li>
        <li class="flex items-start">
          <span class="shrink-0 w-6 h-6 mt-0.5 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: var(--theme-primary); color: var(--theme-text);">2</span>
          <div class="ml-4">
            <strong class="block text-base font-semibold mb-1" style="color: var(--theme-text);">{t('about.whyPartner.item2Title')}</strong>
            <span class="text-sm leading-relaxed" style="color: var(--text-muted);">{t('about.whyPartner.item2Desc')}</span>
          </div>
        </li>
        <li class="flex items-start">
          <span class="shrink-0 w-6 h-6 mt-0.5 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: var(--theme-primary); color: var(--theme-text);">3</span>
          <div class="ml-4">
            <strong class="block text-base font-semibold mb-1" style="color: var(--theme-text);">{t('about.whyPartner.item3Title')}</strong>
            <span class="text-sm leading-relaxed" style="color: var(--text-muted);">{t('about.whyPartner.item3Desc')}</span>
          </div>
        </li>
        <li class="flex items-start">
          <span class="shrink-0 w-6 h-6 mt-0.5 rounded-full flex items-center justify-center text-sm font-bold" style="background-color: var(--theme-primary); color: var(--theme-text);">4</span>
          <div class="ml-4">
            <strong class="block text-base font-semibold mb-1" style="color: var(--theme-text);">{t('about.whyPartner.item4Title')}</strong>
            <span class="text-sm leading-relaxed" style="color: var(--text-muted);">{t('about.whyPartner.item4Desc')}</span>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<!-- Process Section -->
<section class="relative py-16 lg:py-20" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-4" style="color: var(--theme-text);">
        {t('about.process.title')}
      </h2>
      <p class="text-base leading-relaxed mb-10" style="color: var(--text-muted);">
        {t('about.process.intro')}
      </p>

      <!-- Step 01 -->
      <div class="mb-10 p-6 rounded-lg" style="background-color: var(--theme-bg);">
        <span class="inline-block text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">{t('about.process.step1Label')}</span>
        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('about.process.step1Title')}</h3>
        <p class="text-sm leading-relaxed" style="color: var(--text-muted);">{t('about.process.step1Desc')}</p>
      </div>

      <!-- Step 02 -->
      <div class="mb-10 p-6 rounded-lg" style="background-color: var(--theme-bg);">
        <span class="inline-block text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">{t('about.process.step2Label')}</span>
        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('about.process.step2Title')}</h3>
        <p class="text-sm leading-relaxed" style="color: var(--text-muted);">{t('about.process.step2Desc')}</p>
      </div>

      <!-- Step 03 -->
      <div class="mb-10 p-6 rounded-lg" style="background-color: var(--theme-bg);">
        <span class="inline-block text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">{t('about.process.step3Label')}</span>
        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('about.process.step3Title')}</h3>
        <p class="text-sm leading-relaxed" style="color: var(--text-muted);">{t('about.process.step3Desc')}</p>
      </div>

      <!-- Step 04 -->
      <div class="mb-10 p-6 rounded-lg" style="background-color: var(--theme-bg);">
        <span class="inline-block text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">{t('about.process.step4Label')}</span>
        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('about.process.step4Title')}</h3>
        <p class="text-sm leading-relaxed" style="color: var(--text-muted);">{t('about.process.step4Desc')}</p>
      </div>

      <!-- Step 05 -->
      <div class="p-6 rounded-lg" style="background-color: var(--theme-bg);">
        <span class="inline-block text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--theme-primary);">{t('about.process.step5Label')}</span>
        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('about.process.step5Title')}</h3>
        <p class="text-sm leading-relaxed" style="color: var(--text-muted);">{t('about.process.step5Desc')}</p>
      </div>
    </div>
  </div>
</section>

<!-- Empowering Innovation -->
<section class="relative py-16 lg:py-20" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6" style="color: var(--theme-text);">
        {t('about.innovation.title')}
      </h2>
      <p class="text-base leading-relaxed mb-8" style="color: var(--text-muted);">
        {t('about.innovation.description')}
      </p>
      <div class="p-6 rounded-lg inline-block" style="background-color: var(--theme-surface); border-left: 4px solid var(--theme-primary);">
        <p class="text-lg italic font-medium" style="color: var(--theme-text);">
          {t('about.innovation.tagline')}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Contact Section -->
<section class="relative py-16 lg:py-20" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-6" style="color: var(--theme-text);">
        {t('about.contact.title')}
      </h2>
      <p class="text-base leading-relaxed mb-8" style="color: var(--text-muted);">
        {t('about.contact.description')}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-4 rounded-lg" style="background-color: var(--theme-bg);">
          <p class="text-sm" style="color: var(--text-muted);">{t('footer.tel')}</p>
        </div>
        <div class="p-4 rounded-lg" style="background-color: var(--theme-bg);">
          <p class="text-sm" style="color: var(--text-muted);">{t('footer.phone')}</p>
        </div>
        <div class="p-4 rounded-lg" style="background-color: var(--theme-bg);">
          <p class="text-sm" style="color: var(--text-muted);">{t('footer.whatsapp')}</p>
        </div>
        <div class="p-4 rounded-lg" style="background-color: var(--theme-bg);">
          <a href="mailto:info@bozemetal.com" class="text-sm transition-colors hover-opacity-only" style="color: var(--theme-primary);" >{t('footer.email')}</a>
        </div>
      </div>
      <div class="mt-4 p-4 rounded-lg" style="background-color: var(--theme-bg);">
        <p class="text-sm leading-relaxed" style="color: var(--text-muted);">{t('footer.address')}</p>
      </div>
    </div>
  </div>
</section>
