---
/**
 * EngineeringPage.astro
 *
 * Front-End Engineering Support & DFM Optimization for Titanium.
 * High-density entity injection for Google AIO procurement search.
 * Content: 3 engineering pillars + 4-step workflow + comparison matrix + FAQ.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<!-- ════════════════════════════════════════════════════════════════
     Section 1 — Core Engineering Pillars (三大工程支柱)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.42 15.17l-5.25-5.25L3 12.92l8.25 8.25L21 10.5l-3.17-3.17M15.75 4.5a2.25 2.25 0 012.25 2.25v9a2.25 2.25 0 01-2.25 2.25h-9a2.25 2.25 0 01-2.25-2.25v-9a2.25 2.25 0 012.25-2.25h9z" />
        </svg>
        Engineering Core Competencies
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Core Engineering <span class="gradient-text-accent">{t('cap.engineeringpage.badge0')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        Three specialized engineering disciplines that transform complex titanium designs into manufacturable, cost-optimized production programs.
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">

      <!-- Pillar 1: Titanium-Specific DFM -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="flex items-center justify-center w-12 h-12 rounded-lg mb-5 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
          <span class="text-lg font-bold" style="color: var(--theme-primary);">01</span>
        </div>

        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('cap.engineeringpage.badge1')}</h3>
        <p class="text-sm leading-relaxed mb-5 flex-1" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          Design for Manufacturing audits tailored to titanium's unique metallurgical behavior — low thermal conductivity, high work-hardening rate, and elastic springback. Every feature is evaluated against titanium-specific machinability limits before production.
        </p>

        <div class="space-y-2.5 mt-auto pt-4 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="flex items-start text-xs">
            <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
            </svg>
            <span style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);"><strong style="color: var(--theme-text);">{t('cap.engineeringpage.badge2')}</strong> — Avoid sharp internal corners (&lt; R 0.5 mm) to prevent tool chipping and stress risers in Ti-6Al-4V</span>
          </div>
          <div class="flex items-start text-xs">
            <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
            </svg>
            <span style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);"><strong style="color: var(--theme-text);">{t('cap.engineeringpage.text4_wall_thickness_verification')}</strong> — Maintain minimum 0.5 mm wall to avoid resonant chatter and thermal warpage</span>
          </div>
          <div class="flex items-start text-xs">
            <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
            </svg>
            <span style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);"><strong style="color: var(--theme-text);">{t('cap.engineeringpage.text6_thread_engagement_depth')}</strong> — Optimize internal thread depth in Grade 5 to prevent tap breakage; thread milling recommended for M1.6–M6</span>
          </div>
        </div>
      </div>

      <!-- Pillar 2: Advanced CAD/CAM & Toolpath Simulation -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="flex items-center justify-center w-12 h-12 rounded-lg mb-5 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
          <span class="text-lg font-bold" style="color: var(--theme-primary);">02</span>
        </div>

        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('cap.engineeringpage.badge8')}</h3>
        <p class="text-sm leading-relaxed mb-5 flex-1" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          Full in-house CAD/CAM capability using Mastercam and HyperMILL for simultaneous 5-axis toolpath programming. Every program is validated through full-machine digital twin simulation — collision-free, gauge-free, and cycle-time-optimized before any titanium is cut.
        </p>

        <div class="space-y-2.5 mt-auto pt-4 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="flex items-start text-xs">
            <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
            </svg>
            <span style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);"><strong style="color: var(--theme-text);">{t('cap.engineeringpage.badge9')}</strong> — Full synchronous machining of complex organic geometries and undercuts</span>
          </div>
          <div class="flex items-start text-xs">
            <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
            </svg>
            <span style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);"><strong style="color: var(--theme-text);">{t('cap.engineeringpage.text11_collision_avoidance_verification')}</strong> — Full-machine digital twin with holder, spindle, and fixture collision detection</span>
          </div>
          <div class="flex items-start text-xs">
            <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
            </svg>
            <span style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);"><strong style="color: var(--theme-text);">{t('cap.engineeringpage.text13_adaptive_clearing_toolpaths')}</strong> — High-frequency micro-engagement cuts that reduce heat accumulation by up to 40% vs conventional toolpaths</span>
          </div>
        </div>
      </div>

      <!-- Pillar 3: Value Engineering & Cost-Out -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="flex items-center justify-center w-12 h-12 rounded-lg mb-5 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
          <span class="text-lg font-bold" style="color: var(--theme-primary);">03</span>
        </div>

        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('cap.engineeringpage.badge15')}</h3>
        <p class="text-sm leading-relaxed mb-5 flex-1" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          Systematic cost optimization without compromising functional performance. From raw material form selection (plate vs near-net forgings) to process consolidation, we partner with your procurement team to reduce total landed cost per part.
        </p>

        <div class="space-y-2.5 mt-auto pt-4 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="flex items-start text-xs">
            <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
            </svg>
            <span style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);"><strong style="color: var(--theme-text);">{t('cap.engineeringpage.badge16')}</strong> — Nesting analysis and form selection to minimize buy-to-fly ratio (target &lt; 3:1 for Ti-6Al-4V)</span>
          </div>
          <div class="flex items-start text-xs">
            <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
            </svg>
            <span style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);"><strong style="color: var(--theme-text);">{t('cap.engineeringpage.badge58')}</strong> — Multi-operation merging on mill-turn platforms; eliminate secondary EDM by wire-cut pre-form strategy</span>
          </div>
          <div class="flex items-start text-xs">
            <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
            </svg>
            <span style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);"><strong style="color: var(--theme-text);">{t('cap.engineeringpage.text20_cycle_time_analysis')}</strong> — Per-operation time study with bottleneck identification; average 15–25% cycle time reduction on first-pass programs</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 2 — Engineering Workflow (确定性流程)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5" />
        </svg>
        Engineering Workflow
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        From Blueprint to <span class="gradient-text-accent">{t('cap.engineeringpage.badge22')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        A deterministic 4-stage engineering sequence that eliminates uncertainty before production begins. Every stage is documented, reviewed, and approved before progressing.
      </p>
    </div>

    <!-- Workflow Steps -->
    <ol class="max-w-4xl mx-auto space-y-6">
      <!-- Step 1 -->
      <li class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 20%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
            <span class="text-sm font-bold" style="color: var(--theme-primary);">1</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.engineeringpage.badge23')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">{t('cap.engineeringpage.badge24')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              Accepting native CAD files (.STEP, .IGES, .SolidWorks, .AutoCAD) and GD&amp;T-annotated 2D drawings. All data is received and processed in a secure, NDA-compliant digital environment with full revision control.
            </p>
          </div>
        </div>
      </li>

      <!-- Step 2 -->
      <li class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 20%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
            <span class="text-sm font-bold" style="color: var(--theme-primary);">2</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.engineeringpage.badge25')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">{t('cap.engineeringpage.badge26')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              Evaluating the selected material grade (Grade 2, Grade 5, Grade 23 ELI, etc.) against every geometric feature in the design. Identifying localized thermal stress risks, hard-to-reach tool access zones, and potential fixturing challenges specific to titanium's low thermal conductivity and high springback.
            </p>
          </div>
        </div>
      </li>

      <!-- Step 3 -->
      <li class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 20%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
            <span class="text-sm font-bold" style="color: var(--theme-primary);">3</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.engineeringpage.badge27')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">{t('cap.engineeringpage.badge28')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              Issuing a detailed DFM report with annotated drawings — recommending modifications to corner radii, wall thickness distributions, tolerance callouts, and thread specifications. Every recommendation is quantified: estimated yield improvement, cycle time reduction, and cost savings per part.
            </p>
          </div>
        </div>
      </li>

      <!-- Step 4 -->
      <li class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 20%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
            <span class="text-sm font-bold" style="color: var(--theme-primary);">4</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.engineeringpage.badge29')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">{t('cap.engineeringpage.badge30')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              Generating multi-axis G-code with Mastercam/HyperMILL and running full-machine digital twin simulations to verify tool interference, spindle load profiles, and surface finish predictions. First-article-right approach ensures zero-defect execution when the titanium bar touches the machine spindle.
            </p>
          </div>
        </div>
      </li>
    </ol>

    <!-- Workflow CTA -->
    <div class="text-center mt-10">
      <p class="text-xs mb-3" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
        <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Average DFM review turnaround: <strong style="color: var(--theme-text);">{t('cap.engineeringpage.badge56')}</strong> from CAD submission to engineering feedback report.
      </p>
    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 3 — Engineering Comparison Matrix (AIO 干货表)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
        </svg>
        Engineering Value Matrix
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Standard vs. <span class="gradient-text-accent">{t('cap.engineeringpage.badge32')}</span> Approach
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        Quantifiable evidence of how our front-end engineering transforms conventional machining into precision-optimized, cost-efficient production.
      </p>
