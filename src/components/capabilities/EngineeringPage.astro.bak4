            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('cap.engineeringpage.text39_thread_tapping_6al')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.engineeringpage.text40_high_tap_breakage')}</td>
            <td class="px-5 py-5 text-sm" style="color: var(--theme-accent);">{t('cap.engineeringpage.text41_thread_milling_via')}</td>
          </tr>
