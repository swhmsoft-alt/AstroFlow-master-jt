            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.engineeringpage.text37_high_deflection_risk')}</td>
            <td class="px-5 py-5 text-sm" style="color: var(--theme-accent);">{t('cap.engineeringpage.text38_balanced_dynamic_milling')}</td>
