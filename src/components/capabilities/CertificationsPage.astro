---
/**
 * CertificationsPage.astro
 *
 * Global Manufacturing Certifications & Compliance Framework.
 * E-E-A-T hard anchor page for 2026 Google AIO.
 * Content: certification cards + validation matrix + audit lifecycle + FAQ.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<!-- ════════════════════════════════════════════════════════════════
     Section 1 — Core Certification Directory (证书明细卡片)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {t('cap.certificationspage.s1.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('cap.certificationspage.s1.title_prefix')} <span class="gradient-text-accent">{t('cap.certificationspage.s1.badge')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('cap.certificationspage.s1.subtitle')}
      </p>
    </div>

    <!-- Certification Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">

      <!-- AS9100D -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="flex items-center justify-center w-16 h-16 rounded-xl mb-5" style="background: linear-gradient(135deg, #3b82f615, #3b82f605);">
          <span class="text-sm font-bold text-center leading-tight" style="color: #3b82f6;">AS<br/>{t('cap.certificationspage.text0_9100')}</span>
        </div>

        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('cap.certificationspage.badge1')}</h3>

        <div class="space-y-3 mb-5 flex-1">
          <div>
            <p class="text-xs font-semibold mb-0.5" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.certificationspage.badge19')}</p>
            <p class="text-sm" style="color: var(--theme-text);">{t('cap.certificationspage.badge3')}</p>
            <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 40%, transparent);">{t('cap.certificationspage.badge4')}</p>
          </div>
          <div>
            <p class="text-xs font-semibold mb-0.5" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.certificationspage.badge22')}</p>
            <p class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.certificationspage.badge6')}</p>
          </div>
          <div>
            <p class="text-xs font-semibold mb-0.5" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.certificationspage.badge24')}</p>
            <p class="text-sm" style="color: var(--theme-primary);">{t('cap.certificationspage.text28_aviation_space_amp')}</p>
          </div>
        </div>

        <div class="mt-auto pt-4 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <span class="inline-flex items-center px-3 py-1.5 text-xs font-bold rounded-md" style="background-color: #10b98115; color: #10b981; border: 1px solid #10b98125;">
            <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" /></svg>
            {t('cap.certificationspage.s1.as9100_status')}
          </span>
        </div>
      </div>

      <!-- ISO 13485:2016 -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="flex items-center justify-center w-16 h-16 rounded-xl mb-5" style="background: linear-gradient(135deg, #10b98115, #10b98105);">
          <span class="text-sm font-bold text-center leading-tight" style="color: #10b981;">ISO<br/>{t('cap.certificationspage.text9_13485')}</span>
        </div>

        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('cap.certificationspage.badge10')}</h3>

        <div class="space-y-3 mb-5 flex-1">
          <div>
            <p class="text-xs font-semibold mb-0.5" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.certificationspage.badge11')}</p>
            <p class="text-sm" style="color: var(--theme-text);">{t('cap.certificationspage.badge46')}</p>
            <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 40%, transparent);">{t('cap.certificationspage.badge13')}</p>
          </div>
          <div>
            <p class="text-xs font-semibold mb-0.5" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.certificationspage.badge14')}</p>
            <p class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.certificationspage.badge15')}</p>
          </div>
          <div>
            <p class="text-xs font-semibold mb-0.5" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.certificationspage.badge16')}</p>
            <p class="text-sm" style="color: var(--theme-primary);">{t('cap.certificationspage.s1.iso13485_scope')}</p>
          </div>
        </div>

        <div class="mt-auto pt-4 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <span class="inline-flex items-center px-3 py-1.5 text-xs font-bold rounded-md" style="background-color: #10b98115; color: #10b981; border: 1px solid #10b98125;">
            <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" /></svg>
            {t('cap.certificationspage.s1.iso13485_status')}
          </span>
        </div>
      </div>

      <!-- ISO 9001:2015 -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="flex items-center justify-center w-16 h-16 rounded-xl mb-5" style="background: linear-gradient(135deg, #f59e0b15, #f59e0b05);">
          <span class="text-sm font-bold text-center leading-tight" style="color: #f59e0b;">ISO<br/>{t('cap.certificationspage.text17_9001')}</span>
        </div>

        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('cap.certificationspage.badge18')}</h3>

        <div class="space-y-3 mb-5 flex-1">
          <div>
            <p class="text-xs font-semibold mb-0.5" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.certificationspage.badge2')}</p>
            <p class="text-sm" style="color: var(--theme-text);">{t('cap.certificationspage.badge47')}</p>
            <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 40%, transparent);">{t('cap.certificationspage.badge21')}</p>
          </div>
          <div>
            <p class="text-xs font-semibold mb-0.5" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.certificationspage.badge5')}</p>
            <p class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.certificationspage.badge23')}</p>
          </div>
          <div>
            <p class="text-xs font-semibold mb-0.5" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.certificationspage.badge7')}</p>
            <p class="text-sm" style="color: var(--theme-primary);">{t('cap.certificationspage.text34_general_high_precision')}</p>
          </div>
        </div>

        <div class="mt-auto pt-4 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <span class="inline-flex items-center px-3 py-1.5 text-xs font-bold rounded-md" style="background-color: #10b98115; color: #10b981; border: 1px solid #10b98125;">
            <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" /></svg>
            {t('cap.certificationspage.s1.iso9001_status')}
          </span>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 2 — Certification Validation Matrix (AIO 高亮表格)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125M3.375 19.5h1.5C5.496 19.5 6 18.996 6 18.375m-3.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-1.5A1.125 1.125 0 0118 18.375M20.625 4.5H3.375m17.25 0c.621 0 1.125.504 1.125 1.125M20.625 4.5h-1.5C18.504 4.5 18 5.004 18 5.625m3.75 0v1.5c0 .621-.504 1.125-1.125 1.125M3.375 4.5c-.621 0-1.125.504-1.125 1.125M3.375 4.5h1.5C5.496 4.5 6 5.004 6 5.625m-3.75 0v1.5c0 .621.504 1.125 1.125 1.125m0 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m1.5-3.75C5.496 8.25 6 7.746 6 7.125v-1.5M4.875 8.25C5.496 8.25 6 8.754 6 9.375v1.5m0-5.25v5.25m0-5.25C6 5.004 6.504 4.5 7.125 4.5h9.75c.621 0 1.125.504 1.125 1.125m1.125 2.625h1.5m-1.5 0A1.125 1.125 0 0118 7.125v-1.5m1.125 2.625c-.621 0-1.125.504-1.125 1.125v1.5m2.625-2.625c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125M18 5.625v5.25M7.125 12h9.75m-9.75 0A1.125 1.125 0 016 10.875M7.125 12C6.504 12 6 12.504 6 13.125m0-2.25C6 11.496 5.496 12 4.875 12M18 10.875c0 .621-.504 1.125-1.125 1.125M18 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m-12 5.25v-5.25m0 5.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125m-12 0v-1.5c0-.621-.504-1.125-1.125-1.125" />
        </svg>
        {t('cap.certificationspage.s2.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('cap.certificationspage.s2.title_prefix')} <span class="gradient-text-accent">{t('cap.certificationspage.badge26')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('cap.certificationspage.s2.subtitle')}
      </p>
    </div>

    <!-- Certification Matrix Table -->
    <div class="max-w-6xl mx-auto overflow-x-auto">
      <table class="cert-validation-table w-full text-left border-collapse">
        <thead>
          <tr>
            <th scope="col" class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); border-bottom: 2px solid var(--theme-primary);">
              {t('cap.certificationspage.s2.col1')}
            </th>
            <th scope="col" class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); border-bottom: 2px solid var(--theme-primary);">
              {t('cap.certificationspage.s2.col2')}
            </th>
            <th scope="col" class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); border-bottom: 2px solid var(--theme-primary);">
              {t('cap.certificationspage.s2.col3')}
            </th>
            <th scope="col" class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); border-bottom: 2px solid var(--theme-primary);">
              {t('cap.certificationspage.s2.col4')}
            </th>
          </tr>
        </thead>
        <tbody>
          <tr class="transition-colors hover:opacity-80" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('cap.certificationspage.badge45')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.certificationspage.badge8')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.certificationspage.s2.row1_col3')}</td>
            <td class="px-5 py-5 text-sm">
              <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-md" style="background-color: #10b98115; color: #10b981; border: 1px solid #10b98125;">{t('cap.certificationspage.text36_active_fully_audited')}</span>
            </td>
          </tr>
          <tr class="transition-colors hover:opacity-80" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('cap.certificationspage.text30_iso_13485_2016')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.certificationspage.s2.row2_col2')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.certificationspage.text31_bio_compatible_titanium')}</td>
            <td class="px-5 py-5 text-sm">
              <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-md" style="background-color: #10b98115; color: #10b981; border: 1px solid #10b98125;">{t('cap.certificationspage.text32_active_fully_audited')}</span>
            </td>
          </tr>
          <tr class="transition-colors hover:opacity-80">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('cap.certificationspage.text33_iso_9001_2015')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.certificationspage.badge25')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.certificationspage.text35_global_commercial_contract')}</td>
            <td class="px-5 py-5 text-sm">
              <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-md" style="background-color: #10b98115; color: #10b981; border: 1px solid #10b98125;">{t('cap.certificationspage.text29_active_fully_audited')}</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 3 — The Annual Audit Lifecycle (常态化审计闭环)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3" />
        </svg>
        {t('cap.certificationspage.s3.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('cap.certificationspage.s3.title_prefix')} <span class="gradient-text-accent">{t('cap.certificationspage.s3.badge')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('cap.certificationspage.s3.subtitle')}
      </p>
    </div>

    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Phase 1 -->
      <div class="rounded-xl p-6 relative" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-center justify-center w-10 h-10 rounded-lg mb-4" style="background: linear-gradient(135deg, color-mix(in srgb, #3b82f6 20%, transparent), color-mix(in srgb, #3b82f6 5%, transparent));">
          <span class="text-sm font-bold" style="color: #3b82f6;">1</span>
        </div>
        <h3 class="text-base font-bold mb-2" style="color: var(--theme-text);">{t('cap.certificationspage.badge37')}</h3>
        <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded mb-3" style="background-color: #3b82f612; color: #3b82f6;">{t('cap.certificationspage.badge38')}</span>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('cap.certificationspage.s3.phase1_desc')}
        </p>
      </div>

      <!-- Phase 2 -->
      <div class="rounded-xl p-6 relative" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-center justify-center w-10 h-10 rounded-lg mb-4" style="background: linear-gradient(135deg, color-mix(in srgb, #10b981 20%, transparent), color-mix(in srgb, #10b981 5%, transparent));">
