---
/**
 * QualityPage.astro
 *
 * Certified Quality Assurance & Titanium Traceability Infrastructure.
 * E-E-A-T core page for Google AIO trust entity extraction.
 * Content: metrology fleet + IQC-to-OQC workflow + doc matrix + FAQ.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<!-- ════════════════════════════════════════════════════════════════
     Section 1 — Certification & Standards Overview (认证徽章)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {t('page_quality.hero.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('page_quality.hero.title')} <span class="gradient-text-accent">{t('page_quality.hero.title_highlight')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('page_quality.hero.subtitle')}
      </p>
    </div>

    <!-- Certification Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">

      <!-- AS9100 Rev D -->
      <div class="rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-center justify-center w-14 h-14 rounded-xl mb-4" style="background: linear-gradient(135deg, #3b82f615, #3b82f605);">
          <span class="text-xs font-bold text-center leading-tight" style="color: #3b82f6;">AS<br/>{t('cap.qualitypage.text1_9100')}</span>
        </div>
        <h3 class="text-lg font-bold mb-1" style="color: var(--theme-text);">{t('cap.qualitypage.badge57')}</h3>
        <p class="text-xs mb-3" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.qualitypage.badge3')}</p>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('page_quality.cards.card1_desc')}
        </p>
      </div>

      <!-- ISO 13485:2016 -->
      <div class="rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-center justify-center w-14 h-14 rounded-xl mb-4" style="background: linear-gradient(135deg, #10b98115, #10b98105);">
          <span class="text-xs font-bold text-center leading-tight" style="color: #10b981;">ISO<br/>{t('cap.qualitypage.badge4')}</span>
        </div>
        <h3 class="text-lg font-bold mb-1" style="color: var(--theme-text);">{t('cap.qualitypage.badge58')}</h3>
        <p class="text-xs mb-3" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('page_quality.cards.card2_label')}</p>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('page_quality.cards.card2_desc')}
        </p>
      </div>

      <!-- ISO 9001:2015 -->
      <div class="rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-center justify-center w-14 h-14 rounded-xl mb-4" style="background: linear-gradient(135deg, #f59e0b15, #f59e0b05);">
          <span class="text-xs font-bold text-center leading-tight" style="color: #f59e0b;">ISO<br/>{t('cap.qualitypage.badge6')}</span>
        </div>
        <h3 class="text-lg font-bold mb-1" style="color: var(--theme-text);">{t('cap.qualitypage.badge59')}</h3>
        <p class="text-xs mb-3" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.qualitypage.badge8')}</p>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('page_quality.cards.card3_desc')}
        </p>
      </div>

    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 2 — Metrology & Inspection Equipment Fleet (设备集群)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 7.5l16.5-4.125M12 6.75c-2.485 0-4.5-1.007-4.5-2.25s2.015-2.25 4.5-2.25 4.5 1.007 4.5 2.25-2.015 2.25-4.5 2.25zM12 15.75c-2.485 0-4.5 1.007-4.5 2.25s2.015 2.25 4.5 2.25 4.5-1.007 4.5-2.25-2.015-2.25-4.5-2.25zM3.75 7.5v9.75M20.25 4.125v9.75M3.75 17.25c0 1.243 2.015 2.25 4.5 2.25m13.5-11.25c0 1.243-2.015 2.25-4.5 2.25" />
        </svg>
        {t('page_quality.metrology.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('page_quality.metrology.title')} <span class="gradient-text-accent">{t('page_quality.metrology.title_highlight')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('page_quality.metrology.subtitle')}
      </p>
    </div>

    <!-- Equipment Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">

      <!-- CMM -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
          </svg>
        </div>

        <h3 class="text-lg font-bold mb-2" style="color: var(--theme-text);">{t('cap.qualitypage.text10_cnc_coordinate_measuring')}</h3>
        <p class="text-sm leading-relaxed mb-4 flex-1" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('page_quality.metrology.cmm_desc')}
        </p>

        <div class="space-y-2 mt-auto pt-4 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.qualitypage.badge11')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('cap.qualitypage.badge12')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.qualitypage.text13_scanning_type')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('page_quality.metrology.cmm_scan_type')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.qualitypage.text14_standard_compliance')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('cap.qualitypage.text15_asme_y14_amp')}</span>
          </div>
        </div>
      </div>

      <!-- XRF Spectrometer -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
        </div>

        <h3 class="text-lg font-bold mb-2" style="color: var(--theme-text);">{t('cap.qualitypage.text16_xrf_spectrometer_material')}</h3>
        <p class="text-sm leading-relaxed mb-4 flex-1" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('page_quality.metrology.xrf_desc')}
        </p>

        <div class="space-y-2 mt-auto pt-4 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.qualitypage.badge17')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('cap.qualitypage.badge18')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.qualitypage.text19_pmi_validation')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('cap.qualitypage.text20_grade_grade_grade')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.qualitypage.text21_standard')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('cap.qualitypage.text22_astm_e415_iso')}</span>
          </div>
        </div>
      </div>

      <!-- Vision Inspection & Surface Profilometers -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
          </svg>
        </div>

        <h3 class="text-lg font-bold mb-2" style="color: var(--theme-text);">{t('cap.qualitypage.text23_vision_inspection_amp')}</h3>
        <p class="text-sm leading-relaxed mb-4 flex-1" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('page_quality.metrology.vision_desc')}
        </p>

        <div class="space-y-2 mt-auto pt-4 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.qualitypage.badge24')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('cap.qualitypage.badge25')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('page_quality.metrology.measurement_label')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('cap.qualitypage.text26_non_contact_optical')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.qualitypage.text27_parameters')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('cap.qualitypage.text28_rmax_iso_4287')}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 3 — Closed-Loop Quality Control Workflow (IQC→OQC)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3" />
        </svg>
        {t('page_quality.workflow.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('page_quality.workflow.title')} <span class="gradient-text-accent">{t('page_quality.workflow.title_highlight')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('page_quality.workflow.subtitle')}
      </p>
    </div>

    <!-- Workflow Steps -->
    <ol class="max-w-5xl mx-auto space-y-6">
      <!-- Step 1: IQC -->
      <li class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, #3b82f6 20%, transparent), color-mix(in srgb, #3b82f6 5%, transparent));">
            <span class="text-sm font-bold" style="color: #3b82f6;">1</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.qualitypage.badge30')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: #3b82f612; color: #3b82f6;">{t('cap.qualitypage.badge31')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              {t('page_quality.workflow.step1_desc')}
            </p>
          </div>
        </div>
      </li>

      <!-- Step 2: FAI -->
      <li class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, #10b981 20%, transparent), color-mix(in srgb, #10b981 5%, transparent));">
            <span class="text-sm font-bold" style="color: #10b981;">2</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.qualitypage.badge33')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: #10b98112; color: #10b981;">{t('cap.qualitypage.badge34')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              {t('page_quality.workflow.step2_desc')}
            </p>
          </div>
        </div>
      </li>

      <!-- Step 3: IPQC -->
      <li class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, #f59e0b 20%, transparent), color-mix(in srgb, #f59e0b 5%, transparent));">
            <span class="text-sm font-bold" style="color: #f59e0b;">3</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.qualitypage.badge36')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: #f59e0b12; color: #f59e0b;">{t('cap.qualitypage.badge37')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              {t('page_quality.workflow.step3_desc')}
            </p>
          </div>
        </div>
      </li>

      <!-- Step 4: OQC -->
      <li class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 20%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
            <span class="text-sm font-bold" style="color: var(--theme-primary);">4</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.qualitypage.badge39')}</h3>
