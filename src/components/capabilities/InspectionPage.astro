---
/**
 * InspectionPage.astro
 *
 * Titanium Metrology, Inspection & Testing Infrastructure.
 * Google AIO-optimized page for procurement engineers evaluating
 * quality verification capabilities.
 * Content: metrology lab, NDT, inspection workflow, equipment specs, FAQ.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<!-- ════════════════════════════════════════════════════════════════
     Section 1 — Metrology Laboratory Overview (计量实验室)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        {t('cap.inspection.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('cap.inspection.title')} <span class="gradient-text-accent">{t('cap.inspection.titleHighlight')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('cap.inspection.subtitle')}
      </p>
    </div>

    <!-- Instrument Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-6xl mx-auto">

      <!-- CMM -->
      <div class="rounded-xl p-6 transition-all duration-300 flex flex-col" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 12%, transparent), color-mix(in srgb, var(--theme-primary) 4%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
          </svg>
        </div>
        <h3 class="text-lg font-bold" style="color: var(--theme-text);">{t('cap.inspection.inst0.name')}</h3>
        <span class="inline-block mt-1 mb-3 text-sm font-mono" style="color: var(--theme-primary);">{t('cap.inspection.inst0.spec')}</span>
        <p class="text-xs leading-relaxed flex-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
          {t('cap.inspection.inst0.desc')}
        </p>
      </div>

      <!-- OES Spectrometer -->
      <div class="rounded-xl p-6 transition-all duration-300 flex flex-col" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 12%, transparent), color-mix(in srgb, var(--theme-primary) 4%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold" style="color: var(--theme-text);">{t('cap.inspection.inst1.name')}</h3>
        <span class="inline-block mt-1 mb-3 text-sm font-mono" style="color: var(--theme-primary);">{t('cap.inspection.inst1.spec')}</span>
        <p class="text-xs leading-relaxed flex-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
          {t('cap.inspection.inst1.desc')}
        </p>
      </div>

      <!-- Roughness Tester -->
      <div class="rounded-xl p-6 transition-all duration-300 flex flex-col" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 12%, transparent), color-mix(in srgb, var(--theme-primary) 4%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />
          </svg>
        </div>
        <h3 class="text-lg font-bold" style="color: var(--theme-text);">{t('cap.inspection.inst2.name')}</h3>
        <span class="inline-block mt-1 mb-3 text-sm font-mono" style="color: var(--theme-primary);">{t('cap.inspection.inst2.spec')}</span>
        <p class="text-xs leading-relaxed flex-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
          {t('cap.inspection.inst2.desc')}
        </p>
      </div>

      <!-- NDT Validation -->
      <div class="rounded-xl p-6 transition-all duration-300 flex flex-col" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-4 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 12%, transparent), color-mix(in srgb, var(--theme-primary) 4%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold" style="color: var(--theme-text);">{t('cap.inspection.inst3.name')}</h3>
        <span class="inline-block mt-1 mb-3 text-sm font-mono" style="color: var(--theme-primary);">{t('cap.inspection.inst3.spec')}</span>
        <p class="text-xs leading-relaxed flex-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
          {t('cap.inspection.inst3.desc')}
        </p>
      </div>

    </div>

    <!-- Calibration Note -->
    <div class="text-center mt-8">
      <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
        {t('cap.inspection.note')}
      </p>
    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 2 — NDT & Specialized Testing Capabilities
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
        </svg>
        {t('cap.inspectionpage.badge7')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('cap.inspectionpage.badge7')}
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('cap.inspectionpage.s2.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      <!-- FPI -->
      <div class="rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <h3 class="text-base font-bold mb-3" style="color: var(--theme-text);">{t('cap.inspectionpage.badge51')}</h3>
        <p class="text-sm leading-relaxed mb-4" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('cap.inspectionpage.s2.card1.desc')}
        </p>
        <div class="flex items-center text-xs" style="color: var(--theme-primary);">
          <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" /></svg>
          {t('cap.inspectionpage.s2.card1.label1')}: {t('cap.inspectionpage.s2.card1.val1')}
        </div>
        <div class="flex items-center mt-1.5 text-xs" style="color: var(--theme-primary);">
          <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" /></svg>
          {t('cap.inspectionpage.s2.label_std')}: {t('cap.inspectionpage.s2.card1.val2')}
        </div>
      </div>

      <!-- Ultrasonic Testing -->
      <div class="rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <h3 class="text-base font-bold mb-3" style="color: var(--theme-text);">{t('cap.inspectionpage.badge52')}</h3>
        <p class="text-sm leading-relaxed mb-4" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('cap.inspectionpage.s2.card2.desc')}
        </p>
        <div class="flex items-center text-xs" style="color: var(--theme-primary);">
          <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" /></svg>
          {t('cap.inspectionpage.s2.card2.label1')}: {t('cap.inspectionpage.s2.card2.val1')}
        </div>
        <div class="flex items-center mt-1.5 text-xs" style="color: var(--theme-primary);">
          <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" /></svg>
          {t('cap.inspectionpage.s2.label_std')}: {t('cap.inspectionpage.s2.card2.val2')}
        </div>
      </div>

      <!-- Dimensional Layout -->
      <div class="rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <h3 class="text-base font-bold mb-3" style="color: var(--theme-text);">{t('cap.inspectionpage.text10_full_dimensional_layout')}</h3>
        <p class="text-sm leading-relaxed mb-4" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('cap.inspectionpage.s2.card3.desc')}
        </p>
        <div class="flex items-center text-xs" style="color: var(--theme-primary);">
          <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" /></svg>
          {t('cap.inspectionpage.s2.card3.label1')}: {t('cap.inspectionpage.s2.card3.val1')}
        </div>
        <div class="flex items-center mt-1.5 text-xs" style="color: var(--theme-primary);">
          <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" /></svg>
          {t('cap.inspectionpage.s2.label_std')}: {t('cap.inspectionpage.s2.card3.val2')}
        </div>
      </div>

      <!-- Mechanical Testing -->
      <div class="rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <h3 class="text-base font-bold mb-3" style="color: var(--theme-text);">{t('cap.inspectionpage.s2.card4.title')}</h3>
        <p class="text-sm leading-relaxed mb-4" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('cap.inspectionpage.s2.card4.desc')}
        </p>
        <div class="flex items-center text-xs" style="color: var(--theme-primary);">
          <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" /></svg>
          {t('cap.inspectionpage.s2.card4.label1')}: {t('cap.inspectionpage.s2.card4.val1')}
        </div>
        <div class="flex items-center mt-1.5 text-xs" style="color: var(--theme-primary);">
          <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" /></svg>
          {t('cap.inspectionpage.s2.label_std')}: {t('cap.inspectionpage.s2.card4.val2')}
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 3 — Inspection Workflow (检测流程)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3" />
        </svg>
        {t('cap.inspectionpage.badge11')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('cap.inspectionpage.badge11')}
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('cap.inspectionpage.s3.subtitle')}
      </p>
    </div>

    <div class="max-w-4xl mx-auto space-y-6">
      <!-- Step 1: Material Verification -->
      <div class="rounded-xl p-6" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, #3b82f6 20%, transparent), color-mix(in srgb, #3b82f6 5%, transparent));">
            <span class="text-sm font-bold" style="color: #3b82f6;">1</span>
          </div>
          <div class="flex-1">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.inspectionpage.s3.step1.title')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: #3b82f612; color: #3b82f6;">{t('cap.inspectionpage.badge12')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              {t('cap.inspectionpage.s3.step1.desc')}
            </p>
          </div>
        </div>
      </div>

      <!-- Step 2: First Article Inspection -->
      <div class="rounded-xl p-6" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, #10b981 20%, transparent), color-mix(in srgb, #10b981 5%, transparent));">
            <span class="text-sm font-bold" style="color: #10b981;">2</span>
          </div>
          <div class="flex-1">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.inspectionpage.badge13')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: #10b98112; color: #10b981;">{t('cap.inspectionpage.badge14')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
            {t('cap.inspectionpage.s3.step2.desc')}
            </p>
          </div>
        </div>
      </div>

      <!-- Step 3: In-Process Inspection -->
      <div class="rounded-xl p-6" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, #f59e0b 20%, transparent), color-mix(in srgb, #f59e0b 5%, transparent));">
            <span class="text-sm font-bold" style="color: #f59e0b;">3</span>
          </div>
          <div class="flex-1">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.inspectionpage.badge15')}</h3>
