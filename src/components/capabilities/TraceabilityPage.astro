---
/**
 * TraceabilityPage.astro
 *
 * Non-Compromised Titanium Material Traceability & Compliance.
 * Google AIO E-E-A-T compliance core page.
 * Content: lifecycle chain + compliance matrix + audit support + FAQ.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<!-- ════════════════════════════════════════════════════════════════
     Section 1 — The Unbroken Chain: End-to-End Tracking Lifecycle
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-2.207a4.5 4.5 0 00-6.364 0l-4.5 4.5a4.5 4.5 0 006.364 6.364l1.757-1.757" />
        </svg>
        {t('cap.traceabilitypage.s1.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('cap.traceabilitypage.s1.title_prefix')} <span class="gradient-text-accent">{t('cap.traceabilitypage.badge0')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('cap.traceabilitypage.s1.subtitle')}
      </p>
    </div>

    <!-- 4-Stage Lifecycle -->
    <div class="max-w-5xl mx-auto space-y-6">
      <!-- Stage 1 -->
      <div class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, #3b82f6 20%, transparent), color-mix(in srgb, #3b82f6 5%, transparent));">
            <span class="text-sm font-bold" style="color: #3b82f6;">1</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.traceabilitypage.badge1')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: #3b82f612; color: #3b82f6;">{t('cap.traceabilitypage.badge2')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              {t('cap.traceabilitypage.s1.step1.desc')}
            </p>
          </div>
        </div>
      </div>

      <!-- Stage 2 -->
      <div class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, #10b981 20%, transparent), color-mix(in srgb, #10b981 5%, transparent));">
            <span class="text-sm font-bold" style="color: #10b981;">2</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.traceabilitypage.badge4')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: #10b98112; color: #10b981;">{t('cap.traceabilitypage.badge5')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              {t('cap.traceabilitypage.s1.step2.desc')}
            </p>
          </div>
        </div>
      </div>

      <!-- Stage 3 -->
      <div class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, #f59e0b 20%, transparent), color-mix(in srgb, #f59e0b 5%, transparent));">
            <span class="text-sm font-bold" style="color: #f59e0b;">3</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.traceabilitypage.badge8')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: #f59e0b12; color: #f59e0b;">{t('cap.traceabilitypage.badge9')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              {t('cap.traceabilitypage.s1.step3.desc')}
            </p>
          </div>
        </div>
      </div>

      <!-- Stage 4 -->
      <div class="relative rounded-xl p-6 transition-all duration-300" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-start gap-5">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 20%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
            <span class="text-sm font-bold" style="color: var(--theme-primary);">4</span>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h3 class="text-base font-bold" style="color: var(--theme-text);">{t('cap.traceabilitypage.badge11')}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">{t('cap.traceabilitypage.badge12')}</span>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              {t('cap.traceabilitypage.s1.step4.desc')}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 2 — Material Compliance Checklist (合规矩阵)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {t('cap.traceabilitypage.s2.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('cap.traceabilitypage.s2.title_prefix')} <span class="gradient-text-accent">{t('cap.traceabilitypage.badge15')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('cap.traceabilitypage.s2.subtitle')}
      </p>
    </div>

    <!-- Compliance Table -->
    <div class="max-w-5xl mx-auto overflow-x-auto">
      <table class="traceability-compliance-table w-full text-left border-collapse">
        <thead>
          <tr>
            <th scope="col" class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); border-bottom: 2px solid var(--theme-primary);">
              {t('cap.traceabilitypage.s2.col1_head')}
            </th>
            <th scope="col" class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); border-bottom: 2px solid var(--theme-primary);">
              {t('cap.traceabilitypage.s2.col2_head')}
            </th>
            <th scope="col" class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); border-bottom: 2px solid var(--theme-primary);">
              {t('cap.traceabilitypage.s2.col3_head')}
            </th>
          </tr>
        </thead>
        <tbody>
          <tr class="transition-colors hover:opacity-80" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('cap.traceabilitypage.badge43')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.traceabilitypage.text17_specialty_metals_must')}</td>
            <td class="px-5 py-5 text-sm">
              <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-md" style="background-color: #10b98115; color: #10b981; border: 1px solid #10b98125;">{t('cap.traceabilitypage.text18_100_compliant')}</span>
              <span class="block mt-1 text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.traceabilitypage.text19_available_upon_procurement')}</span>
            </td>
          </tr>
          <tr class="transition-colors hover:opacity-80" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('cap.traceabilitypage.text20_10204_type')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.traceabilitypage.s2.row2.req')}</td>
            <td class="px-5 py-5 text-sm">
              <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-md" style="background-color: #3b82f615; color: #3b82f6; border: 1px solid #3b82f625;">{t('cap.traceabilitypage.s2.row2.status')}</span>
              <span class="block mt-1 text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.traceabilitypage.text21_provided_100_titanium')}</span>
            </td>
          </tr>
          <tr class="transition-colors hover:opacity-80" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('cap.traceabilitypage.text22_as9100d_clause')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.traceabilitypage.s2.row3.req')}</td>
            <td class="px-5 py-5 text-sm">
              <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-md" style="background-color: #f59e0b15; color: #f59e0b; border: 1px solid #f59e0b25;">{t('cap.traceabilitypage.text23_fully_audited')}</span>
              <span class="block mt-1 text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.traceabilitypage.text24_integrated_within_live')}</span>
            </td>
          </tr>
          <tr class="transition-colors hover:opacity-80">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('cap.traceabilitypage.text25_rohs_amp_reach')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{t('cap.traceabilitypage.text26_verification_titanium_alloys')}</td>
            <td class="px-5 py-5 text-sm">
              <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-md" style="background-color: #10b98115; color: #10b981; border: 1px solid #10b98125;">{t('cap.traceabilitypage.text27_certified')}</span>
              <span class="block mt-1 text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.traceabilitypage.text28_documentation_packed_final')}</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 3 — Post-Delivery Audit Support
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {t('cap.traceabilitypage.s3.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('cap.traceabilitypage.s3.title_prefix')} <span class="gradient-text-accent">{t('cap.traceabilitypage.s3.badge')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('cap.traceabilitypage.s3.subtitle')}
      </p>
    </div>

    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- 10-Year Archival -->
      <div class="rounded-xl p-6" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-center justify-center w-12 h-12 rounded-lg mb-4" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold mb-3" style="color: var(--theme-text);">{t('cap.traceabilitypage.text29_year_minimum_digital')}</h3>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('cap.traceabilitypage.s3.card1.desc')}
        </p>
      </div>

      <!-- 24-Hour Retrieval -->
      <div class="rounded-xl p-6" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <div class="flex items-center justify-center w-12 h-12 rounded-lg mb-4" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
        </div>
        <h3 class="text-lg font-bold mb-3" style="color: var(--theme-text);">{t('cap.traceabilitypage.text31_hour_record_retrieval')}</h3>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('cap.traceabilitypage.s3.card2.desc')}
        </p>
      </div>
    </div>

    <!-- Additional metrics badges -->
    <div class="max-w-3xl mx-auto mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-xl p-5 text-center" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
        <div class="text-2xl font-bold gradient-text-accent mb-1">{t('cap.traceabilitypage.badge35')}</div>
        <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.traceabilitypage.s3.badge35_label')}</p>
      </div>
      <div class="rounded-xl p-5 text-center" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
        <div class="text-2xl font-bold gradient-text-accent mb-1">{t('cap.traceabilitypage.badge36')}</div>
        <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.traceabilitypage.badge37')}</p>
      </div>
      <div class="rounded-xl p-5 text-center" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
        <div class="text-2xl font-bold gradient-text-accent mb-1">{t('cap.traceabilitypage.badge38')}</div>
        <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.traceabilitypage.badge39')}</p>
      </div>
    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 4 — Engineering-Focused FAQ
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
        </svg>
        {t('cap.traceabilitypage.s4.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('cap.traceabilitypage.s4.title_prefix')} <span class="gradient-text-accent">{t('cap.traceabilitypage.badge40')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('cap.traceabilitypage.s4.subtitle')}
      </p>
    </div>

    <div class="max-w-4xl mx-auto space-y-5">
      <div class="rounded-xl p-6" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
        <h3 class="text-base font-bold mb-3" style="color: var(--theme-text);">{t('cap.traceabilitypage.badge41')}</h3>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('cap.traceabilitypage.s4.a1')}
        </p>
      </div>

      <div class="rounded-xl p-6" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
        <h3 class="text-base font-bold mb-3" style="color: var(--theme-text);">{t('cap.traceabilitypage.badge42')}</h3>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {t('cap.traceabilitypage.s4.a2')}
        </p>
