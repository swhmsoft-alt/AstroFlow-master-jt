---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Blueprint grid -->
  <div class="absolute inset-0 opacity-[0.04]">
    <div class="absolute inset-0" style="background-image: 
      linear-gradient(var(--theme-primary) 1px, transparent 1px), 
      linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px);
      background-size: 40px 40px;
    "></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full" style="background: radial-gradient(circle, color-mix(in srgb, var(--theme-primary) 12%, transparent) 0%, transparent 70%); filter: blur(100px);"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-5xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-14">
        <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
          </svg>
          {t('cap.traceability.badge')}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
          {t('cap.traceability.title')}<span class="gradient-text-accent"> {t('cap.traceability.titleHighlight')}</span>
        </h2>
        <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          {t('cap.traceability.subtitle')}
        </p>
      </div>

      <!-- Traceability Chain -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-5 mb-12">
        <div class="text-center p-5 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mx-auto mb-3" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
            <svg class="w-5 h-5" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
            </svg>
          </div>
          <h4 class="text-sm font-bold mb-1" style="color: var(--theme-text);">{t('cap.traceability.step0.title')}</h4>
          <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.traceability.step0.desc')}</p>
        </div>

        <div class="text-center p-5 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mx-auto mb-3" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
            <svg class="w-5 h-5" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h4 class="text-sm font-bold mb-1" style="color: var(--theme-text);">{t('cap.traceability.step1.title')}</h4>
          <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.traceability.step1.desc')}</p>
        </div>

        <div class="text-center p-5 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mx-auto mb-3" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
            <svg class="w-5 h-5" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
            </svg>
          </div>
          <h4 class="text-sm font-bold mb-1" style="color: var(--theme-text);">{t('cap.traceability.step2.title')}</h4>
          <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.traceability.step2.desc')}</p>
        </div>

        <div class="text-center p-5 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mx-auto mb-3" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
            <svg class="w-5 h-5" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
            </svg>
          </div>
          <h4 class="text-sm font-bold mb-1" style="color: var(--theme-text);">{t('cap.traceability.step3.title')}</h4>
          <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('cap.traceability.step3.desc')}</p>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <a
          href={localizePath('/rfq', currentLang)}
          class="inline-flex items-center px-8 py-4 text-lg font-bold rounded-lg shadow-lg transition-all"
          style="background-color: var(--theme-primary); color: var(--theme-text);"
          onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 80%, black)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 50%, transparent)'; this.style.transform='translateY(-2px)'"
          onmouseout="this.style.backgroundColor='var(--theme-primary)'; this.style.boxShadow=''; this.style.transform=''"
        >
          {t('cap.traceability.cta')}
          <svg class="w-5 h-5 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
