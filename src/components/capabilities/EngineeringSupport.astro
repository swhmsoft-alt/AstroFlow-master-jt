---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const cadFormats: string[] = ["STEP (AP203/AP214)", "IGES", "SolidWorks (.sldprt/.sldasm)", "Mastercam (.mcx)", "AutoCAD (.dwg/.dxf)", "Parasolid (.x_t/.x_b)", "STL / OBJ"];
const dfmSteps: string[] = [
  t('cap.engineering.dfm.step0'),
  t('cap.engineering.dfm.step1'),
  t('cap.engineering.dfm.step2'),
  t('cap.engineering.dfm.step3'),
  t('cap.engineering.dfm.step4'),
  t('cap.engineering.dfm.step5'),
];
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
        </svg>
        {t('cap.engineering.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('cap.engineering.title')}<span class="gradient-text-accent"> {t('cap.engineering.titleHighlight')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('cap.engineering.subtitle')}
      </p>
    </div>

    <!-- 2-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
      <!-- Left: CAD/CAM Software Support -->
      <div
        class="relative rounded-xl p-8 transition-all duration-300"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 rounded-lg flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
            <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
            </svg>
          </div>
          <h3 class="text-xl font-bold" style="color: var(--theme-text);">{t('cap.engineering.cad.title')}</h3>
        </div>

        <p class="text-sm leading-relaxed mb-5" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          {t('cap.engineering.cad.desc')}
        </p>

        <div class="flex flex-wrap gap-2">
          {cadFormats.map((fmt) => (
            <span
              class="inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-md"
              style="background-color: rgba(255,255,255,0.03); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent); color: color-mix(in srgb, var(--theme-text) 45%, transparent);"
            >
              {fmt}
            </span>
          ))}
        </div>
      </div>

      <!-- Right: 24-Hour DFM Review -->
      <div
        class="relative rounded-xl p-8 transition-all duration-300"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-accent)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-accent) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 rounded-lg flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-accent) 15%, transparent), color-mix(in srgb, var(--theme-accent) 5%, transparent));">
            <svg class="w-6 h-6" fill="none" stroke="var(--theme-accent)" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold" style="color: var(--theme-text);">{t('cap.engineering.dfm.title')}</h3>
            <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-bold rounded" style="background-color: color-mix(in srgb, var(--theme-accent) 10%, transparent); color: var(--theme-accent); border: 1px solid color-mix(in srgb, var(--theme-accent) 15%, transparent);">
              {t('cap.engineering.dfm.badge')}
            </span>
          </div>
        </div>

        <p class="text-sm leading-relaxed mb-5" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          {t('cap.engineering.dfm.desc')}
        </p>

        <ul class="space-y-2.5">
          {dfmSteps.map((step) => (
            <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
              <svg class="w-4 h-4 mt-0.5 mr-3 shrink-0" fill="none" stroke="var(--theme-accent)" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              {step}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
