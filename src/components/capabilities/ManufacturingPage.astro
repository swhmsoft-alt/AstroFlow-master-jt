---
/**
 * ManufacturingPage.astro
 *
 * High-density B2B manufacturing capabilities page for Google AIO (AI Overviews).
 * Semantic HTML5, explicit entity injection, and structured tech specs table.
 * Copy tone: engineering procurement / technical white paper.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<!-- ════════════════════════════════════════════════════════════════
     Section 1 — Core Manufacturing Processes (三栏卡片布局)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Engineering grid overlay -->
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 01-.657.643 48.39 48.39 0 01-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 01-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 00-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 01-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 00.657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 01-.349-1.003c0-1.035 1.007-1.875 2.25-1.875s2.25.84 2.25 1.875c0 .369-.128.713-.349 1.003-.215.283-.401.604-.401.959v0c0 .333.277.599.61.58a48.1 48.1 0 005.427-.63 48.05 48.05 0 00.582-4.717.532.532 0 00-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.959.401v0a.656.656 0 00.658-.663 48.422 48.422 0 00-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 01-.61-.58v0z" />
        </svg>
        {t('capabilities.manufacturing.processes.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('capabilities.manufacturing.processes.title')} <span class="gradient-text-accent">{t('capabilities.manufacturing.processes.titleHighlight')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('capabilities.manufacturing.processes.subtitle')}
      </p>
    </div>

    <!-- Process Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">

      <!-- Card 1: 5-Axis CNC Milling -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 7.5l16.5-4.125M12 6.75c-2.485 0-4.5-1.007-4.5-2.25s2.015-2.25 4.5-2.25 4.5 1.007 4.5 2.25-2.015 2.25-4.5 2.25zM12 15.75c-2.485 0-4.5 1.007-4.5 2.25s2.015 2.25 4.5 2.25 4.5-1.007 4.5-2.25-2.015-2.25-4.5-2.25zM3.75 7.5v9.75M20.25 4.125v9.75M3.75 17.25c0 1.243 2.015 2.25 4.5 2.25m13.5-11.25c0 1.243-2.015 2.25-4.5 2.25" />
          </svg>
        </div>

        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('capabilities.manufacturing.processes.card1.title')}</h3>
        <p class="text-sm leading-relaxed mb-5 flex-1" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          {t('capabilities.manufacturing.processes.card1.desc')}
        </p>

        <!-- Key Entities / Metrics -->
        <div class="space-y-2 mt-auto">
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('capabilities.manufacturing.processes.card1.metric1')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('capabilities.manufacturing.processes.card1.value1')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('capabilities.manufacturing.processes.card1.metric2')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('capabilities.manufacturing.processes.card1.value2')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('capabilities.manufacturing.processes.card1.metric3')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('capabilities.manufacturing.processes.card1.value3')}</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Precision Swiss Lathe Turning -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
        </div>

        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('capabilities.manufacturing.processes.card2.title')}</h3>
        <p class="text-sm leading-relaxed mb-5 flex-1" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          {t('capabilities.manufacturing.processes.card2.desc')}
        </p>

        <!-- Key Entities / Metrics -->
        <div class="space-y-2 mt-auto">
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('capabilities.manufacturing.processes.card2.metric1')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('capabilities.manufacturing.processes.card2.value1')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('capabilities.manufacturing.processes.card2.metric2')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('capabilities.manufacturing.processes.card2.value2')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('capabilities.manufacturing.processes.card2.metric3')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('capabilities.manufacturing.processes.card2.value3')}</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Wire EDM & EDM Sinking -->
      <div
        class="group relative rounded-xl p-6 md:p-8 transition-all duration-300 flex flex-col"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
        onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
        onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
      >
        <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
          <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
          </svg>
        </div>

        <h3 class="text-xl font-bold mb-3" style="color: var(--theme-text);">{t('capabilities.manufacturing.processes.card3.title')}</h3>
        <p class="text-sm leading-relaxed mb-5 flex-1" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
          {t('capabilities.manufacturing.processes.card3.desc')}
        </p>

        <!-- Key Entities / Metrics -->
        <div class="space-y-2 mt-auto">
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('capabilities.manufacturing.processes.card3.metric1')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('capabilities.manufacturing.processes.card3.value1')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('capabilities.manufacturing.processes.card3.metric2')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('capabilities.manufacturing.processes.card3.value2')}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('capabilities.manufacturing.processes.card3.metric3')}</span>
            <span class="font-semibold" style="color: var(--theme-primary);">{t('capabilities.manufacturing.processes.card3.value3')}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     Section 2 — Technical Specifications Table (AIO 提取核心)
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125M3.375 19.5h1.5C5.496 19.5 6 18.996 6 18.375m-3.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-1.5A1.125 1.125 0 0118 18.375M20.625 4.5H3.375m17.25 0c.621 0 1.125.504 1.125 1.125M20.625 4.5h-1.5C18.504 4.5 18 5.004 18 5.625m3.75 0v1.5c0 .621-.504 1.125-1.125 1.125M3.375 4.5c-.621 0-1.125.504-1.125 1.125M3.375 4.5h1.5C5.496 4.5 6 5.004 6 5.625m-3.75 0v1.5c0 .621.504 1.125 1.125 1.125m0 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m1.5-3.75C5.496 8.25 6 7.746 6 7.125v-1.5M4.875 8.25C5.496 8.25 6 8.754 6 9.375v1.5m0-5.25v5.25m0-5.25C6 5.004 6.504 4.5 7.125 4.5h9.75c.621 0 1.125.504 1.125 1.125m1.125 2.625h1.5m-1.5 0A1.125 1.125 0 0118 7.125v-1.5m1.125 2.625c-.621 0-1.125.504-1.125 1.125v1.5m2.625-2.625c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125M18 5.625v5.25M7.125 12h9.75m-9.75 0A1.125 1.125 0 016 10.875M7.125 12C6.504 12 6 12.504 6 13.125m0-2.25C6 11.496 5.496 12 4.875 12M18 10.875c0 .621-.504 1.125-1.125 1.125M18 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m-12 5.25v-5.25m0 5.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125m-12 0v-1.5c0-.621-.504-1.125-1.125-1.125M18 18.375v-5.25m0 5.25v-1.5c0-.621.504-1.125 1.125-1.125M18 13.125v1.5c0 .621.504 1.125 1.125 1.125M18 13.125c0-.621.504-1.125 1.125-1.125M6 13.125v1.5c0 .621-.504 1.125-1.125 1.125M6 13.125C6 12.504 5.496 12 4.875 12m-1.5 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M19.125 12h1.5m0 0c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h1.5m14.25 0h1.5" />
        </svg>
        {t('capabilities.manufacturing.specs.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('capabilities.manufacturing.specs.title')} <span class="gradient-text-accent">{t('capabilities.manufacturing.specs.titleHighlight')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('capabilities.manufacturing.specs.subtitle')}
      </p>
    </div>

    <!-- ════════════════════════════════════════════════════════════════
         HTML <table> — Native semantic table for Google AIO extraction
         ════════════════════════════════════════════════════════════════ -->
    <div class="max-w-5xl mx-auto overflow-x-auto">
      <table class="tech-spec-table w-full text-left border-collapse">
        <thead>
          <tr>
            <th scope="col" class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); border-bottom: 2px solid var(--theme-primary);">
              {t('capabilities.manufacturing.specs.table.param')}
            </th>
            <th scope="col" class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); border-bottom: 2px solid var(--theme-primary);">
              {t('capabilities.manufacturing.specs.table.capability')}
            </th>
            <th scope="col" class="px-5 py-4 text-sm font-bold uppercase tracking-wider" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary); border-bottom: 2px solid var(--theme-primary);">
              {t('capabilities.manufacturing.specs.table.material')}
            </th>
          </tr>
        </thead>
        <tbody>
          <tr class="transition-colors hover:opacity-80" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('capabilities.manufacturing.specs.row1.param')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{t('capabilities.manufacturing.specs.row1.value')}</td>
            <td class="px-5 py-5 text-sm" style="color: var(--theme-primary);">{t('capabilities.manufacturing.specs.row1.material')}</td>
          </tr>
          <tr class="transition-colors hover:opacity-80" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('capabilities.manufacturing.specs.row2.param')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{t('capabilities.manufacturing.specs.row2.value')}</td>
            <td class="px-5 py-5 text-sm" style="color: var(--theme-primary);">{t('capabilities.manufacturing.specs.row2.material')}</td>
          </tr>
          <tr class="transition-colors hover:opacity-80" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('capabilities.manufacturing.specs.row5.param')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{t('capabilities.manufacturing.specs.row5.value')}</td>
            <td class="px-5 py-5 text-sm" style="color: var(--theme-primary);">{t('capabilities.manufacturing.specs.row5.material')}</td>
          </tr>
          <tr class="transition-colors hover:opacity-80" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('capabilities.manufacturing.specs.row6.param')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{t('capabilities.manufacturing.specs.row6.value')}</td>
            <td class="px-5 py-5 text-sm" style="color: var(--theme-primary);">{t('capabilities.manufacturing.specs.row6.material')}</td>
          </tr>
          <tr class="transition-colors hover:opacity-80" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('capabilities.manufacturing.specs.row3.param')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{t('capabilities.manufacturing.specs.row3.value')}</td>
            <td class="px-5 py-5 text-sm" style="color: var(--theme-primary);">{t('capabilities.manufacturing.specs.row3.material')}</td>
          </tr>
          <tr class="transition-colors hover:opacity-80">
            <td class="px-5 py-5 text-sm font-semibold" style="color: var(--theme-text);">{t('capabilities.manufacturing.specs.row4.param')}</td>
            <td class="px-5 py-5 text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{t('capabilities.manufacturing.specs.row4.value')}</td>
            <td class="px-5 py-5 text-sm" style="color: var(--theme-primary);">{t('capabilities.manufacturing.specs.row4.material')}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Callout note -->
    <div class="max-w-5xl mx-auto mt-6 p-4 rounded-lg text-sm" style="background-color: color-mix(in srgb, var(--theme-primary) 5%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent); color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
      <span class="font-semibold" style="color: var(--theme-text);">{t('capabilities.manufacturing.specs.noteLabel')}</span> {t('capabilities.manufacturing.specs.note')}
    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════

<!-- ════════════════════════════════════════════════════════════════
     Section 2.5 — Titanium Machining Capability Matrix (Procurement)
     Process-by-process capability evidence for buyer qualification.
     All values sourced from real equipment inventory & metrology data.
     ════════════════════════════════════════════════════════════════ -->
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
