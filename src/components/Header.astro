---
import { NAVIGATION, SITE } from '@config/site';
import type { NavItem } from '@config/site';
import MobileMenu from '@components/react/MobileMenu';
import LanguageSelector from './LanguageSelector.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const { currentPathname } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const isActiveLink = (href: string) : boolean => { return href === currentPathname; }

// ── Navigation translation key mappings ────────────────────
// Map top-level href → nav translation key
const navKeyByHref: Record<string, string> = {
  '/': 'nav.home',
  '/services': 'nav.services',
  '/materials': 'nav.materials',
  '/capabilities': 'nav.capabilities',
  '/industries': 'nav.industries',
  '/resources': 'nav.resources',
  '/products': 'nav.products',
  '/equipment': 'nav.equipment',
};

// Map child href → child item translation key
const childNavKeyByHref: Record<string, string> = {
  // Services > CNC Machining
  '/titanium-cnc-machining-services': 'nav.services.titaniumCncMachiningServices',
  '/titanium-cnc-machining-services/3-5-axis-cnc-machining': 'nav.services.3_5AxisCncMachining',
  '/titanium-cnc-machining-services/cnc-milling-turning': 'nav.services.cncMillingTurning',
  '/titanium-cnc-machining-services/wire-edm-machining': 'nav.services.wireEdmMachining',
  '/titanium-cnc-machining-services/custom-industrial-components': 'nav.services.customIndustrialComponents',
  // Services > Additive
  '/titanium-additive-manufacturing': 'nav.services.titaniumAdditiveManufacturing',
  '/titanium-additive-manufacturing/3d-printing-slm': 'nav.services.3dPrintingSlm',
  '/titanium-additive-manufacturing/rapid-prototyping': 'nav.services.rapidPrototyping',
  '/titanium-additive-manufacturing/low-volume-production': 'nav.services.lowVolumeProduction',
  // Services > Fabrication
  '/titanium-fabrication-services': 'nav.services.titaniumFabricationServices',
  '/titanium-fabrication-services/laser-cutting': 'nav.services.laserCutting',
  '/titanium-fabrication-services/waterjet-cutting': 'nav.services.waterjetCutting',
  '/titanium-fabrication-services/titanium-welding-assembly': 'nav.services.titaniumWeldingAssembly',
  // Services > Forming & Heavy
  '/titanium-forming-heavy-manufacturing': 'nav.services.titaniumFormingHeavyManufacturing',
  '/titanium-forming-heavy-manufacturing/titanium-forging': 'nav.services.titaniumForging',
  '/titanium-forming-heavy-manufacturing/titanium-extrusion': 'nav.services.titaniumExtrusion',
  '/titanium-forming-heavy-manufacturing/raw-material-preparation-sizing': 'nav.services.rawMaterialPreparation',
  // Services > Surface Treatment
  '/titanium-surface-treatment': 'nav.services.titaniumSurfaceTreatment',
  '/titanium-surface-treatment/anodizing': 'nav.services.anodizing',
  '/titanium-surface-treatment/chemical-passivation': 'nav.services.chemicalPassivation',
  '/titanium-surface-treatment/polishing-sandblasting': 'nav.services.polishingSandblasting',
  // Services > Value-Added
  '/branded-custom-packaging-services': 'nav.services.brandedCustomPackaging',
  '/laser-marking-custom-logo': 'nav.services.laserMarkingCustomLogo',
  // Materials — dedicated grade pages
  '/materials/grade-1': 'nav.materials.grade1',
  '/materials/grade-2': 'nav.materials.grade2',
  '/materials/grade-3': 'nav.materials.grade3',
  '/materials/grade-4': 'nav.materials.grade4',
  '/materials/grade-4-eli': 'nav.materials.grade4Eli',
  '/materials/grade-5': 'nav.materials.grade5',
  '/materials/grade-6': 'nav.materials.grade6',
  '/materials/grade-9': 'nav.materials.grade9',
  '/materials/grade-19': 'nav.materials.grade19',
  '/materials/grade-21': 'nav.materials.grade21',
  '/materials/grade-23': 'nav.materials.grade23',
  '/materials/grade-6242': 'nav.materials.grade6242',
  '/materials/ti-5553': 'nav.materials.ti5553',
  '/materials/#comparison': 'nav.materials.alloyComparison',
  // Materials — standard pages
  '/materials/astm-b348': 'nav.materials.astmB348',
  '/materials/astm-b265': 'nav.materials.astmB265',
  '/materials/astm-b381': 'nav.materials.astmB381',
  '/materials/astm-b338': 'nav.materials.astmB338',
  '/materials/astm-b861': 'nav.materials.astmB861',
  '/materials/astm-f67': 'nav.materials.astmF67',
  '/materials/astm-f136': 'nav.materials.astmF136',
  '/materials/astm-f86': 'nav.materials.astmF86',
  '/materials/astm-f2924': 'nav.materials.astmF2924',
  '/materials/astm-f3001': 'nav.materials.astmF3001',
  '/materials/ams-4911': 'nav.materials.ams4911',
  '/materials/ams-4928': 'nav.materials.ams4928',
  '/materials/ams-4943': 'nav.materials.ams4943',
  '/materials/ams-4944': 'nav.materials.ams4944',
  '/materials/ams-2488': 'nav.materials.ams2488',
  '/materials/iso-5832-3': 'nav.materials.iso58323',
  '/materials/iso-5832-11': 'nav.materials.iso583211',
  '/materials/mil-t-9047': 'nav.materials.milT9047',
  // Capabilities
  '/capabilities/manufacturing': 'nav.capabilities.manufacturing',
  '/capabilities/engineering': 'nav.capabilities.engineering',
  '/capabilities/capacity': 'nav.capabilities.capacity',
  '/capabilities/quality': 'nav.capabilities.quality',
  '/capabilities/inspection': 'nav.capabilities.inspection',
  '/capabilities/traceability': 'nav.capabilities.traceability',
  '/capabilities/certifications': 'nav.capabilities.certifications',
  '/equipment': 'nav.equipment',
  // Industries
  '/industries#aerospace': 'nav.industries.aerospace',
  '/industries#medical': 'nav.industries.medical',
  '/industries#uav-drones': 'nav.industries.uavDrones',
  '/industries#ai-infrastructure': 'nav.industries.aiInfrastructure',
  '/industries#marine': 'nav.industries.marine',
  '/industries#semiconductor': 'nav.industries.semiconductor',
  '/industries#energy': 'nav.industries.energy',
  '/industries#industrial-equipment': 'nav.industries.industrialEquipment',
  // Resources
  '/resources#knowledge-base': 'nav.resources.knowledgeBase',
  '/resources#grades-guide': 'nav.resources.gradesGuide',
  '/resources#design-guides': 'nav.resources.designGuides',
  '/resources#insights': 'nav.resources.insights',
  '/resources#applications': 'nav.resources.applications',
  '/resources#case-studies': 'nav.resources.caseStudies',
  '/resources#faqs': 'nav.resources.faqs',
  '/resources#downloads': 'nav.resources.downloads',
  // Blog (inside Resources dropdown)
  '/blog': 'nav.blog',
};

// Map (parent href → heading text → translation key) for dropdown column headings
const navHeadingKeyByParent: Record<string, Record<string, string>> = {
  '/services': {
    'CNC Machining': 'nav.services.cncMachining',
    'Additive': 'nav.services.additive',
    'Fabrication': 'nav.services.fabrication',
    'Forming & Heavy': 'nav.services.formingHeavy',
    'Surface Treatment': 'nav.services.surfaceTreatment',
    'Value-Added': 'nav.services.valueAdded',
  },
  '/materials': {
    'Titanium Grades': 'nav.materials.titaniumGrades',
    'Titanium Standards': 'nav.materials.titaniumStandards',
    'AMS, MIL & Additive': 'nav.materials.amsMilAdditive',
  },
  '/capabilities': {
    'Our Capabilities': 'nav.capabilities.ourCapabilities',
  },
  '/industries': {
    'Industries Served': 'nav.industries.industriesServed',
  },
  '/resources': {
    'Resource Hub': 'nav.resources.resourceHub',
  },
};

// Get translation key for a dropdown column heading
const getHeadingKey = (parentHref: string, heading: string): string => {
  return navHeadingKeyByParent[parentHref]?.[heading] || heading;
};

// Static site identity (previously loaded from CMS collection 'general')
const siteName = SITE.title;
const logoImage = undefined; // Set a static logo path here if desired: '/uploads/logo.png'
const logoAlt = 'Site Logo';
const logoText = 'BOZE CNC Ti';
const logoSubtext = 'Precision Titanium Manufacturing';
---

<header class="sticky top-0 z-50 w-full border-b" style="background-color: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 20%, transparent);">
  <nav class="container mx-auto flex h-20 items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <div class="flex items-center flex-shrink-0">
      <a href={localizePath('/', currentLang)} class="flex items-center space-x-4 group">
        {logoImage ? (
          <!-- CMS-managed Logo Image + Text -->
          <>
            <img
              src={logoImage}
              alt={logoAlt}
              class="h-12 w-auto max-w-[180px] object-contain"
              onerror="this.style.display='none'"
              style="opacity: 1; filter: brightness(0) invert(var(--theme-nav-invert, 1));"
            />
            <div class="flex flex-col">
                <span class="text-2xl font-bold leading-tight" style="color: var(--theme-nav-text); letter-spacing: -0.02em;">
                  {logoText}
                </span>
                {logoSubtext && (
                  <span class="text-xs leading-tight" style="color: var(--theme-nav-text); opacity: 0.6; letter-spacing: 0.05em;">
                  {logoSubtext}
                </span>
              )}
            </div>
          </>
        ) : (
          <!-- Fallback: Icon + Text Logo -->
          <>
            <div class="flex items-center justify-center w-12 h-12 rounded-lg" style="background-color: var(--theme-primary); transition: box-shadow 0.3s;">
              <svg class="w-7 h-7" style="color: var(--theme-text);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="text-2xl font-bold leading-tight" style="color: var(--theme-nav-text); letter-spacing: -0.02em;">
                {logoText}
              </span>
              {logoSubtext && (
                <span class="text-xs leading-tight" style="color: var(--theme-nav-text); opacity: 0.6; letter-spacing: 0.05em;">
                  {logoSubtext}
                </span>
              )}
            </div>
          </>
        )}
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex lg:items-center lg:space-x-1">
      {NAVIGATION.map((item: NavItem) => {
        const isActive = isActiveLink(item.href);
        const hasChildren = item.children && item.children.length > 0;
        return (
        <div class="relative group">
          <a
            href={localizePath(item.href, currentLang)}
            class={`px-4 py-2 text-sm font-medium rounded-lg transition-all relative flex items-center gap-1 ${
              isActive 
                ? 'nav-active' 
                : ''  
            }`}
            style={{
              color: isActive ? 'var(--theme-primary)' : 'var(--theme-text)',
              opacity: isActive ? 1 : 0.65,
            }}
            onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'"
            onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.65'"
          >
            {t(navKeyByHref[item.href] || 'nav.home')}
            {hasChildren && (
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            )}
          </a>
          {hasChildren && (
            <!-- Dropdown -->
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto">
              {item.children!.length === 1 ? (
                <!-- Single-column dropdown: horizontal row layout -->
                <div class="p-8 rounded-xl shadow-2xl border" style="background-color: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); min-width: 500px; max-width: 900px;">
                  <h3 class="text-sm font-bold tracking-wide uppercase mb-5" style="color: var(--theme-primary); letter-spacing: 0.05em;">
                    {t(getHeadingKey(item.href, item.children![0].heading))}
                  </h3>
                  <div class="flex flex-wrap gap-x-5 gap-y-3">
                    {item.children![0].items.map((child) => (
                      <a
                        href={localizePath(child.href, currentLang)}
                        class="text-sm py-2 px-3 rounded-lg transition-all whitespace-nowrap border"
                        style="color: var(--theme-text); opacity: 0.7; border-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);"
                        onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'; this.style.borderColor='var(--theme-primary)'; this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 8%, transparent)'"
                        onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.7'; this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.backgroundColor='transparent'"
                      >
                        {t(childNavKeyByHref[child.href] || child.name)}
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <!-- Multi-column dropdown: 3-column horizontal layout -->
                <div class="p-8 rounded-xl shadow-2xl border" style="background-color: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); min-width: 950px; max-width: 1200px;">
                  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px;">
                    {item.children!.map((column) => (
                      <div class="flex flex-col gap-3">
                        <h3 class="text-sm font-bold tracking-wide uppercase" style="color: var(--theme-primary); letter-spacing: 0.05em;">
                          {t(getHeadingKey(item.href, column.heading))}
                        </h3>
                        <ul class="flex flex-col gap-1.5">
                          {column.items.map((child) => (
                            <li>
                              <a
                                href={localizePath(child.href, currentLang)}
                                class="block text-sm py-1.5 rounded transition-all hover:translate-x-0.5"
                                style="color: var(--theme-text); opacity: 0.7;"
                                onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'"
                                onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.7'"
                              >
                                {t(childNavKeyByHref[child.href] || child.name)}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}
        </div>
      );
      })}
    </div>

    <!-- Language Picker + CTA Button -->
    <div class="hidden lg:flex lg:items-center lg:space-x-4">
      <LanguageSelector />
      <a
        href="https://www.bozemetal.com/contact" target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center px-6 py-2.5 text-sm font-semibold rounded-lg shadow-md transition-all"
        style="background-color: var(--theme-primary); color: var(--theme-text);"
        onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 80%, black)'; this.style.boxShadow='0 0 20px color-mix(in srgb, var(--theme-primary) 50%, transparent)'"
        onmouseout="this.style.backgroundColor='var(--theme-primary)'; this.style.boxShadow=''"
      >
        {t('hero.cta')}
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <MobileMenu client:idle />
  </nav>
</header>
