---
// MedicalCtaSection.astro
// Conversion CTA for medical device DFM analysis and RFQ submission
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 100%, var(--theme-primary) 0%, transparent 70%);"></div>
  </div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center px-4 py-2 mb-6 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
        Start Your Medical Device Project
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Ready for ISO 13485 Certified<br/>
        <span style="color: var(--theme-primary);">Medical Titanium CNC Machining?</span>
      </h2>
      <p class="text-lg leading-relaxed mb-10 max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        Submit your implant or instrument design files for a complimentary Design for Manufacturability (DFM) review. Our engineering team will evaluate your bone screw, orthopedic implant, or surgical instrument requirements and respond with a competitive quote within 24 hours.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 mb-10">
        <span class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg" style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 20%, transparent); color: color-mix(in srgb, var(--theme-text) 80%, transparent);">
          <svg class="w-4 h-4 mr-2" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          ISO 13485:2016 Certified
        </span>
        <span class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg" style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 20%, transparent); color: color-mix(in srgb, var(--theme-text) 80%, transparent);">
          <svg class="w-4 h-4 mr-2" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          Grade 23 ELI Titanium
        </span>
        <span class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg" style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 20%, transparent); color: color-mix(in srgb, var(--theme-text) 80%, transparent);">
          <svg class="w-4 h-4 mr-2" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          Swiss CNC Turning
        </span>
        <span class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg" style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 20%, transparent); color: color-mix(in srgb, var(--theme-text) 80%, transparent);">
          <svg class="w-4 h-4 mr-2" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          Zero-Contamination
        </span>
      </div>
      <a
        href="https://www.bozemetal.com/contact" target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-xl transition-all duration-300 hover:scale-105"
        style="background-color: var(--theme-primary); color: #ffffff; box-shadow: 0 4px 24px color-mix(in srgb, var(--theme-primary) 35%, transparent);"
        onmouseover="this.style.boxShadow='0 8px 40px color-mix(in srgb, var(--theme-primary) 50%, transparent)'"
        onmouseout="this.style.boxShadow='0 4px 24px color-mix(in srgb, var(--theme-primary) 35%, transparent)'"
      >
        Request Medical DFM Analysis &amp; Quote
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
      </a>
      <p class="mt-6 text-sm" style="color: color-mix(in srgb, var(--theme-text) 40%, transparent);">
        Engineering response within 24 hours · CAD models accepted in STEP, IGES, STL formats
      </p>
    </div>
  </div>
</section>
