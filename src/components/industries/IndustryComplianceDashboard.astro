---
interface ComplianceArea {
  title: string;
  standards: string[];
  description: string;
  details: string[];
  highlightColor: string;
  prefix: string;
}

const areas: ComplianceArea[] = [
  {
    title: "Aerospace & UAV",
    standards: ["AS9100D", "Nadcap", "AMS 4928"],
    description: "Full AS9100D quality management system with Nadcap-accredited special processes. Every aerospace component is manufactured under controlled lot traceability with first-article inspection reports (FAIR) per AS9102.",
    details: [
      "AS9100D certified quality management system — fully audited",
      "Nadcap accreditation for NDT, heat treat, and chemical processing",
      "AMS 4928 / AMS 4911 material compliance for titanium grades",
      "First-article inspection (FAIR) reports per AS9102 standard",
      "Counterfeit parts prevention per AS6174/AS5553 protocols",
    ],
    highlightColor: "#3b82f6",
    prefix: "area0",
  },
  {
    title: "Medical",
    standards: ["ASTM F136", "ISO 13485", "ISO 10993"],
    description: "Strict material chemistry control per ASTM F136 for Grade 23 ELI implantable-grade titanium. Our processes are validated for bio-compatibility and cleanroom readiness, supporting Class II and Class III device manufacturing.",
    details: [
      "ASTM F136 / F67 certified material sourcing for implantable grades",
      "ISO 13485 quality system compliance for medical devices",
      "ISO 10993 bio-compatibility testing readiness documentation",
      "Validated cleaning protocols for implantable component finishing",
      "Full material traceability with EN 10204 Type 3.1 MTRs",
    ],
    highlightColor: "#10b981",
    prefix: "area1",
  },
  {
    title: "Semiconductor & AI Hardware",
    standards: ["Ra 0.4 µm", "UHV Compatible", "ISO 14644-1"],
    description: "Surface engineering down to Ra 0.4 µm micro-finish with zero-outgassing protocols for ultra-high vacuum (UHV) environments. Cleanroom assembly and packaging per ISO 14644-1 Class 7 standards.",
    details: [
      "Surface finish capability to Ra 0.4 µm and below on titanium",
      "UHV-compatible processing with < 1×10⁻⁹ Torr outgassing",
      "Electropolishing & passivation for particle-free surfaces",
      "ISO 14644-1 Class 7 cleanroom assembly & packaging",
      "Nickel-free surface cert for EU RoHS/WEEE compliance",
    ],
    highlightColor: "#a855f7",
    prefix: "area2",
  },
];
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Subtle grid -->
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: color-mix(in srgb, var(--theme-primary) 70%, white);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        {t('industries.industrycompliancedashboard.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('industries.industrycompliancedashboard.title')} <span class="gradient-text-accent">{t('industries.industrycompliancedashboard.dashboard')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t('industries.industrycompliancedashboard.description')}
      </p>
    </div>

    <!-- Compliance Areas -->
    <div class="space-y-8 max-w-6xl mx-auto">
      {areas.map((area) => (
        <div
          class="group relative rounded-xl p-8 transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent); border-left: 3px solid {area.highlightColor};"
          onmouseover="this.style.borderColor='{area.highlightColor}'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
        >
          <div class="flex flex-col lg:flex-row lg:items-start gap-6">
            {/* Left: Title & Standards */}
            <div class="lg:w-1/3 shrink-0">
              <h3 class="text-2xl font-bold mb-3" style="color: var(--theme-text);">{t(`industries.industrycompliancedashboard.${area.prefix}_name`)}</h3>
              <div class="flex flex-wrap gap-2">
                {area.standards.map((std) => (
                  <span
                    class="inline-flex items-center px-3 py-1.5 text-xs font-bold rounded-md"
                    style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent); color: color-mix(in srgb, var(--theme-primary) 70%, white); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
                  >
                    {std}
                  </span>
                ))}
              </div>
            </div>

            {/* Right: Description & Details */}
            <div class="flex-1">
              <p class="text-sm leading-relaxed mb-5" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                {t(`industries.industrycompliancedashboard.${area.prefix}_desc`)}
              </p>
              <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
                {area.details.map((detail, i) => (
                  <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
                    <svg class="w-4 h-4 mt-0.5 mr-3 shrink-0" style="color: {area.highlightColor};" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
                    </svg>
                    {t(`industries.industrycompliancedashboard.${area.prefix}_detail${i}`)}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Note -->
    <div class="text-center mt-8">
      <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
        {t('industries.industrycompliancedashboard.note')}
      </p>
    </div>
  </div>
</section>