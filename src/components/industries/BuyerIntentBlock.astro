---
// BuyerIntentBlock.astro
// Reusable Buyer-Intent template for industry pages.
// Structure: Why Titanium → Typical Components → Manufacturing Capability → Quality Requirements → Related Cases → CTA.
// This is an additive enhancement block — no rewriting of existing industry sections.
interface Props {
  industry?: string;
  whyTitanium?: string[];
  typicalComponents?: string[];
  manufacturing?: string[];
  qualityRequirements?: string[];
  caseStudyLinks?: { label: string; href: string }[];
  ctaHref?: string;
  /** Set to false to hide the block's internal CTA (when the page already has its own CTA section). */
  showCta?: boolean;
}
const {
  industry = 'Titanium Components',
  whyTitanium = [],
  typicalComponents = [],
  manufacturing = [],
  qualityRequirements = [],
  caseStudyLinks = [],
  ctaHref = '/rfq/',
  showCta = true,
} = Astro.props;
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-surface);" aria-label={`Buyer information for ${industry} titanium components`}>
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        Buyer Information
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {industry} Titanium Components — <span class="gradient-text-accent">Procurement Overview</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        Everything a {industry} engineering buyer needs to evaluate us in one place: materials, components, manufacturing capability, and quality compliance.
      </p>
    </div>

    <div class="max-w-6xl mx-auto space-y-6">
      <!-- Row 1: Why Titanium + Typical Components -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <article class="rounded-2xl border p-6 lg:p-8" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
          <div class="flex items-center mb-5">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl mr-4" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
            </span>
            <h3 class="text-xl font-bold" style="color: var(--theme-text);">Why Titanium for {industry}</h3>
          </div>
          <ul class="space-y-3">
            {whyTitanium.map((item) => (
              <li class="flex items-start text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </article>

        <article class="rounded-2xl border p-6 lg:p-8" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
          <div class="flex items-center mb-5">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl mr-4" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </span>
            <h3 class="text-xl font-bold" style="color: var(--theme-text);">Typical {industry} Titanium Components</h3>
          </div>
          <ul class="space-y-3">
            {typicalComponents.map((item) => (
              <li class="flex items-start text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </article>
      </div>


      <!-- Row 2: Manufacturing Capability + Quality Requirements -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <article class="rounded-2xl border p-6 lg:p-8" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
          <div class="flex items-center mb-5">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl mr-4" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /></svg>
            </span>
            <h3 class="text-xl font-bold" style="color: var(--theme-text);">Manufacturing Capability</h3>
          </div>
          <ul class="space-y-3">
            {manufacturing.map((item) => (
              <li class="flex items-start text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="/capabilities/manufacturing/" class="inline-flex items-center mt-6 text-sm font-semibold transition-colors hover:underline" style="color: var(--theme-primary);">
            View full manufacturing capability matrix →
          </a>
        </article>

        <article class="rounded-2xl border p-6 lg:p-8" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
          <div class="flex items-center mb-5">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl mr-4" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary);">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </span>
            <h3 class="text-xl font-bold" style="color: var(--theme-text);">Quality Requirements</h3>
          </div>
          <ul class="space-y-3">
            {qualityRequirements.map((item) => (
              <li class="flex items-start text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="/capabilities/inspection/" class="inline-flex items-center mt-6 text-sm font-semibold transition-colors hover:underline" style="color: var(--theme-primary);">
            View inspection & testing capabilities →
          </a>
        </article>
      </div>

      <!-- Row 3: Related Evidence + CTA -->
      {
        caseStudyLinks.length > 0 && (
          <div class="rounded-2xl border p-6 lg:p-8" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-accent) 20%, transparent);">
            <div class="flex items-center mb-5">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl mr-4" style="background: color-mix(in srgb, var(--theme-accent) 12%, transparent); color: var(--theme-accent);">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
              </span>
              <h3 class="text-xl font-bold" style="color: var(--theme-text);">Related Manufacturing Evidence</h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {caseStudyLinks.map((link) => (
                <a href={link.href} class="group rounded-xl border p-4 transition-all duration-300 hover:-translate-y-0.5" style="border-color: color-mix(in srgb, var(--theme-accent) 25%, transparent);">
                  <p class="text-sm font-semibold leading-snug group-hover:underline" style="color: var(--theme-text);">{link.label}</p>
                  <span class="mt-2 inline-block text-xs font-semibold" style="color: var(--theme-accent);">Read evidence →</span>
                </a>
              ))}
            </div>
          </div>
        )
      }

      <!-- CTA -->
      {
        showCta && (
          <div class="rounded-2xl p-8 lg:p-10 text-center" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 12%, transparent), color-mix(in srgb, var(--theme-primary) 4%, transparent)); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);">
            <h3 class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--theme-text);">Need a {industry} Titanium Component Quoted?</h3>
            <p class="text-base md:text-lg mb-6 max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
              Send us your drawing and material specification. Our engineers respond with a DFM review, tolerance assessment, and quote within 48 hours.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href={ctaHref} class="inline-flex items-center justify-center px-8 py-4 font-bold rounded-xl shadow-2xl hover:shadow-3xl transition-all" style="background: var(--theme-primary); color: var(--theme-bg);">
                Request a {industry} Titanium Quote
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
              </a>
              <a href="/case-studies/" class="inline-flex items-center justify-center px-8 py-4 font-bold rounded-xl transition-all" style="border: 2px solid color-mix(in srgb, var(--theme-text) 30%, transparent); color: var(--theme-text);">
                Browse Manufacturing Evidence
              </a>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
