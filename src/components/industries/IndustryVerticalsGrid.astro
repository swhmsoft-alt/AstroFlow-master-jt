    painPoint: "Bio-compatibility per ISO 10993 & strict ASTM F136 chemistry control",
  },
  {
    name: "UAV & Drones",
    iconPath: "M9 3.75H6.912a2.25 2.25 0 00-2.15 1.588L2.35 13.177a2.25 2.25 0 00-.1.661V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 00-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 012.012 1.244l.256.512a2.25 2.25 0 002.013 1.244h3.218a2.25 2.25 0 002.013-1.244l.256-.512a2.25 2.25 0 012.013-1.244h3.859",
    components: ["Lightweight Airframe Structures", "Motor Mounts & Arm Assemblies", "Gimbal Housings & Camera Mounts", "Propulsion System Components"],
