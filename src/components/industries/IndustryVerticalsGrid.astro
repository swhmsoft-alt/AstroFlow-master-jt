    components: ["High-Pressure Pump Housings", "Custom Valve Bodies & Seats", "Hydraulic Cylinder Components", "Wear-Resistant Liners & Bushings"],
    painPoint: "Wear resistance & dimensional stability under high-pressure cycling",
  },
];
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Subtle engineering grid -->
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: color-mix(in srgb, var(--theme-primary) 70%, white);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
        Target Verticals
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Industry <span class="gradient-text-accent">Verticals</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Eight specialized sectors where our titanium engineering expertise delivers measurable performance advantages.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 max-w-7xl mx-auto">
      {industries.map((industry) => (
        <div
          class="group relative rounded-xl p-6 transition-all duration-300 flex flex-col h-full"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
          onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 8%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
        >
          {/* Header */}
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
                <svg class="w-5 h-5" fill="none" stroke="color-mix(in srgb, var(--theme-primary) 70%, white)" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={industry.iconPath} />
                </svg>
              </div>
              <h3 class="text-lg font-bold" style="color: var(--theme-text);">{industry.name}</h3>
            </div>
          </div>

          <!-- Typical Components -->
          <div class="mb-4 flex-1">
            <h4 class="text-xs font-semibold uppercase tracking-wider mb-2.5" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              Typical Components Engineered
            </h4>
            <ul class="space-y-1.5">
              {industry.components.map((comp) => (
                <li class="flex items-start text-xs" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                  <svg class="w-3 h-3 mt-0.5 mr-2 shrink-0" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  {comp}
                </li>
              ))}
            </ul>
          </div>

          <!-- Pain Point -->
          <div class="pt-4 mt-auto" style="border-top: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <h4 class="text-xs font-semibold uppercase tracking-wider mb-1.5" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              Pain Point Solved
            </h4>
            <p class="text-xs leading-relaxed" style="color: color-mix(in srgb, var(--theme-primary) 70%, white);">
              {industry.painPoint}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
