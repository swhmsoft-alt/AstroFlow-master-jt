    components: ["Structural Airframe Components", "Turbine Engine Parts & Blades", "Landing Gear Assemblies", "Fasteners & Hydraulic Fittings"],
    painPoint: "Fatigue resistance & stress-corrosion cracking under cyclic loading",
  },
  {
    name: "Medical",
    iconPath: "M4.26 10.147a60.438 60.438 0 0112.367-3.23 8.212 8.212 0 018.147 6.886 1 1 0 01-.965 1.147H2.942a1 1 0 01-.965-1.147 8.14 8.14 0 012.283-3.656z",
