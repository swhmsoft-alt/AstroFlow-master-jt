---
import { NAVIGATION, SOCIAL_LINKS, SITE } from '@config/site';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

// Static site identity (previously loaded from CMS collection 'general')
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// ── Navigation translation key mappings ────────────────────
const navKeyByHref: Record<string, string> = {
  '/': 'nav.home',
  '/services': 'nav.services',
  '/materials': 'nav.materials',
  '/capabilities': 'nav.capabilities',
  '/industries': 'nav.industries',
  '/resources': 'nav.resources',
  '/products': 'nav.products',
};

const logoImage = '/uploads/boze-cnc-ti-ico.png';
const logoAlt = 'Site Logo';
const logoText = 'BOZE CNC Ti';
const logoSubtext = t('header.logoSubtext');
const siteName = SITE.title;
const siteDescription = SITE.description;
---

<footer style="background-color: var(--theme-bg); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
  <div class="container mx-auto px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-5">
      <!-- Company Info -->
      <div class="lg:col-span-1 space-y-6">
        <a href={localizePath('/', currentLang)} class="flex items-center space-x-3 group">
          {logoImage ? (
            <!-- CMS-managed Logo Image -->
            <img
              src={logoImage}
              alt={logoAlt}
              class="h-10 w-auto max-w-[180px] object-contain"
              style="filter: brightness(0) invert(var(--theme-nav-invert, 1));"
            />
          ) : (
            <!-- Fallback: Icon + Text Logo -->
            <>
              <div class="flex items-center justify-center w-12 h-12 rounded-lg" style="background-color: var(--theme-primary);">
                <svg class="w-7 h-7" style="color: var(--theme-text);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-2xl font-bold leading-tight" style="color: var(--theme-text);">
                  {logoText}
                </span>
                {logoSubtext && (
                  <span class="text-xs leading-tight" style="color: var(--theme-text); opacity: 0.55; letter-spacing: 0.05em;">
                    {logoSubtext}
                  </span>
                )}
              </div>
            </>
          )}
        </a>
        <p class="text-sm leading-relaxed max-w-xs" style="color: var(--theme-text); opacity: 0.55;">
          {t('footer.description')}
        </p>
        <div class="flex space-x-4">
          <a
            href={SOCIAL_LINKS.linkedin}
            class="w-10 h-10 flex items-center justify-center rounded-lg transition-all"
            style="background-color: var(--theme-surface); color: var(--theme-text); opacity: 0.55;"
            onmouseover="this.style.backgroundColor='var(--theme-primary)'; this.style.color='var(--theme-text)'; this.style.opacity='1'"
            onmouseout="this.style.backgroundColor='var(--theme-surface)'; this.style.color='var(--theme-text)'; this.style.opacity='0.55'"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
          
          <a
            href={SOCIAL_LINKS.facebook}
            class="w-10 h-10 flex items-center justify-center rounded-lg transition-all"
            style="background-color: var(--theme-surface); color: var(--theme-text); opacity: 0.55;"
            onmouseover="this.style.backgroundColor='var(--theme-primary)'; this.style.color='var(--theme-text)'; this.style.opacity='1'"
            onmouseout="this.style.backgroundColor='var(--theme-surface)'; this.style.color='var(--theme-text)'; this.style.opacity='0.55'"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>
          <a
            href={SOCIAL_LINKS.instagram}
            class="w-10 h-10 flex items-center justify-center rounded-lg transition-all"
            style="background-color: var(--theme-surface); color: var(--theme-text); opacity: 0.55;"
            onmouseover="this.style.backgroundColor='var(--theme-primary)'; this.style.color='var(--theme-text)'; this.style.opacity='1'"
            onmouseout="this.style.backgroundColor='var(--theme-surface)'; this.style.color='var(--theme-text)'; this.style.opacity='0.55'"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href={SOCIAL_LINKS.youtube}
            class="w-10 h-10 flex items-center justify-center rounded-lg transition-all"
            style="background-color: var(--theme-surface); color: var(--theme-text); opacity: 0.55;"
            onmouseover="this.style.backgroundColor='var(--theme-primary)'; this.style.color='var(--theme-text)'; this.style.opacity='1'"
            onmouseout="this.style.backgroundColor='var(--theme-surface)'; this.style.color='var(--theme-text)'; this.style.opacity='0.55'"
            aria-label="YouTube"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--theme-text);">
          {t('footer.quickLinks')}
        </h3>
        <ul class="space-y-3">
          {NAVIGATION.map((item) => (
            <li>
              <a
                href={localizePath(item.href, currentLang)}
                class="text-sm inline-flex items-center group transition-colors"
                style="color: var(--theme-text); opacity: 0.55;"
                onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'"
                onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.55'"
              >
                <span class="w-0 group-hover:w-2 h-0.5 transition-all mr-0 group-hover:mr-2" style="background-color: var(--theme-primary);"></span>
                {t(navKeyByHref[item.href] || 'nav.home')}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--theme-text);">
          {t('footer.services')}
        </h3>
        <ul class="space-y-3">
          <li>
            <a href={localizePath('/services', currentLang)} class="text-sm inline-flex items-center group transition-colors" style="color: var(--theme-text); opacity: 0.55;" onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'" onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.55'">
              <span class="w-0 group-hover:w-2 h-0.5 transition-all mr-0 group-hover:mr-2" style="background-color: var(--theme-primary);"></span>
              {t('footer.services.cncMachining')}
            </a>
          </li>
          <li>
            <a href={localizePath('/titanium-additive-manufacturing', currentLang)} class="text-sm inline-flex items-center group transition-colors" style="color: var(--theme-text); opacity: 0.55;" onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'" onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.55'">
              <span class="w-0 group-hover:w-2 h-0.5 transition-all mr-0 group-hover:mr-2" style="background-color: var(--theme-primary);"></span>
              {t('footer.services.additiveManufacturing')}
            </a>
          </li>
          <li>
            <a href={localizePath('/titanium-fabrication-services', currentLang)} class="text-sm inline-flex items-center group transition-colors" style="color: var(--theme-text); opacity: 0.55;" onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'" onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.55'">
              <span class="w-0 group-hover:w-2 h-0.5 transition-all mr-0 group-hover:mr-2" style="background-color: var(--theme-primary);"></span>
              {t('footer.services.fabrication')}
            </a>
          </li>
          <li>
            <a href={localizePath('/titanium-surface-treatment', currentLang)} class="text-sm inline-flex items-center group transition-colors" style="color: var(--theme-text); opacity: 0.55;" onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'" onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.55'">
              <span class="w-0 group-hover:w-2 h-0.5 transition-all mr-0 group-hover:mr-2" style="background-color: var(--theme-primary);"></span>
              {t('footer.services.surfaceTreatment')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--theme-text);">
          {t('footer.getStarted')}
        </h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={localizePath('/about', currentLang)} class="inline-flex items-center group transition-colors" style="color: var(--theme-text); opacity: 0.55;" onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'" onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.55'">
              <span class="w-0 group-hover:w-2 h-0.5 transition-all mr-0 group-hover:mr-2" style="background-color: var(--theme-primary);"></span>
              {t('footer.aboutUs')}
            </a>
          </li>
          <li>
            <a href="https://www.bozemetal.com/contact" target="_blank" rel="noopener noreferrer" class="inline-flex items-center group transition-colors" style="color: var(--theme-text); opacity: 0.55;" onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'" onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.55'">
              <span class="w-0 group-hover:w-2 h-0.5 transition-all mr-0 group-hover:mr-2" style="background-color: var(--theme-primary);"></span>
              {t('footer.requestQuote')}
            </a>
          </li>
        </ul>
        
        <div class="mt-8">
          <a
            href="https://www.bozemetal.com/contact" target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 text-sm font-semibold rounded-lg shadow-lg transition-all"
            style="background-color: var(--theme-primary); color: var(--theme-text);"
            onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 80%, black)'; this.style.boxShadow='0 0 20px color-mix(in srgb, var(--theme-primary) 50%, transparent)'"
            onmouseout="this.style.backgroundColor='var(--theme-primary)'; this.style.boxShadow=''"
          >
            {t('footer.getStartedBtn')}
          </a>
        </div>
      </div>

      <!-- Contact Us -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-6" style="color: var(--theme-text);">
          {t('footer.contactUs')}
        </h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start" style="color: var(--theme-text); opacity: 0.55;">
            <span>{t('footer.tel')}</span>
          </li>
          <li class="flex items-start" style="color: var(--theme-text); opacity: 0.55;">
            <span>{t('footer.phone')}</span>
          </li>
          <li class="flex items-start" style="color: var(--theme-text); opacity: 0.55;">
            <span>{t('footer.whatsapp')}</span>
          </li>
          <li class="flex items-start" style="color: var(--theme-text); opacity: 0.55;">
            <a href="mailto:info@bozemetal.com" class="hover:opacity-100 transition-opacity" style="color: var(--theme-text);">
              {t('footer.email')}
            </a>
          </li>
          <li class="flex items-start" style="color: var(--theme-text); opacity: 0.55;">
            <span class="text-xs leading-relaxed">{t('footer.address')}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8" style="border-top: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
      <div class="flex flex-col md:flex-row items-center justify-between space-y-4 md:space-y-0">
        <p class="text-sm" style="color: var(--theme-text); opacity: 0.55;">
          &copy; {new Date().getFullYear()} {siteName}. {t('footer.allRights')}
        </p>
        <div class="flex items-center space-x-6 text-sm">
          <a href={localizePath('/privacy-policy/', currentLang)} class="transition-colors" style="color: var(--theme-text); opacity: 0.55;" onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'" onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.55'">
            {t('footer.privacyPolicy')}
          </a>
          <span style="color: var(--theme-text); opacity: 0.3;">•</span>
          <a href={localizePath('/terms-of-service/', currentLang)} class="transition-colors" style="color: var(--theme-text); opacity: 0.55;" onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'" onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.55'">
            {t('footer.termsOfService')}
          </a>
          <span style="color: var(--theme-text); opacity: 0.3;">•</span>
          <a href={localizePath('/cookie-policy/', currentLang)} class="transition-colors" style="color: var(--theme-text); opacity: 0.55;" onmouseover="this.style.color='var(--theme-primary)'; this.style.opacity='1'" onmouseout="this.style.color='var(--theme-text)'; this.style.opacity='0.55'">
            {t('footer.cookiePolicy')}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
