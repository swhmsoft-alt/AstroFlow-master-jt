---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface Capability {
  label: string;
  value: string;
  subtext: string;
  iconPath: string;
  accent: string;
}

const capabilities: Capability[] = [
  {
    label: t('home.tech.cap0.label'),
    value: "±0.005 mm",
    subtext: t('home.tech.cap0.subtext'),
    iconPath: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    accent: "var(--theme-primary)"
  },
  {
    label: t('home.tech.cap1.label'),
    value: "3 / 4 / 5-Axis",
    subtext: t('home.tech.cap1.subtext'),
    iconPath: "M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4",
    accent: "#14b8a6"
  },
  {
    label: t('home.tech.cap2.label'),
    value: "AS9100 & ISO 9001",
    subtext: t('home.tech.cap2.subtext'),
    iconPath: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    accent: "var(--theme-primary)"
  },
  {
    label: t('home.tech.cap3.label'),
    value: "CMM & OES Testing",
    subtext: t('home.tech.cap3.subtext'),
    iconPath: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
    accent: "#14b8a6"
  }
];
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Industrial diagonal line pattern -->
  <div class="absolute inset-0 opacity-[0.02]">
    <div class="absolute inset-0" style="background-image: repeating-linear-gradient(45deg, var(--theme-primary), var(--theme-primary) 1px, transparent 1px, transparent 30px);"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        {t('home.tech.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('home.tech.titlePrefix')} <span class="gradient-text-accent">{t('home.tech.title')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('home.tech.subtitle')}
      </p>
    </div>

    <!-- Capabilities Dashboard Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {capabilities.map((cap) => (
        <div
          class="relative rounded-xl p-8 transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
          onmouseover="this.style.borderColor=cap.accent; this.style.boxShadow='0 0 40px color-mix(in srgb, var(--theme-primary) 8%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
        >
          <div class="flex items-start justify-between mb-4">
            <div>
              <div class="text-sm font-semibold mb-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{cap.label}</div>
              <div class="text-3xl md:text-4xl font-bold" style="color: var(--theme-text);">
                {cap.value.split(' ').map((word, i) => (
                  i === 0
                    ? <span class="gradient-text-accent">{word}</span>
                    : <span>{' ' + word}</span>
                ))}
              </div>
            </div>
            <div class="w-12 h-12 rounded-lg flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));">
              <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={cap.iconPath} />
              </svg>
            </div>
          </div>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{cap.subtext}</p>

          <!-- Bottom accent bar -->
          <div class="absolute bottom-0 left-0 right-0 h-0.5 rounded-full" style="background: linear-gradient(90deg, var(--theme-primary), #14b8a6); transform: scaleX(0); transition: transform 0.3s;" onmouseover="this.style.transform='scaleX(1)'" onmouseout="this.style.transform='scaleX(0)'"></div>
        </div>
      ))}
    </div>

    <!-- Detail footer -->
    <div class="mt-12 max-w-4xl mx-auto">
      <div class="flex flex-wrap items-center justify-center gap-4 p-6 rounded-xl" style="background-color: color-mix(in srgb, var(--theme-surface) 60%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <span class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('home.tech.compliance')}</span>
        <span class="text-sm font-semibold" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{t('home.technicalcapabilities.as9100d')}</span>
        <span class="w-1 h-1 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);"></span>
        <span class="text-sm font-semibold" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{t('home.technicalcapabilities.iso_90012015')}</span>
        <span class="w-1 h-1 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);"></span>
        <span class="text-sm font-semibold" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{t('home.technicalcapabilities.milspec')}</span>
        <span class="w-1 h-1 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);"></span>
        <span class="text-sm font-semibold" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{t('home.technicalcapabilities.ams_4928')}</span>
        <span class="w-1 h-1 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);"></span>
        <span class="text-sm font-semibold" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{t('home.technicalcapabilities.astm_b348')}</span>
      </div>
    </div>
  </div>
</section>
