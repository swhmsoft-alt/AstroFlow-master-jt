---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface CapabilityCard {
  href: string;
  icon: string;
  title: string;
  desc: string;
  tag: string;
}

const cards: CapabilityCard[] = [
  {
    href: '/titanium-fabrication-services/',
    icon: "M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25z",
    title: t('home.specializedCapabilities.card1.title') || "Titanium Pipe Spool Fabrication",
    desc: t('home.specializedCapabilities.card1.desc') || "Isometric spool assemblies, orbital TIG welding and hydrostatic testing of Ti pipe systems for aerospace, marine and process industries.",
    tag: t('home.specializedCapabilities.card1.tag') || "Spool Builds",
  },
  {
    href: '/titanium-cnc-machining-services/wire-edm-machining/',
    icon: "M9 9l6 6m0-6l-6 6M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    title: t('home.specializedCapabilities.card2.title') || "EDM Broaching",
    desc: t('home.specializedCapabilities.card2.desc') || "Square, hex and splined forms cut by wire EDM with a single setup — no pre-machined pilot holes, no tooling wear, ±0.005 mm repeatability.",
    tag: t('home.specializedCapabilities.card2.tag') || "Wire EDM",
  },
  {
    href: '/titanium-cnc-machining-services/wire-edm-machining/',
    icon: "M12 21a9 9 0 100-18 9 9 0 000 18zm0-9a3 3 0 100-6 3 3 0 000 6z",
    title: t('home.specializedCapabilities.card3.title') || "Sinker EDM",
    desc: t('home.specializedCapabilities.card3.desc') || "3D contoured cavities, blind pockets and internal geometries in hardened titanium via ram EDM with graphite and copper-tungsten electrodes.",
    tag: t('home.specializedCapabilities.card3.tag') || "Ram EDM",
  },
  {
    href: '/laser-marking-custom-logo/',
    icon: "M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z",
    title: t('home.specializedCapabilities.card4.title') || "Laser Marking & Traceability",
    desc: t('home.specializedCapabilities.card4.desc') || "Permanent serialization, UDI and logos via fiber laser — full part traceability from material lot to finished component.",
    tag: t('home.specializedCapabilities.card4.tag') || "Serialization",
  },
];
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-surface);">
  <div class="absolute inset-0 opacity-[0.02]">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, var(--theme-primary) 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" /></svg>
        {t('home.specializedCapabilities.badge') || "Specialized Capabilities"}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('home.specializedCapabilities.title_prefix') || "Niche Titanium"} <span style="color: var(--theme-primary);">{t('home.specializedCapabilities.title_highlight') || "Specializations"}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
        {t('home.specializedCapabilities.subtitle') || "Beyond conventional milling — advanced, high-value processes engineered for the most demanding titanium components."}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {cards.map((card) => (
        <a
          href={localizePath(card.href, lang)}
          class="group relative flex flex-col rounded-xl overflow-hidden p-8 transition-all duration-300 hover:-translate-y-1"
          style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
        >
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-6" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
            <svg class="w-6 h-6" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={card.icon} /></svg>
          </div>
          <span class="text-xs font-semibold uppercase tracking-widest mb-2" style="color: var(--theme-primary);">{card.tag}</span>
          <h3 class="text-lg font-bold mb-3" style="color: var(--theme-text);">{card.title}</h3>
          <p class="text-sm leading-relaxed flex-1" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{card.desc}</p>
          <span class="inline-flex items-center mt-6 text-sm font-semibold transition-all group-hover:translate-x-1" style="color: var(--theme-primary);">
            {t('home.specializedCapabilities.explore') || "Explore"}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
