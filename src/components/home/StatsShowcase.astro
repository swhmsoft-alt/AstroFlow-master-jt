---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Img from '@components/ui/Image.astro';
import AnimatedStats from '../react/AnimatedStats';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="relative py-24 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <Img 
      src={undefined}
      alt={t('home.statsshowcase.global_titanium_cnc_machining_network')}
      class="w-full h-full object-cover"
      widths={[480,768,1024,1600,2070]}
      sizes="100vw"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, color-mix(in srgb, var(--theme-bg) 95%, transparent) 0%, color-mix(in srgb, var(--theme-bg) 85%, transparent) 100%);"></div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full" style="background-color: color-mix(in srgb, var(--theme-surface) 50%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent); color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t('home.statsShowcase.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('home.statsShowcase.title')} <span class="gradient-text-accent">{t('home.statsShowcase.titleHighlight')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t('home.statsShowcase.subtitle')}
      </p>
    </div>

    <AnimatedStats client:load />

    <!-- Trusted By Section -->
    <div class="mt-20">
      <p class="text-center text-sm font-semibold uppercase tracking-wider mb-8" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
        {t('home.statsShowcase.trusted')}
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="flex items-center justify-center group">
          <div class="w-36 h-20 rounded-lg flex items-center justify-center font-semibold transition-all border" style="background-color: color-mix(in srgb, var(--theme-surface) 30%, transparent); color: color-mix(in srgb, var(--theme-text) 45%, transparent); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
            CLIENT
          </div>
        </div>
        <div class="flex items-center justify-center group">
          <div class="w-36 h-20 rounded-lg flex items-center justify-center font-semibold transition-all border" style="background-color: color-mix(in srgb, var(--theme-surface) 30%, transparent); color: color-mix(in srgb, var(--theme-text) 45%, transparent); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
            CLIENT
          </div>
        </div>
        <div class="flex items-center justify-center group">
          <div class="w-36 h-20 rounded-lg flex items-center justify-center font-semibold transition-all border" style="background-color: color-mix(in srgb, var(--theme-surface) 30%, transparent); color: color-mix(in srgb, var(--theme-text) 45%, transparent); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
            CLIENT
          </div>
        </div>
        <div class="flex items-center justify-center group">
          <div class="w-36 h-20 rounded-lg flex items-center justify-center font-semibold transition-all border" style="background-color: color-mix(in srgb, var(--theme-surface) 30%, transparent); color: color-mix(in srgb, var(--theme-text) 45%, transparent); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
            CLIENT
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
