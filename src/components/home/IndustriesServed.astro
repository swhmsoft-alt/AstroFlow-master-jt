---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface Industry {
  title: string;
  description: string;
  iconGradient: string;
  iconPath: string;
  features: string[];
}

const industries: Industry[] = [
  {
    title: t('home.industriesServed.ind0.title'),
    description: t('home.industriesServed.ind0.desc'),
    iconGradient: "from-blue-500 to-blue-600",
    iconPath: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    features: [t('home.industriesServed.ind0.feat0'), t('home.industriesServed.ind0.feat1'), t('home.industriesServed.ind0.feat2')]
  },
  {
    title: t('home.industriesServed.ind1.title'),
    description: t('home.industriesServed.ind1.desc'),
    iconGradient: "from-teal-500 to-teal-600",
    iconPath: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z",
    features: [t('home.industriesServed.ind1.feat0'), t('home.industriesServed.ind1.feat1'), t('home.industriesServed.ind1.feat2')]
  },
  {
    title: t('home.industriesServed.ind2.title'),
    description: t('home.industriesServed.ind2.desc'),
    iconGradient: "from-blue-600 to-teal-600",
    iconPath: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z",
    features: [t('home.industriesServed.ind2.feat0'), t('home.industriesServed.ind2.feat1'), t('home.industriesServed.ind2.feat2')]
  },
  {
    title: t('home.industriesServed.ind3.title'),
    description: t('home.industriesServed.ind3.desc'),
    iconGradient: "from-slate-700 to-slate-800",
    iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
    features: [t('home.industriesServed.ind3.feat0'), t('home.industriesServed.ind3.feat1'), t('home.industriesServed.ind3.feat2')]
  },
  {
    title: t('home.industriesServed.ind4.title'),
    description: t('home.industriesServed.ind4.desc'),
    iconGradient: "from-orange-500 to-orange-600",
    iconPath: "M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4",
    features: [t('home.industriesServed.ind4.feat0'), t('home.industriesServed.ind4.feat1'), t('home.industriesServed.ind4.feat2')]
  },
  {
    title: t('home.industriesServed.ind5.title'),
    description: t('home.industriesServed.ind5.desc'),
    iconGradient: "from-purple-500 to-purple-600",
    iconPath: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    features: [t('home.industriesServed.ind5.feat0'), t('home.industriesServed.ind5.feat1'), t('home.industriesServed.ind5.feat2')]
  }
];

const checkmarkPath = "M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z";
---

<section>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center mb-16">
      <div class="inline-flex items-center badge-accent mb-4">
        {t('home.industriesServed.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        <span class="gradient-text-accent">{t('home.industriesServed.title')} </span>{t('home.industriesServed.titleHighlight')}
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
        {t('home.industriesServed.subtitle')}
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {industries.map((industry) => (
        <div class="card-titanium p-8 transition-all hover:border-[var(--theme-primary)] hover:shadow-[0_0_20px_color-mix(in_srgb_var(--theme-primary)_30%_transparent)] hover:-translate-y-2">
          <div class="w-16 h-16 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform" style="background: linear-gradient(135deg, var(--theme-primary), color-mix(in srgb, var(--theme-primary) 80%, black));">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--theme-text);">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={industry.iconPath} />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-3" style="color: var(--theme-text);">{industry.title}</h3>
          <p class="leading-relaxed mb-4" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            {industry.description}
          </p>
          <ul class="space-y-2 text-sm" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            {industry.features.map((feature) => (
              <li class="flex items-center">
                <svg class="w-4 h-4 mr-2" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d={checkmarkPath} clip-rule="evenodd" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <!-- Bottom CTA -->
    <div class="text-center mt-16">
      <a 
        href="/use-cases" 
        class="inline-flex items-center px-8 py-4 text-base font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all group"
        style="background-color: var(--theme-primary); color: var(--theme-text);"
        onmouseover="this.style.backgroundColor=\x27color-mix(in srgb, var(--theme-primary) 80%, black)\x27; this.style.boxShadow=\x270 0 20px color-mix(in srgb, var(--theme-primary) 40%, transparent)\x27"
        onmouseout="this.style.backgroundColor=\x27var(--theme-primary)\x27; this.style.boxShadow=\x27\x27"
      >
        {t('home.industriesServed.cta')}
        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
