---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentLang = lang;

interface Industry {
  title: string;
  subtitle: string;
  description: string;
  iconPath: string;
  href: string;
  accent: string;
}

const industries: Industry[] = [
  {
    title: t('home.industries.ind0.title'),
    subtitle: t('home.industries.ind0.subtitle'),
    description: t('home.industries.ind0.desc'),
    iconPath: "M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5",
    href: localizePath('/industries/aerospace', currentLang),
    accent: "var(--theme-primary)"
  },
  {
    title: t('home.industries.ind1.title'),
    subtitle: t('home.industries.ind1.subtitle'),
    description: t('home.industries.ind1.desc'),
    iconPath: "M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
    href: localizePath('/industries/medical', currentLang),
    accent: "var(--theme-accent)"
  },
  {
    title: t('home.industries.ind2.title'),
    subtitle: t('home.industries.ind2.subtitle'),
    description: t('home.industries.ind2.desc'),
    iconPath: "m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z",
    href: localizePath('/industries/industrial-equipment', currentLang),
    accent: "var(--theme-primary)"
  },
  {
    title: t('home.industries.ind3.title'),
    subtitle: t('home.industries.ind3.subtitle'),
    description: t('home.industries.ind3.desc'),
    iconPath: "M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5M4.5 15.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V6.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25Zm.75-12h9v9h-9v-9Z",
    href: localizePath('/industries/marine', currentLang),
    accent: "var(--theme-accent)"
  }
];
---

<style>
  .industry-card {
    background-color: var(--theme-surface);
    border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);
    transition: all 300ms;
  }
  .industry-card:hover {
    box-shadow: 0 0 30px color-mix(in srgb, var(--theme-primary) 10%, transparent);
  }
  .industry-card:hover .industry-card-title {
    color: var(--theme-primary);
  }
  .industry-card-title {
    color: var(--theme-text);
    transition: color 300ms;
  }
  .industry-icon-container {
    transition: transform 500ms;
  }
  .industry-card:hover .industry-icon-container {
    transform: scale(1.1);
  }
</style>

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
        {t('home.industries.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('home.industries.title')}
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('home.industries.subtitle')}
      </p>
    </div>

    <!-- Industry Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {industries.map((industry) => (
        <a
          href={industry.href}
          class="industry-card group relative rounded-xl overflow-hidden"
          onmouseover="this.style.borderColor=industry.accent"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'"
        >
          <div class="flex flex-col sm:flex-row sm:items-stretch">
            <!-- Icon Side -->
            <div class="flex-shrink-0 w-full sm:w-28 flex items-center justify-center py-6 sm:py-0">
              <div
                class="industry-icon-container w-14 h-14 rounded-xl flex items-center justify-center"
                style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), color-mix(in srgb, var(--theme-primary) 5%, transparent));"
              >
                <svg class="w-7 h-7" fill="none" style="stroke: var(--theme-primary);" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={industry.iconPath} />
                </svg>
              </div>
            </div>

            <!-- Content Side -->
            <div class="flex-1 p-6 pt-0 sm:pt-6">
              <div class="mb-2">
                <span class="text-xs font-semibold uppercase tracking-wider" style="color: {industry.accent};">{industry.subtitle}</span>
              </div>
              <h3 class="industry-card-title text-xl font-bold mb-3">
                {industry.title}
              </h3>
              <p class="text-sm leading-relaxed mb-4" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
                {industry.description}
              </p>
              <div class="flex items-center text-sm font-semibold transition-all" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
                <span>{t('home.industries.explore')}</span>
                <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
