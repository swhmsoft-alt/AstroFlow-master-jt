---
import Img from '@components/ui/Image.astro';
import aerospaceImg from '@assets/photo-1451187580459-43490279c0fa.jpg';
import medicalImg from '@assets/photo-1518770660439-4636190af475.jpg';
import automotiveImg from '@assets/photo-1565043589221-1a6fd9ae45c7.jpg';
import marineImg from '@assets/photo-1558618666-fcd25c85cd64.jpg';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface Industry {
  title: string;
  subtitle: string;
  description: string;
  image: any;
  href: string;
  accent: string;
}

const industries: Industry[] = [
  {
    title: t('home.industries.ind0.title'),
    subtitle: t('home.industries.ind0.subtitle'),
    description: t('home.industries.ind0.desc'),
    image: aerospaceImg,
    href: localizePath('/use-cases', currentLang),
    accent: "var(--theme-primary)"
  },
  {
    title: t('home.industries.ind1.title'),
    subtitle: t('home.industries.ind1.subtitle'),
    description: t('home.industries.ind1.desc'),
    image: medicalImg,
    href: localizePath('/use-cases', currentLang),
    accent: "var(--theme-accent)"
  },
  {
    title: t('home.industries.ind2.title'),
    subtitle: t('home.industries.ind2.subtitle'),
    description: t('home.industries.ind2.desc'),
    image: automotiveImg,
    href: localizePath('/use-cases', currentLang),
    accent: "var(--theme-primary)"
  },
  {
    title: t('home.industries.ind3.title'),
    subtitle: t('home.industries.ind3.subtitle'),
    description: t('home.industries.ind3.desc'),
    image: marineImg,
    href: localizePath('/use-cases', currentLang),
    accent: "var(--theme-accent)"
  }
];
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
        {t('home.industries.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('home.industries.title')}
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
        {t('home.industries.subtitle')}
      </p>
    </div>

    <!-- Industry Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {industries.map((industry) => (
        <a
          href={industry.href}
          class="group relative rounded-xl overflow-hidden transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
          onmouseover="this.style.borderColor=industry.accent; this.style.boxShadow='0 0 40px color-mix(in srgb, var(--theme-primary) 10%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
        >
          <div class="flex flex-col sm:flex-row">
            <!-- Image Side -->
            <div class="relative w-full sm:w-48 h-48 sm:h-auto overflow-hidden">
              <Img
                src={industry.image}
                alt={industry.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                widths={[240, 480]}
                sizes="(min-width:768px) 240px, 100vw"
              />
              <div class="absolute inset-0" style="background: linear-gradient(to right, color-mix(in srgb, var(--theme-bg) 40%, transparent) 0%, color-mix(in srgb, var(--theme-bg) 80%, transparent) 100%);"></div>
            </div>

            <!-- Content Side -->
            <div class="flex-1 p-6">
              <div class="mb-2">
                <span class="text-xs font-semibold uppercase tracking-wider" style="color: {industry.accent};">{industry.subtitle}</span>
              </div>
              <h3 class="text-xl font-bold mb-3 transition-colors" style="color: var(--theme-text);" onmouseover="this.style.color=industry.accent" onmouseout="this.style.color='var(--theme-text)'">
                {industry.title}
              </h3>
              <p class="text-sm leading-relaxed mb-4" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
                {industry.description}
              </p>
              <div class="flex items-center text-sm font-semibold transition-all" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
                <span>{t('home.industries.explore')}</span>
                <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
