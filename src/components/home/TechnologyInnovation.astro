---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Img from "@components/ui/Image.astro";

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const techDashboardImg = "https://cdn.sanity.io/images/PROJECT_ID/DATASET/tech-dashboard_v1.jpg";

interface Technology {
  title: string;
  description: string;
  iconGradient: string;
  iconPath: string;
}

const technologies: Technology[] = [
  {
    title: t('home.innovation.tech0.title'),
    description: t('home.innovation.tech0.desc'),
    iconGradient: "from-blue-500 to-blue-600",
    iconPath: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
  },
  {
    title: t('home.innovation.tech1.title'),
    description: t('home.innovation.tech1.desc'),
    iconGradient: "from-teal-500 to-teal-600",
    iconPath: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
  },
  {
    title: t('home.innovation.tech2.title'),
    description: t('home.innovation.tech2.desc'),
    iconGradient: "from-blue-500 to-blue-600",
    iconPath: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
  },
  {
    title: t('home.innovation.tech3.title'),
    description: t('home.innovation.tech3.desc'),
    iconGradient: "from-teal-500 to-teal-600",
    iconPath: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
  }
];
---

<section>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center mb-16">
      <div class="inline-flex items-center badge-accent mb-4">
        {t('home.innovation.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('home.innovation.title')} <span class="gradient-text-accent">{t('home.innovation.titleHighlight')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
        {t('home.innovation.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {technologies.map((tech) => (
        <div class="card-titanium p-8 transition-all hover:border-[var(--theme-primary)] hover:shadow-[0_0_20px_color-mix(in_srgb_var(--theme-primary)_30%_transparent)]">
          <div class="flex items-start gap-4">
            <div class="w-16 h-16 rounded-xl flex items-center justify-center flex-shrink-0" style="background: linear-gradient(135deg, var(--theme-primary), color-mix(in srgb, var(--theme-primary) 80%, black));">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--theme-text);">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tech.iconPath} />
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold mb-2" style="color: var(--theme-text);">{tech.title}</h3>
              <p class="leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{tech.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
