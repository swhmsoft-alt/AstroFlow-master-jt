---
import Img from '@components/ui/Image.astro';
import Button from '../ui/Button.astro';
import warehouseBgImg from '@assets/photo-1553413077-190dd305871c.jpg';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="relative py-32 overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0">
    <Img 
      src={warehouseBgImg}
      alt="Modern warehouse operations"
      class="w-full h-full object-cover"
      widths={[480,768,1024,1600,2070]}
      sizes="100vw"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, color-mix(in srgb, var(--theme-bg) 95%, transparent) 0%, color-mix(in srgb, var(--theme-surface) 90%, transparent) 100%);"></div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center px-4 py-2 mb-6 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        {t('home.cta.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight" style="color: var(--theme-text);">
        {t('home.cta.title')}
      </h2>
      <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t('home.cta.subtitle')}
      </p>
      
      <div class="flex flex-col sm:flex-row gap-6 justify-center mb-16">
        <a 
          href={localizePath('/rfq', currentLang)}
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold rounded-lg shadow-2xl hover:shadow-3xl transition-all group"
          style="background-color: var(--theme-primary); color: var(--theme-text);"
          onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 85%, black)'; this.style.boxShadow='0 0 25px color-mix(in srgb, var(--theme-primary) 50%, transparent)'"
          onmouseout="this.style.backgroundColor='var(--theme-primary)'; this.style.boxShadow=''"
        >
          {t('home.cta.quote')}
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a 
          href={localizePath('/facilities', currentLang)}
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold border-2 rounded-lg shadow-2xl hover:shadow-3xl transition-all group"
          style="border-color: color-mix(in srgb, var(--theme-primary) 20%, transparent); color: color-mix(in srgb, var(--theme-text) 65%, transparent);"
          onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.color='var(--theme-primary)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 20%, transparent)'; this.style.color='color-mix(in srgb, var(--theme-text) 65%, transparent)'"
        >
          {t('home.cta.tour')}
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
        <div class="rounded-xl p-6 transition-all border" style="background-color: color-mix(in srgb, var(--theme-surface) 80%, transparent); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
          <div class="text-3xl md:text-4xl font-bold mb-2 gradient-text-titanium">25+</div>
          <div class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('home.cta.years')}</div>
        </div>
        <div class="rounded-xl p-6 transition-all border" style="background-color: color-mix(in srgb, var(--theme-surface) 80%, transparent); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
          <div class="text-3xl md:text-4xl font-bold mb-2 gradient-text-titanium">ISO 9001</div>
          <div class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('home.cta.certified')}</div>
        </div>
        <div class="rounded-xl p-6 transition-all border" style="background-color: color-mix(in srgb, var(--theme-surface) 80%, transparent); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
          <div class="text-3xl md:text-4xl font-bold mb-2 gradient-text-titanium">24/7</div>
          <div class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('home.cta.support')}</div>
        </div>
        <div class="rounded-xl p-6 transition-all border" style="background-color: color-mix(in srgb, var(--theme-surface) 80%, transparent); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);">
          <div class="text-3xl md:text-4xl font-bold mb-2 gradient-text-titanium">Global</div>
          <div class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{t('home.cta.network')}</div>
        </div>
      </div>
    </div>
  </div>
</section>
