---
/**
 * CertificationsMarquee.astro
 *
 * Compact horizontal scrolling strip of 5 certificate cards (image + number + title),
 * re-using the data from /capabilities/certifications/. Pure CSS animation,
 * pause-on-hover, prefers-reduced-motion fallback to manual scroll-snap.
 *
 * Sits on the homepage between JapanTrustDashboard and MaterialMatrix.
 * Zero JS, zero new dependencies.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface CertChip {
  num: string;
  title: string;
  src: string;
  alt: string;
  href: string;
  width: number;
  height: number;
}

const certs: CertChip[] = [
  { num: '01', title: 'Supplier certification',       src: '/uploads/cert-sgs-verified-supplier.jpg', href: '/uploads/cert-sgs-verified-supplier.jpg', alt: 'SGS verified supplier certificate for Baoji Boze Metal Products Co., Ltd, issued under Alibaba verification by Intertek', width: 240, height: 342 },
  { num: '02', title: 'SGS system certification',     src: '/uploads/cert-sgs-verified-supplier.jpg', href: '/uploads/cert-sgs-verified-supplier.jpg', alt: 'SGS verified supplier certificate for Baoji Boze Metal Products Co., Ltd, issued under Alibaba verification by Intertek', width: 240, height: 342 },
  { num: '03', title: 'European Representatives Recognition', src: '/uploads/cert-eu-representative.jpg',  href: '/uploads/cert-eu-representative.jpg',  alt: 'EU Product Safety Act (ProdSG) European authorised representatives recognition certificate', width: 240, height: 342 },
  { num: '04', title: 'AS9100',                       src: '/uploads/cert-as9100-en9100-bv.jpg',  href: '/uploads/cert-as9100-en9100-bv-HD.jpg', alt: 'Bureau Veritas certificate of approval CN054217: EN 9100:2018 (AS9100) and ISO 9001:2015 for machining of aviation standard parts, issued 2025-04-08, expires 2028-04-07', width: 240, height: 342 },
  { num: '05', title: 'High-tech Enterprise Certificate', src: '/uploads/cert-china-hightech.jpg',   href: '/uploads/cert-china-hightech.jpg',   alt: 'China High-tech Enterprise Certificate, national high-tech enterprise certification', width: 240, height: 342 },
];
---

<section
  class="cert-marquee-section relative py-12 md:py-16 overflow-hidden"
  style="background-color: color-mix(in srgb, var(--theme-primary) 3%, var(--theme-bg));"
  aria-labelledby="cert-marquee-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section header: title left, "view all" link right -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <h2
          id="cert-marquee-heading"
          class="text-2xl md:text-[28px] font-bold leading-tight"
          style="color: var(--theme-text);"
        >
          {t('home.certMarquee.title')}
        </h2>
        <p
          class="mt-2 text-sm md:text-[15px] leading-relaxed max-w-2xl"
          style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);"
        >
          {t('home.certMarquee.subtitle')}
        </p>
      </div>
      <a
        href="/capabilities/certifications/"
        class="inline-flex items-center text-sm font-semibold transition-colors duration-200 self-start sm:self-auto"
        style="color: var(--theme-primary);"
      >
        {t('home.certMarquee.viewAll')}
      </a>
    </div>

    <!-- Marquee track: real list (read by AT) + duplicate list (aria-hidden, for seamless loop) -->
    <div
      class="cert-marquee"
      role="region"
      aria-label={t('home.certMarquee.title')}
    >
      <ul class="cert-marquee__track" data-track>
        {certs.map((c) => (
          <li class="cert-marquee__item shrink-0">
            <a
              href={c.href}
              target="_blank"
              rel="noopener"
              class="cert-marquee__chip group block"
              aria-label={t('home.certMarquee.aria.viewCert').replace('{title}', c.title)}
            >
              <span class="cert-marquee__photo bg-[#ffe1b8] p-1.5 inline-block shrink-0">
                <img
                  src={c.src}
                  alt={c.alt}
                  width={c.width}
                  height={c.height}
                  loading="lazy"
                  decoding="async"
                  class="block h-[78px] w-auto"
                />
              </span>
              <span class="cert-marquee__text flex flex-col justify-center min-w-0">
                <span class="cert-marquee__num text-[12px] font-semibold leading-none" style="color: #f39800;">{c.num}</span>
                <span class="cert-marquee__title mt-1 text-[14px] font-bold leading-[1.25] line-clamp-2" style="color: var(--theme-text);">{c.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <ul class="cert-marquee__track" data-track aria-hidden="true">
        {certs.map((c) => (
          <li class="cert-marquee__item shrink-0">
            <span class="cert-marquee__chip block" aria-hidden="true">
              <span class="cert-marquee__photo bg-[#ffe1b8] p-1.5 inline-block shrink-0">
                <img src={c.src} alt="" width={c.width} height={c.height} loading="lazy" decoding="async" class="block h-[78px] w-auto" />
              </span>
              <span class="cert-marquee__text flex flex-col justify-center min-w-0">
                <span class="cert-marquee__num text-[12px] font-semibold leading-none" style="color: #f39800;">{c.num}</span>
                <span class="cert-marquee__title mt-1 text-[14px] font-bold leading-[1.25] line-clamp-2" style="color: var(--theme-text);">{c.title}</span>
              </span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .cert-marquee-section {
    /* Safety: prevent horizontal page overflow from any rogue element */
    max-width: 100vw;
  }

  .cert-marquee {
    display: flex;
    overflow: hidden;
    gap: 1rem;            /* matches gap-4 between items */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 32px, #000 calc(100% - 32px), transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 32px, #000 calc(100% - 32px), transparent 100%);
  }

  .cert-marquee__track {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
    padding-right: 1rem;  /* mirror gap on track edge so duplicate lines up seamlessly */
    animation: cert-scroll 38s linear infinite;
    will-change: transform;
  }

  .cert-marquee:hover .cert-marquee__track,
  .cert-marquee:focus-within .cert-marquee__track {
    animation-play-state: paused;
  }

  @keyframes cert-scroll {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-100%, 0, 0); }
  }

  .cert-marquee__item {
    width: 300px;
  }

  .cert-marquee__chip {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #ffffff;
    border: 1px solid color-mix(in srgb, var(--theme-text) 10%, transparent);
    border-radius: 10px;
    padding: 12px 14px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: transform 200ms ease-out, box-shadow 200ms ease-out, border-color 200ms ease-out;
    text-decoration: none;
    height: 100%;
  }

  a.cert-marquee__chip:hover,
  a.cert-marquee__chip:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
    border-color: #f39800;
    outline: none;
  }

  .cert-marquee__photo img {
    display: block;
  }

  .cert-marquee__text {
    flex: 1 1 auto;
  }

  /* Reduced motion: stop the loop, let the user scroll manually with snap. */
  @media (prefers-reduced-motion: reduce) {
    .cert-marquee {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      -webkit-mask-image: none;
              mask-image: none;
    }
    .cert-marquee__track {
      animation: none;
    }
    .cert-marquee__track[aria-hidden="true"] {
      display: none;
    }
    .cert-marquee__item {
      scroll-snap-align: start;
    }
  }
</style>
