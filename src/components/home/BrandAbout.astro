---
/**
 * BrandAbout — Premium "About the Company" brand module
 * Used site-wide in BaseLayout.astro above the Footer.
 */
import { SITE } from '../../config/site';
---

<section class="brand-about">
  <!-- Ambient background glow -->
  <div class="brand-about-glow" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="brand-about-card">

      <!-- Header -->
      <div class="text-center mb-8">
        <span
          class="inline-flex items-center gap-2 px-4 py-1.5 text-xs font-semibold tracking-wider uppercase rounded-full mb-4"
          style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
          About {SITE.title}
        </span>
        <p class="text-sm font-medium tracking-widest uppercase" style="color: color-mix(in srgb, var(--theme-primary) 60%, transparent); letter-spacing: 0.15em;">
          One Metal. One Focus. Infinite Precision.
        </p>
      </div>

      <!-- Brand Narrative -->
      <div class="max-w-4xl mx-auto text-center mb-10">
        <p
          class="text-base md:text-lg leading-relaxed"
          style="color: color-mix(in srgb, var(--theme-text) 78%, transparent);"
        >
          Founded in 2011 in Baoji's Titanium Valley, BOZE Metal is dedicated exclusively to titanium — from raw material to precision engineering. 
          <strong style="color: var(--theme-text);">AS9100D, ISO 13485 & ISO 9001 certified</strong> 
          with 500+ clients across Aerospace, Medical & Motorsport industries, we deliver end-to-end precision titanium CNC machining with full material traceability from source to component.
        </p>
        <p
          class="text-base md:text-lg leading-relaxed mt-4"
          style="color: color-mix(in srgb, var(--theme-text) 78%, transparent);"
        >
          Boze CNC Ti is the dedicated titanium manufacturing center of Baoji Boze Metal Products Co., Ltd.
        </p>
      </div>

      <!-- Credential Badges -->
      <div class="flex flex-wrap justify-center gap-3 mb-10">
        <span class="cred-badge">AS9100D</span>
        <span class="cred-badge">ISO 13485</span>
        <span class="cred-badge">ISO 9001</span>
        <span class="cred-badge">500+ Clients</span>
        <span class="cred-badge">15+ Years</span>
        <span class="cred-badge">OEM/ODM</span>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a
          href="/about"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 text-sm font-bold rounded-xl transition-all duration-300 hover:-translate-y-0.5"
          style="background: var(--theme-surface); color: var(--theme-text); border: 2px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Learn About Us
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 text-sm font-bold rounded-xl transition-all duration-300 hover:-translate-y-0.5"
          style="background: var(--theme-primary); color: var(--theme-text);"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Request a Quote
        </a>
      </div>

    </div>

    <!-- Explore More (de-emphasised utility links) -->
    <div
      class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-8 pt-6 text-xs"
      style="border-top: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent); color: color-mix(in srgb, var(--theme-text) 40%, transparent);"
    >
      <span style="color: color-mix(in srgb, var(--theme-text) 30%, transparent);">Explore More:</span>
      <a href="/materials" class="hover-link">Material Specifications</a>
      <a href="/industries" class="hover-link">Industry Applications</a>
      <a href="/services" class="hover-link">All Services</a>
      <a href="/capabilities" class="hover-link">Capabilities</a>
    </div>
  </div>
</section>

<style>
  .brand-about {
    position: relative;
    overflow: hidden;
    padding: 4rem 0 3rem;
    background: var(--theme-surface);
    border-top: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);
  }

  .brand-about-glow {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 40% at 20% 50%, color-mix(in srgb, var(--theme-primary) 40%, transparent) 0%, transparent 70%),
      radial-gradient(ellipse 60% 40% at 80% 50%, color-mix(in srgb, var(--theme-accent) 30%, transparent) 0%, transparent 70%);
  }

  .brand-about-card {
    position: relative;
    z-index: 1;
    background: var(--theme-bg);
    border: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent);
    border-radius: 1.25rem;
    padding: 2.5rem 2rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.04);
  }

  .cred-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--theme-primary) 8%, transparent);
    color: color-mix(in srgb, var(--theme-text) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--theme-primary) 10%, transparent);
    letter-spacing: 0.02em;
    transition: all 0.2s ease;
  }

  .cred-badge:hover {
    background: color-mix(in srgb, var(--theme-primary) 14%, transparent);
    color: var(--theme-text);
    border-color: color-mix(in srgb, var(--theme-primary) 20%, transparent);
  }

  .hover-link {
    color: color-mix(in srgb, var(--theme-text) 45%, transparent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hover-link:hover {
    color: var(--theme-primary);
  }

  @media (max-width: 640px) {
    .brand-about {
      padding: 2.5rem 0 2rem;
    }
    .brand-about-card {
      padding: 1.75rem 1.25rem;
    }
  }
</style>
