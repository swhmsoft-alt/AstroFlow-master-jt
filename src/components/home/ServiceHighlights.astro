---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import FeatureShowcase from '../react/FeatureShowcase';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center mb-16">
      <div class="inline-flex items-center badge-accent mb-4">
        {t('home.serviceHighlights.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('home.serviceHighlights.title')} <span class="gradient-text-accent">{t('home.serviceHighlights.titleHighlight')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
        {t('home.serviceHighlights.subtitle')}
      </p>
    </div>

    <FeatureShowcase client:load />
    
    <!-- Bottom CTA -->
    <div class="text-center mt-16">
      <a 
        href="/services" 
        class="inline-flex items-center px-8 py-4 text-base font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all group"
        style="background-color: var(--theme-primary); color: #ffffff;"
        onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 80%, black)'; this.style.boxShadow='0 0 20px color-mix(in srgb, var(--theme-primary) 40%, transparent)'"
        onmouseout="this.style.backgroundColor='var(--theme-primary)'; this.style.boxShadow=''"
      >
        {t('home.serviceHighlights.cta')}
        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
