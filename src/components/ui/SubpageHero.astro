---
interface Props {
  title?: string;
  highlight?: string;
  subtitle?: string;
  badge?: string;
  badgeIcon?: string;
  /** Override gradient from/to (e.g. "from-blue-600 to-teal-600") */
  badgeGradient?: string;
  /** Override heading highlight gradient (e.g. "from-blue-400 via-teal-400 to-blue-400") */
  highlightGradient?: string;
  /** Extra content after subtitle, before the slot */
  extra?: string;
  /** Complete H1 string (merges title + highlight into one). Overrides title/highlight when provided. */
  h1?: string;
}

const {
  title,
  highlight,
  subtitle,
  badge,
  badgeIcon,
  badgeGradient,
  highlightGradient,
  h1,
} = Astro.props;

// Static hero defaults (previously loaded from CMS collection 'hero')
const heroStyle = 'gradient';
const bgImage = '';
const badgePrefix = 'BOZE CNC Ti';
const heroHeight = '50vh';
const heroMinHeight = '400px';

const badgeLabel = badge ? `${badgePrefix} | ${badge}` : badgePrefix;
const badgeBg = badgeGradient || '';
const hlGradient = highlightGradient || '';
---

{
  heroStyle === 'image' && bgImage ? (
    <section
      class="relative flex items-center overflow-hidden"
      style={`height: ${heroHeight}; min-height: ${heroMinHeight};`}
    >
      <div class="absolute inset-0">
        <img
          src={bgImage}
          alt=""
          class="w-full h-full object-cover"
          loading="lazy"
        />
        <div
          class="absolute inset-0"
          style="background: linear-gradient(to right, color-mix(in srgb, var(--theme-bg) 95%, transparent) 0%, color-mix(in srgb, var(--theme-bg) 80%, transparent) 40%, color-mix(in srgb, var(--theme-bg) 50%, transparent) 100%);"
        ></div>
      </div>
      <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
          <div
            class="inline-flex items-center px-4 py-2 mb-6 text-sm font-semibold rounded-full shadow-lg"
            style="background-color: color-mix(in srgb, var(--theme-primary) 20%, transparent); color: var(--theme-text);"
          >
            {badgeIcon && <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d={badgeIcon} clip-rule="evenodd" /></svg>}
            {badgeLabel}
          </div>
          <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight" style="color: var(--theme-text);">
            {h1 ? (
              <span>{h1}</span>
            ) : (
              <>
                {title}
                {highlight && (
                  <span class="block mt-2" style={hlGradient ? `background: linear-gradient(to right, ${hlGradient}); -webkit-background-clip: text; background-clip: text; color: transparent;` : `color: var(--theme-primary);`}>
                    {highlight}
                  </span>
                )}
              </>
            )}
          </h1>
          {subtitle && (
            <p class="text-xl md:text-2xl mb-8 max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
              {subtitle}
            </p>
          )}
          <slot />
        </div>
      </div>
    </section>
  ) : (
    <section
      class="relative flex items-center overflow-hidden"
      style={`height: ${heroHeight}; min-height: ${heroMinHeight}; background: linear-gradient(135deg, var(--theme-bg) 0%, color-mix(in srgb, var(--theme-primary) 10%, var(--theme-bg)) 50%, var(--theme-surface) 100%);`}
    >
      <div class="absolute inset-0 opacity-20">
        <div
          class="absolute inset-0"
          style="background: radial-gradient(circle at 20% 50%, color-mix(in srgb, var(--theme-primary) 30%, transparent) 0%, transparent 50%), radial-gradient(circle at 80% 50%, color-mix(in srgb, var(--theme-accent) 30%, transparent) 0%, transparent 50%);"
        ></div>
      </div>
      <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
          <div
            class="inline-flex items-center px-4 py-2 mb-6 text-sm font-semibold rounded-full shadow-lg"
            style="background-color: color-mix(in srgb, var(--theme-primary) 20%, transparent); color: var(--theme-text);"
          >
            {badgeIcon && <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d={badgeIcon} clip-rule="evenodd" /></svg>}
            {badgeLabel}
          </div>
          <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight" style="color: var(--theme-text);">
            {h1 ? (
              <span>{h1}</span>
            ) : (
              <>
                {title}
                {highlight && (
                  <span class="block mt-2" style={hlGradient ? `background: linear-gradient(to right, ${hlGradient}); -webkit-background-clip: text; background-clip: text; color: transparent;` : `color: var(--theme-primary);`}>
                    {highlight}
                  </span>
                )}
              </>
            )}
          </h1>
          {subtitle && (
            <p class="text-xl md:text-2xl mb-8 max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
              {subtitle}
            </p>
          )}
          <slot />
        </div>
      </div>
    </section>
  )
}