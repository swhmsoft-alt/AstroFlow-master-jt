---
interface MetricItem {
  value: string;
  label: string;
}

interface Props {
  title?: string;
  highlight?: string;
  subtitle?: string;
  badge?: string;
  badgeIcon?: string;
  /** Override gradient from/to (e.g. "from-blue-600 to-teal-600") */
  badgeGradient?: string;
  /** Override heading highlight gradient (e.g. "from-blue-400 via-teal-400 to-blue-400") */
  highlightGradient?: string;
  /** Extra content after subtitle, before the slot */
  extra?: string;
  /** Complete H1 string (merges title + highlight into one). Overrides title/highlight when provided. */
  h1?: string;

  // ── Content overload management ──
  /** Max subtitle characters before line-clamp kicks in (0 = no clamp) */
  subtitleMaxChars?: number;
  /** Max subtitle lines before line-clamp (default 4) */
  subtitleMaxLines?: number;
  /** Key metrics chips displayed below subtitle */
  keyMetrics?: MetricItem[];
  /** Entity badges displayed as chips below subtitle */
  entityChips?: string[];
  /** Force smaller font for long subtitles */
  compact?: boolean;
  /** Background image URL (default: none, uses gradient background) */
  backgroundImage?: string;
  /** Background video URL (overlays backgroundImage; autoplay/loop/muted) */
  backgroundVideo?: string;
  /** Optional poster image for backgroundVideo (shown until first frame) */
  backgroundVideoPoster?: string;
  /** Ken Burns slideshow frames (URLs). Crossfades with slow scale+pan animation. Overrides backgroundImage/Video when set. */
  kenBurnsSlides?: string[];
  /** Ken Burns per-frame duration in seconds (default 8) */
  kenBurnsFrameDuration?: number;
}

import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const {
  title,
  highlight,
  subtitle,
  badge,
  badgeIcon,
  badgeGradient,
  highlightGradient,
  h1,
  subtitleMaxChars = 180,
  subtitleMaxLines = 4,
  keyMetrics,
  entityChips,
  compact = false,
  backgroundImage = '/uploads/titanium-cnc-machining-manufacturing-facility.webp',
  backgroundVideo,
  backgroundVideoPoster,
  kenBurnsSlides,
  kenBurnsFrameDuration = 8,
} = Astro.props;

// Ken Burns: per-frame unique scale+pan transform
// Each frame is visible for kenBurnsFrameDuration seconds, then crossfades to next.
// Total cycle = frames.length * kenBurnsFrameDuration seconds.
const kenBurnsVariants = [
  { originX: '50%', originY: '50%' },
  { originX: '30%', originY: '50%' },
  { originX: '70%', originY: '50%' },
  { originX: '50%', originY: '30%' },
  { originX: '50%', originY: '70%' },
  { originX: '20%', originY: '70%' },
  { originX: '80%', originY: '30%' },
  { originX: '50%', originY: '50%' },
];

const kbTotalCycle = (kenBurnsSlides && kenBurnsSlides.length > 0)
  ? kenBurnsSlides.length * kenBurnsFrameDuration
  : 0;

// All frames share the SAME keyframes (visible during 0..(1/frames)*100 % of their
// own timeline). Different animation-delays make them take turns being visible.
// Per-frame transform-origin differs for varied Ken Burns motion.
const kbSlicePercent = kenBurnsSlides && kenBurnsSlides.length > 0
  ? 100 / kenBurnsSlides.length
  : 0;
const kbFadeInEnd = Math.min(1.5, kbSlicePercent * 0.15);
const kbFadeOutStart = Math.max(kbSlicePercent - 1.5, kbFadeInEnd + 0.1);
const sharedKeyframes = `@keyframes kb-show { 0% { opacity: 0; transform: scale(1.0); } ${kbFadeInEnd.toFixed(2)}% { opacity: 1; transform: scale(1.05); } ${kbFadeOutStart.toFixed(2)}% { opacity: 1; transform: scale(1.18); } ${kbSlicePercent.toFixed(2)}% { opacity: 0; transform: scale(1.18); } 100% { opacity: 0; transform: scale(1.0); } }`;

const kbFrames = (kenBurnsSlides || []).map((src, i) => {
  const v = kenBurnsVariants[i % kenBurnsVariants.length];
  return {
    src,
    index: i,
    style: `transform-origin: ${v.originX} ${v.originY}; animation: kb-show ${kbTotalCycle}s ${i * kenBurnsFrameDuration}s infinite;`,
  };
});

// Static hero defaults
const badgePrefix = 'Boze Titanium Manufacturing Center';
const badgeLabel = badge ? `${badgePrefix} | ${badge}` : badgePrefix;
const hlGradient = highlightGradient || '';

// Determine if subtitle is long and needs truncation
const isLongSubtitle = subtitle && subtitle.length > subtitleMaxChars;
const subTextSize = compact || (subtitle && subtitle.length > 200) ? 'text-lg md:text-xl' : 'text-xl md:text-2xl';
const subMaxWidth = isLongSubtitle ? 'max-w-5xl' : 'max-w-3xl';
---

<section class="relative flex items-center overflow-hidden py-20 md:py-28 min-h-90" style="background: linear-gradient(135deg, var(--theme-bg) 0%, color-mix(in srgb, var(--theme-primary) 10%, var(--theme-bg)) 50%, var(--theme-surface) 100%);">
  {kenBurnsSlides && kenBurnsSlides.length > 0 ? (
    <>
      {/* Ken Burns shared keyframes (per-frame transform-origin set inline) */}
      <style set:html={sharedKeyframes}></style>
      {/* Stacked frames, each fades + scales during its slice */}
      <div class="absolute inset-0">
        {kbFrames.map((f) => (
          <img
            src={f.src}
            alt=""
            aria-hidden="true"
            loading="eager"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover"
            style={f.style}
          />
        ))}
      </div>
    </>
  ) : (
    <>
      {backgroundImage && !backgroundVideo ? (
        <!-- Image Background (overlaid on gradient) -->
        <div class="absolute inset-0" style={`background-image: url(${backgroundImage}); background-size: cover; background-position: center;`}></div>
      ) : null}
      {backgroundVideo ? (
        <!-- Video Background (overlays backgroundImage if set; autoplay/loop/muted) -->
        <video
          class="absolute inset-0 w-full h-full object-cover"
          src={backgroundVideo}
          poster={backgroundVideoPoster || backgroundImage || undefined}
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
      ) : null}
    </>
  )}
  <!-- Gradient overlay on image/video (always applied when any background is present) -->
  {(backgroundImage || backgroundVideo || (kenBurnsSlides && kenBurnsSlides.length > 0)) ? (
    <div class="absolute inset-0" style="background: linear-gradient(to right, color-mix(in srgb, var(--theme-bg) 97%, transparent) 0%, color-mix(in srgb, var(--theme-bg) 85%, transparent) 40%, color-mix(in srgb, var(--theme-bg) 50%, transparent) 100%);"></div>
  ) : null}
  <!-- Ambient background glow -->
  <div class="absolute inset-0 opacity-20">
    <div
      class="absolute inset-0"
      style="background: radial-gradient(circle at 20% 50%, color-mix(in srgb, var(--theme-primary) 30%, transparent) 0%, transparent 50%), radial-gradient(circle at 80% 50%, color-mix(in srgb, var(--theme-accent) 30%, transparent) 0%, transparent 50%);"
    ></div>
  </div>

  <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">

      <!-- Badge -->
      <div
        class="inline-flex items-center px-4 py-2 mb-6 text-sm font-semibold rounded-full shadow-lg"
        style="background-color: color-mix(in srgb, var(--theme-primary) 20%, transparent); color: var(--theme-text);"
      >
        {badgeIcon && <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d={badgeIcon} clip-rule="evenodd" /></svg>}
        {badgeLabel}
      </div>

      <!-- H1 Heading -->
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight" style="color: var(--theme-text);">
        {h1 ? (
          <span>{h1}</span>
        ) : (
          <>
            {title}
            {highlight && (
              <span class="block mt-2" style={hlGradient ? `background: linear-gradient(to right, ${hlGradient}); -webkit-background-clip: text; background-clip: text; color: transparent;` : `color: var(--theme-primary);`}>
                {highlight}
              </span>
            )}
          </>
        )}
      </h1>

      <!-- Subtitle with line-clamp truncation -->
      {subtitle && (
        <div>
          <p
            class="{subTextSize} {subMaxWidth} mx-auto leading-relaxed"
            style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);"
            class:list={{
              'line-clamp-4 md:line-clamp-6': isLongSubtitle,
            }}
            title={isLongSubtitle ? subtitle : undefined}
          >
            {subtitle}
          </p>

          {isLongSubtitle && (
            <details class="group mt-2">
              <summary class="cursor-pointer text-sm font-semibold inline-flex items-center hover:opacity-80 transition-opacity" style="color: var(--theme-primary);">
                <span class="group-open:hidden">{t('hero.read_more')}</span>
                <span class="hidden group-open:inline">{t('hero.show_less')}</span>
                <svg class="w-4 h-4 ml-1 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              {/* Hidden content already visible via line-clamp removal on details open */}
            </details>
          )}
        </div>
      )}

      <!-- Key Metrics Row -->
      {keyMetrics && keyMetrics.length > 0 && (
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-6">
          {keyMetrics.map((m) => (
            <div class="flex items-center gap-1.5 text-sm" style="color: var(--theme-primary);">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="font-semibold">{m.value}</span>
              <span style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{m.label}</span>
            </div>
          ))}
        </div>
      )}

      <!-- Entity Chips -->
      {entityChips && entityChips.length > 0 && (
        <div class="flex flex-wrap justify-center gap-2 mt-5">
          {entityChips.map((chip) => (
            <span
              class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full"
              style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); color: var(--theme-primary); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
            >
              {chip}
            </span>
          ))}
        </div>
      )}

      <slot />
    </div>
  </div>
</section>
