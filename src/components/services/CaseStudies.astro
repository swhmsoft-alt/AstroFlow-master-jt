---
/**
 * CaseStudies.astro
 *
 * Two representative titanium machining programs with quantified before/after
 * results. Designed for EEAT (Experience) and information-gain on AI citation.
 *
 * i18n: t(key) returns the localized string when present, falling back to
 * English otherwise.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface ResultRow {
  label: string;
  before: string;
  after: string;
}

interface CaseStudy {
  clientTag: string;
  part: string;
  challengeLabel: string;
  challenge: string;
  solutionLabel: string;
  solution: string;
  resultsLabel: string;
  results: ResultRow[];
}

const caseA: CaseStudy = {
  clientTag: t('services.casestudies.case1.client_tag'),
  part: t('services.casestudies.case1.part'),
  challengeLabel: t('services.casestudies.case1.challenge_label'),
  challenge: t('services.casestudies.case1.challenge'),
  solutionLabel: t('services.casestudies.case1.solution_label'),
  solution: t('services.casestudies.case1.solution'),
  resultsLabel: t('services.casestudies.case1.results_label'),
  results: [
    { label: t('services.casestudies.case1.result_yield_label'), before: t('services.casestudies.case1.result_yield_before'), after: t('services.casestudies.case1.result_yield_after') },
    { label: t('services.casestudies.case1.result_lead_label'), before: t('services.casestudies.case1.result_lead_before'), after: t('services.casestudies.case1.result_lead_after') },
    { label: t('services.casestudies.case1.result_tol_label'), before: t('services.casestudies.case1.result_tol_before'), after: t('services.casestudies.case1.result_tol_after') },
  ],
};

const caseB: CaseStudy = {
  clientTag: t('services.casestudies.case2.client_tag'),
  part: t('services.casestudies.case2.part'),
  challengeLabel: t('services.casestudies.case2.challenge_label'),
  challenge: t('services.casestudies.case2.challenge'),
  solutionLabel: t('services.casestudies.case2.solution_label'),
  solution: t('services.casestudies.case2.solution'),
  resultsLabel: t('services.casestudies.case2.results_label'),
  results: [
    { label: t('services.casestudies.case2.result_yield_label'), before: t('services.casestudies.case2.result_yield_before'), after: t('services.casestudies.case2.result_yield_after') },
    { label: t('services.casestudies.case2.result_lead_label'), before: t('services.casestudies.case2.result_lead_before'), after: t('services.casestudies.case2.result_lead_after') },
    { label: t('services.casestudies.case2.result_tol_label'), before: t('services.casestudies.case2.result_tol_before'), after: t('services.casestudies.case2.result_tol_after') },
  ],
};

const cases: CaseStudy[] = [caseA, caseB];

const badge = t('services.casestudies.badge');
const sectionTitle = t('services.casestudies.sectionTitle');
const sectionLede = t('services.casestudies.sectionLede');
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.04]" aria-hidden="true">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 80px 80px;"></div>
  </div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12 max-w-3xl mx-auto">
      <div
        class="inline-flex items-center px-4 py-2 mb-5 text-sm font-semibold rounded-full border"
        style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {badge}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-5 leading-tight" style="color: var(--theme-text);">
        {sectionTitle}
      </h2>
      <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {sectionLede}
      </p>
    </div>

    <div class="space-y-10">
      {cases.map((cs) => (
        <article
          class="rounded-2xl overflow-hidden border"
          style="background-color: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 22%, transparent);"
        >
          <!-- Header -->
          <header
            class="px-6 md:px-10 py-6 flex flex-col md:flex-row md:items-center md:justify-between gap-3 border-b"
            style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 8%, var(--theme-surface)), var(--theme-surface)); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);"
          >
            <div>
              <div class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: color-mix(in srgb, var(--theme-primary) 80%, transparent);">
                {cs.clientTag}
              </div>
              <h3 class="text-xl md:text-2xl font-bold" style="color: var(--theme-text);">
                {cs.part}
              </h3>
            </div>
          </header>

          <!-- Challenge & Solution -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
            <div
              class="px-6 md:px-10 py-7 border-r"
              style="border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);"
            >
              <div class="text-xs font-semibold uppercase tracking-widest mb-2 flex items-center" style="color: color-mix(in srgb, var(--theme-primary) 80%, transparent);">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
                {cs.challengeLabel}
              </div>
              <p class="text-sm md:text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
                {cs.challenge}
              </p>
            </div>

            <div class="px-6 md:px-10 py-7">
              <div class="text-xs font-semibold uppercase tracking-widest mb-2 flex items-center" style="color: color-mix(in srgb, var(--theme-primary) 80%, transparent);">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {cs.solutionLabel}
              </div>
              <p class="text-sm md:text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
                {cs.solution}
              </p>
            </div>
          </div>

          <!-- Quantified Results -->
          <div
            class="px-6 md:px-10 py-6 border-t"
            style="background-color: color-mix(in srgb, var(--theme-primary) 4%, var(--theme-surface)); border-color: color-mix(in srgb, var(--theme-primary) 15%, transparent);"
          >
            <div class="text-xs font-semibold uppercase tracking-widest mb-4 flex items-center" style="color: color-mix(in srgb, var(--theme-primary) 80%, transparent);">
              <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
              </svg>
              {cs.resultsLabel}
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {cs.results.map((r) => (
                <div
                  class="rounded-xl p-4"
                  style="background-color: color-mix(in srgb, var(--theme-primary) 8%, var(--theme-surface)); border: 1px solid color-mix(in srgb, var(--theme-primary) 20%, transparent);"
                >
                  <div class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
                    {r.label}
                  </div>
                  <div class="flex items-center gap-3 text-sm">
                    <div class="flex-1">
                      <div class="text-[10px] uppercase tracking-wider mb-0.5" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">Before</div>
                      <div class="font-bold line-through" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">{r.before}</div>
                    </div>
                    <svg class="w-5 h-5 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                    <div class="flex-1">
                      <div class="text-[10px] uppercase tracking-wider mb-0.5" style="color: var(--theme-primary);">After</div>
                      <div class="text-lg font-bold" style="color: var(--theme-primary);">{r.after}</div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>