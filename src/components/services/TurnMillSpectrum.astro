---
interface ServiceCard {
  title: string;
  subtitle: string;
  description: string;
  capabilities: string[];
  icon: string;
}

const services: ServiceCard[] = [
  {
    title: "Precision CNC Turning",
    subtitle: "Steps, Threads & Bone Screws",
    description: "Optimized for cylindrical titanium components demanding tight coaxiality — from threaded fasteners and bone screws to high-grade adapters and stepped shafts.",
    capabilities: [
      "Single & multi-step turning with live tooling",
      "Thread whirling for bone screws & implant posts",
      "Tight coaxiality ≤0.01 mm between steps",
      "Bar feed automation for high-volume runs"
    ],
    icon: "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
  },
  {
    title: "High-Speed CNC Milling",
    subtitle: "Block Components, Slots & Profiling",
    description: "Machining prismatic block components, slots, and complex profiles while maintaining stress-free structural stability — essential for thin-wall titanium housings.",
    capabilities: [
      "3-axis high-speed roughing & finishing cycles",
      "Slotting, pocketing, and shoulder profiling",
      "Stress-relieving tool path strategies for thin walls",
      "Rigid tapping and thread milling in titanium"
    ],
    icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z"
  },
  {
    title: "Turn-Mill Multi-Tasking",
    subtitle: "Live Tooling, Single-Setup Completes",
    description: "Integrating live tooling (drilling, milling, slotting) on turning centers to produce complete parts in a single clamping — zeroing out re-fixturing errors entirely.",
    capabilities: [
      "B-axis live tooling for angled drilling & milling",
      "Complete part production in one clamping cycle",
      "Eliminates secondary op errors & handling time",
      "Ideal for complex valve bodies & fittings"
    ],
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
  }
];
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Grid pattern -->
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z" />
        </svg>
        Turn-Mill Capabilities
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        CNC Turning & Milling <span style="color: var(--theme-primary);">Process Spectrum</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        From precision turned bone screws to multi-axis milled prismatic components — three complementary capabilities covering your full titanium part portfolio.
      </p>
    </div>

    <!-- 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((svc) => (
        <div
          class="group relative rounded-xl p-8 flex flex-col h-full transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);"
          onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 10%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 18%, transparent)'; this.style.boxShadow='none'"
        >
          <!-- Icon -->
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <svg class="w-6 h-6" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={svc.icon} />
            </svg>
          </div>

          <!-- Title & Subtitle -->
          <h3 class="text-lg font-bold mb-1" style="color: var(--theme-text);">{svc.title}</h3>
          <span class="text-sm font-medium mb-4 block" style="color: var(--theme-primary);">{svc.subtitle}</span>

          <!-- Description -->
          <p class="text-sm leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            {svc.description}
          </p>

          <!-- Capabilities list -->
          <ul class="space-y-2 mt-auto">
            {svc.capabilities.map((cap) => (
              <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {cap}
              </li>
            ))}
          </ul>

          <!-- Corner hover accent -->
          <div
            class="absolute top-0 right-0 w-0 h-0 transition-all duration-300 rounded-tr-xl"
            style="border-style: solid; border-width: 0 0 0 0; border-color: transparent var(--theme-primary) transparent transparent; opacity: 0;"
            onmouseover="this.style.borderWidth='40px 40px 0 0'; this.style.opacity='1'"
            onmouseout="this.style.borderWidth='0 0 0 0'; this.style.opacity='0'"
          ></div>
        </div>
      ))}
    </div>
  </div>
</section>