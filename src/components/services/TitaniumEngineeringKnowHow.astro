---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const challengeIndices = [0, 1];

const icons: string[] = [
  "M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z",
  "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
];

const detailKeys: string[][] = [
  ['services.titaniumengineeringknowhow.challenge0.detail0', 'services.titaniumengineeringknowhow.challenge0.detail1', 'services.titaniumengineeringknowhow.challenge0.detail2'],
  ['services.titaniumengineeringknowhow.challenge1.detail0', 'services.titaniumengineeringknowhow.challenge1.detail1', 'services.titaniumengineeringknowhow.challenge1.detail2']
];
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Circuit-board style background -->
  <div class="absolute inset-0 opacity-[0.02]">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, var(--theme-primary) 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
        </svg>
        {t('services.titaniumengineeringknowhow.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Mastering <span style="color: var(--theme-primary);">{t('services.titaniumengineeringknowhow.titaniums_hardbones')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t('services.titaniumengineeringknowhow.subtitle')}
      </p>
    </div>

    <!-- Challenge Grid — 2-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {challengeIndices.map((idx) => (
        <div
          class="relative rounded-xl overflow-hidden h-full"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
        >
          <!-- Top problem zone -->
          <div class="p-8 pb-6">
            <div class="flex items-start mb-5">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mr-4" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
                <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={icons[idx]} />
                </svg>
              </div>
              <h3 class="text-xl font-bold" style="color: var(--theme-text);">
                {t('services.titaniumengineeringknowhow.challenge' + idx + '.title')}
              </h3>
            </div>

            <div class="pl-14">
              <!-- Problem statement -->
              <div class="mb-4">
                <span class="text-xs font-semibold uppercase tracking-widest" style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">{t('services.titaniumengineeringknowhow.challenge_21')}</span>
                <p class="text-sm mt-1.5 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                  {t('services.titaniumengineeringknowhow.challenge' + idx + '.problem')}
                </p>
              </div>
            </div>
          </div>

          <!-- Divider with arrow -->
          <div class="relative flex items-center justify-center py-3">
            <div class="w-full h-px" style="background: linear-gradient(to right, transparent, color-mix(in srgb, var(--theme-primary) 30%, transparent), transparent);"></div>
            <div class="absolute flex items-center justify-center w-8 h-8 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);">
              <svg class="w-4 h-4" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
          </div>

          <!-- Solution zone -->
          <div class="p-8 pt-4">
            <div class="pl-0">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--theme-primary);">{t('services.titaniumengineeringknowhow.solution_21')}</span>
              <h4 class="text-base font-bold mt-1.5 mb-4" style="color: var(--theme-text);">
                {t('services.titaniumengineeringknowhow.challenge' + idx + '.solution')}
              </h4>
              <ul class="space-y-3">
                {detailKeys[idx].map((detailKey) => (
                  <li class="flex items-start">
                    <svg class="w-4 h-4 mt-0.5 mr-3 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{t(detailKey)}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Corner accent -->
          <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden">
            <div class="absolute -top-8 -right-8 w-16 h-16 rotate-45" style="background: linear-gradient(135deg, transparent 50%, color-mix(in srgb, var(--theme-primary) 8%, transparent) 50%);"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA line -->
    <div class="text-center mt-12">
      <p class="text-sm max-w-2xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
        Every titanium project we undertake is backed by decades of accumulated cutting data, in-house tooling development, and continuous process monitoring. <span style="color: var(--theme-primary);">{t('services.titaniumengineeringknowhow.hard_material_demands_hard_engineering')}</span>
      </p>
    </div>
  </div>
</section>