---
interface EngineeringFocus {
  title: string;
  problem: string;
  solution: string;
  details: string[];
  icon: string;
}

const foci: EngineeringFocus[] = [
  {
    title: '"White Layer" Suppression',
    problem: "During wire EDM of titanium, the intense localized heat (10,000°C+) from electrical discharge creates a recast layer — a brittle, re-solidified 'white layer' on the cut surface. This micro-cracked layer acts as a fatigue initiation site, reducing component lifespan by up to 40% in cyclically loaded aerospace and medical implants.",
    solution: "Multi-Pass Skim Cutting & Anti-Electrolysis Micro-Pulse Power Supplies",
    details: [
      "Progressive skim cut strategy: first rough cut removes bulk material, followed by 3-5 skim passes with progressively lower discharge energy (from 30A → 1A) — each pass removes the recast layer from the previous cut",
      "Anti-electrolysis (AC) micro-pulse power supply generates ultra-short pulse durations (< 1 µs) with zero-DC component, eliminating electrolytic corrosion of titanium grain boundaries during the cutting process",
      "Final skim pass at < 1A discharge current produces a recast layer thickness of < 2 µm — a 95% reduction compared to single-pass cutting — eliminating micro-crack initiation sites",
      "Metallurgical validation via SEM examination confirms white layer elimination, with post-cut fatigue life matching base material properties per ASTM E466 standards"
    ],
    icon: "M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"
  },
  {
    title: "Fluid Contamination & Oxidation Control",
    problem: "Titanium's high chemical reactivity at elevated temperatures (above 600°C) causes rapid oxidation and discoloration during the EDM spark discharge. Contaminated dielectric fluid — carrying suspended erosion debris — further degrades surface quality, causing pitting, uneven recast, and color banding visible on the cut surface.",
    solution: "Closed-Loop Deionized Water Resistivity Monitors & Nano-Filtration Systems",
    details: [
      "Closed-loop deionized water circulation system maintains resistivity at 15-20 MΩ·cm — preventing ionic contamination that would otherwise accelerate titanium surface oxidation during spark discharge",
      "Multi-stage nano-filtration (0.5 µm absolute) removes 99.9% of suspended erosion debris from the dielectric, preventing re-deposition of titanium particles onto the freshly cut surface",
      "Real-time resistivity feedback automatically adjusts deionization cartridge regeneration cycles — ensuring consistent dielectric purity across extended multi-hour EDM runs",
      "Temperature-controlled dielectric bath (20°C ±0.5°C) suppresses thermal gradients that cause differential oxidation rates across the workpiece, eliminating visible color banding and ensuring uniform surface appearance"
    ],
    icon: "M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"
  }
];
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Dot matrix -->
  <div class="absolute inset-0 opacity-[0.02]">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, var(--theme-primary) 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
        </svg>
        EDM Know-How
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Controlling Titanium's <span style="color: var(--theme-primary);">{t('services.wireedmknowhow.edmspecific_challenges')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Titanium's metallurgical response to electrical discharge machining requires precise control of thermal, chemical, and fluid dynamics. Here's how we ensure fatigue-safe, oxidation-free EDM surfaces.
      </p>
    </div>

    <!-- 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {foci.map((focus) => (
        <div
          class="relative rounded-xl overflow-hidden h-full"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
        >
          <!-- Problem zone -->
          <div class="p-8 pb-6">
            <div class="flex items-start mb-5">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mr-4" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
                <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={focus.icon} />
                </svg>
              </div>
              <h3 class="text-xl font-bold" style="color: var(--theme-text);">{focus.title}</h3>
            </div>

            <div class="pl-14">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">{t('services.wireedmknowhow.challenge_23')}</span>
              <p class="text-sm mt-1.5 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{focus.problem}</p>
            </div>
          </div>

          <!-- Divider with arrow -->
          <div class="relative flex items-center justify-center py-3">
            <div class="w-full h-px" style="background: linear-gradient(to right, transparent, color-mix(in srgb, var(--theme-primary) 30%, transparent), transparent);"></div>
            <div class="absolute flex items-center justify-center w-8 h-8 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);">
              <svg class="w-4 h-4" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
          </div>

          <!-- Solution zone -->
          <div class="p-8 pt-4">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--theme-primary);">{t('services.wireedmknowhow.solution_23')}</span>
            <h4 class="text-base font-bold mt-1.5 mb-4" style="color: var(--theme-text);">{focus.solution}</h4>
            <ul class="space-y-3">
              {focus.details.map((detail) => (
                <li class="flex items-start">
                  <svg class="w-4 h-4 mt-0.5 mr-3 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{detail}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Corner accent -->
          <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden">
            <div class="absolute -top-8 -right-8 w-16 h-16 rotate-45" style="background: linear-gradient(135deg, transparent 50%, color-mix(in srgb, var(--theme-primary) 8%, transparent) 50%);"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>