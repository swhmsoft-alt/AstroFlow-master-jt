---
interface EngineeringFocus {
  title: string;
  problem: string;
  solution: string;
  details: string[];
  icon: string;
}

const foci: EngineeringFocus[] = [
  {
    title: "Powder Lifecycle Logs",
    problem: "Recycled titanium powder accumulates oxygen pickup, nitrogen pickup, and morphological changes (satellites, agglomerates) through repeated laser exposure and handling cycles. Without strict lifecycle tracking, these degradations cause embrittlement, porosity, and mechanical property drift across production batches.",
    solution: "Mandatory Laser Particle Size Tests & Interstitial Gas Analysis per Powder Lot",
    details: [
      "Every powder lot is tracked by unique lot ID with full lifecycle log: virgin receipt date, sieve grade (15-45 µm / 45-90 µm), number of reuse cycles, and cumulative laser exposure time",
      "Laser diffraction particle size analysis (per ASTM B822) performed every 3 reuse cycles — ensuring D10, D50, D90 distribution remains within ±5% of virgin specification",
      "Interstitial gas analysis (LECO combustion method per ASTM E1409) for oxygen and nitrogen content at each lifecycle milestone — rejecting any lot exceeding O₂ ≤0.20% or N₂ ≤0.05% thresholds",
      "Closed-loop powder management system: used powder is automatically sieved, dried, and blended with virgin powder at controlled ratios before being returned to the feed hopper — maintaining consistent flowability and chemical composition across all production batches"
    ],
    icon: "M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"
  },
  {
    title: "SPC & Witness Bars Validation",
    problem: "Without inline quality verification, batch-to-batch mechanical property variation can go undetected until post-production destructive testing — risking entire production lots being rejected due to sub-surface porosity, inadequate densification, or unexpected variation in tensile properties across different build positions.",
    solution: "Statistical Process Control (SPC) & Printed Witness Bars per Build Platform",
    details: [
      "Standard mechanical tensile witness rods (per ASTM E8 / ASTM F2924) are printed alongside real parts on every build platform — positioned at platform corners and center to capture spatial variation across the build envelope",
      "Witness bars are extracted, machined to standard tensile specimen geometry, and tested on an in-house universal testing machine before batch cargo release — with results logged to the batch-specific quality dossier",
      "SPC charts (X-bar and R charts) maintained for: ultimate tensile strength, yield strength, elongation at break, and density — with upper/lower control limits (UCL/LCL) established from the first 30 production batches",
      "Automated process halt triggered if any witness bar result falls outside ±3σ control limits — requiring root cause investigation and corrective action before the batch can be released, ensuring zero-defect shipment"
    ],
    icon: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
  }
];
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.02]">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, var(--theme-primary) 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        Quality Assurance
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Inter-Batch <span style="color: var(--theme-primary);">{t('services.interbatchrepeatability.repeatability_control')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Strict batch-to-batch metallurgical control pipelines ensuring mechanical property consistency across every production run — from powder lifecycle to final mechanical validation.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {foci.map((focus) => (
        <div
          class="relative rounded-xl overflow-hidden h-full"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
        >
          <div class="p-8 pb-6">
            <div class="flex items-start mb-5">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mr-4" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
                <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={focus.icon} />
                </svg>
              </div>
              <h3 class="text-xl font-bold" style="color: var(--theme-text);">{focus.title}</h3>
            </div>
            <div class="pl-14">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">{t('services.interbatchrepeatability.challenge_11')}</span>
              <p class="text-sm mt-1.5 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{focus.problem}</p>
            </div>
          </div>

          <div class="relative flex items-center justify-center py-3">
            <div class="w-full h-px" style="background: linear-gradient(to right, transparent, color-mix(in srgb, var(--theme-primary) 30%, transparent), transparent);"></div>
            <div class="absolute flex items-center justify-center w-8 h-8 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);">
              <svg class="w-4 h-4" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
          </div>

          <div class="p-8 pt-4">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--theme-primary);">{t('services.interbatchrepeatability.solution_11')}</span>
            <h4 class="text-base font-bold mt-1.5 mb-4" style="color: var(--theme-text);">{focus.solution}</h4>
            <ul class="space-y-3">
              {focus.details.map((detail) => (
                <li class="flex items-start">
                  <svg class="w-4 h-4 mt-0.5 mr-3 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{detail}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden">
            <div class="absolute -top-8 -right-8 w-16 h-16 rotate-45" style="background: linear-gradient(135deg, transparent 50%, color-mix(in srgb, var(--theme-primary) 8%, transparent) 50%);"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>