---
interface Metric {
  label: string;
  value: string;
  unit: string;
  description: string;
  icon: string;
}

const metrics: Metric[] = [
  {
    label: "Minimum Beam Spot",
    value: "≤ 0.01",
    unit: "mm (10 µm)",
    description: "Precision laser focal tracking scaling down to ≤0.01 mm (10 µm) bounds — enabling ultra-fine text, micro-circuit traceability codes, and high-density DataMatrix cells.",
    icon: "M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
  },
  {
    label: "Marking Reposition Accuracy",
    value: "± 0.005",
    unit: "mm",
    description: "Multi-axis linear resolution held tightly within strict ±0.005 mm metrics — enabling repeatable marks across batch runs with zero positional drift.",
    icon: "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
  },
  {
    label: "Salt Spray Endurance",
    value: "1,000+",
    unit: "Hours",
    description: "Sustaining continuous cyclic salt spray testing exceeding 1,000+ hours zero-fading limits per ASTM B117 — annealed marks remain legible with no contrast degradation.",
    icon: "M9 3.75H6.912a2.25 2.25 0 00-2.15 1.588L2.35 13.177a2.25 2.25 0 00-.1.661V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 00-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 012.012 1.244l.256.512a2.25 2.25 0 002.013 1.244h3.218a2.25 2.25 0 002.013-1.244l.256-.512a2.25 2.25 0 012.013-1.244h3.859"
  },
  {
    label: "Compliance Certifications",
    value: "MIL-STD-130",
    unit: "UDI Compliant",
    description: "100% interlocked under MIL-STD-130 defense identification and UDI (Unique Device Identification) healthcare serialization mandates — full traceability documentation.",
    icon: "M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
  }
];
---
<section class="bg-[#0F172A]">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border border-[#38BDF8] text-[#38BDF8] bg-[#38BDF8]/10">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Marking Specifications
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-[#F8FAFC]">
        Laser Marking <span class="text-[#38BDF8]">Specifications Dashboard</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed text-[#F8FAFC]/65">
        Our laser marking processing resolutions — beam spot precision, reposition accuracy, environmental endurance, and defense/medical compliance certifications.
      </p>
    </div>

    <!-- Dashboard Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {metrics.map((metric) => (
        <div
          class="relative rounded-xl p-8 flex flex-col h-full bg-[#1E293B] border border-[#1E293B] hover:border-[#38BDF8] transition-all duration-300"
        >
          <!-- Icon -->
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-5 bg-[#38BDF8]/10">
            <svg class="w-5 h-5 text-[#38BDF8]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={metric.icon} />
            </svg>
          </div>

          <!-- Value — prominently styled tech-noir numbers -->
          <div class="mb-1">
            <span class="text-4xl md:text-5xl font-bold tracking-tight text-[#38BDF8]">
              {metric.value}
            </span>
            <span class="text-lg font-semibold ml-1 text-[#38BDF8]/70">
              {metric.unit}
            </span>
          </div>

          <!-- Label -->
          <h3 class="text-base font-bold mb-3 text-[#F8FAFC]">
            {metric.label}
          </h3>

          <!-- Description -->
          <p class="text-sm leading-relaxed mt-auto text-[#F8FAFC]/55">
            {metric.description}
          </p>

          <!-- Bottom accent line -->
          <div class="absolute bottom-0 left-6 right-6 h-px" style="background: linear-gradient(to right, transparent, #38BDF8, transparent); opacity: 0.2;"></div>
        </div>
      ))}
    </div>

    <!-- Footnote -->
    <div class="mt-12 text-center">
      <p class="text-sm text-[#F8FAFC]/40">
        All specifications measured under MIL-STD-130, ASTM B117, and 21 CFR Part 830 UDI standards. Actual results depend on titanium grade, surface finish, and marking parameters.
      </p>
    </div>
  </div>
</section>