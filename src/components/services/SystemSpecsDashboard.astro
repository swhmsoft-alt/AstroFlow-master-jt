---
interface SpecItem {
  label: string;
  value: string;
  unit: string;
  description: string;
  icon: string;
}

const specs: SpecItem[] = [
  {
    label: "Max Machining Footprint",
    value: "1,200 x 700 x 600",
    unit: "mm",
    description: "Large-scale industrial builds — accommodating oversized structural frames, vacuum chambers, and multi-port manifold blocks in a single clamping setup.",
    icon: "M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
  },
  {
    label: "Positional Cross-Hole Coaxiality",
    value: "≤0.01",
    unit: "mm",
    description: "Strict coaxiality control across intersecting cross-hole networks in valve bodies and fluid manifolds — verified with CMM full-dimensional mapping.",
    icon: "M9 3.75H6.912a2.25 2.25 0 00-2.15 1.588L2.35 13.177a2.25 2.25 0 00-.1.661V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 00-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 012.012 1.244l.256.512a2.25 2.25 0 002.013 1.244h3.218a2.25 2.25 0 002.013-1.244l.256-.512a2.25 2.25 0 012.013-1.244h3.859"
  },
  {
    label: "Final Assembly Fit Bounds",
    value: "±0.005",
    unit: "mm",
    description: "Micron-level matching for mating surfaces, dowel pin holes, and bolted interfaces — ensuring seamless field assembly without rework or shimming.",
    icon: "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
  },
  {
    label: "Specialized Fluid Testing",
    value: "Hydrostatic & Vacuum",
    unit: "in-house certified",
    description: "Full hydrostatic pressure testing up to 5,000 PSI and helium mass spectrometer vacuum leak detection — with NIST-traceable certification logs.",
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
  }
];
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---
<section style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        System Capacity
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Component <span style="color: var(--theme-primary);">{t('services.systemspecsdashboard.throughput_dashboard_2')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Our total component manufacturing capacity — from machining footprint to leak-tight testing verification.
      </p>
    </div>

    <!-- 4-Column Dashboard -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {specs.map((spec) => (
        <div
          class="relative rounded-xl p-8 flex flex-col h-full"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
        >
          <!-- Icon -->
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
            <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={spec.icon} />
            </svg>
          </div>

          <!-- Value -->
          <div class="mb-1">
            <span class="text-4xl md:text-5xl font-bold tracking-tight" style="color: var(--theme-primary);">
              {spec.value}
            </span>
            <span class="text-lg font-semibold ml-1" style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">
              {spec.unit}
            </span>
          </div>

          <!-- Label -->
          <h3 class="text-base font-bold mb-3" style="color: var(--theme-text);">
            {spec.label}
          </h3>

          <!-- Description -->
          <p class="text-sm leading-relaxed mt-auto" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
            {spec.description}
          </p>

          <!-- Bottom accent -->
          <div class="absolute bottom-0 left-6 right-6 h-px" style="background: linear-gradient(to right, transparent, var(--theme-primary), transparent); opacity: 0.2;"></div>
        </div>
      ))}
    </div>
  </div>
</section>