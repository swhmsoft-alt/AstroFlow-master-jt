---
interface Advantage {
  title: string;
  subtitle: string;
  description: string;
  highlights: string[];
  icon: string;
}

const advantages: Advantage[] = [
  {
    title: "Absolute Zero Heat-Affected Zone",
    subtitle: "Pure Supersonic Abrasive Erosion at Ambient Temperature",
    description: "Pure physical supersonic abrasive erosion keeping workpiece temperatures below 100°C — 100% bypassing thermal warp, phase hardening, micro-cracks, or heat-induced metallurgical transformations that plague laser and plasma cutting of titanium.",
    highlights: [
      "No HAZ, no recast layer, no alpha-case embrittlement — cut edges retain native material properties",
      "Zero thermal distortion — even on thin-gauge sheets down to 0.5 mm",
      "No phase transformations in heat-treated titanium alloys",
      "Ideal for thermally sensitive aerospace and medical components"
    ],
    icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
  },
  {
    title: "Exceptional Heavy-Plate Capacity",
    subtitle: "Slicing Titanium Forgings Up to 100 mm+",
    description: "Slicing through massive titanium forgings, billets, and heavy plates up to 120 mm thick — where commercial fiber lasers hit a physical roadblock at 12-20 mm and require multiple slow passes with gas-assist limitations.",
    highlights: [
      "Clean cuts through titanium up to 120 mm thick in a single pass",
      "No thickness limitations from laser power or focal length constraints",
      "Cuts stacked plates simultaneously for doubled throughput",
      "Handles forged, cast, and heat-treated titanium without tooling changes"
    ],
    icon: "M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
  },
  {
    title: "Material Yield Maximization",
    subtitle: "Fine Jet ø 1.0 mm + Advanced Nesting Code",
    description: "Fine abrasive jet streams down to ø 1.0 mm kerf width combined with advanced nesting algorithms — compressing expensive titanium material waste to near-theoretical minimums and maximizing part yield per billet.",
    highlights: [
      "Ultra-fine kerf ø 1.0 mm minimizes material loss between nested parts",
      "Advanced nesting code optimizes part layout for >90% material utilization",
      "Tight part-to-part spacing (2-3 mm) enabled by narrow jet stream",
      "Significant cost savings on high-value titanium plate stock"
    ],
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
  }
];
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        Waterjet Advantages
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Waterjet Cutting <span style="color: var(--theme-primary);">Process Advantages</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Cold abrasive waterjet cutting offers unique advantages for titanium that thermal processes cannot match — zero heat, unlimited thickness, and maximum material yield.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {advantages.map((adv) => (
        <div
          class="group relative rounded-xl p-8 flex flex-col h-full transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);"
          onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 10%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 18%, transparent)'; this.style.boxShadow='none'"
        >
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <svg class="w-6 h-6" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={adv.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-1" style="color: var(--theme-text);">{adv.title}</h3>
          <span class="text-sm font-medium mb-4 block" style="color: var(--theme-primary);">{adv.subtitle}</span>
          <p class="text-sm leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{adv.description}</p>
          <ul class="space-y-2 mt-auto">
            {adv.highlights.map((h) => (
              <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {h}
              </li>
            ))}
          </ul>
          <div
            class="absolute top-0 right-0 w-0 h-0 transition-all duration-300 rounded-tr-xl"
            style="border-style: solid; border-width: 0 0 0 0; border-color: transparent var(--theme-primary) transparent transparent; opacity: 0;"
            onmouseover="this.style.borderWidth='40px 40px 0 0'; this.style.opacity='1'"
            onmouseout="this.style.borderWidth='0 0 0 0'; this.style.opacity='0'"
          ></div>
        </div>
      ))}
    </div>
  </div>
</section>