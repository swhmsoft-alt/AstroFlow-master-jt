---
interface Process {
  title: string;
  subtitle: string;
  description: string;
  capabilities: string[];
  icon: string;
  href: string;
}

import { linkify } from '../../lib/auto-inline-links';
import { DEFAULT_LANG } from '../../i18n/ui';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const isEn = currentLang === DEFAULT_LANG;

const processes: Process[] = [
  {
    title: t('services.fabprocessspectrum.card1.title'),
    subtitle: t('services.fabprocessspectrum.card1.subtitle'),
    description: t('services.fabprocessspectrum.card1.desc'),
    capabilities: [
      t('services.fabprocessspectrum.card1.cap0'),
      t('services.fabprocessspectrum.card1.cap1'),
      t('services.fabprocessspectrum.card1.cap2'),
      t('services.fabprocessspectrum.card1.cap3')
    ],
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    href: localizePath('/titanium-fabrication-services/titanium-welding-assembly/', currentLang)
  },
  {
    title: t('services.fabprocessspectrum.card2.title'),
    subtitle: t('services.fabprocessspectrum.card2.subtitle'),
    description: t('services.fabprocessspectrum.card2.desc'),
    capabilities: [
      t('services.fabprocessspectrum.card2.cap0'),
      t('services.fabprocessspectrum.card2.cap1'),
      t('services.fabprocessspectrum.card2.cap2'),
      t('services.fabprocessspectrum.card2.cap3')
    ],
    icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z",
    href: localizePath('/titanium-fabrication-services/laser-cutting/', currentLang)
  },
  {
    title: t('services.fabprocessspectrum.card3.title'),
    subtitle: t('services.fabprocessspectrum.card3.subtitle'),
    description: t('services.fabprocessspectrum.card3.desc'),
    capabilities: [
      t('services.fabprocessspectrum.card3.cap0'),
      t('services.fabprocessspectrum.card3.cap1'),
      t('services.fabprocessspectrum.card3.cap2'),
      t('services.fabprocessspectrum.card3.cap3')
    ],
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
    href: localizePath('/titanium-fabrication-services/waterjet-cutting/', currentLang)
  }
];
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        {t('services.fabprocessspectrum.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Titanium Fabrication <span style="color: var(--theme-primary);">{t('services.fabprocessspectrum.process_spectrum_3')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {
          isEn
            ? <span set:html={linkify(t('services.fabprocessspectrum.subtitle') ?? '')} />
            : t('services.fabprocessspectrum.subtitle')
        }
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {processes.map((proc) => (
        <a
          href={proc.href}
          class="group relative rounded-xl p-8 flex flex-col h-full transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);"
          onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 10%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 18%, transparent)'; this.style.boxShadow='none'"
        >
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <svg class="w-6 h-6" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={proc.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-1" style="color: var(--theme-text);">{proc.title}</h3>
          <span class="text-sm font-medium mb-4 block" style="color: var(--theme-primary);" set:html={isEn ? linkify(proc.subtitle ?? '') : proc.subtitle}></span>
          <p class="text-sm leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);" set:html={isEn ? linkify(proc.description ?? '') : proc.description}></p>
          <ul class="space-y-2 mt-auto">
            {proc.capabilities.map((cap) => (
              <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {
                  isEn
                    ? <span set:html={linkify(cap ?? '')} />
                    : cap
                }
              </li>
            ))}
          </ul>

          <!-- Arrow indicator -->
          <div class="mt-6 flex items-center text-sm font-semibold transition-all" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">
            <span>{t('services.fabprocessspectrum.learnMore')}</span>
            <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>

          <div
            class="absolute top-0 right-0 w-0 h-0 transition-all duration-300 rounded-tr-xl"
            style="border-style: solid; border-width: 0 0 0 0; border-color: transparent var(--theme-primary) transparent transparent; opacity: 0;"
            onmouseover="this.style.borderWidth='40px 40px 0 0'; this.style.opacity='1'"
            onmouseout="this.style.borderWidth='0 0 0 0'; this.style.opacity='0'"
          ></div>
        </a>
      ))}
    </div>
  </div>
</section>