---
/**
 * TeamCredentials.astro
 *
 * EEAT (Experience + Expertise) block — engineering team depth, key stats,
 * and four engineering discipline areas.
 *
 * i18n: t(key) returns the localized string when present, falling back
 * to English otherwise.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface Stat { value: string; label: string; }
interface Cred { title: string; body: string; }

const stats: Stat[] = [
  { value: t('services.teamcredentials.stat1.value'), label: t('services.teamcredentials.stat1.label') },
  { value: t('services.teamcredentials.stat2.value'), label: t('services.teamcredentials.stat2.label') },
  { value: t('services.teamcredentials.stat3.value'), label: t('services.teamcredentials.stat3.label') },
  { value: t('services.teamcredentials.stat4.value'), label: t('services.teamcredentials.stat4.label') },
];

const creds: Cred[] = [
  { title: t('services.teamcredentials.cred1.title'), body: t('services.teamcredentials.cred1.body') },
  { title: t('services.teamcredentials.cred2.title'), body: t('services.teamcredentials.cred2.body') },
  { title: t('services.teamcredentials.cred3.title'), body: t('services.teamcredentials.cred3.body') },
  { title: t('services.teamcredentials.cred4.title'), body: t('services.teamcredentials.cred4.body') },
];

const badge = t('services.teamcredentials.badge');
const sectionTitle = t('services.teamcredentials.sectionTitle');
const sectionLede = t('services.teamcredentials.sectionLede');
const ctaNote = t('services.teamcredentials.ctaNote');
const ctaButton = t('services.teamcredentials.ctaButton');
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.04]" aria-hidden="true">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 80px 80px;"></div>
  </div>
  

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12 max-w-3xl mx-auto">
      <div
        class="inline-flex items-center px-4 py-2 mb-5 text-sm font-semibold rounded-full border"
        style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
        </svg>
        {badge}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-5 leading-tight" style="color: var(--theme-text);">
        {sectionTitle}
      </h2>
      <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {sectionLede}
      </p>
    </div>

    <!-- Stat row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      {stats.map((s) => (
        <div
          class="rounded-2xl p-5 text-center transition-all duration-300"
          style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 5%, var(--theme-surface))); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);"
          onmouseover="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 50%, transparent)'; this.style.transform='translateY(-4px)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 25%, transparent)'; this.style.transform='translateY(0)'"
        >
          <div class="text-3xl md:text-4xl font-bold mb-1" style="color: var(--theme-primary);">{s.value}</div>
          <div class="text-xs font-semibold uppercase tracking-wider leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{s.label}</div>
        </div>
      ))}
    </div>

    <!-- Four discipline areas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {creds.map((c) => (
        <div
          class="rounded-2xl p-6 transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 22%, transparent);"
          onmouseover="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 45%, transparent)'; this.style.transform='translateY(-3px)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 22%, transparent)'; this.style.transform='translateY(0)'"
        >
          <div class="flex items-center mb-3">
            <span
              class="w-10 h-10 rounded-lg flex items-center justify-center mr-3 font-bold"
              style="background: linear-gradient(135deg, var(--theme-primary), color-mix(in srgb, var(--theme-primary) 70%, #000)); color: #0F172A;"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.745 3.745 0 011.043 3.296A3.745 3.745 0 0121 12z" />
              </svg>
            </span>
            <h3 class="text-lg font-bold" style="color: var(--theme-text);">{c.title}</h3>
          </div>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{c.body}</p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div
      class="mt-10 rounded-xl p-6 md:p-7 flex flex-col md:flex-row md:items-center gap-4"
      style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 6%, var(--theme-surface))); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);"
    >
      <p class="text-sm md:text-base flex-1" style="color: var(--theme-text);">
        {ctaNote}
      </p>
      <a
        href="/rfq/"
        class="inline-flex items-center justify-center whitespace-nowrap px-6 py-3 rounded-lg font-bold text-sm transition-all duration-200 hover:-translate-y-0.5"
        style="background: linear-gradient(135deg, #ff8a3d 0%, #ff5a00 100%); color: #ffffff;"
      >
        {ctaButton}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>