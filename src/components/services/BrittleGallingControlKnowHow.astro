---
interface EngineeringFocus {
  title: string;
  problem: string;
  solution: string;
  details: string[];
  icon: string;
}

const foci: EngineeringFocus[] = [
  {
    title: "Atmospheric Oxygen Isolation",
    problem: "Titanium's extreme affinity for oxygen at welding temperatures (above 600°C) causes rapid alpha-case embrittlement — even trace O₂ at 200 ppm can reduce ductility by 50%. Conventional single-flow trailing shields are often insufficient for complex joints, allowing atmospheric ingress that produces blue/gray oxidized welds with brittle heat-affected zones.",
    solution: "Dynamic Sub-50 ppm O₂ Monitoring & Triple-Shield Argon Stream Deployment",
    details: [
      "Dual zirconia oxygen sensors positioned at the weld torch exit and the far edge of the trailing shield — maintaining continuous real-time monitoring with automated argon purge activation if O₂ exceeds 50 ppm threshold, preventing embrittlement before oxide formation begins",
      "Triple-shield argon deployment architecture: (1) pre-flow through the torch nozzle at 15-20 LPM establishes an inert zone before arc ignition; (2) trailing shield at 20-30 LPM blankets the solidifying weld pool and HAZ until cooling below 250°C; (3) backing purge at 10-15 LPM protects the weld root from atmospheric exposure on the underside of the joint",
      "Custom trailing shield geometries fabricated for each joint configuration — contoured to match complex pipe diameters, corner joints, and transition pieces — ensuring laminar argon flow across every millimeter of the solidifying weld zone",
      "Result: consistently silver/straw weld coloration meeting AWS D1.6 Class A acceptance criteria — zero oxide discoloration, zero alpha-case embrittlement, and mechanical properties matching the base metal"
    ],
    icon: "M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"
  },
  {
    title: "Galling Eradication & Spatial Calibration",
    problem: "Titanium's high coefficient of friction and tendency for cold-welding (galling) under pressure make threaded fastener assembly extremely challenging — titanium bolts and nuts seize during installation, causing thread stripping, clamp load inaccuracy, and field rework. Additionally, the low elastic modulus of titanium (114 GPa) makes welded assemblies prone to spatial drift during cooling, causing misaligned bolt patterns and interface mismatch.",
    solution: "Aerospace Anodization / Anti-Seize Lubricants & High-Rigidity Structural Jig Fixturing",
    details: [
      "Aerospace-grade anodization (Type II per AMS 2488) applied to threaded components before assembly — building a 2-5 µm dense oxide layer that eliminates titanium-to-titanium metal contact at thread interfaces, preventing cold-welding/galling during torque application",
      "Custom zero-silver anti-seize lubricant (molybdenum disulfide or boron nitride based) applied to all threaded fasteners per engineering specification — eliminating galling risk while maintaining consistent coefficient of friction for accurate torque-to-tension conversion",
      "Dynamic torque monitoring with ±1% accuracy transducer on every fastener — recording installed torque, turn angle, and calculated clamp load in real-time, with automatic alerts if galling onset is detected (torque spike without corresponding angle increase)",
      "High-rigidity structural jigs with cast-in datum references constraining all six degrees of freedom during welding and assembly cooling — preventing spatial drift and maintaining bolted interface alignment within ±0.05 mm spatial tolerance verified by post-assembly CMM inspection"
    ],
    icon: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
  }
];
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.02]">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, var(--theme-primary) 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        Process Control
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Brittle Layer & Galling <span style="color: var(--theme-primary);">Control Engineering</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Titanium welding and assembly demands uncompromising oxygen isolation and galling prevention. Here's how we ensure embrittlement-free welds and galling-free threaded assembly.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {foci.map((focus) => (
        <div
          class="relative rounded-xl overflow-hidden h-full"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
        >
          <div class="p-8 pb-6">
            <div class="flex items-start mb-5">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mr-4" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
                <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={focus.icon} />
                </svg>
              </div>
              <h3 class="text-xl font-bold" style="color: var(--theme-text);">{focus.title}</h3>
            </div>
            <div class="pl-14">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">The Challenge</span>
              <p class="text-sm mt-1.5 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{focus.problem}</p>
            </div>
          </div>

          <div class="relative flex items-center justify-center py-3">
            <div class="w-full h-px" style="background: linear-gradient(to right, transparent, color-mix(in srgb, var(--theme-primary) 30%, transparent), transparent);"></div>
            <div class="absolute flex items-center justify-center w-8 h-8 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);">
              <svg class="w-4 h-4" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
          </div>

          <div class="p-8 pt-4">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--theme-primary);">Our Solution</span>
            <h4 class="text-base font-bold mt-1.5 mb-4" style="color: var(--theme-text);">{focus.solution}</h4>
            <ul class="space-y-3">
              {focus.details.map((detail) => (
                <li class="flex items-start">
                  <svg class="w-4 h-4 mt-0.5 mr-3 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{detail}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden">
            <div class="absolute -top-8 -right-8 w-16 h-16 rotate-45" style="background: linear-gradient(135deg, transparent 50%, color-mix(in srgb, var(--theme-primary) 8%, transparent) 50%);"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>