---
/**
 * QualityControl.astro
 *
 * Trust Signals / Quality Control section — implements the EEAT requirement
 * from the landing-page brief.
 *
 *  - Inspection equipment: HEXAGON CMM (coordinate measuring machine) with
 *    quoted accuracy class
 *  - Material traceability: Mill Test Certificate (MTC) per EN 10204 / AS9100
 *  - Process certifications: ISO 9001 (general), AS9100D (aerospace),
 *    ISO 13485 (medical devices)
 *
 * i18n: t(key) returns the localized string when present, falling back to
 * English otherwise.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface CertItem {
  code: string;
  title: string;
  scope: string;
  issuer: string;
}

interface InspectionItem {
  metric: string;
  value: string;
  unit: string;
  note: string;
}

const inspections: InspectionItem[] = [
  {
    metric: t('services.qualitycontrol.inspection.metric'),
    value: t('services.qualitycontrol.inspection.value'),
    unit: t('services.qualitycontrol.inspection.unit'),
    note: t('services.qualitycontrol.inspection.note'),
  },
  {
    metric: t('services.qualitycontrol.surface.metric'),
    value: t('services.qualitycontrol.surface.value'),
    unit: t('services.qualitycontrol.surface.unit'),
    note: t('services.qualitycontrol.surface.note'),
  },
  {
    metric: t('services.qualitycontrol.mtc.metric'),
    value: t('services.qualitycontrol.mtc.value'),
    unit: t('services.qualitycontrol.mtc.unit'),
    note: t('services.qualitycontrol.mtc.note'),
  },
  {
    metric: t('services.qualitycontrol.fai.metric'),
    value: t('services.qualitycontrol.fai.value'),
    unit: t('services.qualitycontrol.fai.unit'),
    note: t('services.qualitycontrol.fai.note'),
  },
];

const certs: CertItem[] = [
  {
    code: t('services.qualitycontrol.cert1.code'),
    title: t('services.qualitycontrol.cert1.title'),
    scope: t('services.qualitycontrol.cert1.scope'),
    issuer: t('services.qualitycontrol.cert1.issuer'),
  },
  {
    code: t('services.qualitycontrol.cert2.code'),
    title: t('services.qualitycontrol.cert2.title'),
    scope: t('services.qualitycontrol.cert2.scope'),
    issuer: t('services.qualitycontrol.cert2.issuer'),
  },
  {
    code: t('services.qualitycontrol.cert3.code'),
    title: t('services.qualitycontrol.cert3.title'),
    scope: t('services.qualitycontrol.cert3.scope'),
    issuer: t('services.qualitycontrol.cert3.issuer'),
  },
];

const badge = t('services.qualitycontrol.badge');
const sectionTitle = t('services.qualitycontrol.sectionTitle');
const sectionLede = t('services.qualitycontrol.sectionLede');
const inspectionSectionTitle = t('services.qualitycontrol.inspection_section_title');
const inspectionSectionDesc = t('services.qualitycontrol.inspection_section_desc');
const certsSectionTitle = t('services.qualitycontrol.certs_section_title');
const mtcCalloutTitle = t('services.qualitycontrol.mtc_callout_title');
const mtcCalloutBody = t('services.qualitycontrol.mtc_callout_body');
const mtcCalloutCta = t('services.qualitycontrol.mtc_callout_cta');
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.04]" aria-hidden="true">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 80px 80px;"></div>
  </div>
  

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12 max-w-3xl mx-auto">
      <div
        class="inline-flex items-center px-4 py-2 mb-5 text-sm font-semibold rounded-full border"
        style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {badge}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-5 leading-tight" style="color: var(--theme-text);">
        {sectionTitle}
      </h2>
      <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {sectionLede}
      </p>
    </div>

    <!-- Inspection & Documentation Grid -->
    <div
      class="rounded-2xl p-8 md:p-10 mb-10 border"
      style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 4%, var(--theme-surface))); border-color: color-mix(in srgb, var(--theme-primary) 22%, transparent);"
    >
      <div class="flex items-start mb-6">
        <svg class="w-7 h-7 mr-3 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
        </svg>
        <div>
          <h3 class="text-2xl font-bold mb-2" style="color: var(--theme-text);">
            {inspectionSectionTitle}
          </h3>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            {inspectionSectionDesc}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {inspections.map((ins) => (
          <div
            class="rounded-xl p-5 transition-all duration-300"
            style="background-color: color-mix(in srgb, var(--theme-primary) 5%, var(--theme-surface)); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);"
            onmouseover="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 35%, transparent)'; this.style.transform='translateY(-3px)'"
            onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 18%, transparent)'; this.style.transform='translateY(0)'"
          >
            <div class="text-xs font-semibold uppercase tracking-widest mb-2" style="color: color-mix(in srgb, var(--theme-primary) 75%, transparent);">
              {ins.metric}
            </div>
            <div class="flex items-baseline mb-2">
              <span class="text-3xl font-bold" style="color: var(--theme-primary);">{ins.value}</span>
              <span class="ml-1 text-sm font-semibold" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{ins.unit}</span>
            </div>
            <p class="text-xs leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
              {ins.note}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Certifications -->
    <div>
      <h3 class="text-2xl font-bold mb-6 text-center" style="color: var(--theme-text);">
        {certsSectionTitle}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {certs.map((cert) => (
          <div
            class="rounded-2xl p-6 transition-all duration-300 flex flex-col h-full"
            style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 22%, transparent);"
            onmouseover="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 45%, transparent)'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 32px color-mix(in srgb, var(--theme-primary) 18%, transparent)'"
            onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 22%, transparent)'; this.style.transform='translateY(0)'; this.style.boxShadow=''"
          >
            <div
              class="w-fit mb-4 px-4 py-2 rounded-lg text-base font-bold tracking-wider"
              style="background: linear-gradient(135deg, var(--theme-primary), color-mix(in srgb, var(--theme-primary) 70%, #000)); color: #0F172A;"
            >
              {cert.code}
            </div>

            <h4 class="text-lg font-bold mb-2" style="color: var(--theme-text);">
              {cert.title}
            </h4>
            <p class="text-sm leading-relaxed flex-1 mb-4" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
              {cert.scope}
            </p>
            <div class="pt-4 flex items-center text-xs" style="border-top: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent); color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              <svg class="w-4 h-4 mr-1.5 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.745 3.745 0 011.043 3.296A3.745 3.745 0 0121 12z" />
              </svg>
              {cert.issuer}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- MTC callout -->
    <div
      class="mt-10 rounded-xl p-6 md:p-7 flex flex-col md:flex-row md:items-center gap-4"
      style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 6%, var(--theme-surface))); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);"
    >
      <div class="flex items-start flex-1">
        <svg class="w-6 h-6 mr-3 mt-0.5 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        <div>
          <div class="text-base font-bold mb-1" style="color: var(--theme-text);">
            {mtcCalloutTitle}
          </div>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            {mtcCalloutBody}
          </p>
        </div>
      </div>
      <a
        href="/rfq/"
        class="inline-flex items-center justify-center whitespace-nowrap px-6 py-3 rounded-lg font-bold text-sm transition-all duration-200 hover:-translate-y-0.5"
        style="background: linear-gradient(135deg, #ff8a3d 0%, #ff5a00 100%); color: #ffffff;"
      >
        {mtcCalloutCta}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>