---
/**
 * MultiAxisComparison.astro
 *
 * Per-axis capability cards for titanium CNC machining with SPECIFIC PART
 * EXAMPLES required by the landing-page brief.
 *
 *  3-Axis VMC:
 *     - Aerospace terminal boards, connector plates
 *     - Medical instrument handles (basic)
 *     - Consumer-electronics titanium parts (watch cases, phone frames)
 *
 *  4-Axis (3+1):
 *     - Titanium camshafts, shaft-type parts
 *     - Rotational slotted valve cores
 *     - Multi-face polyhedral control enclosures
 *
 *  5-Axis Simultaneous:
 *     - Aerospace blisks (integrally bladed rotors)
 *     - Aircraft structural beams / spars
 *     - Orthopedic implants — hip & knee prostheses, dental bridges
 *     - Racing turbocharger impellers
 *
 * All three cards are equally weighted — the brief elevates 5-axis as a
 * critical capability for aerospace & medical.
 *
 * i18n: t(key) returns the localized string when present, falling back to
 * English otherwise.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface AxisConfig {
  type: string;
  subtitle: string;
  description: string;
  applications: string[];
  strengths: string[];
  limitations: string;
  icon: string;
}

const icons = [
  // 3-axis: 4-square grid
  'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z',
  // 4-axis: 3 squares + dial
  'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM16 14a2 2 0 100 4 2 2 0 000-4z',
  // 5-axis: gear / multi-axis
  'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z',
];

const axisConfigs: AxisConfig[] = [
  {
    type: t('services.multiaxiscomparison.card1.type'),
    subtitle: t('services.multiaxiscomparison.card1.subtitle'),
    description: t('services.multiaxiscomparison.card1.description'),
    applications: [
      t('services.multiaxiscomparison.card1.app0'),
      t('services.multiaxiscomparison.card1.app1'),
      t('services.multiaxiscomparison.card1.app2'),
      t('services.multiaxiscomparison.card1.app3'),
    ],
    strengths: [
      t('services.multiaxiscomparison.card1.str0'),
      t('services.multiaxiscomparison.card1.str1'),
      t('services.multiaxiscomparison.card1.str2'),
    ],
    limitations: t('services.multiaxiscomparison.card1.limit'),
    icon: icons[0],
  },
  {
    type: t('services.multiaxiscomparison.card2.type'),
    subtitle: t('services.multiaxiscomparison.card2.subtitle'),
    description: t('services.multiaxiscomparison.card2.description'),
    applications: [
      t('services.multiaxiscomparison.card2.app0'),
      t('services.multiaxiscomparison.card2.app1'),
      t('services.multiaxiscomparison.card2.app2'),
      t('services.multiaxiscomparison.card2.app3'),
    ],
    strengths: [
      t('services.multiaxiscomparison.card2.str0'),
      t('services.multiaxiscomparison.card2.str1'),
      t('services.multiaxiscomparison.card2.str2'),
    ],
    limitations: t('services.multiaxiscomparison.card2.limit'),
    icon: icons[1],
  },
  {
    type: t('services.multiaxiscomparison.card3.type'),
    subtitle: t('services.multiaxiscomparison.card3.subtitle'),
    description: t('services.multiaxiscomparison.card3.description'),
    applications: [
      t('services.multiaxiscomparison.card3.app0'),
      t('services.multiaxiscomparison.card3.app1'),
      t('services.multiaxiscomparison.card3.app2'),
      t('services.multiaxiscomparison.card3.app3'),
    ],
    strengths: [
      t('services.multiaxiscomparison.card3.str0'),
      t('services.multiaxiscomparison.card3.str1'),
      t('services.multiaxiscomparison.card3.str2'),
    ],
    limitations: t('services.multiaxiscomparison.card3.limit'),
    icon: icons[2],
  },
];

const badge = t('services.multiaxiscomparison.badge');
const title = t('services.multiaxiscomparison.title');
const subtitle = t('services.multiaxiscomparison.subtitle');
const typicalApplications = t('services.multiaxiscomparison.typical_applications');
const keyStrengths = t('services.multiaxiscomparison.key_strengths');
const limitationsLabel = t('services.multiaxiscomparison.limitations_label');
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border"
        style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H" />
        </svg>
        {badge}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {title}
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {axisConfigs.map((axis) => (
        <div
          class="relative rounded-xl p-8 flex flex-col h-full transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);"
          onmouseover="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 35%, transparent)'; this.style.transform='translateY(-4px)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 18%, transparent)'; this.style.transform='translateY(0)'"
        >
          <div class="flex items-start mb-6">
            <div
              class="w-12 h-12 rounded-lg flex items-center justify-center shrink-0 mr-4"
              style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);"
            >
              <svg class="w-6 h-6" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={axis.icon} />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold" style="color: var(--theme-text);">
                {axis.type}
              </h3>
              <span class="text-sm font-medium" style="color: var(--theme-primary);">
                {axis.subtitle}
              </span>
            </div>
          </div>

          <p class="text-sm leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            {axis.description}
          </p>

          <div class="mb-5">
            <h4 class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">
              {typicalApplications}
            </h4>
            <ul class="space-y-2">
              {axis.applications.map((app) => (
                <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                  <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  {app}
                </li>
              ))}
            </ul>
          </div>

          <div class="mb-5">
            <h4 class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary);">
              {keyStrengths}
            </h4>
            <ul class="space-y-2">
              {axis.strengths.map((str) => (
                <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
                  <svg class="w-4 h-4 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {str}
                </li>
              ))}
            </ul>
          </div>

          <div
            class="mt-2 pt-4"
            style="border-top: 1px dashed color-mix(in srgb, var(--theme-primary) 25%, transparent);"
          >
            <div class="text-xs font-semibold uppercase tracking-widest mb-1.5" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              {limitationsLabel}
            </div>
            <p class="text-xs leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              {axis.limitations}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>