---
interface AxisConfig {
  type: string;
  subtitle: string;
  description: string;
  applications: string[];
  strengths: string[];
  icon: string;
  isHighlight?: boolean;
}

const axisConfigs: AxisConfig[] = [
  {
    type: "3/4-Axis CNC Machining",
    subtitle: "Prismatic & 2D/3D Contour Focus",
    description: "Ideal for prismatic block parts, 2D/3D face contours, drilled-hole patterns, and straight-line profiling where the workpiece can be indexed manually or via rotary table.",
    applications: [
      "Rectangular block & flange faces",
      "Drilled/tapped hole patterns on planar surfaces",
      "Slotting, pocketing, and step profiling",
      "Straight-wall prismatic enclosures"
    ],
    strengths: [
      "Cost-effective for medium-tolerance prismatic parts",
      "Faster cycle times for 2D-dominant geometries",
      "Simpler setup with standard fixturing"
    ],
    icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
  },
  {
    type: "Simultaneous 5-Axis CNC Machining",
    subtitle: "Single-Setup Complex Geometries",
    description: "Enables complex freeform geometries — impellers, turbine blades, orthopedic implants, and aerospace structural nodes — in a single clamping operation, eliminating cumulative repositioning errors entirely.",
    applications: [
      "Impellers, blisks, and turbine blades",
      "Orthopedic knee/hip implants & bone plates",
      "Aerospace structural nodes & bulkheads",
      "Multi-face ported valve bodies & manifolds"
    ],
    strengths: [
      "Single-setup eliminates stack-up errors from re-clamping",
      "Continuous tilt/rotation reaches undercuts inaccessible to 3/4-axis",
      "Superior surface finish via constant tool-to-part engagement angle"
    ],
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z",
    isHighlight: true
  }
];
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Engineering grid -->
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        </svg>
        Multi-Axis Capability
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        3/4-Axis vs <span style="color: var(--theme-primary);">{t('services.multiaxiscomparison.simultaneous_5axis')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Understanding the right axis configuration for your titanium component geometry — from prismatic blocks to complex freeform surfaces.
      </p>
    </div>

    <!-- 2-Column Comparison Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {axisConfigs.map((axis) => (
        <div
          class="relative rounded-xl p-8 flex flex-col h-full transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);"
          onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 10%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 18%, transparent)'; this.style.boxShadow='none'"
        >
          <!-- Icon & Type -->
          <div class="flex items-start mb-6">
            <div
              class="w-12 h-12 rounded-lg flex items-center justify-center shrink-0 mr-4"
              style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);"
            >
              <svg class="w-6 h-6" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={axis.icon} />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold" style="color: var(--theme-text);">
                {axis.type}
              </h3>
              <span class="text-sm font-medium" style="color: var(--theme-primary);">{axis.subtitle}</span>
            </div>
          </div>

          <!-- Description -->
          <p class="text-sm leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
            {axis.description}
          </p>

          <!-- Applications -->
          <div class="mb-6">
            <h4 class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">{t('services.multiaxiscomparison.typical_applications')}</h4>
            <ul class="space-y-2">
              {axis.applications.map((app) => (
                <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                  <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  {app}
                </li>
              ))}
            </ul>
          </div>

          <!-- Key Strengths -->
          <div class="mt-auto">
            <h4 class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--theme-primary);">{t('services.multiaxiscomparison.key_strengths')}</h4>
            <ul class="space-y-2">
              {axis.strengths.map((str) => (
                <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
                  <svg class="w-4 h-4 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {str}
                </li>
              ))}
            </ul>
          </div>

          <!-- Corner accent -->
          <div
            class="absolute top-0 right-0 w-0 h-0 transition-all duration-300 rounded-tr-xl"
            style="border-style: solid; border-width: 0 0 0 0; border-color: transparent var(--theme-primary) transparent transparent; opacity: 0;"
            onmouseover="this.style.borderWidth='40px 40px 0 0'; this.style.opacity='1'"
            onmouseout="this.style.borderWidth='0 0 0 0'; this.style.opacity='0'"
          ></div>
        </div>
      ))}
    </div>
  </div>
</section>