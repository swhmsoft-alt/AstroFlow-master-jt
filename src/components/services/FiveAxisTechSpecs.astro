---
interface SpecItem {
  label: string;
  value: string;
  unit: string;
  description: string;
  icon: string;
}

const specs: SpecItem[] = [
  {
    label: "5-Axis Work Envelope",
    value: "650",
    unit: "x 650 x 500 mm",
    description: "Linear travels (X/Y/Z) with A-axis rotation -120° to +120°, B/C-axis continuous 360° positioning for full 5-face access.",
    icon: "M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
  },
  {
    label: "Volumetric Geometric Accuracy",
    value: "≤0.005",
    unit: "mm",
    description: "Volumetric compensation via laser interferometer mapping ensures positional repeatability within 5 µm across the entire work envelope.",
    icon: "M9 3.75H6.912a2.25 2.25 0 00-2.15 1.588L2.35 13.177a2.25 2.25 0 00-.1.661V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 00-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 012.012 1.244l.256.512a2.25 2.25 0 002.013 1.244h3.218a2.25 2.25 0 002.013-1.244l.256-.512a2.25 2.25 0 012.013-1.244h3.859"
  },
  {
    label: "High-Torque Spindle Velocity",
    value: "12,000 - 18,000",
    unit: "RPM",
    description: "Dual-winding spindle motors delivering constant torque across the low-to-mid range, optimized for tough titanium and superalloy material removal rates.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z"
  },
  {
    label: "Minimal Thin-Wall Constraint",
    value: "0.5",
    unit: "mm",
    description: "Geometry-dependent thin-wall capability down to 0.5 mm using adaptive finishing passes, vibration-damped tooling, and low-impingement fixturing strategies.",
    icon: "M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
  }
];
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---
<section style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Engineering Specifications
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        5-Axis <span style="color: var(--theme-primary);">{t('services.fiveaxistechspecs.machine_platform')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Physical spindle and work-holding boundaries of our 5-axis machining centers — calibrated and verified for titanium aerospace and medical production.
      </p>
    </div>

    <!-- Specs Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {specs.map((spec) => (
        <div
          class="relative rounded-xl p-8 flex flex-col h-full"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
        >
          <!-- Icon -->
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
            <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={spec.icon} />
            </svg>
          </div>

          <!-- Prominent value display -->
          <div class="mb-1">
            <span class="text-4xl md:text-5xl font-bold tracking-tight" style="color: var(--theme-primary);">
              {spec.value}
            </span>
            <span class="text-lg font-semibold ml-1" style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">
              {spec.unit}
            </span>
          </div>

          <!-- Label -->
          <h3 class="text-base font-bold mb-3" style="color: var(--theme-text);">
            {spec.label}
          </h3>

          <!-- Description -->
          <p class="text-sm leading-relaxed mt-auto" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
            {spec.description}
          </p>

          <!-- Bottom accent -->
          <div class="absolute bottom-0 left-6 right-6 h-px" style="background: linear-gradient(to right, transparent, var(--theme-primary), transparent); opacity: 0.2;"></div>
        </div>
      ))}
    </div>

    <!-- Footnote -->
    <div class="mt-12 text-center">
      <p class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 40%, transparent);">
        Specifications apply to our DMG MORI / Mazak 5-axis machining centers. Actual achievable results depend on material grade, fixturing stiffness, and tooling selection.
      </p>
    </div>
  </div>
</section>