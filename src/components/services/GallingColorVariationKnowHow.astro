---
interface Challenge {
  title: string;
  problem: string;
  solution: string;
  solutionDetails: string[];
  icon: string;
}

const challenges: Challenge[] = [
  {
    title: "In-Situ Titanate Anti-Galling Barriers",
    problem: "Titanium's high galling propensity (µ ≈ 0.5–0.6) causes micro-welding and thread seizure under heavy locking torque in aerospace fasteners and medical implants, resulting in catastrophic joint failure and costly field rework.",
    solution: "Molecular-Bonded Porous Crystalline Nest Growth Under High Alkalinity",
    solutionDetails: [
      "High-alkaline electrolytic bath (pH 10–12) at 10–50 V DC grows molecular-bonded crystalline titanate nests directly into the titanium substrate surface",
      "Micro-porous crystalline structure (pore diameter 20–100 nm) provides permanent mechanical interlocking anchor points for dry-film lubricants (MoS₂, PTFE) with > 5× adhesion vs. untreated surfaces",
      "Permanent friction relief under heavy locking torque — verified zero seizure events across 25+ re-torque cycles per MIL-DLT-8937",
      "Process validated on Grade 5 (Ti-6Al-4V), Grade 23 (Ti-6Al-4V ELI), and Grade 2 titanium alloys with consistent µ < 0.2 results"
    ],
    icon: "M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"
  },
  {
    title: "Nanometer-Level Voltage Interference Control",
    problem: "Traditional DC rectification suffers from voltage ripple (±2–5 V) and bath temperature drift (±5°C), causing inconsistent oxide film growth that manifests as visible shade variation across batch runs — unacceptable for medical color-coding systems.",
    solution: "Synchronized Pulse DC Power Grids + Chilled Fluid Loops (±0.1 V / ±1°C)",
    solutionDetails: [
      "Synchronized pulse DC power supplies regulate voltage to ±0.1 V precision — eliminating ripple-induced thickness variation across the oxide interference film",
      "Closed-loop chilled electrolyte circulation maintains bath temperature at ±1°C (set point 15–25°C), preventing thermally-driven oxide growth rate deviations",
      "Voltage-to-color mapping library (5 V = gold, 25 V = blue, 45 V = purple, 65 V = green, 85 V = pink) enables repeatable shade targeting across infinite production runs",
      "Color difference measured via spectrophotometry: ΔE < 2.0 across entire batch — imperceptible to the human eye and compliant with medical instrument color-coding standards"
    ],
    icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
  }
];
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---
<section class="relative py-24 overflow-hidden bg-[#0F172A]">
  <!-- Circuit-board style background -->
  <div class="absolute inset-0 opacity-[0.02]">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, #38BDF8 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border border-[#38BDF8] text-[#38BDF8] bg-[#38BDF8]/10">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
        </svg>
        {t('services.gallingcolorvariationknowhow.engineering_know_how')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-[#F8FAFC]">
        Anti-Galling & <span class="text-[#38BDF8]">{t('services.gallingcolorvariationknowhow.color_variation_control')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed text-[#F8FAFC]/65">
        Two critical anodizing challenges — conquering titanium thread friction failure and eliminating cross-batch color shift through precision voltage and thermal regulation.
      </p>
    </div>

    <!-- Challenge Grid — 2-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {challenges.map((challenge) => (
        <div
          class="relative rounded-xl overflow-hidden h-full bg-[#1E293B] border border-[#1E293B] hover:border-[#38BDF8] transition-all duration-300"
        >
          <!-- Top problem zone -->
          <div class="p-8 pb-6">
            <div class="flex items-start mb-5">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mr-4 bg-[#38BDF8]/10">
                <svg class="w-5 h-5 text-[#38BDF8]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={challenge.icon} />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-[#F8FAFC]">
                {challenge.title}
              </h3>
            </div>

            <div class="pl-14">
              <!-- Problem statement -->
              <div class="mb-4">
                <span class="text-xs font-semibold uppercase tracking-widest text-[#38BDF8]/70">{t('services.gallingcolorvariationknowhow.challenge_6')}</span>
                <p class="text-sm mt-1.5 leading-relaxed text-[#F8FAFC]/65">
                  {challenge.problem}
                </p>
              </div>
            </div>
          </div>

          <!-- Divider with arrow -->
          <div class="relative flex items-center justify-center py-3">
            <div class="w-full h-px" style="background: linear-gradient(to right, transparent, rgba(56,189,248,0.3), transparent);"></div>
            <div class="absolute flex items-center justify-center w-8 h-8 rounded-full bg-[#38BDF8]/10 border border-[#38BDF8]/25">
              <svg class="w-4 h-4 text-[#38BDF8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
          </div>

          <!-- Solution zone -->
          <div class="p-8 pt-4">
            <div class="pl-0">
              <span class="text-xs font-semibold uppercase tracking-widest text-[#38BDF8]">{t('services.gallingcolorvariationknowhow.solution_6')}</span>
              <h4 class="text-base font-bold mt-1.5 mb-4 text-[#F8FAFC]">
                {challenge.solution}
              </h4>
              <ul class="space-y-3">
                {challenge.solutionDetails.map((detail) => (
                  <li class="flex items-start">
                    <svg class="w-4 h-4 mt-0.5 mr-3 shrink-0 text-[#38BDF8]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-sm leading-relaxed text-[#F8FAFC]/75">{detail}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Corner accent -->
          <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden">
            <div class="absolute -top-8 -right-8 w-16 h-16 rotate-45" style="background: linear-gradient(135deg, transparent 50%, rgba(56,189,248,0.08) 50%);"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA line -->
    <div class="text-center mt-12">
      <p class="text-sm max-w-2xl mx-auto leading-relaxed text-[#F8FAFC]/50">
        Every titanium anodizing project is backed by certified process documentation, precision DC power regulation, and continuous bath chemistry monitoring. <span class="text-[#38BDF8]">{t('services.gallingcolorvariationknowhow.precision_voltage_engineering_meets_repeatable')}</span>
      </p>
    </div>
  </div>
</section>