---
interface Process {
  title: string;
  subtitle: string;
  description: string;
  capabilities: string[];
  icon: string;
}

const processes: Process[] = [
  {
    title: "Monolithic Laser Micro-Scanning",
    subtitle: "Ytterbium Fiber Laser Focus ø 70 µm",
    description: "High-energy Yb-fiber laser with precision focus down to 70 µm spot diameter — enabling ultra-crisp resolution profiles, fine feature reproduction, and sharp internal geometries in titanium powder beds.",
    capabilities: [
      "Yb-fiber laser output up to 400 W with variable pulse shaping",
      "Spot focus diameter tunable ø 70–100 µm for feature resolution control",
      "Galvanometer scanning speeds up to 7 m/s for rapid hatch filling",
      "Multi-strategy scanning: chessboard, stripe, and island pattern modes"
    ],
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
  },
  {
    title: "Micro-Layer Powder Bed Fusion",
    subtitle: "Layer Thickness 20 – 40 µm",
    description: "Single-stroke recoater blade precisely deposits uniform powder layers with thickness tightly balanced between 20 µm and 40 µm — ensuring consistent melt pool dynamics and isotropic mechanical properties through the entire build height.",
    capabilities: [
      "Soft recoater blade system minimizes powder disruption on delicate features",
      "Layer thickness calibration within ±2 µm across full 250 mm platform",
      "Adaptive layer strategy: thin layers (20 µm) for fine surfaces, thick (40 µm) for core bulk",
      "Real-time melt pool monitoring for layer-to-layer consistency verification"
    ],
    icon: "M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
  },
  {
    title: "Complex Lattice & Organics Topology",
    subtitle: "Conformal Cooling, Lightweight Structures, Bio-Pores",
    description: "Flawless tracking of conformal cooling channels, organic lightweight lattice structures, and bio-implant porous networks — enabling design freedom impossible with subtractive manufacturing while maintaining full structural integrity.",
    capabilities: [
      "Gyroid, diamond, and custom TPMS lattice generation for lightweighting",
      "Conformal cooling channel networks with smooth curvilinear paths",
      "Bio-implant porous structures with controlled pore size (200–800 µm)",
      "Support generation optimized for minimal post-processing touch-points"
    ],
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
  }
];
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        </svg>
        SLM Process Mechanics
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        SLM Powder-Bed <span style="color: var(--theme-primary);">{t('services.slmprocessbreakdown.fusion_breakdown')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Three core mechanics powering our Selective Laser Melting process — from micro-laser scanning to complex topology generation.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {processes.map((proc) => (
        <div
          class="group relative rounded-xl p-8 flex flex-col h-full transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);"
          onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 10%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 18%, transparent)'; this.style.boxShadow='none'"
        >
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <svg class="w-6 h-6" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={proc.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-1" style="color: var(--theme-text);">{proc.title}</h3>
          <span class="text-sm font-medium mb-4 block" style="color: var(--theme-primary);">{proc.subtitle}</span>
          <p class="text-sm leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{proc.description}</p>
          <ul class="space-y-2 mt-auto">
            {proc.capabilities.map((cap) => (
              <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {cap}
              </li>
            ))}
          </ul>
          <div
            class="absolute top-0 right-0 w-0 h-0 transition-all duration-300 rounded-tr-xl"
            style="border-style: solid; border-width: 0 0 0 0; border-color: transparent var(--theme-primary) transparent transparent; opacity: 0;"
            onmouseover="this.style.borderWidth='40px 40px 0 0'; this.style.opacity='1'"
            onmouseout="this.style.borderWidth='0 0 0 0'; this.style.opacity='0'"
          ></div>
        </div>
      ))}
    </div>
  </div>
</section>