---
/**
 * QuickStatsBanner.astro
 *
 * Top-of-page credibility band — establishes EEAT (years, scale, certs)
 * and Buyer Decision Chain stage 1 (awareness: "this supplier actually exists
 * at scale, not a 2-person workshop").
 *
 * i18n: t(key) with English fallback.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface Stat { value: string; label: string; }

const stats: Stat[] = [
  { value: t('services.quickstats.stat1.value'), label: t('services.quickstats.stat1.label') },
  { value: t('services.quickstats.stat2.value'), label: t('services.quickstats.stat2.label') },
  { value: t('services.quickstats.stat3.value'), label: t('services.quickstats.stat3.label') },
  { value: t('services.quickstats.stat4.value'), label: t('services.quickstats.stat4.label') },
];

const updatedLabel = t('services.quickstats.lastUpdatedLabel');
const updatedValue = t('services.quickstats.lastUpdatedValue');
---

<section class="relative py-10" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 6%, var(--theme-surface)) 0%, var(--theme-surface) 100%); border-top: 1px solid color-mix(in srgb, var(--theme-primary) 20%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 20%, transparent);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {stats.map((s) => (
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold mb-1" style="color: var(--theme-primary);">{s.value}</div>
          <div class="text-xs md:text-sm font-semibold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{s.label}</div>
        </div>
      ))}
    </div>
    <div class="mt-6 text-center">
      <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
        <span style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{updatedLabel}:</span>
        {' '}
        <time datetime="2026-09-09" style="color: color-mix(in srgb, var(--theme-text) 80%, transparent); font-weight: 600;">{updatedValue}</time>
      </p>
    </div>
  </div>
</section>