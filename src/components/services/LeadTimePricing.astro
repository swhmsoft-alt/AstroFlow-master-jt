---
/**
 * LeadTimePricing.astro
 *
 * Transparent logistics section addressing the buyer decision-chain
 * "cost & time" stage. Standard lead times per axis configuration plus
 * the four pricing factors that shape per-part quotes.
 *
 * i18n: t(key) returns the localized string when present, falling back
 * to English otherwise.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface Row {
  config: string;
  lead: string;
  rush: string;
  cost: string;
}

const rows: Row[] = [
  {
    config: t('services.leadtime.row1.config'),
    lead: t('services.leadtime.row1.lead'),
    rush: t('services.leadtime.row1.rush'),
    cost: t('services.leadtime.row1.cost'),
  },
  {
    config: t('services.leadtime.row2.config'),
    lead: t('services.leadtime.row2.lead'),
    rush: t('services.leadtime.row2.rush'),
    cost: t('services.leadtime.row2.cost'),
  },
  {
    config: t('services.leadtime.row3.config'),
    lead: t('services.leadtime.row3.lead'),
    rush: t('services.leadtime.row3.rush'),
    cost: t('services.leadtime.row3.cost'),
  },
];

interface Factor {
  title: string;
  body: string;
}

const factors: Factor[] = [
  { title: t('services.leadtime.factor1.title'), body: t('services.leadtime.factor1.body') },
  { title: t('services.leadtime.factor2.title'), body: t('services.leadtime.factor2.body') },
  { title: t('services.leadtime.factor3.title'), body: t('services.leadtime.factor3.body') },
  { title: t('services.leadtime.factor4.title'), body: t('services.leadtime.factor4.body') },
];

const badge = t('services.leadtime.badge');
const sectionTitle = t('services.leadtime.sectionTitle');
const sectionLede = t('services.leadtime.sectionLede');
const tableHeaderConfig = t('services.leadtime.tableHeaderConfig');
const tableHeaderLead = t('services.leadtime.tableHeaderLead');
const tableHeaderRush = t('services.leadtime.tableHeaderRush');
const tableHeaderCost = t('services.leadtime.tableHeaderCost');
const factorHeader = t('services.leadtime.factorHeader');
const ctaNote = t('services.leadtime.ctaNote');
const ctaButton = t('services.leadtime.ctaButton');
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.04]" aria-hidden="true">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 80px 80px;"></div>
  </div>
  

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12 max-w-3xl mx-auto">
      <div
        class="inline-flex items-center px-4 py-2 mb-5 text-sm font-semibold rounded-full border"
        style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {badge}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-5 leading-tight" style="color: var(--theme-text);">
        {sectionTitle}
      </h2>
      <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {sectionLede}
      </p>
    </div>

    <!-- Lead Time Table -->
    <div class="overflow-x-auto mb-12">
      <table
        class="w-full border-collapse min-w-[720px]"
        style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 22%, transparent);"
      >
        <caption class="sr-only">Standard lead times, rush lead times, and relative cost index by axis configuration for titanium CNC machining orders.</caption>
        <thead>
          <tr
            style="background: linear-gradient(180deg, color-mix(in srgb, var(--theme-primary) 14%, transparent) 0%, color-mix(in srgb, var(--theme-primary) 6%, transparent) 100%); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 35%, transparent);"
          >
            <th scope="col" class="text-left px-5 py-4 text-sm font-semibold uppercase tracking-wider" style="color: var(--theme-text);">{tableHeaderConfig}</th>
            <th scope="col" class="text-left px-5 py-4 text-sm font-semibold uppercase tracking-wider" style="color: var(--theme-text);">{tableHeaderLead}</th>
            <th scope="col" class="text-left px-5 py-4 text-sm font-semibold uppercase tracking-wider" style="color: var(--theme-text);">{tableHeaderRush}</th>
            <th scope="col" class="text-left px-5 py-4 text-sm font-semibold uppercase tracking-wider" style="color: var(--theme-text);">{tableHeaderCost}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r, idx) => (
            <tr
              class="transition-colors"
              style={`border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent); ${idx === rows.length - 1 ? 'border-bottom: none;' : ''}`}
              onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 4%, transparent)'"
              onmouseout="this.style.backgroundColor='transparent'"
            >
              <td class="px-5 py-5 align-top">
                  <span class="font-bold text-sm" style="color: var(--theme-text);">{r.config}</span>
              </td>
              <td class="px-5 py-5 align-top">
                <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);">{r.lead}</p>
              </td>
              <td class="px-5 py-5 align-top">
                <p class="text-sm leading-relaxed font-semibold" style="color: var(--theme-primary);">{r.rush}</p>
              </td>
              <td class="px-5 py-5 align-top">
                <p class="text-sm leading-relaxed font-mono" style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);">{r.cost}</p>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Pricing Factors -->
    <div
      class="rounded-2xl p-6 md:p-10 border"
      style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 4%, var(--theme-surface))); border-color: color-mix(in srgb, var(--theme-primary) 22%, transparent);"
    >
      <h3 class="text-2xl md:text-3xl font-bold mb-6" style="color: var(--theme-text);">
        {factorHeader}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {factors.map((f, idx) => (
          <div
            class="rounded-xl p-5"
            style="background-color: color-mix(in srgb, var(--theme-primary) 5%, var(--theme-surface)); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);"
          >
            <div class="flex items-center mb-3">
              <span
                class="w-9 h-9 rounded-lg flex items-center justify-center mr-3 font-bold text-sm"
                style="background: linear-gradient(135deg, var(--theme-primary), color-mix(in srgb, var(--theme-primary) 70%, #000)); color: #0F172A;"
              >
                {idx + 1}
              </span>
              <h4 class="text-lg font-bold" style="color: var(--theme-text);">{f.title}</h4>
            </div>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{f.body}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Quick-quote CTA -->
    <div
      class="mt-10 rounded-xl p-6 md:p-7 flex flex-col md:flex-row md:items-center gap-4"
      style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 6%, var(--theme-surface))); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);"
    >
      <p class="text-sm md:text-base flex-1" style="color: var(--theme-text);">
        {ctaNote}
      </p>
      <a
        href="/rfq/"
        class="inline-flex items-center justify-center whitespace-nowrap px-6 py-3 rounded-lg font-bold text-sm transition-all duration-200 hover:-translate-y-0.5"
        style="background: linear-gradient(135deg, #ff8a3d 0%, #ff5a00 100%); color: #ffffff;"
      >
        {ctaButton}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>