---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface EngineeringFocus {
  title: string;
  problem: string;
  solution: string;
  details: string[];
  icon: string;
}

const cards = ['card1', 'card2'];
const icons = [
  "M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z",
  "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
];

const foci: EngineeringFocus[] = cards.map((card, idx) => ({
  title: t(`services.customcomponentsknowhow.${card}.title`) || (idx === 0 ? "Residual Stress Relief Engineering" : "100% Physical Pre-Assembly & Metrology Verification"),
  problem: t(`services.customcomponentsknowhow.${card}.problem`) || (idx === 0 ? "Large titanium components with aggressive material removal (pocket-scooping, deep cavity milling, multi-face machining) contain unbalanced residual stresses locked within the raw billet. When material is removed asymmetrically, these stresses redistribute — causing part warping, geometric distortion, and dimensional drift that can exceed 0.5 mm on critical mating surfaces." : "Complex multi-component assemblies (structural nodes, manifold blocks, vacuum chambers) often reveal mismatched hole patterns, misaligned bolt interfaces, and interference fits only during on-site final assembly — causing costly field rework, extended commissioning delays, and reputational risk for industrial projects."),
  solution: t(`services.customcomponentsknowhow.${card}.solution`) || (idx === 0 ? "Post-Roughing Stress-Relief Annealing & Dynamic Aging Cycles" : "Full CMM Dimensional Mapping & Physical Pin Alignment Checks Before Shipment"),
  details: [
    t(`services.customcomponentsknowhow.${card}.detail0`) || "",
    t(`services.customcomponentsknowhow.${card}.detail1`) || "",
    t(`services.customcomponentsknowhow.${card}.detail2`) || "",
    t(`services.customcomponentsknowhow.${card}.detail3`) || "",
  ].filter(Boolean),
  icon: icons[idx]
}));
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <!-- Dot matrix -->
  <div class="absolute inset-0 opacity-[0.02]">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, var(--theme-primary) 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        {t('services.customcomponentsknowhow.section_badge') || "Engineering Know-How"}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('services.customcomponentsknowhow.title_part1') || "Stress Control &"} <span style="color: var(--theme-primary);">{t('services.customcomponentsknowhow.integration_assurance')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t('services.customcomponentsknowhow.subtitle') || "Large non-standard titanium parts demand rigorous stress management and metrological verification. Here's how we prevent distortion and guarantee assembly fit."}
      </p>
    </div>

    <!-- 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {foci.map((focus) => (
        <div
          class="relative rounded-xl overflow-hidden h-full"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
        >
          <!-- Problem zone -->
          <div class="p-8 pb-6">
            <div class="flex items-start mb-5">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mr-4" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
                <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={focus.icon} />
                </svg>
              </div>
              <h3 class="text-xl font-bold" style="color: var(--theme-text);">{focus.title}</h3>
            </div>

            <div class="pl-14">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">{t('services.customcomponentsknowhow.challenge_4')}</span>
              <p class="text-sm mt-1.5 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{focus.problem}</p>
            </div>
          </div>

          <!-- Divider with arrow -->
          <div class="relative flex items-center justify-center py-3">
            <div class="w-full h-px" style="background: linear-gradient(to right, transparent, color-mix(in srgb, var(--theme-primary) 30%, transparent), transparent);"></div>
            <div class="absolute flex items-center justify-center w-8 h-8 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);">
              <svg class="w-4 h-4" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
          </div>

          <!-- Solution zone -->
          <div class="p-8 pt-4">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--theme-primary);">{t('services.customcomponentsknowhow.solution_4')}</span>
            <h4 class="text-base font-bold mt-1.5 mb-4" style="color: var(--theme-text);">{focus.solution}</h4>
            <ul class="space-y-3">
              {focus.details.map((detail) => (
                <li class="flex items-start">
                  <svg class="w-4 h-4 mt-0.5 mr-3 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{detail}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Corner accent -->
          <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden">
            <div class="absolute -top-8 -right-8 w-16 h-16 rotate-45" style="background: linear-gradient(135deg, transparent 50%, color-mix(in srgb, var(--theme-primary) 8%, transparent) 50%);"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>