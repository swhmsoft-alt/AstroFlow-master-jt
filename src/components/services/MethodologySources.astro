---
/**
 * MethodologySources.astro
 * ──────────────────────────────────────────────────────────────────────
 * Reusable methodology / sources disclosure block for service pages.
 *
 * Layout mirrors CncProcessSpectrum / CncTechnicalDashboard conventions:
 *   - Centered section header (badge + h2 + subtitle)
 *   - Stacked accordion items with numbered markers
 *   - Featured quote block at the bottom
 *
 * All copy is passed via `items` (title + body) — no internal narrative
 * literals — keeping this component reusable across pages.
 *
 * Zero client JS. Pure server-rendered Tailwind markup.
 */
interface MethodologyItem {
  title: string;
  body: string;
}

interface Props {
  badge: string;
  title: string;
  subtitle?: string;
  items: MethodologyItem[];
  quote?: string;
  quoteSource?: string;
}

const { badge, title, subtitle, items, quote, quoteSource } = Astro.props;
---

<section class="relative py-20 overflow-hidden" style="background-color: var(--theme-surface);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto">

      {/* ── Section header ─────────────────────────────────────────── */}
      <div class="text-center mb-10">
        <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border"
             style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          {badge}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold mb-4" style="color: var(--theme-text);">
          {title}
        </h2>
        {subtitle && (
          <p class="text-lg md:text-xl max-w-3xl mx-auto leading-relaxed"
             style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            {subtitle}
          </p>
        )}
      </div>

      {/* ── Accordion items ────────────────────────────────────────── */}
      <div class="space-y-4">
        {items.map((item, idx) => (
          <details class="group rounded-xl border p-5 md:p-6"
                   style="background-color: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
            <summary class="cursor-pointer font-semibold text-base md:text-lg flex items-center justify-between gap-3"
                     style="color: var(--theme-text); list-style: none;">
              <span class="flex items-center gap-3 min-w-0">
                <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-full text-xs font-bold"
                      style="background-color: color-mix(in srgb, var(--theme-primary) 14%, transparent); color: var(--theme-primary);">
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <span class="truncate">{item.title}</span>
              </span>
              <svg class="w-5 h-5 shrink-0 transition-transform group-open:rotate-180"
                   style="color: var(--theme-primary);"
                   fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-4 text-sm md:text-base leading-relaxed"
               style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
              {item.body}
            </p>
          </details>
        ))}
      </div>

      {/* ── Featured quote ─────────────────────────────────────────── */}
      {(quote || quoteSource) && (
        <blockquote class="mt-8 p-6 rounded-xl border-l-4"
                    style="background-color: color-mix(in srgb, var(--theme-primary) 5%, var(--theme-bg)); border-color: var(--theme-primary);">
          {quote && (
            <p class="text-sm md:text-base italic leading-relaxed"
               style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);">
              {quote}
            </p>
          )}
          {quoteSource && (
            <footer class="text-xs mt-3" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
              — {quoteSource}
            </footer>
          )}
        </blockquote>
      )}

    </div>
  </div>
</section>