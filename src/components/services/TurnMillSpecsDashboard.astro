---
interface SpecCategory {
  label: string;
  specs: { name: string; value: string; unit: string }[];
  icon: string;
}

const categories: SpecCategory[] = [
  {
    label: "CNC Turning Boundaries",
    icon: "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1",
    specs: [
      { name: "Max Turning Diameter", value: "ø 320", unit: "mm" },
      { name: "Max Turning Length", value: "500", unit: "mm" },
      { name: "Bar Capacity", value: "ø 65", unit: "mm" }
    ]
  },
  {
    label: "CNC Milling Boundaries",
    icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z",
    specs: [
      { name: "Work Table Size", value: "800 x 500", unit: "mm" },
      { name: "X/Y/Z Travel", value: "700 x 450 x 500", unit: "mm" },
      { name: "Spindle Taper", value: "BT40 / CAT40", unit: "" }
    ]
  },
  {
    label: "Universal Precision",
    icon: "M9 3.75H6.912a2.25 2.25 0 00-2.15 1.588L2.35 13.177a2.25 2.25 0 00-.1.661V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 00-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 012.012 1.244l.256.512a2.25 2.25 0 002.013 1.244h3.218a2.25 2.25 0 002.013-1.244l.256-.512a2.25 2.25 0 012.013-1.244h3.859",
    specs: [
      { name: "Tolerance Bounds", value: "±0.005", unit: "mm" },
      { name: "Surface Micro-Finish", value: "Ra 0.4", unit: "µm" },
      { name: "Repeatability", value: "≤0.003", unit: "mm" }
    ]
  }
];
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---
<section style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Technical Specifications
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Turn-Mill <span style="color: var(--theme-primary);">{t('services.turnmillspecsdashboard.machine_dashboard_2')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Our physical turning and milling machine boundaries — verified under ISO 2768-m and AS9100D protocols.
      </p>
    </div>

    <!-- Dashboard Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {categories.map((cat) => (
        <div
          class="relative rounded-xl p-8 flex flex-col h-full"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
        >
          <!-- Header with icon -->
          <div class="flex items-center mb-6">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mr-3" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
              <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={cat.icon} />
              </svg>
            </div>
            <h3 class="text-base font-bold" style="color: var(--theme-text);">{cat.label}</h3>
          </div>

          <!-- Specs -->
          <div class="space-y-5 mt-auto">
            {cat.specs.map((spec) => (
              <div>
                <span class="text-xs font-medium uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{spec.name}</span>
                <div class="mt-1">
                  <span class="text-3xl md:text-4xl font-bold tracking-tight" style="color: var(--theme-primary);">{spec.value}</span>
                  {spec.unit && (
                    <span class="text-base font-semibold ml-1" style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">{spec.unit}</span>
                  )}
                </div>
              </div>
            ))}
          </div>

          <!-- Bottom accent line -->
          <div class="absolute bottom-0 left-6 right-6 h-px" style="background: linear-gradient(to right, transparent, var(--theme-primary), transparent); opacity: 0.2;"></div>
        </div>
      ))}
    </div>
  </div>
</section>