---
interface Process {
  title: string;
  subtitle: string;
  description: string;
  capabilities: string[];
  icon: string;
}

const processes: Process[] = [
  {
    title: "2D Flat Sheet Laser Cutting",
    subtitle: "High-Kilowatt Fiber Laser for Titanium Plates",
    description: "Utilizing high-kilowatt fiber lasers for rapid cold-state profile profiling on pure and alloyed titanium plates — guaranteeing razor-sharp micro-mesh arrays, intricate internal cutouts, and weld-ready edge quality without secondary deburring.",
    capabilities: [
      "High-kW fiber laser sources optimized for titanium absorption spectrum",
      "Micro-mesh and fine-feature cutting down to ø 0.5 mm holes",
      "Rapid piercing and profile cutting with minimal HAZ (heat-affected zone)",
      "Large-format bed 3,000 x 1,500 mm accommodating full plate sizes"
    ],
    icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
  },
  {
    title: "3D Rotary Tube Laser Machining",
    subtitle: "Multi-Jaw Rotary Chucks for Complex Tube Profiles",
    description: "Equipped with synchronized multi-jaw rotary chucks to execute complex 3D intersecting fish-mouth profiles, slots, and holes over round, square, or rectangular titanium tubes — in a single clamping setup without positional error accumulation.",
    capabilities: [
      "Synchronized rotary chucks for continuous helical and index cutting",
      "3D fish-mouth, saddle, and slot profile cutting on round/square/rectangular tubes",
      "Tube diameter capacity ø 20 mm – ø 220 mm with 6,000 mm raw length",
      "Automatic tube loading and unloading for batch production runs"
    ],
    icon: "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
  }
];
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Laser Cutting Capabilities
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Sheet & Tube <span style="color: var(--theme-primary);">{t('services.laserprocessspectrum.laser_process_spectrum')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Dual-infrastructure laser cutting capability — from 2D flat sheet profiling to 3D rotary tube machining — covering the full titanium component geometry spectrum.
      </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {processes.map((proc) => (
        <div
          class="group relative rounded-xl p-8 flex flex-col h-full transition-all duration-300"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);"
          onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 10%, transparent)'"
          onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 18%, transparent)'; this.style.boxShadow='none'"
        >
          <div class="w-14 h-14 rounded-lg flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <svg class="w-7 h-7" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={proc.icon} />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-1" style="color: var(--theme-text);">{proc.title}</h3>
          <span class="text-sm font-medium mb-4 block" style="color: var(--theme-primary);">{proc.subtitle}</span>
          <p class="text-sm leading-relaxed mb-6" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{proc.description}</p>
          <ul class="space-y-2 mt-auto">
            {proc.capabilities.map((cap) => (
              <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {cap}
              </li>
            ))}
          </ul>
          <div
            class="absolute top-0 right-0 w-0 h-0 transition-all duration-300 rounded-tr-xl"
            style="border-style: solid; border-width: 0 0 0 0; border-color: transparent var(--theme-primary) transparent transparent; opacity: 0;"
            onmouseover="this.style.borderWidth='40px 40px 0 0'; this.style.opacity='1'"
            onmouseout="this.style.borderWidth='0 0 0 0'; this.style.opacity='0'"
          ></div>
        </div>
      ))}
    </div>
  </div>
</section>