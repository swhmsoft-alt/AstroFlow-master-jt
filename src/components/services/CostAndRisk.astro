---
/**
 * CostAndRisk — Buyer costAssessment + riskMitigation + fileProcess
 *                + decisionRfq + comparison + bestForPattern.
 *
 * Trinity Audit P0 fix:
 *   - Buyer.costAssessment  (cost drivers, not fake unit prices)
 *   - Buyer.riskMitigation  (warranty / RMA SLA / file chain)
 *   - Buyer.fileProcess     (DFM file checklist)
 *   - Buyer.decisionRfq     (decision checklist + dual CTA)
 *   - Buyer.comparison      (BOZE vs generic CNC shop table)
 *   - AI.bestForPattern     ("Best for" call-out)
 *   - AI.realTableElement   (comparison table)
 *   - EEAT.proprietaryFrame ("BOZE 5-Pillar DFM Framework™")
 *   - EEAT.teamAuthority    ("12 senior engineers")
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const costDrivers = [0, 1, 2, 3];
const risks = [0, 1, 2, 3];
const files = [0, 1, 2, 3, 4];
const decisions = [0, 1, 2, 3, 4];

const comparison = {
  boze: [0, 1, 2, 3, 4],
  generic: [0, 1, 2, 3, 4],
};
---

<section class="relative py-20 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.025]">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-6xl">

    {/* ── 05 — Cost drivers (Buyer.costAssessment) ── */}
    <header class="mb-10 text-center">
      <div class="inline-flex items-center px-4 py-2 mb-5 text-xs font-semibold rounded-full border tracking-wider uppercase" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-3.5 h-3.5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
        {t('services.cost.badge')}
      </div>
      <h2 class="text-3xl md:text-5xl font-bold mb-5" style="color: var(--theme-text);">
        <span class="text-base font-mono mr-2 align-top" style="color: var(--theme-primary);">05</span>
        {t('services.cost.h2_1')}<span class="gradient-text-accent"> {t('services.cost.h2_2')}</span>
      </h2>
      <p class="text-lg max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t('services.cost.lede')}
      </p>
    </header>

    <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
      {costDrivers.map((i) => (
        <li class="rounded-xl p-5 flex items-start" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <span class="text-xs font-mono font-bold mr-3 mt-0.5 shrink-0" style="color: var(--theme-primary);">05.0{i + 1}</span>
          <div>
            <h4 class="text-sm font-bold mb-1" style="color: var(--theme-text);">{t(`services.cost.driver${i}.title`)}</h4>
            <p class="text-xs leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{t(`services.cost.driver${i}.desc`)}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="text-xs italic text-center mb-14" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
      {t('services.cost.disclaimer')}
    </p>

    {/* ── 06 — Risk mitigation (Buyer.riskMitigation) ── */}
    <h3 class="text-2xl md:text-3xl font-bold mb-6" style="color: var(--theme-text);">
      <span class="text-sm font-mono mr-2 align-top" style="color: var(--theme-primary);">06</span>
      {t('services.risk.h2')}
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-14">
      {risks.map((i) => (
        <article class="rounded-xl p-5 flex" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mr-4 shrink-0" style="background-color: color-mix(in srgb, var(--theme-primary) 14%, transparent);">
            <svg class="w-5 h-5" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div>
            <h4 class="text-base font-bold mb-1" style="color: var(--theme-text);">{t(`services.risk.item${i}.title`)}</h4>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{t(`services.risk.item${i}.desc`)}</p>
          </div>
        </article>
      ))}
    </div>

    {/* ── 07 — DFM file checklist (Buyer.fileProcess) ── */}
    <h3 class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--theme-text);">
      <span class="text-sm font-mono mr-2 align-top" style="color: var(--theme-primary);">07</span>
      {t('services.file.h2')}
    </h3>
    <p class="text-sm mb-6 max-w-3xl" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{t('services.file.lede')}</p>
    <ol class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
      {files.map((i) => (
        <li class="rounded-lg p-4 flex items-start" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <span class="w-7 h-7 rounded-full flex items-center justify-center mr-3 shrink-0 text-xs font-bold" style="background-color: var(--theme-primary); color: #ffffff;">{i + 1}</span>
          <div>
            <h4 class="text-sm font-bold mb-1" style="color: var(--theme-text);">{t(`services.file.item${i}.title`)}</h4>
            <p class="text-xs leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{t(`services.file.item${i}.desc`)}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="text-xs mb-14" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">{t('services.file.footnote')}</p>

    {/* ── 08 — Proprietary framework + team (EEAT) ── */}
    <aside class="rounded-2xl p-7 md:p-9 mb-14" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 10%, transparent), color-mix(in srgb, var(--theme-primary) 2%, transparent)); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);">
      <p class="text-xs font-bold mb-3 uppercase tracking-widest" style="color: var(--theme-primary);">{t('services.cost.framework_label')}</p>
      <h3 class="text-2xl font-bold mb-3" style="color: var(--theme-text);">{t('services.cost.framework_title')}</h3>
      <p class="text-sm leading-relaxed mb-5 max-w-4xl" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{t('services.cost.framework_desc')}</p>
      <ul class="grid grid-cols-1 md:grid-cols-5 gap-3">
        {[0, 1, 2, 3, 4].map((i) => (
          <li class="text-center rounded-lg p-3" style="background-color: var(--theme-bg); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent);">
            <div class="text-xs font-mono font-bold mb-1" style="color: var(--theme-primary);">P{i + 1}</div>
            <div class="text-xs font-semibold" style="color: var(--theme-text);">{t(`services.cost.pillar${i}.title`)}</div>
          </li>
        ))}
      </ul>
      <div class="mt-6 pt-5 border-t flex flex-col md:flex-row md:items-center gap-3" style="border-color: color-mix(in srgb, var(--theme-primary) 18%, transparent);">
        <p class="text-sm font-bold" style="color: var(--theme-text);">{t('services.cost.team_label')}</p>
        <p class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">{t('services.cost.team_desc')}</p>
      </div>
    </aside>

    {/* ── 09 — Comparison table (Buyer.comparison + AI.realTableElement) ── */}
    <h3 class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--theme-text);">
      <span class="text-sm font-mono mr-2 align-top" style="color: var(--theme-primary);">09</span>
      {t('services.comparison.h2')}
    </h3>
    <p class="text-sm mb-6 max-w-3xl" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{t('services.comparison.lede')}</p>
    <div class="overflow-x-auto rounded-xl border mb-6" style="border-color: color-mix(in srgb, var(--theme-primary) 25%, transparent);">
      <table class="w-full text-sm">
        <caption class="sr-only">{t('services.comparison.table_caption')}</caption>
        <thead>
          <tr style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <th class="text-left py-3 px-4 font-semibold" style="color: var(--theme-text);">{t('services.comparison.th.criterion')}</th>
            <th class="text-left py-3 px-4 font-semibold" style="color: var(--theme-primary);">{t('services.comparison.th.boze')}</th>
            <th class="text-left py-3 px-4 font-semibold" style="color: var(--theme-text);">{t('services.comparison.th.generic')}</th>
          </tr>
        </thead>
        <tbody>
          {[0, 1, 2, 3, 4].map((i) => (
            <tr style={i % 2 === 0 ? 'background-color: var(--theme-surface);' : 'background-color: color-mix(in srgb, var(--theme-surface) 50%, var(--theme-bg));'}>
              <td class="py-3 px-4 font-semibold" style="color: var(--theme-text);">{t(`services.comparison.row${i}.crit`)}</td>
              <td class="py-3 px-4" style="color: color-mix(in srgb, var(--theme-text) 80%, transparent);">{t(`services.comparison.row${i}.boze`)}</td>
              <td class="py-3 px-4" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">{t(`services.comparison.row${i}.generic`)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* ── Best for pattern (AI.bestForPattern) ── */}
    <div class="rounded-xl p-5 mb-14" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);">
      <p class="text-xs font-bold mb-2 uppercase tracking-widest" style="color: var(--theme-primary);">{t('services.comparison.bestfor_label')}</p>
      <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{t('services.comparison.bestfor_text')}</p>
    </div>

    {/* ── 10 — RFQ decision checklist (Buyer.decisionRfq) ── */}
    <h3 class="text-2xl md:text-3xl font-bold mb-6 text-center" style="color: var(--theme-text);">
      <span class="text-sm font-mono mr-2 align-top" style="color: var(--theme-primary);">10</span>
      {t('services.rfq.h2')}
    </h3>
    <ol class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-8 max-w-4xl mx-auto">
      {decisions.map((i) => (
        <li class="rounded-lg p-4 flex items-start" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <svg class="w-5 h-5 mr-3 mt-0.5 shrink-0" fill="none" stroke="#059669" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span class="text-sm" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{t(`services.rfq.check${i}`)}</span>
        </li>
      ))}
    </ol>

    {/* ── Dual CTA ── */}
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="/rfq/" rel="noopener" class="inline-flex items-center px-7 py-3.5 text-base font-semibold rounded-lg shadow-md transition-all" style="background-color: var(--theme-primary); color: #ffffff;">
        {t('services.rfq.cta_primary')}
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
      <a href="/rfq/?expedited=1" rel="noopener" class="inline-flex items-center px-7 py-3.5 text-base font-semibold rounded-lg transition-all" style="background-color: transparent; color: var(--theme-primary); border: 2px solid var(--theme-primary);">
        {t('services.rfq.cta_expedited')}
      </a>
    </div>
  </div>
</section>