---
interface MarkingProcess {
  title: string;
  description: string;
  capabilities: string[];
  icon: string;
}

import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const processes: MarkingProcess[] = [
  {
    title: t('services.markingprocessspectrum.card1.title'),
    description: t('services.markingprocessspectrum.card1.desc'),
    capabilities: [
      t('services.markingprocessspectrum.card1.cap0'),
      t('services.markingprocessspectrum.card1.cap1'),
      t('services.markingprocessspectrum.card1.cap2'),
      t('services.markingprocessspectrum.card1.cap3')
    ],
    icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
  },
  {
    title: t('services.markingprocessspectrum.card2.title'),
    description: t('services.markingprocessspectrum.card2.desc'),
    capabilities: [
      t('services.markingprocessspectrum.card2.cap0'),
      t('services.markingprocessspectrum.card2.cap1'),
      t('services.markingprocessspectrum.card2.cap2'),
      t('services.markingprocessspectrum.card2.cap3')
    ],
    icon: "M13 10V3L4 14h7v7l9-11h-7z"
  },
  {
    title: t('services.markingprocessspectrum.card3.title'),
    description: t('services.markingprocessspectrum.card3.desc'),
    capabilities: [
      t('services.markingprocessspectrum.card3.cap0'),
      t('services.markingprocessspectrum.card3.cap1'),
      t('services.markingprocessspectrum.card3.cap2'),
      t('services.markingprocessspectrum.card3.cap3')
    ],
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
  }
];
---
<section class="relative py-24 overflow-hidden bg-theme-bg">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border border-theme-primary text-theme-primary bg-theme-primary/10">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        </svg>
        {t('services.markingprocessspectrum.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-theme-text">
        {t('services.markingprocessspectrum.title_prefix')}<span class="text-theme-primary">{t('services.markingprocessspectrum.process_spectrum_6')}</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed text-theme-text/65">
        {t('services.markingprocessspectrum.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {processes.map((process) => (
        <div class="group relative rounded-xl p-8 transition-all duration-300 flex flex-col h-full bg-theme-surface border border-theme-surface hover:border-theme-primary hover:shadow-[0_0_30px_color-mix(in_srgb,var(--theme-primary)_10%,transparent)]">
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5 bg-theme-primary/10">
            <svg class="w-6 h-6 text-theme-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={process.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-3 text-theme-text">{process.title}</h3>
          <p class="text-sm mb-4 leading-relaxed text-theme-text/60">{process.description}</p>
          <ul class="space-y-2 mt-auto">
            {process.capabilities.map((cap) => (
              <li class="flex items-start text-sm text-theme-text/70">
                <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0 text-theme-primary" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {cap}
              </li>
            ))}
          </ul>
          <div class="absolute top-0 right-0 w-0 h-0 transition-all duration-300 rounded-tr-xl" style="border-style: solid; border-color: transparent var(--theme-primary) transparent transparent; opacity: 0;" onmouseover="this.style.borderWidth='40px 40px 0 0'; this.style.opacity='1'" onmouseout="this.style.borderWidth='0 0 0 0'; this.style.opacity='0'"></div>
        </div>
      ))}
    </div>
  </div>
</section>