---
/**
 * FaqSection.astro
 *
 * Buyer-decision-support FAQ block.
 *
 * Designed for maximum GenAI / Google-SGE citation:
 *   - 10 Q&A pairs in <details>/<summary> for readability
 *   - JSON-LD FAQPage schema injected inline (matches visible content)
 *   - Concrete numeric answers liftable as direct AI responses
 *
 * i18n: t(key) returns the localized string when present, falling back
 * to English otherwise.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface QA {
  q: string;
  a: string;
}

const items: QA[] = [
  { q: t('services.faq.q1'), a: t('services.faq.a1') },
  { q: t('services.faq.q2'), a: t('services.faq.a2') },
  { q: t('services.faq.q3'), a: t('services.faq.a3') },
  { q: t('services.faq.q4'), a: t('services.faq.a4') },
  { q: t('services.faq.q5'), a: t('services.faq.a5') },
  { q: t('services.faq.q6'), a: t('services.faq.a6') },
  { q: t('services.faq.q7'), a: t('services.faq.a7') },
  { q: t('services.faq.q8'), a: t('services.faq.a8') },
  { q: t('services.faq.q9'), a: t('services.faq.a9') },
  { q: t('services.faq.q10'), a: t('services.faq.a10') },
];

const badge = t('services.faq.badge');
const sectionTitle = t('services.faq.sectionTitle');
const sectionLede = t('services.faq.sectionLede');

// Build JSON-LD payload (visible content mirrors this structure)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: it.a,
    },
  })),
};
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.04]" aria-hidden="true">
    <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 80px 80px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12 max-w-3xl mx-auto">
      <div
        class="inline-flex items-center px-4 py-2 mb-5 text-sm font-semibold rounded-full border"
        style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {badge}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-5 leading-tight" style="color: var(--theme-text);">
        {sectionTitle}
      </h2>
      <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {sectionLede}
      </p>
    </div>

    <div class="max-w-4xl mx-auto space-y-4">
      {items.map((it, idx) => (
        <details
          class="group rounded-xl overflow-hidden border transition-all duration-200"
          style="background-color: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-primary) 22%, transparent);"
          open={idx === 0}
        >
          <summary
            class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-bold text-base md:text-lg list-none"
            style="color: var(--theme-text);"
            onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
            onmouseout="this.style.backgroundColor='transparent'"
          >
            <span class="flex items-start">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg mr-4 shrink-0 text-xs font-bold" style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">Q{idx + 1}</span>
              <span class="leading-snug">{it.q}</span>
            </span>
            <svg class="w-5 h-5 shrink-0 transition-transform group-open:rotate-180" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-6 pt-2 text-sm md:text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">
            {it.a}
          </div>
        </details>
      ))}
    </div>

    <div
      class="mt-10 max-w-4xl mx-auto rounded-xl p-6 md:p-7 flex flex-col md:flex-row md:items-center gap-4"
      style="background: linear-gradient(135deg, var(--theme-surface), color-mix(in srgb, var(--theme-primary) 4%, var(--theme-surface))); border: 1px solid color-mix(in srgb, var(--theme-primary) 22%, transparent);"
    >
      <p class="text-sm md:text-base flex-1" style="color: var(--theme-text);">
        Didn't see your question? Our engineering team responds to technical RFQ inquiries within 24 hours.
      </p>
      <a
        href="/rfq/"
        class="inline-flex items-center justify-center whitespace-nowrap px-6 py-3 rounded-lg font-bold text-sm transition-all duration-200 hover:-translate-y-0.5"
        style="background: linear-gradient(135deg, #ff8a3d 0%, #ff5a00 100%); color: #ffffff;"
      >
        Ask the Engineers
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>