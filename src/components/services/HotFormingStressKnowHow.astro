---
interface EngineeringFocus {
  title: string;
  problem: string;
  solution: string;
  details: string[];
  icon: string;
}

const foci: EngineeringFocus[] = [
  {
    title: "Thermal Forming & Spring-Back Micro-Compensation",
    problem: "Titanium's high strength-to-modulus ratio (UTS 950 MPa vs. elastic modulus 114 GPa) causes extreme spring-back during cold forming — where the material elastically recovers 15-30% of the bend angle after the forming load is released. On thick plates (10-50 mm), this spring-back is highly nonlinear and geometry-dependent, making conventional over-bend allowances inaccurate and causing costly dimensional rework.",
    solution: "Localized Infrared Heating (600-800°C) & Finite Element Spring-Back Modeling",
    details: [
      "Localized infrared heating arrays target the bend zone exclusively, raising the titanium temperature to 600-800°C — the optimal hot-forming window where ductility increases by 300% and yield strength drops by 60%, dramatically reducing spring-back magnitude and enabling tight-radius bends without cracking",
      "Finite Element Analysis (FEA) spring-back prediction models simulate the complete forming cycle: heating profile, creep forming during the soak period, elastic recovery during cooling, and final geometry — generating compensated tool geometries that counter the predicted offset before the first part is formed",
      "Iterative over-bend compensation: the FEA model's predicted spring-back angle is fed into the press brake controller as an automated over-bend offset (typically 3-12° depending on plate thickness, bend radius, and temperature), reducing the trial-and-error cycle from 3-5 iterations to a single validated setup",
      "Result: ±0.5° angular accuracy on hot-formed heavy titanium plates — eliminating secondary straightening operations and ensuring fit-up compliance with mating structural components"
    ],
    icon: "M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"
  },
  {
    title: "Full-Scale Vacuum Stress-Relief Thermal Cycles",
    problem: "Heavy titanium plate rolling, forging, and welding operations introduce massive residual stresses — from the non-uniform plastic deformation during forming (rolling stresses up to 60% of yield), thermal contraction stresses in multi-pass weld seams, and stress concentration at formed radius transitions. If not relieved, these locked-in stresses cause delayed distortion during machining, dimensional drift over time, and unpredictable performance under deep-sea hyperbaric or cyclic fatigue loading.",
    solution: "Multi-Meter Computerized Vacuum Annealing Furnace — 95%+ Stress Elimination",
    details: [
      "Full-scale vacuum annealing furnace with usable chamber dimensions accommodating components up to 12,000 x 4,500 x 4,000 mm — the entire fabricated structure is stress-relieved in a single thermal cycle, eliminating the need for localized or segmented stress relief",
      "Computerized thermal cycle control with ±5°C uniformity across the entire workload: ramp to 540-650°C at 50°C/hour, soak for 1 hour per 25 mm of thickness, cool at 50°C/hour to 300°C, then natural convection to room temperature — ensuring complete stress relaxation without thermal gradient-induced distortion",
      "Vacuum atmosphere maintained at ≤10⁻⁵ mbar throughout the entire thermal cycle — preventing any surface oxidation, alpha-case formation, or discoloration on the titanium components, eliminating the need for post-relief chemical cleaning or mechanical scale removal",
      "Result: 95%+ of residual welding and forming stresses eliminated — verified by sectioning and strain gauge measurement per ASTM E837. Structures maintain dimensional stability through subsequent machining, transport, installation, and in-service thermal cycling under deep-sea hyperbaric or cryogenic conditions"
    ],
    icon: "M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"
  }
];
---
<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.02]">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, var(--theme-primary) 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
        </svg>
        Process Engineering
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        Hot Forming & Stress <span style="color: var(--theme-primary);">Relief Know-How</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        Conquering heavy titanium spring-back and structural warp requires thermal-mechanical modeling and full-scale vacuum stress relief. Here's how we achieve dimensional stability on multi-ton structures.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {foci.map((focus) => (
        <div
          class="relative rounded-xl overflow-hidden h-full"
          style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
        >
          <div class="p-8 pb-6">
            <div class="flex items-start mb-5">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mr-4" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
                <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={focus.icon} />
                </svg>
              </div>
              <h3 class="text-xl font-bold" style="color: var(--theme-text);">{focus.title}</h3>
            </div>
            <div class="pl-14">
              <span class="text-xs font-semibold uppercase tracking-widest" style="color: color-mix(in srgb, var(--theme-primary) 70%, transparent);">The Challenge</span>
              <p class="text-sm mt-1.5 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{focus.problem}</p>
            </div>
          </div>

          <div class="relative flex items-center justify-center py-3">
            <div class="w-full h-px" style="background: linear-gradient(to right, transparent, color-mix(in srgb, var(--theme-primary) 30%, transparent), transparent);"></div>
            <div class="absolute flex items-center justify-center w-8 h-8 rounded-full" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 25%, transparent);">
              <svg class="w-4 h-4" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
          </div>

          <div class="p-8 pt-4">
            <span class="text-xs font-semibold uppercase tracking-widest" style="color: var(--theme-primary);">Our Solution</span>
            <h4 class="text-base font-bold mt-1.5 mb-4" style="color: var(--theme-text);">{focus.solution}</h4>
            <ul class="space-y-3">
              {focus.details.map((detail) => (
                <li class="flex items-start">
                  <svg class="w-4 h-4 mt-0.5 mr-3 shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{detail}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden">
            <div class="absolute -top-8 -right-8 w-16 h-16 rotate-45" style="background: linear-gradient(135deg, transparent 50%, color-mix(in srgb, var(--theme-primary) 8%, transparent) 50%);"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>