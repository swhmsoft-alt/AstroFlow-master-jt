---
/**
 * CncProcessSpectrum.astro
 *
 * Dual-purpose grid section used on the /titanium-cnc-machining-services/ hub:
 *
 *   variant="process" (default) — 4-card grid of CNC PROCESS capabilities
 *     (3/5-Axis, Milling & Turning, Wire EDM, Custom Industrial Components)
 *     This is the original CncProcessSpectrum behaviour and is unchanged.
 *
 *   variant="grade"              — 10-card grid of TITANIUM GRADE machining
 *     services. One card per grade sub-page (Grade 2 / 4 / 5 / 6 / 7 / 8 / 9
 *     / 12 / 21 / 23), so the hub page acts as a complete buyer-facing
 *     index of every grade sub-page. Combined with the 3-grade top-nav
 *     slim-down, this satisfies the Buyer Search Intelligence rule that
 *     every sub-page must have an inbound link from the parent hub
 *     (no orphan pages).
 *
 * 2026-10-14 — added variant="grade" branch. Existing 4-card variant
 * untouched. No new component file (F2: do not create a new component
 * for a single page); this extends the existing one.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  variant?: 'process' | 'grade';
}
const { variant = 'process' } = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// ============ PROCESS VARIANT DATA (existing 4-card layout) ============
const processIndices = [0, 1, 2, 3];

const icons: string[] = [
  "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z",
  "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z",
  "M13 10V3L4 14h7v7l9-11h-7z",
  "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
];

const capKeys: string[][] = [
  ['services.cncprocessspectrum.0.cap0', 'services.cncprocessspectrum.0.cap1', 'services.cncprocessspectrum.0.cap2', 'services.cncprocessspectrum.0.cap3'],
  ['services.cncprocessspectrum.1.cap0', 'services.cncprocessspectrum.1.cap1', 'services.cncprocessspectrum.1.cap2', 'services.cncprocessspectrum.1.cap3'],
  ['services.cncprocessspectrum.2.cap0', 'services.cncprocessspectrum.2.cap1', 'services.cncprocessspectrum.2.cap2', 'services.cncprocessspectrum.2.cap3'],
