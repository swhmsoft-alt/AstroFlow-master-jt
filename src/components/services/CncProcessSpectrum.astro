const hrefs: string[] = [
  '/titanium-cnc-machining-services/3-5-axis-cnc-machining/',
  '/titanium-cnc-machining-services/cnc-milling-turning/',
  '/titanium-cnc-machining-services/wire-edm-machining/',
  '/titanium-cnc-machining-services/custom-industrial-components/'
];

// ============ GRADE VARIANT DATA (10-card layout) ============
// 10 grade sub-pages that exist under /titanium-cnc-machining-services/.
// Three of them (Grade 2 / 5 / 23) are flagged `featured: true` because they
// also appear in the top navigation dropdown — the star badge on those cards
// reinforces the "this is a flagship grade" signal to the buyer.
//
// accentColor follows the same five-bucket metallurgical taxonomy used by
// src/components/materials/MaterialGradeMatrix.astro so the two pages look
// coherent when buyers navigate between /materials/ and the CNC hub.
interface GradeCard {
  key: 'g2' | 'g4' | 'g5' | 'g6' | 'g7' | 'g8' | 'g9' | 'g12' | 'g21' | 'g23';
  href: string;
  gradeNumber: string;     // e.g. "2", "5", "23"
  alloyName: string;       // e.g. "Ti-6Al-4V"
  uns: string;             // e.g. "UNS R56400"
  categoryKey: 'cp' | 'alpha' | 'alpha-beta' | 'near-alpha' | 'beta' | 'pd-stabilized' | 'improved-cp';
  categoryLabel: string;   // English short label, also surfaced as eyebrow
  accentColor: string;     // hex
  accentColorDark: string; // hex (used in gradient)
  standards: string[];    // 3 short codes
  featured: boolean;
  appKey: string;          // i18n key for the 1-line application summary
}

const gradeCards: GradeCard[] = [
