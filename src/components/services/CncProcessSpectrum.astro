    accentColorDark: '#1e40af',
    standards: ['ASTM B348', 'ASTM B265', 'ASTM B338'],
    featured: true,
    appKey: 'services.cncgradehub.cards.g2.app',
  },
  {
    key: 'g4',
    href: '/titanium-cnc-machining-services/grade-4-titanium-cnc-machining/',
    gradeNumber: '4',
    alloyName: 'CP-Titanium (high O)',
    uns: 'UNS R50700',
    categoryKey: 'cp',
    categoryLabel: 'Commercially Pure',
    accentColor: '#3b82f6',
    accentColorDark: '#1e40af',
    standards: ['ASTM B348', 'ASTM B265', 'ASTM B338'],
    featured: false,
    appKey: 'services.cncgradehub.cards.g4.app',
  },
  {
    key: 'g5',
    href: '/titanium-cnc-machining-services/grade-5-titanium-cnc-machining/',
    gradeNumber: '5',
    alloyName: 'Ti-6Al-4V',
    uns: 'UNS R56400',
    categoryKey: 'alpha-beta',
    categoryLabel: 'Alpha-Beta Alloy',
    accentColor: '#ff5a00',
    accentColorDark: '#c2410c',
    standards: ['ASTM B348', 'AMS 4911', 'AMS 4928'],
    featured: true,
    appKey: 'services.cncgradehub.cards.g5.app',
  },
  {
    key: 'g6',
    href: '/titanium-cnc-machining-services/grade-6-titanium-cnc-machining/',
    gradeNumber: '6',
    alloyName: 'Ti-5Al-2.5Sn',
    uns: 'UNS R54520',
    categoryKey: 'alpha',
    categoryLabel: 'Alpha Alloy',
    accentColor: '#06b6d4',
    accentColorDark: '#0e7490',
    standards: ['AMS 4910', 'AMS 4925', 'AMS 4966'],
    featured: false,
    appKey: 'services.cncgradehub.cards.g6.app',
  },
  {
    key: 'g7',
    href: '/titanium-cnc-machining-services/grade-7-titanium-cnc-machining/',
    gradeNumber: '7',
    alloyName: 'Ti-0.2Pd (CP)',
    uns: 'UNS R52400',
    categoryKey: 'pd-stabilized',
    categoryLabel: 'Pd-Stabilized',
    accentColor: '#8b5cf6',
    accentColorDark: '#6d28d9',
    standards: ['ASTM B348', 'ASTM B265', 'ASTM B338'],
    featured: false,
    appKey: 'services.cncgradehub.cards.g7.app',
  },
  {
    key: 'g8',
    href: '/titanium-cnc-machining-services/grade-8-titanium-cnc-machining/',
    gradeNumber: '8',
    alloyName: 'Ti-3Al-2.5V + Pd',
    uns: 'UNS R56323',
    categoryKey: 'pd-stabilized',
    categoryLabel: 'Pd-Stabilized',
    accentColor: '#8b5cf6',
    accentColorDark: '#6d28d9',
    standards: ['AMS 4943', 'AMS 4944', 'AMS 4945'],
    featured: false,
    appKey: 'services.cncgradehub.cards.g8.app',
  },
  {
    key: 'g9',
    href: '/titanium-cnc-machining-services/grade-9-titanium-cnc-machining/',
    gradeNumber: '9',
    alloyName: 'Ti-3Al-2.5V',
    uns: 'UNS R56320',
    categoryKey: 'near-alpha',
    categoryLabel: 'Near-Alpha Alloy',
    accentColor: '#10b981',
    accentColorDark: '#047857',
    standards: ['AMS 4943', 'AMS 4944', 'ASTM B338'],
    featured: false,
    appKey: 'services.cncgradehub.cards.g9.app',
  },
  {
    key: 'g12',
    href: '/titanium-cnc-machining-services/grade-12-titanium-cnc-machining/',
    gradeNumber: '12',
    alloyName: 'Ti-0.3Mo-0.8Ni',
    uns: 'UNS R53400',
    categoryKey: 'improved-cp',
    categoryLabel: 'Improved CP-Ti',
    accentColor: '#ec4899',
    accentColorDark: '#be185d',
    standards: ['ASTM B348', 'ASTM B265', 'ASTM B338'],
    featured: false,
    appKey: 'services.cncgradehub.cards.g12.app',
  },
  {
    key: 'g21',
    href: '/titanium-cnc-machining-services/grade-21-titanium-cnc-machining/',
    gradeNumber: '21',
    alloyName: 'Ti-15Mo-3Nb-3Al',
    uns: 'UNS R58210',
