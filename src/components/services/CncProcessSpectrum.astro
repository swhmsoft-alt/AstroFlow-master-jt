    featured: true,
    appKey: 'services.cncgradehub.cards.g23.app',
  },
];

// Star icon path used on featured-grade badge
const starPath = "M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.364 1.118l1.287 3.957c.299.921-.756 1.688-1.539 1.118l-3.366-2.446a1 1 0 00-1.176 0l-3.367 2.446c-.782.57-1.838-.197-1.538-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.063 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z";

// Arrow icon for "Learn more"
const arrowPath = "M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3";
---

{variant === 'grade' ? (
  <!-- ============== GRADE VARIANT: 10-card material grid ============== -->
  <section class="relative py-20 overflow-hidden" style="background-color: var(--theme-bg);">
    <!-- Subtle grid pattern (lighter than process variant for visual differentiation) -->
    <div class="absolute inset-0 opacity-[0.025]">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, var(--theme-primary) 1px, transparent 0); background-size: 24px 24px;"></div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Section Header -->
      <div class="text-center mb-14">
        <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          {t('services.cncgradehub.badge')}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold mb-5" style="color: var(--theme-text);">
          {t('services.cncgradehub.titlePrefix')} <span style="color: var(--theme-primary);">{t('services.cncgradehub.titleHighlight')}</span>
        </h2>
        <p class="text-lg max-w-4xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {t('services.cncgradehub.subtitle')}
        </p>
      </div>

      <!-- Grade Cards Grid: 5 cols xl / 3 cols lg / 2 cols sm / 1 col -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
        {gradeCards.map((card) => (
          <a
            href={card.href}
            class="group relative rounded-2xl overflow-hidden flex flex-col h-full no-underline transition-all duration-300"
            style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent); display: block; text-decoration: none;"
            onmouseover={`this.style.borderColor='${card.accentColor}'; this.style.boxShadow='0 12px 40px -10px ${card.accentColor}55'; this.style.transform='translateY(-4px)'`}
            onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 18%, transparent)'; this.style.boxShadow='none'; this.style.transform='translateY(0)'"
          >
            {/* Top visual zone — category color gradient with grade number */}
            <div
              class="relative h-28 flex items-center justify-center overflow-hidden"
              style={`background: linear-gradient(135deg, ${card.accentColor} 0%, ${card.accentColorDark} 100%);`}
            >
              {/* Subtle grid pattern overlay */}
              <div class="absolute inset-0 opacity-[0.12]">
                <div class="absolute inset-0" style="background-image: linear-gradient(white 1px, transparent 1px), linear-gradient(90deg, white 1px, transparent 1px); background-size: 16px 16px;"></div>
              </div>

              {/* Diagonal accent stripe for featured grades */}
              {card.featured && (
                <div
                  class="absolute top-0 right-0 w-16 h-16"
                  style={`background: linear-gradient(135deg, transparent 50%, white 50%); opacity: 0.18;`}
                ></div>
              )}

              {/* Grade number (the visual anchor) */}
              <div class="relative text-center text-white">
                <div class="text-[2.75rem] leading-none font-black tracking-tighter" style="font-variant-numeric: tabular-nums;">
                  G{card.gradeNumber}
                </div>
                <div class="text-[10px] font-semibold uppercase tracking-[0.2em] mt-1 opacity-85">
                  Grade
                </div>
              </div>

              {/* Featured star badge */}
              {card.featured && (
                <div
                  class="absolute top-2 left-2 inline-flex items-center gap-1 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-md"
                  style="background: rgba(255,255,255,0.95); color: var(--theme-text);"
                >
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                    <path d={starPath} />
                  </svg>
                  {t('services.cncgradehub.featuredBadge')}
                </div>
              )}
            </div>

            {/* Bottom text zone */}
            <div class="flex flex-col flex-1 p-5">
              {/* Category eyebrow */}
              <div
                class="text-[10px] font-bold uppercase tracking-[0.15em] mb-2"
                style={`color: ${card.accentColor};`}
              >
                {card.categoryLabel}
              </div>

              {/* Alloy name (h3) */}
              <h3 class="text-lg font-bold mb-1 leading-tight" style="color: var(--theme-text);">
                {card.alloyName}
              </h3>

              {/* UNS designation */}
              <div class="text-xs font-mono mb-3" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
                {card.uns}
              </div>

              {/* Standards tags */}
              <div class="flex flex-wrap gap-1 mb-3">
                {card.standards.map((std) => (
                  <span
                    class="inline-flex items-center px-1.5 py-0.5 text-[10px] font-semibold rounded"
                    style="background-color: color-mix(in srgb, var(--theme-text) 4%, transparent); border: 1px solid color-mix(in srgb, var(--theme-text) 10%, transparent); color: color-mix(in srgb, var(--theme-text) 70%, transparent);"
                  >
                    {std}
                  </span>
                ))}
              </div>

              {/* Application summary */}
              <p class="text-xs leading-relaxed mb-4 flex-1" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                {t(card.appKey)}
              </p>

              {/* Learn more CTA */}
              <div
                class="inline-flex items-center text-xs font-bold mt-auto"
                style={`color: ${card.accentColor};`}
              >
                {t('services.cncgradehub.learnMore')}
                <svg class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={arrowPath} />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
) : (
  <!-- ============== PROCESS VARIANT: 4-card original layout (unchanged) ============== -->
  <section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
    {/* Engineering grid pattern */}
    <div class="absolute inset-0 opacity-[0.03]">
      <div class="absolute inset-0" style="background-image: linear-gradient(var(--theme-primary) 1px, transparent 1px), linear-gradient(90deg, var(--theme-primary) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      {/* Section Header */}
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          </svg>
          {t('services.cncprocessspectrum.badge')}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
          {t('services.cncprocessspectrum.titlePrefix')} <span style="color: var(--theme-primary);">{t('services.cncprocessspectrum.titleHighlight')}</span>
        </h2>
        <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {t('services.cncprocessspectrum.subtitle')}
        </p>
      </div>

      {/* Process Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {processIndices.map((idx) => (
          <a
            href={hrefs[idx]}
            class="group relative rounded-xl p-8 transition-all duration-300 flex flex-col h-full no-underline hover-card"
            style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 18%, transparent); display: block; text-decoration: none;"
            
          >
            {/* Icon */}
            <div class="w-12 h-12 rounded-lg flex items-center justify-center mb-5" style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
              <svg class="w-6 h-6" fill="none" stroke="var(--theme-primary)" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={icons[idx]} />
              </svg>
            </div>

            {/* Title */}
            <h3 class="text-lg font-bold mb-3" style="color: var(--theme-text);">
              {t('services.cncprocessspectrum.' + idx + '.title')}
            </h3>

            {/* Description */}
            <p class="text-sm mb-4 leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 60%, transparent);">
              {t('services.cncprocessspectrum.' + idx + '.desc')}
            </p>

            {/* Capabilities list */}
            <ul class="space-y-2 mt-auto">
              {capKeys[idx].map((capKey) => (
                <li class="flex items-start text-sm" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
                  <svg class="w-3.5 h-3.5 mt-0.5 mr-2 shrink-0" style="color: var(--theme-primary);" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  {t(capKey)}
                </li>
              ))}
            </ul>

            {/* Corner hover accent */}
            <div
              class="absolute top-0 right-0 w-0 h-0 transition-all duration-300 rounded-tr-xl hover-stage-arrow"
              style="border-style: solid; border-width: 0 0 0 0; border-color: transparent var(--theme-primary) transparent transparent; opacity: 0;"
              
            ></div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
