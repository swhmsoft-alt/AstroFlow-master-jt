---
import type { GradeData } from '../../data/titanium-grades';

export interface Props {
  grade: GradeData;
}

const { grade } = Astro.props as Props;

// Build search terms from grade name, key, and manual aliases
const name = grade.name.toLowerCase().replace(/[–—]/g, ' ').replace(/\s+/g, ' ').trim();
const key = (grade.key || '').toLowerCase().replace(/-/g, ' ');

// Manual grade-to-material aliases for entity matching
const MATERIAL_ALIASES: Record<string, string[]> = {
  'grade-1': ['grade 1', 'cp-ti gr1', 'gr 1'],
  'grade-2': ['grade 2', 'cp-ti gr2', 'gr 2', 'cp-ti (uhp', 'cp-ti (bead', 'commercially pure'],
  'grade-3': ['grade 3', 'cp-ti gr3', 'gr 3'],
  'grade-4': ['grade 4', 'cp-ti gr4', 'gr 4'],
  'grade-5': ['grade 5', 'ti-6al-4v'],
  'grade-6': ['grade 6', 'ti-5al-2.5sn'],
  'grade-7': ['grade 7', 'ti-0.15pd'],
  'grade-9': ['grade 9', 'ti-3al-2.5v'],
  'grade-12': ['grade 12', 'ti-0.3mo-0.8ni'],
  'grade-19': ['grade 19', 'beta-c', 'ti-3al-8v-6cr-4mo-4zr', 'ti-10v-2fe-3al'],
  'grade-21': ['grade 21', 'ti-15v-3cr-3sn-3al', 'ti-153'],
  'grade-23': ['grade 23', 'eli', 'astm f136', 'ti-6al-4v eli'],
  'grade-6242': ['grade 6242', 'ti-6242', 'ti-6al-2sn-4zr-2mo'],
  'ti-6246': ['ti-6246', 'ti-6al-2sn-4zr-6mo'],
  'ti-65': ['ti-65', 'ti-6al-4sn-9zr-1mo-1w-0.3si'],
  'ti-6al-7nb': ['ti-6al-7nb', 'astm f1295'],
  'ti-1100': ['ti-1100'],
  'nitinol': ['nitinol', 'ni-ti', 'shape memory', 'astm f2063'],
  'gamma-tial': ['gamma', 'tial', 'ti-48al-2cr-2nb'],
};

const searchTerms: string[] = [name, key];
const aliases = MATERIAL_ALIASES[grade.key] || [];
searchTerms.push(...aliases);
// Remove empty strings
const terms = searchTerms.filter(Boolean);

// Load from product-entities collection
const { getCollection } = await import('astro:content');
const allEntities = await getCollection('product-entities');

const related = allEntities.filter(e => {
  const m = (e.data.material || '').toLowerCase();
  return terms.some(t => m.includes(t));
});

const total = related.length;
const limit = total > 6 ? 6 : total;
const display = related.slice(0, limit);
---

{total > 0 && (
  <section class="py-16" style="background: var(--theme-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-2" style="color: var(--theme-text);">Related Components</h2>
      <p class="text-sm mb-8" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">
        {total} precision CNC machined components manufactured from {grade.name.replace(/[–—]/g, '-')}
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {display.map((e) => {
          const eslug = e.slug || e.id?.replace('.json','') || '';
          return (
            <a href={`/products/product-entities/${eslug}/`} class="block p-5 rounded-xl border transition-all" style="background: var(--theme-bg); border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
              <h3 class="font-bold text-sm" style="color: var(--theme-text);">{e.data.title}</h3>
              <p class="text-xs mt-1" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent);">{e.data.function?.slice(0, 100) || e.data.description?.slice(0, 100)}</p>
              {e.data.process && (
                <span class="inline-block mt-2 text-[10px] px-2 py-0.5 rounded" style="background: color-mix(in srgb, var(--theme-primary) 8%, transparent); color: color-mix(in srgb, var(--theme-primary) 60%, transparent);">{e.data.process}</span>
              )}
            </a>
          );
        })}
      </div>
      {total > limit && (
        <div class="mt-8 text-center">
          <a href="/products/product-entities/" class="inline-block px-6 py-3 rounded-lg font-medium transition-all" style="background: var(--theme-primary); color: white;">
            View All {total} Components →
          </a>
        </div>
      )}
    </div>
  </section>
)}
