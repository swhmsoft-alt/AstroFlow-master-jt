---
import { useTranslations, localizePath } from '../../i18n/utils';
import SubpageHero from '../ui/SubpageHero.astro';
import StandardStructuredData from './StandardStructuredData.astro';
import type { StandardData } from '../../data/titanium-standards';

export interface Props {
  standard: StandardData;
  lang: string;
  canonicalURL?: URL;
}

const { standard, lang, canonicalURL = new URL('https://cnc.bozemetal.com/materials/') } = Astro.props;
const t = useTranslations(lang);
const defaultCanonical = canonicalURL;
---

<!-- JSON-LD Structured Data for Google AIO -->
<StandardStructuredData standard={standard} lang={lang} canonicalURL={defaultCanonical} />

<!-- ===== HERO ===== -->
<SubpageHero
  title={standard.name}
  highlight={standard.highlight}
  badge={t(`materials.standards.badges.${standard.key}`)}
  badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
  subtitle={t(`materials.standards.subtitles.${standard.key}`)}
/>

<!-- ===== STEP 1: Material Compliance ===== -->
<section class="py-16" style="background-color: color-mix(in srgb, var(--theme-primary) 2%, transparent);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--theme-text);">
          {t('materials.titaniumstandards.materialCompliance')}
        </h2>
        <p class="text-lg max-w-4xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {t('materials.titaniumstandards.complianceDesc')}
          <strong style="color: var(--theme-primary);">{standard.name}</strong>
          {t('materials.titaniumstandards.complianceDesc2')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Supported Grades -->
        <div class="p-8 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="flex items-center gap-3 mb-6">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
              <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold" style="color: var(--theme-text);">{t('materials.titaniumstandards.supportedGrades')}</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {standard.supportedGrades.map((grade) => (
              <span class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-lg transition-all"
                style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent); color: color-mix(in srgb, var(--theme-text) 80%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);"
              >{grade}</span>
            ))}
          </div>
        </div>
        <!-- Available Forms -->
        <div class="p-8 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="flex items-center gap-3 mb-6">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
              <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <h3 class="text-lg font-bold" style="color: var(--theme-text);">{t('materials.titaniumstandards.availableForms')}</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {standard.materialForms.map((form) => (
              <span class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg"
                style="background-color: color-mix(in srgb, var(--theme-primary) 12%, transparent); color: var(--theme-primary); border: 1px solid color-mix(in srgb, var(--theme-primary) 20%, transparent);"
              >{form}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== STEP 2: Technical Specifications Table (NEW for AIO) ===== -->
<section class="py-16">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--theme-text);">
          {t('materials.titaniumstandards.techSpecsTitle')}
        </h2>
        <p class="text-lg max-w-3xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {t('materials.titaniumstandards.techSpecsDesc')}
        </p>
      </div>

      <!-- Machine-readable HTML table for AI extraction -->
      <div class="overflow-x-auto rounded-xl" style="border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <table class="w-full text-sm" style="border-collapse: collapse;">
          <thead>
            <tr style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
              <th class="px-6 py-4 text-left font-bold uppercase tracking-wider" style="color: var(--theme-primary);">{t('materials.titaniumstandards.techSpecParam')}</th>
              <th class="px-6 py-4 text-left font-bold uppercase tracking-wider" style="color: var(--theme-primary);">{t('materials.titaniumstandards.techSpecValue')}</th>
            </tr>
          </thead>
          <tbody>
            {standard.technicalProperties.map((prop, idx) => (
              <tr style="border-top: 1px solid color-mix(in srgb, var(--theme-primary) 8%, transparent); background-color: idx % 2 === 0 ? 'var(--theme-surface)' : 'color-mix(in srgb, var(--theme-primary) 2%, transparent)';"
                onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 5%, transparent)'"
                onmouseout="this.style.backgroundColor= idx % 2 === 0 ? 'var(--theme-surface)' : 'color-mix(in srgb, var(--theme-primary) 2%, transparent)'">
                <td class="px-6 py-3.5 font-medium" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{t(`materials.techspecs.${standard.faqCategoryKey}.label.${idx}`)}</td>
                <td class="px-6 py-3.5 font-semibold" style="color: var(--theme-text);">{t(`materials.techspecs.${standard.faqCategoryKey}.value.${idx}`)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- ===== STEP 3: CNC Capabilities (with narrative paragraph) ===== -->
<section class="py-16" style="background-color: color-mix(in srgb, var(--theme-primary) 2%, transparent);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-6">
        <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--theme-text);">
          {t('materials.titaniumstandards.cncTitle')}
        </h2>
      </div>

      <!-- Descriptive narrative paragraph for AI context extraction -->
      <div class="max-w-4xl mx-auto mb-10">
        <p class="text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {t('materials.titaniumstandards.cncNarrative')}
          <strong style="color: var(--theme-primary);">{standard.name}</strong>
          {t('materials.titaniumstandards.cncNarrative2')}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-12">
        {standard.cncCapabilities.map((cap) => (
          <div class="p-5 rounded-xl text-center transition-all duration-300"
            style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
            onmouseover="this.style.borderColor='var(--theme-primary)'; this.style.boxShadow='0 0 20px color-mix(in srgb, var(--theme-primary) 6%, transparent)'"
            onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'; this.style.boxShadow='none'"
          >
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mx-auto mb-3" style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
              <svg class="w-5 h-5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-sm font-medium" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{cap}</span>
          </div>
        ))}
      </div>

      <!-- Precision Stats -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="p-6 rounded-xl flex items-center gap-5" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="flex-shrink-0 w-14 h-14 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), transparent);">
            <svg class="w-7 h-7" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">{t('materials.titaniumstandards.achievableTolerance')}</div>
            <div class="text-xl font-bold mt-0.5" style="color: var(--theme-primary);">{standard.tolerance}</div>
          </div>
        </div>
        <div class="p-6 rounded-xl flex items-center gap-5" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <div class="flex-shrink-0 w-14 h-14 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 15%, transparent), transparent);">
            <svg class="w-7 h-7" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider" style="color: color-mix(in srgb, var(--theme-text) 50%, transparent);">{t('materials.titaniumstandards.achievableFinish')}</div>
            <div class="text-xl font-bold mt-0.5" style="color: var(--theme-primary);">{standard.surfaceFinish}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== STEP 4: Why Choose Us (NEW narrative for AI) ===== -->
<section class="py-16">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <div class="inline-block px-4 py-2 mb-4 text-sm font-semibold rounded-full"
          style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); color: var(--theme-primary);">
          {t('materials.titaniumstandards.whyChooseBadge')}
        </div>
        <h2 class="text-2xl md:text-3xl font-bold mb-6" style="color: var(--theme-text);">
          {t('materials.titaniumstandards.whyChooseTitle')}
        </h2>
        <!-- Rich narrative paragraph for AI context extraction -->
        <div class="text-left max-w-4xl mx-auto p-8 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent); line-height: 1.8;">
          <p class="text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent);">
            {t(`materials.standards.whyChooseUs.${standard.whyChooseUsKey}`)}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== STEP 5: Quality Assurance ===== -->
<section class="py-16" style="background-color: color-mix(in srgb, var(--theme-primary) 2%, transparent);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-6">
        <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--theme-text);">
          {t('materials.titaniumstandards.qualityTitle')}
        </h2>
      </div>
      <!-- Descriptive paragraph before certs list -->
      <div class="max-w-4xl mx-auto mb-10">
        <p class="text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {t('materials.titaniumstandards.qualityDesc')}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {standard.qualityCerts.map((cert) => (
          <div class="p-4 rounded-xl flex items-center gap-3 transition-all duration-300"
            style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
            onmouseover="this.style.borderColor='var(--theme-primary)'"
            onmouseout="this.style.borderColor='color-mix(in srgb, var(--theme-primary) 12%, transparent)'"
          >
            <svg class="w-5 h-5 flex-shrink-0" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span class="text-sm font-medium" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{cert}</span>
          </div>
        ))}
      </div>

      <div class="mt-8 p-6 rounded-xl flex items-start gap-4" style="background-color: color-mix(in srgb, var(--theme-primary) 5%, transparent); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
        <svg class="w-6 h-6 flex-shrink-0 mt-0.5" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {t('materials.titaniumstandards.traceabilityNote')}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ===== STEP 6: Industries ===== -->
<section class="py-16">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--theme-text);">
          {t('materials.titaniumstandards.industriesTitle')}
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {standard.industries.map((industry) => (
          <div class="p-5 rounded-xl flex items-center gap-3" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <div class="flex-shrink-0 w-9 h-9 rounded-lg flex items-center justify-center" style="background-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);">
              <svg class="w-4 h-4" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <span class="text-sm font-medium" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{t('materials.industries.' + industry.toLowerCase().replace(/[\s&]+/g, '_').replace(/-/g, '_'))}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ===== STEP 7: FAQ Section (NEW for AIO) ===== -->
<section class="py-16" style="background-color: color-mix(in srgb, var(--theme-primary) 2%, transparent);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--theme-text);">
          {t('materials.titaniumstandards.faqTitle')}
        </h2>
        <p class="text-lg" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {t('materials.titaniumstandards.faqSubtitle')}
        </p>
      </div>

      <div class="space-y-4">
        {[0, 1, 2].map((idx) => {
            const qKey = `materials.standards.faq.${standard.faqCategoryKey}.q${idx}`;
            const aKey = `materials.standards.faq.${standard.faqCategoryKey}.a${idx}`;
          return (
          <details class="group rounded-xl overflow-hidden transition-all duration-200"
            style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);"
          >
            <summary class="flex items-center justify-between px-6 py-5 cursor-pointer list-none transition-colors"
              style="color: var(--theme-text);"
              onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 4%, transparent)'"
              onmouseout="this.style.backgroundColor='transparent'"
            >
              <span class="text-base font-semibold pr-4">{t(qKey)}</span>
              <svg class="w-5 h-5 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-5 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
              <p class="text-sm leading-relaxed mt-4" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                {t(aKey)}
              </p>
            </div>
          </details>
          )
        })}
      </div>
    </div>
  </div>
</section>

<!-- ===== CTA SECTION ===== -->
<section class="py-20" style="background: linear-gradient(135deg, color-mix(in srgb, var(--theme-primary) 12%, transparent), color-mix(in srgb, var(--theme-primary) 3%, transparent));">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold mb-6"
        style="background-color: color-mix(in srgb, var(--theme-primary) 15%, transparent); color: var(--theme-primary);">
        {t('materials.titaniumstandards.ctaBadge')}
      </div>
      <h2 class="text-3xl md:text-4xl font-bold mb-6" style="color: var(--theme-text);">
        {t('materials.titaniumstandards.ctaTitle')}
      </h2>
      <p class="text-lg mb-10 max-w-2xl mx-auto" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {standard.ctaDescription}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="https://www.bozemetal.com/contact" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-8 py-4 text-base font-bold rounded-xl shadow-lg transition-all"
          style="background-color: var(--theme-primary); color: var(--theme-text);"
          onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 80%, black)'; this.style.boxShadow='0 0 30px color-mix(in srgb, var(--theme-primary) 40%, transparent)'"
          onmouseout="this.style.backgroundColor='var(--theme-primary)'; this.style.boxShadow=''">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
          {t('materials.titaniumstandards.ctaUpload')}
        </a>
        <a href="https://www.bozemetal.com/contact" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-8 py-4 text-base font-bold rounded-xl transition-all border"
          style="border-color: color-mix(in srgb, var(--theme-primary) 30%, transparent); color: var(--theme-text);"
          onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 10%, transparent)'"
          onmouseout="this.style.backgroundColor='transparent'">
          {t('materials.titaniumstandards.ctaContact')}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
