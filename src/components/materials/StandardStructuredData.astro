---
import type { StandardData } from '../../data/titanium-standards';

export interface Props {
  standard: StandardData;
  lang: string;
  canonicalURL: URL;
}

const { standard, lang, canonicalURL } = Astro.props;
const siteName = 'Boze Titanium Manufacturing Center';
const brandId = 'https://www.bozemetal.com/#brand-boze-cnc-ti';
const brandName = 'BOZE CNC Ti';
const orgId = 'https://www.bozemetal.com/#organization';
const orgName = 'Baoji Boze Metal Products Co., Ltd.';
const orgUrl = 'https://www.bozemetal.com';
const imageUrl = 'https://cnc.bozemetal.com/uploads/boze-tmc-og-en.png';
const currentDate = new Date().toISOString().split('T')[0];

// Build breadcrumb items
const breadcrumbItems = [
  { name: 'Home', url: orgUrl },
  { name: 'Materials', url: `${orgUrl}/materials/` },
  { name: standard.name, url: canonicalURL.href },
];

// Build FAQ structured data
const faqItems = standard.faqs.map((faq, i) => ({
  '@type': 'Question',
  name: faq.question,
  acceptedAnswer: {
    '@type': 'Answer',
    text: faq.answer,
  },
}));
---

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': canonicalURL.href + '#article',
      headline: standard.pageTitle,
      description: standard.metaDescription,
      name: `${standard.name} Titanium Precision CNC Machining Services`,
      author: {
        '@type': 'Organization',
        '@id': brandId,
        name: brandName,
      },
      publisher: {
        '@type': 'Organization',
        '@id': brandId,
        name: brandName,
        url: orgUrl,
      },
      image: imageUrl,
      datePublished: currentDate,
      dateModified: currentDate,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.href,
      },
      about: {
        '@type': 'Thing',
        name: standard.name,
        description: standard.specTitle,
      },
      keywords: standard.industries.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': canonicalURL.href + '#breadcrumb',
      itemListElement: breadcrumbItems.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.name,
        item: item.url,
      })),
    },
    {
      '@type': 'Product',
      '@id': canonicalURL.href + '#product',
      url: canonicalURL.href,
      name: `${standard.name} Titanium Precision Machining Services`,
      description: standard.subtitle,
      brand: {
        '@type': 'Brand',
        '@id': brandId,
        name: brandName,
      },
      category: standard.category,
      manufacturer: {
        '@type': 'Organization',
        '@id': orgId,
        name: orgName,
      },
    },
    {
      '@type': 'FAQPage',
      '@id': canonicalURL.href + '#faq',
      mainEntity: faqItems,
    },
  ],
})} />
