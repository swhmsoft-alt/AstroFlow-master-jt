---
interface AlloyRow {
  grade: string;
  spec: string;
  tensile: string;
  yield: string;
  elongation: string;
  hardness: string;
  advantage: string;
  specStandard: string;
}

interface Props {
  /**
   * Optional whitelist of grade labels to include.
   * When omitted, all 7 default rows render.
   * Used by Grade 5 / Grade 23 pages to render a focused
   * comparison block (see memory-bank/grade-5-semantic-cluster-audit.md §7 G2).
   */
  gradeKeys?: string[];
}

import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const { gradeKeys } = Astro.props as Props;

const alloyDataAll: AlloyRow[] = [
  { grade: "Grade 1", spec: "CP-Ti", tensile: "≥ 240", yield: "≥ 170", elongation: "≥ 24", hardness: "~ 120", advantage: t('materials.alloycomparisontable.adv_grade1'), specStandard: t('materials.alloycomparisontable.spec_astm_b265') },
  { grade: "Grade 2", spec: "CP-Ti", tensile: "≥ 345", yield: "≥ 275", elongation: "≥ 20", hardness: "~ 145", advantage: t('materials.alloycomparisontable.adv_grade2'), specStandard: t('materials.alloycomparisontable.spec_astm_b265') },
  { grade: "Grade 4", spec: "CP-Ti", tensile: "≥ 550", yield: "≥ 483", elongation: "≥ 15", hardness: "~ 265", advantage: t('materials.alloycomparisontable.adv_grade4'), specStandard: t('materials.alloycomparisontable.spec_astm_b265') },
  { grade: "Grade 9", spec: "Ti-3Al-2.5V", tensile: "≥ 620", yield: "≥ 483", elongation: "≥ 20", hardness: "~ 285", advantage: t('materials.alloycomparisontable.adv_grade9'), specStandard: t('materials.alloycomparisontable.spec_ams_4943') },
  { grade: "Grade 12", spec: "Ti-0.3Mo-0.8Ni", tensile: "≥ 485", yield: "≥ 345", elongation: "≥ 18", hardness: "~ 230", advantage: t('materials.alloycomparisontable.adv_grade12'), specStandard: t('materials.alloycomparisontable.spec_astm_b265') },
  { grade: "Grade 5", spec: "Ti-6Al-4V", tensile: "≥ 895", yield: "≥ 828", elongation: "≥ 10", hardness: "~ 330", advantage: t('materials.alloycomparisontable.adv_grade5'), specStandard: t('materials.alloycomparisontable.spec_astm_b265') },
  { grade: "Grade 23 ELI", spec: "Ti-6Al-4V ELI", tensile: "≥ 860", yield: "≥ 795", elongation: "≥ 10", hardness: "~ 315", advantage: t('materials.alloycomparisontable.adv_grade23'), specStandard: t('materials.alloycomparisontable.spec_astm_b265') },
];

// Backward-compatible filter: empty / undefined prop = all rows.
const alloyData: AlloyRow[] = gradeKeys && gradeKeys.length > 0
  ? alloyDataAll.filter((row) => gradeKeys.includes(row.grade))
  : alloyDataAll;
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        {t('materials.alloycomparisontable.badge')}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: var(--theme-text);">
        {t('materials.alloycomparisontable.comparison_table')}
      </h2>
      <p class="text-xl max-w-3xl mx-auto leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t('materials.alloycomparisontable.description')}
      </p>
    </div>

    <!-- Table Wrapper - horizontal scroll on mobile -->
    <div class="max-w-6xl mx-auto overflow-x-auto rounded-xl" style="border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
      <table class="w-full text-sm">
        {/* Table Head */}
        <thead>
          <tr style="background-color: var(--theme-surface);">
            <th class="text-left py-4 px-5 font-bold whitespace-nowrap" style="color: var(--theme-text); border-bottom: 2px solid var(--theme-primary);">
              {t('materials.alloycomparisontable.col_grade')}
            </th>
            <th class="text-left py-4 px-5 font-semibold whitespace-nowrap" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
              {t('materials.alloycomparisontable.col_spec')}
            </th>
            <th class="text-right py-4 px-5 font-semibold whitespace-nowrap" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
              {t('materials.alloycomparisontable.col_tensile')}
            </th>
            <th class="text-right py-4 px-5 font-semibold whitespace-nowrap" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
              {t('materials.alloycomparisontable.col_yield')}
            </th>
            <th class="text-right py-4 px-5 font-semibold whitespace-nowrap" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
              {t('materials.alloycomparisontable.col_elongation')}
            </th>
            <th class="text-right py-4 px-5 font-semibold whitespace-nowrap" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
              {t('materials.alloycomparisontable.col_hardness')}
            </th>
            <th class="text-left py-4 px-5 font-semibold whitespace-nowrap" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent); border-bottom: 2px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
              {t('materials.alloycomparisontable.col_advantage')}
            </th>
          </tr>
        </thead>

        {/* Table Body */}
        <tbody>
          {alloyData.map((row, idx) => (
            <tr
              style={`border-bottom: 1px solid var(--theme-surface);${idx % 2 === 0 ? '' : ' background-color: color-mix(in srgb, var(--theme-text) 3%, transparent);'}`}
              class="transition-all"
              onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 5%, transparent)'"
              onmouseout="this.style.backgroundColor=''"
            >
              <td class="py-4 px-5 font-bold whitespace-nowrap" style="color: var(--theme-text);">
                {row.grade}
                <span class="block text-xs font-mono font-normal mt-0.5" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{row.spec}</span>
              </td>
              <td class="py-4 px-5 font-mono text-xs" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
                {row.specStandard}
              </td>
              <td class="py-4 px-5 text-right font-mono font-semibold whitespace-nowrap" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                {row.tensile}
              </td>
              <td class="py-4 px-5 text-right font-mono font-semibold whitespace-nowrap" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                {row.yield}
              </td>
              <td class="py-4 px-5 text-right font-mono whitespace-nowrap" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                {row.elongation}
              </td>
              <td class="py-4 px-5 text-right font-mono whitespace-nowrap" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                {row.hardness}
              </td>
              <td class="py-4 px-5" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent); max-width: 260px;">
                {row.advantage}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* Footnote */}
    <div class="max-w-6xl mx-auto mt-4">
      <p class="text-xs" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
        {t('materials.alloycomparisontable.footnote')}
      </p>
    </div>
  </div>
</section>