---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { GradeData } from '../../data/titanium-grades';

export interface Props {
  grade: GradeData;
  gradeKey: string;
}

const { grade, gradeKey } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pfx = `materials.${gradeKey}.hasProperty`;
const chem = grade.hasProperty.chemistry;
/**
 * i18n keys for chemistry section. Element names + values are looked up by
 * index under `materials.<gradeKey>.hasProperty.chemistry.elements.<i>.name`.
 * Section title / description / table headers use the short keys below —
 * any missing translation falls back to the English value via the i18n
 * fallback chain in src/i18n/utils.ts (UI[lang]?.[key] ?? UI[en]?.[key] ?? key).
 */
const chemPfx = chem ? `${pfx}.chemistry` : '';
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-6xl mx-auto">
    <div class="mb-12 pb-6" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
        {t("materials.grade.badges.materialProperties")}
      </div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
        {t(`${pfx}.title`)}
      </h2>
      <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t(`${pfx}.description`)}
      </p>
    </div>

    <div class="rounded-xl overflow-hidden" style="border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
      <div class="grid grid-cols-1 md:grid-cols-2">
        {grade.hasProperty.properties.map((prop, index) => (
          <div
            class="flex items-center justify-between p-4 border-b transition-colors duration-150"
            style={`
              background-color: ${index % 2 === 0 ? 'var(--theme-surface)' : 'var(--theme-bg)'};
              border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);
            `}
          >
            <span class="text-sm font-medium" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{t(`${pfx}.properties.${index}.label`)}</span>
            <span class="text-sm font-bold text-right ml-4" style="color: var(--theme-text);">{prop.value}</span>
          </div>
        ))}
      </div>
    </div>

    {chem && (
      <div class="mt-16">
        <div class="mb-8">
          <div class="inline-flex items-center px-3 py-1.5 mb-3 text-xs font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
            <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
            <span>{chem.basis}</span>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold mb-3" style="color: var(--theme-text);">
            {t(`${chemPfx}.title`)}
          </h3>
          <p class="text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            {t(`${chemPfx}.description`)}
          </p>
        </div>

        <div class="rounded-xl overflow-hidden" style="border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
          <table class="w-full text-sm" aria-label={t(`${chemPfx}.title`)}>
            <thead>
              <tr style="background-color: var(--theme-surface); border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
                <th class="text-left font-semibold px-4 py-3 w-16" style="color: var(--theme-text);">{t(`${chemPfx}.headers.symbol`)}</th>
                <th class="text-left font-semibold px-4 py-3" style="color: var(--theme-text);">{t(`${chemPfx}.headers.element`)}</th>
                <th class="text-right font-semibold px-4 py-3 w-24" style="color: var(--theme-text);">{t(`${chemPfx}.headers.min`)}</th>
                <th class="text-right font-semibold px-4 py-3 w-24" style="color: var(--theme-text);">{t(`${chemPfx}.headers.max`)}</th>
                <th class="text-right font-semibold px-4 py-3 w-28 hidden sm:table-cell" style="color: var(--theme-text);">{t(`${chemPfx}.headers.typical`)}</th>
              </tr>
            </thead>
            <tbody>
              {chem.elements.map((el, index) => (
                <tr
                  class="border-b transition-colors duration-150"
                  style={`background-color: ${index % 2 === 0 ? 'var(--theme-surface)' : 'var(--theme-bg)'}; border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);`}
                >
                  <td class="px-4 py-3 font-mono font-bold" style="color: var(--theme-primary);">{el.symbol}</td>
                  <td class="px-4 py-3 font-medium" style="color: var(--theme-text);">{t(`${chemPfx}.elements.${index}.name`)}</td>
                  <td class="px-4 py-3 text-right" style="color: color-mix(in srgb, var(--theme-text) 75%, transparent);">{el.min}</td>
                  <td class="px-4 py-3 text-right font-semibold" style="color: var(--theme-text);">{el.max}</td>
                  <td class="px-4 py-3 text-right hidden sm:table-cell" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">{el.typical ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-xs italic" style="color: color-mix(in srgb, var(--theme-text) 55%, transparent);">
          {chem.remark}
        </p>
      </div>
    )}
  </div>
</section>