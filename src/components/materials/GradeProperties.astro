---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { GradeData } from '../../data/titanium-grades';

export interface Props {
  grade: GradeData;
  gradeKey: string;
}

const { grade, gradeKey } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pfx = `materials.${gradeKey}.hasProperty`;
---

<section class="relative py-24 overflow-hidden" style="background-color: var(--theme-bg);">
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--theme-text) 42%, transparent) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-6xl mx-auto">
    <div class="mb-12 pb-6" style="border-bottom: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
      <div class="inline-flex items-center px-4 py-2 mb-4 text-sm font-semibold rounded-full border" style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-color: var(--theme-primary); color: var(--theme-primary);">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
        {t("materials.grade.badges.materialProperties")}
      </div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--theme-text);">
        {t(`${pfx}.title`)}
      </h2>
      <p class="text-lg leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
        {t(`${pfx}.description`)}
      </p>
    </div>

    <div class="rounded-xl overflow-hidden" style="border: 1px solid color-mix(in srgb, var(--theme-primary) 15%, transparent);">
      <div class="grid grid-cols-1 md:grid-cols-2">
        {grade.hasProperty.properties.map((prop, index) => (
          <div
            class="flex items-center justify-between p-4 border-b transition-colors duration-150"
            style={`
              background-color: ${index % 2 === 0 ? 'var(--theme-surface)' : 'var(--theme-bg)'};
              border-color: color-mix(in srgb, var(--theme-primary) 8%, transparent);
            `}
          >
            <span class="text-sm font-medium" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">{t(`${pfx}.properties.${index}.label`)}</span>
            <span class="text-sm font-bold text-right ml-4" style="color: var(--theme-text);">{prop.value}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>