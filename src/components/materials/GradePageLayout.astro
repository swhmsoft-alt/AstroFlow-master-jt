---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import SubpageHero from '../ui/SubpageHero.astro';
import GradeEntityDefinition from './GradeEntityDefinition.astro';
import GradeStandards from './GradeStandards.astro';
import GradeProperties from './GradeProperties.astro';
import GradeProcessability from './GradeProcessability.astro';
import GradeDownstreamProducts from './GradeDownstreamProducts.astro';
import GradeIndustryApplications from './GradeIndustryApplications.astro';
import GradeAlternativeMaterials from './GradeAlternativeMaterials.astro';
import GradePageCta from './GradePageCta.astro';
import GradeStructuredData from './GradeStructuredData.astro';
import type { GradeData } from '../../data/titanium-grades';

export interface Props {
  grade: GradeData;
  lang: string;
  gradeKey: string;
}

const { grade, lang, gradeKey } = Astro.props;
const t = useTranslations(lang);
const hp = `materials.${gradeKey}.hero`;
---

<!-- JSON-LD Structured Data -->
<GradeStructuredData grade={grade} gradeKey={gradeKey} lang={lang} />

<!-- Hero -->
<SubpageHero
  title={t(`${hp}.name`)}
  highlight={t(`${hp}.highlight`)}
  badge={t(`${hp}.badge`)}
  badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
  subtitle={t(`${hp}.subtitle`)}
/>

<!-- 1. Entity Definition -->
<GradeEntityDefinition grade={grade} gradeKey={gradeKey} />

<!-- 2. Applicable Standards (conforms_to) -->
<GradeStandards grade={grade} gradeKey={gradeKey} />

<!-- 3. Material Properties (has_property) -->
<GradeProperties grade={grade} gradeKey={gradeKey} />

<!-- 4. Processing Methods (processed_by) -->
<GradeProcessability grade={grade} gradeKey={gradeKey} />

<!-- 5. Downstream Products (manufactured_from) -->
<GradeDownstreamProducts grade={grade} gradeKey={gradeKey} />

<!-- 6. Industries (used_in) -->
<GradeIndustryApplications grade={grade} gradeKey={gradeKey} />

<!-- 7. Alternative Materials (alternative_to) -->
<GradeAlternativeMaterials grade={grade} gradeKey={gradeKey} />

<!-- Why Choose Us (AIO narrative) -->
{t(`materials.grades.${gradeKey}.whyChooseUs`) && (
<section class="py-16" style="background-color: color-mix(in srgb, var(--theme-primary) 2%, transparent);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <div class="inline-block px-4 py-2 mb-4 text-sm font-semibold rounded-full"
          style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); color: var(--theme-primary);">
          {t('materials.titaniumstandards.whyChooseBadge')}
        </div>
        <h2 class="text-2xl md:text-3xl font-bold mb-6" style="color: var(--theme-text);">
          {t('materials.grade.whyChooseTitle')}
        </h2>
        <div class="text-left max-w-4xl mx-auto p-8 rounded-xl" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <p class="text-base leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 70%, transparent); line-height: 1.8;">
            {t(`materials.grades.${gradeKey}.whyChooseUs`)}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
)}

<!-- FAQ Section (AIO) -->
{grade.faqs && grade.faqs.length > 0 && (
<section class="py-16">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: var(--theme-text);">
          {t('materials.titaniumstandards.faqTitle')}
        </h2>
        <p class="text-lg" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
          {t('materials.grade.faqSubtitle')}
        </p>
      </div>
      <div class="space-y-4">
        {grade.faqs.map((faq, idx) => (
          <details class="group rounded-xl overflow-hidden transition-all duration-200"
            style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-primary) 12%, transparent);">
            <summary class="flex items-center justify-between px-6 py-5 cursor-pointer list-none transition-colors"
              style="color: var(--theme-text);"
              onmouseover="this.style.backgroundColor='color-mix(in srgb, var(--theme-primary) 4%, transparent)'"
              onmouseout="this.style.backgroundColor='transparent'">
              <span class="text-base font-semibold pr-4">{t(`materials.grades.${gradeKey}.faq.${idx}.question`)}</span>
              <svg class="w-5 h-5 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-5 border-t" style="border-color: color-mix(in srgb, var(--theme-primary) 10%, transparent);">
              <p class="text-sm leading-relaxed mt-4" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
                {t(`materials.grades.${gradeKey}.faq.${idx}.answer`)}
              </p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
)}

<!-- CTA -->
<GradePageCta grade={grade} lang={lang} gradeKey={gradeKey} />
