---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import SubpageHero from '../ui/SubpageHero.astro';
import GradeEntityDefinition from './GradeEntityDefinition.astro';
import GradeStandards from './GradeStandards.astro';
import GradeProperties from './GradeProperties.astro';
import GradeProcessability from './GradeProcessability.astro';
import GradeDownstreamProducts from './GradeDownstreamProducts.astro';
import GradeIndustryApplications from './GradeIndustryApplications.astro';
import GradeAlternativeMaterials from './GradeAlternativeMaterials.astro';
import GradePageCta from './GradePageCta.astro';
import type { GradeData } from '../../data/titanium-grades';

export interface Props {
  grade: GradeData;
  lang: string;
  gradeKey: string;
}

const { grade, lang, gradeKey } = Astro.props;
const t = useTranslations(lang);
const hp = `materials.${gradeKey}.hero`;
---

<!-- Hero -->
<SubpageHero
  title={t(`${hp}.name`)}
  highlight={t(`${hp}.highlight`)}
  badge={t(`${hp}.badge`)}
  badgeIcon="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
  subtitle={t(`${hp}.subtitle`)}
/>

<!-- 1. Entity Definition -->
<GradeEntityDefinition grade={grade} gradeKey={gradeKey} />

<!-- 2. Applicable Standards (conforms_to) -->
<GradeStandards grade={grade} gradeKey={gradeKey} />

<!-- 3. Material Properties (has_property) -->
<GradeProperties grade={grade} gradeKey={gradeKey} />

<!-- 4. Processing Methods (processed_by) -->
<GradeProcessability grade={grade} gradeKey={gradeKey} />

<!-- 5. Downstream Products (manufactured_from) -->
<GradeDownstreamProducts grade={grade} gradeKey={gradeKey} />

<!-- 6. Industries (used_in) -->
<GradeIndustryApplications grade={grade} gradeKey={gradeKey} />

<!-- 7. Alternative Materials (alternative_to) -->
<GradeAlternativeMaterials grade={grade} gradeKey={gradeKey} />

<!-- CTA -->
<GradePageCta grade={grade} lang={lang} gradeKey={gradeKey} />
