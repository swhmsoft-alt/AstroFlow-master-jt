---
/**
 * ComparisonTable.astro — visible <table> + AIO-citable ItemList JSON-LD.
 *
 * Renders a side-by-side product/service comparison table from a
 * ComparisonTableSeed (single source of truth shared with the JSON-LD).
 * AIO heavily cites comparison tables for "best X for Y" queries.
 *
 * Usage:
 *   <ComparisonTable seed={GRADE_5_VS_23} />
 *
 * The JSON-LD is injected as a separate `<script type="application/ld+json">`
 * block on the same page (rather than through BaseLayout) so the schema
 * stays co-located with the visible table that drives it.
 */
import type { ComparisonTableSeed } from '../data/comparisons/grade-comparisons';
import { toComparisonList } from '../data/comparisons/grade-comparisons';

export interface Props {
  seed: ComparisonTableSeed;
}

const { seed } = Astro.props;
const pageUrl = Astro.url.href.split('#')[0];
const itemList = toComparisonList(seed, pageUrl);
---

<section class="my-10">
  <h2 class="text-2xl font-semibold mb-4">{seed.name}</h2>
  <p class="text-sm text-slate-600 mb-6">{seed.description}</p>
  <div class="overflow-x-auto">
    <table class="min-w-full border border-slate-200 text-sm">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-4 py-3 text-left font-semibold border-b border-slate-200" scope="col">
            Criterion
          </th>
          {seed.columns.map((c) => (
            <th class="px-4 py-3 text-left font-semibold border-b border-slate-200" scope="col">
              <a href={c.url} class="text-blue-700 hover:underline">{c.linkLabel}</a>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {seed.rows.map((r) => (
          <tr class="even:bg-slate-50">
            <th class="px-4 py-2 text-left font-medium border-b border-slate-100" scope="row">
              {r.label}
            </th>
            {seed.columns.map((c) => (
              <td class="px-4 py-2 border-b border-slate-100">
                {r.values[c.name] ?? '—'}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [{
    '@type': 'ItemList',
    '@id': `${pageUrl}#comparison-list`,
    name: itemList.name,
    description: itemList.description,
    url: pageUrl,
    numberOfItems: itemList.items.length,
    itemListElement: itemList.items.map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: { '@id': it['@id'], '@type': 'Product', name: it.name },
    })),
    additionalProperty: itemList.criteria.map((c) => ({
      '@type': 'PropertyValue',
      name: c.name,
      value: Object.values(c.values)[0],
    })),
  }],
})} />