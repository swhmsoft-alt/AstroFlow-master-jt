---
// ResponsePipelineTimeline.astro
// Minimalist 3-step technical timeline displaying quotation response SLA
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="w-full" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="max-w-5xl mx-auto">
      <div class="relative">
        <!-- Section Label -->
        <div class="text-center mb-12">
          <span class="inline-block text-xs font-semibold uppercase tracking-wider mb-3" style="color: color-mix(in srgb, var(--theme-text) 45%, transparent); letter-spacing: 0.08em;">
            {t('rfq.pipeline.label')}
          </span>
          <h2 class="text-2xl md:text-3xl font-bold" style="color: var(--theme-text);">
            {t('rfq.pipeline.title')} <span style="color: var(--theme-primary);">{t('rfq.pipeline.titleHighlight')}</span>
          </h2>
        </div>

        <!-- Timeline Grid -->
        <div class="relative grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
          <!-- Connecting Line (Desktop) -->
          <div class="hidden md:block absolute top-8  h-px" style="background-color: color-mix(in srgb, var(--theme-text) 45%, transparent);"></div>

          <!-- Step 1 -->
          <div class="relative flex flex-col items-center text-center">
            <div class="relative z-10 w-16 h-16 flex items-center justify-center mb-6" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-text) 45%, transparent); border-radius: 2px;">
              <span class="text-lg font-bold" style="color: var(--theme-primary);">01</span>
            </div>
            <h3 class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--theme-text); letter-spacing: 0.06em;">
              {t('rfq.pipeline.step1.title')}
            </h3>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
              {t('rfq.pipeline.step1.desc')}
            </p>
            <div class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium" style="color: var(--theme-primary);">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {t('rfq.pipeline.step1.time')}
            </div>
          </div>

          <!-- Step 2 -->
          <div class="relative flex flex-col items-center text-center">
            <div class="relative z-10 w-16 h-16 flex items-center justify-center mb-6" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-text) 45%, transparent); border-radius: 2px;">
              <span class="text-lg font-bold" style="color: var(--theme-primary);">02</span>
            </div>
            <h3 class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--theme-text); letter-spacing: 0.06em;">
              {t('rfq.pipeline.step2.title')}
            </h3>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
              {t('rfq.pipeline.step2.desc')}
            </p>
            <div class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium" style="color: var(--theme-primary);">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {t('rfq.pipeline.step2.time')}
            </div>
          </div>

          <!-- Step 3 -->
          <div class="relative flex flex-col items-center text-center">
            <div class="relative z-10 w-16 h-16 flex items-center justify-center mb-6" style="background-color: var(--theme-surface); border: 1px solid color-mix(in srgb, var(--theme-text) 45%, transparent); border-radius: 2px;">
              <span class="text-lg font-bold" style="color: var(--theme-primary);">03</span>
            </div>
            <h3 class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--theme-text); letter-spacing: 0.06em;">
              {t('rfq.pipeline.step3.title')}
            </h3>
            <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
              {t('rfq.pipeline.step3.desc')}
            </p>
            <div class="mt-4 inline-flex items-center gap-1.5 text-xs font-medium" style="color: var(--theme-primary);">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {t('rfq.pipeline.step3.time')}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
