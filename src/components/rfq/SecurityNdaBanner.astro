---
// SecurityNdaBanner.astro
// Trust-anchor component highlighting IP protection, encrypted file transfer, and NDA availability
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="w-full" style="background-color: var(--theme-bg);">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="max-w-5xl mx-auto">
      <div
        class="relative p-6 md:p-8 border flex flex-col md:flex-row md:items-center gap-6"
        style="background-color: var(--theme-surface); border-color: color-mix(in srgb, var(--theme-text) 45%, transparent); border-radius: 2px;"
      >
        <!-- Shield Icon -->
        <div
          class="flex-shrink-0 w-12 h-12 flex items-center justify-center"
          style="background-color: color-mix(in srgb, var(--theme-primary) 10%, transparent); border-radius: 2px;"
        >
          <svg class="w-6 h-6" style="color: var(--theme-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>

        <!-- Content -->
        <div class="flex-1 min-w-0">
          <h3 class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: var(--theme-text); letter-spacing: 0.06em;">
            {t('rfq.security.title')}
          </h3>
          <p class="text-sm leading-relaxed" style="color: color-mix(in srgb, var(--theme-text) 65%, transparent);">
            {t('rfq.security.desc')}
          </p>
        </div>

        <!-- NDA Download Link -->
        <div class="flex-shrink-0">
          <a
            href="#"
            class="inline-flex items-center gap-2 px-5 py-3 text-xs font-semibold uppercase tracking-wider border transition-all hover:bg-[var(--theme-primary)]/10 whitespace-nowrap"
            style="border-color: var(--theme-primary); color: var(--theme-primary); letter-spacing: 0.06em; border-radius: 2px;"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            {t('rfq.security.cta')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
